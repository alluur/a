// A small tool built from prelude functions: statistics of standard input
int main() {
    char line[256];
    int lines = 0, words = 0, chars = 0, numbers = 0, sum = 0;
    char* longest = "";
    while (readLine(line, 256) >= 0) {
        lines++;
        chars += strlen(line) + 1;
        char* p = trim(line);
        int i = 0;
        while (p[i] != 0) {                           // split the line into words
            while (isSpace(p[i])) i++;
            if (p[i] == 0) break;
            int start = i;
            while (p[i] != 0 && !isSpace(p[i])) i++;
            char* word = substr(p, start, i - start);
            words++;
            int value;
            if (parseInt(word, &value)) {
                numbers++;
                sum += value;
            }
            if (strlen(word) > strlen(longest)) longest = word;
        }
    }
    printf("%d lines, %d words, %d characters\n", lines, words, chars);
    printf("%d numbers with sum %d\n", numbers, sum);
    printf("longest word: %s\n", longest);
    return 0;
}
