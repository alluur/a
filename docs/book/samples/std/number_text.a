// Numbers to text and text to numbers
int main() {
    char buf[24];
    println(intToStr(-1234, buf));           // returns buf
    hexToStr(48879, buf);
    println(buf);

    // atoi is lenient: it reads digits until something else appears
    printf("%d %d %d %d\n", atoi("42"), atoi("-17"), atoi("12abc"), atoi("abc"));

    // parseInt is strict: false when the text is not exactly a number
    char* tests[5] = {"42", "  -8  ", "+5", "12abc", ""};
    for (int i = 0; i < 5; i++) {
        int value = -999;
        bool ok = parseInt(tests[i], &value);
        printf("parseInt(\"%s\") = %d, value %d\n", tests[i], ok, value);
    }
    return 0;
}
