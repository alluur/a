// Searching and cutting strings
int main() {
    char* path = "/usr/local/lib/a/std.a";
    printf("index of 'l': %d, of '#': %d\n", indexOf(path, 'l'), indexOf(path, '#'));   // -1: not found
    printf("starts with /usr: %d, ends with .a: %d, ends with .c: %d\n",
           startsWith(path, "/usr"), endsWith(path, ".a"), endsWith(path, ".c"));
    printf("find lib: %d, find nothing: %d\n", find(path, "lib"), find(path, "xyz"));
    printf("contains local: %d\n", contains(path, "local"));

    char* name = substr(path, find(path, "std"), 3);    // start, length: a new heap string
    printf("[%s]\n", name);

    char line[32] = "   padded text  \t";
    char* clean = trim(line);                // cuts the end in place and returns the new start
    printf("[%s]\n", clean);
    return 0;
}
