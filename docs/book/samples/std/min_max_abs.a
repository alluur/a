// abs, min and max
int main() {
    printf("%d %d %d\n", abs(-12), abs(12), abs(0));
    printf("%d %d\n", min(3, 9), max(3, 9));
    printf("%d\n", min(max(-5, 0), 10));              // clamping a value into 0 .. 10
    printf("%d\n", min(max(50, 0), 10));
    int values[5] = {7, -3, 12, 0, 5};
    int lo = values[0];
    int hi = values[0];
    for (int i = 1; i < 5; i++) {
        lo = min(lo, values[i]);
        hi = max(hi, values[i]);
    }
    printf("range %d .. %d\n", lo, hi);
    return 0;
}
