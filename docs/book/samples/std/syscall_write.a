// __syscall: a raw system call (the numbers differ between processors)
// book: linux-only
static if (__ARCH == 0) {
    const SYS_WRITE = 1;                         // x86-64
} else {
    const SYS_WRITE = 64;                        // ARM64, RISC-V and LoongArch use the generic table
}

int main() {
    char* msg = "hello from a raw system call\n";
    int written = __syscall(SYS_WRITE, 1, msg, strlen(msg), 0, 0, 0);
    printf("write returned %d\n", written);
    return 0;
}
