// millis() measures time, sleepMs() waits
int main() {
    int start = millis();                         // milliseconds since an arbitrary moment: use differences
    sleepMs(120);
    int elapsed = millis() - start;
    printf("slept at least 120 ms: %d\n", elapsed >= 120);
    printf("and not absurdly longer: %d\n", elapsed < 1000);

    return 0;
}
