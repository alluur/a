// Strings: length, comparison, copying and joining
int main() {
    char* s = "A string";
    printf("strlen: %d\n", strlen(s));
    printf("streq: %d %d\n", streq("abc", "abc"), streq("abc", "abd"));
    printf("strcmp: %d %d %d\n", strcmp("apple", "banana") < 0, strcmp("pear", "pear"), strcmp("b", "a") > 0);

    char buf[32];
    strcpy(buf, "Hello");                    // copy into a buffer that is big enough
    strcat(buf, ", ");                       // append
    strcat(buf, "world");
    println(buf);

    char* copy = strdup(buf);                // a copy on the heap
    copy[0] = 'J';
    printf("%s / %s\n", buf, copy);

    char block[8];
    memset(block, '-', 7);                   // memset and memcpy work on raw bytes
    block[7] = 0;
    memcpy(block, "ab", 2);
    println(block);
    return 0;
}
