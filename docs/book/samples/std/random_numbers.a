// rand and srand: the same seed gives the same numbers on every machine
int main() {
    srand(2024);
    printf("%d %d %d\n", rand() % 100, rand() % 100, rand() % 100);

    srand(2024);                                   // start again: the same sequence
    printf("%d %d %d\n", rand() % 100, rand() % 100, rand() % 100);

    srand(7);
    int rolls[6];
    for (int i = 0; i < 600; i++) {
        rolls[rand() % 6]++;                       // simulate dice
    }
    int total = 0;
    for (int i = 0; i < 6; i++) {
        printf("%d: %d\n", i + 1, rolls[i]);
        total += rolls[i];
    }
    printf("total %d\n", total);
    return 0;
}
