// Environment variables: getEnv needs argc and argv
int main(int argc, char** argv) {
    char* term = getEnv(argc, argv, "TERM");      // a heap string, or null if the variable is not set
    if (term != null) {
        printf("TERM is %s\n", term);
    }
    char* missing = getEnv(argc, argv, "A_BOOK_NO_SUCH_VARIABLE");
    printf("missing is null: %d\n", missing == null);
    char* lang = getEnv(argc, argv, "LANG") ?? "unset";
    printf("LANG is %s\n", lang);
    return 0;
}
