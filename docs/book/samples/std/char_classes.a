// Character tests and conversion
int main() {
    char* text = "Hello, World 2024! ";
    int letters = 0, digits = 0, spaces = 0, upper = 0, other = 0;
    for (int i = 0; text[i] != 0; i++) {
        char c = text[i];
        if (isAlpha(c)) {
            letters++;
            if (isUpper(c)) upper++;
        } else if (isDigit(c)) {
            digits++;
        } else if (isSpace(c)) {
            spaces++;
        } else {
            other++;
        }
    }
    printf("letters %d (upper %d), digits %d, spaces %d, other %d\n", letters, upper, digits, spaces, other);

    printf("%c %c %c\n", toUpper('q'), toLower('Q'), toUpper('7'));

    char word[16] = "MiXed CaSe";
    strUpper(word);                              // in place
    println(word);
    strLower(word);
    println(word);
    printf("streqi: %d %d\n", streqi("Hello", "hELLO"), streqi("Hello", "Help"));
    return 0;
}
