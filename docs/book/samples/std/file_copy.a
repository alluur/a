// Copying a file in chunks with the file handle functions
int copyFile(char* from, char* to) {
    int in = fileOpen(from, FILE_READ);
    if (in < 0) return -1;
    int out = fileOpen(to, FILE_WRITE);
    if (out < 0) {
        fileClose(in);
        return -1;
    }
    char chunk[64];
    int total = 0;
    int n = fileRead(in, chunk, 64);
    while (n > 0) {
        fileWrite(out, chunk, n);
        total += n;
        n = fileRead(in, chunk, 64);
    }
    fileClose(in);
    fileClose(out);
    return total;
}

int main() {
    writeFile("source.txt", "The quick brown fox jumps over the lazy dog.\nThe quick brown fox jumps over the lazy dog again.\n");
    printf("copied %d bytes\n", copyFile("source.txt", "target.txt"));
    printf("same text: %d\n", streq(readFile("source.txt"), readFile("target.txt")));
    printf("copy of a missing file: %d\n", copyFile("missing.txt", "x.txt"));
    fileDelete("source.txt");
    fileDelete("target.txt");
    return 0;
}
