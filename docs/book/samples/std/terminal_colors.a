// Coloured output that stays readable when it is not a terminal
int main() {
    printColor(ANSI_GREEN, "ok");                 // plain text when output goes to a file or a pipe
    print(" ");
    printColor(ANSI_RED, "failed");
    print(" ");
    printColor(ANSI_BOLD, "bold");
    println("");
    printf("stdout is a terminal: %d\n", isTerminal(1));

    // the constants are ordinary strings: you can combine them yourself
    if (isTerminal(1)) {
        print(ANSI_CYAN);
        print("only seen on a terminal");
        println(ANSI_RESET);
    }
    printf("length of ANSI_RED: %d\n", strlen(ANSI_RED));
    return 0;
}
