// The built-in runtime functions the prelude is built on
// book: exit=5
int main() {
    char* msg = "written with __write\n";
    __write(1, msg, strlen(msg));                    // fd 1 is standard output

    int h = __open("data.bin", 1);                   // mode 0 read, 1 write, 2 append
    __write(h, "abcdef", 6);
    __close(h);

    char buf[16];
    h = __open("data.bin", 0);
    int n = __read(h, buf, 16);
    __close(h);
    buf[n] = 0;
    printf("read back %d bytes: %s\n", n, buf);
    fileDelete("data.bin");

    printf("__OS = %d, __ARCH = %d\n", __OS, __ARCH);   // 0 Linux, 1 Windows, 2 Android / 0 x86-64
    printf("__cmdline() is null on this system: %d\n", __cmdline() == null);
    __exit(5);                                       // end the process at once, without flushing anything
    return 0;
}
