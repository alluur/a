// A weighted random pick: loot drops with integer weights and an alias table
import rng;

int main() {
    char* loot[5] = {"nothing", "coin", "potion", "sword", "dragon egg"};
    int weights[5] = {50, 30, 15, 4, 1};             // out of 100: a dragon egg drops once in 100 times
    rng.Xoshiro256 g(77);

    // weighted(weights, n): exact, integers only; the result is an index, -1 for bad weights
    int got[5];
    foreach (int i in 0..5) { got[i] = 0; }
    for (int i = 0; i < 10000; i++) { got[g.weighted(weights, 5)]++; }
    println("weighted(): 10000 drops");
    foreach (int i, char* name in loot) { printf("  %-11s weight %2d  dropped %4d times (expected %d)\n", name, weights[i], got[i], weights[i] * 100); }
    int bad[3] = {5, -1, 2};
    int zero[3] = {0, 0, 0};
    printf("negative weight: %d, all zero: %d (both give -1)\n", g.weighted(bad, 3), g.weighted(zero, 3));

    // AliasTable: O(n) setup, then every draw costs one below() and one nextDouble(), however many categories there are
    double w[5] = {0.5, 0.3, 0.15, 0.04, 0.01};      // doubles need not add up to 1
    rng.AliasTable table(w, 5);
    printf("alias table ok: %d, size %d, probability of the dragon egg %s\n", table.ok(), table.size(), doubleToFixed(table.probabilityOf(4), 4));
    foreach (int i in 0..5) { got[i] = 0; }
    for (int i = 0; i < 10000; i++) { got[table.sample(&g)]++; }     // the table needs the generator: sample(&g)
    printf("alias: ");
    foreach (int i in 0..5) { printf(" %d", got[i]); }
    println("");

    // a zero weight is never drawn; bad weights (negative, NaN, all zero) make the table "not ok"
    double w2[3] = {1.0, 0.0, 3.0};
    rng.AliasTable t2(w2, 3);
    int hits1 = 0;
    for (int i = 0; i < 10000; i++) { if (t2.sample(&g) == 1) { hits1++; } }
    double w3[2] = {1.0, -2.0};
    rng.AliasTable t3(w3, 2);
    printf("zero weight drawn %d times; table with a negative weight is ok: %d, its sample gives %d\n", hits1, t3.ok(), t3.sample(&g));
    table.dispose(); t2.dispose(); t3.dispose();
    return 0;
}
