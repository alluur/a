// An interval set: a calendar of booked minutes
import ds;

// minutes since midnight as hh:mm
void showTime(int m) { printf("%02d:%02d", m / 60, m % 60); }

void show(char* label, ds.IntervalSet* cal) {
    printf("%s (%d minutes in %d block(s)):", label, cal->length(), cal->count());
    for (int i = 0; i < cal->count(); i++) {
        printf(" ");
        showTime(cal->lowAt(i));
        printf("-");
        showTime(cal->highAt(i) + 1);                // the interval is closed: the last minute is hi, the slot ends one later
    }
    println("");
}

int main() {
    ds.IntervalSet cal();
    cal.add(540, 599);                               // 09:00-10:00: both ends are included, so 60 minutes
    cal.add(720, 779);                               // 12:00-13:00
    cal.add(600, 629);                               // 10:00-10:30 touches the first block: they merge
    show("booked", &cal);

    printf("is 09:30 booked: %d, 11:00: %d, the hour 12:00..12:59 covered: %d\n", cal.contains(570), cal.contains(660), cal.covers(720, 779));
    printf("anything booked in 10:30..11:59: %d, in 10:30..12:00: %d\n", cal.overlaps(630, 719), cal.overlaps(630, 720));

    int t = 0;
    cal.nextFree(570, &t);                           // first minute at or after 09:30 that is free
    printf("the next free minute after 09:30 is ");
    showTime(t);
    println("");
    cal.nextMember(631, &t);                         // first booked minute at or after 10:31
    printf("the next booked minute after 10:31 is ");
    showTime(t);
    println("");

    cal.remove(560, 569);                            // a cancellation in the middle splits the block
    show("after a cancellation", &cal);
    cal.add(0, 1439);                                // the whole day ...
    cal.remove(480, 1019);                           // ... except 08:00 to 17:00 (minutes 480 .. 1019)
    show("outside office hours", &cal);
    printf("block of minute 100: %d, of minute 500: %d (-1 = none)\n", cal.indexOf(100), cal.indexOf(500));
    cal.dispose();
    return 0;
}
