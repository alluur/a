// Fuzzy search: similarity scores and "did you mean ...?"
import strx;
import ds;

char* dictionary[12] = {"banana", "bandana", "cabana", "bandage", "bonanza", "banner", "bananas", "ban", "canal", "panama", "bank", "nana"};

void score(char* a, char* b) {
    char pair[24];
    format(pair, 24, "%s/%s", a, b);
    printf("%-16s %6s %6s %6s %6s %6s\n", pair,
           doubleToFixed(strx.jaro(a, -1, b, -1), 3), doubleToFixed(strx.jaroWinkler(a, -1, b, -1), 3),
           doubleToFixed(strx.diceBigrams(a, -1, b, -1), 3), doubleToFixed(strx.jaccardQgrams(a, -1, b, -1), 3),
           doubleToFixed(strx.cosineQgrams(a, -1, b, -1), 3));
}

int main() {
    // 1.0 means equal, 0.0 nothing in common
    printf("%-16s %6s %6s %6s %6s %6s\n", "pair", "jaro", "jw", "dice", "jacc.", "cosine");
    score("martha", "marhta");                       // the classic: two letters swapped
    score("dixon", "dicksonx");
    score("night", "nacht");
    score("banana", "banana");
    score("abc", "xyz");

    // a spelling helper: words within 2 edits are candidates (levenshteinMax stops early, so it is cheap)
    char* query = "bananna";
    ds.BinaryHeap best();
    foreach (int i, char* word in dictionary) {
        int d = strx.levenshteinMax(query, -1, word, -1, 2);
        if (d > 2) { continue; }                     // k + 1 means "more than k"
        int jw = (int) (strx.jaroWinkler(query, -1, word, -1) * 1000);
        best.push(d * 1000 + (1000 - jw), i);        // fewer edits first, then the higher Jaro-Winkler score
    }
    printf("did you mean \"%s\"? %d suggestions:\n", query, best.size());
    while (!best.isEmpty()) {
        int key = best.peek();
        char* word = dictionary[best.popValue()];
        int jw = 1000 - key % 1000;
        printf("  %-8s distance %d, jaro-winkler %d.%03d\n", word, key / 1000, jw / 1000, jw % 1000);
    }
    best.dispose();
    return 0;
}
