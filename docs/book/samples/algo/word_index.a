// A word index: an ordered map from text to count
import ds;

// the next word of the text: lower case letters only; returns the position after it, or -1 at the end
int nextWord(char* text, int pos, char* out) {
    while (text[pos] != 0 && !isAlpha(text[pos])) { pos++; }
    if (text[pos] == 0) { return -1; }
    int n = 0;
    while (isAlpha(text[pos])) { out[n] = toLower(text[pos]); n++; pos++; }
    out[n] = 0;
    return pos;
}

int main() {
    char* text = "The quick brown fox jumps over the lazy dog. The dog barks, the fox runs away, "
                 "and the quick brown dog follows the fox over the hill.";
    ds.OrderedTextMap index();
    char word[32];
    int pos = nextWord(text, 0, word);
    while (pos >= 0) {
        index.put(word, index.get(word, 0) + 1);     // the key is copied: the buffer can be reused
        pos = nextWord(text, pos, word);
    }
    printf("%d different words\n", index.size());

    // the keys come out in alphabetical (byte) order
    char* keys[40];
    int counts[40];
    int n = index.toArrays(keys, counts);
    for (int i = 0; i < n; i++) { printf("%s=%d%s", keys[i], counts[i], i + 1 < n ? " " : "\n"); }

    printf("first: %s, last: %s, rank of \"fox\": %d\n", index.first(), index.last(), index.rank("fox"));
    printf("word after \"dog\": %s, at or before \"e\": %s, 5th word: %s\n", index.higher("dog"), index.floor("e"), index.select(4));

    // all words from "b" to "e": a range query on the tree
    n = index.range("b", "e", keys, counts, 40);
    printf("words from b to e (%d):", index.countRange("b", "e"));
    for (int i = 0; i < n; i++) { printf(" %s", keys[i]); }
    println("");

    // a set of the words that occur once; foreach walks it in order
    ds.OrderedTextSet once();
    for (int i = 0; i < index.size(); i++) {
        char* w = index.select(i);
        if (index.get(w, 0) == 1) { once.add(w); }
    }
    printf("words that occur once:");
    foreach (char* w in once) { printf(" %s", w); }
    println("");
    index.dispose(); once.dispose();                 // frees the copies of the keys too
    return 0;
}
