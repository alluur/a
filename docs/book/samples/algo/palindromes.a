// Palindromes: Manacher's algorithm in linear time
import strx;

int main() {
    // isPalindrome compares the bytes as they are: no folding of case, blanks or punctuation
    char* tests[5] = {"racecar", "level", "abba", "banana", "A man, a plan"};
    foreach (char* t in tests) { printf("%-14s palindrome: %d\n", t, strx.isPalindrome(t, -1)); }

    // the longest palindrome inside a text (the leftmost one wins a tie)
    char* text = "forgeeksskeegfor and civic duty";
    int start = 0;
    int len = strx.longestPalindrome(text, -1, &start);
    printf("longest in \"%s\": \"%.*s\" (%d bytes at %d)\n", text, len, text + start, len, start);

    // how many palindromic substrings: every letter is one, and equal positions count separately
    printf("\"aaa\" has %d (a, a, a, aa, aa, aaa), \"abc\" has %d, \"abaaba\" has %d\n",
           strx.countPalindromes("aaa", -1), strx.countPalindromes("abc", -1), strx.countPalindromes("abaaba", -1));

    // the raw radii: d1[i] odd palindromes centred on i (longest 2*d1[i] - 1), d2[i] even ones centred between i-1 and i (longest 2*d2[i])
    char* s = "abacaba";
    int d1[7];
    int d2[7];
    strx.manacher(s, 7, d1, d2);
    printf("%s  centre:", s);
    foreach (int i in 0..7) { printf(" %d", d1[i]); }
    printf("   between:");
    foreach (int i in 0..7) { printf(" %d", d2[i]); }
    println("");

    // with utf8 = true whole characters are compared: "été" is a palindrome of 3 characters (5 bytes)
    char* ete = "\xc3\xa9t\xc3\xa9";
    printf("ete: bytes %d, characters %d, longest palindrome %d bytes\n", strx.isPalindrome(ete, -1), strx.isPalindrome(ete, -1, true), strx.longestPalindrome(ete, -1, null, true));
    return 0;
}
