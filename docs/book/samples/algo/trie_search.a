// A trie: prefix search, wildcards and the longest matching prefix
import ds;

int printKey(char* key, int value, int ctx) {        // callback: the key text is only valid inside the call
    printf("  %s (%d)\n", key, value);
    return 0;                                        // non-zero would stop the walk
}

int main() {
    ds.Trie words();
    char* list[9] = {"car", "card", "care", "careful", "cart", "cat", "catalog", "dog", "dot"};
    foreach (int i, char* w in list) { words.put(w, i); }   // a value comes with every key
    printf("%d keys, %d trie nodes\n", words.size(), words.nodeCount());

    printf("keys starting with \"car\": %d, with \"cat\": %d, with \"x\": %d\n",
           words.countPrefix("car"), words.countPrefix("cat"), words.countPrefix("x"));
    println("walkPrefix(\"care\"):");
    words.walkPrefix("care", printKey, 0);           // in byte order, calls printKey for each

    // collect copies the keys: you free them with ds.freeTexts
    char* found[10];
    int n = words.collect("d", found, 10);
    printf("collect(\"d\"):");
    for (int i = 0; i < n; i++) { printf(" %s", found[i]); }
    println("");
    ds.freeTexts(found, n);

    // wildcards: ? is one byte, * is any run of bytes
    printf("c?t matches %d, ca* matches %d, *t matches %d, ?o? matches %d\n",
           words.countWildcard("c?t"), words.countWildcard("ca*"), words.countWildcard("*t"), words.countWildcard("?o?"));
    n = words.collectWildcard("car?", found, 10);
    printf("car?:");
    for (int i = 0; i < n; i++) { printf(" %s", found[i]); }
    println("");
    ds.freeTexts(found, n);

    words.remove("card");
    printf("after remove(\"card\"): has card %d, has care %d, size %d\n", words.has("card"), words.has("care"), words.size());

    // a routing table: the longest stored prefix wins
    ds.Trie routes();
    routes.put("/", 1);  routes.put("/api", 2);  routes.put("/api/users", 3);  routes.put("/static", 4);
    char* paths[4] = {"/api/users/42", "/api/orders", "/static/logo.png", "/about"};
    foreach (char* p in paths) {
        int handler = 0;
        int len = routes.longestPrefixOf(p, &handler);   // length of the match, its value in handler
        printf("%-18s -> route %d (prefix length %d)\n", p, handler, len);
    }
    words.dispose(); routes.dispose();
    return 0;
}
