// An LRU cache: keep the most recently used results
import ds;

int computations = 0;

// pretend this is slow: the number of steps of the Collatz sequence of n
int collatzSteps(int n) {
    computations++;
    int steps = 0;
    while (n != 1) {
        n = (n % 2 == 0) ? n / 2 : 3 * n + 1;
        steps++;
    }
    return steps;
}

int onEvict(int key, int value, int ctx) {          // called whenever an entry leaves the cache
    printf("  evicted %d (%d steps)\n", key, value);
    return 0;
}

int cachedSteps(ds.LruCache* cache, int n) {
    int steps = cache->get(n, -1);                   // -1 = not cached; get makes the entry the newest
    if (steps < 0) {
        steps = collatzSteps(n);
        cache->put(n, steps);
    }
    return steps;
}

int main() {
    ds.LruCache cache(3);                            // room for three results
    cache.setEvictHandler(onEvict, 0);
    int requests[10] = {27, 97, 871, 27, 97, 6171, 27, 871, 871, 97};
    foreach (int n in requests) {
        int steps = cachedSteps(&cache, n);
        printf("steps(%d) = %d\n", n, steps);
    }
    printf("%d requests, %d computations; hits %d, misses %d, evictions %d\n", 10, computations, cache.hits, cache.misses, cache.evictions);

    // from the newest to the oldest entry
    printf("newest first:");
    for (int t = cache.newest(); t >= 0; t = cache.olderThan(t)) { printf(" %d", cache.keyAt(t)); }
    println("");
    printf("peek(27) = %d does not change the order, has(6171) = %d, size %d\n", cache.peek(27, -1), cache.has(6171), cache.size());

    cache.setCapacity(1);                            // shrinking evicts the oldest entries
    printf("capacity %d, size %d, left: %d\n", cache.capacity(), cache.size(), cache.keyAt(cache.newest()));

    // text keys: TextLruCache copies them
    ds.TextLruCache names(2);
    names.put("ada", 1); names.put("grace", 2);
    names.get("ada", 0);                             // ada is now newer than grace
    names.put("linus", 3);                           // grace is the oldest: out
    printf("ada %d, grace %d, linus %d\n", names.has("ada"), names.has("grace"), names.has("linus"));
    println("dispose also tells the handler about the entries that are left:");
    cache.dispose(); names.dispose();
    return 0;
}
