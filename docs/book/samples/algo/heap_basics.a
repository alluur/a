// A binary heap: smallest first, largest first, merge and drain
import ds;

// odd numbers come out before even ones; inside each group the smaller first
int oddFirst(int x, int y) {
    int px = x % 2 == 1 ? 0 : 1;
    int py = y % 2 == 1 ? 0 : 1;
    if (px != py) { return px - py; }
    return x - y;
}

int main() {
    ds.BinaryHeap h();                               // smallest key first
    int keys[7] = {42, 7, 19, 3, 25, 11, 3};
    foreach (int k in keys) { h.push(k, k * 10); }   // push(key, value): the value travels with the key
    printf("size %d, smallest key %d (value %d)\n", h.size(), h.peek(), h.peekValue());

    printf("pop order:");
    while (!h.isEmpty()) { printf(" %d", h.pop()); } // pop() returns the key, popValue() the value
    println("");                                     // both 3s come out, in no particular order

    // ds.cmpDesc turns it into a max-heap
    ds.BinaryHeap big(ds.cmpDesc);
    foreach (int k in keys) { big.push(k); }         // the value is optional
    printf("largest first:");
    int sorted[7];
    int n = big.drain(sorted, null);                 // drain pops everything into an array
    for (int i = 0; i < n; i++) { printf(" %d", sorted[i]); }
    println("");

    // your own order: a comparator is a function int cmp(int a, int b)
    ds.BinaryHeap odd(oddFirst);
    foreach (int k in 1..=8) { odd.push(k); }
    printf("odd numbers first:");
    while (!odd.isEmpty()) { printf(" %d", odd.pop()); }
    println("");

    // merge moves all elements of another heap in
    ds.BinaryHeap a();
    ds.BinaryHeap b();
    foreach (int k in 1..=5) { a.push(k * 10); b.push(k * 10 + 5); }
    a.merge(&b);
    printf("merged: size %d, b is now empty: %d, order:", a.size(), b.isEmpty());
    while (!a.isEmpty()) { printf(" %d", a.pop()); }
    println("");
    h.dispose(); big.dispose(); odd.dispose(); a.dispose(); b.dispose();
    return 0;
}
