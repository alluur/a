// Union-find (DisjointSet): groups, sizes, and the cheapest cabling
import ds;

int main() {
    // ten offices; a cable joins two of them
    ds.DisjointSet net(10);
    int a[6] = {0, 1, 3, 4, 6, 7};
    int b[6] = {1, 2, 4, 5, 7, 8};
    for (int i = 0; i < 6; i++) { net.unite(a[i], b[i]); }
    printf("%d groups after 6 cables; office 2 is with 0: %d, with 3: %d\n", net.groups, net.same(0, 2), net.same(0, 3));
    printf("group sizes: office 0 -> %d, office 3 -> %d, office 9 -> %d\n", net.sizeOf(0), net.sizeOf(3), net.sizeOf(9));
    printf("a seventh cable 0-2 joins anything new: %d\n", net.unite(0, 2));

    int label[10];
    int g = net.labels(label);                       // numbers the groups 0 .. g-1 in order of their first office
    printf("labels (%d groups):", g);
    foreach (int l in label) { printf(" %d", l); }
    println("");

    int extra = net.add();                           // the set can grow: a new office in a group of its own
    net.unite(extra, 9);
    printf("new office %d, now %d offices in %d groups\n", extra, net.count(), net.groups);

    // Kruskal's minimum spanning tree: take the cheapest cable that joins two different groups
    int from[7] = {0, 0, 1, 1, 2, 3, 3};
    int to[7]   = {1, 2, 2, 3, 4, 4, 5};
    int cost[7] = {7, 5, 9, 8, 7, 15, 6};
    ds.BinaryHeap cables();
    for (int i = 0; i < 7; i++) { cables.push(cost[i], i); }   // the key is the price, the value the cable number
    ds.DisjointSet tree(6);
    int total = 0;
    while (!cables.isEmpty()) {
        int price = cables.peek();
        int c = cables.popValue();
        if (tree.unite(from[c], to[c])) {
            printf("  lay cable %d-%d for %d\n", from[c], to[c], price);
            total += price;
        }
    }
    printf("total cost %d, all connected: %d\n", total, tree.groups == 1);
    net.dispose(); cables.dispose(); tree.dispose();
    return 0;
}
