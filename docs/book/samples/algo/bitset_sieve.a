// A bit set: the sieve of Eratosthenes and set operations
import ds;

void show(char* label, ds.BitSet* s) {
    printf("%-26s %2d:", label, s->count());
    for (int i = s->nextSet(0); i >= 0; i = s->nextSet(i + 1)) { printf(" %d", i); }   // walk the 1 bits in order
    println("");
}

int main() {
    ds.BitSet prime(100);                            // bits 0 .. 99, all 0 at the start
    prime.setAll();
    prime.unset(0);
    prime.unset(1);
    for (int i = 2; i * i < 100; i++) {
        if (prime.get(i)) {
            for (int j = i * i; j < 100; j += i) { prime.unset(j); }   // cross out the multiples
        }
    }
    show("primes below 100", &prime);
    printf("primes in 50..99: %d (countRange(50, 100) is half open), last prime <= 60: %d, first non-prime at or after 2: %d\n",
           prime.countRange(50, 100), prime.prevSet(60), prime.nextClear(2));

    // set operations work on whole 64 bit words at a time
    ds.BitSet low(100);
    low.setRange(0, 30);                             // bits 0 .. 29: the end is not included
    ds.BitSet endsIn3(100);
    for (int i = 3; i < 100; i += 10) { endsIn3.set(i); }

    ds.BitSet both(100);
    both.copyFrom(&prime);
    both.andWith(&low);
    show("primes below 30", &both);
    both.copyFrom(&prime);
    both.andWith(&endsIn3);
    show("primes ending in 3", &both);
    both.copyFrom(&endsIn3);
    both.andNotWith(&prime);
    show("ends in 3, not prime", &both);
    both.copyFrom(&low);
    both.xorWith(&endsIn3);
    printf("low xor endsIn3: %d bits, low is a subset of prime: %d, they intersect: %d\n", both.count(), low.isSubsetOf(&prime), low.intersects(&prime));

    // a bit set can grow; the new bits are 0
    ds.BitSet flags(10);
    flags.set(9);
    flags.resize(70);
    flags.set(69);
    flags.flip(9);
    int ones[4];
    int n = flags.toArray(ones, 4);
    printf("flags: size %d, count %d, toArray gives %d number(s): %d\n", flags.size(), flags.count(), n, ones[0]);
    prime.dispose(); low.dispose(); endsIn3.dispose(); both.dispose(); flags.dispose();
    return 0;
}
