// The random generators: same seed, same numbers
import rng;

void show(char* name, rng.Rng* g) {
    printf("%-22s", name);
    for (int i = 0; i < 3; i++) { printf(" %u", g->nextU64()); }
    println("");
}

int main() {
    // every generator is a class derived from rng.Rng and has its own state: nothing is shared
    rng.SplitMix64 sm(1234567);
    rng.Xoshiro256 xo(1);
    rng.Pcg32 pcg32(42, 54);                         // seed and stream; 42, 54 are the defaults
    rng.Pcg64 pcg64(42, 54);
    rng.Mt19937 mt(5489);                            // the default seed of the Mersenne Twister
    show("SplitMix64(1234567)", &sm);
    show("Xoshiro256(1)", &xo);
    show("Pcg32(42, 54)", &pcg32);
    show("Pcg64(42, 54)", &pcg64);
    show("Mt19937(5489)", &mt);

    // Pcg32 and Mt19937 make 32 bit numbers natively
    rng.Pcg32 p(42, 54);
    printf("Pcg32 nextU32: %x %x %x (the first values of the reference C code)\n", p.nextU32(), p.nextU32(), p.nextU32());
    rng.Mt19937 m(5489);
    printf("Mt19937 nextU32: %u %u %u (the reference output)\n", m.nextU32(), m.nextU32(), m.nextU32());

    // Mersenne Twister with Python's seeding gives Python's random.random()
    rng.Mt19937 py(0);
    py.seedPython(12345);
    printf("Python's random.seed(12345); random.random() = %s\n", doubleToFixed(py.nextDouble(), 15));

    // two generators with the same seed are in step; a different seed or jump() gives a different stream
    rng.Xoshiro256 a(2024);
    rng.Xoshiro256 b(2024);
    rng.Xoshiro256 c(2025);
    rng.Xoshiro256 d(2024);
    d.jump();                                        // skips 2^128 numbers: the start of a stream that cannot overlap
    printf("seed 2024 twice: %d %d, seed 2025: %d, after jump(): %d\n", a.below(1000), b.below(1000), c.below(1000), d.below(1000));

    // the state can be read and written to continue later
    rng.Xoshiro256 e(7);
    e.nextU64();
    rng.Xoshiro256 copy(0);
    copy.setState(e.getState(0), e.getState(1), e.getState(2), e.getState(3));
    printf("copied state: %u and %u\n", e.nextU64(), copy.nextU64());
    return 0;
}
