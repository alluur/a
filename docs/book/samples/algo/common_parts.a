// What two texts have in common: subsequence, substring, prefix and suffix
import strx;

int main() {
    char* a = "the quick brown fox";
    char* b = "a quick brown dog and the fox";

    // longest common SUBSEQUENCE: letters in the same order, gaps allowed
    int len = 0;
    char* common = strx.lcs(a, -1, b, -1, &len);     // a new text: free it with strx.freeText
    printf("lcs length %d, text \"%s\"\n", strx.lcsLength(a, -1, b, -1), common);
    strx.freeText(common);
    printf("lcs of ABCBDAB and BDCABA has length %d\n", strx.lcsLength("ABCBDAB", -1, "BDCABA", -1));

    // longest common SUBSTRING: one unbroken run
    int startA = 0;
    int startB = 0;
    int n = strx.longestCommonSubstring(a, -1, b, -1, &startA, &startB);
    printf("longest common substring: %d bytes, at %d in the first text and at %d in the second: \"%.*s\"\n", n, startA, startB, n, a + startA);

    // common beginning and end
    printf("common prefix of \"interview\" and \"internet\": %d bytes, common suffix of \"walking\" and \"talking\": %d bytes\n",
           strx.commonPrefix("interview", -1, "internet", -1), strx.commonSuffix("walking", -1, "talking", -1));

    // LCS is what a diff is made from: the length of the shorter edit script
    char* v1 = "AGGTAB";
    char* v2 = "GXTXAYB";
    int keep = strx.lcsLength(v1, -1, v2, -1);
    printf("%s -> %s: keep %d letters, delete %d, insert %d\n", v1, v2, keep, 6 - keep, 7 - keep);
    return 0;
}
