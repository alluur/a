// A task scheduler: a priority queue with handles
import ds;

char* names[8] = {"backup", "send mail", "compile", "update docs", "deploy", "clean cache", "run tests", "reboot"};
int priority[8] = {5, 3, 2, 4, 1, 5, 2, 1};          // 1 is the most urgent

// one number orders the queue: priority first, then arrival order, so equal priorities run first come first served
int keyOf(int prio, int arrival) { return prio * 1000 + arrival; }

int main() {
    ds.PriorityQueue pq();
    int handle[8];                                   // a handle names an element for as long as it is in the queue
    for (int i = 0; i < 8; i++) {
        handle[i] = pq.enqueue(keyOf(priority[i], i), i);
    }
    printf("%d tasks queued, next up: %s\n", pq.size(), names[pq.peekValue()]);

    // the user bumps "update docs" to the top: decrease-key through the handle
    pq.update(handle[3], keyOf(0, 3));
    // "reboot" is cancelled: remove from the middle of the queue
    bool removed = pq.remove(handle[7]);
    printf("cancelled reboot: %d; second cancel: %d\n", removed, pq.remove(handle[7]));
    printf("handle of reboot still valid: %d, of deploy: %d\n", pq.contains(handle[7]), pq.contains(handle[4]));

    int order = 0;
    while (!pq.isEmpty()) {
        int key = pq.peekPriority();
        int task = pq.dequeue();                     // the value that was stored with the key
        order++;
        printf("%d. %-12s priority %d, arrival %d\n", order, names[task], key / 1000, key % 1000);
    }
    pq.dispose();
    return 0;
}
