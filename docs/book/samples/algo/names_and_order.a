// Names that sound alike, and file names in natural order
import strx;
import sort;

int main() {
    // Soundex: a four character code for the English sound of a name
    char* names[8] = {"Robert", "Rupert", "Rubin", "Ashcraft", "Ashcroft", "Tymczak", "Pfister", "Smith"};
    char code[8];
    foreach (char* n in names) {
        strx.soundex(n, code);                       // the code needs room for 5 bytes
        printf("%-9s %s\n", n, code);
    }
    printf("Robert and Rupert sound alike: %d, Robert and Rubin: %d, Smith and Smyth: %d\n",
           strx.soundexEqual("Robert", "Rupert"), strx.soundexEqual("Robert", "Rubin"), strx.soundexEqual("Smith", "Smyth"));

    // the usual string order puts img10 before img2; natural order compares digit runs by value
    char* files[8] = {"img10.png", "img2.png", "img1.png", "Img3.png", "img20.png", "img02.png", "img100.png", "img11.png"};
    printf("does img2 come before img10? strcmp: %d, natural order: %d\n", strcmp("img2", "img10") < 0, strx.naturalCompare("img2", "img10") < 0);
    printf("img1 vs img01: %d (fewer leading zeros first), Img3 vs img3 with ignoreCase: %d\n",
           strx.naturalCompare("img1", "img01"), strx.naturalCompare("Img3", "img3", true));

    char* plain[8];
    char* natural[8];
    for (int i = 0; i < 8; i++) { plain[i] = files[i]; natural[i] = files[i]; }
    sort.sortStrings(plain, 8);
    strx.naturalSort(natural, 8, true);              // true: ignore case
    printf("%-14s %s\n", "sortStrings", "naturalSort");
    for (int i = 0; i < 8; i++) { printf("%-14s %s\n", plain[i], natural[i]); }
    return 0;
}
