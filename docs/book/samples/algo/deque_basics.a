// A deque: add and remove at both ends
import ds;

void show(char* label, ds.Deque* d) {
    printf("%-20s", label);
    foreach (int v in d) { printf(" %d", v); }       // foreach works: Deque has size() and get(i)
    printf("   (size %d)\n", d->size());
}

int main() {
    ds.Deque d(4);                                   // with parentheses: the constructor must run (the capacity is at least 8)
    d.pushBack(10); d.pushBack(20); d.pushBack(30);
    d.pushFront(5);                                  // O(1) at the front as well
    show("four pushes", &d);
    printf("front %d, back %d, get(2) = %d\n", d.front(), d.back(), d.get(2));

    int first = d.popFront();
    int last = d.popBack();
    printf("popFront %d, popBack %d\n", first, last);
    show("after two pops", &d);

    d.insertAt(1, 15);                               // O(n): the elements behind it move
    d.insertAt(0, 1);
    show("two inserts", &d);
    int gone = d.removeAt(2);
    printf("removeAt(2) = %d, indexOf(20) = %d, has(99) = %d\n", gone, d.indexOf(20), d.has(99));

    // as a queue the deque wraps around inside its buffer: 1000 numbers pass through and the capacity stays at its minimum, 8
    ds.Deque q(4);
    int total = 0;
    for (int i = 1; i <= 1000; i++) {
        q.pushBack(i);
        if (q.size() > 3) { total += q.popFront(); }
    }
    printf("queue: 1000 numbers passed through, capacity %d, sum popped %d\n", q.capacity(), total);

    // bad indexes and an empty deque give 0 or false, they do not crash
    ds.Deque e(2);
    printf("empty: popFront %d, front %d, get(5) %d, insertAt(3, 1) %d\n", e.popFront(), e.front(), e.get(5), e.insertAt(3, 1));
    d.dispose(); q.dispose(); e.dispose();           // give the memory back
    return 0;
}
