// A Bloom filter and a count-min sketch: answers from a small fixed amount of memory
import ds;

int main() {
    // Bloom filter: "have we seen this user name?" for 500 names with about 1 false alarm in 100
    ds.BloomFilter taken(500, 100);
    printf("filter: %d bits (%d bytes), %d hash functions\n", taken.bitCount(), taken.bitCount() / 8, taken.hashCount());
    char name[32];
    for (int i = 0; i < 500; i++) {
        format(name, 32, "user%d", i);
        taken.addText(name);
    }
    int missing = 0;                                 // a Bloom filter never forgets a key it was given
    for (int i = 0; i < 500; i++) {
        format(name, 32, "user%d", i);
        if (!taken.mightContainText(name)) { missing++; }
    }
    int falseAlarms = 0;                             // but it may claim to know a key it never saw
    for (int i = 500; i < 10500; i++) {
        format(name, 32, "user%d", i);
        if (taken.mightContainText(name)) { falseAlarms++; }
    }
    printf("added %d names, forgotten %d, false alarms %d of 10000 (%d.%02d%%)\n", taken.count(), missing, falseAlarms, falseAlarms / 100, falseAlarms % 100);
    printf("filter is %d per thousand full, estimated false alarm rate %d per million\n", taken.fillPermille(), taken.falsePositivePpm());

    // count-min sketch: approximate counts of 1000 different keys in only 272 * 5 counters
    ds.CountMinSketch hits(272, 5);
    int exact[1000];
    for (int i = 0; i < 1000; i++) { exact[i] = 0; }
    int seed = 12345;                                // a tiny home made generator: the stream is the same everywhere
    for (int i = 0; i < 5000; i++) {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        int roll = (seed >> 8) % 100;
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        int key = (roll < 60) ? (seed >> 8) % 5 : 5 + (seed >> 8) % 995;   // 60% of the events hit five hot keys
        hits.add(key);
        exact[key]++;
    }
    printf("%d events counted; the hot keys (an estimate is never too small):\n", hits.total());
    for (int k = 0; k < 5; k++) { printf("  key %d: exact %d, estimate %d\n", k, exact[k], hits.estimate(k)); }
    int worst = 0;
    for (int k = 5; k < 1000; k++) {
        int over = hits.estimate(k) - exact[k];
        if (over > worst) { worst = over; }
    }
    printf("the largest overestimate of a cold key is %d, a key that never occurred: estimate %d\n", worst, hits.estimate(123456789));
    taken.dispose(); hits.dispose();
    return 0;
}
