// Distributions: normal, exponential, gamma, beta, Poisson, binomial and more
import rng;

const KINDS = 12;
char* names[KINDS] = {"normal()", "normalAt(100, 15)", "lognormal(0, 0.5)", "exponential()", "exponentialRate(2)", "gamma(2.5)",
                      "gammaAt(2, 3)", "beta(2, 5)", "chiSquared(3)", "poisson(4.5)", "binomial(20, 0.3)", "geometric(0.25)"};
double expected[KINDS] = {0.0, 100.0, 1.1331485, 1.0, 0.5, 2.5, 6.0, 0.2857143, 3.0, 4.5, 6.0, 4.0};

double draw(rng.Rng* g, int kind) {
    if (kind == 0) { return g->normal(); }
    if (kind == 1) { return g->normalAt(100.0, 15.0); }
    if (kind == 2) { return g->lognormal(0.0, 0.5); }
    if (kind == 3) { return g->exponential(); }
    if (kind == 4) { return g->exponentialRate(2.0); }
    if (kind == 5) { return g->gamma(2.5); }
    if (kind == 6) { return g->gammaAt(2.0, 3.0); }
    if (kind == 7) { return g->beta(2.0, 5.0); }
    if (kind == 8) { return g->chiSquared(3.0); }
    if (kind == 9) { return g->poisson(4.5); }          // integer results convert to double
    if (kind == 10) { return g->binomial(20, 0.3); }
    return g->geometric(0.25);                          // 1, 2, 3 ...: the trial of the first success
}

// the last three distributions give whole numbers: show them without decimals
char* fmt(double v, int kind) { return doubleToFixed(v, kind >= 9 ? 0 : 3); }

int main() {
    rng.Pcg64 g(2024, 7);                            // any generator works: the methods live in rng.Rng
    printf("%-20s %-26s %9s %9s\n", "distribution", "first three draws", "mean of N", "expected");
    for (int kind = 0; kind < KINDS; kind++) {
        double first[3];
        double sum = 0.0;
        int n = 2000;
        for (int i = 0; i < n; i++) {
            double v = draw(&g, kind);
            if (i < 3) { first[i] = v; }
            sum += v;
        }
        printf("%-20s %8s %8s %8s %9s %9s\n", names[kind], fmt(first[0], kind), fmt(first[1], kind), fmt(first[2], kind),
               doubleToFixed(sum / n, 3), doubleToFixed(expected[kind], 3));
    }

    // a bell curve drawn with text: 20000 normal numbers, counted in bins of width 1 around the whole numbers -4 .. 4
    int bin[9];
    for (int i = 0; i < 9; i++) { bin[i] = 0; }
    for (int i = 0; i < 20000; i++) {
        double v = g.normal();
        if (v > -4.5 && v < 4.5) { bin[(int) (v + 4.5)]++; }
    }
    println("normal(): how many draws fall within 0.5 of each whole number (one # = 200 draws)");
    for (int i = 0; i < 9; i++) {
        printf("  %2d: %5d", i - 4, bin[i]);
        if (bin[i] >= 200) { printChar(' '); }
        for (int k = 0; k < bin[i] / 200; k++) { printChar('#'); }
        println("");
    }
    return 0;
}
