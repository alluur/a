// Secure random numbers, seeds from the system, and UUIDs
import rng;

// a version 4 UUID looks like xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx with y in 8, 9, a or b
bool looksLikeUuid4(char* u) {
    if (strlen(u) != 36) { return false; }
    if (u[8] != '-' || u[13] != '-' || u[18] != '-' || u[23] != '-') { return false; }
    if (u[14] != '4') { return false; }
    return u[19] == '8' || u[19] == '9' || u[19] == 'a' || u[19] == 'b';
}

int main() {
    // ChaCha20Rng with a key: a fixed sequence (here the bytes 0, 1, 2 ... 31 as the key; a real key must be secret and random)
    char key[32];
    foreach (int i in 0..32) { key[i] = i; }
    rng.ChaCha20Rng a(key);
    rng.ChaCha20Rng b(key);
    uint64 w0 = a.nextU64();
    uint64 w1 = a.nextU64();
    uint64 w2 = a.nextU64();
    printf("ChaCha20 with a fixed key: %u %u %u\n", w0, w1, w2);
    printf("a second generator with the same key starts the same way: %d\n", b.nextU64() == w0);

    // the same methods as every other generator
    printf("dice from ChaCha20:");
    foreach (int i in 0..10) { printf(" %d", a.uniformInt(1, 6)); }
    println("");

    // without a key it is seeded by the operating system: different on every run, so we only check its shape
    rng.ChaCha20Rng sys;                             // lazily seeded from the system on first use
    uint64 x = sys.nextU64();
    uint64 y = sys.nextU64();
    printf("system seeded: two draws differ: %d\n", x != y);

    // rng.systemSeed() is a good seed for a fast generator; keep it if you want to repeat the run
    uint64 seed = rng.systemSeed();
    rng.Xoshiro256 g1(seed);
    rng.Xoshiro256 g2(seed);
    printf("a generator seeded from systemSeed() and a copy with the same seed agree: %d\n", g1.nextU64() == g2.nextU64());

    // UUIDs: from the system generator, or from a seeded one (then they repeat)
    char u1[40];
    char u2[40];
    rng.uuid4(u1);                                   // needs 37 bytes: 36 characters and the final 0
    rng.uuid4(u2);
    printf("rng.uuid4: looks like a UUID: %d, two UUIDs differ: %d\n", looksLikeUuid4(u1), strcmp(u1, u2) != 0);
    rng.Xoshiro256 fixed(1);
    fixed.uuid4(u1);
    printf("from Xoshiro256(1): %s (%d)\n", u1, looksLikeUuid4(u1));
    a.dispose(); b.dispose(); sys.dispose();         // dispose wipes the key
    return 0;
}
