// Fenwick trees: prefix sums that change, and range updates
import ds;

int main() {
    // sales per day for two weeks; a Fenwick tree answers "how much between day a and day b" in O(log n)
    int sales[14] = {12, 7, 0, 25, 14, 9, 30, 11, 8, 22, 0, 17, 5, 19};
    ds.Fenwick f(14);
    f.build(sales, 14);
    printf("total %d, days 0..6: %d, days 7..13: %d, day 3 alone: %d\n", f.total(), f.sum(0, 6), f.sum(7, 13), f.get(3));
    printf("prefix(5) = %d, sum(4, 9) = %d  (both ends are included)\n", f.prefix(5), f.sum(4, 9));

    f.add(2, 40);                                    // a late order for day 2
    printf("after adding 40 to day 2: total %d, days 0..6: %d\n", f.total(), f.sum(0, 6));
    f.set(10, 3);                                    // overwrite instead of add
    printf("day 10 is now %d, total %d\n", f.get(10), f.total());

    // lowerBound(target): the first day on which the running total reaches the target (elements must not be negative)
    printf("the running total first reaches 100 on day %d, 200 on day %d, 1000 never: %d (= size)\n", f.lowerBound(100), f.lowerBound(200), f.lowerBound(1000));

    // a RangeFenwick changes whole ranges at once: add to days l..r, then ask for sums
    ds.RangeFenwick r(10);
    r.add(0, 9, 1);                                  // every day starts with 1
    r.add(3, 6, 10);                                 // a promotion from day 3 to day 6
    r.add(5, 9, -2);
    printf("per day:");
    for (int i = 0; i < 10; i++) { printf(" %d", r.get(i)); }
    println("");
    printf("sum(0, 9) = %d, sum(3, 5) = %d, prefix(2) = %d\n", r.sum(0, 9), r.sum(3, 5), r.prefix(2));
    f.dispose(); r.dispose();
    return 0;
}
