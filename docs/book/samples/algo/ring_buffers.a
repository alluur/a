// Ring buffers: a sliding window of ints and a byte FIFO
import ds;

int main() {
    // keep the last 4 readings; the oldest one is overwritten by default
    ds.RingBuffer window(4);
    int readings[10] = {12, 15, 11, 18, 20, 17, 25, 22, 19, 30};
    foreach (int i, int r in readings) {
        window.push(r);
        int sum = 0;
        foreach (int v in window) { sum += v; }      // get(0) is the oldest element
        if (i >= 3) { printf("reading %2d: window sum %3d, average %d\n", r, sum, sum / window.size()); }
    }
    printf("newest %d, one before %d, oldest %d, overwritten %d\n",
           window.fromNewest(0), window.fromNewest(1), window.peek(), window.overwritten);

    // the same ring can refuse new elements instead (drop-newest policy)
    ds.RingBuffer queue(3, false);
    for (int i = 1; i <= 5; i++) { queue.push(i * 100); }
    printf("refusing ring: size %d, rejected %d, pop %d then %d\n", queue.size(), queue.rejected, queue.pop(), queue.pop());

    // ByteRing is the same idea for bytes: a serial or network buffer
    ds.ByteRing rx(8);
    int took = rx.write("HELLO!", 6);
    int extra = rx.write("world", 5);                // only 2 bytes fit: the rest is counted as dropped
    printf("write 6 -> %d, write 5 -> %d, available %d, dropped %d\n", took, extra, rx.available(), rx.dropped);
    char buf[16];
    int n = rx.peek(buf, 3);                         // peek does not remove
    buf[n] = 0;
    printf("peek: %s, still available %d\n", buf, rx.available());
    n = rx.read(buf, 20);
    buf[n] = 0;
    printf("read: %s (%d bytes), available %d, space %d\n", buf, n, rx.available(), rx.space());
    window.dispose(); queue.dispose(); rx.dispose();
    return 0;
}
