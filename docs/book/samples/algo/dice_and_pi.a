// Integers and doubles from a generator: dice, coins and Monte Carlo pi
import rng;

int main() {
    rng.Xoshiro256 g(2024);                          // a fixed seed: the same numbers on every run and every target

    // below(n) is 0 .. n-1 without modulo bias; uniformInt(lo, hi) includes both ends
    int count[7];
    for (int i = 0; i < 7; i++) { count[i] = 0; }
    for (int i = 0; i < 6000; i++) { count[g.uniformInt(1, 6)]++; }
    println("6000 rolls of a die:");
    for (int face = 1; face <= 6; face++) {
        printf("  %d: %4d ", face, count[face]);
        for (int i = 0; i < count[face] / 50; i++) { printChar('#'); }
        println("");
    }
    printf("below(10) x 8:");
    for (int i = 0; i < 8; i++) { printf(" %d", g.below(10)); }
    println("");
    printf("uniformInt(-5, 5) x 8:");
    for (int i = 0; i < 8; i++) { printf(" %d", g.uniformInt(-5, 5)); }
    println("");

    // coins: nextBool is a fair coin, bernoulli(p) is true with probability p
    int heads = 0;
    int rare = 0;
    for (int i = 0; i < 10000; i++) {
        if (g.nextBool()) { heads++; }
        if (g.bernoulli(0.1)) { rare++; }
    }
    printf("10000 fair coins: %d heads; bernoulli(0.1) was true %d times\n", heads, rare);

    // doubles: nextDouble() is in [0, 1) with 53 random bits, uniform(a, b) in [a, b)
    printf("nextDouble:");
    for (int i = 0; i < 3; i++) { printf(" %s", doubleToFixed(g.nextDouble(), 6)); }
    printf("\nuniform(10, 20):");
    for (int i = 0; i < 3; i++) { printf(" %s", doubleToFixed(g.uniform(10.0, 20.0), 4)); }
    println("");

    // Monte Carlo: the share of random points of the unit square that fall inside the quarter circle is pi / 4
    int inside = 0;
    int shots = 100000;
    for (int i = 0; i < shots; i++) {
        double x = g.nextDouble();
        double y = g.nextDouble();
        if (x * x + y * y < 1.0) { inside++; }
    }
    double pi = 4.0 * inside / shots;
    printf("pi from %d points: %d inside, estimate %s (true value 3.14159...)\n", shots, inside, doubleToFixed(pi, 4));
    return 0;
}
