// A shuffled deck: shuffle, deal and count the pairs
import rng;

char* ranks = "A23456789TJQK";
char* suits = "SHDC";                               // spades, hearts, diamonds, clubs

void showCard(int c) { printf(" %c%c", ranks[c % 13], suits[c / 13]); }

int main() {
    int deck[52];
    foreach (int i in 0..52) { deck[i] = i; }        // 0..12 spades, 13..25 hearts ...

    rng.Xoshiro256 g(31415);
    g.shuffle(deck, 52);                             // Fisher-Yates: every order is equally likely
    printf("top 13 cards:");
    foreach (int i in 0..13) { showCard(deck[i]); }
    println("");

    // deal four hands of five cards from the top
    for (int hand = 0; hand < 4; hand++) {
        printf("hand %d:", hand + 1);
        int seen[13];
        foreach (int i in 0..13) { seen[i] = 0; }
        foreach (int i in 0..5) {
            int c = deck[hand * 5 + i];
            showCard(c);
            seen[c % 13]++;
        }
        int pairs = 0;
        foreach (int n in seen) { if (n >= 2) { pairs++; } }
        printf("   %s\n", pairs > 0 ? "has a pair or better" : "no pair");
    }

    // how likely is a pair in the first five cards? shuffle many times and count
    int withPair = 0;
    int games = 2000;
    for (int game = 0; game < games; game++) {
        g.shuffle(deck, 52);
        int seen[13];
        foreach (int i in 0..13) { seen[i] = 0; }
        bool pair = false;
        foreach (int i in 0..5) { if (++seen[deck[i] % 13] >= 2) { pair = true; } }
        if (pair) { withPair++; }
    }
    printf("a pair or better in %d of %d games (the exact probability is about 49.3%%)\n", withPair, games);

    // shuffleItems shuffles anything of a fixed size: here four 3-letter words (4 bytes each)
    char words[16] = "cat\0dog\0emu\0fox\0";
    g.shuffleItems(words, 4, 4);
    printf("shuffled words: %s %s %s %s\n", &words[0], &words[4], &words[8], &words[12]);
    return 0;
}
