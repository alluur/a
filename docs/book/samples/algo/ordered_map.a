// An ordered map: neighbours, rank, ranges
import ds;

int printEntry(int key, int value, int ctx) {        // a callback for forEachRange: return 0 to go on
    printf("  from %d kg: %d%% discount\n", key, value);
    return 0;
}

int main() {
    // discount tiers: from this order weight (kg) on, this many percent
    ds.OrderedMap tiers();
    tiers.put(0, 0);  tiers.put(50, 5);  tiers.put(100, 10);  tiers.put(250, 15);  tiers.put(500, 20);
    printf("%d tiers, smallest %d, largest %d\n", tiers.size(), tiers.firstKey(), tiers.lastKey());

    // floorKey: the largest key <= x is the tier that applies
    int weights[5] = {20, 50, 99, 260, 900};
    foreach (int w in weights) {
        printf("order of %3d kg: tier from %3d kg, discount %d%%\n", w, tiers.floorKey(w), tiers.get(tiers.floorKey(w)));
    }
    printf("next tier after 100: %d, before 100: %d, ceil(101): %d, none above 500: %d\n",
           tiers.higherKey(100), tiers.lowerKey(100), tiers.ceilKey(101), tiers.higherKey(500, -1));

    // rank = how many keys are smaller; select(i) = the node of the i-th key
    printf("rank(100) = %d, rank(101) = %d, the 4th tier starts at %d kg\n", tiers.rank(100), tiers.rank(101), tiers.keyAt(tiers.select(3)));
    printf("tiers starting in 50..250: %d\n", tiers.countRange(50, 250));

    println("forEachRange(60, 600):");
    tiers.forEachRange(60, 600, printEntry, 0);

    // walking the nodes in order, and changing a value through its node number
    int node = tiers.find(250);
    tiers.setValueAt(node, 17);
    printf("tier 250 now gives %d%%; all tiers:", tiers.get(250));
    for (int t = tiers.firstNode(); t >= 0; t = tiers.nextNode(t)) { printf(" %d:%d", tiers.keyAt(t), tiers.valueAt(t)); }
    println("");

    tiers.remove(50);
    tiers.removeLast();
    printf("after removing two tiers: size %d, balanced: %d, height %d\n", tiers.size(), tiers.verify(), tiers.height());

    // a different order: biggest key first (ds.cmpDesc is a comparator)
    ds.OrderedMap reverse(ds.cmpDesc);
    foreach (int k in 1..=5) { reverse.put(k * k, k); }
    int keys[5];
    int n = reverse.toArrays(keys, null);
    printf("descending:");
    for (int i = 0; i < n; i++) { printf(" %d", keys[i]); }
    println("");
    tiers.dispose(); reverse.dispose();
    return 0;
}
