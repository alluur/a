// A segment tree: range minimum, maximum and sum with range updates
import ds;

int main() {
    int temp[10] = {14, 9, 17, 20, 12, 8, 15, 22, 19, 11};   // temperatures over ten hours

    ds.SegTree hi(10, ds.SEG_MAX);                   // ds.SEG_SUM, ds.SEG_MIN and ds.SEG_MAX
    ds.SegTree lo(10, ds.SEG_MIN);
    ds.SegTree sum(10, ds.SEG_SUM);
    hi.build(temp, 10);
    lo.build(temp, 10);
    sum.build(temp, 10);
    printf("hours 2..5: max %d, min %d, sum %d\n", hi.query(2, 5), lo.query(2, 5), sum.query(2, 5));
    printf("all hours:  max %d, min %d, sum %d (total() is the same)\n", hi.total(), lo.total(), sum.total());

    // add to a range: the whole range gets 3 degrees warmer in O(log n), the tree does not touch every element
    hi.add(4, 7, 3);
    lo.add(4, 7, 3);
    sum.add(4, 7, 3);
    printf("after +3 on hours 4..7: max %d, min %d, sum %d\n", hi.total(), lo.total(), sum.total());
    printf("hour 7 is now %d (was %d)\n", hi.get(7), temp[7]);

    // assign a value to a range: a sensor was broken, hours 0..2 are set to 10
    hi.assign(0, 2, 10);
    lo.assign(0, 2, 10);
    sum.assign(0, 2, 10);
    printf("after assign 10 to hours 0..2: max %d, min %d, sum %d\n", hi.total(), lo.total(), sum.total());

    // ranges are clipped to the tree; an empty range gives the neutral value
    printf("query(8, 100) = %d (clipped to 8..9), query(5, 4) = %d (empty sum)\n", sum.query(8, 100), sum.query(5, 4));
    printf("empty max range: %d, empty min range: %d\n", hi.query(5, 4), lo.query(5, 4));

    // a classic use: the warmest stretch of three hours, using range sums
    int best = 0;
    int bestStart = 0;
    for (int start = 0; start + 3 <= 10; start++) {
        int s = sum.query(start, start + 2);
        if (s > best) { best = s; bestStart = start; }
    }
    printf("warmest three hours start at hour %d (sum %d)\n", bestStart, best);
    hi.dispose(); lo.dispose(); sum.dispose();
    return 0;
}
