// Sampling without repeats: lottery numbers, huge ranges and streams
import rng;

void show(char* label, int* a, int n) {
    printf("%-28s", label);
    for (int i = 0; i < n; i++) { printf(" %d", a[i]); }
    println("");
}

int main() {
    rng.Xoshiro256 g(1999);
    int pick[10];

    // sample(n, k, out): k different numbers from 0 .. n-1 in random order; false when k > n
    g.sample(49, 6, pick);
    show("6 of 0..48, random order:", pick, 6);
    g.sampleSorted(49, 6, pick);
    show("6 of 0..48, sorted:", pick, 6);
    printf("sample(5, 6, ...) is refused: %d\n", g.sample(5, 6, pick));

    // Floyd's algorithm uses O(k) memory however large n is: no table of a trillion numbers
    g.sampleSorted(1000000000000, 5, pick);
    show("5 of 0..10^12-1, sorted:", pick, 5);

    // every number should have the same chance: 6 of 49, 20000 draws, how often does each number appear?
    int seen[49];
    foreach (int i in 0..49) { seen[i] = 0; }
    for (int draw = 0; draw < 20000; draw++) {
        g.sample(49, 6, pick);
        foreach (int i in 0..6) { seen[pick[i]]++; }
    }
    int lo = seen[0];
    int hi = seen[0];
    foreach (int c in seen) { if (c < lo) { lo = c; } if (c > hi) { hi = c; } }
    printf("each number should appear about %d times: least %d, most %d\n", 20000 * 6 / 49, lo, hi);

    // a reservoir keeps k random items of a stream whose length you do not know in advance
    rng.ReservoirSampler r(5);
    for (int i = 1; i <= 100000; i++) { r.offer(&g, i); }
    printf("reservoir of %d from a stream of %d:", r.size(), r.offered());
    for (int i = 0; i < r.size(); i++) { printf(" %d", r.get(i)); }
    println("");
    r.dispose();
    return 0;
}
