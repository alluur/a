// A suffix array: every substring question in O(pattern * log n)
import strx;

int main() {
    char* text = "banana";
    strx.SuffixArray sa(text);                       // built in linear time; it keeps its own copy of the text
    printf("suffixes of \"%s\" in sorted order (and the common prefix with the one above):\n", text);
    for (int i = 0; i < sa.size(); i++) {
        printf("  %d: %-7s starts at %d, lcp %d\n", i, text + sa.at(i), sa.at(i), sa.lcp(i));
    }
    printf("suffix \"na\" (starts at 4) has rank %d\n", sa.rank(4));

    // counting and finding patterns
    int pos[8];
    int total = sa.findAll("ana", -1, pos, 8);       // positions come in suffix order, not text order
    printf("\"ana\": count %d, find %d, findAll %d:", sa.count("ana"), sa.find("ana"), total);
    for (int i = 0; i < total; i++) { printf(" %d", pos[i]); }
    println("");
    printf("\"nab\": count %d, find %d (-1 = none), empty pattern: count %d\n", sa.count("nab"), sa.find("nab"), sa.count(""));

    // how long do two suffixes agree?
    printf("common prefix of the suffixes at 1 (\"anana\") and 3 (\"ana\"): %d\n", sa.lcpOf(1, 3));
    int at = 0;
    int len = sa.longestRepeat(&at);
    printf("longest repeated substring: %d bytes at %d: \"%.*s\"\n", len, at, len, text + at);
    printf("distinct substrings: %d\n", sa.distinctSubstrings());

    // a bigger text: how often does a phrase occur?
    char* poem = "she sells sea shells by the sea shore, the shells she sells are sea shells for sure";
    strx.SuffixArray big(poem);
    printf("in a text of %d bytes: \"sea\" %d times, \"shell\" %d times, \"she \" %d times, \"sells\" %d times\n",
           big.size(), big.count("sea"), big.count("shell"), big.count("she "), big.count("sells"));
    len = big.longestRepeat(&at);
    printf("longest repeat: \"%.*s\" (%d bytes)\n", len, poem + at, len);
    sa.dispose(); big.dispose();
    return 0;
}
