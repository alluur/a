// A text diff: what changed between two versions of a file?
import strx;

int main() {
    char* before = "name = demo\nport = 8080\nhost = localhost\nlog = info\ncolor = on\nmode = fast\nretries = 3\ntimeout = 30\n";
    char* after  = "name = demo\nport = 9090\nhost = localhost\nlog = info\ncolor = on\nmode = fast\nretries = 5\ntimeout = 30\ncache = on\n";

    strx.LineDiff d;                                  // LineDiff has no constructor, so no parentheses
    d.runText(before, after);                        // splits both texts into lines and compares them
    printf("%d lines before, %d after, %d lines deleted or inserted, exact: %d\n", d.linesA(), d.linesB(), d.distance(), d.exact());

    // the edit script as runs: kind 0 = equal, 1 = delete, 2 = insert
    char* kind[3] = {"keep  ", "delete", "insert"};
    for (int r = 0; r < d.opCount(); r++) {
        printf("  %s %d line(s) (a from %d, b from %d)\n", kind[d.opKind(r)], d.opLen(r), d.opA(r), d.opB(r));
    }

    // the same as text, in the format of `diff -u`: 1 line of context here (the default is 3)
    char* patch = d.unified("old.conf", "new.conf", 1);
    print(patch);
    strx.freeText(patch);                            // the patch is a new block of memory

    // with line arrays: no copy of the text is made, the lines must stay alive.
    // splitLines tells whether the last line had no newline; pass that on to run (after maxCost) to get diff's "\ No newline" marker
    int na = 0;
    int nb = 0;
    bool noEolA = false;
    bool noEolB = false;
    char** a = strx.splitLines("one\ntwo\nthree", -1, &na, &noEolA);
    char** b = strx.splitLines("one\nthree\nfour\n", -1, &nb, &noEolB);
    strx.LineDiff e;
    e.run(a, na, b, nb, 8000, noEolA, noEolB);
    printf("second diff: %d runs, distance %d\n", e.opCount(), e.distance());
    patch = e.unified("a.txt", "b.txt");
    print(patch);
    strx.freeText(patch);

    e.runText("same\n", "same\n");
    patch = e.unified("x", "y");
    printf("equal files: the patch is \"%s\"\n", patch);   // "" when there is nothing to report
    strx.freeText(patch);
    strx.freeText((char*) a);                        // a line array is one block
    strx.freeText((char*) b);
    d.dispose(); e.dispose();
    return 0;
}
