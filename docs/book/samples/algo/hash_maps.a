// Hash maps and sets: counting, lookup and the order of the entries
import ds;

int main() {
    // count how often each number occurs; add(key) adds 1 to the value (a new key starts at 0)
    int data[12] = {4, 8, 15, 16, 23, 42, 8, 4, 15, 8, 8, 99};
    ds.HashMap freq();
    foreach (int x in data) { freq.add(x); }
    printf("%d different numbers in %d, number 8 occurs %d times, 5 occurs %d times\n", freq.size(), sizeof(data) / sizeof(int), freq.get(8, 0), freq.get(5, 0));

    // entries come out in the order of their first insertion, not in hash order
    printf("insertion order:");
    for (int e = freq.first(); e >= 0; e = freq.next(e)) { printf(" %d:%d", freq.keyAt(e), freq.valueAt(e)); }
    println("");

    // removing while iterating is fine; the entry is skipped from then on
    for (int e = freq.first(); e >= 0; e = freq.next(e)) {
        if (freq.valueAt(e) == 1) { freq.remove(freq.keyAt(e)); }
    }
    printf("only repeated numbers left:");
    for (int e = freq.first(); e >= 0; e = freq.next(e)) { printf(" %d", freq.keyAt(e)); }
    println("");

    // put tells whether the key was new; putIfAbsent keeps an old value
    printf("put(8, 100): %d (0 = the key existed), putIfAbsent(8, 5): %d, putIfAbsent(7, 5): %d, 8 is now %d\n",
           freq.put(8, 100), freq.putIfAbsent(8, 5), freq.putIfAbsent(7, 5), freq.get(8, 0));

    // text keys are copied into the map
    ds.TextHashMap stock();
    char name[16];
    strcpy(name, "apples");  stock.put(name, 12);
    strcpy(name, "pears");   stock.put(name, 4);
    stock.put("plums", 30);
    stock.add("apples", -5);                         // 5 apples sold
    stock.remove("pears");
    printf("apples %d, pears %d (fallback -1), %d kinds:", stock.get("apples", -1), stock.get("pears", -1), stock.size());
    for (int e = stock.first(); e >= 0; e = stock.next(e)) { printf(" %s=%d", stock.keyAt(e), stock.valueAt(e)); }
    println("");

    // a set: have I seen this before? the first repeated word of a text
    char* words[8] = {"one", "two", "three", "two", "four", "one", "five", "six"};
    ds.TextHashSet seen();
    foreach (char* w in words) {
        if (!seen.add(w)) { printf("first repeat: %s\n", w); break; }   // add returns 1 for a new key, 0 when it was there
    }
    ds.HashSet odd();
    foreach (int x in data) { if (x % 2 == 1) { odd.add(x); } }
    printf("odd numbers: %d different, contains 15: %d, contains 16: %d\n", odd.size(), odd.has(15), odd.has(16));
    freq.dispose(); stock.dispose(); seen.dispose(); odd.dispose();
    return 0;
}
