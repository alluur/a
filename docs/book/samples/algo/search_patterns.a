// Searching for one pattern: Kmp, Horspool, Rabin-Karp and the one-shot functions
import strx;

void showList(char* label, int* a, int n) {
    printf("%s:", label);
    for (int i = 0; i < n; i++) { printf(" %d", a[i]); }
    println("");
}

int main() {
    char* text = "abracadabra abracadabra";
    int pos[16];

    // compile the pattern once, search as many texts as you like (-1 as the length means "up to the 0")
    strx.Kmp kmp("abra");
    printf("Kmp: first match at %d, next one from 1 at %d, from 21: %d\n", kmp.find(text), kmp.find(text, -1, 1), kmp.find(text, -1, 21));
    int total = kmp.findAll(text, -1, pos, 16);      // the return value is the total, pos holds at most 16
    showList("all matches", pos, total);

    // Horspool and RabinKarp have the same methods; they are faster or slower depending on the text
    strx.Horspool horspool("cad");
    strx.RabinKarp rabin("a a");
    printf("Horspool \"cad\" at %d, RabinKarp \"a a\" at %d, a missing pattern: %d\n", horspool.find(text), rabin.find(text), horspool.find("xyz"));

    // overlapping or not: "aa" in "aaaaa"
    strx.Kmp aa("aa");
    printf("\"aa\" in \"aaaaa\": %d overlapping, %d without overlap\n", aa.count("aaaaa"), aa.count("aaaaa", -1, false));

    // no setup: one call (it picks a fast method and stays linear on nasty texts)
    printf("indexOf %d, countOf %d, findAll %d\n", strx.indexOf(text, "dab"), strx.countOf(text, "abra"), strx.findAll(text, "a", pos, 16));
    showList("positions of a", pos, 8);

    // a pattern with an explicit length, in a text that is not 0 terminated: only n bytes are read
    printf("first 7 bytes of \"abracadabra\" contain \"cad\": %d, first 5 bytes: %d\n", strx.indexOf("abracadabra", "cad", 0, 7), strx.indexOf("abracadabra", "cad", 0, 5));

    // the tools behind KMP
    int pi[9];
    int z[9];
    strx.prefixFunction("abcabcabd", 9, pi);
    strx.zFunction("abcabcabd", 9, z);
    showList("prefix function of abcabcabd", pi, 9);
    showList("Z array of abcabcabd", z, 9);
    printf("smallest period of \"abcabcabcab\": %d, of \"abcd\": %d\n", strx.period("abcabcabcab", 11), strx.period("abcd", 4));
    kmp.dispose(); horspool.dispose(); rabin.dispose(); aa.dispose();
    return 0;
}
