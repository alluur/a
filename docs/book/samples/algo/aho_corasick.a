// Aho-Corasick: many patterns in one pass over the text
import strx;

int onMatch(int id, int end, int ctx) {              // callback for each(): return non-zero to stop
    printf("  callback: pattern %d ends at %d\n", id, end);
    return 0;
}

int main() {
    // the classic example: matches that overlap and end at the same place
    strx.AhoCorasick ac();
    char* words[4] = {"he", "she", "his", "hers"};
    foreach (int i, char* w in words) { printf("%s%s=%d", i > 0 ? ", " : "ids: ", w, ac.add(w)); }   // add returns the id of the pattern
    println("");

    int ids[16];
    int ends[16];
    int n = ac.findAll("ushers", -1, ids, ends, 16); // the matches in text order; the return value is the total
    printf("\"ushers\" has %d matches:\n", n);
    for (int i = 0; i < n; i++) {
        int len = ac.patternLength(ids[i]);
        printf("  %-5s at %d..%d\n", words[ids[i]], ends[i] - len, ends[i]);   // end is the position after the last byte
    }
    printf("count: %d, same pattern added again gets its old id: %d\n", ac.count("hishers"), ac.add("she"));

    int id = 0;
    int end = 0;
    ac.first("a history of hershey", -1, &id, &end); // only the first match
    printf("first match in the story: pattern %d (%s), ends at %d\n", id, words[id], end);
    ac.each("ushers", -1, onMatch, 0);

    // a cursor for streams: feed one byte at a time and keep only the state (an int); no text in memory is needed
    int state = 0;
    foreach (int i, char c in "ushers") {
        state = ac.step(state, c);
        for (int t = ac.match(state); t > 0; t = ac.nextMatch(t)) {   // the patterns that end here, longest first
            printf("  after byte %d (%c): %s\n", i + 1, c, words[ac.patternAt(t)]);
        }
    }

    // ignore case: a log scanner with three keywords
    strx.AhoCorasick scan(true);
    char* level[3] = {"error", "warn", "timeout"};
    foreach (char* k in level) { scan.add(k); }
    char* lines[4] = {"12:01 INFO started", "12:02 Warning: disk 91%", "12:03 ERROR connection TIMEOUT", "12:04 info done"};
    foreach (char* line in lines) {
        int found = scan.findAll(line, -1, ids, ends, 16);
        printf("%-32s %d hit(s)", line, found);
        for (int i = 0; i < found && i < 16; i++) { printf(" [%s]", level[ids[i]]); }
        println("");
    }
    ac.dispose(); scan.dispose();
    return 0;
}
