// Edit distances: how many changes turn one text into another?
import strx;

void row(char* a, char* b) {
    printf("%-10s %-10s lev %d  osa %d  damerau %d\n", a, b, strx.levenshtein(a, -1, b, -1), strx.osa(a, -1, b, -1), strx.damerau(a, -1, b, -1));
}

int main() {
    // Levenshtein: insert, delete or replace one letter. OSA and Damerau also count swapping two neighbours as one change.
    row("kitten", "sitting");
    row("flaw", "lawn");
    row("ab", "ba");                                 // a swap: 2 changes for Levenshtein, 1 for the others
    row("ca", "abc");                                // OSA allows no edit inside a swapped pair: 3, Damerau finds 2
    row("sunday", "saturday");

    // levenshteinMax(a, na, b, nb, k) stops early: when the distance is above k it returns k + 1
    printf("max 2: kitten/sitting -> %d (3 is more than 2), flaw/lawn -> %d\n",
           strx.levenshteinMax("kitten", -1, "sitting", -1, 2), strx.levenshteinMax("flaw", -1, "lawn", -1, 2));

    // Hamming: same length only, counts the differing positions (or bits)
    printf("hamming karolin/kathrin = %d, 1011101/1001001 = %d, different lengths = %d\n",
           strx.hamming("karolin", -1, "kathrin", -1), strx.hamming("1011101", -1, "1001001", -1), strx.hamming("abc", -1, "ab", -1));
    printf("hammingBits \"a\"/\"b\" = %d (0x61 ^ 0x62 has 2 bits)\n", strx.hammingBits("a", 1, "b", 1));

    // a similarity from 0.0 to 1.0: 1 - distance / the longer length
    printf("similarity kitten/sitting = %s, equal = %s\n",
           doubleToFixed(strx.levenshteinSimilarity("kitten", -1, "sitting", -1), 3), doubleToFixed(strx.levenshteinSimilarity("same", -1, "same", -1), 1));

    // bytes or code points: the last argument utf8 = true compares whole characters
    char* cafe = "caf\xc3\xa9";                     // "cafe" with an accent: 5 bytes, 4 characters
    printf("cafe vs \"%s\": by bytes %d, by characters %d\n", cafe, strx.levenshtein(cafe, -1, "cafe", -1), strx.levenshtein(cafe, -1, "cafe", -1, true));

    // not 0 terminated texts: pass the length
    printf("first 3 bytes of \"kitchen\" vs \"kit\": %d\n", strx.levenshtein("kitchen", 3, "kit", 3));
    return 0;
}
