// Fuzzy file finder (quick open) and glob patterns
import strx;

int main() {
    char* files[8] = {"src/main.a", "src/map_builder.a", "docs/MainMenu.md", "tests/t12_main.a", "README.md", "src/utils/format_money.a", "build/a.out", "src/mem.a"};

    // the letters of the pattern must appear in the text in the same order, gaps allowed
    strx.FuzzyMatcher f("sma");                      // all lower case: case does not matter
    int idx[8];
    int score[8];
    int n = f.rank(files, 8, idx, 8, score);         // best first; ties: shorter text first
    printf("pattern \"sma\" matches %d of 8:\n", n);
    for (int i = 0; i < n; i++) { printf("  %-26s score %d\n", files[idx[i]], score[i]); }

    // score() also tells where the letters were found: word starts and camelCase humps score more
    int pos[8];
    char* candidate = "docs/MainMenu.md";
    strx.FuzzyMatcher mm("mm");
    int s = mm.score(candidate, -1, pos);
    printf("\"mm\" in %s: score %d, letters at bytes %d and %d\n", candidate, s, pos[0], pos[1]);
    printf("\"zz\" in %s: %d (-1 = not a match)\n", candidate, mm.score("zz"));
    printf("smart case: \"MM\" in \"main menu\": %d (a capital makes the match case sensitive), \"mm\": %d\n", strx.fuzzyScore("MM", "main menu"), strx.fuzzyScore("mm", "main menu"));

    // glob patterns: * any run, ? one byte, [a-c] a set, [!x] not; GLOB_PATHNAME makes * stop at a slash and ** cross slashes
    char* paths[5] = {"src/main.a", "src/utils/text.a", "src/utils/deep/x.a", "docs/readme.md", "Makefile"};
    foreach (char* p in paths) {
        printf("%-20s *.a %d  src/*.a %d  src/**/*.a %d  [Mm]*  %d\n", p, strx.globMatch("*.a", p),
               strx.globMatch("src/*.a", p, strx.GLOB_PATHNAME), strx.globMatch("src/**/*.a", p, strx.GLOB_PATHNAME), strx.globMatch("[Mm]*", p));
    }
    printf("case-blind: %d, ?-wildcard: %d, escaped star: %d\n", strx.globMatch("README.*", "readme.md", strx.GLOB_ICASE),
           strx.globMatch("t??t.a", "text.a"), strx.globMatch("a\\*b", "a*b"));
    f.dispose(); mm.dispose();
    return 0;
}
