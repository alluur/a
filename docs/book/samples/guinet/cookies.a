// A login that works: POST and cookies
import wsrv;
import gui;
import gnet;
import http;
import net;
import cstring;

wsrv.Server* srv;
gui.Display* d;
int web;
int webPort;

void reply(int c, char* extraHeader, char* body) {
    char head[300];
    format(&head[0], 300, "HTTP/1.1 200 OK\r\n%sContent-Length: %d\r\nConnection: close\r\n\r\n", extraHeader, strlen(body), 0, 0);
    net.sendText(c, &head[0]);
    net.sendText(c, body);
}

// a tiny site: POST /login sets a cookie, GET /me looks at it
void serveOne() {
    if (!net.waitReadable(web, 0)) { return; }
    int c = net.accept(web);
    http.Request* q = new http.Request();
    if (http.readRequest(c, q)) {
        if (streq(&q->path[0], "/login")) {
            printf("  server got a %s with the body: %s\n", &q->method[0], q->body);
            reply(c, "Set-Cookie: session=abc123; Path=/\r\n", "logged in");
        } else {
            char* cookie = q->header("Cookie");
            reply(c, "", cookie != null && strstr(cookie, "session=abc123") != null ? "welcome back" : "who are you?");
        }
    }
    net.close(c);
}

int serve(int unused) { srv->step(0); serveOne(); return 0; }

gnet.Fetch* run(char* path, char* postData) {
    gnet.Fetch* f = new gnet.Fetch();
    if (postData != null) { f->post(postData, null); }           // makes it a POST with a form body
    char url[100];
    format(&url[0], 100, "http://127.0.0.1:%d%s", webPort, path, 0, 0);
    f->start(d, &url[0], null);
    for (int i = 0; i < 400 && !f->done; i++) { serve(0); d->pump(5); }
    return f;
}

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(100, 100), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "cookies");
    web = net.listen(0, 8);
    webPort = net.localPort(web);

    printf("/me before logging in: %s\n", run("/me", null)->body);
    gnet.Fetch* f = run("/login", "user=ada&password=x");
    printf("/login answered: %s\n", f->body);
    printf("cookies in the jar: %d, session = %s\n", gnet.cookies()->size(), gnet.cookies()->get("127.0.0.1", "session"));
    printf("/me after logging in: %s\n", run("/me", null)->body);
    return 0;
}
