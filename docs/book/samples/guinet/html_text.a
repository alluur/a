// Parsing HTML and Markdown without a window
import ghtml;

int main() {
    char* page = "<html><head><title>Notes &amp; links</title><style>p { color: red }</style></head>"
                 "<body><h1>Title</h1><p>Hello   <b>big</b> world, see <a href='guide.html'>the guide</a>.</p>"
                 "<ul><li>one<li>two</ul><script>alert('skipped')</script></body></html>";
    ghtml.Doc* doc = ghtml.parseHtml(page, "http://example.org/docs/index.html");
    printf("title: %s\n", doc->title);
    printf("links: %d, the first goes to %s\n", doc->nlinks, doc->links[0]);   // already absolute
    println("as plain text:");
    println(ghtml.plainText(page));                      // style and script are not text

    println("entities:");
    println(ghtml.decodeEntities("a &amp; b &lt;c&gt; &#65;&#x42; &copy; &unknown; &"));

    println("Markdown becomes HTML first:");
    println(ghtml.markdownToHtml("# Hi\n\nSome *emphasis*, **bold** and `code`.\n\n- one\n- two\n"));
    return 0;
}
