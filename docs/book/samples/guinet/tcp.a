// TCP connections and a listener inside the event loop
import wsrv;
import gui;
import gnet;
import net;

wsrv.Server* srv;
gui.Display* d;
gnet.Conn* peer;           // the server's end of the connection
int closed;

int serve(int unused) { srv->step(0); return 0; }

// server side: a line arrived; answer it
int serverLine(int conn) {
    gnet.Conn* c = (gnet.Conn*) conn;
    char reply[100];
    format(&reply[0], 100, "echo: %s", c->line, 0, 0, 0);
    c->sendLine(&reply[0]);                         // sends the text and a newline
    return 0;
}

int accepted(int listener) {
    gnet.Listener* l = (gnet.Listener*) listener;
    peer = l->accepted;                              // the new connection
    peer->onLine = serverLine;
    return 0;
}

// client side
int clientLine(int conn) {
    gnet.Conn* c = (gnet.Conn*) conn;
    printf("client got: %s\n", c->line);
    return 0;
}
int clientClosed(int conn) { closed++; return 0; }

// run both ends for a while
void spin(int ms) {
    int t0 = millis();
    while (millis() - t0 < ms) { srv->step(0); d->pump(5); }
}

// a port number that is free right now
int freePort() {
    int probe = net.listen(0, 1);
    int p = net.localPort(probe);
    net.close(probe);
    return p;
}

int main() {
    int port = freePort();
    srv = new wsrv.Server(new wsrv.Headless(100, 100), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "tcp");

    gnet.Listener* l = new gnet.Listener();
    l->onAccept = accepted;
    printf("listening: %d\n", l->start(d, "127.0.0.1", 0));      // port 0: any free port, then l->port

    gnet.Conn* c = new gnet.Conn();
    c->onLine = clientLine;                          // text protocols: one call per line
    c->onClose = clientClosed;
    printf("connected: %d\n", c->connect(d, "127.0.0.1", l->port, 1000));
    c->sendLine("first");
    c->sendLine("second");
    spin(200);

    peer->close();                                   // the other side hangs up: onClose runs once
    spin(200);
    printf("closed callbacks: %d, still open: %d\n", closed, c->open);
    printf("connect to a port nobody listens on: %d\n", c->connect(d, "127.0.0.1", freePort(), 500));
    return 0;
}
