// Resolving links against the address of the page
import ghtml;

void show(char* ref) {
    printf("%-30s -> %s\n", ref, ghtml.resolveUrl("http://example.org:8080/docs/guide/page.html?q=1", ref));
}

int main() {
    println("base: http://example.org:8080/docs/guide/page.html?q=1");
    show("other.html");
    show("../img/a.png");
    show("../../../up.html");                   // cannot go above the root
    show("/root.html");
    show("//cdn.org/x.js");                     // same scheme, another host
    show("#section");
    show("https://secure.org/x");
    show("./here/./there/../x.html?y=2");
    printf("%s\n", ghtml.resolveUrl("file:///home/ada/docs/a.md", "b/c.md"));
    return 0;
}
