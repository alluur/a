// A peer-to-peer chat: two peers find each other and talk
import wsrv;
import gui;
import gnet;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }

int freePort() {
    int probe = net.listen(0, 1);
    int p = net.localPort(probe);
    net.close(probe);
    return p;
}

void spin(int ms) {
    int t0 = millis();
    while (millis() - t0 < ms) { srv->step(0); d->pump(5); }
}

// the chat reports through onEvent: eventKind 1 = a peer joined, 2 = left, 3 = a message
int adaSees(int chat) {
    gnet.Chat* c = (gnet.Chat*) chat;
    if (c->eventKind == 1) { printf("ada sees: %s joined\n", c->eventName); }
    if (c->eventKind == 2) { printf("ada sees: %s left\n", c->eventName); }
    if (c->eventKind == 3) { printf("ada sees: %s says \"%s\"\n", c->eventName, c->eventText); }
    return 0;
}

int bobSees(int chat) {
    gnet.Chat* c = (gnet.Chat*) chat;
    if (c->eventKind == 3) { printf("bob sees: %s says \"%s\"\n", c->eventName, c->eventText); }
    return 0;
}

int main() {
    int displayPort = freePort();
    srv = new wsrv.Server(new wsrv.Headless(100, 100), displayPort);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", displayPort, 0, 0, 0);
    d = gui.connectAs(&spec[0], "chat");

    // Chat(name, TCP port, UDP port): 0 = any free port. Every peer listens, and announces
    // itself by UDP (on a LAN by broadcast); here we point the announcements at each other.
    gnet.Chat* ada = new gnet.Chat("ada", 0, 0);
    gnet.Chat* bob = new gnet.Chat("bob", 0, 0);
    ada->onEvent = adaSees;
    bob->onEvent = bobSees;
    ada->start(d);
    bob->start(d);
    ada->addTarget(0x7F000001, bob->udpPort);
    bob->addTarget(0x7F000001, ada->udpPort);
    ada->announce();
    bob->announce();
    for (int i = 0; i < 200 && (ada->peerCount() < 1 || bob->peerCount() < 1); i++) { srv->step(0); d->pump(5); }
    printf("peers: ada %d, bob %d\n", ada->peerCount(), bob->peerCount());

    ada->say("hello bob");
    spin(100);
    bob->say("hi ada");
    spin(100);
    bob->stop();                                      // leaving tells the others
    spin(150);
    printf("ada has %d peer(s) now\n", ada->peerCount());
    ada->stop();
    return 0;
}
