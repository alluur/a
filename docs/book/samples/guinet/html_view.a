// A web page in a window: HtmlView with links
// book: shot=out.png
import wsrv;
import gui;
import ghtml;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }

int onLink(int view) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) view;
    printf("link clicked: %s\n", v->linkHref);          // already resolved against the page address
    return 0;
}

int onHover(int view) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) view;
    printf("hovering: %s\n", v->hoverHref == null ? "(nothing)" : v->hoverHref);
    return 0;
}

int main() {
    screen = new wsrv.Headless(420, 400);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "html");

    gui.Window* w = d->createWindowAt("A page", 20, 40, 380, 330, 0);
    ghtml.HtmlView* view = new ghtml.HtmlView();
    view->onLink = onLink;
    view->onHover = onHover;
    gui.Box* col = gui.vbox(0, 0);
    col->add(view);
    w->setRoot(col);
    view->setHtml("<h1>Hello</h1><p>This is <b>bold</b>, this is <code>code</code>, and <a href='next.html'>this is a link</a> to another page.</p>"
                  "<h2>A list</h2><ul><li>first<li>second <a href='/abs.html'>(absolute)</a></ul>"
                  "<blockquote>A quotation in a block.</blockquote>"
                  "<table><tr><td>cell A</td><td>cell B</td></tr><tr><td>cell C</td><td>cell D</td></tr></table>",
                  "http://example.org/dir/index.html");
    settle();

    screen->moveTo(290, 130);                           // over a link: the cursor turns into a hand
    settle();
    screen->moveTo(300, 220);                           // off the link again
    settle();
    screen->click(290, 130);                            // a click on the link calls onLink
    settle();
    screen->moveTo(410, 390);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
