// Showing a Markdown document
// book: shot=out.png
import wsrv;
import gui;
import ghtml;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }

int main() {
    wsrv.Headless* screen = new wsrv.Headless(420, 360);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "markdown");

    gui.Window* w = d->createWindowAt("README.md", 20, 40, 380, 290, 0);
    ghtml.HtmlView* view = new ghtml.HtmlView();
    gui.Box* col = gui.vbox(0, 0);
    col->add(view);
    w->setRoot(col);
    // headings, emphasis, code, lists, a quote, a table and a link: the Markdown is turned into HTML and shown
    view->setMarkdown("# A project\n\nIt has **bold**, *italic* and `code`, and a [link](docs/guide.md).\n\n"
                      "## To do\n\n- write the book\n- check the samples\n  - run them\n\n1. first\n2. second\n\n"
                      "> Samples are compiled and run.\n\n"
                      "| module | lines |\n|---|---|\n| term | 1962 |\n| tui | 3797 |\n\n"
                      "```\nint main() { return 0; }\n```\n",
                      "file:///home/ada/project/README.md");
    settle();
    printf("document height %d, window height %d: %s\n", view->contentHeight, view->h, view->contentHeight > view->h ? "it scrolls" : "it fits");
    screen->moveTo(200, 200);                            // the wheel scrolls the view under the pointer
    screen->scroll(-3);                                  // 3 steps down (negative = down)
    settle();
    printf("scrolled to %d of at most %d\n", view->scrollY, view->contentHeight - view->h);
    screen->moveTo(410, 350);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
