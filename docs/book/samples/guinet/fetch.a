// Fetching a web page without freezing the window
import wsrv;
import gui;
import gnet;
import http;
import net;

wsrv.Server* srv;
gui.Display* d;
int web;                 // the little web server's listening socket
int webPort;

// Serves one waiting connection. A real program would run this server elsewhere;
// here it shares the process so that the sample needs nothing but loopback.
void serveOne() {
    if (!net.waitReadable(web, 0)) { return; }
    int c = net.accept(web);
    http.Request* q = new http.Request();
    if (http.readRequest(c, q)) {
        if (streq(&q->path[0], "/hello")) { http.respond(c, 200, "text/plain", "hello from the server"); }
        else if (streq(&q->path[0], "/old")) {
            net.sendText(c, "HTTP/1.1 302 Found\r\nLocation: /hello\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
        } else { http.respond(c, 404, "text/plain", "no such page"); }
    }
    net.close(c);
}

int serve(int unused) { srv->step(0); serveOne(); return 0; }

// start a fetch and run the event loops until it is done
gnet.Fetch* get(char* path) {
    gnet.Fetch* f = new gnet.Fetch();
    char url[100];
    format(&url[0], 100, "http://127.0.0.1:%d%s", webPort, path, 0, 0);
    if (!f->start(d, &url[0], null)) { return f; }               // false: bad address, f->error says why
    for (int i = 0; i < 400 && !f->done; i++) { serve(0); d->pump(5); }
    return f;
}

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(100, 100), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "fetch");
    web = net.listen(0, 8);
    webPort = net.localPort(web);

    gnet.Fetch* f = get("/hello");
    printf("/hello: status %d, %d bytes: %s\n", f->status, f->bodyLen, f->body);
    f = get("/old");
    printf("/old: status %d after the redirect, body: %s\n", f->status, f->body);
    printf("the address that was finally fetched ends with /hello: %d\n", endsWith(f->url, "/hello"));
    f = get("/nothing");
    printf("/nothing: status %d, body: %s\n", f->status, f->body);
    gnet.Fetch* bad = new gnet.Fetch();
    printf("not an http address: started %d, error: %s\n", bad->start(d, "ftp://example.org/", null), bad->error);
    return 0;
}
