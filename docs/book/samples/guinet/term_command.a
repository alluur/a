// Running a real program inside the terminal widget
// book: linux-only
import wsrv;
import gui;
import gterm;
import net;

wsrv.Server* srv;
gui.Display* d;
int exited;

int serve(int unused) { srv->step(0); return 0; }
int onExit(int terminal) { exited++; return 0; }

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(500, 300), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "term");

    gui.Window* w = d->createWindow("Terminal", 300, 140, 0);
    gterm.Terminal* t = new gterm.Terminal();
    t->onExit = onExit;                                    // called when the program has ended
    gui.Box* col = gui.vbox(0, 0);
    col->add(t);
    w->setRoot(col);
    w->resize(t->cellW() * 40 + 6, t->cellH() * 6 + 6);
    d->sync();
    for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); }      // let the new size reach the widget before the program asks for it

    // start(display, command) runs the command through /bin/sh on a pseudo terminal.
    // The program sees a real terminal: its size, colours, TERM=xterm-256color.
    printf("started: %d\n", t->start(d, "echo size: $(stty size); echo TERM=$TERM; printf '\\033[1mbold\\033[0m done\\n'; exit 3"));
    for (int i = 0; i < 300 && exited == 0; i++) { srv->step(0); d->pump(10); }
    for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); }      // let the last output arrive
    for (int r = 0; r < 3; r++) { printf("|%s|\n", t->lineText(r)); }
    printf("the program ended: %d, exit status %d\n", exited, t->exitStatus);
    return 0;
}
