// A port scanner that runs one port per turn of the event loop
import wsrv;
import gui;
import gnet;
import net;

wsrv.Server* srv;
gui.Display* d;
int openPort;
int doneCalls;
int progress;

int serve(int unused) { srv->step(0); return 0; }
int onFound(int scan) { gnet.Scan* s = (gnet.Scan*) scan; openPort = s->lastFound; return 0; }
int onProgress(int scan) { progress++; return 0; }
int onDone(int scan) { doneCalls++; return 0; }

int freePort() {
    int probe = net.listen(0, 1);
    int p = net.localPort(probe);
    net.close(probe);
    return p;
}

// run the loop until the scan is finished
void wait(gnet.Scan* s) {
    for (int i = 0; i < 400 && s->running; i++) { srv->step(0); d->pump(5); }
}

int main() {
    int port = freePort();
    srv = new wsrv.Server(new wsrv.Headless(100, 100), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "scan");

    int service = net.listen(0, 4);                  // something to find
    int servicePort = net.localPort(service);

    gnet.Scan* s = new gnet.Scan();
    s->onFound = onFound;
    s->onProgress = onProgress;
    s->onDone = onDone;
    // start(display, host, first port, last port, time out per port in ms): one port per turn of the loop
    s->start(d, "127.0.0.1", servicePort, servicePort, 200);
    wait(s);
    printf("scanned %d port(s), open: %d, it is our service: %d\n", progress, s->found, openPort == servicePort);

    int quiet = freePort();                          // a port where nothing listens
    s->start(d, "127.0.0.1", quiet, quiet, 200);     // the same scanner can be started again
    wait(s);
    printf("a closed port: open %d, scans finished: %d\n", s->found, doneCalls);
    printf("a bad range (10 to 5) is refused: %d\n", s->start(d, "127.0.0.1", 10, 5, 100) == false);
    return 0;
}
