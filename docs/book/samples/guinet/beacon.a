// UDP datagrams in the event loop
import wsrv;
import gui;
import gnet;
import net;

wsrv.Server* srv;
gui.Display* d;
int got;

int serve(int unused) { srv->step(0); return 0; }
int onPacket(int beacon) {
    gnet.Beacon* b = (gnet.Beacon*) beacon;
    printf("received \"%s\" from 127.0.0.1: %d\n", b->text, b->fromIp == 0x7F000001);
    got++;
    return 0;
}

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(100, 100), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "beacon");

    gnet.Beacon* listener = new gnet.Beacon();
    listener->onPacket = onPacket;
    listener->start(d, 0);                           // 0: any free port, then listener->port
    gnet.Beacon* sender = new gnet.Beacon();
    sender->start(d, 0);
    // an address is an int: 127.0.0.1 is 0x7F000001. broadcast() would reach the whole LAN.
    sender->send(0x7F000001, listener->port, "are you there?");
    for (int i = 0; i < 100 && got == 0; i++) { srv->step(0); d->pump(5); }
    printf("the sender's port is reported: %d\n", listener->fromPort == sender->port);
    listener->stop();
    sender->stop();
    return 0;
}
