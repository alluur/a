// A terminal widget as a screen you write to: escape sequences in a string
import wsrv;
import gui;
import gterm;
import net;

wsrv.Server* srv;
gui.Display* d;
gterm.Terminal* t;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }

// show the first rows of the terminal as text
void rows(int n) {
    for (int r = 0; r < n; r++) { printf("|%s|\n", t->lineText(r)); }
    printf("cursor at row %d, column %d\n", t->cursorRow, t->cursorCol);
}

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(500, 300), port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "term");

    gui.Window* w = d->createWindow("Terminal", 300, 140, 0);
    t = new gterm.Terminal();
    gui.Box* col = gui.vbox(0, 0);
    col->add(t);
    w->setRoot(col);
    w->resize(t->cellW() * 30 + 6, t->cellH() * 5 + 6);         // 30 columns, 5 rows
    settle();
    printf("the widget has %d columns and %d rows\n", t->cols, t->rows);

    // feed() writes as if a program had printed it: \r\n is a new line
    t->feed("Hello, terminal\r\nsecond line\r\n");
    rows(3);

    // cursor movement: row 1, column 8, then overwrite, then erase to the end of the line
    t->feed("\e[1;8H\e[1mWORLD\e[0m\e[K");
    rows(2);

    // a line longer than the screen wraps
    t->feed("\e[2J\e[H0123456789012345678901234567890123456789");
    rows(2);

    // what the user types goes to the program: takeSent() returns it
    t->send("ls\r");
    printf("sent to the program: %d bytes\n", strlen(t->takeSent()));
    return 0;
}
