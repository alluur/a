// Fetching an https:// page: the certificate is checked
// book: linux-only
import wsrv;
import gui;
import gnet;
import net;
import tls;
import x509;
import cunistd;
import testcert;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }

// a tiny HTTPS server in a child process: it answers `count` requests
void server(int listener, tls.Config* cfg, int count) {
    for (int k = 0; k < count; k++) {
        int c = net.accept(listener);
        if (tls.wrapServer(c, cfg)) {
            char buf[2000];
            net.recv(c, buf, 1999);
            net.sendText(c, "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nsecure hello");
        }
        net.close(c);
    }
}

gnet.Fetch* get(int port, bool verify) {
    gnet.Fetch* f = new gnet.Fetch();
    f->verifyCerts = verify;                                 // the default is true
    char url[100];
    format(&url[0], 100, "https://127.0.0.1:%d/", port, 0, 0, 0);
    f->start(d, &url[0], null);
    for (int i = 0; i < 400 && !f->done; i++) { srv->step(0); d->pump(5); }
    return f;
}

int main() {
    int probe = net.listen(0, 1);
    int displayPort = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(100, 100), displayPort);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", displayPort, 0, 0, 0);
    d = gui.connectAs(&spec[0], "https");

    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    int pid = fork();
    if (pid == 0) { server(listener, cfg, 3); _exit(0); }
    net.close(listener);

    gnet.Fetch* f = get(port, true);                         // nobody trusts the test certificate yet
    printf("not trusted: status %d, secure %d\n  error: %s\n", f->status, f->secure, f->error);
    x509.addRootPem(testcert.CERT_PEM);                      // now we do
    f = get(port, true);
    printf("trusted: status %d, body \"%s\", secure %d, cipher %s\n", f->status, f->body, f->secure, f->cipher);
    f = get(port, false);                                    // no checking at all: never do this on the Internet
    printf("not verified: status %d, secure %d\n", f->status, f->secure);
    int status;
    waitpid(pid, &status, 0);
    return 0;
}
