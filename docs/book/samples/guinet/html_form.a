// Forms in a page: controls become widgets, a submit collects the fields
// book: shot=out.png
import wsrv;
import gui;
import ghtml;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }

int onSubmit(int view) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) view;
    printf("%s %s\n", v->submitMethod, v->submitUrl);        // GET or POST, and the address
    printf("body: %s\n", v->submitBody);                      // name=value pairs, URL encoded
    return 0;
}

void clickOn(gui.Window* w, gui.Widget* wd) {
    wsrv.Win* win = srv->findWindow(d->clientNum, w->id);
    screen->click(win->x + wd->absX() + wd->w / 2, win->y + wd->absY() + wd->h / 2);
    settle();
}

int main() {
    screen = new wsrv.Headless(420, 410);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "form");

    gui.Window* w = d->createWindowAt("Sign up", 20, 40, 380, 350, 0);
    ghtml.HtmlView* view = new ghtml.HtmlView();
    view->onSubmit = onSubmit;
    gui.Box* col = gui.vbox(0, 0);
    col->add(view);
    w->setRoot(col);
    view->setHtml("<h2>Sign up</h2><form action='/join' method='POST'>"
                  "<p>Name <input name=name value='Ada Lovelace'></p>"
                  "<p><input type=checkbox name=news value=yes checked> newsletter</p>"
                  "<p>Size <input type=radio name=size value=s> S <input type=radio name=size value=m checked> M <input type=radio name=size value=l> L</p>"
                  "<p>Colour <select name=colour><option value=r>Red<option value=g selected>Green</select></p>"
                  "<p><textarea name=note rows=2 cols=24>first line\nsecond</textarea></p>"
                  "<p><input type=submit name=go value='Join'></p></form>",
                  "http://example.org/signup.html");
    settle();
    printf("controls in the page: %d\n", view->controlCount());

    gui.TextBox* name = (gui.TextBox*) view->controlWidget(0);    // controls are numbered in the order of the page
    name->setText("Grace & co");                                    // '&' will be encoded
    clickOn(w, view->controlWidget(1));                              // the checkbox: off
    clickOn(w, view->controlWidget(4));                              // the radio button L
    screen->moveTo(405, 400);
    settle();
    gimg.savePng(srv->screen, "out.png");                            // the picture before the submit
    clickOn(w, view->controlWidget(7));                              // the submit button
    return 0;
}
