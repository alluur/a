// What the terminal widget draws: colours, attributes and box drawing
// book: shot=out.png
import wsrv;
import gui;
import gterm;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }

int main() {
    wsrv.Headless* screen = new wsrv.Headless(480, 300);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "term");

    gui.Window* w = d->createWindowAt("Terminal", 20, 40, 100, 100, 0);
    gterm.Terminal* t = new gterm.Terminal();
    t->showCursor = false;                                   // no cursor in the picture
    gui.Box* col = gui.vbox(0, 0);
    col->add(t);
    w->setRoot(col);
    w->resize(t->cellW() * 52 + 6, t->cellH() * 11 + 6);
    settle();

    t->feed("\e[1mbold\e[0m \e[2mdim\e[0m \e[4munderline\e[0m \e[7mreverse\e[0m \e[3mitalic\e[0m\r\n");
    t->feed("\e[31mred\e[0m \e[32mgreen\e[0m \e[33myellow\e[0m \e[34mblue\e[0m \e[35mmagenta\e[0m \e[36mcyan\e[0m\r\n");
    t->feed("\e[97;41m white on red \e[0m \e[30;102m black on bright green \e[0m\r\n");
    // 256 colours: the grayscale ramp and a piece of the colour cube
    for (int i = 232; i < 256; i++) { char c[24]; format(&c[0], 24, "\e[48;5;%dm ", i, 0, 0, 0); t->feed(&c[0]); }
    t->feed("\e[0m\r\n");
    for (int i = 0; i < 36; i++) { char c[24]; format(&c[0], 24, "\e[48;5;%dm ", 16 + i * 6, 0, 0, 0); t->feed(&c[0]); }
    t->feed("\e[0m\r\n");
    // 24 bit colour: a red to blue ramp
    for (int i = 0; i < 48; i++) { char c[40]; format(&c[0], 40, "\e[48;2;%d;40;%dm ", 255 - i * 5, i * 5, 0, 0); t->feed(&c[0]); }
    t->feed("\e[0m\r\n");
    // box drawing characters are drawn as lines, so they join without gaps
    t->feed("\xe2\x94\x8c\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x90\r\n");
    t->feed("\xe2\x94\x82 box \xe2\x94\x82  \xe2\x96\x88\xe2\x96\x93\xe2\x96\x92\xe2\x96\x91  \xe2\x96\xb6 \xe2\x86\x92\r\n");
    t->feed("\xe2\x94\x94\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x80\xe2\x94\x98\r\n");
    settle();
    printf("cell size %d x %d pixels, %d columns\n", t->cellW(), t->cellH(), t->cols);
    screen->moveTo(470, 290);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
