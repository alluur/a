// Temporary files, pipes and file descriptors
import cstdio;
import cunistd;

int main() {
    FILE* t = tmpfile();                               // an anonymous file, opened for reading and writing
    fprintf(t, "scratch %d\n", 42);
    rewind(t);                                         // go back before reading what was just written
    char line[32];
    fgets(line, 32, t);
    print(line);
    fclose(t);                                         // and it is gone

    // a name for a temporary file: only a name, the file is yours to create
    char name[260];
    tmpnam(name);
    printf("tmpnam made a name of %d characters\n", strlen(name));

    // FILE* and file descriptors convert both ways
    FILE* f = fopen("fd.txt", "w");
    int fd = fileno(f);
    printf("fileno is above 2 (0, 1 and 2 are the standard streams): %d\n", fd > 2);
    fclose(f);

    int raw = open("fd.txt", O_WRONLY | O_APPEND);
    FILE* g = fdopen(raw, "a");                        // a stream on an existing descriptor
    fputs("via fdopen\n", g);
    fclose(g);                                         // closes the descriptor too

    f = fopen("fd.txt", "r");
    fgets(line, 32, f);
    print(line);
    fclose(f);
    return 0;
}
