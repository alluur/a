// Reading a date from text with strptime
import ctime;

int main() {
    tm p;
    char* end = strptime("2026-09-21 14:05:09", "%Y-%m-%d %H:%M:%S", &p);
    printf("parsed: %s\n", end != null ? "yes" : "no");
    printf("%d seconds since 1970\n", timegm(&p));

    char* end2 = strptime("21 Sep 2026", "%d %b %Y", &p);   // month names work
    printf("day %d, month %d, year %d (parsed: %d)\n", p.tm_mday, p.tm_mon + 1, p.tm_year + 1900, end2 != null);

    // the returned pointer is where parsing stopped: after the used text
    char* text = "07/04/26 and more";
    char* rest = strptime(text, "%m/%d/%y", &p);
    printf("rest of the text: \"%s\"\n", rest);
    printf("month %d day %d year %d\n", p.tm_mon + 1, p.tm_mday, p.tm_year + 1900);

    // a mismatch gives null
    printf("not a date: %s\n", strptime("tomorrow", "%Y-%m-%d", &p) == null ? "null" : "parsed");
    printf("wrong separator: %s\n", strptime("2026/09/21", "%Y-%m-%d", &p) == null ? "null" : "parsed");

    // AM / PM
    strptime("11:30 PM", "%I:%M %p", &p);
    printf("11:30 PM is hour %d\n", p.tm_hour);
    return 0;
}
