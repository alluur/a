strcmp("apple", "banana") is negative
strcmp("banana", "apple") is positive
strcmp("same", "same") is zero
strcmp("Zebra", "apple") is negative
strcmp("abc", "abcd") is negative
strncmp("abcdef", "abcxyz", 3) = 0
strcasecmp("Hello", "hELLO") = 0
strncasecmp("HELP me", "help", 4) = 0
strcoll = strcmp in the C locale: 1
