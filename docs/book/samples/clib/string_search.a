// Searching in strings
import cstring;

int main() {
    char* path = "/usr/local/lib/libm.so.6";
    char* slash = strrchr(path, '/');               // the last '/': the file name follows it
    printf("file name: %s\n", slash + 1);
    char* dot = strchr(slash, '.');                 // the first '.' after it
    printf("extension: %s\n", dot);
    printf("dot index: %d\n", dot - path);

    char* hay = "the quick brown fox jumps over the lazy dog";
    char* hit = strstr(hay, "fox");
    printf("strstr: \"%s\"\n", hit);
    printf("missing: %d\n", strstr(hay, "cat") == null);
    printf("strcasestr: %s\n", strcasestr(hay, "QUICK") != null ? "found" : "not found");

    // spans: how long is the prefix made only of / not made of the given characters
    printf("strspn(\"2026-09\", \"0123456789\") = %d\n", strspn("2026-09", "0123456789"));
    printf("strcspn(\"hello, world\", \",;\") = %d\n", strcspn("hello, world", ",;"));
    char* p = strpbrk("user@example.org", "@:/");   // first of several characters
    printf("strpbrk: %s\n", p);
    printf("the terminating zero counts as part of the string: %d\n", strchr("abc", 0) != null);
    return 0;
}
