// Square roots, powers and logarithms on software doubles
import cmath;
import cfloat;

int main() {
    int two = dlit("2");                    // a double is an int holding the IEEE 754 bits; dlit reads one from text
    printfd("sqrt(2)     = %.17g\n", sqrt(two));
    printfd("cbrt(27)    = %g\n", cbrt(dlit("27")));
    printfd("pow(2, 0.5) = %.17g\n", pow(two, dlit("0.5")));
    printfd("pow(2, 10)  = %g\n", pow(two, itod(10)));     // itod: an int as a double
    printfd("exp(1)      = %.17g\n", exp(itod(1)));
    printfd("log(e)      = %g\n", log(M_E));                 // M_E, M_PI ... are doubles too
    printfd("log2(1024)  = %g\n", log2(itod(1024)));
    printfd("log10(0.001)= %g\n", log10(dlit("0.001")));
    printfd("hypot(3, 4) = %g\n", hypot(itod(3), itod(4)));

    // the arithmetic is done by functions: (3 + 4) * 0.5
    int x = dmul(dadd(itod(3), itod(4)), dlit("0.5"));
    printfd("(3 + 4) * 0.5 = %g\n", x);
    printfd("1 / 3         = %.20f\n", ddiv(itod(1), itod(3)));
    return 0;
}
