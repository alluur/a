// Computing with doubles: pi from a series, e from another
import cmath;
import cfloat;

int main() {
    // Leibniz: pi/4 = 1 - 1/3 + 1/5 - 1/7 ...  (slow: 1000 terms give 3 digits)
    int sum = itod(0);
    for (int k = 0; k < 1000; k++) {
        int term = ddiv(itod(1), itod(2 * k + 1));
        if (k % 2 == 0) sum = dadd(sum, term); else sum = dsub(sum, term);
    }
    printfd("Leibniz, 1000 terms: %.6f\n", dmul(sum, itod(4)));

    // e = 1 + 1/1! + 1/2! + 1/3! ...  (fast: 18 terms give every digit of a double)
    int e = itod(1);
    int term = itod(1);
    for (int n = 1; n <= 18; n++) {
        term = ddiv(term, itod(n));
        e = dadd(e, term);
    }
    printfd("series for e:        %.15f\n", e);
    printfd("exp(1) from cmath:   %.15f\n", exp(itod(1)));
    printf("the same double: %d\n", deq(e, exp(itod(1))));

    // Newton's method for the square root of 2: x = (x + 2/x) / 2
    int x = itod(1);
    for (int i = 0; i < 6; i++) {
        x = ddiv(dadd(x, ddiv(itod(2), x)), itod(2));
        printfd("step %d: %.15f\n", i + 1 , x);
    }
    return 0;
}
