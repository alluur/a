// A C program ported to A: head, with getopt and error messages
// book: args=-n 2 poem.txt missing.txt poem.txt
// book: exit=1
import cstdio;
import cstdlib;
import cstring;
import cerrno;
import cunistd;
import climits;                  // NULL

static int head(FILE *f, int n) {
    char line[256];
    int shown = 0;
    while (shown < n && fgets(line, sizeof line, f) != NULL) {
        fputs(line, stdout);
        shown++;
    }
    return shown;
}

int main(int argc, char **argv) {
    int n = 10, quiet = 0, opt, status = 0;

    while ((opt = getopt(argc, argv, "n:q")) != -1) {
        switch (opt) {
        case 'n': {
            char *end;
            n = (int) strtol(optarg, &end, 10);
            if (*end != '\0' || n < 0) {
                fprintf(stderr, "head: bad line count '%s'\n", optarg);
                return 2;
            }
            break;
        }
        case 'q':
            quiet = 1;
            break;
        default:
            fprintf(stderr, "usage: head [-n lines] [-q] [file ...]\n");
            return 2;
        }
    }

    if (optind == argc) {
        head(stdin, n);
        return 0;
    }
    for (int i = optind; i < argc; i++) {
        FILE *f = fopen(argv[i], "r");
        if (f == NULL) {
            fprintf(stderr, "head: %s: %s\n", argv[i], strerror(errno));
            status = 1;
            continue;
        }
        if (!quiet && argc - optind > 1) printf("==> %s <==\n", argv[i]);
        head(f, n);
        fclose(f);
    }
    return status;
}
