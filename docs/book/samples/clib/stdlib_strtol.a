// strtol: numbers from text, with a base and error detection
import cstdlib;
import cerrno;

void parse(char* text, int base) {
    char* end;
    errno = 0;
    int v = strtol(text, &end, base);
    printf("\"%s\" base %d -> %d", text, base, v);
    if (end == text) printf(" (no digits)");
    else if (*end != 0) printf(" (stopped at \"%s\")", end);
    if (errno == ERANGE) printf(" (out of range)");
    println("");
}

int main() {
    parse("123", 10);
    parse("  -42abc", 10);                          // blanks and the sign are accepted, then it stops at 'a'
    parse("ff", 16);
    parse("0xff", 16);                              // the 0x prefix is fine for base 16
    parse("0xff", 0);                               // base 0: the prefix decides (0x hex, 0 octal, else decimal)
    parse("0755", 0);
    parse("1010", 2);
    parse("zz", 36);                                // digits go up to z
    parse("hello", 10);                             // nothing to convert: 0 and end == text
    parse("99999999999999999999", 10);              // too big: the limit, and errno is ERANGE

    // strtoul gives the bit pattern of an unsigned number
    printf("strtoul of 2^64-1: %u\n", strtoul("18446744073709551615", null, 10));
    printf("atol: %d, atoi: %d\n", atol("77 dwarfs"), atoi("-5"));
    return 0;
}
