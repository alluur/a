// Formatting dates with strftime
import ctime;

void fmt(tm* p, char* f) {
    char out[100];
    strftime(out, 100, f, p);                          // the result of 0 means: it did not fit
    printf("%-22s %s\n", f, out);
}

int main() {
    int t = 1790000000;                                // Monday 2026-09-21 14:13:20 UTC
    tm* p = gmtime(&t);
    fmt(p, "%Y-%m-%d");
    fmt(p, "%F %T");                                   // ISO date and time
    fmt(p, "%A, %d %B %Y");
    fmt(p, "%a %b %e");                                // %e: day padded with a space
    fmt(p, "%I:%M %p");                                // 12 hour clock
    fmt(p, "%H%M%S");
    fmt(p, "%j");                                      // day of the year
    fmt(p, "week %U / ISO %V");
    fmt(p, "%u %w");                                   // weekday 1-7 (Monday first), 0-6 (Sunday first)
    fmt(p, "%s");                                      // seconds since 1970
    fmt(p, "%z %Z");                                   // zone offset and name
    fmt(p, "100%%");
    fmt(p, "%D %R");

    char small[8];
    printf("too small a buffer gives %d\n", strftime(small, 8, "%A, %d %B %Y", p));
    return 0;
}
