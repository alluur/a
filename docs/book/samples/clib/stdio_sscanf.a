// sscanf: taking text apart
import cstdio;

int main() {
    int year; int month; int day;
    int n = sscanf("2026-09-21", "%d-%d-%d", &year, &month, &day);     // pass the addresses
    printf("%d items: year %d, month %d, day %d\n", n, year, month, day);

    char name[32];
    int age;
    n = sscanf("  Ann   31 years", "%s %d", name, &age);               // white space in the format matches any amount
    printf("%d items: %s is %d\n", n, name, age);

    n = sscanf("key=value", "%[^=]=%s", name, name + 16);              // %[^=]: everything up to '='
    printf("%d items: %s -> %s\n", n, name, name + 16);

    int hex; int dec;
    sscanf("ff 255", "%x %d", &hex, &dec);
    printf("hex %d, dec %d\n", hex, dec);

    int used;
    sscanf("12345 rest", "%d%n", &dec, &used);                         // %n: characters consumed so far
    printf("%d characters used for %d\n", used, dec);

    // the return value tells how far it got
    int a = -1; int b = -1;
    n = sscanf("7 seven", "%d %d", &a, &b);
    printf("matched %d of 2 (a=%d, b=%d)\n", n, a, b);
    n = sscanf("", "%d", &a);
    printf("empty input: %d (EOF is %d)\n", n, EOF);

    char c; int skipped;
    sscanf("x 5", "%c %*d %n", &c, &skipped);                          // %*d reads a number and throws it away
    printf("c=%c, %d characters read\n", c, skipped);
    return 0;
}
