// Temporary files and directories that cannot clash
import cunistd;
import cstdlib;

int main() {
    char tmpl[32];
    strcpy(tmpl, "scratch-XXXXXX");                // the template ends in six X, which are replaced
    int fd = mkstemp(tmpl);                        // creates the file and opens it: no other program can get the name first
    printf("fd valid: %d\n", fd >= 3);
    printf("prefix kept: %d, X replaced: %d\n", startsWith(tmpl, "scratch-"), tmpl[8] != 'X');
    write(fd, "temporary data", 14);
    close(fd);

    Stat st;
    stat(tmpl, &st);
    printf("size: %d\n", st.st_size);
    unlink(tmpl);

    char dir[32];
    strcpy(dir, "workdir-XXXXXX");
    printf("mkdtemp: %s\n", mkdtemp(dir) != null ? "created" : "failed");
    stat(dir, &st);
    printf("it is a directory: %d\n", S_ISDIR(st.st_mode));
    rmdir(dir);
    return 0;
}
