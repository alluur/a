// Rounding: floor, ceil, trunc, round and rint
import cmath;
import cfloat;

int main() {
    char* inputs[6];
    inputs[0] = "2.5"; inputs[1] = "-2.5"; inputs[2] = "2.4"; inputs[3] = "3.5"; inputs[4] = "-0.4"; inputs[5] = "7";
    printf("%6s %6s %6s %6s %6s %6s\n", "x", "floor", "ceil", "trunc", "round", "rint");
    for (int i = 0; i < 6; i++) {
        int x = dlit(inputs[i]);
        printfd("%6g %6g %6g %6g %6g %6g\n", x, floor(x), ceil(x), trunc(x), round(x), rint(x));
    }
    // round: halves away from zero (2.5 becomes 3). rint: halves to the even number (2.5 becomes 2, 3.5 becomes 4)

    // to an int: dtoi cuts toward zero; lround rounds
    printf("dtoi(-2.9) = %d, lround(-2.9) = %d\n", dtoi(dlit("-2.9")), lround(dlit("-2.9")));

    // remainders
    printfd("fmod(7.5, 2)       = %g\n", fmod(dlit("7.5"), itod(2)));            // 1.5
    printfd("fmod(-7.5, 2)      = %g\n", fmod(dlit("-7.5"), itod(2)));           // -1.5, the sign of the first
    printfd("remainder(7.5, 2)  = %g\n", remainder(dlit("7.5"), itod(2)));       // -0.5: 7.5 - 4 * 2
    int ip;
    int frac = modf(dlit("3.75"), &ip);                                          // integer and fractional parts
    printfd("modf(3.75)         = %g + %g\n", ip, frac);
    return 0;
}
