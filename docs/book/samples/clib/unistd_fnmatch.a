// Wildcard matching with fnmatch
import cunistd;

void test(char* pattern, char* name, int flags = 0, char* flagName = "") {
    printf("%-12s %-14s %-14s %s\n", pattern, name, flagName, fnmatch(pattern, name, flags) == 0 ? "match" : "no match");
}

int main() {
    test("*.txt", "notes.txt");                    // * matches any number of characters
    test("*.txt", "notes.txt.bak");
    test("note?.txt", "note1.txt");                // ? matches exactly one
    test("[a-c]*", "banana");                      // a character class
    test("[!a-c]*", "banana");                     // [!...]: not one of these
    test("*", "src/main.a");                       // without FNM_PATHNAME * also matches '/'
    test("*", "src/main.a", FNM_PATHNAME, "FNM_PATHNAME");     // with it, wildcards stop at '/'
    test("src/*.a", "src/main.a", FNM_PATHNAME, "FNM_PATHNAME");
    test("*", ".hidden");
    test("*", ".hidden", FNM_PERIOD, "FNM_PERIOD");            // a leading dot must be matched by an explicit dot
    test("*.TXT", "notes.txt");
    test("*.TXT", "notes.txt", FNM_CASEFOLD, "FNM_CASEFOLD");  // ignore case
    test("a\\*b", "a*b");                          // a backslash escapes the wildcard
    return 0;
}
