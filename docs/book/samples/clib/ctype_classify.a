// Classifying characters with the C names
import cctype;

int main() {
    char* sample = "aZ5 !_\t";
    printf("char   alpha digit upper lower space punct xdigit\n");
    for (int i = 0; sample[i] != 0; i++) {
        int c = sample[i];
        char* name = "";
        if (c == ' ') name = "space";
        else if (c == '\t') name = "tab";
        if (name[0] != 0) printf("%-6s", name); else printf("%c     ", c);
        printf(" %5d %5d %5d %5d %5d %5d %6d\n",
               isalpha(c), isdigit(c), isupper(c), islower(c), isspace(c), ispunct(c), isxdigit(c));
    }
    return 0;
}
