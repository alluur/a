// The POSIX random number generators: the same sequence on every platform
import cstdlib;
import cfloat;

int main() {
    srand48(2026);                                  // the seed fixes the whole sequence
    printf("lrand48:");
    for (int i = 0; i < 5; i++) printf(" %d", lrand48());      // 0 ... 2^31 - 1
    println("");
    printf("mrand48:");
    for (int i = 0; i < 3; i++) printf(" %d", mrand48());      // -2^31 ... 2^31 - 1
    println("");
    printf("drand48: %.6f %.6f %.6f\n", drand48(), drand48(), drand48());   // doubles in [0, 1)

    srand48(2026);                                  // the same seed starts the same sequence again
    printf("again:   %d\n", lrand48());

    // erand48 keeps its state in an array you own, so several generators can run side by side
    int state[3];
    state[0] = 1; state[1] = 2; state[2] = 3;
    printf("erand48: %.6f %.6f\n", erand48(state), erand48(state));

    // rand and srand of the standard library: one shared generator, also repeatable
    srand(7);
    int first = rand();
    srand(7);
    printf("rand repeats: %d\n", first == rand());

    // a die: rand() % 6 + 1
    int counts[6];
    for (int i = 0; i < 6; i++) counts[i] = 0;
    for (int i = 0; i < 600; i++) counts[lrand48() % 6]++;
    int total = 0;
    for (int i = 0; i < 6; i++) total += counts[i];
    printf("600 throws, all counted: %d\n", total == 600);
    return 0;
}
