// 0.1 + 0.2 is not 0.3: the same on every platform
import cmath;
import cfloat;

int main() {
    int a = dlit("0.1");
    int b = dlit("0.2");
    int sum = dadd(a, b);
    println(dtostr(sum));                                 // the shortest text that reads back as this very double
    println(dtostr(dlit("0.3")));
    printf("0.1 + 0.2 == 0.3: %d\n", deq(sum, dlit("0.3")));
    printfd("%.20f\n", dlit("0.1"));                      // what 0.1 really is: a little more than a tenth
    printfd("%.20f\n", sum);

    // the gap between a number and the next one is DBL_EPSILON for numbers near 1
    printfd("DBL_EPSILON = %g\n", DBL_EPSILON);
    int next = nextafter(itod(1), itod(2));
    printf("next double after 1: %s\n", dtostr(next));
    printf("1 + epsilon/2 == 1: %d\n", deq(dadd(itod(1), ddiv(DBL_EPSILON, itod(2))), itod(1)));

    // compare with a tolerance, not with ==
    int diff = fabs(dsub(sum, dlit("0.3")));
    printf("close enough: %d\n", dlt(diff, dlit("1e-12")));

    // summing ten tenths
    int total = itod(0);
    for (int i = 0; i < 10; i++) total = dadd(total, dlit("0.1"));
    printf("ten times 0.1 = %s, equals 1: %d\n", dtostr(total), deq(total, itod(1)));
    return 0;
}
