// The "C" locale: the only one there is
import clocale;

int main() {
    println(setlocale(LC_ALL, null));         // null asks without changing: always "C"
    println(setlocale(LC_ALL, ""));           // "" means the environment's choice: still "C"
    println(setlocale(LC_CTYPE, "en_US.UTF-8"));    // UTF-8 names are accepted: text is UTF-8 anyway
    printBool(setlocale(LC_ALL, "xx_YY") == null);   // names it does not know fail
    println(" : unknown locale refused");

    lconv* l = localeconv();                  // number formatting rules of the locale
    printf("decimal point: \"%s\"\n", l->decimal_point);
    printf("thousands separator: \"%s\"\n", l->thousands_sep);
    return 0;
}
