// Text to double: strtod, atof and dlit
import cfloat;

int main() {
    char* inputs[6];
    inputs[0] = "3.14159";
    inputs[1] = "  -2.5e3 apples";                 // leading blanks are skipped, parsing stops at "apples"
    inputs[2] = ".5";
    inputs[3] = "0x1.8p3";                         // hexadecimal: 1.5 * 2^3 = 12
    inputs[4] = "inf";
    inputs[5] = "banana";

    for (int i = 0; i < 6; i++) {
        char* end;
        int x = strtod(inputs[i], &end);           // end points at the first character that was not used
        printf("\"%s\" -> %s, stopped at \"%s\"\n", inputs[i], dtostr(x), end);
    }

    printf("atof(\"2.75\") = %s\n", dtostr(atof("2.75")));       // atof: no way to tell about errors
    printf("dlit(\"1e-3\") = %s\n", dtostr(dlit("1e-3")));        // dlit: the same for a text you trust

    // nothing could be read: end is the start of the text, and the result is 0
    char* bad = "xyz";
    char* end;
    strtod(bad, &end);
    printf("\"xyz\" consumed %d characters\n", end - bad);
    return 0;
}
