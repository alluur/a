// The double type and the C library: bits in, bits out
import cmath;
import cfloat;
import cstdio;

// the C functions take and return a double as an int holding its 64 bits; these wrappers add the types
double sqrtd(double x) { return __dbl(sqrt(__bits(x))); }
double powd(double x, double y) { return __dbl(pow(__bits(x), __bits(y))); }

int main() {
    double x = 2.0;                                  // a real double: use it with + - * / and comparisons
    printlnDouble(sqrtd(x));
    printlnDouble(powd(x, 0.5));
    printlnDouble(x * x + 1);

    // printf passes a double as its 64 bits and %f reads them back: no __bits needed
    printf("sqrt(2) = %.10f\n", sqrtd(x));
    printf("%d items of %.2f = %.2f\n", 3, 9.99, 3 * 9.99);
    // a C function result is already a bit pattern, and %f prints that as it is
    printf("straight from the C function: %.10f\n", sqrt(__bits(x)));

    // scanf and sscanf store a double through a pointer to a double variable
    double v;
    sscanf("2.75 apples", "%lf", &v);
    printlnDouble(v * 4);

    // the two styles compute the same bits: (3 + 4) * 0.5 against dmul and dadd
    double a = (3 + 4) * 0.5;
    int b = dmul(dadd(itod(3), itod(4)), dlit("0.5"));
    printf("same number: %d\n", __bits(a) == b);

    // the constants of cmath (M_PI, M_E, INFINITY ...) are bit patterns too
    printlnDouble(__dbl(M_PI));
    double wrong = M_PI;                             // mistake 1: the integer that holds the bits is converted to a number
    printlnDouble(wrong);
    double alsoWrong = sqrt(dlit("2"));              // mistake 2: so is the result of a C function
    printlnDouble(alsoWrong);

    // mistake 3: %d shows the bits of a double, a whole number that is not the value: cast first
    printf("printf(\"%%d\", 3.99) shows %d, (int) 3.99 is %d\n", 3.99, (int) 3.99);
    // mistake 4: an int parameter converts a double to an int: printfd and the C math functions have them
    printfd("printfd(\"%%.2f\", 3.99) shows %.2f\n", 3.99);              // the int 3 read as bits: a tiny number
    printlnDouble(__dbl(sqrt(x)));                                      // sqrt of the number whose bits are 2
    return 0;
}
