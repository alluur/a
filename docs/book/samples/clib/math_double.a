// The double type and the C library: bits in, bits out
import cmath;
import cfloat;
import cstdio;

// the C functions take and return a double as an int holding its 64 bits; these wrappers add the types
double sqrtd(double x) { return __dbl(sqrt(__bits(x))); }
double powd(double x, double y) { return __dbl(pow(__bits(x), __bits(y))); }

int main() {
    double x = 2.0;                                  // a real double: use it with + - * / and comparisons
    printlnDouble(sqrtd(x));
    printlnDouble(powd(x, 0.5));
    printlnDouble(x * x + 1);

    // printfd, like printf, takes integers: give it the bits with __bits
    printfd("sqrt(2) = %.10f\n", __bits(sqrtd(x)));
    printfd("%d items of %.2f = %.2f\n", 3, __bits(9.99), __bits(3 * 9.99));

    // scanf and sscanf store a double through a pointer to a double variable
    double v;
    sscanf("2.75 apples", "%lf", &v);
    printlnDouble(v * 4);

    // the two styles compute the same bits: (3 + 4) * 0.5 against dmul and dadd
    double a = (3 + 4) * 0.5;
    int b = dmul(dadd(itod(3), itod(4)), dlit("0.5"));
    printf("same number: %d\n", __bits(a) == b);

    // the constants of cmath (M_PI, M_E, INFINITY ...) are bit patterns too
    printlnDouble(__dbl(M_PI));
    printlnDouble(M_PI);                             // the mistake: the bits are read as a whole number and converted

    // the other mistake: a double passed where an int is expected is converted to an int, not reinterpreted
    printf("printf(\"%%d\", 3.99) shows %d\n", 3.99);
    printfd("printfd(\"%%.2f\", 3.99) shows %.2f\n", 3.99);              // the int 3 read as bits: a tiny number
    printlnDouble(__dbl(sqrt(x)));                                      // sqrt of the number whose bits are 2
    return 0;
}
