// assert: a check that must hold
import cassert;

int divide(int a, int b) {
    assert(b != 0);                                   // a bug if it happens: stop here
    return a / b;
}

int main() {
    printlnInt(divide(84, 2));
    assertMsg(divide(9, 3) == 3, "9 / 3 should be 3");   // assertMsg says what was expected
    println("all assertions held");
    return 0;
}
