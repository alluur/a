// Trigonometry: angles are in radians
import cmath;
import cfloat;

// degrees to radians: deg * pi / 180
int rad(int deg) { return ddiv(dmul(itod(deg), M_PI), itod(180)); }

int main() {
    for (int deg = 0; deg <= 90; deg += 30) {
        int a = rad(deg);
        printfd("%2.0f degrees: sin %.6f  cos %.6f  tan %.6f\n", itod(deg), sin(a), cos(a), tan(a));
    }
    // sin(x)^2 + cos(x)^2 is 1 for every x (up to rounding)
    int x = dlit("0.7");
    int s = sin(x);
    int c = cos(x);
    printfd("sin^2 + cos^2 = %.15f\n", dadd(dmul(s, s), dmul(c, c)));

    // the inverse functions
    printfd("atan(1) * 4    = %.15f\n", dmul(atan(itod(1)), itod(4)));      // pi
    printfd("atan2(1, -1)   = %.6f (135 degrees = 3pi/4 = %.6f)\n", atan2(itod(1), itod(-1)), dmul(M_PI, dlit("0.75")));
    printfd("asin(0.5)      = %.6f (pi/6 = %.6f)\n", asin(dlit("0.5")), ddiv(M_PI, itod(6)));
    printfd("acos(0)        = %.6f (pi/2)\n", acos(itod(0)));

    printfd("sinh(1) = %.6f, cosh(1) = %.6f, tanh(1) = %.6f\n", sinh(itod(1)), cosh(itod(1)), tanh(itod(1)));
    return 0;
}
