// Information about files: stat, access, chmod, truncate
import cunistd;
import cstdio;

void describe(char* path) {
    Stat st;
    if (stat(path, &st) != 0) {
        printf("%-10s does not exist\n", path);
        return;
    }
    char* kind = S_ISDIR(st.st_mode) ? "directory" : (S_ISREG(st.st_mode) ? "file" : "other");
    printf("%-10s %-9s mode %o", path, kind, st.st_mode & 0b111111111);
    if (S_ISREG(st.st_mode)) printf(", %d bytes", st.st_size);    // the size of a directory depends on the file system
    println("");
}

int main() {
    writeFile("note.txt", "hello world");
    mkdir("folder", 0b111101101);                       // rwxr-xr-x. A has no octal literals: 0755 would be decimal 755
    chmod("note.txt", 0b110100100);                     // 644; chmod ignores the umask, so the output is the same everywhere
    chmod("folder", 0b111101101);
    describe("note.txt");
    describe("folder");
    describe("missing");

    chmod("note.txt", 0b110000000);                     // 600: only the owner may read and write
    describe("note.txt");

    truncate("note.txt", 5);                            // cut to 5 bytes
    describe("note.txt");

    printf("access exists: %d\n", access("note.txt", F_OK));          // 0 means yes
    printf("access read+write: %d\n", access("note.txt", R_OK | W_OK));
    printf("access missing: %d\n", access("missing", F_OK));

    // symbolic links: lstat does not follow them
    symlink("note.txt", "alias");
    Stat st;
    lstat("alias", &st);
    printf("alias is a link: %d\n", S_ISLNK(st.st_mode));
    stat("alias", &st);
    printf("following it, a file: %d\n", S_ISREG(st.st_mode));
    char target[64];
    int n = readlink("alias", target, 63);                           // the text of the link; no zero is added
    target[n] = 0;
    printf("it points to \"%s\"\n", target);

    printf("unlink: %d, again: %d\n", unlink("alias"), unlink("alias"));
    return 0;
}
