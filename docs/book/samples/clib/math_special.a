// Infinity, NaN, negative zero: what IEEE 754 does for odd results
import cmath;
import cfloat;

void show(char* label, int x) {
    printf("%-14s %-9s class %d\n", label, dtostr(x), fpclassify(x));
}

int main() {
    int zero = itod(0);
    int one = itod(1);
    show("1 / 0", ddiv(one, zero));                       // inf
    show("-1 / 0", ddiv(itod(-1), zero));                 // -inf
    show("0 / 0", ddiv(zero, zero));                      // nan
    show("sqrt(-1)", sqrt(itod(-1)));                     // nan
    show("log(0)", log(zero));                            // -inf
    show("-0.0", dneg(zero));
    show("1e-320", dlit("1e-320"));                       // a subnormal number: tiny, with less precision
    show("1e308 * 10", dmul(dlit("1e308"), itod(10)));    // overflow gives inf

    printf("classes: nan=%d inf=%d zero=%d subnormal=%d normal=%d\n", FP_NAN, FP_INFINITE, FP_ZERO, FP_SUBNORMAL, FP_NORMAL);

    int nan = NAN;
    printf("nan == nan: %d (dcmp gives %d: unordered)\n", deq(nan, nan), dcmp(nan, nan));
    printf("isnan: %d, isinf(inf): %d, isfinite(1): %d\n", isnan(nan), isinf(INFINITY), isfinite(one));
    printf("-0 == +0: %d, but signbit(-0) = %d\n", deq(dneg(zero), zero), signbit(dneg(zero)));
    return 0;
}
