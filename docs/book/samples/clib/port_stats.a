// A C program ported to A: statistics with doubles
import cstdio;
import cmath;
import cfloat;

const MAXN = 100;

int main() {
    // in C: double v[MAXN], x, sum = 0, sq = 0, lo, hi;
    // in A a double is an int that holds the 64 bits of the number, and scanf stores it there
    int v[MAXN], x, sum = 0, sq = 0, lo, hi;
    int n = 0;

    while (n < MAXN && scanf("%lf", &x) == 1) {
        v[n++] = x;
        sum = dadd(sum, x);                           // sum += x
    }
    if (n == 0) {
        printf("no numbers\n");
        return 1;
    }
    int mean = ddiv(sum, itod(n));                    // sum / n
    lo = hi = v[0];
    for (int i = 0; i < n; i++) {
        int d = dsub(v[i], mean);
        sq = dadd(sq, dmul(d, d));                    // sq += (v[i] - mean) * (v[i] - mean)
        if (dlt(v[i], lo)) lo = v[i];                 // comparisons: dlt dle dgt dge deq
        if (dgt(v[i], hi)) hi = v[i];
    }
    printf("count  %d\n", n);
    printfd("mean   %.3f\n", mean);
    printfd("stddev %.3f\n", sqrt(ddiv(sq, itod(n))));
    printfd("range  %g .. %g\n", lo, hi);
    return 0;
}
