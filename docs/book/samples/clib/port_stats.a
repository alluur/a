// A C program ported to A: statistics with doubles
import cstdio;
import dmath;
import cfloat;

const MAXN = 100;

int main() {
    double v[MAXN], x, sum = 0, sq = 0, lo, hi;       // the same declaration as in C
    int n = 0;

    while (n < MAXN && scanf("%lf", &x) == 1) {       // scanf stores the 64 bits through the pointer
        v[n++] = x;
        sum += x;
    }
    if (n == 0) {
        printf("no numbers\n");
        return 1;
    }
    double mean = sum / n;
    lo = hi = v[0];
    for (int i = 0; i < n; i++) {
        sq += (v[i] - mean) * (v[i] - mean);
        if (v[i] < lo) lo = v[i];
        if (v[i] > hi) hi = v[i];
    }
    printf("count  %d\n", n);
    printfd("mean   %.3f\n", __bits(mean));            // printfd takes the bit pattern of a double
    printfd("stddev %.3f\n", __bits(dmath.sqrt(sq / n)));      // sqrt of <math.h> is dmath.sqrt
    printfd("range  %g .. %g\n", __bits(lo), __bits(hi));
    return 0;
}
