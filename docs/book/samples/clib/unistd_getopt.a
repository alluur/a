// getopt: the classic option parser
// book: args=-v -o out.txt -n5 -x file1 file2
import cunistd;
import cstdio;

int main(int argc, char** argv) {
    int verbose = 0;
    char* output = "a.out";
    int count = 1;
    int c;
    // letters followed by ':' take an argument; the leading ':' makes a missing argument report ':' instead of '?'
    while ((c = getopt(argc, argv, ":vo:n:")) != -1) {
        if (c == 'v') verbose = 1;
        else if (c == 'o') output = optarg;               // optarg points at the argument
        else if (c == 'n') count = atoi(optarg);          // "-n5" and "-n 5" both work
        else if (c == '?') printf("unknown option -%c\n", optopt);
        else if (c == ':') printf("option -%c needs an argument\n", optopt);
    }
    printf("verbose=%d output=%s count=%d\n", verbose, output, count);
    printf("the %d other arguments start at index %d:\n", argc - optind, optind);
    for (int i = optind; i < argc; i++) printf("  %s\n", argv[i]);
    return 0;
}
