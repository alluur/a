// import clib: one line gives you the whole C library
import clib;

int byLength(char* a, char* b) {                       // qsort passes pointers to two elements
    return strlen(((char**) a)[0]) - strlen(((char**) b)[0]);
}

int main() {
    // files and formatted output
    FILE* f = fopen("report.txt", "w");
    fprintf(f, "%-8s|%6d|\n", "total", 1600);
    fclose(f);

    // reading it back with scanf: the addresses are passed as they are
    char word[32];
    int amount;
    f = fopen("report.txt", "r");
    fscanf(f, "%s | %d", word, &amount);
    fclose(f);
    printf("%s %d\n", word, amount);

    // sorting strings through a function pointer
    char* names[3];
    names[0] = "ccc"; names[1] = "a"; names[2] = "bb";
    qsort((char*) names, 3, 8, byLength);              // base, count, element size, comparison
    printf("%s %s %s\n", names[0], names[1], names[2]);

    // dates
    int when = 1700000000;
    char text[64];
    strftime(text, 64, "%A, %d %B %Y", gmtime(&when));
    println(text);

    // numbers with a fraction: the C math functions take and return a double as an int with its 64 bits
    int r = sqrt(dlit("2"));
    printfd("sqrt(2) = %.15f, sin(1) = %g\n", r, sin(itod(1)));

    // memory, the environment and other programs
    char* buf = malloc(100);
    strcpy(buf, "hello");
    free(buf);
    setenv("TOUR", "yes", true);
    printf("TOUR=%s\n", getenv("TOUR"));
    printf("exit code %d\n", system("exit 3"));
    return 0;
}
