// errno: what went wrong
import cstdio;
import cerrno;

int main() {
    FILE* f = fopen("/no/such/directory/file.txt", "r");
    if (f == null) {
        printf("errno = %d\n", errno);                 // the Linux numbers, on every platform
        printf("ENOENT = %d\n", ENOENT);
        println(strerror(errno));                      // the message for it
        printBool(errno == ENOENT);
        println(" : no such file or directory");
    }

    errno = 0;
    FILE* g = fopen("/", "w");                          // a directory cannot be opened for writing
    if (g == null) {
        printf("errno = %d: %s\n", errno, strerror(errno));
    }

    // perror writes to standard error: "prefix: message"
    errno = EACCES;
    perror("config");
    return 0;
}
