// Splitting strings: strtok, strtok_r and strsep
import cstring;

int main() {
    // strtok changes the text (delimiters become zero bytes), so work on a copy
    char line[64];
    strcpy(line, "alpha, beta;gamma  delta");
    char* tok = strtok(line, ",; ");
    while (tok != null) {
        printf("[%s] ", tok);
        tok = strtok(null, ",; ");                  // null: continue with the same text
    }
    println("");                                    // runs of delimiters collapse: no empty tokens

    // strtok_r keeps its place in a variable of yours, so two splits can be interleaved
    char a[32]; char b[32];
    strcpy(a, "1,2,3");
    strcpy(b, "x,y,z");
    char* sa; char* sb;
    char* ta = strtok_r(a, ",", &sa);
    char* tb = strtok_r(b, ",", &sb);
    while (ta != null && tb != null) {
        printf("%s%s ", ta, tb);
        ta = strtok_r(null, ",", &sa);
        tb = strtok_r(null, ",", &sb);
    }
    println("");

    // strsep returns empty fields as well: right for CSV-like data
    char csv[32];
    strcpy(csv, "name,,42,");
    char* rest = csv;
    int n = 0;
    char* field;
    while ((field = strsep(&rest, ",")) != null) {
        n++;
        printf("field %d: \"%s\"\n", n, field);
    }
    return 0;
}
