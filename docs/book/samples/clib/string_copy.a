// Copying and joining strings without overflowing the buffer
import cstring;

int main() {
    char small[8];

    // strncpy: copies at most n characters and does NOT add a zero when the source is too long
    strncpy(small, "hello, world", 8);
    printf("strncpy: terminated = %d\n", memchr(small, 0, 8) != null);     // 0: not a string any more!

    // strlcpy: always terminates, and returns the length it wanted
    int wanted = strlcpy(small, "hello, world", 8);
    printf("strlcpy: \"%s\", wanted %d characters\n", small, wanted);      // truncated if wanted >= size

    // strlcat: append within a total size
    char path[16];
    strlcpy(path, "/usr/", 16);
    int total = strlcat(path, "local/share/applications", 16);
    printf("strlcat: \"%s\", would have been %d\n", path, total);

    // strncat: append at most n characters of the source (and always terminate)
    char s[16];
    strcpy(s, "ab");
    strncat(s, "cdefgh", 3);
    println(s);

    // stpcpy returns the end: chaining copies without scanning again
    char buf[32];
    char* end = stpcpy(buf, "one");
    end = stpcpy(end, "-two");
    stpcpy(end, "-three");
    println(buf);

    char* part = strndup("truncated copy", 9);      // a heap copy of at most 9 characters
    println(part);
    printf("strnlen(\"abcdef\", 3) = %d\n", strnlen("abcdef", 3));
    return 0;
}
