// Memory functions: memmove, memcmp, memchr
import cstring;

int main() {
    char buf[32];
    strcpy(buf, "abcdefghij");

    // memcpy must not overlap; memmove can: shift "cdefghij" two places to the left
    memmove(buf, buf + 2, 9);                       // 8 characters and the zero
    println(buf);                                   // cdefghij
    memmove(buf + 2, buf, 9);                       // and back to the right, overlapping
    println(buf);                                   // cdcdefghij

    printf("memcmp: %d %d %d\n", memcmp("abc", "abd", 3) < 0, memcmp("abc", "abd", 2), memcmp("b", "a", 1) > 0);

    char* data = "key=value;other=thing";
    char* eq = memchr(data, '=', 21);               // first '=' in the first 21 bytes
    printf("first '=' at index %d\n", eq - data);
    char* last = memrchr(data, '=', 21);            // the last one
    printf("last '=' at index %d\n", last - data);
    printf("no 'z': %d\n", memchr(data, 'z', 21) == null);

    // memccpy copies up to and including a stop character
    char out[32];
    char* after = memccpy(out, data, ';', 21);
    *after = 0;                                     // it returns the address after the copied ';'
    println(out);

    memset(buf, '-', 5);
    buf[5] = 0;
    println(buf);
    return 0;
}
