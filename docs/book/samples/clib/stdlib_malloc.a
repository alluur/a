// malloc and free: memory that can be given back
import cstdlib;
import cstring;

struct Node { int value; Node* next; }

int main() {
    // calloc: count and size, zeroed
    int* a = (int*) calloc(4, 8);
    printf("calloc: %d %d %d %d\n", a[0], a[1], a[2], a[3]);
    for (int i = 0; i < 4; i++) a[i] = (i + 1) * 11;

    // realloc: a bigger block with the old content in front
    a = (int*) realloc((char*) a, 8 * 8);
    printf("after realloc: %d %d %d %d | %d\n", a[0], a[1], a[2], a[3], a[7]);
    printf("usable bytes: at least 64: %d\n", malloc_usable_size((char*) a) >= 64);

    // a linked list on the heap, then taken apart again
    Node* head = null;
    for (int i = 1; i <= 5; i++) {
        Node* n = (Node*) malloc(sizeof(Node));
        n->value = i * i;
        n->next = head;
        head = n;
    }
    int sum = 0;
    while (head != null) {
        Node* next = head->next;
        sum += head->value;
        free((char*) head);                      // every block that is freed can be used again
        head = next;
    }
    printf("sum of squares: %d\n", sum);

    // freed memory is reused: a block of the same size comes back at the same address, zeroed again
    char* p = malloc(100);
    memset(p, 'x', 100);
    free(p);
    char* q = malloc(100);
    printf("same block again: %d, zeroed again: %d\n", p == q, q[0] == 0);
    free(q);
    free(null);                                  // free(null) does nothing
    free((char*) a);
    return 0;
}
