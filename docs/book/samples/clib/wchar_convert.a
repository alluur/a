// Wide characters: code points in ints
import cwchar;

int main() {
    char* text = "naïve café, Ωμέγα, 日本語";          // UTF-8: one character may take 1 to 4 bytes
    printf("bytes: %d\n", strlen(text));

    int wide[64];                                      // a wide string is an int array ended by 0
    int n = mbstowcs(wide, text, 64);                  // UTF-8 to code points; returns how many characters
    printf("characters: %d\n", n);
    printf("wcslen: %d\n", wcslen(wide));
    printf("code point of the 3rd character: U+%04X\n", wide[2]);   // the diaeresis i
    printf("code point of the 1st Greek letter: U+%04X\n", wide[12]);

    // each character knows its class and its case
    printf("iswalpha: %d %d %d %d\n", iswalpha(wide[0]), iswalpha(wide[4]), iswalpha(wide[5]), iswalpha(wide[12]));
    int upper[64];
    for (int i = 0; i <= n; i++) upper[i] = towupper(wide[i]);
    char out[128];
    wcstombs(out, upper, 128);                         // code points to UTF-8 again
    println(out);

    // columns in a terminal: CJK characters are two wide
    printf("display width: %d columns for %d characters\n", wcswidth(wide, n), n);

    // one character at a time
    int wc;
    int used = mbtowc(&wc, "€uro", 4);                 // decodes the first character
    printf("€ is U+%04X and takes %d bytes\n", wc, used);
    char bytes[8];
    int k = wctomb(bytes, 0x1F600);                    // encode a code point
    printf("U+1F600 needs %d bytes: %02x %02x %02x %02x\n", k, bytes[0], bytes[1], bytes[2], bytes[3]);
    return 0;
}
