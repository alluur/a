// Date arithmetic: timegm normalizes the fields
import ctime;

// the date of a time as text
char* when(int t) {
    char* out = alloc(32);
    strftime(out, 32, "%a %Y-%m-%d", gmtime(&t));
    return out;
}

int main() {
    tm d;                                              // 2026-01-31 12:00:00
    d.tm_year = 2026 - 1900; d.tm_mon = 0; d.tm_mday = 31;
    d.tm_hour = 12; d.tm_min = 0; d.tm_sec = 0;
    int start = timegm(&d);
    printf("start:         %s\n", when(start));

    d.tm_mon = d.tm_mon + 1;                           // one month later: February 31 does not exist
    printf("+1 month:      %s\n", when(timegm(&d)));   // so it becomes March 3

    d.tm_year = 2026 - 1900; d.tm_mon = 0; d.tm_mday = 31;
    d.tm_mday = d.tm_mday + 100;                       // 100 days later
    printf("+100 days:     %s\n", when(timegm(&d)));

    d.tm_mon = 2; d.tm_mday = 0;                       // day 0 of March = the last day of February
    printf("end of Feb:    %s\n", when(timegm(&d)));

    d.tm_year = 2024 - 1900; d.tm_mon = 2; d.tm_mday = 0;
    printf("end of Feb 2024: %s (a leap year)\n", when(timegm(&d)));

    // the difference of two dates in days
    tm a; tm b;
    a.tm_year = 2026 - 1900; a.tm_mon = 11; a.tm_mday = 25; a.tm_hour = 0; a.tm_min = 0; a.tm_sec = 0;
    b.tm_year = 2026 - 1900; b.tm_mon = 0;  b.tm_mday = 1;  b.tm_hour = 0; b.tm_min = 0; b.tm_sec = 0;
    printf("days from 1 Jan to 25 Dec 2026: %d\n", difftime(timegm(&a), timegm(&b)) / 86400);
    return 0;
}
