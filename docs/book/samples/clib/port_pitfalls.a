// Things that behave differently from C
import clib;

int main() {
    // 1. int is 64 bits, long is the same type, char is unsigned
    printf("sizeof: char %d, int %d, long %d, pointer %d\n", sizeof(char), sizeof(int), sizeof(long), sizeof(char*));
    char c = 200;
    printf("char 200 stays %d (C often gives -56)\n", c);

    // 2. %d reads and writes a whole 64 bit value: scanf needs a size for smaller targets
    int small = 0;
    uint8 tiny = 0;
    sscanf("300 77", "%d %hhd", &small, &tiny);
    printf("%%d stored %d, %%hhd stored %d\n", small, tiny);

    // 3. no octal literals: 010 is ten, not eight. Use 8 or 0b1000
    printf("010 is %d\n", 010);

    // 4. every integer is signed 64 bit unless you say otherwise: uint32 wraps at 32 bits
    uint32 u = 4000000000;
    uint32 more = 500000000;
    printf("uint32: %d + %d = %d\n", u, more, u + more);
    int a = 4000000000;
    int b = 500000000;
    printf("int:    %d + %d = %d\n", a, b, a + b);

    // 5. double is a real type, but printf only knows integers: it converts the double to an int
    double pi = 3.14159;
    printf("printf with a double: %d\n", pi);
    printfd("printfd with the bits:  %.5f\n", __bits(pi));

    // 6. a function pointer gets no type check: the callback returns an int and takes ints
    func f = abs;
    printf("through a func: %d\n", f(-5));

    // 7. malloc always returns zeroed memory here (in C it does not)
    int* p = (int*) malloc(16);
    printf("first malloc'ed int: %d\n", p[0]);
    free((char*) p);

    // 8. string literals are writable data, not read-only
    char* s = "hello";
    s[0] = 'J';
    println(s);
    return 0;
}
