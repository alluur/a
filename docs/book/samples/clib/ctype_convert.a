// Case conversion and digit values
import cctype;

int main() {
    char* word = "Hello, World 42";
    char up[32];
    char low[32];
    int i = 0;
    for (; word[i] != 0; i++) {
        up[i] = toupper(word[i]);          // letters only: everything else is unchanged
        low[i] = tolower(word[i]);
    }
    up[i] = 0;
    low[i] = 0;
    println(up);
    println(low);

    // digitValue: the value of a digit in any base up to 36, -1 if it is not one
    printlnInt(digitValue('7', 10));       // 7
    printlnInt(digitValue('f', 16));       // 15
    printlnInt(digitValue('F', 16));       // 15: upper or lower case
    printlnInt(digitValue('g', 16));       // -1
    printlnInt(digitValue('z', 36));       // 35
    printlnInt(digitValue('9', 8));        // -1

    // the functions work on ASCII only: bytes of a UTF-8 letter such as "e with acute" are not letters here
    printf("0xC3 is a letter: %s\n", isalpha(0xC3) ? "yes" : "no");
    printf("isascii('x'), isascii(200): %d %d\n", isascii('x'), isascii(200));
    return 0;
}
