// Clocks: wall time, monotonic time and processor time
import ctime;

int main() {
    int now = time(null);                              // seconds since 1970
    printf("after 2020: %d\n", now > 1577836800);

    timespec a; timespec b;
    clock_gettime(CLOCK_MONOTONIC, &a);                // never jumps: the right clock for measuring
    nanosleep(&(timespec){0, 30000000}, null);         // 30 ms
    clock_gettime(CLOCK_MONOTONIC, &b);
    int ms = (b.tv_sec - a.tv_sec) * 1000 + (b.tv_nsec - a.tv_nsec) / 1000000;
    printf("slept 30 ms, measured at least 30: %d\n", ms >= 30);
    printf("and less than 500: %d\n", ms < 500);

    int c0 = clock();                                  // processor time in 1/CLOCKS_PER_SEC seconds
    int x = 0;
    for (int i = 0; i < 200000; i++) x += i % 7;
    int c1 = clock();
    printf("CLOCKS_PER_SEC = %d, clock went forward: %d\n", CLOCKS_PER_SEC, c1 >= c0);
    printf("difftime(10, 4) = %d\n", difftime(10, 4));

    timeval tv;
    gettimeofday(&tv);                                 // seconds and microseconds, the old way
    printf("gettimeofday agrees with time: %d\n", tv.tv_sec - now <= 1);
    return 0;
}
