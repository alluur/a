// A C program ported to A: counting words
import cstdio;
import cstdlib;
import cstring;
import cctype;
import cfloat;

const MAXWORDS = 1000;

struct Entry {
    char word[32];
    int count;
}

Entry table[MAXWORDS];
int used = 0;

void add(char* w) {
    for (int i = 0; i < used; i++) {
        if (strcmp(table[i].word, w) == 0) {
            table[i].count++;
            return;
        }
    }
    if (used < MAXWORDS) {
        strncpy(table[used].word, w, 31);
        table[used].count = 1;
        used++;
    }
}

/* most frequent first, then alphabetical: qsort hands over pointers to two elements as char* */
int compare(char* a, char* b) {
    Entry* x = (Entry*) a;
    Entry* y = (Entry*) b;
    if (x->count != y->count) return y->count - x->count;
    return strcmp(x->word, y->word);
}

int main() {
    char word[32];
    int len = 0, c, total = 0;

    while ((c = getchar()) != EOF) {
        if (isalpha(c)) {
            if (len < 31) word[len++] = tolower(c);
        } else if (len > 0) {
            word[len] = 0;
            add(word);
            total++;
            len = 0;
        }
    }
    if (len > 0) {
        word[len] = 0;
        add(word);
        total++;
    }

    qsort((char*) table, used, sizeof(Entry), compare);
    printf("%d words, %d different\n", total, used);
    for (int i = 0; i < used && i < 5; i++) {
        double percent = 100.0 * table[i].count / total;      // double arithmetic reads as in C
        printfd("%-10s %3d  %5.1f%%\n", table[i].word, table[i].count, __bits(percent));   // printfd wants the bits
    }
    return 0;
}
