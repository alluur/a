// What a double is made of
import cmath;
import cfloat;

int main() {
    int x = dlit("0.15625");                             // 5/32 = 1.25 * 2^-3
    printf("bit pattern: 0x%x\n", x);                    // sign 1 bit, exponent 11 bits, fraction 52 bits
    printf("sign %d, exponent field %d, fraction 0x%x\n", (x >> 63) & 1, (x >> 52) & 0x7FF, x & 0xFFFFFFFFFFFFF);

    int e;
    int m = frexp(x, &e);                                // x = m * 2^e with 0.5 <= m < 1
    printfd("frexp: %g * 2^%d\n", m, e);
    printfd("ldexp(m, e) = %g\n", ldexp(m, e));          // and back
    printfd("scalbn(1, 10) = %g\n", scalbn(itod(1), 10));
    printf("ilogb(1000) = %d, logb(1000) = %s\n", ilogb(itod(1000)), dtostr(logb(itod(1000))));   // floor(log2(1000)) = 9

    // the other way: write the bits of a double yourself
    printfd("0x4009000000000000 is %g\n", 0x4009000000000000);     // sign 0, exponent 1024, fraction 0.5625: 3.125
    printfd("0x7ff0000000000000 is %g\n", 0x7ff0000000000000);     // exponent all ones, fraction 0: infinity
    return 0;
}
