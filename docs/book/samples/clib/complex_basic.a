// Complex numbers: arithmetic and the polar form
import ccomplex;
import cfloat;

int main() {
    Complex* a = cmplx(itod(3), itod(4));              // 3 + 4i
    Complex* b = cmplx(itod(1), itod(-2));             // 1 - 2i
    println(cstr(a));                                  // each result is a new Complex on the heap
    println(cstr(cadd(a, b)));
    println(cstr(csub(a, b)));
    println(cstr(cmul(a, b)));                         // (3+4i)(1-2i) = 11 - 2i
    println(cstr(cdiv(a, b)));                         // (3+4i)/(1-2i) = -1 + 2i
    println(cstr(conj(a)));
    println(cstr(cneg(a)));

    printfd("|3+4i| = %g\n", cabs(a));
    printfd("arg(3+4i) = %.6f radians\n", carg(a));
    printfd("re = %g, im = %g\n", creal(a), cimag(a));

    // nesting: expressions are made from calls
    Complex* z = cmul(cadd(a, b), conj(b));
    println(cstr(z));

    // from polar form: radius 2, angle 90 degrees
    Complex* p = cpolar(itod(2), ddiv(M_PI, itod(2)));
    printfd("2 at 90 degrees: %.6f + %.6fi\n", creal(p), cimag(p));
    return 0;
}
