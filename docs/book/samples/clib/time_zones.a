// Time zones: the TZ variable
import ctime;
import cstdlib;

// 2026-07-01 12:00:00 UTC and 2026-01-15 12:00:00 UTC
const SUMMER = 1782907200;
const WINTER = 1768478400;

void show(char* zone, int t) {
    setenv("TZ", zone, true);
    tzset();                                           // read the variable again
    tm* p = localtime(&t);                             // local time in that zone
    char out[64];
    strftime(out, 64, "%Y-%m-%d %H:%M %Z (UTC%z)", p);
    printf("%-30s %s, dst=%d\n", zone, out, p->tm_isdst);
}

int main() {
    show("UTC", SUMMER);
    show("EST5EDT", SUMMER);                           // US Eastern: standard time UTC-5, daylight saving UTC-4
    show("EST5EDT", WINTER);
    show("CET-1CEST", SUMMER);                         // note the sign: POSIX counts hours WEST of Greenwich
    show("IST-5:30", WINTER);                          // a zone with a half hour offset and no daylight saving
    show("EET-2EEST,M3.5.0/3,M10.5.0/4", SUMMER);      // an explicit rule: last Sunday of March to last Sunday of October

    // mktime goes the other way: local fields to seconds since 1970
    setenv("TZ", "EST5EDT", true);
    tzset();
    tm p;
    p.tm_year = 126; p.tm_mon = 6; p.tm_mday = 1;           // 2026-07-01
    p.tm_hour = 8; p.tm_min = 0; p.tm_sec = 0;
    p.tm_isdst = -1;                                        // -1: find out whether daylight saving applies
    int t = mktime(&p);
    printf("8:00 in New York on 2026-07-01 is 12:00 UTC: %d\n", t == SUMMER);
    printf("mktime filled in dst=%d, gmtoff=%d\n", p.tm_isdst, p.tm_gmtoff);
    return 0;
}
