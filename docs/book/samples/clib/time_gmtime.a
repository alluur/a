// Breaking a time into calendar fields
import ctime;
import cstdlib;

void show(int t) {
    tm* p = gmtime(&t);                                // seconds since 1970-01-01 00:00:00 UTC -> fields in UTC
    printf("%11d -> %04d-%02d-%02d", t, p->tm_year + 1900, p->tm_mon + 1, p->tm_mday);   // the year counts from 1900, the month from 0
    printf(" %02d:%02d:%02d, weekday %d, day of year %d\n", p->tm_hour, p->tm_min, p->tm_sec, p->tm_wday, p->tm_yday);
}

int main() {
    show(0);                                           // the epoch: a Thursday (weekday 4; Sunday is 0)
    show(86400);
    show(951782400);                                   // 2000-02-29: a leap day
    show(1700000000);
    show(-1);                                          // one second before the epoch
    show(4102444800);                                  // 2100-01-01

    int t = 1700000000;
    printf("asctime: %s", asctime(gmtime(&t)));         // a fixed format with a newline at the end
    setenv("TZ", "UTC", true);                          // ctime is the local time: pick the zone first
    tzset();
    printf("ctime:   %s", ctime(&t));

    // back again: timegm is the inverse of gmtime
    tm* p = gmtime(&t);
    printf("round trip: %d\n", timegm(p) == t);
    return 0;
}
