// Binary files: fwrite, fread and fseek to a record
import cstdio;

struct Point { int x; int y; }

int main() {
    Point pts[4];
    for (int i = 0; i < 4; i++) {
        pts[i].x = i * 10;
        pts[i].y = i * i;
    }

    FILE* f = fopen("points.bin", "wb");              // "b" does nothing on Linux but documents the intent
    int written = fwrite((char*) pts, sizeof(Point), 4, f);     // item size, item count
    fclose(f);
    printf("wrote %d records of %d bytes\n", written, sizeof(Point));

    f = fopen("points.bin", "rb");
    fseek(f, 2 * sizeof(Point), SEEK_SET);            // go straight to record number 2
    Point p;
    int got = fread((char*) &p, sizeof(Point), 1, f);
    printf("record 2: x=%d y=%d (%d read)\n", p.x, p.y, got);

    fseek(f, 0, SEEK_END);
    printf("file size: %d bytes = %d records\n", ftell(f), ftell(f) / sizeof(Point));

    printf("read at the end returns %d\n", fread((char*) &p, sizeof(Point), 1, f));
    printf("feof: %d\n", feof(f) != 0);
    fclose(f);
    return 0;
}
