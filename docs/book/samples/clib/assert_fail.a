// A failing assertion ends the program with exit code 134
// book: exit=134
import cassert;

// assert is a function, so it cannot see the text of the condition. The preprocessor can:
#define CHECK(cond) assertMsg(cond, "check failed: " #cond)

int main() {
    int x = 5;
    println("before");
    assert(x == 5);                      // true: nothing happens
    CHECK(x + 1 == 7);                   // false: the message on standard error names the condition
    println("after: never printed");
    return 0;
}
