// The printf family: printf, sprintf, snprintf, asprintf, dprintf
import cstdio;
import cstdlib;

int main() {
    printf("%5d|%-5d|%05d|%+d|%x|%X|%#x\n", 42, 42, 42, 42, 255, 255, 255);   // width, flags, bases
    printf("%o|%b|%c|%s|%%\n", 8, 5, 'A', "text");                          // octal, binary, a character, a string
    printf("[%8.3s] [%-8s] [%*d]\n", "abcdef", "ab", 6, 42);     // precision cuts a string; * takes the width from the arguments

    char buf[40];
    int n = sprintf(buf, "%d-%d", 12, 34);                       // the buffer must be big enough
    printf("sprintf wrote %d characters: %s\n", n, buf);

    char small[8];
    n = snprintf(small, 8, "%s", "a long sentence");             // never writes more than 8 bytes, including the zero
    printf("snprintf: \"%s\", the full text has %d characters\n", small, n);

    char* heap;
    n = asprintf(&heap, "%d squared is %d", 12, 144);            // allocates the buffer for you
    printf("asprintf: %s (%d)\n", heap, n);
    free(heap);

    dprintf(1, "dprintf writes to a file descriptor: %d\n", 1);

    // at most eight values; a larger list goes through an array
    int values[3];
    values[0] = 1; values[1] = 2; values[2] = 3;
    vprintf("vprintf takes an array: %d %d %d\n", values, 3);
    return 0;
}
