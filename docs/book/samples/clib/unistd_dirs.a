// Directories: mkdir, opendir, readdir, chdir, getcwd, rmdir
import cunistd;
import cstdio;
import cstring;

int main() {
    mkdir("project", 493);                               // the mode 755 in octal is 493
    mkdir("project/src", 493);
    writeFile("project/README", "r");
    writeFile("project/main.a", "m");

    // readdir returns "." and ".." too, in no particular order: collect and sort
    DIR* d = opendir("project");
    char* names[16];
    int n = 0;
    Dirent* e;
    while ((e = readdir(d)) != null) {
        if (!streq(e->d_name, ".") && !streq(e->d_name, "..")) {
            names[n] = strdup(e->d_name);
            n++;
        }
    }
    closedir(d);
    for (int i = 0; i < n; i++)                          // a small sort: the order of readdir is not defined
        for (int j = i + 1; j < n; j++)
            if (strcmp(names[j], names[i]) < 0) { char* t = names[i]; names[i] = names[j]; names[j] = t; }
    for (int i = 0; i < n; i++) printf("%s\n", names[i]);

    // d_type says what kind of entry it is: 4 directory, 8 file
    d = opendir("project");
    while ((e = readdir(d)) != null) {
        if (streq(e->d_name, "src")) printf("src has d_type %d\n", e->d_type);
    }
    closedir(d);

    chdir("project/src");
    char cwd[256];
    getcwd(cwd, 256);
    printf("now in a directory called %s\n", strrchr(cwd, '/') + 1);
    char real[4096];
    realpath("../README", real);                         // the absolute path with the ".." resolved
    printf("realpath ends with %s\n", strrchr(real, '/') + 1);
    chdir("../..");

    printf("rmdir of a non-empty directory: %d (ENOTEMPTY is %d, errno is %d)\n", rmdir("project"), ENOTEMPTY, errno);
    unlink("project/README");
    unlink("project/main.a");
    printf("rmdir src: %d, project: %d\n", rmdir("project/src"), rmdir("project"));
    printf("opendir of a missing directory: %s\n", opendir("project") == null ? "null" : "opened");
    return 0;
}
