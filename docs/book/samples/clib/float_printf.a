// printf with %f %e %g: the digits are exact (printfd adds %a)
import cfloat;
import cstdio;

int main() {
    int x = dlit("1234.56789");
    printf("[%f]\n", x);                         // 6 digits after the point by default
    printf("[%.2f]\n", x);
    printf("[%10.1f]\n", x);                     // width 10
    printf("[%-10.1f]\n", x);                    // left aligned
    printf("[%+.0f]\n", x);                      // forced sign, no decimals
    printf("[%e]\n", x);                         // scientific
    printf("[%.3E]\n", x);
    printf("[%g]\n", x);                         // %f or %e style by the size of the exponent, trailing zeros removed
    printf("[%g]\n", dlit("0.00001234"));
    printf("[%g]\n", dlit("123456789"));
    printfd("[%a]\n", dlit("0.5"));              // hexadecimal floating point: only printfd and its relatives know %a

    // integers and doubles mix: the format decides how each value is read
    printf("%d items at %.2f each = %.2f\n", 3, dlit("9.99"), dmul(itod(3), dlit("9.99")));

    // snprintf (and sprintf, fprintf) do the same into a buffer or a file
    char buf[32];
    int n = snprintf(buf, 32, "pi is about %.5f", M_PI);
    printf("%s (%d characters)\n", buf, n);

    // the digits are exact, however many you ask for
    printf("%.30f\n", dlit("0.1"));
    printf("%.0f\n", dlit("1e22"));
    return 0;
}
