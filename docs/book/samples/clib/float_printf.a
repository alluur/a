// printfd: printf with %f %e %g and %a
import cfloat;

int main() {
    int x = dlit("1234.56789");
    printfd("[%f]\n", x);                         // 6 digits after the point by default
    printfd("[%.2f]\n", x);
    printfd("[%10.1f]\n", x);                     // width 10
    printfd("[%-10.1f]\n", x);                    // left aligned
    printfd("[%+.0f]\n", x);                      // forced sign, no decimals
    printfd("[%e]\n", x);                         // scientific
    printfd("[%.3E]\n", x);
    printfd("[%g]\n", x);                         // the shorter of %f and %e, trailing zeros removed
    printfd("[%g]\n", dlit("0.00001234"));
    printfd("[%g]\n", dlit("123456789"));
    printfd("[%a]\n", dlit("0.5"));               // hexadecimal floating point: exact

    // integers and doubles mix: the format decides how each value is read
    printfd("%d items at %.2f each = %.2f\n", 3, dlit("9.99"), dmul(itod(3), dlit("9.99")));

    // sprintfd and snprintfd write into a buffer
    char buf[32];
    int n = snprintfd(buf, 32, "pi is about %.5f", M_PI);
    printf("%s (%d characters)\n", buf, n);

    // the digits are exact, however many you ask for
    printfd("%.30f\n", dlit("0.1"));
    printfd("%.0f\n", dlit("1e22"));
    return 0;
}
