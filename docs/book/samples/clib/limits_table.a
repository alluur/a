// The limits of the integer types
import climits;

int main() {
    printf("CHAR_BIT   %d\n", CHAR_BIT);
    printf("INT8_MIN   %d\n", INT8_MIN);
    printf("INT8_MAX   %d\n", INT8_MAX);
    printf("UINT8_MAX  %d\n", UINT8_MAX);
    printf("INT16_MAX  %d\n", INT16_MAX);
    printf("UINT16_MAX %d\n", UINT16_MAX);
    printf("INT32_MIN  %d\n", INT32_MIN);
    printf("INT32_MAX  %d\n", INT32_MAX);
    printf("UINT32_MAX %d\n", UINT32_MAX);
    printf("INT_MAX    %d\n", INT_MAX);           // int is 64 bits in A, so INT_MAX is the 64-bit maximum
    printf("INT_MIN    %d\n", INT_MIN);
    printf("LONG_MAX   %d\n", LONG_MAX);          // long is the same type as int
    printf("SIZE_MAX   %u\n", SIZE_MAX);          // %u: it does not fit a signed number
    printf("UINT64_MAX %u\n", UINT64_MAX);
    printf("PATH_MAX   %d\n", PATH_MAX);
    printf("NULL       %d\n", NULL);

    // wrapping: arithmetic on a 32 bit type wraps at 32 bits, on int at 64 bits
    uint32 small = UINT32_MAX;
    small = small + 1;
    printf("UINT32_MAX + 1 = %d\n", small);
    printf("INT_MAX + 1 = %d\n", INT_MAX + 1);    // wraps around to INT_MIN
    return 0;
}
