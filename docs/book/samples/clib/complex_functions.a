// Square roots, exponentials and Euler's identity
import ccomplex;
import cfloat;

int main() {
    // sqrt(-4) = 2i
    println(cstr(csqrt(cmplx(itod(-4), itod(0)))));

    // Euler: e^(i pi) + 1 = 0  (to within rounding)
    Complex* i_pi = cmplx(itod(0), M_PI);
    Complex* e = cexp(i_pi);
    printfd("e^(i pi)     = %.15f + %.15fi\n", creal(e), cimag(e));
    printfd("imaginary part = %.3e: not exactly 0: the double nearest to pi is not pi\n", cimag(e));

    // roots of x^2 + 2x + 5 = 0:  x = -1 +- 2i
    int a = 1; int b = 2; int c = 5;
    int disc = itod(b * b - 4 * a * c);               // -16
    Complex* root = csqrt(cmplx(disc, itod(0)));
    Complex* x1 = cdiv(cadd(cmplx(itod(-b), itod(0)), root), cmplx(itod(2 * a), itod(0)));
    Complex* x2 = cdiv(csub(cmplx(itod(-b), itod(0)), root), cmplx(itod(2 * a), itod(0)));
    printf("roots: %s and %s\n", cstr(x1), cstr(x2));

    // the 4th roots of unity are 1, i, -1, -i: cpolar(1, 2 pi k / 4)
    for (int k = 0; k < 4; k++) {
        Complex* w = cpolar(itod(1), ddiv(dmul(itod(2 * k), M_PI), itod(4)));
        printfd("w%d = %6.3f %+.3fi\n", k, creal(w), cimag(w));
    }
    println(cstr(clog(cmplx(itod(-1), itod(0)))));    // ln(-1) = i pi
    return 0;
}
