// Comparing strings
import cstring;

void cmp(char* a, char* b) {
    int c = strcmp(a, b);
    printf("strcmp(\"%s\", \"%s\") is %s\n", a, b, c < 0 ? "negative" : (c > 0 ? "positive" : "zero"));
}

int main() {
    cmp("apple", "banana");
    cmp("banana", "apple");
    cmp("same", "same");
    cmp("Zebra", "apple");                          // upper case letters sort before lower case in ASCII
    cmp("abc", "abcd");                             // a prefix is smaller

    printf("strncmp(\"abcdef\", \"abcxyz\", 3) = %d\n", strncmp("abcdef", "abcxyz", 3));
    printf("strcasecmp(\"Hello\", \"hELLO\") = %d\n", strcasecmp("Hello", "hELLO"));
    printf("strncasecmp(\"HELP me\", \"help\", 4) = %d\n", strncasecmp("HELP me", "help", 4));
    printf("strcoll = strcmp in the C locale: %d\n", strcoll("a", "b") == strcmp("a", "b"));
    return 0;
}
