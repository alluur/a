// File descriptors: open, write, lseek, read
import cunistd;
import cstdio;

int main() {
    // O_CREAT creates the file, O_TRUNC empties it; the last argument is the permission bits (octal 644 is 420)
    int fd = open("data.bin", O_WRONLY | O_CREAT | O_TRUNC, 420);
    printf("fd is at least 3 (0, 1 and 2 are taken): %d\n", fd >= 3);
    printf("write: %d\n", write(fd, "0123456789", 10));
    printf("lseek to 4: %d\n", lseek(fd, 4, SEEK_SET));
    printf("write: %d\n", write(fd, "XY", 2));                  // overwrites 4 and 5
    close(fd);

    fd = open("data.bin", O_RDONLY);
    char buf[32];
    int n = read(fd, buf, 31);                                   // up to 31 bytes; no zero is added
    buf[n] = 0;
    printf("read %d bytes: %s\n", n, buf);
    printf("at the end read returns %d\n", read(fd, buf, 31));

    Stat st;
    fstat(fd, &st);
    printf("fstat: size %d\n", st.st_size);
    printf("size via lseek: %d\n", lseek(fd, 0, SEEK_END));
    close(fd);

    printf("open a missing file: %d (errno %d)\n", open("missing.bin", O_RDONLY), errno);
    fd = open("data.bin", O_WRONLY | O_CREAT | O_EXCL, 420);     // O_EXCL: fail if it exists
    printf("exclusive create of an existing file: %d (EEXIST is %d, errno is %d)\n", fd, EEXIST, errno);
    return 0;
}
