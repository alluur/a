// Some error numbers and their messages
import cerrno;

void show(int e) {
    printf("%3d  %s\n", e, strerror(e));
}

int main() {
    show(EPERM);
    show(ENOENT);
    show(EINTR);
    show(EIO);
    show(EBADF);
    show(ENOMEM);
    show(EACCES);
    show(EEXIST);
    show(ENOTDIR);
    show(EISDIR);
    show(EINVAL);
    show(EMFILE);
    show(ENOSPC);
    show(EPIPE);
    show(ERANGE);
    show(ECONNREFUSED);
    show(9999);                                         // an unknown number still gives text
    return 0;
}
