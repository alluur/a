// Integer division, abs, atexit and the ways to end a program
import cstdlib;

void goodbye() { println("handler 1: goodbye"); }
void cleanup() { println("handler 2: cleanup"); }

int main() {
    // div gives quotient and remainder together; division truncates toward zero
    div_t* d = div(17, 5);
    printf("17 / 5 = %d remainder %d\n", d->quot, d->rem);
    d = div(-17, 5);
    printf("-17 / 5 = %d remainder %d\n", d->quot, d->rem);      // -3 and -2: the remainder has the sign of the dividend
    printf("abs(-9) = %d, labs(-9) = %d\n", abs(-9), labs(-9));

    // handlers run when the program ends, the last registered first
    atexit(goodbye);
    atexit(cleanup);
    printf("EXIT_SUCCESS = %d, EXIT_FAILURE = %d\n", EXIT_SUCCESS, EXIT_FAILURE);
    println("main is ending");
    exit(EXIT_SUCCESS);                                          // return from main does the same
}
