// Standard input and output: getchar, putchar, puts and scanf
import cstdio;
import cctype;

int main() {
    int total = 0;
    int count = 0;
    int value;
    // scanf returns the number of items it converted; it stops at the first text that is not a number
    while (scanf("%d", &value) == 1) {
        total += value;
        count++;
    }
    printf("%d numbers, sum %d\n", count, total);

    // what scanf could not read is still waiting: copy the rest in capitals, character by character
    int c;
    while ((c = getchar()) != EOF) {
        putchar(toupper(c));
    }
    puts("--");                                       // puts adds the newline
    return 0;
}
