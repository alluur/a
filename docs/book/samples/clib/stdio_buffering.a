// Buffering: when does the text reach the file?
import cstdio;
import cunistd;

// the size of a file as the operating system sees it
int sizeOnDisk(char* path) {
    Stat st;
    stat(path, &st);
    return st.st_size;
}

int main() {
    FILE* f = fopen("buffered.txt", "w");
    fputs("hello", f);
    printf("after fputs:  %d bytes on disk\n", sizeOnDisk("buffered.txt"));     // still in the buffer
    fflush(f);
    printf("after fflush: %d bytes on disk\n", sizeOnDisk("buffered.txt"));
    fputs(", world", f);
    fclose(f);                                                                   // fclose flushes too
    printf("after fclose: %d bytes on disk\n", sizeOnDisk("buffered.txt"));

    // setvbuf chooses the mode before the first write
    f = fopen("unbuffered.txt", "w");
    setvbuf(f, null, _IONBF, 0);                                                 // no buffering at all
    fputs("hello", f);
    printf("unbuffered:   %d bytes on disk\n", sizeOnDisk("unbuffered.txt"));
    fclose(f);

    // stdout and stderr are not buffered here, so printed text is never lost when a program is killed
    printf("the buffer of a file stream holds BUFSIZ = %d bytes\n", BUFSIZ);
    return 0;
}
