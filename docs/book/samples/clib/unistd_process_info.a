// Facts about the running process
import cunistd;

int main() {
    printf("pid is positive: %d\n", getpid() > 0);
    printf("parent pid is positive: %d\n", getppid() > 0);
    printf("uid and euid agree here: %d\n", getuid() == geteuid());
    printf("page size is a multiple of 1024: %d\n", getpagesize() % 1024 == 0);

    char host[64];
    printf("gethostname: %d, not empty: %d\n", gethostname(host, 64), strlen(host) > 0);

    printf("the standard descriptors: %d %d %d\n", STDIN_FILENO, STDOUT_FILENO, STDERR_FILENO);

    // sleep and usleep wait; the process is not busy meanwhile
    int t0 = millis();
    usleep(20000);
    printf("usleep(20000) waited at least 20 ms: %d\n", millis() - t0 >= 20);
    return 0;
}
