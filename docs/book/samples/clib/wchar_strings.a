// The wcs functions: strings of wide characters
import cwchar;

int* wide(char* utf8) {                                // helper: a wide copy of an UTF-8 text
    int* w = (int*) alloc(8 * (strlen(utf8) + 1));
    mbstowcs(w, utf8, strlen(utf8) + 1);
    return w;
}

void show(char* label, int* w) {
    char out[128];
    wcstombs(out, w, 128);
    printf("%s: %s\n", label, out);
}

int main() {
    int buf[64];
    wcscpy(buf, wide("grüße"));                        // copy
    wcscat(buf, wide(" aus Zürich"));                  // append
    show("joined", buf);
    printf("length %d characters\n", wcslen(buf));

    printf("wcscmp: %d %d %d\n", wcscmp(wide("abc"), wide("abd")) < 0, wcscmp(wide("é"), wide("é")), wcscmp(wide("b"), wide("a")) > 0);

    int* hit = wcsstr(buf, wide("aus"));               // search for a string
    printf("\"aus\" found at index %d\n", hit - buf);
    int* ue = wcschr(buf, 0xFC);                       // search for a character: U+00FC is ü
    printf("first ü at index %d\n", ue - buf);

    // split on spaces with wcstok
    int* save;
    int* token = wcstok(buf, wide(" "), &save);
    while (token != null) {
        show("token", token);
        token = wcstok(null, wide(" "), &save);
    }
    return 0;
}
