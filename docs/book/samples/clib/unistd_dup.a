// dup and dup2: redirecting standard output into a file
// book: linux-only
import cunistd;
import cstdio;

int main() {
    println("this goes to the terminal (or the pipe the book captured)");

    int saved = dup(1);                              // a second descriptor for the real standard output
    int fd = open("captured.txt", O_WRONLY | O_CREAT | O_TRUNC, 420);
    dup2(fd, 1);                                     // now descriptor 1 is the file
    close(fd);
    println("this line is written into the file");
    printf("so is this one: %d\n", 42);

    dup2(saved, 1);                                  // put the original back
    close(saved);
    println("back on the original output");

    FILE* f = fopen("captured.txt", "r");
    char line[64];
    while (fgets(line, 64, f) != null) printf("captured: %s", line);
    fclose(f);
    return 0;
}
