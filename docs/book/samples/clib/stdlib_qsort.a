// qsort and bsearch
import cstdlib;

// the comparison function gets pointers to two elements and returns <0, 0 or >0
int cmpInt(char* a, char* b) {
    int x = ((int*) a)[0];
    int y = ((int*) b)[0];
    return x < y ? -1 : (x > y ? 1 : 0);
}

struct Person { char* name; int age; }

int byAge(char* a, char* b) {
    return ((Person*) a)->age - ((Person*) b)->age;
}

int byName(char* a, char* b) {
    return strcmp(((Person*) a)->name, ((Person*) b)->name);
}

int main() {
    int v[8] = {42, 7, 19, 3, 88, 1, 56, 19};
    qsort((char*) v, 8, 8, cmpInt);                 // base, number of elements, size of an element, comparison
    for (int i = 0; i < 8; i++) printf("%d ", v[i]);
    println("");

    int key = 56;
    int* hit = (int*) bsearch((char*) &key, (char*) v, 8, 8, cmpInt);    // the array must be sorted
    printf("56 is at index %d\n", hit - v);
    key = 57;
    printf("57 found: %d\n", bsearch((char*) &key, (char*) v, 8, 8, cmpInt) != null);

    // structs: sort the same array in two ways
    Person people[3];
    people[0].name = "Carol"; people[0].age = 22;
    people[1].name = "Alice"; people[1].age = 41;
    people[2].name = "Bob";   people[2].age = 35;
    qsort((char*) people, 3, sizeof(Person), byAge);
    for (int i = 0; i < 3; i++) printf("%s (%d)  ", people[i].name, people[i].age);
    println("");
    qsort((char*) people, 3, sizeof(Person), byName);
    for (int i = 0; i < 3; i++) printf("%s (%d)  ", people[i].name, people[i].age);
    println("");
    return 0;
}
