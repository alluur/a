// Files with FILE*: write, append, read, seek
import cstdio;

int main() {
    FILE* f = fopen("poem.txt", "w");                 // "w": create or empty the file
    fputs("roses are red\n", f);
    fprintf(f, "violets are %s\n", "blue");
    fputc('!', f);
    fputc('\n', f);
    fclose(f);                                        // output is buffered: fclose (or fflush) writes it

    f = fopen("poem.txt", "a");                       // "a": add at the end
    fputs("the end\n", f);
    fclose(f);

    f = fopen("poem.txt", "r");
    char line[64];
    while (fgets(line, 64, f) != null) {              // the newline is kept; null at the end of the file
        printf("%ld: %s", ftell(f), line);            // ftell: the position after the line
    }
    printf("at the end: %d\n", feof(f) != 0);

    fseek(f, 6, SEEK_SET);                            // jump to byte 6
    printf("char at 6: %c\n", fgetc(f));
    fseek(f, -4, SEEK_END);                           // four bytes before the end
    printf("tail: %s", fgets(line, 64, f));
    rewind(f);                                        // back to the start
    printf("first char: %c\n", fgetc(f));
    ungetc('R', f);                                   // push one character back
    printf("pushed back and read again: %c\n", fgetc(f));
    fclose(f);

    printf("rename: %d\n", rename("poem.txt", "verse.txt"));
    printf("open the old name: %s\n", fopen("poem.txt", "r") == null ? "fails" : "works");
    printf("remove: %d\n", remove("verse.txt"));
    return 0;
}
