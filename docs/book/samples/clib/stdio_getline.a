// Reading lines of any length with getline
import cstdio;
import cstdlib;

int main() {
    FILE* f = fopen("lines.txt", "w");
    fputs("short\n", f);
    fputs("a rather longer line than the first one\n", f);
    fputs("last line without a newline", f);
    fclose(f);

    f = fopen("lines.txt", "r");
    char* line = null;                                // getline allocates and grows the buffer itself
    int cap = 0;
    int len;
    while ((len = getline(&line, &cap, f)) != -1) {   // the length including the newline, -1 at the end
        printf("%2d characters: %s", len, line);
        if (line[len - 1] != '\n') println("");
    }
    printf("buffer capacity at the end: %s\n", cap >= 41 ? "big enough for the longest line" : "too small");
    free(line);
    fclose(f);
    return 0;
}
