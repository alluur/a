// A class that points to itself: a singly linked list
class Node {
    public int value;
    public Node* next;
    public Node(int v) { value = v; }
}

class Stack {
    private Node* top;
    private int size;

    public void push(int v) {
        Node* n = new Node(v);
        n->next = top;
        top = n;
        size++;
    }

    public int pop() {
        Node* n = top;
        top = n->next;
        size--;
        return n->value;
    }

    public int count() { return size; }
}

int main() {
    Stack* s = new Stack();                       // fields start as zero: top is null, size is 0
    for (int i = 1; i <= 4; i++) {
        s->push(i * i);
    }
    printf("%d items\n", s->count());
    while (s->count() > 0) {
        printf("%d ", s->pop());
    }
    println("");
    return 0;
}
