// #define: object-like macros, function-like macros, #, ## and variadic macros
#define N 5
#define SQUARE(x) ((x) * (x))
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define NAME_OF(x) #x                      // # turns the argument into a string
#define MAKE_GETTER(name, value) int get_##name() { return value; }   // ## pastes tokens
#define LOG(...) printf(__VA_ARGS__)       // ... takes the remaining arguments
#define REPEAT(n, body) \
    for (int _i = 0; _i < (n); _i++) { \
        body \
    }                                      // a backslash continues the line

MAKE_GETTER(width, 640)
MAKE_GETTER(height, 480)

int main() {
    printf("%d %d\n", N, SQUARE(N + 1));          // ((5 + 1) * (5 + 1)): the parentheses matter
    printf("%d\n", MAX(3, SQUARE(2)));
    println(NAME_OF(hello world));
    printf("%d x %d\n", get_width(), get_height());
    LOG("%s has %d items\n", "the list", 3);
    REPEAT(3, print("ab");)
    println("");
    println("N is not replaced inside strings: N");
#undef N
#define N 10
    printf("N is now %d\n", N);
    return 0;
}
