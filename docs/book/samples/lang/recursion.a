// Recursion: a function that calls itself
int factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}

int fib(int n) {
    return n < 2 ? n : fib(n - 1) + fib(n - 2);
}

int gcd(int a, int b) {
    return b == 0 ? a : gcd(b, a % b);
}

void hanoi(int n, char from, char to, char via, int* moves) {
    if (n == 0) return;
    hanoi(n - 1, from, via, to, moves);
    (*moves)++;
    hanoi(n - 1, via, to, from, moves);
}

int depth(int n) {                               // the stack is 8 MiB: a deep recursion is fine
    return n == 0 ? 0 : 1 + depth(n - 1);
}

int main() {
    printf("10! = %d, 20! = %d\n", factorial(10), factorial(20));
    printf("fib(20) = %d\n", fib(20));
    printf("gcd(1071, 462) = %d\n", gcd(1071, 462));
    int moves = 0;
    hanoi(10, 'A', 'C', 'B', &moves);
    printf("hanoi with 10 discs: %d moves\n", moves);
    printf("depth: %d\n", depth(100000));
    return 0;
}
