// var: the compiler takes the type from the initializer
struct Pair { int a; int b; }

Pair makePair(int a, int b) {
    Pair p;
    p.a = a;
    p.b = b;
    return p;
}

double half(int n) { return n * 0.5; }
int twice(int n) { return n * 2; }

int main() {
    var n = 5;                         // int
    var pi = 3.25;                     // double
    var name = "ada";                  // char*
    var p = &n;                        // int*
    var f = twice;                     // func
    var h = half(3);                   // the result type of the function: double
    var q = makePair(1, 2);            // a Pair, copied
    var q2 = q;
    q2.a = 100;
    println($"{n} {pi} {name} {*p} {f(21)} {h} {q.a} {q2.a}");

    // the variable really has that type: this is a double sum and an integer division
    var total = n + pi;
    var third = n / 3;
    println($"{total} {third} {sizeof(total)} {sizeof(third)}");

    // a later assignment is converted to the type that var chose
    n = 2.9;
    pi = 4;
    println($"{n} {pi}");

    // an array becomes a pointer to its first element
    int values[4] = {10, 20, 30, 40};
    var vp = values;
    vp++;
    println($"{*vp} {sizeof(values)} {sizeof(vp)}");

    // several names in one declaration, each with its own type
    var count = 3, label = "items", ratio = 0.5;
    println($"{count} {label} {ratio}");
    return 0;
}
