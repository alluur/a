// A double passed to printf is its 64 bit pattern: %f reads it back, %d shows the bits
double square(double v) { return v * v; }

int main() {
    double d = 3.99;
    int n = 3;

    printf("%.2f\n", d);                       // right: %f reads the bits as a double
    printf("%d\n", d);                         // %d shows the bits as a whole number
    printf("%d\n", (int) d);                   // cast first to print the integer part
    printf("%x\n", d);                         // the same bits in hexadecimal

    // an int is not converted: its bits are read as a double, a tiny number
    printf("%f\n", n);
    printf("%f\n", (double) n);                // the cast makes it 3.0
    printf("%f\n", n * 1.0);                   // so does arithmetic with a double

    // a function with a double parameter converts its argument as usual
    printf("%.1f %.1f\n", square(n), square(1.2));

    // the interpolated string knows the types and converts for you
    println($"{d:.2f} {n:.2f} {d} {n}");

    // __bits and __dbl move between a double and its bits without changing them
    printf("%x -> %v\n", __bits(1.0), __dbl(0x4009000000000000));
    return 0;
}
