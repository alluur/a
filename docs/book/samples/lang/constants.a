// const: names that the compiler evaluates
const MAX = 100;                    // the type is inferred
const TITLE = "Aytict";             // strings work too
const int MASK = 0xF0;              // an explicit type is optional
const uint8 SMALL = 300;            // a typed constant is cut to its type
const AREA = MAX * 2 + 1;           // constants can use earlier constants
const FLAG = MAX > 50 && MASK != 0;

int values[MAX / 10];               // a constant can size an array

int main() {
    printf("%d %s %d %d %d %d\n", MAX, TITLE, MASK, SMALL, AREA, FLAG);
    printf("array holds %d numbers\n", sizeof(values) / sizeof(values[0]));
    // MAX = 5;                     // error: constants cannot be assigned to
    // int* p = &MAX;               // ... or have their address taken
    return 0;
}
