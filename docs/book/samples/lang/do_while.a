// do ... while: the body runs once before the first test
int main() {
    int tries = 0;
    do {
        tries++;
        printf("try %d\n", tries);
    } while (tries < 3);

    int n = 100;
    do {
        println("runs once even though the condition is false");
    } while (n < 5);

    // typical use: build the digits of a number backwards (and 0 has one digit)
    int value = 0;
    char buf[24];
    int pos = 23;
    buf[pos] = 0;
    do {
        pos--;
        buf[pos] = '0' + value % 10;
        value /= 10;
    } while (value > 0);
    printf("digits of 0: %s\n", &buf[pos]);
    return 0;
}
