// Formatting numbers into aligned columns
int main() {
    printf("%-4s %8s %9s %10s\n", "n", "n^5", "hex", "binary");
    printRepeat('-', 34);
    println("");
    int total = 0;
    for (int n = 1; n <= 5; n++) {
        int p = n * n * n * n * n;
        total += p;
        printf("%-4d %8d %9x %10b\n", n, p, p, n);
    }
    printRepeat('=', 34);
    println("");
    printf("%-4s %8d\n", "sum", total);
    return 0;
}
