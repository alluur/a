// foreach over arrays, text and ranges
int main() {
    int primes[5] = {2, 3, 5, 7, 11};

    int sum = 0;
    foreach (int p in primes) sum += p;            // every element, in order
    printf("sum of the primes: %d\n", sum);

    foreach (int i, int p in primes) {             // the index too
        printf("primes[%d] = %d\n", i, p);
    }

    print("backwards:");
    foreach (int p in rev primes) printf(" %d", p);
    println("");

    foreach (char c in "abc") printf("%c=%d ", c, c);   // the bytes of a text, not the final 0
    println("");

    foreach (int n in 1..4) printf("%d ", n);      // half open: 1 2 3
    println("");
    foreach (int n in 1..=4) printf("%d ", n);     // closed: 1 2 3 4
    println("");
    foreach (int n in rev 0..=3) printf("%d ", n); // counting down: 3 2 1 0
    println("");

    foreach (x in primes) sum -= x;                // no type: the variable gets the type of the elements
    printf("and back to %d\n", sum);
    return 0;
}
