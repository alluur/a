// Casts use C syntax and change the width or the kind of a value
int main() {
    int big = 0x1234ABCD;
    printf("(char) 0x1234ABCD = %d\n", (char) big);          // keeps the low 8 bits
    printf("(int8) = %d, (uint16) = %d\n", (int8) big, (uint16) big);
    printf("(uint16) -1 = %d, (uint32) -1 = %d\n", (uint16) -1, (uint32) -1);
    printf("(bool) 12 = %d, (bool) 0 = %d\n", (bool) 12, (bool) 0);

    char text[4] = "abc";
    char* p = text;
    int address = (int) p;                                   // a pointer as a number
    printf("round trip: %c\n", ((char*) address)[1]);

    int n = 65;
    printf("%c %d\n", (char) n, (char) (n + 200));           // 265 does not fit in a byte
    uint8 small = 250;
    int wide = (int) small + 10;                             // widen first, so nothing is lost
    printf("%d\n", wide);
    return 0;
}
