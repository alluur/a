// Tuples: a function that returns several values
(int, int) divmod(int a, int b) {
    return (a / b, a % b);
}

(char*, int) named() {
    return ("seven", 7);
}

(bool, int) firstNegative(int* v, int n) {
    for (int i = 0; i < n; i++) {
        if (v[i] < 0) return (true, i);
    }
    return (false, -1);
}

int main() {
    // declare two variables from the result
    (int q, int r) = divmod(17, 5);
    println($"17 / 5 = {q} remainder {r}");

    // var takes the element types from the tuple
    var (name, n) = named();
    println($"{name} {n}");

    // _ throws an element away
    (int quotient, _) = divmod(100, 7);
    println($"quotient only: {quotient}");

    // the result is a value: keep it, read an element with .0 .1
    var t = divmod(9, 4);
    println($"t = ({t.0}, {t.1})");
    t.1 = 99;
    println($"t = ({t.0}, {t.1})");
    println($"{divmod(20, 6).0} {divmod(20, 6).1}");

    // assign to variables that already exist: the right side is computed first
    int a = 1;
    int b = 2;
    (a, b) = (b, a);
    println($"swapped: a={a} b={b}");
    (a, b) = (a + b, a - b);
    println($"a={a} b={b}");

    int data[4] = {3, 8, -2, 5};
    (bool found, int at) = firstNegative(data, 4);
    println($"found={found} at={at}");
    return 0;
}
