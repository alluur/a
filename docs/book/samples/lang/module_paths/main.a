// import with dots and with an explicit file name, plus a file without a module line
import util.math;                                // finds util/math.a
import "extras/tools.a";                         // an explicit file name
import plain;                                    // plain.a has no module line

int main() {
    printf("%d %d\n", math.square(7), math.gcd(48, 18));
    printf("%d %d\n", math.max(4, 9, 2), max(4, 9));    // the prelude's max is untouched outside the module
    printf("%d\n", tools.twice(21));
    printf("%d\n", shout());                     // names of plain.a are global
    return 0;
}
