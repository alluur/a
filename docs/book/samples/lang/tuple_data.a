// Tuples are values: arrays, fields, parameters, nesting, loops
(int, int) origin = (0, 0);                       // a global: constants only

class Window {
public:
    (int, int) size;                              // a field
    Window(int w, int h) { size = (w, h); }
    void grow((int, int) by) {                    // a parameter
        size = (size.0 + by.0, size.1 + by.1);
    }
}

((int, int), char*) labelled() {                  // a tuple inside a tuple
    return ((3, 4), "point");
}

int main() {
    // an array of tuples, and foreach over it (a pointer variable changes the elements)
    (char*, int) people[3] = {("zoe", 30), ("adam", 25), ("mia", 41)};
    foreach (var p in people) {
        println($"{p.0:-5}|{p.1:3}");
    }
    foreach ((char*, int)* p in people) {
        p->1 += 1;
    }
    println($"{people[0].1} {people[1].1} {people[2].1}");

    Window w(80, 24);
    w.grow((10, 1));
    println($"{w.size.0}x{w.size.1}");

    var (xy, text) = labelled();
    println($"{text} at {xy.0},{xy.1}");

    // a copy is a copy
    (int, int) a = (1, 2);
    var b = a;
    b.0 = 100;
    println($"a={a.0} b={b.0} origin={origin.0}");

    // patterns can sit in the head of a for: the Fibonacci numbers below 100
    for (var (x, y) = (0, 1); x < 100; (x, y) = (y, x + y)) {
        print($"{x} ");
    }
    println("");
    return 0;
}
