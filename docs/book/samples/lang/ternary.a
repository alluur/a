// The conditional operator ?: and the default operator ??
int main() {
    int a = 7;
    int b = 4;
    int bigger = a > b ? a : b;
    printf("bigger: %d\n", bigger);
    printf("%s\n", a % 2 == 0 ? "even" : "odd");

    // chained: right to left
    int n = -3;
    printf("%s\n", n < 0 ? "negative" : n == 0 ? "zero" : "positive");

    // a ?? b is a unless a is 0 or null, then b
    char* name = null;
    printf("hello %s\n", name ?? "stranger");
    int count = 0;
    printf("count or default: %d\n", count ?? 10);
    printf("%d\n", 5 ?? 10);
    return 0;
}
