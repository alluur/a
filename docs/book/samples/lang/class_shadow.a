// Inside a class, its own methods hide global functions of the same name
class Logger {
    public int count;
    public void print(char* text) {               // hides the global print() inside Logger
        count++;
        printf("[%d] %s\n", count, text);
    }
    public void run() {
        print("starting");                        // this is Logger.print
        ::print("global print\n");                // :: reaches the global function
    }
}

int main() {
    Logger log;
    log.run();
    print("outside the class, print is global again\n");
    return 0;
}
