// var: the type comes from the initializer
struct Point { int x; int y; }

Point makePoint(int x, int y) { Point p; p.x = x; p.y = y; return p; }

int main() {
    var n = 5;                       // int
    var pi = 3.14159;                // double
    var name = "bob";                // char*
    var p = &n;                      // int*
    var pt = makePoint(3, 4);        // a copy of the struct that the function returns
    var a = 1, s = "two";            // several declarators, each with its own type
    *p = 9;
    printf("n=%d pi=%.2f name=%s pt=(%d,%d) a=%d s=%s\n", n, pi, name, pt.x, pt.y, a, s);

    int values[3] = {10, 20, 30};
    var total = 0;
    foreach (var v in values) total += v;
    printf("total=%d\n", total);
    return 0;
}
