// Scope: a variable lives to the end of its block; inner names can shadow outer ones
int counter = 100;                  // a global

int main() {
    int x = 1;
    printf("outer x = %d\n", x);
    {
        int x = 2;                  // a new variable that hides the outer x
        int y = 20;
        printf("inner x = %d, y = %d\n", x, y);
    }
    printf("outer x again = %d\n", x);

    for (int i = 0; i < 3; i++) {   // i lives in the loop only
        x += i;
    }
    printf("x = %d\n", x);

    int counter = 5;                // hides the global
    printf("local counter = %d\n", counter);
    return 0;
}
