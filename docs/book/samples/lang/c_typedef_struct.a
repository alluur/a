// More C syntax: typedef enum, typedef struct, struct in type names, extern
typedef enum { RED, GREEN = 5, BLUE } Color;
typedef struct { int x; int y; } Point;
typedef struct Node { int val; struct Node* next; } Node;

extern int counter;                        // accepted and ignored: one program, one definition
int counter = 40;

int main() {
    Color c = BLUE;
    Point p;
    p.x = 3;
    p.y = 4;
    Node first;
    Node second;
    first.val = 10;
    second.val = 20;
    first.next = &second;
    struct Node* n = &first;               // the struct keyword is optional but allowed
    printf("%d %d %d\n", c, p.x * p.y, n->next->val);
    printf("%d %d\n", sizeof(struct Node), counter);
    return 0;
}
