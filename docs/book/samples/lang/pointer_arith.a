// Pointer arithmetic is scaled by the size of the element
int main() {
    int numbers[5] = {10, 20, 30, 40, 50};
    int* p = &numbers[0];
    printf("%d %d %d\n", *p, *(p + 1), p[2]);
    p = p + 3;                                  // moves 3 elements = 24 bytes
    printf("%d %d\n", *p, p[-1]);
    p++;
    printf("%d\n", *p);
    int* start = numbers;                        // an array is the address of its first element
    printf("distance: %d elements\n", p - start);
    printf("p > start: %d\n", p > start);

    char text[6] = "hello";
    char* c = text;
    c += 2;
    printf("%c %d\n", *c, (int) c - (int) text); // chars are 1 byte: the step is 1

    uint16 shorts[3] = {1, 2, 3};
    uint16* s = shorts;
    printf("uint16 step: %d bytes\n", (int) (s + 1) - (int) s);
    return 0;
}
