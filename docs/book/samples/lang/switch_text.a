// A switch on text: lists of labels, text constants and a null value
const QUIT = "quit";                           // a text constant may be a label too

int run(char* command) {
    switch (command) {
        case "get":                  return 1;
        case "put", "post":          return 2;      // several texts share one case
        case "delete":
        case "remove":               return 3;      // fall-through works as it does for numbers
        case QUIT:                   return 9;
        default:                     return 0;
    }
}

int main() {
    char* words[7] = {"get", "post", "remove", "quit", "GET", "", null};
    foreach (char* w in words) {
        printf("%-8s -> %d\n", w == null ? "(null)" : w[0] == 0 ? "(empty)" : w, run(w));   // a null text is never a match
    }

    // the text is compared byte by byte, not by address: a text built at run time matches too
    char built[8] = "p";
    strcat(built, "ut");
    printf("built text \"%s\" -> %d\n", built, run(built));
    return 0;
}
