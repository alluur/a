// The constructor runs only when you write parentheses (or use new)
class Noisy {
    public int id;
    public Noisy(int n = 0) {
        id = n + 100;
        printf("  constructor ran, id = %d\n", id);
    }
}

class Holder {                        // a field whose type is a class
    public Noisy inner;
}

Noisy global;                         // a global object is only zeroed as well

int main() {
    println("Noisy a;");
    Noisy a;                          // no parentheses: no constructor
    printf("  a.id = %d\n", a.id);

    println("Noisy b();");
    Noisy b();                        // parentheses: the constructor runs
    println("Noisy c(5);");
    Noisy c(5);
    println("Noisy* d = new Noisy(7);");
    Noisy* d = new Noisy(7);

    println("Holder h; Noisy arr[2];");
    Holder h;                         // fields and array elements are zeroed too
    Noisy arr[2];
    printf("  h.inner.id = %d, arr[1].id = %d, global.id = %d\n", h.inner.id, arr[1].id, global.id);
    return 0;
}
