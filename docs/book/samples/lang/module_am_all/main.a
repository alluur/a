// a_import with '*' brings every public member into this file
a_import('wordtools.am', '*');

int main() {
    char word[16] = "modules";
    printf("%d vowels in %s\n", vowels(word), word);   // no prefix
    shout(word);
    println(word);
    println(wordtools.vowels("A E I") == 3 ? "the prefix works too" : "?");
    return 0;
}
