// Labeled break and continue
int main() {
    // find the first pair a < b with a * b == 42 and leave both loops at once
    search: foreach (int a in 1..10) {
        foreach (int b in a + 1..10) {
            if (a * b == 42) {
                printf("%d x %d = 42\n", a, b);
                break search;
            }
        }
    }

    // continue with the next round of the OUTER loop
    int row = 0;
    rows: while (row < 4) {
        row++;
        for (int col = 1; col <= 4; col++) {
            if (col > row) { println(""); continue rows; }   // the row is finished
            printf("%d ", row * col);
        }
        println("");
    }

    // a labeled loop with a switch inside: a plain break leaves only the switch, break loop leaves the loop
    int n = 0;
    loop: for (;;) {
        n++;
        switch (n) {
            case 1:                  println("one"); break;           // leaves the switch
            case 2:                  println("two"); continue loop;
            case 3:                  println("three, leaving the loop"); break loop;
        }
        println("after the switch");
    }
    return 0;
}
