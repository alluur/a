// Static fields and methods
class Counter {
public:
    static int made;                               // one variable for the whole class, 0 at the start
    static int step = 5;                           // with a constant initializer
    static int table[4] = {1, 10, 100, 1000};      // arrays too
    int id;

    Counter() { made++; id = made; }               // plain names inside the class
    static int bump() { made += step; return made; }      // a static method has no 'this'
    static int square(int v) { return v * v; }
}

int main() {
    Counter a();                                   // write the parentheses: "Counter a;" would not run the constructor
    Counter b();
    Counter* c = new Counter();
    printf("made %d objects, ids %d %d %d\n", Counter.made, a.id, b.id, c->id);

    Counter.step = 2;                              // used with the class name
    printf("bump: %d, then %d\n", Counter.bump(), Counter.bump());
    printf("square(7) = %d\n", Counter.square(7));

    int sum = 0;
    foreach (int v in Counter.table) sum += v;     // the array length is known
    printf("table: %d entries, sum %d\n", sizeof(Counter.table) / sizeof(int), sum);
    return 0;
}
