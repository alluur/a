// var in loops, and the rules for names
int counter = 0;

int next() {
    counter++;
    return counter;
}

int main() {
    // var in the head of a for, and as the type of a foreach variable
    for (var i = 0; i < 3; i++) {
        print($"i={i} ");
    }
    println("");
    int primes[4] = {2, 3, 5, 7};
    foreach (var p in primes) {
        print($"{p} ");
    }
    println("");
    foreach (var i, var p in primes) {
        print($"{i}:{p} ");
    }
    println("");

    // the initializer is evaluated before the new name exists:
    // it sees the outer x, so this is 5 + 10 and not an error
    var x = 5;
    {
        var x = x + 10;
        println($"inner x = {x}");
    }
    println($"outer x = {x}");

    // it is evaluated exactly once
    var sum = next() + next();
    println($"sum = {sum}, counter = {counter}");

    // var is not a reserved word: it can still be the name of a variable
    var var = 7;
    int v2 = var * 2;
    println($"var = {var}, v2 = {v2}");
    return 0;
}
