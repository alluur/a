// case lists, ranges and big values in a switch
enum Weekday { Mon, Tue, Wed, Thu, Fri, Sat, Sun }

char* kind(int c) {
    switch (c) {
        case 'a'..'z':               return "lower case letter";   // a range includes both ends
        case 'A'..'Z':               return "upper case letter";
        case '0'..'9':               return "digit";
        case ' ', '\t', '\n':        return "white space";         // a list of labels
        default:                     return "something else";
    }
}

char* when(Weekday d) {
    switch (d) {
        case Weekday.Sat, Weekday.Sun: return "weekend";
        case Weekday.Mon..Weekday.Fri: return "work day";
    }
    return "?";
}

char* size(int64 n) {
    switch (n) {
        case 0:                      return "empty";
        case 1..999:                 return "small";
        case 1000..4999999999:       return "large";       // labels are no longer limited to 32 bits
        case 5000000000:             return "exactly five billion";
        default:                     return "huge or negative";
    }
}

int main() {
    foreach (int c in "aZ7 !") printf("'%c' -> %s\n", c, kind(c));
    foreach (Weekday d in 0..7) printf("day %d: %s\n", d, when(d));
    foreach (int64 n in (int64[]){0, 500, 5000000, 5000000000, 9000000000, -3}) {
        printf("%lld: %s\n", n, size(n));
    }
    return 0;
}
