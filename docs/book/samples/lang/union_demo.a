// union: the members share the same memory
union Value {
    int number;
    char bytes[8];
    char* text;
}

struct Tagged {
    int kind;                           // which member of the union is in use
    Value value;
}

void show(Tagged t) {
    if (t.kind == 0) {
        printf("number %d\n", t.value.number);
    } else {
        printf("text %s\n", t.value.text);
    }
}

int main() {
    printf("sizeof(Value) = %d, sizeof(Tagged) = %d\n", sizeof(Value), sizeof(Tagged));
    Value v;
    v.number = 0x0102030405060708;
    printf("first byte %d, last byte %d\n", v.bytes[0], v.bytes[7]);   // little endian

    Tagged a;
    a.kind = 0;
    a.value.number = 42;
    Tagged b;
    b.kind = 1;
    b.value.text = "hello";
    show(a);
    show(b);
    return 0;
}
