// memcpy and memset work on raw bytes; a cast shows the bytes of any value
struct Pair { int a; int b; }

int main() {
    char buffer[16];
    memset(buffer, 'x', 15);                     // fill 15 bytes
    buffer[15] = 0;
    println(buffer);

    char copy[16];
    memcpy(copy, "bytes to copy", 14);           // copy including the final zero
    println(copy);

    Pair p;
    p.a = 0x0102;
    p.b = -1;
    Pair q;
    memcpy((char*) &q, (char*) &p, sizeof(Pair));    // copying a whole struct byte by byte
    printf("%d %d\n", q.a, q.b);

    int value = 0x04030201;
    uint8* bytes = (uint8*) &value;              // x86-64 is little endian
    printf("%d %d %d %d\n", bytes[0], bytes[1], bytes[2], bytes[3]);

    memset((char*) &q, 0, sizeof(Pair));         // clear a struct
    printf("%d %d\n", q.a, q.b);
    return 0;
}
