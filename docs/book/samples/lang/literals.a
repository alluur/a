// Integer, character and boolean literals
int main() {
    printf("decimal %d, with underscores %d\n", 42, 1_000_000);
    printf("hex %d, binary %d\n", 0xFF, 0b1010);
    printf("suffixes ignored: %d %d %d %d\n", 10u, 10L, 10UL, 10ull);
    printf("characters: %d %d %d %d\n", 'A', '0', '\n', '\x41');
    printf("quote characters: %c %c\n", '\'', '"');
    bool t = true;
    bool f = false;
    printf("true = %d, false = %d\n", t, f);
    char* nothing = null;
    printf("null = %d\n", (int) nothing);
    printf("negative: %d, minus a hex: %d\n", -17, -0x10);
    return 0;
}
