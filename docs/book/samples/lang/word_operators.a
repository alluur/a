// and, or, not, xor and the logical exclusive or ^^
int main() {
    int a = 5;
    int b = 0;
    bool retry = false;
    if (a > 1 and not (b > 0) or retry) {
        println("word operators work like && || !");
    }
    printf("%d %d %d %d\n", 1 ^^ 0, 1 ^^ 1, 0 ^^ 0, 3 xor 4);   // 1 only when exactly one side is true
    printf("%d %d\n", true xor false, a xor a);
    return 0;
}
