// format() and vformat() write into a buffer instead of the screen
int main() {
    char buf[32];
    int n = format(buf, 32, "%s-%04d", "id", 42);
    println(buf);
    printlnInt(n);

    // a buffer that is too small: the text is cut, format() says how much it stored
    char small[8];
    n = format(small, 8, "%s", "far too long");
    println(small);
    printlnInt(n);

    // vformat takes the values as an array and returns the length the whole text needs
    int values[2];
    values[0] = 12345;
    values[1] = 67890;
    n = vformat(small, 8, "%d and %d", values, 2);
    println(small);
    printlnInt(n);
    return 0;
}
