// Compound literals: a nameless value built where you need it
struct Point { int x; int y; }

int area(Point p) { return p.x * p.y; }
int sum(int* values, int n) {
    int total = 0;
    for (int i = 0; i < n; i++) total += values[i];
    return total;
}

int main() {
    printf("%d\n", area((Point){6, 7}));
    printf("%d\n", area((Point){.y = 3, .x = 4}));
    printf("%d\n", sum((int[]){1, 2, 3, 4}, 4));            // the size is counted from the list
    Point p;
    p = (Point){11, 22};                                    // assign a whole struct
    printf("%d %d\n", p.x, p.y);
    Point* q = &(Point){5, 6};                              // its address may be taken
    q->x = 50;
    printf("%d\n", q->x * q->y);
    return 0;
}
