// int and long: one 64-bit signed integer type that wraps around
int main() {
    int top = 9223372036854775807;     // the largest value
    long same = 42;                    // long is another name for int
    printf("sizeof(int) = %d, sizeof(long) = %d\n", sizeof(int), sizeof(long));
    printf("largest  = %d\n", top);
    int low = top + 1;                 // no error, no warning: the value wraps
    printf("top + 1  = %d\n", low);
    printf("low - 1  = %d\n", low - 1);
    printf("3037000500 squared = %d\n", 3037000500 * 3037000500);
    printf("%d\n", same + 1);
    return 0;
}
