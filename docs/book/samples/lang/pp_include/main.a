// #include inserts another file; guards and #pragma once prevent double inclusion
#include "defs.h"
#include "defs.h"          // the second one is skipped (#pragma once)
#include "guarded.h"
#include "guarded.h"       // skipped by the #ifndef guard inside the file

int main() {
    printf("%d %d\n", VERSION, ADD(1, 2) * 3);
    printf("%d %d\n", helper(21), guarded);
    return 0;
}
