// File handles: open, write, append, read in pieces, close
int main() {
    int h = fileOpen("log.txt", FILE_WRITE);          // creates or truncates
    if (h < 0) { println("cannot create"); return 1; }
    fileWrite(h, "first\n", 6);
    fileClose(h);

    h = fileOpen("log.txt", FILE_APPEND);
    fileWrite(h, "second\n", 7);
    fileClose(h);

    h = fileOpen("log.txt", FILE_READ);
    char all[64];
    int total = 0;
    int n = fileRead(h, &all[total], 5);              // 0 means: end of the file
    while (n > 0) {
        printf("chunk of %d bytes\n", n);
        total += n;
        n = fileRead(h, &all[total], 5);
    }
    fileClose(h);
    all[total] = 0;
    print(all);

    printf("open a missing file: %d\n", fileOpen("nothing.txt", FILE_READ) < 0);
    fileDelete("log.txt");
    return 0;
}
