// Fixed size arrays
const SIZE = 5;

int main() {
    int squares[SIZE];                         // a constant expression gives the size
    for (int i = 0; i < SIZE; i++) {
        squares[i] = i * i;
    }
    int primes[6] = {2, 3, 5, 7, 11};          // the last one is 0
    char name[16] = "Aytict";
    printf("squares[4] = %d\n", squares[4]);
    printf("primes: %d %d %d\n", primes[0], primes[4], primes[5]);
    printf("sizeof(primes) = %d bytes, %d elements\n", sizeof(primes), sizeof(primes) / sizeof(primes[0]));
    printf("name: %s (%d bytes)\n", name, sizeof(name));
    int* first = squares;                      // an array decays to a pointer to its first element
    printf("first[3] = %d, *first = %d\n", first[3], *first);
    int zeroed[3];
    printf("a new array is zeroed: %d %d %d\n", zeroed[0], zeroed[1], zeroed[2]);
    return 0;
}
