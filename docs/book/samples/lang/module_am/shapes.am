// a module file: the name and the content in one block
a_module shapes
{
    const SIDES = 4;

    public int area(int w, int h) { return w * h; }
    public int perimeter(int w, int h) { return 2 * (w + h); }

    private int secret() { return 42; }          // only visible inside shapes.am
    public int reveal() { return secret(); }

    public class Box {
        public int w;
        public int h;
        public Box(int a, int b) { w = a; h = b; }
        public int area() { return w * h; }
    }
}
