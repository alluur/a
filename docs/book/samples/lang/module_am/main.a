// a_import: use a module file with or without the module prefix
a_import('shapes.am');                           // use it as shapes.area(...)
a_import('shapes.am', 'perimeter, Box');         // also bring two names into this file

int main() {
    printf("%d %d\n", shapes.area(3, 4), shapes.SIDES);
    printf("%d\n", perimeter(3, 4));             // imported by name: no prefix needed
    Box* b = new Box(5, 6);                      // a class works the same way
    printf("%d\n", b->area());
    printf("%d\n", shapes.reveal());             // reaches secret() through a public function
    shapes.Box* c = new shapes.Box(2, 2);        // the prefix still works
    printf("%d\n", c->area());
    return 0;
}
