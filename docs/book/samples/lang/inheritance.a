// Inheritance: a derived class starts with the fields of its base class
class Animal {
    protected int legs;                          // visible in Animal and in derived classes
    private int secret;                          // only in Animal
    public char* name;

    public Animal(char* name, int legs) {
        this.name = name;
        this.legs = legs;
        secret = 42;
    }
    public int legCount() { return legs; }
    public char* kind() { return "animal"; }
}

class Bird : Animal {
    public Bird(char* name) {
        super(name, 2);                          // run the base class constructor first
    }
    public int wings() { return legs / 2 * 2; }  // legs is protected: usable here
}

class Dog : Animal {
    public Dog(char* name) { super(name, 4); }
    public char* kind() { return "dog"; }        // a method with the same name replaces the base one
    public char* baseKind() { return super.kind(); }   // super.name() calls the base version
}

int main() {
    Bird b("Tweety");
    Dog d("Rex");
    printf("%s has %d legs and %d wings\n", b.name, b.legCount(), b.wings());
    printf("%s has %d legs\n", d.name, d.legCount());
    printf("%s / %s\n", d.kind(), d.baseKind());

    Animal* a = &d;                              // a Dog* can be used where an Animal* is expected
    printf("through Animal*: %s, %s\n", a->name, a->kind());
    return 0;
}
