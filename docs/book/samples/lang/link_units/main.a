// Separate compilation: a header, two units, a shared global and a class
// book: link
#include "shapes.h"

int main() {
    Counter c;                       // the class comes from the header: both units know it
    for (int i = 1; i <= MAX_SHAPES; i++) {
        c.bump();
        Point far = corner(i);       // a function defined in shapes.a
        printf("corner %d is (%d, %d), area %d\n", i, far.x, far.y, area(corner(0), far));
    }
    printf("counter %d, areas computed %d\n", c.value(), created);
    created = 100;                   // a variable defined in shapes.a, changed here
    printf("created is now %d, seen from shapes.a: %d\n", created, createdTwice() / 2);
    return 0;
}
