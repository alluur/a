// shapes.a: the definitions
#include "shapes.h"

int created = 0;

static int scale() { return 1; }     // static: only this unit can call it

int area(Point a, Point b) {
    created++;
    return (b.x - a.x) * (b.y - a.y) * scale();
}

Point corner(int i) {
    Point p = {i * 10, i * 5};
    return p;
}

int createdTwice() {
    return created * 2;
}
