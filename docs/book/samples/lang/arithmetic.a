// Arithmetic operators: division truncates toward zero
int main() {
    printf("%d %d %d %d %d\n", 7 + 3, 7 - 3, 7 * 3, 7 / 3, 7 % 3);
    printf("%d %d %d %d\n", -7 / 2, -7 % 3, 7 / -2, 7 % -3);
    printf("%d %d\n", -(5 + 2), +4);
    int total = 17;
    int people = 5;
    printf("%d each, %d left over\n", total / people, total % people);
    // the rule for % : (a / b) * b + a % b == a
    int a = -17;
    int b = 5;
    printf("check: %d\n", (a / b) * b + a % b);
    return 0;
}
