// void: no value; void* a pointer to anything; null a pointer to nothing
void hello() {
    println("hello returns nothing");
}

int main() {
    hello();
    int number = 7;
    void* anything = &number;          // any pointer converts to void*
    int* back = (int*) anything;       // and back again with a cast
    printf("%d\n", *back);
    char* nothing = null;
    printf("null is %d, is it false? %d\n", (int) nothing, nothing == null);
    if (!nothing) {
        println("a null pointer is false in a condition");
    }
    return 0;
}
