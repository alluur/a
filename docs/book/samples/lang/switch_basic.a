// switch: constant case labels, fall-through, default
char* describe(int n) {
    switch (n) {
        case 0:
            return "zero";
        case 1:
        case 2:                            // 1 and 2 share this code
            return "small";
        case 3:
            return "three";
        default:
            return "large";
    }
}

int main() {
    for (int i = 0; i <= 4; i++) {
        printf("%d is %s\n", i, describe(i));
    }

    int level = 3;
    switch (level) {                       // without break, execution falls through
        case 3: println("level 3 unlocks ...");
        case 2: println("... level 2 ...");
        case 1: println("... and level 1");
                break;
        case 0: println("never printed");
    }

    // continue inside a switch belongs to the loop around it
    for (int i = 0; i < 5; i++) {
        switch (i) {
            case 1: continue;
            case 3: break;                 // break leaves only the switch
            default: printf("i=%d ", i);
        }
        printf("[after %d] ", i);
    }
    println("");
    return 0;
}
