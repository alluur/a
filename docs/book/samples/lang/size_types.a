// size_t, ssize_t, uintptr_t, intptr_t and ptrdiff_t
int main() {
    printf("sizes: %d %d %d %d %d\n", sizeof(size_t), sizeof(ssize_t), sizeof(uintptr_t),
           sizeof(intptr_t), sizeof(ptrdiff_t));
    int data[10];
    size_t bytes = sizeof(data);                 // size_t is an unsigned 64-bit integer
    size_t count = bytes / sizeof(data[0]);
    printf("%d bytes, %d elements\n", bytes, count);

    int* first = &data[0];
    int* last = &data[9];
    ptrdiff_t distance = last - first;           // the difference of two pointers, in elements
    printf("distance: %d\n", distance);

    ssize_t result = -1;                         // signed: a function can return an error as -1
    printf("signed: %d\n", result < 0);
    size_t unsignedResult = (size_t) -1;
    printf("unsigned: %d (the largest size_t)\n", unsignedResult > 100);

    uintptr_t address = (uintptr_t) first;       // a pointer as a number, and back
    int* again = (int*) address;
    printf("round trip: %d\n", again == first);
    return 0;
}
