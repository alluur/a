// Conditional compilation: #ifdef, #ifndef, #if, #elif, #else, #endif
#define VERSION 42
#define FEATURE_FAST

#ifdef FEATURE_FAST
int mode() { return 1; }
#else
int mode() { return 2; }
#endif

#ifndef FEATURE_SLOW
#define SPEED "not slow"
#endif

#if VERSION >= 50
#define LABEL "new"
#elif VERSION >= 40 && defined(FEATURE_FAST)    // defined() and ordinary operators work
#define LABEL "recent"
#else
#define LABEL "old"
#endif

#if 0
this block is skipped completely { ( even if it is not valid code
#endif

int main() {
    printf("mode %d, %s, %s\n", mode(), SPEED, LABEL);
#if UNDEFINED_NAME == 0                   // a name that is not a macro counts as 0
    println("an unknown name is 0 inside #if");
#endif
#if defined(__A__) && __OS__ == 0
    println("compiled by A for Linux");
#endif
    return 0;
}
