// The stack: locals live in the frame of a call; heap memory outlives it
int sumTo(int n) {
    int block[4096];                      // 32 KiB in every frame
    block[0] = n;
    if (n == 0) return 0;
    return block[0] + sumTo(n - 1);       // 100 frames of 32 KiB fit in the 8 MiB stack
}

char* greeting(char* name) {
    char local[32];                       // gone when the function returns
    strcpy(local, "Hello, ");
    strcat(local, name);
    char* result = alloc(strlen(local) + 1);    // the heap copy survives
    strcpy(result, local);
    return result;
}

int main() {
    printf("%d\n", sumTo(100));
    char* g = greeting("stack");
    println(g);
    return 0;
}
