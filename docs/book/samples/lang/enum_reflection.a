// Enums know their members: count, name, parse and has
enum Color { Red, Green = 5, Blue }

int main() {
    printf("%d members\n", Color.count);
    printf("%s %s %s\n", Color.name(Color.Red), Color.name(5), Color.name(Blue));
    printf("unknown value: %s\n", Color.name(99));
    printf("parse: %d %d\n", Color.parse("Green"), Color.parse("Blue"));
    printf("unknown name: %d, with fallback: %d\n", Color.parse("Purple"), Color.parse("Purple", 42));
    printf("has: %d %d %d\n", Color.has(0), Color.has(1), Color.has(6));

    // walk over all values
    for (int v = 0; v < 8; v++) {
        if (Color.has(v)) {
            printf("  %d is %s\n", v, Color.name(v));
        }
    }
    return 0;
}
