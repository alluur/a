// input(), askInt() and confirm() print a prompt and read an answer
int main() {
    char* name = input("Your name: ");       // a heap string, null at the end of the input
    int age = askInt("Your age: ");          // asks again until the text is a whole number
    println("");
    printf("Hello %s, next year you will be %d.\n", name, age + 1);
    if (confirm("Continue? ")) {
        println("");
        println("you said yes");
    } else {
        println("");
        println("you said no");
    }
    return 0;
}
