// Inline assembly: machine code for every processor the program should run on
int add2(int a, int b) {
    return asm(a, b) {                       // a goes into register A, b into B
        x64: 0x48, 0x01, 0xC8;               // add rax, rcx
        arm64: 0x8B010000;                   // add x0, x0, x1
        riscv64: 0x00B50533;                 // add a0, a0, a1
        loongarch64: 0x00109484;             // add.d a0, a0, a1
    };                                       // the value of the expression is register A afterwards
}

int main() {
    printf("add2(20, 22) = %d\n", add2(20, 22));
    printf("add2(-5, 3) = %d\n", add2(-5, 3));

    // as a statement the block may stand alone: here it does nothing (a no-operation)
    asm() { x64: 0x90; arm64: 0xD503201F; riscv64: 0x00000013; loongarch64: 0x03400000; }
    println("the program continues after the nop");
    return 0;
}
