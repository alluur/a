// typedef: another name for a type
struct Point { int x; int y; }

typedef int Number;
typedef char* Text;
typedef Point* PointRef;

Number twice(Number n) {
    return n * 2;
}

int main() {
    Number a = 21;
    Text greeting = "typedef names a type";
    Point p;
    PointRef r = &p;
    r->x = 3;
    r->y = 4;
    printf("%d %s %d\n", twice(a), greeting, p.x * p.y);

    typedef int Index;                  // also allowed inside a function
    Index i = 7;
    printf("%d\n", i);
    return 0;
}
