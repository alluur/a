// new and alloc give zeroed heap memory that is never freed
struct Point { int x; int y; }

int main() {
    Point* p = new Point;                      // zeroed
    int* numbers = (int*) alloc(5 * sizeof(int));
    char* text = alloc(32);                    // alloc returns char*
    printf("%d %d %d %d\n", p->x, p->y, numbers[4], text[31]);
    numbers[0] = 100;
    strcpy(text, "built on the heap");
    printf("%d %s\n", numbers[0], text);

    // the allocator is a bump pointer: blocks follow each other, rounded up to 16 bytes
    char* a = alloc(10);
    char* b = alloc(10);
    char* c = alloc(17);
    char* d = alloc(1);
    printf("%d %d %d\n", b - a, c - b, d - c);

    // a long loop of small allocations is cheap: nothing is ever freed
    char* first = alloc(16);
    char* last = first;
    for (int i = 0; i < 100000; i++) {
        last = alloc(16);
    }
    printf("100000 blocks used %d bytes\n", last - first);
    return 0;
}
