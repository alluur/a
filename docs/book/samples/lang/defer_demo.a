// defer: run an expression when the function returns, last in first out
int process(int fd, bool fail) {
    defer printf("closing file %d\n", fd);       // runs on every way out of the function
    defer println("second deferred expression runs first");
    printf("working with file %d\n", fd);
    if (fail) {
        return -1;                               // both deferred calls still run
    }
    println("everything went well");
    return 0;
}

int total = 0;
int measure() {
    int local = 5;
    defer total += local;                        // can use locals declared before it
    local = 10;                                  // ... and sees later changes
    return local * 2;                            // the result 20 is computed first
}

int main() {
    printf("process returned %d\n", process(7, false));
    printf("process returned %d\n", process(8, true));
    printf("measure returned %d, total is %d\n", measure(), total);
    return 0;
}
