// Mathematical functions of the dmath module
import dmath;

int main() {
    printlnDouble(dmath.sqrt(2));              // the module name is part of the call
    printlnDouble(dmath.pow(2, 0.5) * dmath.PI);
    printlnDouble(dmath.floor(-2.5));
    printlnDouble(dmath.ceil(2.1));
    printlnDouble(dmath.fabs(-0.75));
    printlnDouble(dmath.hypot(3, 4));
    printlnDouble(dmath.sin(dmath.PI / 6));
    println(doubleToFixed(dmath.exp(1), 5));
    println(doubleToFixed(dmath.log(dmath.E * dmath.E), 3));

    double radius = 2.5;
    double area = dmath.PI * radius * radius;
    println(doubleToFixed(area, 4));
    printf("%d\n", (int) dmath.round(area));
    return 0;
}
