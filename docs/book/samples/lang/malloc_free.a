// malloc, calloc, realloc and free from the cstdlib module: memory that can be given back
import cstdlib;

int main() {
    int* a = (int*) malloc(4 * sizeof(int));
    for (int i = 0; i < 4; i++) a[i] = i * 10;

    int* b = (int*) calloc(4, sizeof(int));          // calloc zeroes the memory
    printf("calloc: %d %d %d %d\n", b[0], b[1], b[2], b[3]);

    a = (int*) realloc(a, 8 * sizeof(int));          // grows, keeping the old contents
    for (int i = 4; i < 8; i++) a[i] = i * 10;
    int total = 0;
    for (int i = 0; i < 8; i++) total += a[i];
    printf("sum after realloc: %d\n", total);

    free(a);
    free(b);
    // a loop that allocates and frees does not grow the program's memory
    for (int i = 0; i < 100000; i++) {
        char* tmp = malloc(1000);
        tmp[0] = 'x';
        free(tmp);
    }
    println("100000 allocations done");
    return 0;
}
