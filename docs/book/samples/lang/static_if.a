// static if: the compiler chooses a branch; the other one is never compiled
const DEBUG = false;
const WORD = 8;

static if (__OS == 1) {
    char* osName() { return "Windows"; }
} else static if (__OS == 2) {
    char* osName() { return "Android"; }
} else {
    char* osName() { return "Linux"; }
}

static if (WORD == 8) {
    int bits() { return 64; }
} else {
    int bits() { return notDeclaredAnywhere(); }       // never compiled, so no error
}

int main() {
    printf("running on %s with %d bit words\n", osName(), bits());
    static if (DEBUG) {
        println("debug output");
    } else {
        println("release build");
    }
    static if (__ARCH == 0) {
        println("built for x86-64");
    } else static if (__ARCH == 1) {
        println("built for ARM64");
    } else {
        println("built for another processor");
    }
    return 0;
}
