// Pointers: & takes an address, * follows it
void swap(int* a, int* b) {
    int t = *a;
    *a = *b;
    *b = t;
}

void setBoth(int* x, int* y, int v) {
    *x = v;
    *y = v;
}

int main() {
    int n = 10;
    int* p = &n;                      // p holds the address of n
    *p = 20;                          // changes n
    printf("n = %d, *p = %d\n", n, *p);

    int** pp = &p;                    // a pointer to a pointer
    **pp = 30;
    printf("n = %d\n", n);

    int a = 1;
    int b = 2;
    swap(&a, &b);                     // output parameters
    printf("a = %d, b = %d\n", a, b);
    setBoth(&a, &b, 7);
    printf("a = %d, b = %d\n", a, b);

    int* none = null;
    if (none == null) println("null pointers compare with ==");
    printf("p == &n: %d\n", p == &n);
    return 0;
}
