// A struct groups fields; both . and -> reach them
struct Point {
    int x;
    int y;
}

struct Rect {
    Point topLeft;                     // a struct inside a struct
    Point bottomRight;
    char name[12];                     // an array field
}

int area(Rect* r) {
    return (r->bottomRight.x - r->topLeft.x) * (r->bottomRight.y - r->topLeft.y);
}

int main() {
    Point p;                           // zeroed
    p.x = 3;
    p.y = 4;
    Point q = p;                       // a copy of all fields
    q.x = 30;
    printf("p=(%d,%d) q=(%d,%d)\n", p.x, p.y, q.x, q.y);

    Rect r;
    r.topLeft.x = 1;
    r.topLeft.y = 1;
    r.bottomRight = (Point){6, 5};
    strcpy(r.name, "window");
    printf("%s has area %d\n", r.name, area(&r));

    Point* pp = &p;
    pp->x = 99;                        // through a pointer ...
    (*pp).y = 98;                      // ... in either spelling
    pp.x++;                            // . also works on a pointer
    printf("p=(%d,%d)\n", p.x, p.y);
    printf("sizeof(Point) = %d, sizeof(Rect) = %d\n", sizeof(Point), sizeof(Rect));
    Point* heap = new Point;           // heap memory, zeroed
    heap->x = 5;
    printf("heap point: (%d,%d)\n", heap->x, heap->y);
    return 0;
}
