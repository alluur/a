// char (also called byte) is an unsigned 8-bit number
int main() {
    char c = 'a';
    byte b = 200;                      // byte is another name for char
    printf("sizeof(char) = %d, sizeof(byte) = %d\n", sizeof(char), sizeof(byte));
    printf("'a' is %d, 'a' + 1 is %c\n", c, c + 1);
    printf("200 stored in a char: %d\n", b);
    b = b + 100;                       // 300 does not fit: only the low 8 bits stay
    printf("200 + 100 stored again: %d\n", b);
    char letters[4];
    for (int i = 0; i < 3; i++) {
        letters[i] = 'x' + i;
    }
    letters[3] = 0;                    // text ends with a zero byte
    println(letters);
    printf("%d %d\n", '0', 'z' - 'a');
    return 0;
}
