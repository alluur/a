// An enum with a base type takes less room: handy for file formats and protocols
enum Kind : uint8 { Text, Binary, Image = 200 }

struct Frame {
    Kind kind;                                   // one byte
    uint16 length;                               // aligned to 2
    Kind flag;
}

int main() {
    printf("sizeof(Kind) = %d, sizeof(Frame) = %d\n", sizeof(Kind), sizeof(Frame));
    Frame f;
    f.kind = Kind.Image;
    f.length = 9;
    f.flag = Binary;
    printf("%d %d %d\n", f.kind, f.length, f.flag);
    Kind k = 300;                                // stored in a byte: 300 - 256
    printf("%d\n", k);
    printf("%s\n", Kind.name(Kind.Image));
    return 0;
}
