// Operator overloading: methods named operator+, operator==, operator[] ...
struct Vec {
    int x;
    int y;
    Vec operator+(Vec o) { return make(x + o.x, y + o.y); }
    Vec operator-() { return make(-x, -y); }                    // unary minus: no parameter
    Vec operator*(int k) { return make(x * k, y * k); }         // the right side may be any type
    bool operator==(Vec o) { return x == o.x && y == o.y; }     // != comes for free
    bool operator<(Vec o) { return x * x + y * y < o.x * o.x + o.y * o.y; }
    int operator[](int i) { return i == 0 ? x : y; }
}

Vec make(int x, int y) {
    Vec v;
    v.x = x;
    v.y = y;
    return v;
}

int main() {
    Vec a = make(1, 2);
    Vec b = make(10, 20);
    Vec c = a + b + a;
    printf("%d %d\n", c.x, c.y);
    Vec d = -a * 2;
    printf("%d %d\n", d.x, d.y);
    printf("%d %d %d\n", a == a, a != b, a < b);
    printf("%d %d\n", b[0], b[1]);
    c += a;                                                     // calls operator+ and stores the result
    printf("%d %d\n", c.x, c.y);
    return 0;
}
