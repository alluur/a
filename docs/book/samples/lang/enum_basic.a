// Enums: named integer constants
enum Color { Red, Green = 5, Blue }              // Red = 0, Green = 5, Blue = 6
enum Day { Mon, Tue, Wed, Thu, Fri, Sat, Sun, }  // a trailing comma is fine

char* mood(Color c) {
    switch (c) {                                 // enum members are constants: usable as case labels
        case Color.Red:   return "angry";
        case Color.Green: return "calm";
        default:          return "blue";
    }
}

int hours[Day.Sun + 1];                          // ... and in array sizes

int main() {
    Color c = Color.Blue;                        // qualified
    Color d = Red;                               // unqualified works too
    printf("%d %d %d\n", c, d, Green);
    printf("%s %s %s\n", mood(Color.Red), mood(Green), mood(c));
    hours[Day.Sat] = 3;
    printf("%d slots, Saturday has %d\n", sizeof(hours) / sizeof(hours[0]), hours[Sat]);
    printf("enum values are ints: %d\n", Color.Blue + 10);
    printf("sizeof(Color) = %d\n", sizeof(Color));
    return 0;
}
