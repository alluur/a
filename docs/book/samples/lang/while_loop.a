// while: test first, then run the body
int main() {
    int n = 27;
    int steps = 0;
    while (n != 1) {                  // the Collatz sequence
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    printf("27 reaches 1 after %d steps\n", steps);

    int never = 10;
    while (never < 5) {
        println("the body is skipped when the condition starts false");
    }

    int digits = 0;
    int value = 9065;
    while (value > 0) {
        value /= 10;
        digits++;
    }
    printf("9065 has %d digits\n", digits);
    return 0;
}
