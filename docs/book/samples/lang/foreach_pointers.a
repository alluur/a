// foreach: change elements through a pointer, pointer plus count, compound literals
// book: args=alpha beta gamma
struct Item { int id; int qty; }

int total(int* values, int n) {
    int t = 0;
    foreach (int v in values, n) t += v;           // an array parameter has no known length: say how many
    return t;
}

void show(Item* items, int n) {
    foreach (int i, Item it in items, n) printf("  #%d: id %d, qty %d\n", i, it.id, it.qty);
}

int main(int argc, char** argv) {
    Item items[3] = {{1, 10}, {2, 20}, {3, 30}};

    foreach (Item it in items) it.qty = 0;         // the variable is a copy: the array stays as it is
    println("after changing copies:");
    show(items, 3);

    foreach (Item* it in items) it->qty += 5;      // a pointer variable points at each element
    println("after changing through pointers:");
    show(items, 3);

    foreach (char* arg in argv + 1, argc - 1) printf("argument: %s\n", arg);   // "pointer, count" skips argv[0]
    printf("total = %d\n", total((int[]){4, 5, 6}, 3));

    char* nothing = null;
    foreach (char c in nothing) println("never printed");          // a null text has no bytes
    foreach (int n in 5..5) println("never printed");              // an empty range
    println("done");
    return 0;
}
