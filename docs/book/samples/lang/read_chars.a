// readChar() and readAll(): counting words, then taking the rest of the input
int main() {
    int words = 0;
    bool inWord = false;
    int c = readChar();                      // -1 at the end of the input
    while (c >= 0 && c != '.') {             // stop at the first full stop
        if (isSpace(c)) {
            inWord = false;
        } else if (!inWord) {
            inWord = true;
            words++;
        }
        c = readChar();
    }
    printf("words before the full stop: %d\n", words);
    char* rest = readAll();                  // everything that is left
    printf("the rest is %d bytes: [%s]\n", strlen(rest), trim(rest));
    return 0;
}
