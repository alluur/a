// A tuple literal needs a context; elsewhere (a, b) is the comma operator
int main() {
    // where a tuple type is expected, the elements are converted one by one
    (int, double) t = (1, 2);
    println($"{t.0} {t.1} {t.1 / 4}");           // t.1 is the double 2.0
    (uint8, int32) narrow = (300, 5000 * 1000000);
    println($"{narrow.0:d} {narrow.1}");        // 300 does not fit in a uint8: 44; the int32 wraps too

    // without an expected type, var takes the types of the elements
    var mixed = (1, "two", 3.5);
    println($"{mixed.0} {mixed.1} {mixed.2}");

    // the elements are computed from left to right, once each
    int cnt = 0;
    var order = (cnt++, cnt++, cnt++);
    println($"{order.0} {order.1} {order.2} cnt={cnt}");

    // outside of such a context (a, b) is the old comma operator: the value of b
    int a = 0;
    int c = (a = 5, a + 1);
    println($"a={a} c={c}");

    // an assignment pattern first finds its targets, then assigns from left to right
    int i = 0;
    int v[3] = {0, 0, 0};
    (v[i], i) = (7, 2);                // v[0] gets 7 (the old i), then i becomes 2
    println($"v[0]={v[0]} i={i}");
    (i, i) = (1, 2);
    println($"i={i}");

    // sizes: every element sits at its own alignment, the total is rounded to 8 bytes
    println($"{sizeof((int, int))} {sizeof((int, int, int))} {sizeof((uint8, uint8))} {sizeof((char*, int, double))}");
    return 0;
}
