// Code for one processor only: static if keeps the other targets compiling
static if (__ARCH == 0) {
    int shiftLeft3(int v) {                  // x86-64 only: shl rax, 3
        return asm(v) {
            x64: 0x48, 0xC1, 0xE0, 0x03;
        };
    }
} else {
    int shiftLeft3(int v) {                  // every other processor: plain A
        return v << 3;
    }
}

int main() {
    printf("%d\n", shiftLeft3(5));
    return 0;
}
