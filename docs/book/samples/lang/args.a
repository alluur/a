// Command line arguments: argc, argv and the helpers hasArg / argValue / argIndex
// book: args=alpha -v -o out.txt beta
int main(int argc, char** argv) {
    printf("argc = %d\n", argc);                     // argv[0] is the program itself
    for (int i = 1; i < argc; i++) {
        printf("argv[%d] = %s\n", i, argv[i]);
    }
    println(hasArg(argc, argv, "-v") ? "verbose" : "quiet");
    printf("output file: %s\n", argValue(argc, argv, "-o", "a.out"));
    printf("input file: %s\n", argValue(argc, argv, "-i", "stdin"));   // the fallback
    printf("-o is argument number %d\n", argIndex(argc, argv, "-o"));
    printf("-x is argument number %d\n", argIndex(argc, argv, "-x"));
    return 0;
}
