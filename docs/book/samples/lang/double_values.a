// double: literals, mixed arithmetic, casts and comparisons
int main() {
    double a = 1.5;
    float b = 2e-3;                            // float is another name for double
    double c = 1_000.25;
    printlnDouble(a + b + c);
    printf("sizeof(double) = %d, sizeof(float) = %d\n", sizeof(double), sizeof(float));

    int n = 3;
    double mixed = n * a;                      // the int becomes a double: 3.0 * 1.5
    printlnDouble(mixed);
    printlnDouble(n / 2);                      // two ints: an integer division, 1, then converted
    printlnDouble(n / 2.0);                    // one double: a real division

    // double to int needs a cast and truncates toward zero
    printf("%d %d %d\n", (int) 7.9, (int) -7.75, (int) (a * 100));

    printf("%d %d %d %d\n", a < c, a == 1.5, a != 1.5, n > 2.5);   // comparisons give 0 or 1

    double total = 0;
    total += 0.25;
    total *= 8;
    total -= 0.5;
    total /= 3;
    printlnDouble(total);
    total++;                                   // ++ and -- add or subtract 1.0
    printlnDouble(total);
    printlnDouble(-total);
    if (total) println("a double is true when it is not zero");
    printlnDouble(total > 1 ? 0.5 : 1.5);
    return 0;
}
