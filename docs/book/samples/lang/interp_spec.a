// After the colon: flags, width, .precision, length, letter (in this order)
int main() {
    int x = 42;
    int n = -42;
    char* s = "text";
    double d = 3.14159;

    println($"width     [{x:6}] [{x:-6}] [{n:6}]");
    println($"zeros     [{x:06}] [{n:06}] [{x:+06}]");
    println($"sign      [{x:+}] [{n:+}] [{x: d}] [{n: d}]");
    println($"hex       [{x:x}] [{x:X}] [{x:#x}] [{x:#08x}] [{n:x}]");
    println($"octal bin [{x:o}] [{x:#o}] [{x:b}] [{x:#b}] [{x:010b}]");
    println($"digits    [{x:.5}] [{x:8.5}] [{x:-8.5}] [{0:.0}]|");
    println($"text      [{s:8}] [{s:-8}] [{s:.2}] [{s:8.2}] [{s:-8.2s}]");
    println($"float     [{d:.2f}] [{d:10.3f}] [{d:-10.1f}] [{d:+.1f}] [{d:010.2f}]");
    println($"sci       [{d:e}] [{d:.2E}] [{d:g}] [{d:.3g}] [{d:G}] [{d:v}]");
    println($"char      [{65:c}] [{65:3c}] [{65:-3c}] [{x:c}]");
    println($"length    [{x:ld}] [{x:lld}] [{x:zu}] [{300:hhd}] [{70000:hd}]");
    println($"letters   [{x:d}] [{x:i}] [{x:u}] [{n:u}] [{x:5.3d}]");
    return 0;
}
