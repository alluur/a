// break leaves the innermost loop, continue starts its next round
int main() {
    for (int i = 1; i <= 10; i++) {
        if (i % 2 == 0) continue;                // skip even numbers
        if (i > 7) break;                        // stop completely
        printf("%d ", i);
    }
    println("");

    // break only leaves the inner loop
    for (int row = 1; row <= 3; row++) {
        for (int col = 1; col <= 5; col++) {
            if (col > row) break;
            printf("*");
        }
        println("");
    }

    // looking for something
    int data[6] = {4, 9, 16, 25, 36, 49};
    int found = -1;
    for (int i = 0; i < 6; i++) {
        if (data[i] == 25) {
            found = i;
            break;
        }
    }
    printf("25 is at index %d\n", found);
    return 0;
}
