module geometry;

const SIDES = 4;

public int area(int w, int h) {
    return w * h;
}

private int secret() {                           // invisible outside this file
    return 1000;
}

public int describe(int w, int h) {
    return secret() + area(w, h);                // inside the module, names need no prefix
}

public class Box {
    private int w;
    private int h;
    public Box(int w, int h) { this.w = w; this.h = h; }
    public int area() { return w * h; }
}
