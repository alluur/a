// A module in its own file: import it and use qualified names
import geometry;

int area(int w, int h) {                         // our own area() does not clash with geometry.area()
    return -1;
}

int main() {
    printf("%d %d\n", geometry.area(3, 4), area(3, 4));
    printf("sides: %d\n", geometry.SIDES);
    geometry.Box* b = new geometry.Box(5, 6);    // types are qualified too
    printf("box: %d\n", b->area());
    printf("through a helper: %d\n", geometry.describe(2, 5));
    // geometry.secret();                        // error: access to private declaration 'secret'
    return 0;
}
