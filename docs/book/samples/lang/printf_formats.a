// printf: conversions, width, precision and flags
int main() {
    printf("%d items, %s\n", 3, "apples");
    printf("[%5d] [%-5d] [%05d] [%+d]\n", 42, 42, 42, 42);
    printf("[%x] [%X] [%#x] [%o] [%b]\n", 255, 255, 255, 8, 10);
    printf("[%8s] [%-8s] [%.3s]\n", "right", "left", "truncated");
    printf("[%c%c%c]\n", 'A', 66, 0x43);
    printf("[%*d] [%-*d]\n", 6, 7, 6, 7);
    printf("%d%%\n", 50);
    printf("%u\n", -1);                       // %u shows the 64 bits as an unsigned number
    printf("%d\n", -1);
    return 0;
}
