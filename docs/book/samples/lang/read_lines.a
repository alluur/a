// Reading standard input line by line
int main() {
    char line[128];
    int count = 0;
    int total = 0;
    while (readLine(line, 128) >= 0) {      // -1 means: end of the input
        count++;
        total += strlen(line);
        printf("%d: [%s]\n", count, line);
    }
    printf("%d lines, %d characters\n", count, total);
    return 0;
}
