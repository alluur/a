// A function that takes any number of extra arguments
int sum(int scale, ...) {
    int total = 0;
    for (int i = 0; i < va_count(); i++) {       // va_count(): how many extra arguments
        total += va_arg(i) * scale;              // va_arg(i): the i-th extra one, from 0
    }
    return total;
}

// a printf-like function: collect the extras in an array and use vformat
void logf(char* tag, char* fmt, ...) {
    int args[8];
    int n = va_count();
    for (int i = 0; i < n; i++) args[i] = va_arg(i);
    char buf[256];
    vformat(buf, 256, fmt, args, n);
    print(tag);
    print(": ");
    println(buf);
}

int main() {
    printf("%d %d %d\n", sum(10, 1, 2, 3), sum(1), sum(2, 5, 5));
    logf("info", "%d items", 3);
    logf("warn", "%s needs %d%% of %d", "disk", 90, 500);
    return 0;
}
