// Defining and calling functions
int add(int a, int b) {
    return a + b;
}

void greet(char* who) {                  // void: no result
    print("hello, ");
    println(who);
}

int later() {
    return helper() + 1;                 // helper is defined further down: that is fine
}
int helper() { return 41; }

int noReturn(int x) {
    x = x * 2;                           // no return statement: the result is 0
}

int multiply(int a, int b);              // a prototype is accepted, never necessary

int main() {
    greet("functions");
    printf("%d %d\n", add(2, 3), later());
    printf("%d\n", noReturn(21));
    printf("%d\n", multiply(6, 7));
    printf("%d\n", add(add(1, 2), add(3, 4)));    // arguments are evaluated left to right
    return 0;
}

int multiply(int a, int b) { return a * b; }
