// Printing, parsing and inspecting doubles
int main() {
    double d = 2.0 / 3;
    printDouble(d);                            // no newline
    println("");
    printlnDouble(0.1 + 0.2);                  // the shortest text that reads back as the same number
    println(doubleToText(1e22));
    println(doubleToFixed(d, 3));              // a fixed number of decimals, rounded exactly
    println(doubleToSci(123456.789, 2));       // scientific notation
    printlnDouble(parseDouble("2.5e3"));
    printlnDouble(parseDouble("  -0.125"));

    double inf = 1.0 / 0.0;
    double nan = inf - inf;
    printf("isInf: %d %d, isNaN: %d %d, isFinite: %d %d\n", isInf(inf), isInf(d), isNaN(nan), isNaN(d), isFinite(d), isFinite(inf));
    printf("nan == nan: %d\n", nan == nan);
    printlnDouble(inf);
    printlnDouble(nan);

    // the 64 bits of a double: __bits and __dbl convert without changing a bit
    printf("bits of 1.0: %x\n", __bits(1.0));
    printf("bits of -2.0: %x\n", __bits(-2.0));
    printlnDouble(__dbl(0x4009000000000000));
    printlnDouble(__dbl(__bits(1.0) + 1));     // adding 1 to the bits gives the next double
    return 0;
}
