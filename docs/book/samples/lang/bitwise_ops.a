// Bitwise operators and shifts
int main() {
    int a = 0b1100;
    int b = 0b1010;
    printf("and %b, or %b, xor %b, not a = %d\n", a & b, a | b, a ^ b, ~a);
    printf("1 << 10 = %d, 1024 >> 3 = %d\n", 1 << 10, 1024 >> 3);
    printf("-16 >> 2 = %d (arithmetic shift keeps the sign)\n", -16 >> 2);

    // flags in one number
    const READ = 1;
    const WRITE = 2;
    const EXEC = 4;
    int mode = READ | EXEC;
    printf("can write: %d, can exec: %d\n", (mode & WRITE) != 0, (mode & EXEC) != 0);
    mode |= WRITE;                                // set a bit
    mode &= ~READ;                                // clear a bit
    mode ^= EXEC;                                 // flip a bit
    printf("mode now %b\n", mode);

    // extracting a field: bits 4 to 7 of a value
    int value = 0xABCD;
    printf("middle nibble: %x\n", (value >> 4) & 0xF);
    uint64 big = 0x8000000000000000;
    printf("uint64 >> 63 = %d, int >> 63 = %d\n", big >> 63, (int) big >> 63);
    return 0;
}
