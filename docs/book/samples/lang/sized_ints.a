// Fixed width integers: values are cut to their width when they are stored
struct Header {
    uint8 kind;                        // each field is aligned to its own size
    uint16 length;
    uint32 id;
    int8 delta;
    int16 offset;
    int32 code;
    uint64 stamp;
}

int main() {
    printf("sizes: %d %d %d %d %d %d %d %d\n", sizeof(int8), sizeof(int16), sizeof(int32), sizeof(int64),
           sizeof(uint8), sizeof(uint16), sizeof(uint32), sizeof(uint64));
    printf("sizeof(Header) = %d\n", sizeof(Header));

    uint8 b = 300;                     // only the low 8 bits fit
    int8 s = 200;                      // 200 - 256, and reading sign extends
    printf("uint8 300 = %d, int8 200 = %d\n", b, s);

    uint32 w = 0;
    w = w - 1;                         // 32-bit arithmetic wraps at 32 bits
    printf("uint32 0 - 1 = %d\n", w);

    uint16 u = 65535;
    printf("uint16 65535 + 1 = %d, stored again = %d\n", u + 1, (uint16)(u + 1));

    uint64 big = 0xFFFFFFFFFFFFFFFF;
    printf("uint64 max as %%d: %d, as %%u: %u\n", big, big);
    printf("big / 2 = %u, big > 1 = %d\n", big / 2, big > 1);

    uint8 bytes[4] = {1, 2, 3, 250};
    uint16 halves[2] = {1, 65535};
    int32 negs[2] = {-1, -2};
    printf("%d %d %d\n", bytes[3], halves[1], negs[0] + negs[1]);
    return 0;
}
