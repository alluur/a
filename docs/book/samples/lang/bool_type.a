// bool: any value stored in a bool becomes 0 or 1
bool isEven(int n) {
    return n % 2 == 0;
}

int main() {
    bool yes = true;
    bool no = false;
    bool fromNumber = 25;              // not zero: true
    bool fromZero = 0;
    printf("sizeof(bool) = %d\n", sizeof(bool));
    printf("%d %d %d %d\n", yes, no, fromNumber, fromZero);
    printf("isEven(10) = %d, isEven(7) = %d\n", isEven(10), isEven(7));
    printBool(isEven(4) && !isEven(5));
    println("");
    bool flag = (bool) 256;            // a cast to bool also gives 0 or 1
    printf("(bool) 256 = %d\n", flag);
    return 0;
}
