// The shape of an A program: comments, constants, functions in any order
/* A block comment can span several lines.
   Block comments do not nest. */

const GREETING = "Hello";          // a top level constant

int main() {                        // execution starts here
    println(GREETING);
    int answer = compute();         // compute() is defined further down: the order does not matter
    print("The answer is ");
    printlnInt(answer);
    return 0;                       // the exit code of the process
}

int compute() {
    return 6 * 7;
}
