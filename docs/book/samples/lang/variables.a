// Declaring variables: everything starts as zero
struct Point { int x; int y; }

int main() {
    int a;                          // zero
    int b = 5, c = b * 2;           // several at once; any expression may initialise
    char name[8];                   // an array of zeros
    Point p;                        // a struct of zeros
    bool flag;
    char* text;                     // a null pointer
    printf("a=%d b=%d c=%d name[0]=%d p=(%d,%d) flag=%d text is null: %d\n", a, b, c, name[0], p.x, p.y, flag, text == null);

    Point q = p;                    // copies the whole struct
    q.x = 9;
    printf("p.x=%d q.x=%d\n", p.x, q.x);

    int d = a = 3;                  // an assignment is an expression
    printf("a=%d d=%d\n", a, d);
    return 0;
}
