// goto: jump to a label in the same function
int search(int* values, int n, int wanted) {
    int i = 0;
again:
    if (i >= n) goto missing;
    if (values[i] == wanted) goto found;
    i++;
    goto again;                            // a backward jump
found:
    return i;
missing:
    return -1;
}

int main() {
    int data[5] = {4, 8, 15, 16, 23};
    printf("%d %d\n", search(data, 5, 15), search(data, 5, 99));

    // the classic use: leave several loops at once
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (i * j == 6) {
                printf("i=%d j=%d\n", i, j);
                goto done;
            }
        }
    }
done:
    println("left both loops");
    return 0;
}
