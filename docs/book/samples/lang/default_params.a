// Default parameter values
int area(int w, int h = 1, int scale = 100) {
    return w * h * scale / 100;
}

void greet(char* name, char* greeting = "Hello", char* punctuation = "!") {
    printf("%s, %s%s\n", greeting, name, punctuation);
}

int main() {
    printf("%d %d %d\n", area(5), area(5, 4), area(5, 4, 200));
    greet("Ada");
    greet("Ada", "Good morning");
    greet("Ada", "Welcome", "...");
    return 0;
}
