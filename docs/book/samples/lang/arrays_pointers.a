// Arrays and pointers: arrays decay to pointers when passed to functions
int sum(int* values, int n) {                    // the length must be passed along
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += values[i];
    }
    return total;
}

void fill(int* values, int n, int v) {
    for (int i = 0; i < n; i++) values[i] = v;   // writes into the caller's array
}

int lengthInside(int* values) {
    return sizeof(values);                       // just the size of a pointer
}

int main() {
    int data[6] = {1, 2, 3, 4, 5, 6};
    printf("%d\n", sum(data, 6));
    printf("%d\n", sum(&data[2], 3));            // a slice: elements 2, 3 and 4
    fill(data, 6, 9);
    printf("%d %d\n", data[0], data[5]);
    printf("in main: %d bytes, in a function: %d\n", sizeof(data), lengthInside(data));

    // strings are char arrays: functions walk them until the zero byte
    char* s = "pointer";
    int len = 0;
    while (s[len] != 0) len++;
    printf("%s has %d characters, %s\n", s, len, &s[3]);
    return 0;
}
