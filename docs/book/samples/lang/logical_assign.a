// ||= &&= ??= : assign only when the target says so
int calls = 0;

int expensive(int v) {
    calls++;
    printf("  expensive(%d) runs\n", v);
    return v;
}

int main() {
    char* name = null;
    name ??= "anonymous";                          // null: replaced
    name ??= "someone else";                       // not null: stays
    printf("name = %s\n", name);

    int cache = 0;
    println("first:");
    cache ||= expensive(42);                       // 0: the right side runs and is stored
    println("second:");
    cache ||= expensive(99);                       // not 0: the right side is not evaluated
    printf("cache = %d, expensive ran %d time(s)\n", cache, calls);

    bool ready = true;
    ready &&= expensive(0) != 0;                   // true: the right side runs, false is stored
    printf("ready = %d\n", ready);
    ready &&= expensive(1) != 0;                   // false: the right side is not evaluated
    printf("ready = %d, expensive ran %d times\n", ready, calls);

    int slots[3] = {0, 7, 0};
    int next = 0;
    slots[next++] ||= 100;                         // the index expression runs once: next is 1 afterwards
    slots[next++] ||= 100;
    printf("slots: %d %d %d, next = %d\n", slots[0], slots[1], slots[2], next);
    return 0;
}
