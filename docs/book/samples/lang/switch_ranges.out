'a' -> lower case letter
'Z' -> upper case letter
'7' -> digit
' ' -> white space
'!' -> something else
day 0: work day
day 1: work day
day 2: work day
day 3: work day
day 4: work day
day 5: weekend
day 6: weekend
0: empty
500: small
5000000: large
5000000000: exactly five billion
9000000000: huge or negative
-3: huge or negative
