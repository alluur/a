// Tuples: several results from one function, patterns and swaps
(int, int) divmod(int a, int b) { return (a / b, a % b); }
(char*, int) named() { return ("seven", 7); }

int main() {
    (int q, int r) = divmod(7, 2);          // declares q and r
    printf("7 / 2 = %d remainder %d\n", q, r);

    var (q2, r2) = divmod(100, 7);          // the types come from the tuple
    printf("100 / 7 = %d remainder %d\n", q2, r2);

    (char* s, int n) = named();
    printf("%s is %d\n", s, n);

    (int only, _) = divmod(17, 5);          // _ throws an element away
    printf("quotient only: %d\n", only);

    int a = 1, b = 2;
    (a, b) = (b, a);                        // all values are computed first: a swap
    printf("a=%d b=%d\n", a, b);

    var t = (1, "two", 3.5);                // a tuple is a value, .0 .1 .2 are its elements
    printf("%d %s %.1f\n", t.0, t.1, t.2);
    t.0 = 10;
    printf("changed: %d, size of (int, int) = %d\n", t.0, sizeof((int, int)));
    return 0;
}
