// The digits are exact: the true value of the binary number, rounded half to even
int main() {
    // 0.1 is not one tenth: these are its real digits
    printf("%.30f\n", 0.1);
    printf("%.20f\n", 0.1 + 0.2);

    // 1.005 is a little below 1.005, so it rounds down; 2.675 is below too
    printf("%.2f %.2f %.2f\n", 1.005, 2.675, 1.115);

    // a tie (the number is exactly in the middle) goes to the even digit
    printf("%.0f %.0f %.0f %.0f %.0f\n", 0.5, 1.5, 2.5, 3.5, 4.5);
    printf("%.2f %.2f %.2f\n", 0.125, 0.375, 0.625);

    // large numbers: every digit, not just 17
    printf("%.0f\n", 1e22);
    printf("%.0f\n", 9007199254740993.0);        // 2^53 + 1 is not a double: it is 2^53
    printf("%.0f\n", 1e23);                      // not 1 followed by 23 zeros

    // tiny numbers: the smallest double has 1074 digits after the point; %e and %g are short
    printf("%e\n", 5e-324);
    printf("%g %v\n", 5e-324, 5e-324);
    printf("%e %v\n", 1.7976931348623157e308, 1.7976931348623157e308);
    printf("%.15f\n", 1e-15);

    // more digits than a double has: the rest is the exact value, then zeros
    printf("%.25g\n", 1.0 / 3.0);
    printf("%.3f\n", 2.0 / 3.0);
    return 0;
}
