// foreach over your own class: count() and get(i)
import collections;

class Squares {
public:
    int n;
    Squares(int count) { n = count; }
    int count() { return n; }                      // how many elements ...
    int get(int i) { return i * i; }               // ... and element number i
}

int main() {
    Squares sq(6);
    foreach (int s in sq) printf("%d ", s);
    println("");

    collections.IntList* list = new collections.IntList();   // size() and get(): works without changes
    foreach (int n in 1..=5) list->push(n * 11);
    int total = 0;
    foreach (int i, int v in list) { printf("list[%d] = %d\n", i, v); total += v; }
    printf("total %d\n", total);

    collections.StrList* names = new collections.StrList();
    names->push("Ada"); names->push("Grace"); names->push("Linus");
    foreach (char* name in rev names) println(name);
    return 0;
}
