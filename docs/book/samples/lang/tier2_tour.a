// The new language features together in one program
//   ac examples/tier2.a -o tier2 && ./tier2

abstract class Shape {
public:
    static int made;                             // shared by all shapes
    char* name;
    Shape(char* n) { name = n; made++; }
    abstract int area();                         // every concrete shape provides it
    virtual int sides() { return 0; }
    static char* describe(Shape* s) { return s->sides() > 0 ? "polygon" : "round"; }
}

class Rect : Shape {
public:
    int w; int h;
    Rect(int a, int b) { super("rect"); w = a; h = b; }
    override int area() { return w * h; }
    override final int sides() { return 4; }
}

class Disc : Shape {
public:
    int r;
    Disc(int x) { super("disc"); r = x; }
    override int area() { return 3 * r * r; }
}

int command(char* word) {
    switch (word) {                              // a switch on text; null matches nothing
        case "add", "plus": return 1;
        case "mul": return 2;
        case "quit", "exit": return 9;
        default: return 0;
    }
}

int main() {
    Shape* shapes[3];
    shapes[0] = new Rect(3, 4);
    shapes[1] = new Disc(2);
    shapes[2] = new Rect(5, 5);

    int total = 0;
    foreach (int i, Shape* s in shapes) {        // the index and the element
        printf("%d: %s, area %d, %s", i, s->name, s->area(), Shape.describe(s));
        if (s is Rect) { Rect* r = s as Rect; printf(", %d x %d", r->w, r->h); }
        println("");
        total += s->area();
    }
    printf("%d shapes, total area %d\n", Shape.made, total);

    foreach (char* w in (char*[]){"add", "plus", "mul", "exit", "nothing"}) {
        printf("%s -> %d\n", w, command(w));
    }

    // ranges, counting down, text, and a labeled break out of two loops
    foreach (int i in rev 1..=3) { printInt(i); print(" "); }
    foreach (char c in "abc") { printChar(c - 32); }
    println("");
    found: foreach (int a in 1..10) {
        foreach (int b in a..10) {
            if (a * b == 42) { printf("%d x %d = 42\n", a, b); break found; }
        }
    }

    // short-circuit assignment: the right side runs only when it is needed
    char* name = null;
    name ??= "anonymous";
    int cache = 0;
    cache ||= 100;
    cache ||= 200;
    printf("%s %d\n", name, cache);
    return 0;
}
