// The basic output functions
int main() {
    print("no newline, ");
    println("with newline");
    printInt(42);
    printChar(' ');
    printlnInt(-7);
    printChar('A');
    printChar(10);                  // 10 is the newline character
    printBool(3 > 2);
    println("");
    printHex(255);
    println("");
    printRepeat('-', 12);
    println("");
    eprintln("this line goes to standard error");
    return 0;
}
