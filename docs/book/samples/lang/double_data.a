// double in structs, arrays, globals, parameters and results
struct Vec { double x; double y; }

double scale = 1.5;                            // a global with a double literal
double samples[4];

double dot(Vec a, Vec b) {                     // parameters: doubles and structs of doubles
    return a.x * b.x + a.y * b.y;
}

Vec scaled(Vec v, double k) {                  // results too
    Vec r;
    r.x = v.x * k;
    r.y = v.y * k;
    return r;
}

double average(double* values, int n) {        // a pointer to doubles steps by 8 bytes
    double sum = 0;
    for (int i = 0; i < n; i++) sum += values[i];
    return sum / n;
}

int main() {
    Vec v;
    v.x = 3;                                   // an int is converted on assignment
    v.y = 0.5;
    Vec w = scaled(v, scale);
    printlnDouble(w.x);
    printlnDouble(w.y);
    printlnDouble(dot(v, w));

    for (int i = 0; i < 4; i++) {
        samples[i] = i * 0.25;
    }
    printlnDouble(average(samples, 4));
    printf("sizeof(Vec) = %d\n", sizeof(Vec));
    return 0;
}
