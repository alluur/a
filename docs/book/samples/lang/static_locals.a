// static: a local that keeps its value, and a function that stays in its file
static int helper() {                   // the same as private: only this file can call it
    return 1;
}

int next() {
    static int calls;                   // zero at the start, kept between calls
    static int start = 100;             // a constant initializer is applied once
    calls++;
    return start + calls;
}

int histogram(int value) {
    static int counts[4];               // static arrays are fine
    counts[value]++;
    return counts[value];
}

int main() {
    printf("%d %d %d\n", next(), next(), next());
    histogram(2);
    histogram(2);
    printf("value 2 seen %d times, value 1 seen %d time\n", histogram(2), histogram(1));
    printf("%d\n", helper());
    return 0;
}
