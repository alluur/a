// virtual methods: the object's real class decides which method runs
class Animal {
    protected int legs;
    public Animal(int l) { legs = l; }
    public virtual int speak() { return 1; }
    public int describe() { return speak() * 1000 + legs; }   // calls the right speak()
}

class Dog : Animal {
    public Dog() { super(4); }
    public int speak() { return 2; }              // overrides Animal.speak
}

class Puppy : Dog {
    public int speak() { return super.speak() + 10; }
}

int main() {
    Animal* list[3];
    list[0] = new Animal(0);
    list[1] = new Dog();
    list[2] = new Puppy();                        // a class without a constructor uses the base one
    for (int i = 0; i < 3; i++) {
        printf("describe() = %d\n", list[i]->describe());
    }
    Dog local();
    printf("local Dog: %d\n", local.speak());
    return 0;
}
