// is and as: ask an object for its class
class Animal {
public:
    virtual char* sound() { return "..."; }
}
class Dog : Animal {
public:
    int tricks;
    Dog(int t) { tricks = t; }
    override char* sound() { return "woof"; }
}
class Puppy : Dog {
public:
    Puppy() { super(1); }
    override char* sound() { return "yip"; }
}
class Cat : Animal {
public:
    override char* sound() { return "meow"; }
}

void meet(Animal* a) {
    printf("%-5s", a == null ? "null" : a->sound());
    printf(" is Dog: %d, is Puppy: %d, is Cat: %d", a is Dog, a is Puppy, a is Cat);
    Dog* d = a as Dog;                             // the same pointer, or null when it is no Dog
    if (d != null) printf(", knows %d trick(s)", d->tricks);
    println("");
}

int main() {
    Animal* zoo[4];
    zoo[0] = new Animal();
    zoo[1] = new Dog(3);
    zoo[2] = new Puppy();
    zoo[3] = new Cat();
    foreach (Animal* a in zoo) meet(a);
    meet(null);                                    // null is nothing: is gives 0, as gives null
    return 0;
}
