// Global variables: initialised with constant expressions, or zero
const BASE = 10;
int total;                          // zero, lives in the zero-filled bss area
int start = BASE * 4 + 2;           // a constant expression
char* label = "global";
int table[4] = {1, 2, 3};
int lookup[BASE];

void add(int n) {
    total += n;                     // every function sees the same variable
}

int main() {
    add(5);
    add(6);
    printf("total=%d start=%d label=%s\n", total, start, label);
    printf("table: %d %d %d %d, lookup has %d slots\n", table[0], table[1], table[2], table[3], sizeof(lookup) / 8);
    return 0;
}
