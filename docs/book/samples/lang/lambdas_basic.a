// Lambdas: anonymous functions without captures
import algo;

int main() {
    func twice = (int x) => x * 2;
    func add = (a, b) => a + b;              // parameters without a type are int
    func inc = x => x + 1;
    func sum = (int a, int b) => { int s = 0; for (int i = a; i <= b; i++) s += i; return s; };
    printf("%d %d %d %d\n", twice(21), add(2, 3), inc(9), sum(1, 10));
    printf("called where written: %d\n", ((int a) => a + 100)(5));

    int items[5] = {42, 7, 19, 3, 25};
    algo.sortBy(items, 5, (int a, int b) => a - b);      // where a library function wants a func
    foreach (int v in items) printf("%d ", v);
    println("");
    algo.sortBy(items, 5, (int a, int b) => b - a);
    foreach (int v in items) printf("%d ", v);
    println("");
    return 0;
}
