// Without a letter, the type of the value chooses the conversion
int main() {
    int n = 65;
    double d = 0.1 + 0.2;
    char* s = "text";
    bool ok = true;
    char c = 'A';
    uint64 big = 18446744073709551615;
    uint8 b = 66;
    int8 small = -5;

    println($"int {n}, double {d}, text {s}, bool {ok}, char {c}, uint64 {big}");

    // surprises that follow from the types of the language
    println($"uint8 prints as a character: {b}, as a number: {b:d}");
    println($"a character literal is an int: {'A'}, with c: {'A':c}");
    println($"int8 is a number: {small}");
    println($"a comparison is an int: {n > 3}, a condition gives words: {n > 3 ? "yes" : "no"}");
    println($"a bool as a number: {ok:d}, negated: {!ok}");
    println($"null text: {(char*) 0}");

    // an integer with a floating point letter is converted first
    println($"{n:.2f} {n:e} {n:8.1f}| {7:v}");
    println($"{big} {big:.0f} {big:x}");

    // a double needs a floating point letter (or none): {d:d} is a compile error
    println($"{d} {d:v} {d:.20f}");
    return 0;
}
