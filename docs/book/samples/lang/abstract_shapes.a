// Abstract classes, override and final
abstract class Shape {
public:
    char* name;
    Shape(char* n) { name = n; }
    abstract int area();                           // no body: every concrete shape has to provide it
    virtual int sides() = 0;                       // the C++ spelling of the same thing
    int ratio() { return area() * 100 / sides(); } // a method of the base class may call the abstract ones
}

class Rect : Shape {
public:
    int w; int h;
    Rect(int a, int b) { super("rect"); w = a; h = b; }
    override int area() { return w * h; }          // checked: Shape has a virtual int area()
    override final int sides() { return 4; }       // and nobody may override this one again
}

final class Square : Rect {                        // a final class cannot be a base class
public:
    Square(int s) { super(s, s); name = "square"; }
}

class Triangle : Shape {
public:
    int base; int height;
    Triangle(int b, int h) { super("triangle"); base = b; height = h; }
    override int area() { return base * height / 2; }
    override int sides() { return 3; }
}

int main() {
    Shape* shapes[3];                              // pointers to the abstract class are fine
    shapes[0] = new Rect(3, 4);
    shapes[1] = new Square(5);
    shapes[2] = new Triangle(6, 5);
    foreach (Shape* s in shapes) {
        printf("%-8s area %2d, %d sides, ratio %d\n", s->name, s->area(), s->sides(), s->ratio());
    }
    return 0;
}
