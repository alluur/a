// A class with private data, a constructor and methods
class Account {
    private int balance;                          // only Account's own methods can touch this
    public char* owner;

    public Account(char* owner, int opening) {    // the constructor has the name of the class
        this.owner = owner;                       // 'this' is a pointer to the object
        balance = opening;                        // fields can also be used without 'this'
    }

    public void deposit(int amount) {
        balance += amount;
    }

    public bool withdraw(int amount) {
        if (amount > balance) return false;
        balance -= amount;
        return true;
    }

    public int get() { return balance; }
}

int main() {
    Account a("Ann", 100);                        // an object on the stack
    a.deposit(50);
    printf("%s: %d\n", a.owner, a.get());
    printf("withdraw 500: %d\n", a.withdraw(500));
    printf("withdraw 30: %d\n", a.withdraw(30));

    Account* b = new Account("Bob", 10);          // an object on the heap: new returns a pointer
    b->deposit(5);
    printf("%s: %d\n", b->owner, b->get());
    // a.balance = 1000;                          // error: member is private to its class
    return 0;
}
