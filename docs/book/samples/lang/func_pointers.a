// func: a pointer to a function
int twice(int x) { return x * 2; }
int square(int x) { return x * x; }

int apply(func f, int v) {
    return f(v);                                 // calling a func variable calls the function
}

struct Command {
    char* name;
    func run;
}

int main() {
    func f = twice;                              // the name of a function is a func value
    printf("%d\n", f(21));
    printf("%d\n", apply(&square, 9));           // &name works as well

    func table[2];
    table[0] = twice;
    table[1] = square;
    for (int i = 0; i < 2; i++) {
        printf("table[%d](7) = %d\n", i, table[i](7));
    }

    Command cmds[2];
    cmds[0].name = "double";  cmds[0].run = twice;
    cmds[1].name = "square";  cmds[1].run = square;
    for (int i = 0; i < 2; i++) {
        printf("%s 5 = %d\n", cmds[i].name, cmds[i].run(5));
    }
    printf("same function: %d\n", f == twice);
    return 0;
}
