// What a lambda can see: globals, constants and its own variables, but not the locals around it
const LIMIT = 100;
int base = 1000;
func fact;                                    // a global, so that the lambda can call itself

int main() {
    int local = 7;

    // globals and constants are visible
    func plus = (int x) => x + base + LIMIT;
    println($"{plus(1)}");

    // a local of the lambda hides a local of the same name outside
    func shadow = (int x) => { int local = x * 2; return local; };
    println($"{shadow(4)} {local}");

    // a static local belongs to the lambda and keeps its value between calls
    func counter = () => { static int n = 0; n++; return n; };
    counter();
    counter();
    println($"third call: {counter()}");

    // the local of main is not visible: pass it as a parameter instead
    func scaled = (int x, int factor) => x * factor;
    println($"{scaled(6, local)}");

    // recursion works through a global func variable
    fact = (int n) => n <= 1 ? 1 : n * fact(n - 1);
    println($"{fact(10)}");

    // a call through func gives an int: a double result arrives as its 64 bits
    func half = (double x) -> double => x * 0.5;
    double ok = __dbl(half(5.0));
    double wrong = half(5.0);
    println($"{ok} {wrong}");
    return 0;
}
