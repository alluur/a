// Designated initializers pick fields and elements by name or index
struct Point { int x; int y; }
struct Box { Point lo; Point hi; int tag[3]; char* name; }

int main() {
    Point p = {.y = 5, .x = 3};                           // any order
    Box b = {.hi = {7, 8}, .tag = {1, 2, 3}, .name = "box"};
    int table[8] = {[1] = 10, [4] = 40, 50};              // 50 goes to index 5
    printf("%d %d\n", p.x, p.y);
    printf("lo=(%d,%d) hi=(%d,%d) tag=%d%d%d %s\n", b.lo.x, b.lo.y, b.hi.x, b.hi.y, b.tag[0], b.tag[1], b.tag[2], b.name);
    for (int i = 0; i < 8; i++) {
        printf("%d ", table[i]);
    }
    println("");
    return 0;
}
