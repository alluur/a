// Writing and reading whole files
int main() {
    if (!writeFile("notes.txt", "alpha\nbeta\ngamma\n")) {
        println("cannot write the file");
        return 1;
    }
    printf("exists: %d\n", fileExists("notes.txt"));

    char* text = readFile("notes.txt");               // null if the file cannot be opened
    if (text == null) {
        return 1;
    }
    printf("%d bytes\n", strlen(text));
    print(text);

    printf("missing file: %d\n", readFile("no/such/file") == null);

    fileDelete("notes.txt");
    printf("exists after delete: %d\n", fileExists("notes.txt"));
    return 0;
}
