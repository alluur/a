// Compound assignment: a op= b means a = a op b (a is evaluated once)
int main() {
    int a = 10;
    a += 5;   printf("%d\n", a);
    a -= 3;   printf("%d\n", a);
    a *= 2;   printf("%d\n", a);
    a /= 5;   printf("%d\n", a);
    a %= 3;   printf("%d\n", a);
    a <<= 4;  printf("%d\n", a);
    a >>= 1;  printf("%d\n", a);
    a |= 5;   printf("%d\n", a);
    a &= 12;  printf("%d\n", a);
    a ^= 7;   printf("%d\n", a);

    int calls = 0;
    int table[3] = {1, 2, 3};
    table[calls++] += 100;            // the index is computed once
    printf("%d %d, calls = %d\n", table[0], table[1], calls);
    return 0;
}
