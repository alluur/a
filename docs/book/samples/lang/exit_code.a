// The value returned from main (or passed to exit) is the exit code of the process
// book: exit=3
void fail(char* why) {
    eprintln(why);                 // diagnostics go to standard error
    exit(3);                       // ends the program at once, from any function
    println("never printed");
}

int main() {
    println("checking the input ...");
    int problems = 1;
    if (problems > 0) {
        fail("found a problem");
    }
    println("all fine");
    return 0;                      // 0 means success
}
