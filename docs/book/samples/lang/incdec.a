// ++ and -- before and after a variable
int main() {
    int i = 5;
    printf("%d\n", i++);              // the old value, then add one
    printf("%d\n", i);
    printf("%d\n", ++i);              // add one, then the new value
    printf("%d\n", i--);
    printf("%d\n", --i);

    int data[4] = {10, 20, 30, 40};
    int k = 0;
    data[k++] = 11;                   // uses data[0], then k becomes 1
    data[k++] += 5;                   // data[1] += 5
    printf("%d %d %d, k=%d\n", data[0], data[1], data[2], k);

    char text[8] = "abc";
    char* p = text;
    while (*p) {
        printf("%c", *p++);           // read the character, then step to the next
    }
    println("");
    return 0;
}
