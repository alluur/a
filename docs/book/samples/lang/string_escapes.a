// String literals and their escape sequences
int main() {
    println("tab:\tseparated\tcolumns");
    println("quotes: \"double\" and 'single' and a backslash \\");
    println("hex escape: \x48\x69");
    print("two lines:\nsecond line\n");
    println("adjacent " "literals " "are joined");
    char* paragraph = "a long text can be "
                 "split over several lines";
    println(paragraph);

    // escapes are single characters: look at their values
    char* codes = "\n\t\r\0\e\\";
    for (int i = 0; i < 6; i++) {
        printf("%d ", codes[i]);
    }
    println("");

    char* text = "strings end with a zero byte";
    printf("%d characters, last byte %d\n", strlen(text), text[strlen(text)]);

    char editable[8] = "abc";           // an array filled from a literal is your own copy
    editable[0] = 'X';
    println(editable);
    return 0;
}
