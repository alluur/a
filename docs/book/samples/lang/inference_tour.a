// All together: var, a tuple result, a lambda and an interpolated report
import algo;

// minimum, maximum and mean in one call
(int, int, double) stats(int* v, int n) {
    int lo = v[0];
    int hi = v[0];
    int sum = 0;
    foreach (int x in v, n) {
        if (x < lo) lo = x;
        if (x > hi) hi = x;
        sum += x;
    }
    return (lo, hi, sum / (double) n);
}

int main() {
    int scores[6] = {72, 95, 61, 88, 79, 95};
    var (lo, hi, mean) = stats(scores, 6);
    println($"min {lo}, max {hi}, mean {mean:.2f}");

    // the best score first
    algo.sortBy(scores, 6, (a, b) => b - a);

    println("rank  score  of best  bar");
    foreach (var i, var s in scores) {
        var percent = s * 100.0 / hi;
        print($"{i + 1:4}  {s:5}  {percent:6.1f}%  ");
        printRepeat('#', (s - lo) / 5 + 1);
        println("");
    }

    var above = 0;
    foreach (var s in scores) {
        if (s > mean) above++;
    }
    println($"{above} of {sizeof(scores) / sizeof(int)} scores are above the mean");
    return 0;
}
