// sizeof: the size in bytes of a type, a variable or an expression
struct Point { int x; int y; }
struct Mixed { char tag; int value; char flag; }

int main() {
    printf("int %d, char %d, bool %d, int* %d, char** %d\n", sizeof(int), sizeof(char), sizeof(bool), sizeof(int*), sizeof(char**));
    printf("Point %d, Mixed %d\n", sizeof(Point), sizeof(Mixed));      // Mixed is padded for alignment
    int numbers[10];
    char text[32];
    printf("numbers %d, text %d\n", sizeof(numbers), sizeof text);
    printf("elements: %d\n", sizeof(numbers) / sizeof(numbers[0]));
    int x = 5;
    printf("sizeof(x + 1) = %d\n", sizeof(x + 1));                    // the expression is not evaluated
    printf("x is still %d\n", x);
    return 0;
}
