// String interpolation: $"text {expression} text"
struct Item { char* name; int qty; double price; }

class Greeter {
public:
    char* who;
    Greeter(char* w) { who = w; }
    char* hello() { return $"hello, {who}!"; }    // the result is a char*
}

int twice(int n) { return n * 2; }
char* plural(int n) { return n == 1 ? "item" : "items"; }

int main() {
    int x = 42;
    double pi = 3.14159265358979;
    char* name = "bob";
    println($"x = {x}, pi = {pi}, name = {name}");

    // any expression: arithmetic, calls, members, indexing, conditions
    int arr[3] = {10, 20, 30};
    Item it;
    it.name = "pen";
    it.qty = 3;
    it.price = 1.5;
    println($"{x + 1} {twice(x)} {arr[1]} {it.name} {it.qty * it.price} {x > 40 ? "big" : "small"}");
    println($"{it.qty} {plural(it.qty)}, {1} {plural(1)}");

    // a string inside the braces, and an interpolated string inside the braces
    println($"{name} has {name == null ? "nothing" : "a name"}, {$"inner {x}"}");

    // {{ and }} are braces; a % is just a percent sign; the usual escapes work
    println($"{{x}} is {x}, 100% sure, quote[\"] backslash[\\]");

    // the value is a char*: keep it, pass it, return it
    char* s = $"{x}-{x}";
    println(s);
    Greeter g("world");
    println(g.hello());
    printf("%s|%s\n", $"a{x}", $"b{x}");

    // the same formatter as format(): the same characters
    char buf[64];
    format(buf, 64, "x = %d, pi = %.3f", x, pi);
    println(buf);
    println($"x = {x}, pi = {pi:.3f}");
    return 0;
}
