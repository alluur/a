// if, else if and else
char* grade(int score) {
    if (score >= 90) {
        return "A";
    } else if (score >= 80) {
        return "B";
    } else if (score >= 70) {
        return "C";
    } else {
        return "F";
    }
}

int main() {
    int scores[5] = {95, 83, 70, 69, 0};
    for (int i = 0; i < 5; i++) {
        printf("%3d -> %s\n", scores[i], grade(scores[i]));
    }
    int x = 4;
    if (x > 3) println("a single statement needs no braces");
    if (x) println("a number is a condition: non-zero is true");
    return 0;
}
