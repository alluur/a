// Initializer lists for arrays and structs
struct Point { int x; int y; }
struct Line { Point from; Point to; char label[4]; }

int primes[6] = {2, 3, 5, 7, 11};               // a global list: constants only

int main() {
    int a[5] = {1, 2, 3};                       // the rest is 0
    Point p = {3, 4};
    Line l = {{1, 2}, {3, 4}, "ab"};            // nested lists and a char array from a string
    char name[16] = "Aytict";
    char* words[3] = {"alpha", "beta", "gamma"};
    int local = 10;
    int computed[3] = {local, local * 2, local + 1,};    // locals may use any expression; a trailing comma is fine

    printf("%d %d %d %d\n", a[0], a[2], a[3], a[4]);
    printf("(%d,%d) -> (%d,%d) %s\n", l.from.x, l.from.y, l.to.x, l.to.y, l.label);
    printf("%s %s %d\n", name, words[1], p.x + p.y);
    printf("%d %d %d\n", computed[0], computed[1], computed[2]);
    printf("%d %d\n", primes[4], primes[5]);
    return 0;
}
