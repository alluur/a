// C++ style access labels: public: and private:
class Shape {
public:
    int id;
    Shape(int id) { this.id = id; secret = id * 100; }
    int reveal() { return secret + helper(); }
private:
    int secret;
    int helper() { return 1; }                    // a private method: callable inside the class only
}

struct Open {                                     // a struct is public by default ...
    int visible;
private:
    int hidden;                                   // ... unless a member says private
}

int main() {
    Shape s(7);
    printf("id %d, reveal %d\n", s.id, s.reveal());
    Open o;
    o.visible = 1;
    printf("%d\n", o.visible);
    return 0;
}
