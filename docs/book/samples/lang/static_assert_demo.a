// static_assert: facts the compiler checks for you
struct Header {
    uint32 magic;
    uint16 version;
    uint16 flags;
}

enum Color { Red, Green, Blue }
const SLOTS = 16;

static_assert(sizeof(Header) == 8, "the header is sent over the wire as 8 bytes");   // at top level
static_assert(Color.count == 3);                                                      // the message is optional

class Table {
public:
    static_assert(SLOTS % 4 == 0, "SLOTS must be a multiple of 4");                  // inside a class
    int values[SLOTS];
}

int main() {
    static_assert(__ARCH >= 0 && __ARCH <= 3);                                       // inside a function
    printf("Header takes %d bytes, Color has %d members\n", sizeof(Header), Color.count);
    printf("a Table takes %d bytes (%d slots)\n", sizeof(Table), SLOTS);
    return 0;
}
