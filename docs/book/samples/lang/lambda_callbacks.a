// Lambdas as callbacks of library functions
import algo;
import ds;
import cstdlib;

int main() {
    // algo.sortBy takes a compare function: negative, 0 or positive
    int a[6] = {5, 2, 9, 1, 7, 3};
    algo.sortBy(a, 6, (int x, int y) => x - y);
    foreach (var v in a) print($"{v} ");
    println("(ascending)");
    algo.sortBy(a, 6, (x, y) => y - x);
    foreach (var v in a) print($"{v} ");
    println("(descending)");

    // sort by the last digit: the order is whatever the lambda says
    int b[5] = {19, 22, 31, 40, 58};
    algo.sortBy(b, 5, (x, y) => x % 10 - y % 10);
    foreach (var v in b) print($"{v} ");
    println("(by last digit)");

    // a priority queue that gives the largest number first
    ds.BinaryHeap* heap = new ds.BinaryHeap((x, y) => y - x);
    heap->push(3); heap->push(9); heap->push(1); heap->push(7);
    int first = heap->pop();
    int second = heap->pop();
    int third = heap->pop();
    println($"heap: {first} {second} {third}");

    // the C library qsort passes pointers to the elements, as char*
    int c[5] = {50, 10, 40, 30, 20};
    qsort((char*) c, 5, sizeof(int), (char* p, char* q) => *(int*) p - *(int*) q);
    foreach (var v in c) print($"{v} ");
    println("(qsort)");

    // a lambda cannot capture, so a callback with a context argument gets its state there
    ds.OrderedMap* m = new ds.OrderedMap();
    m->put(10, 100);
    m->put(20, 200);
    m->put(30, 300);
    int total = 0;
    m->forEach((key, value, ctx) => { *(int*) ctx += value; return 0; }, (int) &total);
    println($"sum of the values: {total}");
    return 0;
}
