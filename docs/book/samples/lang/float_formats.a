// printf with doubles: %f %e %g %v, precision, width and flags
int main() {
    double x = 1234.5678;
    printf("%%f   [%f]\n", x);                 // 6 digits after the point by default
    printf("%%e   [%e]\n", x);                 // scientific, 6 digits after the point
    printf("%%g   [%g]\n", x);                 // 6 significant digits, no trailing zeros
    printf("%%v   [%v]\n", x);                 // the shortest text that reads back as x

    // precision: digits after the point for f and e, significant digits for g
    printf("%.0f [%.2f] [%.5f]\n", x, x, x);
    printf("[%.1e] [%.3E]\n", x, x);
    printf("[%.2g] [%.10g]\n", x, x);

    // width, left alignment, sign, zero fill, space
    printf("[%12.3f] [%-12.3f] [%+.1f] [%012.3f] [% .1f]\n", x, x, x, x, x);

    // %g switches to the e style when the exponent is below -4 or not below the precision
    printf("%g %g %g %g %g\n", 100000.0, 1000000.0, 0.0001, 0.00001, 123456789.0);

    // %v: like Python's repr, no forced ".0", fixed notation for exponents -4 to 15
    printf("%v %v %v %v %v %v\n", 0.1, 100.0, 1e15, 1e16, 0.0001, 0.00001);
    printf("%v %v\n", 0.1 + 0.2, 1.0 / 3.0);

    // a double can be any expression, a variable, or the result of a function
    double celsius = 21.5;
    printf("%.1f C = %.1f F\n", celsius, celsius * 9 / 5 + 32);
    return 0;
}
