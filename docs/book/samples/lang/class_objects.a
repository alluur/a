// Creating objects: with parentheses the constructor runs, without them the object is only zeroed
class Counter {
    public int value;
    private int step;

    public Counter(int start = 1, int step = 1) {     // default values work for constructors too
        value = start;
        this.step = step;
    }
    public void tick() { value += step; }
}

class Plain {                                         // no constructor: always zeroed
    public int a;
    public char* text;
}

int main() {
    Counter c();                                      // constructor with all defaults
    Counter d(10, 5);
    Counter* e = new Counter(100);                    // new always runs the constructor
    Counter zero;                                     // no parentheses: zeroed, constructor not run
    c.tick();
    d.tick();
    e->tick();
    zero.tick();
    printf("%d %d %d %d\n", c.value, d.value, e->value, zero.value);

    Plain p;
    Plain* q = new Plain();
    printf("%d %d %d\n", p.a, p.text == null, q->a);
    return 0;
}
