// for: initialise; test; step - and each of the three parts may be empty
int main() {
    for (int i = 0; i < 5; i++) {
        printf("%d ", i);
    }
    println("");

    for (int i = 10; i > 0; i -= 3) {            // any step expression
        printf("%d ", i);
    }
    println("");

    int j = 0;
    for (; j < 3; ) {                            // empty parts
        j++;
    }
    printf("j = %d\n", j);

    for (int a = 0, b = 10; a < b; a += 3, b -= 3) {   // the comma operator runs two steps
        printf("(%d,%d) ", a, b);
    }
    println("");

    int count = 0;
    for (;;) {                                   // an infinite loop, left with break
        count++;
        if (count == 4) break;
    }
    printf("left after %d rounds\n", count);
    return 0;
}
