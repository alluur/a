// setjmp and longjmp: a non-local jump, the basis for error handling without return codes
int env[4];                                      // the buffer holds the saved position

void fail(int code) {
    printf("failing with code %d\n", code);
    longjmp(env, code);                          // jump back to where setjmp was called
}

void deep(int level) {
    if (level == 3) fail(7);
    deep(level + 1);
    println("not reached");
}

int main() {
    int r = setjmp(env);                         // returns 0 the first time ...
    if (r == 0) {
        println("first pass");
        deep(0);
    } else {
        printf("back from longjmp, setjmp returned %d\n", r);   // ... and the code afterwards
    }

    int tries = 0;
    int e = setjmp(env);
    tries++;
    if (tries < 3) longjmp(env, 0);              // a value of 0 becomes 1
    printf("tries %d, last value %d\n", tries, e);
    return 0;
}
