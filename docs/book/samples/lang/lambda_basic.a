// Lambdas: anonymous functions that are values of the type func
int apply(func f, int x) {
    return f(x);
}

int main() {
    // an expression body: its value is the result
    func twice = (int x) => x * 2;
    println($"{twice(21)}");

    // parameters without a type are int; one parameter needs no parentheses
    func add = (a, b) => a + b;
    func inc = x => x + 1;
    func answer = () => 42;
    println($"{add(3, 4)} {inc(9)} {answer()}");

    // a block body uses return
    func sumTo = (int n) => {
        int s = 0;
        for (int i = 1; i <= n; i++) s += i;
        return s;
    };
    println($"{sumTo(100)}");

    // a lambda can be written where it is passed, or called where it is written
    println($"{apply(x => x * x, 12)} {((int a) => a + 100)(5)}");

    // lambdas are values: keep them in a table, choose one at run time
    func table[3];
    table[0] = x => x + 1;
    table[1] = x => x * 10;
    table[2] = twice;
    for (var i = 0; i < 3; i++) {
        print($"{table[i](i + 4)} ");
    }
    println("");

    // the result is an int unless you say otherwise with ->
    func isOdd = (int x) -> bool => x % 2 == 1;
    func low = (int x) -> uint8 => x + 250;
    println($"{isOdd(3)} {isOdd(4)} {low(10)}");

    // a function can return a lambda
    func mk = () => (int q) => q * 7;
    func times7 = mk();
    println($"{times7(6)}");
    return 0;
}
