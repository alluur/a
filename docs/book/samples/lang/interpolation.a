// String interpolation: $"text {expression:spec}"
int square(int v) { return v * v; }

int main() {
    int x = 42;
    double pi = 3.14159265;
    char* name = "bob";
    bool ok = true;
    println($"x = {x}, pi = {pi:.3f}, name = {name:-8}|, hex = {x:#x}, braces {{ }}");
    println($"{name} has {x * 2} items; square(7) = {square(7)}; ok = {ok}");
    println($"[{x:6}] [{x:-6}] [{x:06}] [{pi:10.2f}] [{pi}]");
    char* s = $"{name}-{x}";                 // the result is a text, usable like any other
    printf("%s has %d characters\n", s, strlen(s));
    return 0;
}
