// Directories, existence checks and cleaning up
int main() {
    printf("make data: %d\n", makeDir("data"));
    printf("again: %d\n", makeDir("data"));           // false: it exists already
    writeFile("data/one.txt", "1");
    writeFile("data/two.txt", "22");
    printf("%s has %d bytes\n", "data/two.txt", strlen(readFile("data/two.txt")));
    printf("one: %d two: %d three: %d\n", fileExists("data/one.txt"),
           fileExists("data/two.txt"), fileExists("data/three.txt"));
    printf("delete one: %d\n", fileDelete("data/one.txt"));
    printf("delete one again: %d\n", fileDelete("data/one.txt"));
    fileDelete("data/two.txt");
    return 0;
}
