// Comparisons and logical operators always give 0 or 1
int main() {
    int a = 5;
    int b = 8;
    printf("%d %d %d %d %d %d\n", a < b, a <= b, a > b, a >= b, a == b, a != b);
    printf("%d %d %d\n", a > 1 && b > 1, a > 6 || b > 6, !(a > 6));
    printf("%d %d %d\n", 12 && 3, 0 || 7, !99);       // any non-zero value is true
    char* text = "hi";
    char* none = null;
    printf("%d %d\n", text != null, !none);           // pointers are conditions too
    if (a) { println("5 is true"); }
    if (!0) { println("0 is false"); }
    printf("three way: %d %d %d\n", 3 <=> 5, 5 <=> 5, 9 <=> 5);
    return 0;
}
