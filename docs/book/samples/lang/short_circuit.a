// && and || stop as soon as the answer is known
int calls = 0;

bool check(char* name, bool result) {
    printf("  checking %s\n", name);
    calls++;
    return result;
}

int main() {
    println("false && ...");
    bool a = check("left", false) && check("right", true);    // right is never evaluated
    println("true || ...");
    bool b = check("left", true) || check("right", false);    // the right side is skipped too
    printf("results %d %d after %d calls\n", a, b, calls);

    // the usual use: guard a risky test with a cheap one
    char* text = null;
    if (text != null && text[0] == 'x') {
        println("starts with x");
    } else {
        println("no text, and no crash");
    }
    return 0;
}
