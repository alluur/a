// inf, nan and negative zero
int main() {
    double zero = 0.0;
    double inf = 1.0 / zero;
    double nan = inf - inf;
    double negzero = -zero;

    printf("%f %f %f\n", inf, -inf, nan);
    printf("%e %g %v\n", inf, -inf, nan);
    printf("%F %E %G\n", inf, nan, -inf);

    // width and flags: the 0 flag does not fill inf and nan with zeros, as in C
    printf("[%8.2f] [%-8.2f] [%08.2f] [%+.1f]\n", inf, inf, inf, inf);

    // negative zero is a real value and keeps its sign
    printf("%f %e %g %v\n", negzero, negzero, negzero, negzero);
    printf("%.0f %.0f\n", -0.4, 0.4);
    printf("%d\n", negzero == zero);

    // the interpolated string agrees
    println($"{inf} {nan} {negzero} {inf:8.1f}|");

    // classify before you print, if the reader should see words
    println(isNaN(nan) ? "not a number" : "a number");
    println(isInf(inf) ? "infinite" : "finite");
    return 0;
}
