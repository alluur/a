// Importing the library modules that are built into the compiler
import collections;
import sort;
import strings;

int main() {
    collections.IntList* list = new collections.IntList();
    list->push(30);
    list->push(10);
    list->push(20);
    sort.sortInts(list->items(), list->size());
    for (int i = 0; i < list->size(); i++) {
        printf("%d ", list->get(i));
    }
    println("");

    collections.StrMap ages;                     // objects can live on the stack too
    ages.put("ann", 31);
    ages.put("bob", 27);
    printf("ann is %d, carl is %d\n", ages.get("ann", 0), ages.get("carl", -1));

    println(strings.padLeft("42", 6, '.'));      // a module function, qualified
    return 0;
}
