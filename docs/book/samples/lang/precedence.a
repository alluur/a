// Operator precedence: use parentheses when in doubt
int main() {
    printf("%d %d\n", 2 + 3 * 4, (2 + 3) * 4);
    printf("%d\n", 1 + 2 << 3);              // + binds tighter than <<  : (1 + 2) << 3
    printf("%d\n", 1 | 2 & 3);               // & binds tighter than |
    printf("%d\n", 6 & 3 == 3);              // == binds tighter than & : 6 & (3 == 3)
    printf("%d\n", (6 & 3) == 2);
    printf("%d\n", 10 - 4 - 3);              // left to right
    int a, b, c;
    a = b = c = 7;                           // assignment is right to left
    printf("%d %d %d\n", a, b, c);
    printf("%d\n", !0 + !5);
    printf("%d\n", - -3 * 2);
    printf("%d\n", 1 < 2 == 1);              // comparisons give 0 or 1
    return 0;
}
