// double: IEEE 754 binary64 arithmetic, done in software
import dmath;

int main() {
    double price = 19.99;
    double total = price * 3;                  // an int in a mixed expression becomes a double
    printlnDouble(total);
    printlnDouble(0.1 + 0.2);                  // the classic binary rounding
    printlnDouble(10 / 4);                     // integer division happens first: 2
    printlnDouble(10.0 / 4);

    int whole = (int) total;                   // converting to int needs a cast and truncates
    printf("truncated: %d\n", whole);
    printf("compare: %d %d\n", price < total, total == 59.97);

    printlnDouble(dmath.sqrt(2));              // the dmath module has the maths functions
    printlnDouble(dmath.pow(2, 0.5) * dmath.PI);
    println(doubleToFixed(price, 1));          // text with a fixed number of decimals
    printlnDouble(parseDouble("2.5e3"));

    int bits = __bits(1.0);                    // the 64 raw bits of a double, as an int
    printf("bits of 1.0: %x\n", bits);
    printlnDouble(__dbl(bits + 1));            // and back: the next number after 1.0
    return 0;
}
