// Predefined macros and constants
int main() {
    printf("__A__ = %d\n", __A__);
    printf("__ARCH__ = %d (0 x64, 1 arm64, 2 riscv64, 3 loongarch64)\n", __ARCH__);
    printf("__OS__ = %d (0 Linux, 1 Windows, 2 Android)\n", __OS__);
    printf("this is line %d\n", __LINE__);
    printf("the file name ends with .a: %d\n", endsWith(__FILE__, ".a"));
    // __ARCH and __OS (without the underscores at the end) are constants of the language itself
    printf("%d %d\n", __ARCH == __ARCH__, __OS == __OS__);
    return 0;
}
