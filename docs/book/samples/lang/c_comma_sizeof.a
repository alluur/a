// More C syntax: the comma operator, sizeof of values, C integer words
int main() {
    int a = 0, b = 0;
    for (a = 0, b = 10; a < 3; a++, b--) { }       // two assignments in one part
    printf("a=%d b=%d\n", a, b);
    int c = (a = 5, a + 1);                        // the value of the last expression
    printf("c=%d\n", c);

    int values[7];
    char text[5];
    printf("%d %d %d\n", sizeof(values), sizeof values, sizeof(values) / sizeof(values[0]));
    printf("%d %d\n", sizeof(text), sizeof(c + 1));

    // C's integer words are accepted and all mean the 64-bit int (or the unsigned byte)
    short s = 2;
    long l = 5;
    unsigned u = 3;
    unsigned char uc = 200;
    long long ll = 4;
    unsigned long long int ull = 6;
    printf("%d\n", s + l + u + uc + ll + ull);
    printf("%d %d\n", sizeof(short), sizeof(unsigned char));

    char* msg = "Hello, "
                "adjacent "
                "strings";
    println(msg);
    return 0;
}
