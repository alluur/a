// A one-page tour: constants, enums, structs, classes, functions and control flow
const MAX = 10;
enum Color { Red, Green = 5, Blue }

struct Point { int x; int y; }          // struct members are public by default

class Stack {                            // class members are private by default
    private int data[16];
    private int top;
    public void push(int v) { data[top] = v; top++; }
    public int pop()        { top--; return data[top]; }
    public bool empty()     { return top == 0; }
}

int fib(int n) {                         // functions may be used before they are defined
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

int main() {
    int total = 0;
    for (int i = 0; i < MAX; i++) {
        if (i % 2 == 0 && i != 4) { total += fib(i); }
        else if (i == 4)          { continue; }
        else                      { total -= 1; }
    }
    Stack s;                             // objects live on the stack ...
    s.push(1);
    s.push(2);
    Point* p = new Point;                // ... or on the heap
    p->x = s.pop();
    p->y = Color.Blue;
    print("total = ");   printlnInt(total);
    print("p = (");      printInt(p->x);  print(", ");  printInt(p->y);  println(")");
    switch (total % 3) {
        case 0:  println("divisible by three"); break;
        case 1:  println("remainder one");      break;
        default: println("remainder two");
    }
    return 0;
}
