// LU, Cholesky and QR of one matrix, and how to check them
import matrix;

void show(char* name, matrix.Matrix* m) {
    printf("%s\n", name);
    for (int i = 0; i < m->rows; i++) {
        printf(" ");
        for (int j = 0; j < m->cols; j++) { printf(" %8.4f", m->get(i, j)); }
        printf("\n");
    }
}

// the largest |a - b| over all entries: how far two matrices are apart
double gap(matrix.Matrix* a, matrix.Matrix* b) {
    double w = 0.0;
    for (int i = 0; i < a->rows * a->cols; i++) {
        double d = a->d[i] - b->d[i];
        if (d < 0.0) { d = -d; }
        if (d > w) { w = d; }
    }
    return w;
}

int main() {
    double v[9] = {1, 2, 1,  2, 5, 3,  1, 3, 6};      // symmetric and positive definite; the 2 below the 1 forces a row swap
    matrix.Matrix a = matrix.fromArray(v, 3, 3);

    // LU with partial pivoting: P A = L U
    matrix.LU f(&a);
    matrix.Matrix l = f.lower();
    matrix.Matrix u = f.upper();
    matrix.Matrix p = f.permutation();
    show("L", &l);
    show("U", &u);
    show("P (row i of P A is row k of A where P[i][k] = 1)", &p);
    matrix.Matrix pa = p * a;
    matrix.Matrix lu = l * u;
    printf("det %.4f, P A = L U: gap below 1e-12 %d\n", f.det(), gap(&pa, &lu) < 1.0e-12);
    matrix.Matrix inv = f.inverse();
    matrix.Matrix e = a * inv;
    matrix.Matrix id = matrix.identity(3);
    printf("A * inverse = I: gap below 1e-12 %d\n", gap(&e, &id) < 1.0e-12);

    // Cholesky: A = L L^T, half the work of LU, only for symmetric positive definite matrices
    matrix.Cholesky c(&a);
    matrix.Matrix lt = c.l.transpose();
    matrix.Matrix llt = c.l * lt;
    show("Cholesky factor", &c.l);
    printf("det %.4f, log det %.6f, L L^T = A: gap below 1e-12 %d\n", c.det(), c.logDet(), gap(&llt, &a) < 1.0e-12);
    double b[3] = {10, 20, 30};
    double x[3];
    c.solve(b, x);
    printf("A x = b gives x = (%.4f, %.4f, %.4f)\n", x[0], x[1], x[2]);

    // QR (Householder): A = Q R with orthonormal columns in Q and an upper triangular R
    matrix.QR q(&a);
    matrix.Matrix qm = q.q();
    matrix.Matrix r = q.r();
    matrix.Matrix qt = qm.transpose();
    matrix.Matrix qtq = qt * qm;
    matrix.Matrix qr = qm * r;
    show("R", &r);
    printf("Q^T Q = I: gap below 1e-12 %d, Q R = A: gap below 1e-12 %d\n", gap(&qtq, &id) < 1.0e-12, gap(&qr, &a) < 1.0e-12);

    // each object owns memory; dispose them all
    matrix.Matrix* all[14] = {&a, &l, &u, &p, &pa, &lu, &inv, &e, &id, &lt, &llt, &qm, &r, &qt};
    for (int i = 0; i < 14; i++) { all[i]->dispose(); }
    qtq.dispose();
    qr.dispose();
    f.dispose();
    c.dispose();
    q.dispose();
    return 0;
}
