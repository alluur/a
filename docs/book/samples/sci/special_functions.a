// Special functions: erf, gamma, beta and the incomplete gamma and beta functions
import stats;

int main() {
    // error function: erf(x) = 2/sqrt(pi) * integral of exp(-t^2) from 0 to x
    printf("erf(1) %.12f   erfc(5) %.6e   erfInv(0.5) %.12f\n", stats.erf(1.0), stats.erfc(5.0), stats.erfInv(0.5));

    // gamma generalises the factorial: gamma(n + 1) = n!
    printf("gamma(5) %.1f (4!)   gamma(0.5) %.12f (sqrt pi)   gamma(-0.5) %.12f\n", stats.gamma(5.0), stats.gamma(0.5), stats.gamma(-0.5));
    printf("gamma(171) %.6e   lgamma(171) %.9f\n", stats.gamma(171.0), stats.lgamma(171.0));
    printf("lgamma(1000) %.9f   (log of 999!, which gamma() cannot hold)\n", stats.lgamma(1000.0));
    printf("gamma(172) is infinite: %d\n", stats.gamma(172.0) > 1.0e308);

    // digamma is the derivative of lgamma: digamma(1) is minus Euler's constant
    printf("digamma(1) %.12f   digamma(10) %.12f\n", stats.digamma(1.0), stats.digamma(10.0));

    // the beta function B(a, b) = gamma(a) gamma(b) / gamma(a + b)
    printf("beta(2, 3) %.12f (1/12)   lbeta(100, 200) %.9f\n", stats.beta(2.0, 3.0), stats.lbeta(100.0, 200.0));

    // regularised incomplete gamma P(a, x) and Q = 1 - P, incomplete beta I_x(a, b)
    printf("incGammaP(2, 1) %.12f (1 - 2/e)   incGammaQ(2, 1) %.12f\n", stats.incGammaP(2.0, 1.0), stats.incGammaQ(2.0, 1.0));
    printf("incGammaPInv(2, 0.5) %.12f (P of this is 0.5: %.12f)\n", stats.incGammaPInv(2.0, 0.5), stats.incGammaP(2.0, stats.incGammaPInv(2.0, 0.5)));
    printf("incBeta(0.5, 2, 3) %.12f (11/16)   incBetaInv(0.6875, 2, 3) %.12f\n", stats.incBeta(0.5, 2.0, 3.0), stats.incBetaInv(0.6875, 2.0, 3.0));

    // outside the domain: NaN, or the limit where one exists
    double a = stats.lgamma(-1.0);
    double b = stats.incBeta(0.5, -1.0, 2.0);
    printf("lgamma(-1) is infinite: %d, incBeta(0.5, -1, 2) is NaN: %d\n", a > 1.0e308, b != b);
    return 0;
}
