// Upper tails: why p values use Sf instead of 1 - Cdf
import stats;

int main() {
    printf("%4s %14s %14s\n", "z", "sf(z)", "1 - cdf(z)");
    double zs[6] = {2.0, 5.0, 8.0, 10.0, 20.0, 37.0};
    for (int i = 0; i < 6; i++) {
        double z = zs[i];
        printf("%4.0f %14.6e %14.6e\n", z, stats.stdNormalSf(z), 1.0 - stats.stdNormalCdf(z));
    }
    // 1 - cdf throws the small number away: cdf(8) is the double nearest to 1, and the difference is rounding noise or 0

    // a t statistic of 1500 with 5 degrees of freedom (a huge effect): the two-sided p value
    double t = 1500.0;
    printf("t = 1500, 5 df: p = %.4e (2 * tSf)\n", 2.0 * stats.tSf(t, 5.0));
    printf("t = 1500, 5 df: p = %.4e (2 * (1 - tCdf))\n", 2.0 * (1.0 - stats.tCdf(t, 5.0)));

    // a chi-square of 300 with 100 degrees of freedom
    printf("chi2 = 300, 100 df: p = %.4e\n", stats.chi2Sf(300.0, 100.0));

    // the quantile function works from the tail as well
    printf("normalQuantile(1e-300) = %.6f\n", stats.stdNormalQuantile(1.0e-300));
    printf("check: stdNormalCdf of it = %.6e\n", stats.stdNormalCdf(stats.stdNormalQuantile(1.0e-300)));

    // the binomial and Poisson tails: at least 20 heads in 25 fair flips; at least 15 events when 4 are expected
    printf("P(X >= 20), binomial(25, 0.5): %.6e\n", stats.binomSf(19.0, 25.0, 0.5));
    printf("P(X >= 15), Poisson(4):        %.6e\n", stats.poissonSf(14.0, 4.0));
    return 0;
}
