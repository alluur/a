// Chi-square, Mann-Whitney and ANOVA tests
import stats;

void show(char* label, stats.TestResult r) {
    printf("%-30s stat %8.4f  df %5.2f  p %.4g\n", label, r.stat, r.df, r.pvalue);
}

// the U test has no degrees of freedom: print the statistic and p only
void showU(char* label, stats.TestResult r) {
    printf("%-30s stat %8.4f         p %.4g\n", label, r.stat, r.pvalue);
}

int main() {
    // is a die fair? 120 rolls (expected: 20 of each face when expected is null)
    double rolls[6] = {17, 24, 18, 31, 14, 16};
    show("die, all faces equally likely", stats.chiSquareGof(rolls, null, 6));
    // against given expected counts (a loaded die: 6 twice as likely)
    double expected[6] = {16, 16, 16, 16, 16, 40};
    show("die, loaded 6", stats.chiSquareGof(rolls, expected, 6));

    // a 2 x 2 table (row by row): treated / not treated against recovered / not recovered
    double table[4] = {30, 10, 18, 22};
    show("independence 2x2", stats.chiSquareIndependence(table, 2, 2, false));
    show("independence 2x2, Yates", stats.chiSquareIndependence(table, 2, 2, true));

    // Mann-Whitney U: no assumption of normality, works on ranks; exact p for small samples without ties
    double fast[7] = {12.4, 15.1, 11.8, 13.6, 14.2, 12.9, 16.0};
    double slow[9] = {14.9, 17.3, 16.4, 18.8, 15.7, 19.5, 17.9, 16.8, 20.2};
    showU("Mann-Whitney (exact), U", stats.mannWhitney(fast, 7, slow, 9));
    // with ties (or more than 25 values per sample) the normal approximation is used instead
    double c1[8] = {3, 5, 4, 6, 5, 7, 4, 5};
    double c2[8] = {6, 8, 7, 9, 7, 6, 8, 10};
    showU("Mann-Whitney (ties)", stats.mannWhitney(c1, 8, c2, 8));

    // one-way ANOVA: three groups stored one after the other, sizes 5, 6 and 5
    double data[16] = {23, 25, 21, 27, 24,   30, 28, 33, 29, 31, 27,   26, 24, 28, 25, 29};
    int sizes[3] = {5, 6, 5};
    stats.TestResult an = stats.anovaOneWay(data, sizes, 3);
    printf("ANOVA: F %.4f, df %.0f and %.0f, p %.6f\n", an.stat, an.df, an.df2, an.pvalue);

    // Jarque-Bera: are the data normal? (skewness and kurtosis; 2 df)
    double skew[12] = {1, 1, 2, 2, 2, 3, 3, 4, 5, 8, 13, 21};
    show("Jarque-Bera, skewed data", stats.jarqueBera(skew, 12));
    return 0;
}
