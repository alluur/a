// Eigenvalues of a symmetric matrix, and the singular value decomposition
import matrix;

int main() {
    // the second difference matrix (a chain of 3 masses with springs): eigenvalues 2 - sqrt 2, 2, 2 + sqrt 2
    double sv[9] = {2, -1, 0,  -1, 2, -1,  0, -1, 2};
    matrix.Matrix a = matrix.fromArray(sv, 3, 3);
    matrix.SymEigen e(&a);                              // Jacobi: values in ascending order
    printf("status %d, sweeps %d, largest |A v - lambda v| below 1e-12: %d\n", e.err, e.sweeps, e.maxResidual(&a) < 1.0e-12);
    for (int j = 0; j < 3; j++) {
        // the sign of an eigenvector is arbitrary: flip it so that the first entry is positive
        double s = e.vectors.get(0, j) < 0.0 ? -1.0 : 1.0;
        printf("lambda %.6f  vector (%7.4f, %7.4f, %7.4f)\n", e.values[j], s * e.vectors.get(0, j), s * e.vectors.get(1, j), s * e.vectors.get(2, j));
    }
    // trace = sum of eigenvalues, determinant = product
    printf("trace %.4f = %.4f, det %.4f = %.4f\n", a.trace(), e.values[0] + e.values[1] + e.values[2], a.det(), e.values[0] * e.values[1] * e.values[2]);

    // SVD of a 3 x 2 matrix: A = U diag(s) V^T with s sorted downwards
    double mv[6] = {1, 2, 3, 4, 5, 6};
    matrix.Matrix m = matrix.fromArray(mv, 3, 2);
    matrix.SVD d(&m);
    printf("singular values %.6f %.6f, rank %d, condition number %.4f\n", d.s[0], d.s[1], d.rank(), d.cond());
    matrix.Matrix back = d.reconstruct();
    printf("U is %d x %d, V is %d x %d, U diag(s) V^T (1,1) = %.4f\n", d.u.rows, d.u.cols, d.v.rows, d.v.cols, back.get(1, 1));

    // the pseudo inverse solves least squares: A+ b minimises |A x - b|
    matrix.Matrix pi = d.pinv();
    double b[3] = {1, 2, 4};
    double x[2];
    d.solve(b, x);
    printf("pinv is %d x %d; least squares solution x = (%.4f, %.4f)\n", pi.rows, pi.cols, x[0], x[1]);

    // a rank 1 matrix: the second singular value is 0 and cond is infinite
    double rv[6] = {1, 2, 2, 4, 3, 6};
    matrix.Matrix r1 = matrix.fromArray(rv, 3, 2);
    printf("rank of the rank-1 matrix: %d, cond infinite: %d\n", r1.rank(), r1.cond() > 1.0e300);
    a.dispose();
    e.dispose();
    m.dispose();
    d.dispose();
    back.dispose();
    pi.dispose();
    r1.dispose();
    return 0;
}
