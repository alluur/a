// Matrices: create, multiply, transpose, norms, and what a shape mismatch does
import matrix;

void show(char* name, matrix.Matrix* m) {
    printf("%s (%d x %d)\n", name, m->rows, m->cols);
    for (int i = 0; i < m->rows; i++) {
        printf(" ");
        for (int j = 0; j < m->cols; j++) { printf(" %7.2f", m->get(i, j)); }
        printf("\n");
    }
}

int main() {
    // fromArray copies row by row; element (i, j) of a matrix m is also m.d[i * m.cols + j]
    double av[6] = {1, 2, 3, 4, 5, 6};
    matrix.Matrix a = matrix.fromArray(av, 2, 3);
    matrix.Matrix b(3, 2);                            // zero filled
    for (int i = 0; i < 3; i++) { b.set(i, 0, (double) (i + 1)); b.set(i, 1, 1.0); }
    show("a", &a);
    show("b", &b);

    matrix.Matrix p = a * b;                          // the operators allocate a new matrix: dispose it
    show("a * b", &p);
    matrix.Matrix t = a.transpose();
    matrix.Matrix g = t * a;
    show("a^T * a", &g);
    printf("isSymmetric %d, trace %.1f, det of a*b %.1f\n", g.isSymmetric(), g.trace(), p.det());

    // matrix times vector, and the norms
    double x[3] = {1, 0, -1};
    double y[2];
    a.mulVec(x, y);
    printf("a * (1, 0, -1) = (%.1f, %.1f)\n", y[0], y[1]);
    printf("norm1 %.1f, normInf %.1f, Frobenius %.4f, largest entry %.1f\n", a.norm1(), a.normInf(), a.normFro(), a.normMax());

    // the identity and a diagonal matrix
    matrix.Matrix id = matrix.identity(2);
    matrix.Matrix same = id * p;
    printf("identity * (a * b) equals a * b: %d\n", same.get(0, 0) == p.get(0, 0) && same.get(1, 1) == p.get(1, 1));

    // errors never crash: the result is an empty matrix that says why
    matrix.Matrix bad = a * a;                        // 2 x 3 times 2 x 3 does not fit
    printf("a * a: ok %d, rows %d, err %d (%s)\n", bad.ok(), bad.rows, bad.err, matrix.errorText(bad.err));
    matrix.Matrix none(0, 4);
    printf("Matrix(0, 4): ok %d, err %d (%s)\n", none.ok(), none.err, matrix.errorText(none.err));
    printf("get(5, 5) is NaN: %d, set(5, 5, 1.0) returns %d\n", a.get(5, 5) != a.get(5, 5), a.set(5, 5, 1.0));

    a.dispose();
    b.dispose();
    p.dispose();
    t.dispose();
    g.dispose();
    id.dispose();
    same.dispose();
    return 0;
}
