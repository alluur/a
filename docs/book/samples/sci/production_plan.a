// Linear programming: what to produce to earn the most
import optim;

// max c.x subject to rows of A x <= b, x >= 0; prints the plan or why there is none
int solve(char* label, double* c, int n, double* a, int m, double* b, int* kinds) {
    double x[3];
    double best = 0.0;
    int pivots = 0;
    int st = optim.linprog(c, n, a, m, b, kinds, true, x, &best, &pivots);   // true: maximise
    printf("%-26s status %d (%s)", label, st, optim.errorText(st));
    if (st == optim.OK) { printf(": make A %.2f, B %.2f, C %.2f; profit %.2f (%d pivots)", x[0], x[1], x[2], best, pivots); }
    printf("\n");
    return st;
}

int main() {
    // three products A, B, C earn 40, 30 and 50 per unit
    double profit[3] = {40, 30, 50};
    // rows: labour hours, machine hours, material; one row per resource, one column per product
    double need[9] = {2, 1, 3,
                      4, 3, 2,
                      1, 2, 1};
    double have[3] = {100, 160, 80};
    solve("plan", profit, 3, need, 3, have, null);              // null: every row is <=

    // what is one more labour hour worth? Solve again with 101 hours (the "shadow price")
    double have2[3] = {101, 160, 80};
    double x[3];
    double base = 0.0;
    double more = 0.0;
    optim.linprog(profit, 3, need, 3, have, null, true, x, &base);
    optim.linprog(profit, 3, need, 3, have2, null, true, x, &more);
    printf("one more labour hour is worth %.4f\n", more - base);

    // a contract: at least 30 units of B. This row (0 A + 1 B + 0 C >= 30) has kind GE, the others LE
    double need2[12] = {2, 1, 3,  4, 3, 2,  1, 2, 1,  0, 1, 0};
    double have3[4] = {100, 160, 80, 30};
    int kinds[4] = {optim.LE, optim.LE, optim.LE, optim.GE};
    solve("with B >= 30", profit, 3, need2, 4, have3, kinds);

    // a contract nobody can fill: at least 100 units of B
    have3[3] = 100;
    solve("with B >= 100", profit, 3, need2, 4, have3, kinds);

    // no limit on C: unbounded
    double need3[6] = {1, 1, 0,  0, 1, 0};
    double have4[2] = {10, 10};
    solve("no limit on C", profit, 3, need3, 2, have4, null);
    return 0;
}
