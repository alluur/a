// Fit a line to noisy data and report a 95 percent confidence interval
import stats;
import rng;

int main() {
    // the truth is y = 3.2 + 1.7 x; the noise is normal with standard deviation 2
    rng.Xoshiro256 g(7);
    int n = 20;
    double x[20];
    double y[20];
    for (int i = 0; i < n; i++) {
        x[i] = (double) i;
        y[i] = 3.2 + 1.7 * x[i] + g.normalAt(0.0, 2.0);
    }

    stats.Regression r = stats.linearFit(x, y, n);
    if (!r.ok()) { printf("fit failed: status %d\n", r.err); return 1; }
    printf("n = %d, coefficients = %d, degrees of freedom = %d\n", r.n, r.p, r.df);
    char* names[2] = {"intercept", "slope"};
    for (int k = 0; k < 2; k++) {
        printf("%-9s %8.4f  std err %.4f  t %7.3f  p %.3g\n", names[k], r.coef[k], r.stdErr[k], r.tvalue[k], r.pvalue[k]);
    }
    printf("R2 %.4f, adjusted %.4f, residual std error %.4f\n", r.r2, r.adjR2, r.sigma);
    printf("F %.2f, p of the whole model %.3g\n", r.fstat, r.fpvalue);

    // the confidence interval of a coefficient: estimate +- t(0.975, df) * standard error
    double t = stats.tQuantile(0.975, (double) r.df);
    printf("t quantile (97.5%%, %d df) = %.4f\n", r.df, t);
    printf("95%% CI intercept [%.3f, %.3f]   truth 3.2\n", r.coef[0] - t * r.stdErr[0], r.coef[0] + t * r.stdErr[0]);
    printf("95%% CI slope     [%.3f, %.3f]   truth 1.7\n", r.coef[1] - t * r.stdErr[1], r.coef[1] + t * r.stdErr[1]);

    // predictions and residuals
    printf("predict(25) = %.3f, truth without noise %.3f\n", r.predict(25.0), 3.2 + 1.7 * 25.0);
    double worst = 0.0;
    for (int i = 0; i < n; i++) {
        double e = r.residuals[i] < 0.0 ? -r.residuals[i] : r.residuals[i];
        if (e > worst) { worst = e; }
    }
    double mean = stats.mean(r.residuals, n);
    printf("largest residual %.3f, residuals average to zero: %d\n", worst, mean < 1.0e-12 && mean > -1.0e-12);
    r.dispose();
    return 0;
}
