// Confidence intervals: mean, difference, variance, proportion and a bootstrap
import stats;
import rng;

void show(char* label, stats.Interval v) {
    printf("%-34s [%8.4f, %8.4f]\n", label, v.lo, v.hi);
}

// the statistic for the bootstrap: any function of a sample (here the median)
double medianOf(double* sample, int n, void* ctx) { return stats.median(sample, n); }

int main() {
    double a[12] = {5.1, 4.9, 5.6, 5.0, 5.3, 4.7, 5.8, 5.2, 5.4, 4.8, 5.5, 5.1};
    double b[10] = {4.4, 4.9, 4.6, 5.0, 4.3, 4.8, 4.5, 4.7, 5.1, 4.2};

    show("mean of a, 95%", stats.meanCI(a, 12, 0.95));
    show("mean of a, 99%", stats.meanCI(a, 12, 0.99));
    show("mean of a minus mean of b (Welch)", stats.meanDiffCI(a, 12, b, 10, 0.95));
    show("variance of a (normal data)", stats.varianceCI(a, 12, 0.95));

    // a proportion: 7 successes in 20 trials, three methods
    show("7 of 20, Wald", stats.proportionCI(7, 20, 0.95, stats.CI_WALD));
    show("7 of 20, Wilson (the default)", stats.proportionCI(7, 20, 0.95));
    show("7 of 20, Clopper-Pearson (exact)", stats.proportionCI(7, 20, 0.95, stats.CI_CLOPPER_PEARSON));
    // at the edge Wald collapses to a single point; Wilson and Clopper-Pearson do not
    show("0 of 15, Wald", stats.proportionCI(0, 15, 0.95, stats.CI_WALD));
    show("0 of 15, Wilson", stats.proportionCI(0, 15, 0.95, stats.CI_WILSON));
    show("0 of 15, Clopper-Pearson", stats.proportionCI(0, 15, 0.95, stats.CI_CLOPPER_PEARSON));

    // bootstrap: resample the data with replacement 2000 times and take the middle 95% of the medians
    rng.Xoshiro256 g(99);
    stats.Interval bi = stats.bootstrapCI(a, 12, medianOf, null, 2000, 0.95, &g);
    show("median of a, bootstrap 95%", bi);
    // the generator you pass decides the numbers: the same seed gives the same interval on every machine
    rng.Xoshiro256 again(99);
    stats.Interval bi2 = stats.bootstrapCI(a, 12, medianOf, null, 2000, 0.95, &again);
    printf("median of a is %.2f; a second generator with seed 99 gives the same interval: %d\n", stats.median(a, 12), bi.lo == bi2.lo && bi.hi == bi2.hi);

    // bad requests give NaN
    stats.Interval bad = stats.meanCI(a, 12, 1.0);
    printf("level 1.0: lo is NaN %d\n", bad.lo != bad.lo);
    return 0;
}
