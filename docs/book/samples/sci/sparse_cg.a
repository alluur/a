// Sparse matrices: a heated rod solved with the conjugate gradient method
import matrix;

int main() {
    // -u'' = 1 on a rod of length 1, ends held at 0. With n interior points and step h = 1 / (n + 1)
    // the equations are  -u[i-1] + 2 u[i] - u[i+1] = h^2:  a tridiagonal matrix. The exact answer is u(x) = x (1 - x) / 2.
    int n = 99;
    double h = 1.0 / (double) (n + 1);
    matrix.CooBuilder coo(n, n);                       // collect (row, column, value) entries in any order
    for (int i = 0; i < n; i++) {
        coo.add(i, i, 2.0);
        if (i > 0) { coo.add(i, i - 1, -1.0); }
        if (i < n - 1) { coo.add(i, i + 1, -1.0); }
    }
    matrix.CsrMatrix a = coo.build();                  // compressed sparse rows: only the non zeros are stored
    coo.dispose();
    printf("%d x %d matrix with %d non zeros (a dense one would hold %d numbers)\n", a.rows, a.cols, a.nnz, n * n);
    printf("a(0,0) %.1f, a(0,1) %.1f, a(0,5) %.1f (not stored: 0)\n", a.get(0, 0), a.get(0, 1), a.get(0, 5));

    double b[100];
    double u[100];
    for (int i = 0; i < n; i++) { b[i] = h * h; u[i] = 0.0; }    // u holds the starting guess: zeros

    int iters = 0;
    int st = matrix.cg(&a, b, u, 500, 1.0e-12, &iters);
    printf("cg: status %d (%s) after %d iterations\n", st, matrix.errorText(st), iters);

    double worst = 0.0;
    for (int i = 0; i < n; i++) {
        double x = (double) (i + 1) * h;
        double d = u[i] - x * (1.0 - x) / 2.0;
        if (d < 0.0) { d = -d; }
        if (d > worst) { worst = d; }
    }
    printf("u[49] is the point x = %.2f: %.8f (exact %.8f), largest error below 1e-9: %d\n", 50.0 * h, u[49], 0.125, worst < 1.0e-9);

    // too few iterations: reported, and x keeps the last iterate
    double w[100];
    for (int i = 0; i < n; i++) { w[i] = 0.0; }
    st = matrix.cg(&a, b, w, 10, 1.0e-12, &iters);
    printf("only 10 iterations allowed: status %d (%s)\n", st, matrix.errorText(st));

    // the same system with the dense LU, for comparison
    matrix.Matrix d = a.toDense();
    matrix.LU f(&d);
    double v[100];
    f.solve(b, v);
    double diff = 0.0;
    for (int i = 0; i < n; i++) {
        double e = v[i] - u[i];
        if (e < 0.0) { e = -e; }
        if (e > diff) { diff = e; }
    }
    printf("dense LU and cg agree to 1e-9: %d\n", diff < 1.0e-9);
    f.dispose();
    d.dispose();
    a.dispose();
    return 0;
}
