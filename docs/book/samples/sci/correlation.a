// Covariance, three kinds of correlation, ranks and the correlation matrix
import stats;
import matrix;

int main() {
    double hours[8] = {1, 2, 2, 3, 4, 5, 6, 8};
    double score[8] = {52, 55, 61, 64, 70, 71, 80, 88};
    double growth[8];                                 // a perfect but curved relation: y = 2^x
    for (int i = 0; i < 8; i++) { growth[i] = (double) (1 << (int) hours[i]); }

    printf("covariance           %.4f\n", stats.covariance(hours, score, 8));
    printf("Pearson (straight)   %.4f\n", stats.correlation(hours, score, 8));
    printf("Spearman (by rank)   %.4f\n", stats.spearman(hours, score, 8));
    printf("Kendall tau-b        %.4f\n", stats.kendall(hours, score, 8));

    // Pearson measures a straight line; rank correlations only ask "does one rise with the other?"
    printf("curved: Pearson %.4f, Spearman %.4f, Kendall %.4f\n",
           stats.correlation(hours, growth, 8), stats.spearman(hours, growth, 8), stats.kendall(hours, growth, 8));

    // ranks: ties get the average rank (the two 2s share ranks 2 and 3)
    double rk[8];
    stats.ranks(hours, 8, rk);
    printf("ranks of hours:");
    for (int i = 0; i < 8; i++) { printf(" %.1f", rk[i]); }
    printf("\n");

    // a constant variable has no correlation: NaN, not 0
    double flat[8] = {5, 5, 5, 5, 5, 5, 5, 5};
    double c = stats.correlation(hours, flat, 8);
    printf("constant variable: NaN %d\n", c != c);

    // the matrices: one observation per row, one variable per column
    matrix.Matrix data(8, 3);
    for (int i = 0; i < 8; i++) {
        data.set(i, 0, hours[i]);
        data.set(i, 1, score[i]);
        data.set(i, 2, growth[i]);
    }
    matrix.Matrix cor = stats.correlationMatrix(&data);
    cor.show(4);
    matrix.Matrix cov = stats.covarianceMatrix(&data);
    printf("variance of hours %.4f = covariance[0][0] %.4f\n", stats.variance(hours, 8), cov.get(0, 0));
    cov.dispose();
    cor.dispose();
    data.dispose();
    return 0;
}
