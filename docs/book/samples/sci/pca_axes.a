// Principal component analysis: the directions in which the data vary most
import stats;
import matrix;
import rng;

int main() {
    // 150 observations of 3 variables: the first two follow one hidden factor, the third is independent
    rng.Xoshiro256 g(11);
    int n = 150;
    matrix.Matrix data(n, 3);
    for (int i = 0; i < n; i++) {
        double z = g.normal();
        data.set(i, 0, 3.0 * z + 0.5 * g.normal());
        data.set(i, 1, 2.0 * z + 0.5 * g.normal());
        data.set(i, 2, g.normal());
    }

    stats.Pca p(&data, 0, false);                       // keep = 0: all components; scale = false: raw units
    if (!p.ok()) { printf("PCA failed: %d\n", p.err); return 1; }
    for (int c = 0; c < p.k; c++) {
        printf("PC%d: variance %7.4f, share %6.4f, axis (%7.4f, %7.4f, %7.4f)\n", c + 1, p.variance[c], p.ratio[c],
               p.components.get(c, 0), p.components.get(c, 1), p.components.get(c, 2));
    }
    printf("column means %.4f %.4f %.4f\n", p.mean[0], p.mean[1], p.mean[2]);

    // project onto the first axis only (keep = 1) and go back: the best straight-line summary of the data
    stats.Pca one(&data, 1, false);
    matrix.Matrix scores = one.transform(&data);          // n x 1
    matrix.Matrix back = one.inverseTransform(&scores);   // n x 3
    double err = 0.0;
    double total = 0.0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < 3; j++) {
            double d = data.get(i, j) - back.get(i, j);
            err += d * d;
            double c = data.get(i, j) - p.mean[j];
            total += c * c;
        }
    }
    printf("one component keeps %.2f%% of the variance; reconstruction error %.4f of %.4f\n", 100.0 * (1.0 - err / total), err, total);
    printf("first observation: (%.3f, %.3f, %.3f) -> score %.3f -> (%.3f, %.3f, %.3f)\n", data.get(0, 0), data.get(0, 1), data.get(0, 2),
           scores.get(0, 0), back.get(0, 0), back.get(0, 1), back.get(0, 2));

    // standardising first (scale = true) puts every variable on the same footing
    stats.Pca s(&data, 0, true);
    printf("standardised shares: %.4f %.4f %.4f\n", s.ratio[0], s.ratio[1], s.ratio[2]);
    scores.dispose();
    back.dispose();
    one.dispose();
    s.dispose();
    p.dispose();
    data.dispose();
    return 0;
}
