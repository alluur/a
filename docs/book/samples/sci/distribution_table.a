// Probability distributions: density, cumulative probability, upper tail and quantile
import stats;

int main() {
    // continuous: Pdf (density), Cdf (P[X <= x]), Sf (P[X > x]), Quantile (the x with Cdf = p)
    printf("normal(100, 15):  pdf(110) %.6f  cdf(110) %.6f  sf(110) %.6f\n",
           stats.normalPdf(110.0, 100.0, 15.0), stats.normalCdf(110.0, 100.0, 15.0), stats.normalSf(110.0, 100.0, 15.0));
    printf("  95th percentile %.4f, middle 95%% of the values: %.4f .. %.4f\n", stats.normalQuantile(0.95, 100.0, 15.0),
           stats.normalQuantile(0.025, 100.0, 15.0), stats.normalQuantile(0.975, 100.0, 15.0));
    printf("standard normal:  z(0.975) %.12f  cdf(1.96) %.6f\n", stats.stdNormalQuantile(0.975), stats.stdNormalCdf(1.96));
    printf("Student t, 10 df: t(0.975) %.6f  cdf(2) %.6f  pdf(0) %.6f\n", stats.tQuantile(0.975, 10.0), stats.tCdf(2.0, 10.0), stats.tPdf(0.0, 10.0));
    printf("chi-square, 3 df: q(0.95) %.6f  sf(7.814728) %.6f\n", stats.chi2Quantile(0.95, 3.0), stats.chi2Sf(7.814728, 3.0));
    printf("F(4, 20):         q(0.95) %.6f  cdf(2.8) %.6f\n", stats.fQuantile(0.95, 4.0, 20.0), stats.fCdf(2.8, 4.0, 20.0));
    printf("exponential(2):   cdf(0.5) %.6f  median %.6f\n", stats.expCdf(0.5, 2.0), stats.expQuantile(0.5, 2.0));
    printf("gamma(3, 2):      cdf(4) %.6f  beta(2, 5) cdf(0.3) %.6f\n", stats.gammaCdf(4.0, 3.0, 2.0), stats.betaCdf(0.3, 2.0, 5.0));
    printf("uniform(2, 6):    cdf(3) %.2f  lognormal(0, 1): median %.6f\n", stats.uniformCdf(3.0, 2.0, 6.0), stats.lognormalQuantile(0.5, 0.0, 1.0));

    // discrete: k and n are doubles that must hold whole numbers
    printf("binomial(10, 0.3): pmf(3) %.6f  cdf(3) %.6f  sf(3) %.6f  q(0.5) %.0f\n",
           stats.binomPmf(3.0, 10.0, 0.3), stats.binomCdf(3.0, 10.0, 0.3), stats.binomSf(3.0, 10.0, 0.3), stats.binomQuantile(0.5, 10.0, 0.3));
    printf("Poisson(4):        pmf(2) %.6f  cdf(2) %.6f  q(0.9) %.0f\n",
           stats.poissonPmf(2.0, 4.0), stats.poissonCdf(2.0, 4.0), stats.poissonQuantile(0.9, 4.0));

    // the quantile is the inverse of the cdf: going there and back gives p again
    double p = 0.9;
    printf("round trip of p = %.1f: normal %.12f, t(5) %.12f, chi2(7) %.12f\n", p, stats.normalCdf(stats.normalQuantile(p, 3.0, 2.0), 3.0, 2.0),
           stats.tCdf(stats.tQuantile(p, 5.0), 5.0), stats.chi2Cdf(stats.chi2Quantile(p, 7.0), 7.0));

    // bad parameters give NaN, never a number that looks right
    double a = stats.normalCdf(0.0, 0.0, -1.0);
    double b = stats.tQuantile(1.5, 10.0);
    printf("sigma = -1: NaN %d, p = 1.5: NaN %d\n", a != a, b != b);
    return 0;
}
