// Histograms: fixed bins, a text bar chart, and the automatic bin rules
import stats;
import rng;

int main() {
    rng.Xoshiro256 g(2024);
    double x[200];
    for (int i = 0; i < 200; i++) { x[i] = g.normalAt(70.0, 10.0); }   // exam scores

    // 8 equal bins over 40 .. 100; values outside go to below / above
    stats.Histogram h(8, 40.0, 100.0);
    h.addAll(x, 200);
    printf("bins %d, width %.2f, inside %d, below %d, above %d, nans %d\n", h.bins, h.width(), h.total, h.below, h.above, h.nans);
    for (int i = 0; i < h.bins; i++) {
        printf("[%5.1f, %5.1f%s %3d %6.4f ", h.edge(i), h.edge(i + 1), i == h.bins - 1 ? "]" : ")", h.count(i), h.density(i));
        for (int k = 0; k < h.count(i) / 2; k++) { printChar('#'); }
        println("");
    }
    printf("fullest bin: %d, the bin of 83.5 is %d, of 10 is %d\n", h.modeBin(), h.binOf(83.5), h.binOf(10.0));

    // the density integrates to 1: sum of density * width
    double area = 0.0;
    for (int i = 0; i < h.bins; i++) { area += h.density(i) * h.width(); }
    printf("area under the density: %.6f\n", area);
    h.dispose();

    // NumPy's rules choose the number of bins from the data
    char* names[7] = {"Sturges", "square root", "Rice", "Scott", "Freedman-Diaconis", "Doane", "auto"};
    int rules[7] = {stats.STURGES, stats.SQRT_RULE, stats.RICE, stats.SCOTT, stats.FD, stats.DOANE, stats.AUTO_RULE};
    for (int r = 0; r < 7; r++) {
        printf("%-18s %2d bins, the rule's width is %.3f\n", names[r], stats.binCount(x, 200, rules[r]), stats.binWidth(x, 200, rules[r]));
    }
    stats.Histogram a = stats.histogramAuto(x, 200, stats.FD);    // range = min .. max, already filled
    printf("histogramAuto(FD): %d bins from %.2f to %.2f, fullest bin %d\n", a.bins, a.lo, a.hi, a.modeBin());
    a.dispose();
    return 0;
}
