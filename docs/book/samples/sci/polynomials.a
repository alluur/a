// Polynomials: arithmetic, all roots (real and complex), and a least squares fit
import optim;
import dmath;

// coefficients are in INCREASING order: coef[k] belongs to x^k, so {-6, 11, -6, 1} is -6 + 11x - 6x^2 + x^3
void show(char* name, double* c, int degree) {
    printf("%-30s [", name);
    for (int k = 0; k <= degree; k++) { printf("%s%.4g", k > 0 ? ", " : "", c[k]); }
    printf("]\n");
}

void roots(char* name, double* c, int degree) {
    double re[8];
    double im[8];
    int n = optim.polyRoots(c, degree, re, im);       // the number of roots, or a negative error code
    printf("roots of %s (%d):", name, n);
    for (int i = 0; i < n; i++) {
        if (im[i] > 1.0e-9 || im[i] < -1.0e-9) { printf("  %.6f%+.6fi", re[i], im[i]); } else { printf("  %.6f", re[i]); }
    }
    printf("\n");
}

int main() {
    double p[4] = {-6, 11, -6, 1};                    // x^3 - 6x^2 + 11x - 6 = (x - 1)(x - 2)(x - 3)
    double q[3] = {-1, 0, 1};                         // x^2 - 1
    show("p", p, 3);
    printf("p(4) = %.1f, p'(4) = ", optim.polyEval(p, 3, 4.0));
    double dp[3];
    optim.polyDeriv(p, 3, dp);
    printf("%.1f\n", optim.polyEval(dp, 2, 4.0));

    double prod[6];
    int d = optim.polyMul(p, 3, q, 2, prod);          // degree 3 + 2 = 5
    show("p * q", prod, d);
    double quot[3];
    double rem[2];
    optim.polyDivide(p, 3, q, 2, quot, rem);          // p = quot * q + rem
    show("p / q: quotient", quot, 1);
    show("p / q: remainder", rem, 1);

    roots("p", p, 3);
    double c2[3] = {5, 2, 1};                         // x^2 + 2x + 5: no real roots
    roots("x^2 + 2x + 5", c2, 2);
    double c5[6] = {-1, 0, 0, 0, 0, 1};               // x^5 - 1: the fifth roots of unity
    roots("x^5 - 1", c5, 5);
    double r3[3] = {1, 2, 3};
    double fromr[4];
    optim.polyFromRoots(r3, 3, fromr);                // the monic polynomial with these roots
    show("polynomial with roots 1, 2, 3", fromr, 3);
    double quad[5] = {1, -4, 6, -4, 1};               // (x - 1)^4: a root of multiplicity 4
    double re[4];
    double im[4];
    optim.polyRoots(quad, 4, re, im);
    double worst = 0.0;
    for (int i = 0; i < 4; i++) {
        double dx = re[i] - 1.0;
        double e = dmath.hypot(dx, im[i]);
        if (e > worst) { worst = e; }
    }
    printf("(x - 1)^4: the four roots are all within %.0e of 1 (a multiple root loses digits)\n", worst);

    // fit a quadratic to noisy points; the truth is 2 - 3x + 0.5x^2
    double x[7] = {-2, -1, 0, 1, 2, 3, 4};
    double y[7] = {10.1, 5.4, 2.0, -0.4, -2.1, -2.4, -2.1};
    double fit[3];
    int st = optim.polyFit(x, y, 7, 2, fit);
    printf("polyFit: status %d\n", st);
    show("fit of 2 - 3x + 0.5x^2", fit, 2);
    return 0;
}
