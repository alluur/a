// Several predictors, a polynomial fit, and a design that cannot be fitted
import stats;
import matrix;

int main() {
    // house prices (in thousands): area in m2, age in years
    double area[10] = {50, 65, 70, 80, 85, 95, 100, 110, 120, 140};
    double age[10]  = {30, 12, 25, 8, 40, 15, 5, 20, 3, 10};
    double price[10] = {152, 215, 188, 262, 183, 260, 305, 280, 352, 391};
    int n = 10;

    matrix.Matrix X(n, 2);
    for (int i = 0; i < n; i++) { X.set(i, 0, area[i]); X.set(i, 1, age[i]); }
    stats.Regression r = stats.olsFit(&X, price, true);        // true: add an intercept column first
    char* names[3] = {"intercept", "area", "age"};
    for (int k = 0; k < r.p; k++) {
        printf("%-9s %8.4f  std err %.4f  p %.3g\n", names[k], r.coef[k], r.stdErr[k], r.pvalue[k]);
    }
    printf("R2 %.4f, adjusted R2 %.4f, sigma %.3f, F %.1f (p %.2g)\n", r.r2, r.adjR2, r.sigma, r.fstat, r.fpvalue);
    r.dispose();

    // a polynomial is a regression on x, x^2, x^3 ...: coef[k] belongs to x^k
    double t[8] = {0, 1, 2, 3, 4, 5, 6, 7};
    double h[8] = {1.2, 6.2, 10.1, 11.6, 12.0, 9.8, 6.5, 0.8};     // a thrown ball: 1 + 6.3 t - 0.9 t^2 and noise
    stats.Regression q = stats.polyFit(t, h, 8, 2);
    printf("coefficients of 1, t, t^2: %.3f %.3f %.3f, R2 %.4f, height at t = 8: %.3f\n", q.coef[0], q.coef[1], q.coef[2], q.r2, q.predict(8.0));
    q.dispose();

    // two columns that are the same carry no separate information: refused, never nonsense
    matrix.Matrix D(n, 2);
    for (int i = 0; i < n; i++) { D.set(i, 0, area[i]); D.set(i, 1, area[i]); }
    stats.Regression bad = stats.olsFit(&D, price, true);
    printf("duplicate column: ok %d, status %d (%s)\n", bad.ok(), bad.err, matrix.errorText(bad.err));
    // more coefficients than observations
    stats.Regression few = stats.polyFit(t, h, 8, 8);
    printf("degree 8 through 8 points: status %d (%s)\n", few.err, matrix.errorText(few.err));
    X.dispose();
    D.dispose();
    return 0;
}
