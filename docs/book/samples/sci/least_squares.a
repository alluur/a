// Least squares with QR: more equations than unknowns, and a rank deficient case
import matrix;

int main() {
    // fit y = c0 + c1 t + c2 t^2 to six measurements: 6 equations, 3 unknowns
    double t[6] = {0, 1, 2, 3, 4, 5};
    double y[6] = {1.1, 2.9, 7.2, 12.8, 21.1, 31.0};
    matrix.Matrix a(6, 3);
    for (int i = 0; i < 6; i++) {
        a.set(i, 0, 1.0);
        a.set(i, 1, t[i]);
        a.set(i, 2, t[i] * t[i]);
    }
    matrix.QR f(&a);
    double c[3];
    double resid;
    int st = f.solveLS(y, c, &resid);
    printf("status %d (%s): c = (%.4f, %.4f, %.4f), residual norm %.4f\n", st, matrix.errorText(st), c[0], c[1], c[2], resid);
    printf("QR's reciprocal condition estimate of R: %.4f\n", f.rcond());
    f.dispose();

    // two identical columns: the unknowns c1 and c2 cannot be told apart
    matrix.Matrix d(6, 3);
    for (int i = 0; i < 6; i++) {
        d.set(i, 0, 1.0);
        d.set(i, 1, t[i]);
        d.set(i, 2, t[i]);
    }
    matrix.QR g(&d);
    double x[3];
    st = g.solveLS(y, x);
    printf("QR.solveLS on the rank deficient matrix: status %d (%s)\n", st, matrix.errorText(st));
    g.dispose();

    // lstsq falls back to the SVD and returns the solution of smallest norm: the weight is shared equally
    int rank = 0;
    st = matrix.lstsq(&d, y, x, &resid, &rank);
    printf("lstsq: status %d, rank %d, x = (%.4f, %.4f, %.4f), residual %.4f\n", st, rank, x[0], x[1], x[2], resid);

    // fewer equations than unknowns: infinitely many solutions, again the smallest one
    matrix.Matrix w(2, 3);
    double wv[6] = {1, 1, 0,  0, 1, 1};
    for (int i = 0; i < 6; i++) { w.d[i] = wv[i]; }
    double b2[2] = {2, 2};
    st = matrix.lstsq(&w, b2, x, &resid, &rank);
    printf("2 equations, 3 unknowns: rank %d, x = (%.4f, %.4f, %.4f), residual is zero: %d\n", rank, x[0], x[1], x[2], resid < 1.0e-12);
    a.dispose();
    d.dispose();
    w.dispose();
    return 0;
}
