// k-means clustering of three blobs of points, and the elbow of the inertia
import stats;
import rng;

int main() {
    // 3 blobs of 30 points around (0, 0), (6, 1) and (3, 7); spread 0.8
    rng.Xoshiro256 g(5);
    const int PER = 30;
    int n = 3 * PER;
    double cx[3] = {0.0, 6.0, 3.0};
    double cy[3] = {0.0, 1.0, 7.0};
    double pts[180];                                   // n x 2, row by row: (x, y), (x, y) ...
    for (int i = 0; i < n; i++) {
        pts[2 * i] = g.normalAt(cx[i / PER], 0.8);
        pts[2 * i + 1] = g.normalAt(cy[i / PER], 0.8);
    }

    // k-means++ starts, Lloyd's iterations, the best of 5 restarts; the generator makes it repeatable
    rng.Xoshiro256 seed(1);
    stats.KMeans km = stats.kmeans(pts, n, 2, 3, &seed, 300, 5);
    if (!km.ok()) { printf("failed: %d\n", km.err); return 1; }
    printf("k %d, dim %d, iterations %d, inertia %.3f\n", km.k, km.dim, km.iterations, km.inertia);

    // the numbering of the clusters is arbitrary: it follows the random starting points
    int size[3] = {0, 0, 0};
    for (int i = 0; i < n; i++) { size[km.labels[i]]++; }
    for (int c = 0; c < 3; c++) {
        printf("cluster %d: %2d points, center (%6.3f, %6.3f)\n", c, size[c], km.centers[2 * c], km.centers[2 * c + 1]);
    }

    // which cluster does a new point belong to? the one with the nearest center
    double q[2] = {5.0, 2.0};
    int c = km.predict(q);
    printf("point (5, 2) belongs to cluster %d, center (%.3f, %.3f)\n", c, km.centers[2 * c], km.centers[2 * c + 1]);
    km.dispose();

    // the elbow: the inertia (sum of squared distances to the centers) drops sharply up to the true k
    printf("k  inertia\n");
    for (int k = 1; k <= 5; k++) {
        rng.Xoshiro256 s(1);
        stats.KMeans m = stats.kmeans(pts, n, 2, k, &s, 300, 50);
        printf("%d  %8.3f\n", k, m.inertia);
        m.dispose();
    }

    // k-means finds a local optimum: more restarts, a better (lower) inertia
    int tries[3] = {1, 5, 50};
    for (int t = 0; t < 3; t++) {
        rng.Xoshiro256 s(1);
        stats.KMeans m = stats.kmeans(pts, n, 2, 4, &s, 300, tries[t]);
        printf("k = 4 with %2d restarts: inertia %.3f\n", tries[t], m.inertia);
        m.dispose();
    }
    return 0;
}
