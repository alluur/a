// Finding a root of cos(x) = x with four methods, and what the errors look like
import optim;
import dmath;

// every function for optim is  double f(double x, void* ctx)  (ctx: anything you want to pass along, or null)
double f(double x, void* ctx) { return dmath.cos(x) - x; }
double df(double x, void* ctx) { return -dmath.sin(x) - 1.0; }
double wild(double x, void* ctx) { return x < 1.0 ? x - 2.0 : dmath.nan(); }

void show(char* name, optim.Result r) {
    printf("%-22s x = %.12f  f(x) = %9.2e  iterations %2d  evaluations %2d  status %d\n", name, r.x, r.fx, r.iterations, r.evals, r.status);
}

int main() {
    // the root lies in [0, 1] because f(0) = 1 > 0 and f(1) = cos(1) - 1 < 0
    show("bisection", optim.bisection(f, null, 0.0, 1.0, 1.0e-12, 200));    // safe, one binary digit per step
    show("brent", optim.brent(f, null, 0.0, 1.0, 1.0e-12, 100));            // safe and fast: the usual choice
    show("newton (derivative)", optim.newton(f, df, null, 0.5, 1.0e-12, 50)); // fast near the root, needs a start
    show("newton (numerical)", optim.newton(f, null, null, 0.5, 1.0e-10, 50)); // df = null: central differences
    show("secant", optim.secant(f, null, 0.0, 1.0, 1.0e-12, 50));           // no derivative, no bracket guarantee

    // no sign change: refused (ERR_BRACKET = 2); findBracket walks outwards until there is one
    optim.Result r = optim.brent(f, null, 2.0, 3.0, 1.0e-12, 100);
    printf("brent on [2, 3]: status %d (%s)\n", r.status, optim.errorText(r.status));
    double lo = 0.0;
    double hi = 0.0;
    int st = optim.findBracket(f, null, 2.0, 0.5, &lo, &hi);
    printf("findBracket from 2.0: status %d, bracket [%.3f, %.3f]\n", st, lo, hi);
    show("brent on that bracket", optim.brent(f, null, lo, hi, 1.0e-12, 100));

    // a function that returns NaN is reported, never turned into an answer
    r = optim.bisection(wild, null, 0.0, 5.0, 1.0e-9, 100);
    printf("callback returns NaN: status %d (%s)\n", r.status, optim.errorText(r.status));
    r = optim.brent(null, null, 0.0, 1.0, 1.0e-9, 100);
    printf("no callback: status %d (%s)\n", r.status, optim.errorText(r.status));
    return 0;
}
