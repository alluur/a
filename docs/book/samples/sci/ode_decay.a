// Solving y' = f(t, y): exponential decay with RK4 and the adaptive Rk45
import optim;
import dmath;

struct Decay { double k; }                                   // the context: the decay rate

// the right hand side: dydt[0] = -k y[0]  (n = 1 equation)
void rhs(double t, double* y, double* dydt, int n, void* ctx) {
    Decay* p = (Decay*) ctx;
    dydt[0] = -p->k * y[0];
}

int main() {
    Decay d;
    d.k = 0.5;                                               // half life ln 2 / 0.5 = 1.386
    double y0[1] = {10.0};
    double exact = 10.0 * dmath.exp(-0.5 * 4.0);             // y(4) = 10 e^-2
    printf("exact y(4) = %.10f\n", exact);

    // fixed steps: halving the step divides the error by about 16 (a fourth order method)
    double prev = 0.0;
    for (int steps = 4; steps <= 64; steps *= 2) {
        double y[1];
        optim.rk4(rhs, &d, 1, 0.0, y0, 4.0, steps, y, null);
        double e = y[0] - exact;
        if (e < 0.0) { e = -e; }
        printf("rk4, %2d steps: y(4) = %.10f  error %.2e", steps, y[0], e);
        if (prev > 0.0) { printf("  (previous / this = %.1f)", prev / e); }
        printf("\n");
        prev = e;
    }

    // adaptive: the step size follows the solution; you give a relative and an absolute tolerance
    optim.Rk45 s(rhs, &d, 1, 0.0, y0, 1.0e-9, 1.0e-12);
    int st = s.solveTo(4.0, 10000);
    printf("Rk45: status %d, y(4) = %.10f, %d steps, %d rejected, %d function calls\n", st, s.y[0], s.nsteps, s.nrejected, s.nfev);
    s.dispose();

    // output at chosen times: the state at t = 1, 2, 3 and 4 in one run
    double times[4] = {1.0, 2.0, 3.0, 4.0};
    double out[4];
    optim.Rk45 r(rhs, &d, 1, 0.0, y0, 1.0e-9, 1.0e-12);
    r.solveAt(times, 4, out, 10000);
    for (int i = 0; i < 4; i++) { printf("t = %.0f: y = %.8f  exact %.8f\n", times[i], out[i], 10.0 * dmath.exp(-0.5 * times[i])); }
    r.dispose();

    // the whole trajectory of fixed steps: 8 steps give 9 rows, row i belongs to t = i / 2
    double fin[1];
    double traj[9];
    optim.rk4(rhs, &d, 1, 0.0, y0, 4.0, 8, fin, traj);
    printf("trajectory of rk4 with 8 steps:");
    for (int i = 0; i < 9; i++) { printf(" %.3f", traj[i]); }
    printf("\n");
    return 0;
}
