// The spectrum of a two-tone signal with the FFT, and filtering it
import optim;
import rng;
import dmath;

const N = 1000;                                       // 1 second sampled at 1000 Hz: bin k is k Hz

int main() {
    rng.Xoshiro256 g(3);
    double clean[N];
    double x[N];
    for (int i = 0; i < N; i++) {
        double t = (double) i / 1000.0;
        // a 50 Hz tone (amplitude 1.0), a 120 Hz tone (amplitude 0.5), an offset of 0.25, and noise
        clean[i] = 0.25 + dmath.sin(2.0 * dmath.PI * 50.0 * t) + 0.5 * dmath.sin(2.0 * dmath.PI * 120.0 * t);
        x[i] = clean[i] + g.normalAt(0.0, 0.3);
    }

    // N = 1000 is not a power of two: any length works. A real signal gives N / 2 + 1 useful bins.
    double re[501];
    double im[501];
    int st = optim.rfft(x, N, re, im);
    double amp[501];
    double freq[N];
    optim.fftFrequencies(N, 1.0 / 1000.0, freq);      // the frequency of every bin in Hz
    for (int k = 0; k <= 500; k++) {
        amp[k] = dmath.hypot(re[k], im[k]) * (k == 0 ? 1.0 : 2.0) / (double) N;   // the amplitude of the tone in that bin
    }
    printf("rfft status %d; bins 0 .. 500, spacing %.1f Hz\n", st, freq[1]);
    printf("peaks above 0.2 (a tone of amplitude A shows up as A in its bin):\n");
    for (int k = 0; k <= 500; k++) {
        if (amp[k] > 0.2) { printf("  %5.1f Hz  amplitude %.4f\n", freq[k], amp[k]); }
    }
    double noiseSum = 0.0;
    for (int k = 200; k <= 500; k++) { noiseSum += amp[k]; }
    printf("average noise bin between 200 and 500 Hz: %.4f\n", noiseSum / 301.0);

    // low-pass filter: keep the bins up to 150 Hz, zero the rest, transform back
    for (int k = 151; k <= 500; k++) { re[k] = 0.0; im[k] = 0.0; }
    double y[N];
    optim.irfft(re, im, N, y);
    double before = 0.0;
    double after = 0.0;
    for (int i = 0; i < N; i++) {
        before += (x[i] - clean[i]) * (x[i] - clean[i]);
        after += (y[i] - clean[i]) * (y[i] - clean[i]);
    }
    printf("RMS error against the clean signal: noisy %.4f, filtered %.4f\n", dmath.sqrt(before / N), dmath.sqrt(after / N));

    // the round trip is exact: transform and transform back
    double back[N];
    double r2[501];
    double i2[501];
    optim.rfft(clean, N, r2, i2);
    optim.irfft(r2, i2, N, back);
    double worst = 0.0;
    for (int i = 0; i < N; i++) {
        double e = back[i] - clean[i];
        if (e < 0.0) { e = -e; }
        if (e > worst) { worst = e; }
    }
    printf("round trip error below 1e-12: %d\n", worst < 1.0e-12);
    return 0;
}
