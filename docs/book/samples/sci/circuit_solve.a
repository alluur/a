// A 3-loop resistor circuit: mesh currents from a linear system
import matrix;

int main() {
    // Mesh analysis (Kirchhoff's voltage law), resistors in ohms:
    //   loop 1: 10 and 20 ohm, source 12 V
    //   loop 2: 20 (shared with loop 1), 30 and 40 ohm (40 is shared with loop 3)
    //   loop 3: 40 (shared) and 50 ohm, a 5 V source working against loop 3
    // Unknowns: the currents i1, i2, i3 in amperes.
    double r[5] = {10, 20, 30, 40, 50};
    matrix.Matrix a(3, 3);
    a.set(0, 0, r[0] + r[1]);  a.set(0, 1, -r[1]);
    a.set(1, 0, -r[1]);        a.set(1, 1, r[1] + r[2] + r[3]);  a.set(1, 2, -r[3]);
    a.set(2, 1, -r[3]);        a.set(2, 2, r[3] + r[4]);
    double v[3] = {12, 0, -5};

    matrix.LU f(&a);                                   // P A = L U, with row swaps for stability
    if (!f.ok()) { printf("cannot solve: %s\n", matrix.errorText(f.err)); return 1; }
    double i[3];
    int st = f.solve(v, i);                            // matrix.OK (0) when it worked
    printf("status %d (%s)\n", st, matrix.errorText(st));
    for (int k = 0; k < 3; k++) { printf("i%d = %8.4f mA\n", k + 1, 1000.0 * i[k]); }

    // check: A i must give back v
    double back[3];
    a.mulVec(i, back);
    double worst = 0.0;
    for (int k = 0; k < 3; k++) {
        double d = back[k] - v[k];
        if (d < 0.0) { d = -d; }
        if (d > worst) { worst = d; }
    }
    printf("largest residual below 1e-12: %d\n", worst < 1.0e-12);

    // voltage across the shared 20 ohm resistor and the power of the 12 V source
    printf("drop over 20 ohm: %.4f V, power of the 12 V source: %.4f mW\n", r[1] * (i[0] - i[1]), 12.0 * i[0] * 1000.0);
    printf("det %.0f, reciprocal condition %.4f\n", f.det(), f.rcond());

    // the factorisation is reused: a new source voltage costs only a cheap solve
    double v2[3] = {24, 0, -5};
    double j[3];
    f.solve(v2, j);
    printf("with a 24 V source: i1 = %.4f mA, i2 = %.4f mA, i3 = %.4f mA\n", 1000.0 * j[0], 1000.0 * j[1], 1000.0 * j[2]);
    f.dispose();
    a.dispose();
    return 0;
}
