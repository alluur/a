// Describing a data set: centre, spread and shape
import stats;

int main() {
    // response times in milliseconds of 15 requests; the last one is a stall
    double x[15] = {212, 187, 305, 198, 254, 221, 240, 199, 231, 262, 208, 245, 190, 228, 1210};
    int n = 15;

    printf("n        %d\n", n);
    printf("sum      %.1f\n", stats.sum(x, n));
    printf("mean     %.3f\n", stats.mean(x, n));
    printf("median   %.3f\n", stats.median(x, n));
    printf("mode     %.1f (smallest value when all are unique)\n", stats.mode(x, n));
    printf("min/max  %.0f / %.0f, range %.0f\n", stats.minimum(x, n), stats.maximum(x, n), stats.rangeOf(x, n));

    // ddof is the divisor n - ddof: 1 = sample variance (default), 0 = the whole population
    printf("variance %.3f (ddof 1), %.3f (ddof 0)\n", stats.variance(x, n, 1), stats.variance(x, n, 0));
    printf("stddev   %.3f, standard error of the mean %.3f\n", stats.stddev(x, n), stats.sem(x, n));

    // robust measures: the stall hardly moves them
    printf("IQR      %.3f\n", stats.iqr(x, n));
    printf("MAD      %.3f (median absolute deviation, not scaled)\n", stats.mad(x, n));
    printf("skewness %.4f, excess kurtosis %.4f\n", stats.skewness(x, n), stats.kurtosis(x, n));

    // z scores: how many standard deviations from the mean (ddof 1 here)
    double z[15];
    stats.zscores(x, n, z, 1);
    printf("z of the stall %.3f, z of the fastest %.3f\n", z[14], z[1]);

    // the same without the stall
    printf("without the stall: mean %.3f, stddev %.3f, skewness %.4f\n",
           stats.mean(x, 14), stats.stddev(x, 14), stats.skewness(x, 14));
    return 0;
}
