// Streaming statistics: Welford's accumulator, merging chunks
import stats;

int main() {
    // 1000 readings of 1e9 + (0 .. 6): a huge offset and a spread of about 2
    stats.Welford w;
    double sumSq = 0.0;                      // the textbook way: keep the sums of x and x^2
    double sum = 0.0;
    int n = 1000;
    for (int i = 0; i < n; i++) {
        double x = 1.0e9 + (double) (i % 7);
        w.add(x);                            // O(1) memory: no array of readings needed
        sum += x;
        sumSq += x * x;
    }
    double naive = (sumSq - sum * sum / (double) n) / (double) (n - 1);
    printf("count %d, mean %.4f, min %.0f, max %.0f\n", w.size(), w.mean(), w.minimum(), w.maximum());
    printf("Welford variance   %.6f\n", w.variance());
    printf("textbook variance  %.6f (cancellation)\n", naive);
    printf("skewness %.6f, excess kurtosis %.6f\n", w.skewness(), w.kurtosis());

    // chunks: three workers each summarise a part, then the summaries are merged
    stats.Welford a;
    stats.Welford b;
    stats.Welford c;
    for (int i = 0; i < n; i++) {
        double x = 1.0e9 + (double) (i % 7);
        if (i < 300) { a.add(x); } else if (i < 800) { b.add(x); } else { c.add(x); }
    }
    a.merge(&b);
    a.merge(&c);
    printf("merged: count %d, mean %.4f, variance %.6f\n", a.size(), a.mean(), a.variance());

    // too little data is NaN, never a made-up number
    stats.Welford one;
    one.add(5.0);
    double v = one.variance();               // needs n - 1 >= 1
    printf("one value: mean %.1f, sample variance NaN %d, population variance %.1f\n", one.mean(), v != v, one.variance(0));
    return 0;
}
