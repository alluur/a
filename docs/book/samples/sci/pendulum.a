// A pendulum: the period grows with the amplitude (an ODE solver inside a root finder)
import optim;
import dmath;

struct Pendulum { double w2; double theta0; }               // w2 = g / L, and the starting angle

// theta' = omega, omega' = -(g / L) sin(theta): two equations, y[0] = theta, y[1] = omega
void rhs(double t, double* y, double* dydt, int n, void* ctx) {
    Pendulum* p = (Pendulum*) ctx;
    dydt[0] = y[1];
    dydt[1] = -p->w2 * dmath.sin(y[0]);
}

// theta(t) for a pendulum released at rest at theta0
double angle(double t, void* ctx) {
    Pendulum* p = (Pendulum*) ctx;
    double y0[2] = {p->theta0, 0.0};
    optim.Rk45 s(rhs, ctx, 2, 0.0, y0, 1.0e-11, 1.0e-13);
    s.solveTo(t, 100000);
    double v = s.y[0];
    s.dispose();
    return v;
}

// the exact period from elliptic integrals: T = T0 * 2 K(k) / pi with k = sin(theta0 / 2), K by the arithmetic-geometric mean
double exactRatio(double theta0) {
    double a = 1.0;
    double b = dmath.cos(theta0 / 2.0);
    for (int i = 0; i < 40; i++) { double t = (a + b) / 2.0; b = dmath.sqrt(a * b); a = t; }
    return 1.0 / a;
}

int main() {
    Pendulum p;
    p.w2 = 9.81;                                            // g = 9.81 m/s^2, L = 1 m
    double t0 = 2.0 * dmath.PI / dmath.sqrt(p.w2);          // the small angle period 2 pi sqrt(L / g)
    printf("small angle period T0 = %.6f s\n", t0);
    printf("%8s %10s %10s %10s\n", "angle", "period", "T / T0", "exact");
    double starts[4] = {0.1, 0.5, 1.5, 2.5};                // radians
    for (int i = 0; i < 4; i++) {
        p.theta0 = starts[i];
        // the pendulum crosses theta = 0 after a quarter period: find that time with Brent's method
        optim.Result q = optim.brent(angle, &p, 0.05 * t0, 0.45 * t0, 1.0e-10, 100);
        double period = 4.0 * q.x;
        printf("%8.1f %9.6f s %10.6f %10.6f\n", starts[i], period, period / t0, exactRatio(starts[i]));
    }
    return 0;
}
