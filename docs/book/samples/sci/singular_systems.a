// Singular and ill conditioned systems: refused, not solved into nonsense
import matrix;
import dmath;

// the largest |x[i] - 1|: the exact solution of every system below is all ones
double wrong(double* x, int n) {
    double w = 0.0;
    for (int i = 0; i < n; i++) {
        double d = x[i] - 1.0;
        if (d < 0.0) { d = -d; }
        if (d > w) { w = d; }
    }
    return w;
}

// builds b = H * (1, 1, ... 1), so that the exact answer is known
void rhsOfOnes(matrix.Matrix* h, double* b) {
    double ones[12];
    for (int i = 0; i < 12; i++) { ones[i] = 1.0; }
    h->mulVec(ones, b);
}

int main() {
    // row 3 = row 1 + row 2: exactly singular
    double sv[9] = {1, 2, 3,  4, 5, 6,  5, 7, 9};
    matrix.Matrix s = matrix.fromArray(sv, 3, 3);
    matrix.LU f(&s);
    double b[3] = {1, 2, 3};
    double x[3];
    int st = f.solve(b, x);
    printf("singular: factor status %d (%s), solve %d, det %.1f\n", f.err, matrix.errorText(f.err), st, f.det());
    matrix.Matrix inv = f.inverse();
    printf("inverse: ok %d, err %d (%s)\n", inv.ok(), inv.err, matrix.errorText(inv.err));
    f.dispose();

    // Hilbert matrices H(i, j) = 1 / (i + j + 1): a classic of bad conditioning
    for (int n = 4; n <= 12; n += 4) {
        matrix.Matrix h = matrix.hilbert(n);
        double rhs[12];
        double sol[12];
        rhsOfOnes(&h, rhs);
        matrix.LU g(&h);
        int r = g.solve(rhs, sol);
        printf("hilbert(%2d): rcond %.1e, solve status %d (%s)", n, g.rcond(), r, matrix.errorText(r));
        if (r == matrix.OK) { printf(", error %.0e", wrong(sol, n)); }
        printf("\n");
        g.dispose();
        if (n == 12) {
            matrix.LU force(&h, 0.0);                  // minRcond = 0: only exactly zero pivots are refused
            r = force.solve(rhs, sol);
            printf("hilbert(12) forced: status %d, but the answer is off by %.2f\n", r, wrong(sol, n));
            force.dispose();
        }
        h.dispose();
    }

    // NaN in the input is refused at once
    double nanv[4] = {1, 2, 3, 4};
    nanv[3] = dmath.nan();
    matrix.Matrix bad = matrix.fromArray(nanv, 2, 2);
    matrix.LU h2(&bad);
    printf("NaN input: status %d (%s)\n", h2.err, matrix.errorText(h2.err));

    // Cholesky checks symmetry and positive definiteness
    double ns[4] = {1, 2, 3, 4};
    double ind[4] = {1, 2, 2, 1};
    matrix.Matrix m1 = matrix.fromArray(ns, 2, 2);
    matrix.Matrix m2 = matrix.fromArray(ind, 2, 2);
    matrix.Cholesky c1(&m1);
    matrix.Cholesky c2(&m2);
    printf("Cholesky of a non symmetric matrix: %s; of an indefinite one: %s\n", matrix.errorText(c1.err), matrix.errorText(c2.err));
    s.dispose();
    inv.dispose();
    bad.dispose();
    m1.dispose();
    m2.dispose();
    h2.dispose();
    c1.dispose();
    c2.dispose();
    return 0;
}
