// Student's t tests: one sample, two samples (Welch or pooled), paired data
import stats;

void show(char* label, stats.TestResult r) {
    printf("%-28s t %7.4f  df %6.3f  p %.5f\n", label, r.stat, r.df, r.pvalue);
}

int main() {
    // battery life in hours; the maker claims a mean of 100
    double life[10] = {96.2, 99.1, 94.8, 101.3, 95.5, 97.9, 98.4, 93.7, 100.2, 96.6};
    show("one sample, mu0 = 100", stats.ttestOneSample(life, 10, 100.0));
    show("  only 'less' (tail -1)", stats.ttestOneSample(life, 10, 100.0, stats.TAIL_LESS));
    show("  only 'greater'", stats.ttestOneSample(life, 10, 100.0, stats.TAIL_GREATER));

    // two brands, different sample sizes and spread
    double a[8] = {12.1, 11.8, 13.0, 12.6, 12.2, 11.5, 12.9, 12.4};
    double b[12] = {13.4, 12.2, 14.9, 13.8, 15.1, 12.7, 14.2, 13.9, 15.6, 12.9, 14.4, 13.1};
    show("Welch (unequal variances)", stats.ttestTwoSample(a, 8, b, 12, false));
    show("pooled (equal variances)", stats.ttestTwoSample(a, 8, b, 12, true));
    // the variances: are they equal? (F test)
    stats.TestResult f = stats.varianceTest(a, 8, b, 12);
    printf("variance ratio %.4f, p %.4f\n", f.stat, f.pvalue);

    // paired: the same 8 people before and after training (the pairs are linked, so test the differences)
    double before[8] = {72, 85, 64, 90, 78, 69, 81, 75};
    double after[8]  = {75, 88, 63, 95, 83, 70, 86, 77};
    show("paired", stats.ttestPaired(before, after, 8));
    show("(wrongly) as two samples", stats.ttestTwoSample(before, 8, after, 8, false));

    // bad input is an error (err 8 = matrix.ERR_ARG, NaN everywhere); a sample with no spread is not:
    // it divides by 0, so look at t and p as well as err
    double flat[4] = {3.0, 3.0, 3.0, 3.0};
    stats.TestResult bad = stats.ttestOneSample(life, 1, 100.0);
    printf("one value:         err %d, p is NaN %d\n", bad.err, bad.pvalue != bad.pvalue);
    bad = stats.ttestOneSample(flat, 4, 3.0);
    printf("no spread, mu0 3:  err %d, t %.1f, p %.1f\n", bad.err, bad.stat, bad.pvalue);
    bad = stats.ttestOneSample(flat, 4, 2.0);
    printf("no spread, mu0 2:  err %d, t %.1f, p %.1f\n", bad.err, bad.stat, bad.pvalue);
    return 0;
}
