// Numerical integration: from the trapezoid rule to adaptive Gauss-Kronrod
import optim;
import dmath;

double quarterCircle(double x, void* ctx) { return 4.0 / (1.0 + x * x); }        // the integral over [0, 1] is pi
double bell(double x, void* ctx) { return dmath.exp(-x * x); }                      // over the whole line: sqrt(pi)
double root(double x, void* ctx) { return dmath.sqrt(x); }                         // 2/3 on [0, 1], with a steep start

void row(char* name, optim.Integral r, double exact) {
    double e = r.value - exact;
    if (e < 0.0) { e = -e; }
    printf("%-26s %.12f  error %8.1e  evaluations %5d\n", name, r.value, e, r.evals);
}

int main() {
    double pi = dmath.PI;
    printf("pi = %.12f: the integral of 4 / (1 + x^2) over [0, 1]\n", pi);
    row("trapezoid, 100 panels", optim.trapezoid(quarterCircle, null, 0.0, 1.0, 100), pi);
    row("Simpson, 100 panels", optim.simpson(quarterCircle, null, 0.0, 1.0, 100), pi);
    optim.Integral ro = optim.romberg(quarterCircle, null, 0.0, 1.0, 1.0e-12, 20);
    row("Romberg", ro, pi);
    optim.Integral gk = optim.gaussKronrod(quarterCircle, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 100);
    row("Gauss-Kronrod", gk, pi);
    row("Gauss-Legendre, 8 points", optim.integrateGL(quarterCircle, null, 0.0, 1.0, 8), pi);
    printf("Gauss-Kronrod says: error estimate %.1e, %d subintervals, status %d\n", gk.error, gk.intervals, gk.status);

    // infinite limits are mapped to a finite interval: pass +- dmath.INFINITY
    optim.Integral inf = optim.gaussKronrod(bell, null, -dmath.INFINITY, dmath.INFINITY, 1.0e-12, 1.0e-12, 100);
    row("exp(-x^2) over the line", inf, dmath.sqrt(pi));

    // an endpoint singularity (sqrt has an infinite slope at 0): slow for fixed rules, fine for the adaptive one
    row("sqrt(x), Simpson, 100", optim.simpson(root, null, 0.0, 1.0, 100), 2.0 / 3.0);
    row("sqrt(x), Gauss-Kronrod", optim.gaussKronrod(root, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 200), 2.0 / 3.0);

    // tabulated data (no function): the trapezoid rule over samples, and Simpson for equal steps
    double xs[5] = {0.0, 0.5, 1.0, 1.5, 2.0};
    double ys[5] = {0.0, 0.25, 1.0, 2.25, 4.0};                // y = x^2
    printf("samples of x^2 on [0, 2]: trapezoid %.4f, Simpson %.4f (exact %.4f)\n", optim.integrateSamples(xs, ys, 5), optim.simpsonSamples(ys, 5, 0.5), 8.0 / 3.0);
    return 0;
}
