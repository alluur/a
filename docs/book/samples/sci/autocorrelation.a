// Time series: autocorrelation, partial autocorrelation and the Ljung-Box test
import stats;
import rng;
import dmath;

const N = 120;

void report(char* name, double* x) {
    double acf[7];
    double pacf[7];
    stats.autocorrelation(x, N, 6, acf);               // lags 0 .. 6 (lag 0 is always 1)
    stats.partialAutocorrelation(x, N, 6, pacf);
    printf("%-9s acf ", name);
    for (int k = 1; k <= 6; k++) { printf(" %6.3f", acf[k]); }
    printf("\n%-9s pacf", "");
    for (int k = 1; k <= 6; k++) { printf(" %6.3f", pacf[k]); }
    stats.TestResult q = stats.ljungBox(x, N, 10);       // H0: no autocorrelation up to lag 10
    printf("\n%-9s Ljung-Box Q %.2f, df %.0f, p %.3g\n", "", q.stat, q.df, q.pvalue);
}

int main() {
    rng.Xoshiro256 g(31);
    double noise[N];
    double ar1[N];
    double season[N];
    double prev = 0.0;
    for (int t = 0; t < N; t++) {
        noise[t] = g.normal();
        prev = 0.7 * prev + g.normal();                   // each value remembers 70% of the one before
        ar1[t] = prev;
        season[t] = 2.0 * dmath.sin(2.0 * dmath.PI * (double) t / 12.0) + g.normal();   // a yearly cycle in months
    }
    report("noise", noise);
    report("AR(1)", ar1);
    report("seasonal", season);
    // for AR(1) with 0.7 the acf decays like 0.7^k and the pacf stops after lag 1
    printf("0.7^k:        %6.3f %6.3f %6.3f %6.3f %6.3f %6.3f\n", dmath.pow(0.7, 1.0), dmath.pow(0.7, 2.0), dmath.pow(0.7, 3.0),
           dmath.pow(0.7, 4.0), dmath.pow(0.7, 5.0), dmath.pow(0.7, 6.0));
    return 0;
}
