// Minimising a function of one variable and of two: golden section, Brent, Nelder-Mead, BFGS
import optim;
import dmath;

// surface area of a closed can of volume 1000 cm^3 and radius r: two lids and the side
double area(double r, void* ctx) { return 2.0 * dmath.PI * r * r + 2000.0 / r; }

// Rosenbrock's banana valley: minimum 0 at (1, 1), inside a long curved valley
double rosen(double* x, int n, void* ctx) {
    double a = 1.0 - x[0];
    double b = x[1] - x[0] * x[0];
    return a * a + 100.0 * b * b;
}
void rosenGrad(double* x, int n, double* g, void* ctx) {
    g[0] = -2.0 * (1.0 - x[0]) - 400.0 * x[0] * (x[1] - x[0] * x[0]);
    g[1] = 200.0 * (x[1] - x[0] * x[0]);
}

int main() {
    // one variable, on an interval [a, b] that holds the minimum
    optim.Result g = optim.goldenSection(area, null, 1.0, 20.0, 1.0e-8, 500);
    optim.Result b = optim.brentMin(area, null, 1.0, 20.0, 1.0e-8, 200);
    double exact = dmath.cbrt(1000.0 / (2.0 * dmath.PI));          // calculus: r = (V / 2 pi)^(1/3), the height is 2 r
    printf("exact r %.6f, area %.4f\n", exact, area(exact, null));
    printf("golden section: r %.6f, area %.4f, %d evaluations\n", g.x, g.fx, g.evals);
    printf("Brent:          r %.6f, area %.4f, %d evaluations\n", b.x, b.fx, b.evals);
    printf("the best can is as tall as it is wide: height 2r = %.4f cm\n", 2.0 * b.x);

    // two variables: no derivatives needed for Nelder-Mead (a simplex that crawls downhill)
    double x[2] = {-1.2, 1.0};
    optim.Result nm = optim.nelderMead(rosen, null, x, 2, 0.5, 1.0e-10, 5000);
    printf("Nelder-Mead: (%.5f, %.5f) f %.2e, %d evaluations, status %d\n", x[0], x[1], nm.fx, nm.evals, nm.status);

    // BFGS with the gradient, and with grad = null (central differences, 2n extra evaluations per step)
    double y[2] = {-1.2, 1.0};
    optim.Result bf = optim.bfgs(rosen, rosenGrad, null, y, 2, 1.0e-8, 200);
    printf("BFGS, gradient:   (%.5f, %.5f) f %.2e, %d iterations, %d evaluations, status %d\n", y[0], y[1], bf.fx, bf.iterations, bf.evals, bf.status);
    double z[2] = {-1.2, 1.0};
    optim.Result bn = optim.bfgs(rosen, null, null, z, 2, 1.0e-6, 200);
    printf("BFGS, numerical:  (%.5f, %.5f) f %.2e, %d iterations, status %d\n", z[0], z[1], bn.fx, bn.iterations, bn.status);

    // too few iterations: the best point so far comes back with a status
    double w[2] = {-1.2, 1.0};
    optim.Result few = optim.bfgs(rosen, rosenGrad, null, w, 2, 1.0e-8, 5);
    printf("5 iterations only: f %.4f, status %d (%s)\n", few.fx, few.status, optim.errorText(few.status));
    return 0;
}
