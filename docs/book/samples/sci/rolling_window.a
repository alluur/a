// A sliding window over a sensor stream: mean, median, maximum and an EMA
import stats;

int main() {
    // temperature readings; 31.9 is a one-off spike
    double t[12] = {20.1, 20.4, 20.2, 20.6, 31.9, 20.5, 20.7, 20.9, 21.0, 20.8, 21.2, 21.1};
    stats.RollingStats win(4);                 // the last 4 values
    stats.Ema ema(stats.emaAlphaFromSpan(4.0)); // alpha = 2 / (span + 1) = 0.4

    printf("%2s %6s | %7s %6s %6s %6s | %6s\n", "i", "value", "mean", "median", "max", "stddev", "ema");
    for (int i = 0; i < 12; i++) {
        win.add(t[i]);
        double e = ema.add(t[i]);
        // stddev needs two values: NaN while the window holds one (printed as nan)
        printf("%2d %6.1f | %7.3f %6.2f %6.1f %6.3f | %6.2f%s\n", i, t[i], win.mean(), win.median(), win.maximum(),
               win.stddev(), e, win.full() ? "" : "  (window not full)");
    }
    printf("window %d, values seen %d, in the window %d\n", win.window(), win.added(), win.size());

    // whole-series versions: out[i] is the average of t[i .. i + w - 1], so there are n - w + 1 of them
    double ma[12];
    int cnt = stats.movingAverage(t, 12, 4, ma);
    printf("movingAverage(4): %d values, first %.3f, last %.3f\n", cnt, ma[0], ma[cnt - 1]);
    double cs[12];
    stats.cumsum(t, 12, cs);
    printf("cumsum: %.1f ... %.1f\n", cs[0], cs[11]);
    win.dispose();
    return 0;
}
