// Convolution and cross-correlation: smoothing, polynomial products and finding a delay
import optim;
import rng;

int main() {
    // convolution of the coefficient lists multiplies the polynomials: (1 + 2x + 3x^2)(4 + 5x)
    double a[3] = {1, 2, 3};
    double b[2] = {4, 5};
    double prod[4];
    optim.convolve(a, 3, b, 2, prod);                 // na + nb - 1 = 4 numbers
    printf("(1 + 2x + 3x^2)(4 + 5x) = %.0f + %.0f x + %.0f x^2 + %.0f x^3\n", prod[0], prod[1], prod[2], prod[3]);

    // smoothing: a spike and a step, passed through a 3 point average (the full output is 2 longer than the input)
    double sig[8] = {0, 0, 9, 0, 0, 3, 3, 3};
    double kern[3] = {1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0};
    double sm[10];
    optim.convolve(sig, 8, kern, 3, sm);
    printf("smoothed:");
    for (int i = 0; i < 10; i++) { printf(" %.2f", sm[i]); }
    printf("\n");

    // a delay: y is x shifted by 17 samples plus noise; the cross-correlation peaks at the lag
    rng.Xoshiro256 g(21);
    const int N = 200;
    double x[200];
    double y[200];
    for (int i = 0; i < N; i++) { x[i] = g.normal(); }
    for (int i = 0; i < N; i++) { y[i] = (i >= 17 ? x[i - 17] : 0.0) + 0.5 * g.normal(); }
    double cc[399];
    optim.crossCorrelate(y, N, x, N, cc);             // 2 N - 1 numbers; lag = index - (N - 1)
    int best = 0;
    for (int k = 1; k < 2 * N - 1; k++) { if (cc[k] > cc[best]) { best = k; } }
    double other = 0.0;                               // the highest value anywhere else
    for (int k = 0; k < 2 * N - 1; k++) { if (k != best && cc[k] > other) { other = cc[k]; } }
    printf("cross-correlation peaks at lag %d (true delay 17): height %.1f, the next highest value is %.1f\n", best - (N - 1), cc[best], other);

    // long inputs use the FFT; it agrees with the direct sum (integers come back as integers up to rounding)
    const int M = 1500;
    double u[1500];
    double v[1500];
    for (int i = 0; i < M; i++) { u[i] = (double) (g.below(21) - 10); v[i] = (double) (g.below(21) - 10); }
    double* fast = (double*) alloc(8 * (2 * M - 1));
    double* slow = (double*) alloc(8 * (2 * M - 1));
    optim.convolve(u, M, v, M, fast);                 // long inputs: convolve() switches to the FFT by itself
    optim.convolveDirect(u, M, v, M, slow);
    double worst = 0.0;
    for (int k = 0; k < 2 * M - 1; k++) {
        double d = fast[k] - slow[k];
        if (d < 0.0) { d = -d; }
        if (d > worst) { worst = d; }
    }
    printf("FFT and direct convolution of two integer sequences of %d: largest difference below 1e-6: %d\n", M, worst < 1.0e-6);
    printf("first and last value: FFT %.0f %.0f, direct %.0f %.0f\n", fast[0], fast[2 * M - 2], slow[0], slow[2 * M - 2]);
    return 0;
}
