// Quantiles: the nine definitions of Hyndman and Fan
import stats;

int main() {
    // ten sorted values (the functions also sort a copy for you)
    double x[10] = {2, 4, 4, 5, 7, 9, 10, 12, 15, 21};
    char* names[9] = {"1 inverted cdf", "2 averaged cdf", "3 nearest even", "4 interpolated cdf", "5 Hazen",
                      "6 Weibull (Minitab)", "7 linear (NumPy, Excel)", "8 median unbiased", "9 normal unbiased"};
    double ps[3] = {0.1, 0.4, 0.9};

    printf("%-24s %8s %8s %8s\n", "method", "p=0.10", "p=0.40", "p=0.90");
    for (int m = 1; m <= 9; m++) {
        double q[3];
        stats.quantiles(x, 10, ps, 3, q, m);          // one sort for all three probabilities
        printf("%-24s %8.3f %8.3f %8.3f\n", names[m - 1], q[0], q[1], q[2]);
    }

    // the default is method 7, so these two lines agree
    printf("median(x)           %.3f\n", stats.median(x, 10));
    printf("quantile(x, 0.5, 7) %.3f\n", stats.quantile(x, 10, 0.5, 7));

    // the ends and bad input: p must be in [0, 1], method in 1 .. 9
    printf("p = 0 and 1: %.1f %.1f\n", stats.quantile(x, 10, 0.0), stats.quantile(x, 10, 1.0));
    double bad = stats.quantile(x, 10, 1.5);
    printf("p = 1.5 gives NaN: %d\n", bad != bad);
    bad = stats.quantile(x, 10, 0.5, 10);
    printf("method 10 gives NaN: %d\n", bad != bad);
    return 0;
}
