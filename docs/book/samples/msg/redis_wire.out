-- an inline command: words and a line end (what you type into telnet)
client: PING\r\n
server: +PONG\r\n
-- the real thing: an array (*3) of bulk strings ($3 = three bytes follow)
client: *3\r\n$3\r\nSET\r\n$5\r\ncolor\r\n$3\r\nred\r\n
server: +OK\r\n
client: *2\r\n$3\r\nGET\r\n$5\r\ncolor\r\n
server: $3\r\nred\r\n
-- a missing key is a bulk string of length -1; a number starts with a colon
client: *2\r\n$3\r\nGET\r\n$4\r\nnone\r\n
server: $-1\r\n
client: *4\r\n$5\r\nRPUSH\r\n$1\r\nl\r\n$2\r\nhi\r\n$5\r\nthere\r\n
server: :2\r\n
-- an array of two bulk strings
client: *4\r\n$6\r\nLRANGE\r\n$1\r\nl\r\n$1\r\n0\r\n$2\r\n-1\r\n
server: *2\r\n$2\r\nhi\r\n$5\r\nthere\r\n
-- an error is a line that starts with a minus
client: INCR color\r\n
server: -ERR value is not an integer or out of range\r\n
-- garbage: the server says why and hangs up
client: *abc\r\n
server: -ERR Protocol error: invalid number\r\n
client: PING\r\n
server: the connection was closed
