// RESP, the Redis protocol, as bytes: what a client and a server really say
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

// print bytes with the line ends made visible
void show(char* who, char* bytes, int n) {
    printf("%s ", who);
    for (int i = 0; i < n; i++) {
        if (bytes[i] == 13) printf("\\r");
        else if (bytes[i] == 10) printf("\\n");
        else printf("%c", bytes[i]);
    }
    println("");
}

// send text, read the answer (net.recv waits; the server answers from the idle hook)
void talk(int h, char* request) {
    show("client:", request, strlen(request));
    net.send(h, request, strlen(request));
    char buf[200];
    int n = net.recv(h, &buf[0], 200);
    if (n > 0) show("server:", &buf[0], n);
    else printf("server: the connection was closed\n");
}

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    int h = net.connect("127.0.0.1", server->port);
    net.setTimeout(h, 2000);

    println("-- an inline command: words and a line end (what you type into telnet)");
    talk(h, "PING\r\n");
    println("-- the real thing: an array (*3) of bulk strings ($3 = three bytes follow)");
    talk(h, "*3\r\n$3\r\nSET\r\n$5\r\ncolor\r\n$3\r\nred\r\n");
    talk(h, "*2\r\n$3\r\nGET\r\n$5\r\ncolor\r\n");
    println("-- a missing key is a bulk string of length -1; a number starts with a colon");
    talk(h, "*2\r\n$3\r\nGET\r\n$4\r\nnone\r\n");
    talk(h, "*4\r\n$5\r\nRPUSH\r\n$1\r\nl\r\n$2\r\nhi\r\n$5\r\nthere\r\n");
    println("-- an array of two bulk strings");
    talk(h, "*4\r\n$6\r\nLRANGE\r\n$1\r\nl\r\n$1\r\n0\r\n$2\r\n-1\r\n");
    println("-- an error is a line that starts with a minus");
    talk(h, "INCR color\r\n");
    println("-- garbage: the server says why and hangs up");
    talk(h, "*abc\r\n");
    talk(h, "PING\r\n");
    net.close(h);
    server->shutdown();
    return 0;
}
