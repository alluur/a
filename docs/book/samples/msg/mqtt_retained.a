// Retained messages: the broker keeps the last value of a topic
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

mqtt.Client* login(char* url) { return mqtt.connect(url); }

void show(char* who, mqtt.Message* m) {
    if (m == null) { printf("%s: nothing\n", who); return; }
    printf("%s: %s = \"%s\" (retain flag %d)\n", who, m->topic, m->payload, m->retain);
    m->dispose();
}

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    mqttd.Broker* b = broker->broker;

    mqtt.Client* pub = login(&url[0]);
    // The last argument of publishWait is "retain". Two values for one topic, one for another.
    pub->publishWait("door/front", "open", 4, 1, true, 2000);
    pub->publishWait("door/front", "closed", 6, 1, true, 2000);        // replaces the first
    pub->publishWait("door/back", "open", 4, 1, true, 2000);
    printf("the broker holds %d retained messages\n", b->retainedCount());

    // A subscriber that arrives LATE still learns the state, at once, with the retain flag set
    mqtt.Client* late = login(&url[0]);
    late->subscribeWait("door/+", 1, 2000);
    mqtt.Message* a = late->waitMessage(2000);
    mqtt.Message* c = late->waitMessage(2000);
    // the order of the two is the broker's business: print them sorted
    if (strcmp(a->topic, c->topic) > 0) { mqtt.Message* t = a; a = c; c = t; }
    show("late subscriber", a);
    show("late subscriber", c);

    // A live message reaches an existing subscription with the retain flag OFF (the flag means "this is old news")
    pub->publishWait("door/front", "locked", 6, 1, true, 2000);
    show("live delivery   ", late->waitMessage(2000));

    // An empty retained message deletes the retained one
    pub->publishWait("door/back", "", 0, 1, true, 2000);
    show("live delivery   ", late->waitMessage(2000));
    printf("the broker holds %d retained message now\n", b->retainedCount());

    // A message that is NOT retained does not change what is kept
    pub->publishWait("door/front", "knock", 5, 0, false, 2000);
    show("live delivery   ", late->waitMessage(2000));
    mqtt.Client* third = login(&url[0]);
    third->subscribeWait("door/#", 0, 2000);
    show("third subscriber", third->waitMessage(2000));
    show("third subscriber", third->waitMessage(50));
    broker->shutdown();
    return 0;
}
