// Quality of service 0, 1 and 2, and what a subscription does to it
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

int doneCount = 0;
int onPublished(mqtt.Client* c, int token) { doneCount++; return 0; }    // a message is complete

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);

    // three subscribers to the same topic, each asking for a different QoS
    mqtt.Client* sub[3];
    for (int q = 0; q < 3; q++) {
        sub[q] = mqtt.connect(&url[0]);
        int granted = sub[q]->subscribeWait("data", q, 2000);
        printf("subscriber %d asked for QoS %d, the broker granted %d\n", q, q, granted);
    }

    mqtt.Client* pub = mqtt.connect(&url[0]);
    pub->onPublished = onPublished;

    // publish with every QoS; each subscriber gets the message with the LOWER of the two levels
    for (int p = 0; p < 3; p++) {
        pub->publishWait("data", "x", 1, p, false, 2000);
        for (int q = 0; q < 3; q++) {
            mqtt.Message* m = sub[q]->waitMessage(2000);
            printf("published with QoS %d, subscriber %d got QoS %d\n", p, q, m->qos);
            m->dispose();
        }
    }
    printf("onPublished was called %d times, nothing in flight: %d\n", doneCount, pub->inflight() == 0 ? 1 : 0);

    // publish() does not wait: it returns a token, and isPending() says whether the message is complete
    int token = pub->publish("data", "y", 1, 2, false);
    printf("token %d pending right away: %d\n", token, pub->isPending(token) ? 1 : 0);
    pub->flushAll(2000);                                      // wait for the PUBREC / PUBREL / PUBCOMP exchange
    printf("after flushAll: pending %d, completed messages %d\n", pub->isPending(token) ? 1 : 0, pub->published);

    printf("the broker counted %d messages in and %d out\n", broker->broker->stats->messagesIn, broker->broker->stats->messagesOut);
    broker->shutdown();
    return 0;
}
