// Sets (unique members) and sorted sets (members with a score)
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);

    // A set holds each member once and has no order: SADD says 1 for a new member, 0 for one that was there
    printf("sadd ada: %d, sadd grace: %d, sadd ada again: %d\n", c->sadd("tags", "ada"), c->sadd("tags", "grace"), c->sadd("tags", "ada"));
    printf("is ada a member: %d, is linus: %d\n", c->sismember("tags", "ada") ? 1 : 0, c->sismember("tags", "linus") ? 1 : 0);
    redis.Reply* m = c->smembers("tags");
    printf("members: %d\n", m->count);                         // the ORDER of the members is not defined: count them, or sort them
    m->dispose();
    printf("srem grace: %d, srem grace again: %d\n", c->srem("tags", "grace"), c->srem("tags", "grace"));

    // A sorted set keeps its members ordered by a score. Scores are numbers written as text ("2.5", "-inf").
    c->zadd("board", "120", "ada");
    c->zadd("board", "95", "grace");
    c->zadd("board", "210", "linus");
    c->zadd("board", "95.5", "dennis");
    printf("zadd an existing member changes its score: %d\n", c->zadd("board", "130", "ada"));          // 0: nobody new
    printf("members: %d\n", c->zcard("board"));

    redis.Reply* r = c->zrange("board", 0, -1, true);          // lowest score first; true = with scores
    println("from the lowest:");
    for (int i = 0; i + 1 < r->count; i += 2) printf("  %-8s %s\n", r->elems[i]->str, r->elems[i + 1]->str);
    r->dispose();

    // The top two: the last two of the ascending order. (ZREVRANGE and ZRANGE ... REV are not supported by redisd.)
    r = c->zrange("board", -2, -1, false);
    printf("the top two, best last:");
    for (int i = 0; i < r->count; i++) printf(" %s", r->elems[i]->str);
    printf("\n");
    r->dispose();

    char* s = c->zscore("board", "grace");
    printf("score of grace: %s, of nobody: %s\n", s, c->zscore("board", "nobody") == null ? "null" : "?");
    free(s);
    printf("zrem dennis: %d, members left: %d\n", c->zrem("board", "dennis"), c->zcard("board"));
    c->dispose();
    server->shutdown();
    return 0;
}
