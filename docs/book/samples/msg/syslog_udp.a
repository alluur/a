// A syslog sender and a collector over UDP, one thread
import syslog;
import syslogd;

int TS = 1065910455;                                          // 2003-10-11 22:14:15 UTC: a fixed clock, so the log lines never change
syslogd.Server* server;

// UDP needs no connection, so nothing waits and nothing calls the collector for us: we run its loop until it is quiet
void settle() {
    int quiet = 0;
    while (quiet < 20) { if (server->poll(1) == 0) quiet++; else quiet = 0; }
}

void dump(char* title) {
    syslogd.Ring* ring = server->collector->ring;             // the default ring: it keeps what is not dropped
    printf("%s:\n", title);
    for (int i = 0; i < ring->count(); i++) printf("  [%s] %s\n", syslog.severityName(ring->severityOf(i)), ring->line(i));
    ring->clear();
}

int main() {
    server = syslogd.newServer();
    server->collector->setClock(TS);                          // for messages that arrive without a time stamp
    server->listenUdp(0);                                     // port 0: any free port, server->udpPort tells which
    char url[80];
    format(&url[0], 80, "udp://127.0.0.1:%d", server->udpPort);

    syslog.Sender* s = syslog.newSender(&url[0]);             // udp://  tcp://  tls://
    s->setHostName("web1");                                   // default: the name of this computer
    s->setApp("shop", "42");                                  // APP-NAME and PROCID
    s->facility = syslog.FAC_LOCAL3;
    s->now = TS;                                              // time stamps from our clock, not the real one
    s->fracDigits = 0;                                        // RFC 5424 may carry fractions of a second; leave them out here
    s->info("service started");
    s->warning("disk 91 percent full");
    s->error("payment gateway timed out");
    s->send(syslog.SEV_DEBUG, "cache warmed in 12 ms");       // any severity, by number
    settle();
    dump("traditional lines (the default)");

    // The same collector can write its lines in another shape
    server->collector->lineFormat = syslogd.LINE_DETAIL;      // with facility.severity
    s->format = syslog.FORMAT_3164;                           // and the sender can speak the old format
    s->critical("raid array degraded");
    settle();
    dump("detail lines, sent as RFC 3164");

    server->collector->lineFormat = syslogd.LINE_RAW;         // exactly the bytes that arrived
    s->format = syslog.FORMAT_5424;
    s->notice("raw");
    settle();
    dump("raw lines");

    // A UDP datagram holds one message; longer ones are cut at 2048 bytes
    char* big = alloc(6000);
    memset(big, 'x', 5999);
    server->collector->lineFormat = syslogd.LINE_TRADITIONAL;
    s->info(big);
    settle();
    printf("a 5999 byte message arrived as a line of %d bytes\n", server->collector->ring->lineLength(0));

    syslogd.Stats* st = server->collector->stats;
    printf("collector: %d received, %d parsed, %d by UDP; sender: %d sent, %d dropped\n", st->received, st->parsed, st->udp, s->sent, s->dropped);
    s->dispose();
    server->shutdown();
    return 0;
}
