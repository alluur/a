// Persistent sessions: a subscriber that was away finds its messages waiting
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

char url[80];

// let the broker see what the clients did (a DISCONNECT is only noticed when the broker runs)
void settle() {
    int quiet = 0;
    while (quiet < 10) { if (broker->poll(1) == 0) quiet++; else quiet = 0; }
}

mqtt.Client* login(char* id, bool clean) {
    mqtt.Options o();
    o.clientId = id;
    o.cleanSession = clean;                                  // false: the broker keeps subscriptions and QoS 1/2 messages
    return mqtt.connectWith(&url[0], &o);
}

// connect again with the same id and count what is waiting
void comeBack(char* id, bool clean) {
    mqtt.Client* c = login(id, clean);
    printf("%s returns: session present %d", id, c->sessionPresent ? 1 : 0);
    int n = 0;
    for (;;) {
        mqtt.Message* m = c->waitMessage(100);
        if (m == null) break;
        printf(", got \"%s\" (QoS %d)", m->payload, m->qos);
        n++;
        m->dispose();
    }
    printf(n == 0 ? ", no messages\n" : "\n");
    c->disconnect();
    c->dispose();
}

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    mqttd.Broker* b = broker->broker;

    // two subscribers with the same subscription; one keeps its session, one does not
    mqtt.Client* keeper = login("keeper", false);
    mqtt.Client* tidy = login("tidy", true);
    printf("first connect: session present %d and %d\n", keeper->sessionPresent ? 1 : 0, tidy->sessionPresent ? 1 : 0);
    keeper->subscribeWait("jobs/#", 1, 2000);
    tidy->subscribeWait("jobs/#", 1, 2000);
    keeper->disconnect();  keeper->dispose();
    tidy->disconnect();    tidy->dispose();
    settle();
    printf("the broker keeps %d session (the clean one is gone)\n", b->sessionCount());

    // messages arrive while both are away
    mqtt.Client* pub = mqtt.connect(&url[0]);
    pub->publishWait("jobs/1", "resize", 6, 1, false, 2000);
    pub->publishWait("jobs/2", "convert", 7, 1, false, 2000);
    pub->publishWait("jobs/3", "fast", 4, 0, false, 2000);          // QoS 0 is never kept for an offline client
    printf("queued for keeper: %d messages\n", b->sessionQueued("keeper"));

    comeBack("tidy", true);
    comeBack("keeper", false);
    comeBack("keeper", false);                                       // delivered once: the queue is empty now
    pub->disconnect();  pub->dispose();
    settle();
    printf("sessions on the broker: %d\n", b->sessionCount());

    // A session can be thrown away: connect with a clean session under the same id
    mqtt.Client* wipe = login("keeper", true);
    wipe->disconnect();  wipe->dispose();
    settle();
    printf("after a clean connect of \"keeper\": %d sessions\n", b->sessionCount());
    broker->shutdown();
    return 0;
}
