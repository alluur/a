// Keys that expire: time to live, SET NX as a lock, PERSIST
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);

    // TTL says how many seconds are left: -1 = the key never expires, -2 = there is no such key
    c->setEx("session", "abc", 100);                          // SET and EXPIRE in one command
    c->set("forever", "x");
    c->set("later", "y");
    c->expire("later", 50);
    printf("ttl: session %d, forever %d, later %d, nothing %d\n", c->ttl("session"), c->ttl("forever"), c->ttl("later"), c->ttl("nothing"));

    // Milliseconds need the general command: SET key value PX 250
    redis.Reply* r = c->call("SET", "blink", "on", "PX", "250");
    r->dispose();
    char* v = c->get("blink");
    printf("blink right after SET: %s\n", v);
    free(v);
    sleepMs(350);                                             // expired keys disappear when they are read (and by a sweep every 100 ms)
    printf("blink 350 ms later: %s\n", c->get("blink") == null ? "gone" : "still there");

    // PERSIST removes a time to live (no helper: call() takes any command, up to 6 words)
    r = c->call("PERSIST", "session");
    r->dispose();
    printf("ttl after PERSIST: %d\n", c->ttl("session"));

    // SET key value NX PX ms: "only if the key does not exist", a lock that frees itself after 5 s
    for (int who = 1; who <= 2; who++) {
        r = c->call("SET", "lock", "worker", "NX", "PX", "5000");
        printf("attempt %d to take the lock: %s\n", who, r->type == redis.T_STATUS ? "got it" : "refused (nil)");
        r->dispose();
    }
    c->dispose();
    server->shutdown();
    return 0;
}
