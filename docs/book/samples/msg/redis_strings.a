// Redis strings: set, get, counters, several keys at once, binary values
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }                    // the server lives in the idle hook, as in the MQTT samples

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);
    if (c == null) { println(redis.error()); return 1; }

    c->set("greeting", "hello");
    char* v = c->get("greeting");                             // a heap string: free it. null when the key does not exist
    printf("greeting = %s\n", v);
    free(v);
    printf("a key that is not there: %s\n", c->get("nokey") == null ? "null" : "a value");

    // Counters: the value is text, INCR reads it as a number. A missing key counts as 0.
    printf("incr: %d, %d, incrBy 10: %d, decr: %d\n", c->incr("visits"), c->incr("visits"), c->incrBy("visits", 10), c->decr("visits"));
    int bad = c->incr("greeting");
    printf("incr on text: %d, error: %s\n", bad, c->error);

    printf("append: %d, then %d\n", c->append("log", "ab"), c->append("log", "cde"));
    printf("strLength(log) = %d\n", c->strLength("log"));

    c->mset("a", "1", "b", "2");                              // several keys in one round trip
    redis.Reply* r = c->mget("a", "missing", "b");            // an array reply, one element per key
    for (int i = 0; i < r->count; i++) {
        redis.Reply* e = r->elems[i];
        printf("mget[%d]: %s\n", i, e->type == redis.T_NIL ? "(nil)" : e->str);
    }
    r->dispose();                                             // every Reply is yours to dispose

    printf("exists: %d, del: %d, exists again: %d, del again: %d\n", c->exists("a"), c->del("a"), c->exists("a"), c->del("a"));

    // Values are binary safe: a 0 byte, CR and LF inside are fine. Use the length, not strlen.
    char blob[6];
    blob[0] = 'x'; blob[1] = 0; blob[2] = 13; blob[3] = 10; blob[4] = 255; blob[5] = 'y';
    c->setBin("blob", &blob[0], 6);
    int len = 0;
    char* back = c->getBin("blob", &len);
    printf("blob: %d bytes, same: %d, strlen would say %d\n", len, memcmp(back, &blob[0], 6) == 0 ? 1 : 0, strlen(back));
    free(back);
    printf("keys in the database: %d\n", c->dbsize());
    c->dispose();
    server->shutdown();
    return 0;
}
