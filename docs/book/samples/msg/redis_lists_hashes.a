// Lists as queues and hashes as records
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

void showList(char* title, redis.Reply* r) {
    printf("%s:", title);
    for (int i = 0; i < r->count; i++) printf(" %s", r->elems[i]->str);
    printf("\n");
    r->dispose();
}

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);

    // A list is ordered. RPUSH adds at the right end, LPUSH at the left; the results are the new length.
    c->rpush("jobs", "resize");
    c->rpush("jobs", "convert");
    c->rpush("jobs", "upload");
    printf("lpush urgent: length %d\n", c->lpush("jobs", "urgent"));
    showList("all jobs     ", c->lrange("jobs", 0, -1));       // -1 means "up to the last"
    showList("first two    ", c->lrange("jobs", 0, 1));

    // A queue: producers RPUSH, a worker takes from the left with LPOP
    char* job = c->lpop("jobs");
    printf("worker takes: %s, %d left\n", job, c->llen("jobs"));
    free(job);
    job = c->rpop("jobs");                                    // RPOP makes a stack of it: the newest first
    printf("rpop takes: %s\n", job);
    free(job);
    free(c->lpop("jobs"));  free(c->lpop("jobs"));           // empty the list
    printf("pop from an empty list: %s\n", c->lpop("jobs") == null ? "null" : "a value");

    // A hash is a small record: named fields with text values
    c->hset("user:1", "name", "Ada");
    c->hset("user:1", "language", "A");
    printf("hset a new field: %d, an existing one: %d\n", c->hset("user:1", "year", "1843"), c->hset("user:1", "year", "1844"));
    char* name = c->hget("user:1", "name");
    char* year = c->hget("user:1", "year");
    printf("name %s, year %s, no such field: %s\n", name, year, c->hget("user:1", "email") == null ? "null" : "?");
    free(name);  free(year);

    // HGETALL returns a flat array: field, value, field, value ...  in no particular order
    redis.Reply* all = c->hgetall("user:1");
    int total = 0;
    for (int i = 0; i + 1 < all->count; i += 2) {
        if (streq(all->elems[i]->str, "language")) printf("language is %s\n", all->elems[i + 1]->str);
        total++;
    }
    printf("fields: %d, removing one: %d\n", total, c->hdel("user:1", "year"));
    all->dispose();
    c->dispose();
    server->shutdown();
    return 0;
}
