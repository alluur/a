// What can go wrong: error replies, commands redisd does not have, a password, a full server
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }
int port;

char* kind(redis.Reply* r) {
    char* names[8];
    names[redis.T_STATUS] = "status";  names[redis.T_ERROR] = "error";  names[redis.T_INT] = "integer";  names[redis.T_BULK] = "bulk string";
    names[redis.T_ARRAY] = "array";  names[redis.T_NIL] = "nil";  names[redis.T_NILARRAY] = "nil array";  names[0] = "?";
    return names[r->type];
}

// one command and its reply: the type, and the text or number
void showCall(redis.Client* c, char* name, char* arg) {
    char label[40];
    format(&label[0], 40, "%s %s", name, arg == null ? "" : arg);
    redis.Reply* r = c->call(name, arg);
    if (r->type == redis.T_INT) printf("%-12s -> %-11s %d\n", &label[0], kind(r), r->num);
    else printf("%-12s -> %-11s %s\n", &label[0], kind(r), r->str);
    r->dispose();
}

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    port = server->port;
    net.setIdleHook(serve);
    char url[100];
    format(&url[0], 100, "redis://127.0.0.1:%d", port);
    redis.Client* c = redis.connect(&url[0]);

    // 1. An error reply is a Reply like any other. call() returns null only when the connection itself failed.
    c->rpush("list", "a");
    showCall(c, "PING", null);
    showCall(c, "LLEN", "list");
    showCall(c, "GET", "list");                                // a list is not a string
    showCall(c, "GET", null);                                  // an argument is missing
    showCall(c, "NOSUCH", "x");

    // 2. Commands that real Redis has and redisd does not: the answer is always "unknown command"
    println("\nnot in redisd:");
    char* missing[8];
    missing[0] = "HINCRBY"; missing[1] = "HMGET"; missing[2] = "ZREVRANGE"; missing[3] = "ZINCRBY";
    missing[4] = "SINTER"; missing[5] = "SCAN"; missing[6] = "GETDEL"; missing[7] = "EVAL";
    for (int i = 0; i < 8; i++) {
        redis.Reply* r = c->call(missing[i], "k", "a", "1");
        printf("  %-10s %s\n", missing[i], startsWith(r->str, "ERR unknown command") ? "unknown command" : r->str);
        r->dispose();
    }

    // 3. A password: requirepass. Without it every command answers NOAUTH.
    server->store->requirepass = "s3cret";
    redis.Client* anon = redis.connect(&url[0]);
    redis.Reply* r = anon->call("PING");
    printf("\nno password: %s\n", r->str);
    r->dispose();
    char authUrl[100];
    format(&authUrl[0], 100, "redis://:s3cret@127.0.0.1:%d/3", port);       // password, and database 3
    redis.Client* d3 = redis.connect(&authUrl[0]);
    printf("with the password in the URL: ping %d\n", d3->ping() ? 1 : 0);
    format(&authUrl[0], 100, "redis://:wrong@127.0.0.1:%d", port);
    printf("wrong password: %s\n", redis.connect(&authUrl[0]) == null ? redis.error() : "connected?");
    server->store->requirepass = null;

    // 4. 16 databases: the number after the host. Keys do not cross.
    d3->set("only-in-3", "yes");
    printf("database 3 has %d key, database 0 has %d key(s)\n", d3->dbsize(), c->dbsize());

    // 5. maxMemory: over the limit writes are refused (OOM), reads and deletes still work
    server->store->maxMemory = 5000;
    c->set("big", "x");
    char* chunk = alloc(1001);
    memset(chunk, 'y', 1000);
    int stored = 0;
    for (int i = 0; i < 20; i++) {
        char key[16];
        format(&key[0], 16, "k%d", i);
        if (!c->set(&key[0], chunk)) { printf("write %d refused: %s\n", i, c->error); break; }
        stored++;
    }
    printf("stored %d values, reading still works: %s\n", stored, c->get("k0") == null ? "no" : "yes");
    c->dispose();
    server->shutdown();
    return 0;
}
