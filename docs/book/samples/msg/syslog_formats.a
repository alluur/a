// syslog messages: RFC 5424 and RFC 3164, built and parsed, with no network at all
import syslog;

int TS = 1065910455;                                          // 2003-10-11 22:14:15 UTC, a fixed time so the output never changes

void describe(char* text) {
    syslog.Message m;                                         // parse() fills it in; the strings in it are copies
    int rc = syslog.parse(text, strlen(text), &m, TS);        // TS: the clock that guesses the year of an RFC 3164 time stamp
    printf("%s\n", text);
    if (rc != 0) { printf("    error: %s\n", syslog.errorText(rc)); return; }
    char body[100];
    int n = m.msgLen < 99 ? m.msgLen : 99;
    memcpy(&body[0], m.msg, n);                               // msg points into our text and is not 0 terminated: copy it
    body[n] = 0;
    printf("    %s.%s, RFC %d, host \"%s\", app \"%s\", pid \"%s\", id \"%s\", time %d, text \"%s\"\n",
        syslog.facilityName(m.facility), syslog.severityName(m.severity), m.version == 1 ? 5424 : 3164,
        &m.host[0], &m.app[0], &m.procid[0], &m.msgid[0], m.timestamp, &body[0]);
}

int main() {
    char buf[512];
    // The priority is facility * 8 + severity: auth (4) and crit (2) make <34>
    char* text = "'su root' failed on /dev/pts/8";
    syslog.build5424(&buf[0], 512, syslog.FAC_AUTH, syslog.SEV_CRIT, TS, 0, "mymachine", "su", "-", "ID47", "-", text, strlen(text));
    printf("build5424: %s\n", &buf[0]);
    char old[512];
    syslog.build3164(&old[0], 512, syslog.FAC_AUTH, syslog.SEV_CRIT, TS, "mymachine", "su", 123, text, strlen(text));
    printf("build3164: %s\n\n", &old[0]);

    println("parse, in either format:");
    describe(&buf[0]);
    describe(&old[0]);
    describe("<165>1 2003-08-24T05:14:15.000003-07:00 192.0.2.1 myproc 8710 - - %% It's time to make the do-nuts.");
    describe("just text, no priority at all");                 // taken as user.notice
    describe("<999>1 2003-10-11T22:14:15Z h a - - - x");       // priority over 191
    describe("<34>1 2003-02-30T22:14:15Z h a - - - x");        // February 30th

    // Structured data: [id name="value" ...], with escaping of " \ and ]
    char sd[200];
    int sdLen = 0;
    char* names[2];   names[0] = "user";   names[1] = "note";
    char* values[2];  values[0] = "ada";   values[1] = "said \"hi\" [twice]";
    syslog.buildSd(&sd[0], 200, &sdLen, "login@32473", &names[0], &values[0], 2);
    printf("\nstructured data: %s\n", &sd[0]);
    int n = syslog.build5424(&buf[0], 512, syslog.FAC_AUTH, syslog.SEV_INFO, TS, 0, "mymachine", "sshd", "4711", "LOGIN", &sd[0], "accepted", 8);
    syslog.Message m;
    syslog.parse(&buf[0], n, &m, TS);
    char value[100];
    syslog.sdParam(m.sd, m.sdLen, "login@32473", "note", &value[0], 100);
    printf("sdParam note: %s\n", &value[0]);

    // Header fields are cleaned: blanks and control characters become _, empty fields become -
    n = syslog.build5424(&buf[0], 512, syslog.FAC_USER, syslog.SEV_INFO, TS, 0, "my host", "", "1 2", "-", "-", "x", 1);
    printf("cleaned header: %s\n", &buf[0]);
    return 0;
}
