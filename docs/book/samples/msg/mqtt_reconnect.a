// The non-blocking client: callbacks, poll(), and a connection that comes back by itself
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

int received = 0;
int connects = 0;
int losses = 0;

// called from poll(): the payload is valid during the call and followed by a 0 byte
int onMessage(mqtt.Client* c, char* topic, char* payload, int n, int qos, int retain) {
    received++;
    printf("  message: %s = %s\n", topic, payload);
    return 0;
}
int onConnect(mqtt.Client* c, int sessionPresent) {
    connects++;
    printf("  connected (session present: %d, connection number %d)\n", sessionPresent, connects);
    return 0;
}
int onDisconnect(mqtt.Client* c, int willRetry) {
    losses++;
    printf("  connection lost (will retry: %d)\n", willRetry);
    return 0;
}

// serve the client's connection until the counters have reached these values (or 1.5 s have passed)
bool until(mqtt.Client* c, int wantReceived, int wantConnects, int wantLosses) {
    int t0 = millis();
    while (millis() - t0 < 1500) {
        c->poll(5);
        broker->poll(0);
        if (received >= wantReceived && connects >= wantConnects && losses >= wantLosses) return true;
    }
    return false;
}

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    mqtt.Options o();
    o.clientId = "monitor";
    o.autoReconnect = true;                                  // after a lost connection, poll() connects again
    o.reconnectMinMs = 20;                                   // the pause before the first retry; it doubles up to reconnectMaxMs
    mqtt.Client* c = mqtt.newClient("127.0.0.1", broker->port, &o);
    c->onMessage = onMessage;
    c->onConnect = onConnect;
    c->onDisconnect = onDisconnect;
    println("connect:");
    c->connect();
    c->subscribe("plant/#", 1);                              // returns at once; the SUBACK is handled by poll()
    until(c, 0, 1, 0);

    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    mqtt.Client* pub = mqtt.connect(&url[0]);
    pub->publishWait("plant/pump", "on", 2, 1, false, 2000);
    println("publish, poll:");
    until(c, 1, 1, 0);

    println("the broker drops every client:");
    broker->dropClients();
    until(c, 1, 1, 1);
    println("poll until the client is back:");
    until(c, 1, 2, 1);                                       // reconnects; the clean session is lost, so the client subscribes again

    pub->dispose();
    pub = mqtt.connect(&url[0]);                             // the publisher was dropped too
    pub->publishWait("plant/pump", "off", 3, 1, false, 2000);
    until(c, 2, 2, 1);
    printf("messages received: %d, reconnects: %d\n", received, c->reconnects);
    broker->shutdown();
    return 0;
}
