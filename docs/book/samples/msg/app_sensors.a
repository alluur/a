// Application: temperature sensors publish over MQTT, a monitor writes them to syslog
import mqtt;
import mqttd;
import syslog;
import syslogd;
import net;

mqttd.Server* broker;
syslogd.Server* collector;
int serve() { broker->poll(0); collector->poll(0); return 0; }     // both servers live in the idle hook

mqtt.Client* monitor;
syslog.Sender* log;

// A sensor: its will says "offline" if it vanishes, and it announces itself as "online" (both retained)
mqtt.Client* sensor(char* room, int port) {
    char id[40], will[60], url[60];
    format(&id[0], 40, "sensor-%s", room);
    format(&will[0], 60, "sensors/%s/status", room);
    format(&url[0], 60, "mqtt://127.0.0.1:%d", port);
    mqtt.Options o();
    o.clientId = &id[0];
    o.willTopic = &will[0];  o.willPayload = "offline";  o.willQos = 1;  o.willRetain = true;
    mqtt.Client* c = mqtt.connectWith(&url[0], &o);
    c->publishWait(&will[0], "online", 6, 1, true, 2000);
    return c;
}

void reading(mqtt.Client* s, char* room, char* value) {
    char topic[60];
    format(&topic[0], 60, "sensors/%s/temperature", room);
    s->publishWait(&topic[0], value, strlen(value), 1, false, 2000);
}

// The monitor's whole job: one message in, one syslog line out. The severity follows the reading.
void handle(mqtt.Message* m) {
    char text[120];
    format(&text[0], 120, "%s = %s", m->topic, m->payload);
    if (endsWith(m->topic, "/status")) {
        log->send(streq(m->payload, "offline") ? syslog.SEV_WARNING : syslog.SEV_NOTICE, &text[0]);
    } else {
        int t = atoi(m->payload);
        log->send(t >= 40 ? syslog.SEV_CRIT : (t >= 30 ? syslog.SEV_WARNING : syslog.SEV_INFO), &text[0]);
    }
    m->dispose();
}

void drain() {                                                 // handle messages until nothing comes for 100 ms
    mqtt.Message* m = monitor->waitMessage(100);
    while (m != null) { handle(m); m = monitor->waitMessage(100); }
}

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;  broker->listenOn("127.0.0.1", 0, null);
    collector = syslogd.newServer();
    collector->collector->setClock(1065910455);  collector->listenUdp(0);
    syslogd.Filter* worse = syslogd.newFilter();                // a second ring that only keeps warnings and worse: the alerts
    worse->setSeverityUpTo(syslog.SEV_WARNING);
    syslogd.Ring* alerts = collector->collector->addRing(worse, 100, 65536);
    net.setIdleHook(serve);

    char url[80];
    format(&url[0], 80, "udp://127.0.0.1:%d", collector->udpPort);
    log = syslog.newSender(&url[0]);
    log->setHostName("plant1");  log->setApp("monitor", "1");  log->now = 1065910455;

    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    monitor = mqtt.connect(&url[0]);
    monitor->subscribeWait("sensors/#", 1, 2000);              // temperatures and status messages

    mqtt.Client* kitchen = sensor("kitchen", broker->port);
    mqtt.Client* attic = sensor("attic", broker->port);
    drain();
    reading(kitchen, "kitchen", "21");  drain();
    reading(attic, "attic", "36");      drain();
    reading(kitchen, "kitchen", "44");  drain();
    kitchen->disconnect();  kitchen->dispose();                // a clean goodbye: no will
    attic->dispose();                                          // a crash: the broker sends the will
    drain();

    int quiet = 0;
    while (quiet < 20) { if (collector->poll(1) == 0) quiet++; else quiet = 0; }      // the collector reads what is left
    syslogd.Ring* all = collector->collector->ring;
    println("everything the monitor logged:");
    for (int i = 0; i < all->count(); i++) printf("  [%-7s] %s\n", syslog.severityName(all->severityOf(i)), all->line(i));
    printf("the alert ring has %d of %d lines\n", alerts->count(), all->count());
    return 0;
}
