// Topic filters with + and #
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

void match(char* filter, char* topic) {
    printf("  %-18s %-22s %s\n", filter, topic, mqtt.topicMatches(filter, topic) ? "match" : "-");
}

int main() {
    // 1. The matching rule alone: a pure function, no network
    println("topicMatches(filter, topic):");
    match("sport/+/score", "sport/tennis/score");
    match("sport/+/score", "sport/tennis/court1/score");        // + is exactly one level
    match("sport/#", "sport");                                  // # also matches its parent
    match("sport/#", "sport/tennis/score");
    match("#", "$SYS/broker/uptime");                           // topics that start with $ are not for # or +
    match("$SYS/#", "$SYS/broker/uptime");
    match("+/status", "kitchen/status");

    // 2. The same through a broker
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    mqtt.Client* sub = mqtt.connect(&url[0]);
    mqtt.Client* pub = mqtt.connect(&url[0]);
    sub->subscribeWait("home/+/temperature", 0, 2000);
    sub->subscribeWait("alerts/#", 0, 2000);

    char* topics[6];
    topics[0] = "home/kitchen/temperature";
    topics[1] = "home/attic/temperature";
    topics[2] = "home/kitchen/humidity";                       // wrong last level
    topics[3] = "home/kitchen/oven/temperature";               // one level too many
    topics[4] = "alerts";
    topics[5] = "alerts/fire/kitchen";
    println("\npublished, then received:");
    for (int i = 0; i < 6; i++) {
        pub->publishWait(topics[i], "1", 1, 0, false, 2000);
        mqtt.Message* m = sub->waitMessage(60);
        printf("  %-30s %s\n", topics[i], m == null ? "not delivered" : "delivered");
        if (m != null) m->dispose();
    }

    // 3. Bad topics and filters are refused by the client, before anything is sent
    println("");
    printf("publish to a topic with a wildcard: %d (%s)\n", pub->publishText("home/+/x", "1", 0, false), pub->error);
    printf("subscribe to a#: %d (%s)\n", sub->subscribe("a#", 0), sub->error);
    printf("subscribe to a/#/b: %d (%s)\n", sub->subscribe("a/#/b", 0), sub->error);
    broker->shutdown();
    return 0;
}
