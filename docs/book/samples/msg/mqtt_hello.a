// MQTT: a broker, a subscriber and a publisher in one program
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;

// The broker lives in the idle hook: whenever a client has to wait for the network,
// net calls this function and the broker serves its sockets (see the web services chapter).
int serve() { broker->poll(0); return 0; }

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;                       // no $SYS topics: they would be noise here
    broker->listenOn("127.0.0.1", 0, null);                  // port 0: the system picks one, broker->port tells which
    net.setIdleHook(serve);

    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);
    printf("the broker listens on an ephemeral port: %s\n", broker->port > 1023 ? "yes" : "no");

    mqtt.Client* sub = mqtt.connect(&url[0]);                // blocks until the CONNACK is there; null on failure
    mqtt.Client* pub = mqtt.connect(&url[0]);
    if (sub == null || pub == null) { println(mqtt.error()); return 1; }
    printf("clients connected: %d\n", broker->clients());

    int granted = sub->subscribeWait("kitchen/temperature", 0, 2000);
    printf("subscribed, granted QoS %d\n", granted);

    pub->publishWait("kitchen/temperature", "21.5", 4, 0, false, 2000);

    mqtt.Message* m = sub->waitMessage(2000);                // null after 2 s without a message
    if (m != null) {
        printf("%s = %s (QoS %d, retained %d)\n", m->topic, m->payload, m->qos, m->retain);
        m->dispose();
    }
    printf("nothing else waits: %s\n", sub->waitMessage(50) == null ? "true" : "false");

    pub->disconnect();  pub->dispose();
    sub->disconnect();  sub->dispose();
    broker->shutdown();
    return 0;
}
