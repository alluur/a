// MQTT packets as bytes, and a broker that has no sockets at all
import mqtt;
import mqttd;
import netio;
import encoding;

void dump(char* what, netio.Queue* q) {
    printf("%-26s %s\n", what, encoding.hexEncode(q->data(), q->pending()));
}

int main() {
    // 1. Packets are built into a queue of bytes
    netio.Queue q;
    mqtt.Packet k;
    k.reset();
    k.clientId = "demo";
    k.clean = true;
    k.keepAlive = 10;
    mqtt.putConnect(&q, &k);
    dump("CONNECT", &q);
    netio.Queue q2;
    mqtt.putPublish(&q2, "a/b", "hi", 2, 1, true, false, 7);        // topic, payload, length, QoS 1, retain, no DUP, packet id 7
    dump("PUBLISH QoS 1 retained", &q2);

    // 2. The parser takes bytes in any pieces and hands out whole packets
    mqtt.Parser* p = mqtt.newParser(mqtt.MODE_SERVER, 65536);
    mqtt.Packet r;
    r.reset();
    char* d = q2.data();
    int n = q2.pending();
    for (int i = 0; i < n; i += 3) {
        p->feed(&d[i], n - i < 3 ? n - i : 3);
        int got = p->next(&r);
        printf("fed %2d bytes: %s\n", i + 3 < n ? i + 3 : n, got == 1 ? "a packet" : "more needed");
    }
    printf("%s, topic %s, payload %s, QoS %d, retain %d, packet id %d\n", mqtt.typeName(r.type), r.topic, r.payload, r.qos, r.retain, r.pid);

    // 3. The broker is a state machine too: open() makes a peer, feed() runs bytes, peer->out holds the answer
    mqttd.Broker* b = new mqttd.Broker();
    b->sysIntervalMs = 0;
    b->setClock(0);                                           // the broker has no clock of its own here: we set it
    mqttd.Peer* peer = b->open(0);
    b->feed(peer, q.data(), q.pending());
    dump("the broker answers", peer->out);                    // CONNACK: session present 0, return code 0
    peer->out->clear();

    // 4. Keep-alive is checked against that clock: silence for 1.5 times the interval ends the connection
    b->tick(14000);
    printf("after 14 s of silence: connection closed %d\n", peer->wantClose ? 1 : 0);
    b->tick(15001);
    printf("after 15 s of silence: connection closed %d (timeouts counted: %d)\n", peer->wantClose ? 1 : 0, b->stats->timeouts);
    return 0;
}
