// The last will: a message the broker sends when a client vanishes
import mqtt;
import mqttd;
import net;

mqttd.Server* broker;
int serve() { broker->poll(0); return 0; }

// a client that declares a will: if its connection ends without DISCONNECT, the broker publishes it
mqtt.Client* sensor(char* url, char* id) {
    mqtt.Options o();                                        // () runs the constructor that sets the defaults
    o.clientId = id;
    o.willTopic = "status/sensor";
    o.willPayload = "offline";
    o.willQos = 1;
    o.willRetain = true;                                     // a late subscriber also learns that the sensor is gone
    return mqtt.connectWith(url, &o);
}

int main() {
    broker = mqttd.newServer();
    broker->broker->sysIntervalMs = 0;
    broker->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "mqtt://127.0.0.1:%d", broker->port);

    mqtt.Client* watcher = mqtt.connect(&url[0]);
    watcher->subscribeWait("status/#", 1, 2000);

    // 1. A polite client says goodbye: no will
    mqtt.Client* s1 = sensor(&url[0], "sensor-1");
    s1->publishWait("status/sensor", "online", 6, 1, true, 2000);
    s1->disconnect();                                        // DISCONNECT: the will is thrown away
    s1->dispose();
    mqtt.Message* m = watcher->waitMessage(2000);
    printf("sensor-1 says: %s\n", m->payload);
    m->dispose();
    printf("after its DISCONNECT: %s\n", watcher->waitMessage(100) == null ? "no will was sent" : "a will arrived");

    // 2. A client whose connection just breaks: the broker publishes the will for it
    mqtt.Client* s2 = sensor(&url[0], "sensor-2");
    s2->publishWait("status/sensor", "online", 6, 1, true, 2000);
    m = watcher->waitMessage(2000);
    printf("sensor-2 says: %s\n", m->payload);
    m->dispose();
    s2->dispose();                                           // closes the socket without DISCONNECT (a crash, a cable)
    m = watcher->waitMessage(2000);
    printf("then the will arrives: %s (QoS %d, retained %d)\n", m->payload, m->qos, m->retain);
    m->dispose();

    // 3. The will was retained: a new subscriber sees it at once
    mqtt.Client* late = mqtt.connect(&url[0]);
    late->subscribeWait("status/sensor", 1, 2000);
    m = late->waitMessage(2000);
    printf("a late subscriber reads: %s (retained %d)\n", m->payload, m->retain);
    m->dispose();
    broker->shutdown();
    return 0;
}
