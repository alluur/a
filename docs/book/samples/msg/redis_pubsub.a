// Publish and subscribe: channels and patterns
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

void show(redis.PubMessage* m) {
    if (m == null) { println("  nothing"); return; }
    if (m->pattern == null) printf("  channel %s: %s\n", m->channel, m->data);
    else printf("  pattern %s matched channel %s: %s\n", m->pattern, m->channel, m->data);
    m->dispose();
}

// subscribe() and unsubscribe() return when the command is SENT. The server's confirmation is read by next(),
// and sub->channels follows it. So: read until the number is what we expect, before anybody publishes.
void settle(redis.PubSub* s, int want) {
    while (s->channels != want) s->next(20);
}

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);                 // for commands, and for PUBLISH

    // A subscriber needs a connection of its own: in RESP2 a subscribed connection can do nothing else.
    // redis.pubsub(c) opens that second connection for you, with the same address and settings.
    redis.PubSub* sub = redis.pubsub(c);
    sub->subscribe("news");
    sub->psubscribe("log.*");                                 // a pattern: * ? and [a-z] work like in KEYS
    settle(sub, 2);
    printf("subscriptions the server counts: %d\n", sub->channels);

    // PUBLISH answers with the number of subscribers that got the message
    printf("publish to news: %d receiver(s)\n", c->publish("news", "hello"));
    printf("publish to log.error: %d receiver(s)\n", c->publish("log.error", "disk full"));
    printf("publish to weather: %d receiver(s)\n", c->publish("weather", "rain"));

    println("what the subscriber reads:");
    show(sub->next(1000));                                    // waits up to 1000 ms; null on time out
    show(sub->next(1000));
    show(sub->next(100));

    // A message that matches a channel AND a pattern of the same client arrives twice
    sub->subscribe("log.error");
    settle(sub, 3);
    printf("publish to log.error again: %d receiver(s)\n", c->publish("log.error", "again"));
    show(sub->next(1000));
    show(sub->next(1000));

    sub->unsubscribe("news");
    settle(sub, 2);
    printf("after unsubscribe, publish to news: %d receiver(s)\n", c->publish("news", "x"));

    // Messages are not stored: a subscriber that is not there misses them
    sub->dispose();
    int quiet = 0;
    while (quiet < 10) { if (server->poll(1) == 0) quiet++; else quiet = 0; }      // let the server see the closed connection
    printf("with nobody subscribed: %d receiver(s)\n", c->publish("log.error", "lost"));
    c->dispose();
    server->shutdown();
    return 0;
}
