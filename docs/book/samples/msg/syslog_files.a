// A collector that writes log files and rotates them
import syslog;
import syslogd;
import asys;

int TS = 1065910455;
syslogd.Server* server;

void settle() {
    int quiet = 0;
    while (quiet < 20) { if (server->poll(1) == 0) quiet++; else quiet = 0; }
}

void showFile(char* path) {
    if (!asys.exists(path)) { printf("%s: no such file\n", path); return; }
    printf("%s:\n", path);
    char* text = readFile(path);                              // the whole file as a string
    printf("%s", text);
}

int main() {
    server = syslogd.newServer();
    syslogd.Collector* col = server->collector;
    col->setClock(TS);
    server->listenUdp(0);

    // Only warnings and worse go to the file. It may grow to 90 bytes; then it is renamed to app.log.1
    // (the older ones move on to .2 ...) and a new app.log starts. At most 2 old files are kept.
    syslogd.Filter* f = syslogd.newFilter();
    f->setSeverityUpTo(syslog.SEV_WARNING);
    syslogd.FileSink* file = col->addFile(f, "app.log", 90, 2);

    char url[80];
    format(&url[0], 80, "udp://127.0.0.1:%d", server->udpPort);
    syslog.Sender* s = syslog.newSender(&url[0]);
    s->setHostName("web1");
    s->setApp("shop", "42");
    s->now = TS;
    for (int i = 1; i <= 16; i++) {
        char text[40];
        format(&text[0], 40, "event %d", i);
        // odd numbers are warnings, even ones are only info: the filter keeps the warnings
        if (i % 2 == 1) s->warning(&text[0]); else s->info(&text[0]);
        settle();                                             // one message at a time, so the file sees them in order
    }
    printf("lines written: %d, rotations: %d, file size now: %d bytes\n\n", file->lines, file->rotations, file->fileSize());
    file->close();                                            // flush and release the file before we read it
    showFile("app.log");
    showFile("app.log.1");
    showFile("app.log.2");
    showFile("app.log.3");
    s->dispose();
    server->shutdown();
    return 0;
}
