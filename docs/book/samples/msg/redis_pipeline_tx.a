// Pipelines (many commands, one round trip) and transactions (MULTI / EXEC)
import redis;
import redisd;
import net;

redisd.Server* server;
int serve() { server->poll(0); return 0; }

void show(redis.Reply* r) {                                   // one reply, in a line
    if (r->type == redis.T_INT) printf("  integer %d\n", r->num);
    else if (r->type == redis.T_ERROR) printf("  error   %s\n", r->str);
    else if (r->type == redis.T_NIL) printf("  nil\n");
    else printf("  %s\n", r->str);
}

int main() {
    server = redisd.newServer();
    server->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "redis://127.0.0.1:%d", server->port);
    redis.Client* c = redis.connect(&url[0]);

    c->set("title", "A book");

    // A pipeline sends all commands in ONE write and then reads all the replies.
    redis.Pipeline* p = redis.pipeline(c);
    p->add("SET", "stock", "10");
    p->add("INCR", "stock");
    p->add("INCR", "title");                                   // fails: "A book" is not a number
    p->add("GET", "stock");
    printf("queued %d commands, run: %d\n", p->count, p->run() ? 1 : 0);
    println("replies of the pipeline (an error in the middle does not stop the rest):");
    for (int i = 0; i < p->got; i++) show(p->reply(i));
    p->dispose();

    // A transaction: the commands are QUEUED, EXEC runs them together. Nobody else's command runs in between.
    println("\nMULTI ... EXEC:");
    c->multi();
    redis.Reply* q = c->call("SET", "balance", "100");
    printf("  while queueing, SET answers: %s\n", q->str);
    q->dispose();
    c->call("INCR", "balance")->dispose();
    c->call("INCR", "title")->dispose();                       // fails when it runs, but ...
    c->call("GET", "balance")->dispose();
    redis.Reply* r = c->exec();
    for (int i = 0; i < r->count; i++) show(r->elems[i]);      // ... there is no rollback: the others ran anyway
    r->dispose();

    println("\nDISCARD:");
    c->multi();
    c->call("SET", "balance", "0")->dispose();
    c->discard();
    char* b = c->get("balance");
    printf("  balance is still %s\n", b);
    free(b);

    println("\na command that is wrong while queueing aborts the whole transaction:");
    c->multi();
    c->call("SET", "balance", "5")->dispose();
    c->call("NOSUCHCOMMAND")->dispose();
    r = c->exec();
    show(r);
    r->dispose();
    b = c->get("balance");
    printf("  balance is %s\n", b);
    free(b);
    c->dispose();
    server->shutdown();
    return 0;
}
