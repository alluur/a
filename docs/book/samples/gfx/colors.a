// Colours: rgb, argb, mix, lighten and darken
// book: shot=out.png
import gfx;
import gimg;

int main() {
    int orange = gfx.rgb(240, 140, 20);
    printf("orange = %#x: red %d, green %d, blue %d, alpha %d\n",
           orange, gfx.red(orange), gfx.green(orange), gfx.blue(orange), gfx.alpha(orange));

    int glass = gfx.withAlpha(orange, 128);
    printf("half transparent: %#x\n", glass);
    printf("argb(255, ...) equals rgb(...): %d\n", gfx.argb(255, 240, 140, 20) == orange);

    gfx.Surface* s = new gfx.Surface(256, 96);
    s->clear(gfx.WHITE);
    // mix(a, b, t): t = 0 gives a, t = 255 gives b
    for (int x = 0; x < 256; x++) {
        s->vline(x, 0, 32, gfx.mix(gfx.BLUE, gfx.YELLOW, x));
        s->vline(x, 32, 32, gfx.lighten(gfx.BLUE, x));
        s->vline(x, 64, 32, gfx.darken(gfx.YELLOW, x));
    }
    printf("mix at 0, 128, 255: %#x %#x %#x\n",
           gfx.mix(gfx.BLUE, gfx.YELLOW, 0), gfx.mix(gfx.BLUE, gfx.YELLOW, 128), gfx.mix(gfx.BLUE, gfx.YELLOW, 255));
    gimg.savePng(s, "out.png");
    return 0;
}
