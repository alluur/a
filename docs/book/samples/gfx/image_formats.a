// Three file formats: PPM, BMP and PNG
// book: shot=out.png
import gfx;
import gimg;
import os;

int main() {
    gfx.Surface* s = new gfx.Surface(64, 40);
    s->clear(gfx.WHITE);
    s->fillCircle(20, 20, 14, gfx.BLUE);
    s->fillRoundRect(30, 8, 28, 24, 6, gfx.argb(255, 224, 80, 60));

    s->savePPM("a.ppm");                                 // 3 bytes per pixel, a short text header
    s->saveBMP("a.bmp");                                 // 24 bit, rows padded to 4 bytes
    gimg.savePng(s, "a.png");                            // 4 bytes per pixel plus a little overhead
    printf("ppm %d bytes, bmp %d bytes, png %d bytes\n", os.fileSize("a.ppm"), os.fileSize("a.bmp"), os.fileSize("a.png"));
    printf("64 * 40 * 3 = %d\n", 64 * 40 * 3);

    // gimg.load() reads all three, whatever the file is called
    char* names[3] = {"a.ppm", "a.bmp", "a.png"};
    for (int i = 0; i < 3; i++) {
        gfx.Surface* t = gimg.load(names[i]);
        printf("%s: %d x %d, same pixels: %d\n", names[i], t->w, t->h, t->checksum() == s->checksum());
    }

    // a PPM can be written by hand: P3 is the text form
    char* text = "P3\n3 1\n255\n255 0 0   0 255 0   0 0 255\n";
    gfx.Surface* tiny = gimg.decode(text, strlen(text));
    printf("hand made: %d x %d, pixels %#x %#x %#x\n", tiny->w, tiny->h, tiny->get(0, 0), tiny->get(1, 0), tiny->get(2, 0));
    gimg.savePng(s, "out.png");
    return 0;
}
