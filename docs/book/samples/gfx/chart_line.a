// A line chart with a fixed range
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    gchart.Chart* c = new gchart.Chart(gchart.LINE);
    int sine = c->addSeries("sine", 0);
    int saw = c->addSeries("saw", 0);
    for (int i = 0; i < 40; i++) {
        c->push(sine, 50 + 40 * gfx.isin(i * 18) / 1024);    // one point per call
        c->push(saw, (i * 7) % 100);
    }
    c->setRange(0, 100);                                 // otherwise the axis is chosen from the data
    c->title = "Two signals";
    c->w = 340;
    c->h = 180;
    printf("points per series: %d and %d\n", c->pointCount(sine), c->pointCount(saw));
    printf("last values: %d and %d\n", c->valueAt(sine, 39), c->valueAt(saw, 39));

    gfx.Surface* s = new gfx.Surface(360, 200);
    s->clear(gui.cBack);
    c->paint(s, 10, 10);
    gimg.savePng(s, "out.png");
    return 0;
}
