// A bar chart: two series, side by side and stacked
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    char* quarters[4] = {"Q1", "Q2", "Q3", "Q4"};
    int sales[4] = {30, 45, 38, 60};
    int costs[4] = {20, 25, 30, 35};

    gchart.Chart* side = new gchart.Chart(gchart.BAR);
    int a = side->addSeries("Sales", 0);                 // colour 0: the next colour of the palette
    int b = side->addSeries("Costs", 0);
    side->setValues(a, sales, 4);
    side->setValues(b, costs, 4);
    side->setLabels(quarters, 4);
    side->title = "Side by side";

    gchart.Chart* stacked = new gchart.Chart(gchart.BAR);
    stacked->addSeries("Sales", 0xFF58A55C);             // or give the colour yourself
    stacked->addSeries("Costs", 0xFFF0A030);
    stacked->setValues(0, sales, 4);
    stacked->setValues(1, costs, 4);
    stacked->setLabels(quarters, 4);
    stacked->stacked = true;
    stacked->title = "Stacked";

    printf("series %d, points %d, value at 3: %d\n", side->seriesCount(), side->pointCount(a), side->valueAt(a, 3));

    // a chart is a widget; without a window it still paints into any surface, at the size you give it
    gfx.Surface* s = new gfx.Surface(500, 170);
    s->clear(gui.cBack);
    side->w = 240;
    side->h = 150;
    stacked->w = 240;
    stacked->h = 150;
    side->paint(s, 10, 10);
    stacked->paint(s, 250, 10);
    gimg.savePng(s, "out.png");
    return 0;
}
