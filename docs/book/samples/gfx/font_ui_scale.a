// Changing the size of the shared fonts for a whole program
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Font* ui = gfx.sans();                           // widgets hold this very pointer
    gfx.Surface* s = new gfx.Surface(280, 134);
    s->clear(gfx.WHITE);

    printf("start: scale %d %%, height %d, width %d\n", gfx.uiFontScale(), ui->height, gfx.textWidth(ui, "Settings"));
    s->text(ui, 10, 6, "Settings (100 %)", gfx.BLACK);

    gfx.setFontScales(150, 100);                         // sans and sans bold 150 %, mono 100 %
    printf("after: scale %d %%, height %d, width %d\n", gfx.uiFontScale(), ui->height, gfx.textWidth(ui, "Settings"));
    s->text(ui, 10, 30, "Settings (150 %)", gfx.BLACK);  // the same object draws a bigger font now

    gfx.setFontScales(200, 150);
    s->text(gfx.sansBold(), 10, 62, "Bold 200 %", gfx.rgb(30, 90, 200));
    s->text(gfx.mono(), 10, 102, "mono 150 %", gfx.rgb(30, 90, 200));
    printf("sets computed so far: %d\n", gfx.fontScaleBuilds());

    gfx.setFontScales(100, 100);                         // 100 gives the exact original fonts back
    printf("back: scale %d %%, height %d\n", gfx.uiFontScale(), ui->height);
    gimg.savePng(s, "out.png");
    return 0;
}
