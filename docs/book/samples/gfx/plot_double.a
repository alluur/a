// Plotting with double and dmath: a damped wave and a spiral
// book: shot=out.png
import gfx;
import gimg;
import dmath;

int main() {
    gfx.Surface* s = new gfx.Surface(320, 130);
    s->clear(gfx.WHITE);
    s->hline(10, 65, 200, gfx.GRAY);

    // y = exp(-x / 3) * sin(4 x) for x from 0 to 10: real doubles, the same bits on every target
    int prevX = 10;
    int prevY = 65;
    for (int px = 0; px <= 200; px++) {
        double x = px / 20.0;                            // an int mixed with a double becomes a double
        double y = dmath.exp(-x / 3) * dmath.sin(4 * x);
        int sy = 65 - (int) (y * 55);                    // a cast to int truncates toward zero
        if (px > 0) {
            s->line(prevX, prevY, 10 + px, sy, gfx.BLUE);
        }
        prevX = 10 + px;
        prevY = sy;
    }

    // an Archimedean spiral: the radius grows with the angle
    int lastX = 265;
    int lastY = 65;
    for (int step = 1; step <= 360; step++) {
        double angle = step * dmath.PI / 45;             // 4 degrees per step, in radians
        double r = step / 6.5;
        int sx = 265 + (int) (r * dmath.cos(angle));
        int sy = 65 + (int) (r * dmath.sin(angle));
        s->line(lastX, lastY, sx, sy, gfx.RED);
        lastX = sx;
        lastY = sy;
    }
    // gfx.isin() is an integer approximation: close, but not exact
    printf("sin(10 degrees) with dmath: %s\n", doubleToFixed(dmath.sin(10 * dmath.PI / 180), 6));
    printf("gfx.isin(10) / 1024:        %s\n", doubleToFixed(gfx.isin(10) / 1024.0, 6));
    gimg.savePng(s, "out.png");
    return 0;
}
