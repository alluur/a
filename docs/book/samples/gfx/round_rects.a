// Rounded rectangles: the shape of buttons
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(240, 120);
    s->clear(gfx.rgb(238, 238, 242));

    // x, y, width, height, corner radius, colour
    s->fillRoundRect(10, 10, 100, 40, 8, gfx.rgb(60, 120, 216));
    s->roundRect(10, 10, 100, 40, 8, gfx.rgb(30, 70, 150));
    s->fillRoundRect(130, 10, 100, 40, 20, gfx.rgb(88, 165, 92));    // radius 20 = half the height: a pill
    s->fillRoundRect(10, 62, 100, 48, 30, gfx.rgb(224, 102, 102));   // a radius that is too big is reduced
    s->roundRect(130, 62, 100, 48, 4, gfx.GRAY);
    s->fillRoundRect(140, 72, 80, 28, 0, gfx.YELLOW);                // radius 0 is a plain rectangle

    gimg.savePng(s, "out.png");
    printf("the corner pixel of the first button is untouched: %#x\n", s->get(10, 10));
    printf("its middle is blue: %#x\n", s->get(60, 30));
    return 0;
}
