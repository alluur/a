// Lines and circles
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(240, 140);
    s->clear(gfx.WHITE);

    // a fan of lines from one corner: every line is one pixel wide and not antialiased
    for (int i = 0; i <= 8; i++) {
        s->line(10, 130, 110, 130 - i * 15, gfx.mix(gfx.BLUE, gfx.RED, i * 31));
    }
    s->circle(170, 40, 30, gfx.BLACK);                   // centre x, y, radius
    s->fillCircle(170, 40, 20, gfx.GREEN);
    s->fillCircle(170, 40, 8, gfx.WHITE);
    s->circle(170, 100, 1, gfx.RED);
    s->fillCircle(210, 100, 12, gfx.withAlpha(gfx.BLUE, 120));

    printf("centre of the green disc: %#x\n", s->get(170, 55));
    printf("centre of the white dot:  %#x\n", s->get(170, 40));
    printf("just outside the outline: %#x\n", s->get(170, 9));
    gimg.savePng(s, "out.png");
    return 0;
}
