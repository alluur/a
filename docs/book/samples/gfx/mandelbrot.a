// The Mandelbrot set with integer arithmetic
// book: shot=out.png
import gfx;
import gimg;

const SCALE = 4096;                                      // fixed point: 12 bits after the point
const MAX_ITER = 40;

int escapeTime(int cr, int ci) {
    int zr = 0;
    int zi = 0;
    for (int i = 0; i < MAX_ITER; i++) {
        int zr2 = zr * zr / SCALE;
        int zi2 = zi * zi / SCALE;
        if (zr2 + zi2 > 4 * SCALE) {
            return i;                                    // it escaped after i steps
        }
        zi = 2 * zr * zi / SCALE + ci;
        zr = zr2 - zi2 + cr;
    }
    return MAX_ITER;                                     // it never did: inside the set
}

int main() {
    int w = 220;
    int h = 140;
    gfx.Surface* s = new gfx.Surface(w, h);
    int inside = 0;
    for (int py = 0; py < h; py++) {
        for (int px = 0; px < w; px++) {
            int cr = (px * 3 * SCALE) / w - 2 * SCALE + SCALE / 4;       // about -1.75 .. 1.25
            int ci = (py * 2 * SCALE) / h - SCALE;                       // -1 .. 1
            int n = escapeTime(cr, ci);
            if (n == MAX_ITER) {
                s->put(px, py, gfx.rgb(10, 12, 30));
                inside++;
            } else {
                int t = n * 255 / 16;
                int c = (t < 256) ? gfx.mix(gfx.rgb(20, 40, 120), gfx.rgb(90, 200, 250), t)
                                  : gfx.mix(gfx.rgb(90, 200, 250), gfx.WHITE, (t - 256) * 255 / 400);
                s->put(px, py, c);
            }
        }
    }
    printf("%d of %d pixels belong to the set\n", inside, w * h);
    printf("checksum %d\n", s->checksum());
    gimg.savePng(s, "out.png");
    return 0;
}
