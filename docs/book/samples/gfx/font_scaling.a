// Text at other sizes
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Font* base = gfx.sans();
    gfx.Surface* s = new gfx.Surface(260, 160);
    s->clear(gfx.WHITE);

    // scaleFont() makes a new font from the glyphs of another: 20 to 400 percent
    int percents[4] = {70, 100, 140, 200};
    int y = 6;
    for (int i = 0; i < 4; i++) {
        gfx.Font* f = gfx.scaleFont(base, percents[i]);
        char label[32];
        format(&label[0], 32, "%d%% Sample", percents[i]);
        s->text(f, 10, y, &label[0], gfx.BLACK);
        printf("%3d%%: height %2d, width of \"Sample\" %3d\n", percents[i], f->height, gfx.textWidth(f, "Sample"));
        y = y + f->height + 2;
    }
    // textScaled() draws a string at another size without making a font (slower: it resamples a temporary picture)
    s->text(base, 150, 10, "textScaled:", gfx.GRAY);
    s->textScaled(base, 150, 28, "150 %", gfx.rgb(200, 40, 40), 150);
    printf("scaledWidth of \"150 %%\": %d\n", s->scaledWidth(base, "150 %", 150));
    gfx.Font* tiny = gfx.scaleFont(base, 10);
    printf("10 %% is refused: %d\n", tiny == null);
    gimg.savePng(s, "out.png");
    return 0;
}
