// A pie chart with named slices
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    gchart.Chart* c = new gchart.Chart(gchart.PIE);
    char* names[4] = {"Rent", "Food", "Travel", "Fun"};
    int amounts[4] = {900, 450, 200, 150};
    int s0 = c->addSeries("Budget", 0);
    c->setValues(s0, amounts, 4);                        // one slice per value
    c->setLabels(names, 4);                              // the legend shows the slice names
    c->title = "Monthly budget";
    c->w = 260;
    c->h = 160;

    int total = 0;
    for (int i = 0; i < 4; i++) {
        total = total + c->valueAt(s0, i);
    }
    printf("total %d, rent is %d %%\n", total, c->valueAt(s0, 0) * 100 / total);

    gfx.Surface* s = new gfx.Surface(280, 180);
    s->clear(gui.cBack);
    c->paint(s, 10, 10);
    gimg.savePng(s, "out.png");
    return 0;
}
