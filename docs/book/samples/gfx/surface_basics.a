// A surface, pixels and rectangles
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(160, 100);          // all pixels start as 0: transparent black
    printf("size %d x %d, first pixel %#x\n", s->w, s->h, s->get(0, 0));

    s->clear(gfx.rgb(245, 245, 250));                    // every pixel
    s->fill(10, 10, 60, 40, gfx.RED);                    // x, y, width, height
    s->rect(80, 10, 60, 40, gfx.BLUE);                   // outline only
    s->hline(10, 70, 130, gfx.GREEN);                    // x, y, length
    s->vline(150, 10, 80, gfx.GRAY);
    s->put(20, 80, gfx.BLACK);                           // one pixel

    printf("red square: %#x\n", s->get(20, 20));
    printf("inside the blue outline: %#x\n", s->get(100, 30));
    printf("outside the surface: %d\n", s->get(-5, 3));  // get() gives 0 there
    s->put(500, 500, gfx.RED);                           // and put() ignores it

    gimg.savePng(s, "out.png");
    return 0;
}
