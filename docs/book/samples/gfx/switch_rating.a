// A switch and a star rating
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    gchart.Switch* off = new gchart.Switch(false);
    gchart.Switch* on = new gchart.Switch(true);
    gchart.Rating* r2 = new gchart.Rating(5, 2);         // five stars, two lit
    gchart.Rating* r5 = new gchart.Rating(5, 5);
    printf("off.on = %d, on.on = %d\n", off->on, on->on);
    printf("rating %d of %d\n", r2->value, r2->max);
    r2->set(9);                                          // clipped to the number of stars
    printf("set(9) gives %d\n", r2->value);
    r2->set(3);

    gfx.Surface* s = new gfx.Surface(280, 70);
    s->clear(gui.cBack);
    off->paint(s, 12, 10);
    on->paint(s, 12, 38);
    r2->paint(s, 90, 8);
    r5->paint(s, 90, 38);
    s->text(gfx.sans(), 66, 14, "off", gui.cTextDim);
    s->text(gfx.sans(), 66, 42, "on", gui.cTextDim);
    gimg.savePng(s, "out.png");
    return 0;
}
