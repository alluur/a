// UTF-8 text and the characters the fonts have
// book: shot=out.png
import gfx;
import gimg;

int main() {
    // the source file is UTF-8; the fonts have the characters 32 to 255 (Latin-1)
    char* line1 = "Ä Ö Å ä ö å é è ñ ç ß";
    char* line2 = "£ € © ® ° ± × ÷ ½ ¿";
    char* line3 = "Greek α β γ, arrows → ←";
    gfx.Font* f = gfx.sans();
    printf("%d bytes, %d pixels wide\n", strlen(line1), gfx.textWidth(f, line1));

    // nextCode() reads one code point; characters above 255 come back as the code point but are drawn as '?'
    int pos = 0;
    int code = gfx.nextCode("é!", &pos);
    printf("first code %d, next byte at %d\n", code, pos);
    printf("width of a Greek letter %d, of '?' %d\n", gfx.textWidth(f, "α"), gfx.textWidth(f, "?"));

    gfx.Surface* s = new gfx.Surface(240, 80);
    s->clear(gfx.WHITE);
    s->text(f, 10, 8, line1, gfx.BLACK);
    s->text(f, 10, 30, line2, gfx.BLACK);
    s->text(f, 10, 52, line3, gfx.BLACK);
    gimg.savePng(s, "out.png");
    return 0;
}
