// Plotting a function: axes, grid, labels
// book: shot=out.png
import gfx;
import gimg;

const LEFT = 36;
const TOP = 12;
const PW = 288;                                          // plot width: one pixel per 1.25 degrees
const PH = 100;

int main() {
    gfx.Surface* s = new gfx.Surface(340, 150);
    s->clear(gfx.WHITE);
    int grid = gfx.rgb(220, 224, 232);
    int mid = TOP + PH / 2;

    for (int i = 0; i <= 4; i++) {                       // vertical grid lines and labels every 90 degrees
        int x = LEFT + i * PW / 4;
        s->vline(x, TOP, PH, grid);
        char label[8];
        format(&label[0], 8, "%d", i * 90);
        s->textCentered(gfx.sans(), x - 20, TOP + PH + 4, 40, 17, &label[0], gfx.GRAY);
    }
    s->hline(LEFT, TOP, PW, grid);
    s->hline(LEFT, TOP + PH, PW, grid);
    s->hline(LEFT, mid, PW, gfx.GRAY);
    s->text(gfx.sans(), 12, TOP - 6, "1", gfx.GRAY);
    s->text(gfx.sans(), 12, mid - 8, "0", gfx.GRAY);
    s->text(gfx.sans(), 6, TOP + PH - 10, "-1", gfx.GRAY);

    // isin() and icos() give 1024 for 1.0: scale to half the plot height
    int prevS = 0;
    int prevC = 0;
    for (int x = 0; x <= PW; x++) {
        int deg = x * 360 / PW;
        int ys = mid - gfx.isin(deg) * (PH / 2) / 1024;
        int yc = mid - gfx.icos(deg) * (PH / 2) / 1024;
        if (x > 0) {
            s->line(LEFT + x - 1, prevS, LEFT + x, ys, gfx.BLUE);
            s->line(LEFT + x - 1, prevC, LEFT + x, yc, gfx.RED);
        }
        prevS = ys;
        prevC = yc;
    }
    s->fill(190, 132, 10, 3, gfx.BLUE);
    s->text(gfx.sans(), 204, 126, "sin", gfx.BLACK);
    s->fill(250, 132, 10, 3, gfx.RED);
    s->text(gfx.sans(), 264, 126, "cos", gfx.BLACK);
    printf("sin(90) = %d / 1024, cos(0) = %d / 1024\n", gfx.isin(90), gfx.icos(0));
    gimg.savePng(s, "out.png");
    return 0;
}
