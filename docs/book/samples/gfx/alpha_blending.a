// Translucent colours
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(240, 120);
    // a checkerboard shows what shines through
    for (int y = 0; y < 120; y = y + 10) {
        for (int x = 0; x < 240; x = x + 10) {
            s->fill(x, y, 10, 10, ((x + y) / 10) % 2 == 0 ? gfx.WHITE : gfx.rgb(200, 200, 210));
        }
    }
    // an alpha below 255 makes every drawing function blend with what is there
    s->fillCircle(80, 50, 38, gfx.argb(150, 224, 48, 48));
    s->fillCircle(120, 50, 38, gfx.argb(150, 48, 176, 80));
    s->fillCircle(100, 82, 38, gfx.argb(150, 48, 112, 224));

    // blend(): one pixel, with an extra coverage 0..255 that scales the alpha
    s->blend(10, 110, gfx.BLACK, 255);
    s->blend(11, 110, gfx.BLACK, 128);
    printf("black over white: %#x, with cover 128: %#x\n", s->get(10, 110), s->get(11, 110));

    // blitBlend(): a whole surface, composited over this one
    gfx.Surface* badge = new gfx.Surface(60, 24);
    badge->fillRoundRect(0, 0, 60, 24, 6, gfx.argb(255, 30, 30, 40));
    badge->textCentered(gfx.sans(), 0, 0, 60, 24, "alpha", gfx.WHITE);
    s->blitBlend(badge, 0, 0, 60, 24, 170, 10, 255);     // opacity 255: as it is
    s->blitBlend(badge, 0, 0, 60, 24, 170, 40, 120);     // about half transparent
    printf("pixel in the overlap of all three circles: %#x\n", s->get(100, 62));
    gimg.savePng(s, "out.png");
    return 0;
}
