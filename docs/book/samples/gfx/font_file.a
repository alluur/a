// Making and loading a font file
// book: shot=out.png
import gfx;
import gimg;

// the digits 0 to 9 as 5 x 7 bitmaps, one byte per row (the low five bits)
int digits[70] = {
    14,17,19,21,25,17,14,   4,12,4,4,4,4,14,   14,17,1,2,4,8,31,   14,17,1,6,1,17,14,   2,6,10,18,31,2,2,
    31,16,30,1,1,17,14,     6,8,16,30,17,17,14, 31,1,2,4,8,8,8,     14,17,17,14,17,17,14, 14,17,17,15,1,2,12
};

int main() {
    // the format: ascent, line height, then for each code 32 to 255: advance, left bearing, top, width, height
    // and width * height coverage values of 4 bits (two per byte, 0 = nothing, 15 = full)
    char font[2000];
    int n = 0;
    font[n++] = 8;
    font[n++] = 10;
    for (int code = 32; code < 256; code++) {
        bool digit = code >= '0' && code <= '9';
        font[n++] = digit ? 7 : 5;                       // advance
        font[n++] = 0;                                   // left bearing
        font[n++] = digit ? 7 : 0;                       // top: rows above the baseline
        font[n++] = digit ? 5 : 0;                       // width
        font[n++] = digit ? 7 : 0;                       // height
        if (digit) {
            int bits[35];
            for (int i = 0; i < 35; i++) {
                bits[i] = (digits[(code - '0') * 7 + i / 5] >> (4 - i % 5)) & 1;
            }
            for (int i = 0; i < 36; i = i + 2) {         // 35 values: the last byte is half empty
                int hi = bits[i] * 15;
                int lo = (i + 1 < 35) ? bits[i + 1] * 15 : 0;
                font[n++] = hi * 16 + lo;
            }
        }
    }
    printf("the file is %d bytes\n", n);
    int h = fileOpen("digits.afont", FILE_WRITE);
    fileWrite(h, &font[0], n);
    fileClose(h);

    gfx.Font* f = gfx.loadFont("digits.afont");
    printf("loaded: %d, height %d, width of 2025: %d\n", f != null, f->height, gfx.textWidth(f, "2025"));
    printf("missing file: %d\n", gfx.loadFont("no-such-file.afont") == null);

    gfx.Surface* s = new gfx.Surface(240, 70);
    s->clear(gfx.rgb(20, 24, 40));
    gfx.Font* big = gfx.scaleFont(f, 300);
    s->text(big, 12, 10, "0123456789", gfx.rgb(90, 240, 140));
    s->text(f, 12, 50, "2025 1234567890", gfx.rgb(240, 200, 80));
    gimg.savePng(s, "out.png");
    return 0;
}
