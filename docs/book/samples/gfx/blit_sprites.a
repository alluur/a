// Copying pictures: blit and blitBlend
// book: shot=out.png
import gfx;
import gimg;

gfx.Surface* makeSprite() {
    gfx.Surface* sp = new gfx.Surface(24, 24);           // starts fully transparent
    sp->fillCircle(12, 12, 11, gfx.rgb(240, 160, 40));
    sp->circle(12, 12, 11, gfx.rgb(160, 80, 10));
    sp->fillCircle(8, 9, 2, gfx.BLACK);
    sp->fillCircle(16, 9, 2, gfx.BLACK);
    sp->arc(12, 13, 6, 20, 160, gfx.BLACK);
    return sp;
}

int main() {
    gfx.Surface* sprite = makeSprite();
    gfx.Surface* s = new gfx.Surface(240, 100);
    s->gradientV(0, 0, 240, 100, gfx.rgb(120, 190, 250), gfx.rgb(30, 80, 160));

    // blitBlend: the transparent corners of the sprite show the sky. Arguments: source, the
    // part of it (x, y, width, height), where to put it (x, y), opacity 0..255
    for (int i = 0; i < 5; i++) {
        s->blitBlend(sprite, 0, 0, 24, 24, 10 + i * 30, 10 + (i % 2) * 20, 255);
    }
    s->blitBlend(sprite, 0, 0, 24, 24, 170, 10, 110);    // a ghost

    // blit: a plain copy of the pixels, alpha included (fast, no blending)
    s->blit(s, 0, 0, 160, 40, 40, 56);                   // copy the top strip to the bottom (a copy of itself)
    s->blit(sprite, 6, 6, 12, 12, 200, 56);              // only the middle of the sprite
    printf("corner of the sprite: %#x, its middle: %#x\n", sprite->get(0, 0), sprite->get(12, 12));
    gimg.savePng(s, "out.png");
    return 0;
}
