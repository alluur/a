// Scaling pictures smoothly
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* small = new gfx.Surface(16, 12);        // a 16 x 12 picture
    small->clear(gfx.rgb(250, 240, 200));
    small->fillCircle(8, 6, 4, gfx.rgb(220, 60, 60));
    small->rect(0, 0, 16, 12, gfx.rgb(60, 60, 60));

    gfx.Surface* wide = gimg.scale(small, 96, 72);       // any size, bilinear interpolation
    gfx.Surface* fitted = gimg.fit(wide, 60, 60);        // as big as fits the box, same proportions
    gfx.Surface* tall = gimg.fit(gimg.scale(small, 40, 80), 60, 60);
    printf("scale: %d x %d\n", wide->w, wide->h);
    printf("fit 96 x 72 into 60 x 60: %d x %d\n", fitted->w, fitted->h);
    printf("fit 40 x 80 into 60 x 60: %d x %d\n", tall->w, tall->h);

    gfx.Surface* s = new gfx.Surface(250, 90);
    s->clear(gfx.WHITE);
    s->blit(small, 0, 0, 16, 12, 6, 6);
    // the same picture enlarged without smoothing: one rectangle per pixel
    for (int y = 0; y < 12; y++) {
        for (int x = 0; x < 16; x++) {
            s->fill(6 + x * 4, 24 + y * 4, 4, 4, small->get(x, y));
        }
    }
    s->blit(wide, 0, 0, 96, 72, 80, 8);
    s->blit(fitted, 0, 0, fitted->w, fitted->h, 185, 8);
    gimg.savePng(s, "out.png");
    return 0;
}
