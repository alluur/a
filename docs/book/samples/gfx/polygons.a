// Polygons with fillPolygon
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(260, 110);
    s->clear(gfx.WHITE);

    // a triangle: the corners are two arrays, n is the number of corners
    int tx[3] = {10, 90, 50};
    int ty[3] = {100, 100, 10};
    s->fillPolygon(tx, ty, 3, gfx.rgb(60, 120, 216));

    // a five pointed star made of the points of a circle, visited in steps of two
    int sx[5];
    int sy[5];
    for (int i = 0; i < 5; i++) {
        int angle = -90 + i * 144;                       // degrees, clockwise from the right
        sx[i] = 140 + 45 * gfx.icos(angle) / 1024;       // icos and isin are 1024 times the real value
        sy[i] = 58 + 45 * gfx.isin(angle) / 1024;
    }
    s->fillPolygon(sx, sy, 5, gfx.rgb(240, 160, 40));    // even-odd rule: the middle of the star stays empty

    // an arrow
    int ax[7] = {200, 230, 230, 252, 230, 230, 200};
    int ay[7] = {48, 48, 30, 58, 86, 68, 68};
    s->fillPolygon(ax, ay, 7, gfx.rgb(88, 165, 92));

    printf("star middle (even-odd rule): %#x\n", s->get(140, 58));
    printf("a star arm:                  %#x\n", s->get(140, 25));
    gimg.savePng(s, "out.png");
    return 0;
}
