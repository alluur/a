// Text with the three built-in fonts
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Font* sans = gfx.sans();
    gfx.Font* bold = gfx.sansBold();
    gfx.Font* mono = gfx.mono();
    printf("height %d, ascent %d (sans); height %d (mono)\n", sans->height, sans->ascent, mono->height);
    printf("width of \"Hello, world\": sans %d, bold %d, mono %d\n",
           gfx.textWidth(sans, "Hello, world"), gfx.textWidth(bold, "Hello, world"), gfx.textWidth(mono, "Hello, world"));

    gfx.Surface* s = new gfx.Surface(240, 110);
    s->clear(gfx.WHITE);
    // y is the TOP of the line; text() returns the x position after the text
    int x = s->text(sans, 10, 10, "Sans, ", gfx.BLACK);
    x = s->text(bold, x, 10, "bold ", gfx.BLACK);
    s->text(mono, x, 10, "mono", gfx.BLACK);
    printf("the mono text starts at x = %d\n", x);
    s->text(sans, 10, 34, "A translucent colour", gfx.argb(120, 200, 0, 0));
    s->text(mono, 10, 56, "0123456789 {}[]<>", gfx.rgb(30, 90, 200));

    // textCentered puts the text in the middle of a rectangle
    s->fillRoundRect(10, 78, 220, 24, 6, gfx.rgb(60, 120, 216));
    s->textCentered(bold, 10, 78, 220, 24, "Centred in a button", gfx.WHITE);
    gimg.savePng(s, "out.png");
    return 0;
}
