// Arcs, ring segments and pie slices
// book: shot=out.png
import gfx;
import gimg;

int main() {
    // angles are degrees, clockwise from the right (the y axis points down)
    printf("isin(30) = %d, icos(60) = %d, isin(90) = %d, icos(180) = %d\n",
           gfx.isin(30), gfx.icos(60), gfx.isin(90), gfx.icos(180));       // 1024 = 1.0

    gfx.Surface* s = new gfx.Surface(280, 110);
    s->clear(gfx.WHITE);
    s->arc(50, 55, 40, 0, 270, gfx.BLACK);                              // centre, radius, from, to
    s->arc(50, 55, 30, 45, 135, gfx.RED);
    s->thickArc(140, 55, 25, 40, 150, 390, gfx.mix(gfx.BLUE, gfx.WHITE, 140));  // ring: inner and outer radius
    s->thickArc(140, 55, 25, 40, 150, 300, gfx.BLUE);

    // a pie chart with fillPie: each slice starts where the last one ended
    int values[4] = {40, 25, 20, 15};
    int colours[4] = {gfx.BLUE, gfx.GREEN, gfx.YELLOW, gfx.RED};
    int from = -90;                                                     // start at the top
    for (int i = 0; i < 4; i++) {
        int to = from + values[i] * 360 / 100;
        s->fillPie(230, 55, 40, from, to, colours[i]);
        from = to;
    }
    gimg.savePng(s, "out.png");
    printf("the slices cover %d degrees\n", from + 90);
    return 0;
}
