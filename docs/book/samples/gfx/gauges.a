// Gauges: a dial with coloured zones
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(470, 135);
    s->clear(gui.cBack);
    int values[3] = {35, 72, 94};
    char* captions[3] = {"CPU %", "Memory %", "Disk %"};
    for (int i = 0; i < 3; i++) {
        gchart.Gauge* g = new gchart.Gauge(0, 100);      // the range
        g->setValue(values[i]);
        g->caption = captions[i];
        g->w = 150;
        g->h = 125;
        g->paint(s, 5 + i * 155, 5);
    }
    // the yellow zone starts at 60 % of the range and the red one at 85 %; the zones can move
    gchart.Gauge* t = new gchart.Gauge(0, 100);
    t->setValue(250);                                    // out of range: cut to the maximum
    t->warn = 100;
    t->critical = 100;                                   // both at 100: one colour only
    printf("value 250 in a 0..100 gauge shows %d\n", t->value);
    gimg.savePng(s, "out.png");
    return 0;
}
