// The clip rectangle
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(220, 100);
    s->clear(gfx.WHITE);

    // everything is drawn twice: once without a clip, once with
    s->circle(55, 50, 45, gfx.GRAY);
    s->setClip(25, 20, 60, 60);                          // x, y, width, height
    printf("clip: %d,%d to %d,%d\n", s->clipX0, s->clipY0, s->clipX1, s->clipY1);
    printf("inside(30, 30) = %d, inside(5, 5) = %d\n", s->inside(30, 30), s->inside(5, 5));
    s->fillCircle(55, 50, 45, gfx.rgb(60, 120, 216));    // only the part inside the rectangle appears
    s->text(gfx.sansBold(), 30, 44, "clipped text", gfx.WHITE);
    s->line(0, 0, 219, 99, gfx.RED);
    s->resetClip();                                      // back to the whole surface

    // a clip that runs over the edge is cut to the surface
    s->setClip(140, 60, 500, 500);
    printf("clip: %d,%d to %d,%d\n", s->clipX0, s->clipY0, s->clipX1, s->clipY1);
    s->resetClip();
    s->rect(140, 20, 60, 60, gfx.BLACK);
    s->setClip(141, 21, 58, 58);
    s->gradientV(100, 0, 200, 100, gfx.YELLOW, gfx.GREEN);
    s->resetClip();

    // fill() obeys the clip rectangle, clear() does not
    gfx.Surface* t = new gfx.Surface(20, 20);
    t->setClip(5, 5, 5, 5);
    t->fill(0, 0, 20, 20, gfx.BLUE);
    printf("fill: %#x outside the clip, %#x inside\n", t->get(0, 0), t->get(6, 6));
    t->clear(gfx.RED);
    printf("clear: %#x outside the clip\n", t->get(0, 0));
    gimg.savePng(s, "out.png");
    return 0;
}
