// An area chart that scrolls: maxPoints
// book: shot=out.png
import gui;
import gchart;
import gfx;
import gimg;

int main() {
    gchart.Chart* c = new gchart.Chart(gchart.AREA);
    c->maxPoints = 30;                                   // the oldest points drop out (the default is 60)
    int load = c->addSeries("load", 0xFF2AA3B0);
    for (int i = 0; i < 100; i++) {
        int v = 40 + 25 * gfx.isin(i * 12) / 1024 + (i * 37) % 11;
        c->push(load, v);
    }
    printf("100 values pushed, %d kept\n", c->pointCount(load));
    printf("first kept: %d, last: %d\n", c->valueAt(load, 0), c->valueAt(load, 29));
    c->legend = false;
    c->title = "Load, last 30 samples";
    c->w = 320;
    c->h = 160;

    gfx.Surface* s = new gfx.Surface(340, 180);
    s->clear(gui.cBack);
    c->paint(s, 10, 10);
    gimg.savePng(s, "out.png");
    return 0;
}
