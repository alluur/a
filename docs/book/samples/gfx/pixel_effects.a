// Pixel by pixel: grey scale and negative
// book: shot=out.png
import gfx;
import gimg;

int grey(int c) {
    int g = (gfx.red(c) * 30 + gfx.green(c) * 59 + gfx.blue(c) * 11) / 100;
    return gfx.rgb(g, g, g);
}

int negative(int c) {
    return gfx.rgb(255 - gfx.red(c), 255 - gfx.green(c), 255 - gfx.blue(c));
}

int main() {
    gfx.Surface* a = new gfx.Surface(80, 70);
    a->gradientV(0, 0, 80, 70, gfx.rgb(255, 200, 80), gfx.rgb(40, 90, 200));
    a->fillCircle(28, 30, 18, gfx.RED);
    a->fillRoundRect(40, 38, 32, 22, 5, gfx.GREEN);
    a->text(gfx.sansBold(), 8, 4, "Pixels", gfx.WHITE);

    gfx.Surface* b = new gfx.Surface(80, 70);
    gfx.Surface* c = new gfx.Surface(80, 70);
    for (int y = 0; y < a->h; y++) {
        for (int x = 0; x < a->w; x++) {
            int p = a->get(x, y);
            b->put(x, y, grey(p));
            c->put(x, y, negative(p));
        }
    }
    printf("red %#x -> grey %#x, negative %#x\n", gfx.RED, grey(gfx.RED), negative(gfx.RED));
    printf("white -> grey %#x, black -> negative %#x\n", grey(gfx.WHITE), negative(gfx.BLACK));

    gfx.Surface* s = new gfx.Surface(260, 80);
    s->clear(gfx.WHITE);
    s->blit(a, 0, 0, 80, 70, 5, 5);
    s->blit(b, 0, 0, 80, 70, 90, 5);
    s->blit(c, 0, 0, 80, 70, 175, 5);
    gimg.savePng(s, "out.png");
    return 0;
}
