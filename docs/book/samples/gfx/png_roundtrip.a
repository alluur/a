// Saving, loading and decoding PNG files
// book: shot=out.png
import gfx;
import gimg;
import os;

int main() {
    gfx.Surface* s = new gfx.Surface(120, 60);
    s->gradientV(0, 0, 120, 60, gfx.rgb(255, 220, 120), gfx.rgb(220, 80, 60));
    s->text(gfx.sansBold(), 10, 20, "PNG round trip", gfx.WHITE);
    s->put(110, 50, gfx.argb(100, 0, 0, 255));           // put() stores the pixel as it is: alpha 100 of 255
    printf("checksum of the surface: %d\n", s->checksum());

    // to a file ...
    gimg.savePng(s, "pic.png");
    printf("pic.png is %d bytes (RGBA, not compressed)\n", os.fileSize("pic.png"));
    gfx.Surface* back = gimg.load("pic.png");            // the format is recognised from the content
    printf("loaded %d x %d, same checksum: %d\n", back->w, back->h, back->checksum() == s->checksum());

    // ... or to memory and back
    int n = 0;
    char* bytes = gimg.encodePng(s, &n);
    printf("in memory: %d bytes, starts with %c%c%c\n", n, bytes[1], bytes[2], bytes[3]);
    gfx.Surface* again = gimg.decode(bytes, n);
    printf("decoded again, pixel (110, 50): %#x == %#x\n", again->get(110, 50), s->get(110, 50));

    // things that are not images give null
    printf("garbage: %d, missing file: %d\n", gimg.decode("hello, not a picture", 20) == null, gimg.load("nothing.png") == null);
    gimg.savePng(back, "out.png");
    return 0;
}
