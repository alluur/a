// gfxfont: the glyph data behind the built-in fonts
// book: shot=out.png
import gfx;
import gfxfont;                                          // you rarely need this import: gfx has it already
import gimg;

int main() {
    // gfxfont only holds the data, as hex text made by docs/gen_font.py: one function per font
    printf("sans:     %d hex digits = %d bytes\n", strlen(gfxfont.sans()), strlen(gfxfont.sans()) / 2);
    printf("sansBold: %d hex digits = %d bytes\n", strlen(gfxfont.sansBold()), strlen(gfxfont.sansBold()) / 2);
    printf("mono:     %d hex digits = %d bytes\n", strlen(gfxfont.mono()), strlen(gfxfont.mono()) / 2);

    // gfx.Font(hex) builds a font from such text, so these are the built-in fonts made by hand
    gfx.Font* a = new gfx.Font(gfxfont.sans());
    gfx.Font* b = new gfx.Font(gfxfont.sansBold());
    gfx.Font* m = new gfx.Font(gfxfont.mono());
    printf("valid: %d %d %d, heights %d %d %d\n", a->valid, b->valid, m->valid, a->height, b->height, m->height);
    printf("an empty font is not valid: %d\n", new gfx.Font("") ->valid);

    gfx.Surface* s = new gfx.Surface(260, 100);
    s->clear(gfx.WHITE);
    s->text(a, 10, 8, "DejaVu Sans, 13 pixels", gfx.BLACK);
    s->text(b, 10, 30, "DejaVu Sans Bold, 13 pixels", gfx.BLACK);
    s->text(m, 10, 52, "DejaVu Sans Mono, 13 pixels", gfx.BLACK);
    s->text(gfx.scaleFont(a, 150), 10, 72, "150 %", gfx.rgb(30, 90, 200));
    gimg.savePng(s, "out.png");
    return 0;
}
