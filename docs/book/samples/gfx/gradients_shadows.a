// Gradients and shadows
// book: shot=out.png
import gfx;
import gimg;

int main() {
    gfx.Surface* s = new gfx.Surface(260, 130);
    s->clear(gfx.rgb(238, 238, 242));

    // gradientV: a vertical gradient from the first colour (top) to the second (bottom)
    s->gradientV(15, 15, 70, 100, gfx.rgb(90, 150, 240), gfx.rgb(20, 40, 110));

    // a card with a soft shadow: the shadow goes first, the card over it
    s->shadow(110, 20, 60, 90, 8, 90);                   // spread 8 pixels; the outermost ring is the darkest (alpha 90 / 8 = 11)
    s->fill(110, 20, 60, 90, gfx.WHITE);
    s->gradientV(110, 20, 60, 16, gfx.rgb(60, 120, 216), gfx.rgb(40, 90, 180));

    // a horizontal gradient is one line of mix() per column
    for (int x = 0; x < 70; x++) {
        s->vline(185 + x, 15, 100, gfx.mix(gfx.RED, gfx.YELLOW, x * 255 / 69));
    }
    printf("top %#x, middle %#x, bottom %#x\n", s->get(40, 15), s->get(40, 65), s->get(40, 114));
    printf("shadow 1 pixel from the card %#x, 8 pixels away %#x, outside %#x\n", s->get(109, 60), s->get(102, 60), s->get(101, 60));
    gimg.savePng(s, "out.png");
    return 0;
}
