// Atomic operations on a shared counter
import thread;
import cpu;

int hits;                                 // shared by every thread

int worker(int rounds) {
    for (int i = 0; i < rounds; i++) {
        cpu.atomicAdd(&hits, 1);          // read-modify-write as one indivisible step
    }
    return 0;
}

int main() {
    thread.Thread* ts[4];
    for (int i = 0; i < 4; i++) ts[i] = thread.spawn(worker, 25000);
    for (int i = 0; i < 4; i++) thread.join(ts[i]);
    printlnInt(hits);                     // 100000: no update was lost

    int v = 10;
    printlnInt(cpu.atomicAdd(&v, 5));     // returns the OLD value: 10
    printlnInt(v);                        // 15
    printlnInt(cpu.atomicSwap(&v, 99));   // old value 15, now 99
    printlnInt(cpu.atomicCas(&v, 99, 7)); // v was 99, so it becomes 7; returns the old value
    printlnInt(cpu.atomicCas(&v, 99, 8)); // v is 7 now: nothing changes, returns 7
    printlnInt(cpu.atomicLoad(&v));
    return 0;
}
