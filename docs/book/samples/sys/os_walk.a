// Walking a directory tree
import os;
import sort;

// prints the files below dir, indented by depth, and returns their total size
int walk(char* dir, int depth) {
    char* names[64];
    int n = os.listDir(dir, names, 64);
    sort.sortStrings(names, n);                      // a stable order for the output
    int total = 0;
    for (int i = 0; i < n; i++) {
        char path[300];
        format(path, 300, "%s/%s", (int) dir, (int) names[i]);
        int size = os.fileSize(path);                // -1 for a directory
        printRepeat(' ', depth * 2);
        if (size >= 0) {
            printf("%s (%d bytes)\n", names[i], size);
            total += size;
        } else {
            printf("%s/\n", names[i]);
            total += walk(path, depth + 1);
        }
    }
    return total;
}

int main() {
    makeDir("site");
    makeDir("site/css");
    makeDir("site/img");
    writeFile("site/index.html", "<h1>hi</h1>");
    writeFile("site/css/style.css", "body {}");
    writeFile("site/img/logo.svg", "<svg/>");
    writeFile("site/img/icon.svg", "<svg></svg>");
    printlnInt(walk("site", 0));
    return 0;
}
