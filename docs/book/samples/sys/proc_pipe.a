// A pipe between a parent and its child
// book: linux-only
import cunistd;

int main() {
    int fds[2];
    pipe(&fds[0]);                        // fds[0] reads, fds[1] writes
    int pid = fork();
    if (pid == 0) {
        close(fds[0]);                    // the child only writes
        char* msg = "numbers: 1 2 3\n";
        write(fds[1], msg, strlen(msg));
        close(fds[1]);
        _exit(0);
    }
    close(fds[1]);                        // the parent only reads; without this read never sees the end
    char buf[64];
    int total = 0;
    for (;;) {
        int n = read(fds[0], &buf[total], 63 - total);
        if (n <= 0) break;                // 0 means every writer has closed the pipe
        total += n;
    }
    buf[total] = 0;
    close(fds[0]);
    int status;
    waitpid(pid, &status, 0);
    print("parent read: ");
    print(buf);
    printf("%d bytes\n", total);
    return 0;
}
