// File size, rename and delete
import os;

int main() {
    writeFile("draft.txt", "twelve bytes");
    printlnInt(os.fileSize("draft.txt"));            // 12
    printlnInt(os.fileSize("missing.txt"));          // -1: it cannot be opened

    printBool(os.rename("draft.txt", "final.txt"));  // true on success
    println(" renamed");
    printBool(fileExists("draft.txt"));
    printBool(fileExists("final.txt"));
    println("");

    // rename replaces an existing destination on Linux (Windows refuses)
    writeFile("other.txt", "old");
    printBool(os.rename("final.txt", "other.txt"));
    println(" replaced");
    println(readFile("other.txt"));

    printBool(fileDelete("other.txt"));
    printBool(fileDelete("other.txt"));              // already gone
    println("");
    printlnInt(os.fileSize("."));                    // a directory is not a file: -1
    return 0;
}
