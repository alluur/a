// Printing from several threads: a lock keeps the lines whole, the order varies
// book: sorted
import thread;
import cpu;

int guard;

int worker(int id) {
    sleepMs(10 * (4 - id));               // the threads finish in a different order than they started
    cpu.lock(&guard);                     // the runtime's print is not thread safe: take turns
    printf("worker %d reporting\n", id);
    cpu.unlock(&guard);
    return id * id;
}

int main() {
    thread.Thread* ts[4];
    for (int i = 0; i < 4; i++) ts[i] = thread.spawn(worker, i);
    int sum = 0;
    for (int i = 0; i < 4; i++) sum += thread.join(ts[i]);
    printf("sum of the results: %d\n", sum);
    return 0;
}
