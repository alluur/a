// Handing data to another thread: publish, fence, wait
import thread;
import cpu;

int payload;
int ready;

int producer(int unused) {
    sleepMs(20);
    payload = 12345;                      // 1. write the data
    cpu.fence();                          // 2. make sure it is visible before the flag
    cpu.atomicStore(&ready, 1);           // 3. raise the flag
    return 0;
}

int main() {
    thread.Thread* t = thread.spawn(producer, 0);
    int spins = 0;
    while (cpu.atomicLoad(&ready) == 0) {
        cpu.pause();                      // tells the CPU this is a spin loop (saves power, helps the other thread)
        spins++;
    }
    printlnInt(payload);                  // safe: the flag was raised after the data was written
    printBool(spins > 0);
    println(" : we really had to wait");
    thread.join(t);
    return 0;
}
