// Reading and changing the environment
import cstdlib;

int main() {
    printBool(getenv("A_BOOK_DEMO") == null);       // not set yet: null
    println(" : A_BOOK_DEMO is not set");

    setenv("A_BOOK_DEMO", "hello", true);
    println(getenv("A_BOOK_DEMO"));

    setenv("A_BOOK_DEMO", "ignored", false);        // overwrite = false keeps the old value
    println(getenv("A_BOOK_DEMO"));

    putenv("A_BOOK_OTHER=42");                      // NAME=value in one string
    int n = 0;
    char** e = environ();                           // null terminated array of "NAME=value"
    for (int i = 0; e[i] != null; i++) {
        if (startsWith(e[i], "A_BOOK_")) {
            println(e[i]);
            n++;
        }
    }
    printlnInt(n);

    unsetenv("A_BOOK_DEMO");
    printBool(getenv("A_BOOK_DEMO") == null);
    println(" : removed");
    return 0;
}
