// A small test suite for a stack
import testing;

struct Stack { int items[8]; int size; }

void push(Stack* s, int v) { s->items[s->size] = v; s->size++; }
int pop(Stack* s) { s->size--; return s->items[s->size]; }
bool isEmpty(Stack* s) { return s->size == 0; }

void testPushPop() {
    Stack s;
    push(&s, 1); push(&s, 2); push(&s, 3);
    testing.assertEq(3, s.size, "size after three pushes");
    testing.assertEq(3, pop(&s), "last in, first out");
    testing.assertEq(2, pop(&s), "then the one before");
}

void testEmpty() {
    Stack s;
    testing.check(isEmpty(&s), "a new stack is empty");
    push(&s, 9);
    testing.check(!isEmpty(&s), "one item is not empty");
    pop(&s);
    testing.check(isEmpty(&s), "empty again");
}

int main() {
    testPushPop();
    testEmpty();
    printf("%d checks so far\n", testing.passedCount() + testing.failedCount());
    testing.reset();                      // start counting again (e.g. between suites)
    testPushPop();
    return testing.summary();
}
