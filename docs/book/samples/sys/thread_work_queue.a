// Worker threads that take jobs from a shared counter
import thread;
import cpu;

const JOBS = 12;
int next;                                 // the next job nobody has taken
int result[JOBS];

// a job that takes a while: how many steps of the Collatz sequence does n need?
int collatz(int n) {
    int steps = 0;
    while (n != 1) {
        n = (n % 2 == 0) ? n / 2 : 3 * n + 1;
        steps++;
    }
    return steps;
}

int worker(int id) {
    for (;;) {
        int job = cpu.atomicAdd(&next, 1);     // the old value: every thread gets a different one
        if (job >= JOBS) break;
        result[job] = collatz(job + 27);       // each job writes its own slot
    }
    return 0;
}

int main() {
    thread.Thread* ts[3];
    for (int i = 0; i < 3; i++) ts[i] = thread.spawn(worker, i);
    for (int i = 0; i < 3; i++) thread.join(ts[i]);
    for (int i = 0; i < JOBS; i++) {
        printf("collatz(%d) takes %d steps\n", i + 27, result[i]);
    }
    return 0;
}
