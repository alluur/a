// parallelFor: one loop spread over several threads
import thread;

int squares[1000];

// body(i) may run on any thread; every i writes its own slot, so no lock is needed
int square(int i) {
    squares[i] = i * i;
    return 0;
}

int main() {
    thread.parallelFor(1000, square, 4);   // 4 workers; 0 would mean one per processor
    int total = 0;
    for (int i = 0; i < 1000; i++) total += squares[i];
    printlnInt(total);                     // 332833500
    printlnInt(squares[999]);

    printBool(thread.cpuCount() >= 1);     // how many processors we may use: machine specific, so not printed
    println(" : at least one processor");
    printBool(thread.supported());
    println(" : real threads on this platform");
    return 0;
}
