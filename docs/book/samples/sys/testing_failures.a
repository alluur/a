// What a failing test looks like
// book: exit=4
import testing;

int twice(int x) { return x * 3; }                           // a bug

int main() {
    testing.assertEq(4, twice(2), "twice of 2");              // fails: 6
    testing.assertEq(0, twice(0), "twice of 0");              // passes
    testing.assertStrEq("abc", "abd", "strings");             // fails
    testing.assertStrEq("x", null, "null string");            // fails: null is shown as (null)
    testing.check(twice(1) == 2, "twice of 1");               // fails: no values to show
    testing.check(true, "always");
    printf("passed %d, failed %d\n", testing.passedCount(), testing.failedCount());
    return testing.summary();                                 // prints the totals; the exit code is the number of failures
}
