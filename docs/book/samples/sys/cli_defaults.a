// What the parser returns when an option is not given
import cli;

int main(int argc, char** argv) {            // run without arguments
    cli.ArgParser p("tally", null);
    p.addFlag("-v", "verbose");
    p.addOption("--mode", "how to count", "fast");
    p.addOption("-n", "how many", "10");
    p.parse(argc, argv);
    printBool(p.flag("-v"));
    println(" : -v given");
    println(p.option("--mode"));             // the default
    printlnInt(p.optionInt("-n", 99));       // "10" is a number, so the default option text is used
    printlnInt(p.optionInt("--mode", 99));   // "fast" is not a number: the fallback
    printBool(p.option("--nope") == null);   // an option that was never declared
    println(" : unknown name gives null");
    printlnInt(p.positionalCount());
    printBool(p.positional(0) == null);
    println(" : no first argument");
    return 0;
}
