// A unit test: assertions and a summary
import testing;

int add(int a, int b) { return a + b; }

char* shout(char* s) {
    char* r = strdup(s);
    strUpper(r);
    return r;
}

int main() {
    testing.assertEq(4, add(2, 2), "add small numbers");     // expected first, then the actual value
    testing.assertEq(0, add(-5, 5), "add opposites");
    testing.assertStrEq("HELLO", shout("hello"), "shout");
    testing.check(add(1, 1) < add(2, 2), "ordering");         // any condition
    return testing.summary();                                 // prints the totals; the result is the exit code
}
