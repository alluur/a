// Which CPU is this program built for?
// book: cpu-dependent
import cpu;

int main() {
    // the architecture of the build, not of the machine you happen to run it on
    printBool(cpu.arch() == __ARCH);
    println(" : cpu.arch() is the compiler's __ARCH");
    printBool(cpu.arch() == cpu.ARCH_X64 || cpu.arch() == cpu.ARCH_ARM64 || cpu.arch() == cpu.ARCH_RISCV64 || cpu.arch() == cpu.ARCH_LOONGARCH64);
    println(" : one of the four known CPUs");
    printBool(strlen(cpu.archName()) > 4);
    println(" : it has a name (x86-64, arm64, riscv64 or loongarch64)");

    // code that only exists for one CPU is chosen while compiling
    static if (__ARCH == 0) {
        println("compiled the x86-64 branch");
    } else {
        println("compiled a branch for another CPU");
    }

    // the kernel's list of CPU capabilities (Linux, Android): the bits mean different things on each CPU
    printBool(cpu.hwcap() != 0 || __OS == 1);
    println(" : the kernel reported capability bits");
    return 0;
}
