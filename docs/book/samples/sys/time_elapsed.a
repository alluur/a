// Measuring elapsed time
import cpu;

int main() {
    int start = millis();                 // milliseconds since some starting point: only differences mean anything
    sleepMs(50);
    int elapsed = millis() - start;
    printBool(elapsed >= 50);
    println(" : slept at least 50 ms");
    printBool(elapsed < 1000);
    println(" : and not a whole second");

    int c0 = cpu.cycles();                // the CPU's own counter, much finer than millis
    int sum = 0;
    for (int i = 0; i < 100000; i++) sum += i;
    int c1 = cpu.cycles();
    printlnInt(sum);
    printBool(c1 > c0);
    println(" : the cycle counter only goes forward");
    return 0;
}
