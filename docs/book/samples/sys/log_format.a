// printf style log functions
import log;

int main() {
    log.setFd(1);
    log.setTimestamps(false);
    log.setColors(false);

    char* user = "ann";
    log.infof("user %s logged in from port %d", (int) user, 8080, 0, 0);    // the values: up to four, as ints
    log.warnf("%d of %d retries used", 3, 5, 0, 0);
    log.errorf("exit code %d (%s)", 2, (int) "usage error", 0, 0);
    log.debugf("never shown at level INFO: %d", 1, 0, 0, 0);

    // for a message you built yourself use the plain functions
    char msg[64];
    format(msg, 64, "%d%% done", 75);
    log.info(msg);
    return 0;
}
