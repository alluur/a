// Asking an x86-64 processor about itself with CPUID
import cpu;

int main() {
    if (cpu.arch() != cpu.ARCH_X64) {
        println("cpuid exists on x86-64 only");     // elsewhere it returns 0 and vendor() is ""
        return 0;
    }
    char* v = cpu.vendor();                          // 12 letters made from three registers
    printBool(strlen(v) == 12);
    println(" : the vendor string has 12 characters");
    printBool(strlen(cpu.brand()) > 0);
    println(" : the brand string is not empty");

    int maxLeaf = cpu.cpuid(0, 0, 0);                // leaf 0, register eax: the highest basic leaf
    printBool(maxLeaf >= 1);
    println(" : leaf 1 exists");

    int features = cpu.cpuid(1, 0, 3);               // leaf 1, edx: the classic feature bits
    printBool((features & (1 << 26)) != 0);          // bit 26 is SSE2, part of every x86-64 CPU
    println(" : SSE2 is there");
    printBool((features & (1 << 4)) != 0);           // bit 4: the time stamp counter that cpu.cycles() reads
    println(" : time stamp counter");
    return 0;
}
