// A producer thread and a consumer: a bounded queue guarded by a spin lock
import thread;
import cpu;

const SIZE = 4;                           // a small queue, so the producer has to wait sometimes
int ring[SIZE];
int head;                                 // next slot to read
int tail;                                 // next slot to write
int count;                                // items in the queue
int guard;

bool push(int v) {
    bool ok = false;
    cpu.lock(&guard);
    if (count < SIZE) {
        ring[tail] = v;
        tail = (tail + 1) % SIZE;
        count++;
        ok = true;
    }
    cpu.unlock(&guard);
    return ok;
}

// returns -1 when the queue is empty
int pop() {
    int v = -1;
    cpu.lock(&guard);
    if (count > 0) {
        v = ring[head];
        head = (head + 1) % SIZE;
        count--;
    }
    cpu.unlock(&guard);
    return v;
}

int producer(int n) {
    for (int i = 1; i <= n; i++) {
        while (!push(i * i)) cpu.pause(); // queue full: wait politely
    }
    while (!push(0)) cpu.pause();         // 0 tells the consumer that nothing more will come
    return 0;
}

int main() {
    thread.Thread* p = thread.spawn(producer, 10);
    int sum = 0;
    for (;;) {
        int v = pop();
        if (v < 0) { cpu.pause(); continue; }
        if (v == 0) break;
        printf("got %d\n", v);            // only this thread prints
        sum += v;
    }
    thread.join(p);
    printf("sum of squares 1..10 = %d\n", sum);
    return 0;
}
