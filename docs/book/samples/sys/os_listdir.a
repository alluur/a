// Listing a directory
import os;
import sort;

int main() {
    makeDir("photos");
    writeFile("photos/b.jpg", "2");
    writeFile("photos/a.jpg", "1");
    writeFile("photos/notes.txt", "n");
    makeDir("photos/raw");

    char* names[16];                                  // room for 16 names
    int n = os.listDir("photos", names, 16);          // new heap strings, no "." or ".."
    printlnInt(n);
    sort.sortStrings(names, n);                       // the order of listDir is not defined
    for (int i = 0; i < n; i++) {
        println(names[i]);
    }
    printlnInt(os.listDir("nowhere", names, 16));     // -1 if it cannot be read

    char* few[2];                                     // a small array only takes what fits
    printlnInt(os.listDir("photos", few, 2));
    return 0;
}
