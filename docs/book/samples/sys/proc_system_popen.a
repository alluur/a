// Shell commands: system and popen
// book: linux-only
import cstdio;
import cstdlib;

int main() {
    printf("system returned %d\n", system("exit 3"));        // the exit code of the command

    FILE* p = popen("printf 'one\\ntwo\\nthree\\n'", "r");   // read the output of a command
    char line[64];
    int lines = 0;
    while (fgets(line, 64, p) != null) {
        lines++;
        printf("line %d: %s", lines, line);
    }
    printf("exit code: %d\n", pclose(p));

    p = popen("read word; echo \"the shell read: $word\"", "w");   // or feed its input
    fputs("shouting\n", p);
    pclose(p);                                               // flushes, closes and waits; the output goes to ours
    return 0;
}
