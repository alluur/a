// Starting threads and collecting their results
import thread;

// a thread function takes one int and returns one int
int sumTo(int n) {
    int total = 0;
    for (int i = 1; i <= n; i++) total += i;
    return total;
}

int main() {
    thread.Thread* ts[4];
    for (int i = 0; i < 4; i++) {
        ts[i] = thread.spawn(sumTo, (i + 1) * 100);    // 100, 200, 300, 400
    }
    for (int i = 0; i < 4; i++) {
        int r = thread.join(ts[i]);                    // waits, returns what sumTo returned
        printf("sumTo(%d) = %d\n", (i + 1) * 100, r);
    }
    printBool(thread.finished(ts[0]));
    println(" : finished");
    printBool(thread.join(ts[0]) == 5050);             // joining again gives the same result
    println(" : joined twice");
    return 0;
}
