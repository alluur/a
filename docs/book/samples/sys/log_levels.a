// Log levels
import log;

int main() {
    log.setFd(1);                         // the default is standard error; here we want it in the output
    log.setTimestamps(false);             // time stamps would change every run
    log.setColors(false);

    log.debug("not shown: the default level is INFO");
    log.info("server started");
    log.warn("disk is 91% full");
    log.error("cannot open config.ini");

    log.setLevel(log.WARN);               // DEBUG, INFO, WARN, ERROR, OFF
    log.info("hidden now");
    log.warn("still shown");

    log.setLevel(log.DEBUG);
    log.debug("everything is shown");
    log.setLevel(log.OFF);
    log.error("nothing is shown");
    return 0;
}
