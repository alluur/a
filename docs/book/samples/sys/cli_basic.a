// A command line parser: flags, options and arguments
// book: args=-v --output=report.txt -n 5 data1.csv data2.csv
import cli;

int main(int argc, char** argv) {
    cli.ArgParser p("tally", "Counts things in files");
    p.addFlag("-v,--verbose", "print more");                       // a flag may have several names
    p.addOption("-o,--output", "output file", "out.txt");         // an option takes a value and has a default
    p.addOption("-n,--count", "how many lines", "10");
    if (!p.parse(argc, argv)) {                                   // reports problems itself
        return 1;
    }
    printBool(p.flag("-v"));                                      // any of the names works
    println(" : verbose");
    println(p.option("--output"));                                // "report.txt": the value that was given
    printlnInt(p.optionInt("-n", 10));                            // as a number, with a fallback
    for (int i = 0; i < p.positionalCount(); i++) {
        printf("file %d: %s\n", i + 1, p.positional(i));
    }
    return 0;
}
