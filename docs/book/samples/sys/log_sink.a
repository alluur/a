// Logging to a file, and what a time stamp looks like
import log;

int main() {
    int fd = fileOpen("app.log", FILE_WRITE);        // setFd sends the lines to any open handle
    log.setFd(fd);
    log.info("written to a file");                   // time stamps are on by default
    log.error("and so is this");
    fileClose(fd);

    // a line is "2026-10-11 16:05:09 [INFO ] written to a file": the date and time change, the rest does not
    char* text = readFile("app.log");
    char line[200];
    int n = 0;
    for (int i = 0; text[i] != 0; i++) {
        if (text[i] != '\n') {
            line[n] = text[i];
            n++;
            continue;
        }
        line[n] = 0;
        n = 0;
        int tag = indexOf(line, '[');
        printf("time stamp of %d characters, then: %s\n", tag - 1, &line[tag]);
        printBool(line[4] == '-' && line[10] == ' ' && line[13] == ':');
        println(" : it looks like YYYY-MM-DD HH:MM:SS");
    }
    return 0;
}
