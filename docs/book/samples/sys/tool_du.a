// A small tool: cli, os and log working together
// book: args=-v --min 8 site
import cli;
import os;
import log;
import sort;

int main(int argc, char** argv) {
    makeDir("site");                                  // some data to look at
    writeFile("site/a.txt", "12345");
    writeFile("site/b.txt", "1234567890");
    writeFile("site/c.txt", "123456789012345");

    cli.ArgParser p("du", "Lists the files of a directory that are big enough");
    p.addFlag("-v,--verbose", "also say what is skipped");
    p.addOption("-m,--min", "smallest size to list", "0");
    if (!p.parse(argc, argv)) return 1;
    if (p.positionalCount() != 1) {
        eprintln("usage: du [options] DIRECTORY");
        return 2;
    }

    log.setFd(1);
    log.setTimestamps(false);
    log.setColors(false);
    if (p.flag("-v")) log.setLevel(log.DEBUG); else log.setLevel(log.WARN);

    char* dir = p.positional(0);
    int minSize = p.optionInt("--min", 0);
    char* names[64];
    int n = os.listDir(dir, names, 64);
    if (n < 0) {
        log.errorf("cannot read %s", (int) dir, 0, 0, 0);
        return 1;
    }
    sort.sortStrings(names, n);
    for (int i = 0; i < n; i++) {
        char path[300];
        format(path, 300, "%s/%s", (int) dir, (int) names[i]);
        int size = os.fileSize(path);
        if (size < minSize) {
            log.debugf("skipping %s (%d bytes)", (int) names[i], size, 0, 0);
            continue;
        }
        printf("%6d  %s\n", size, names[i]);
    }
    return 0;
}
