// --help prints the usage and makes parse return false
// book: args=--help
// book: exit=1
import cli;

int main(int argc, char** argv) {
    cli.ArgParser p("resize", "Changes the size of images");
    p.addFlag("-f,--force", "overwrite existing files");
    p.addOption("-w,--width", "new width in pixels", "800");
    p.addOption("-o,--output", "output directory", "");     // an empty default is not shown
    if (!p.parse(argc, argv)) {
        return 1;                                           // --help or a mistake: nothing more to do
    }
    println("not reached with --help");
    return 0;
}
