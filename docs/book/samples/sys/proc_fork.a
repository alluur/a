// Starting a child process with fork and waiting for it
// book: linux-only
import cunistd;

int main() {
    int pid = fork();                     // returns twice: 0 in the child, the child's pid in the parent
    if (pid < 0) {
        println("fork failed");
        return 1;
    }
    if (pid == 0) {
        println("child: working");
        _exit(7);                         // leave without running the parent's exit handlers
    }
    int status = 0;
    int got = waitpid(pid, &status, 0);   // blocks until the child has ended
    printBool(got == pid);
    println(" : waitpid returned the child");
    printf("child exit code: %d\n", (status >> 8) & 255);     // the exit code is in bits 8-15
    printf("killed by a signal: %d\n", status & 127);
    return 0;
}
