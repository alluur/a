// Running another program: fork, exec, wait
// book: linux-only
import cunistd;

int main() {
    int pid = fork();
    if (pid == 0) {
        char* argv[4];                    // the program name comes first; the list ends with null
        argv[0] = "echo";
        argv[1] = "hello";
        argv[2] = "from exec";
        argv[3] = null;
        execvp("echo", argv);             // searches PATH; only returns when it failed
        println("exec failed");
        _exit(127);
    }
    int status;
    waitpid(pid, &status, 0);
    printf("echo exited with %d\n", (status >> 8) & 255);

    pid = fork();
    if (pid == 0) {
        char* argv[2];
        argv[0] = "no-such-program";
        argv[1] = null;
        execvp("no-such-program", argv);
        _exit(127);                       // the usual code for "command not found"
    }
    waitpid(pid, &status, 0);
    printf("missing program: %d\n", (status >> 8) & 255);
    return 0;
}
