// A spin lock protects a larger piece of shared data
import thread;
import cpu;

struct Account { int balance; int deposits; }

Account account;
int guard;                                // 0 = free, 1 = taken

int depositor(int n) {
    for (int i = 0; i < 5000; i++) {
        cpu.lock(&guard);                 // spins until it gets the lock
        account.balance += 10;            // two fields change together:
        account.deposits += 1;            // nobody may look in between
        cpu.unlock(&guard);
    }
    return 0;
}

int main() {
    thread.Thread* ts[3];
    for (int i = 0; i < 3; i++) ts[i] = thread.spawn(depositor, i);
    for (int i = 0; i < 3; i++) thread.join(ts[i]);
    printf("deposits %d, balance %d\n", account.deposits, account.balance);

    printBool(cpu.tryLock(&guard));       // tryLock does not wait: true, we hold it now
    println(" : first tryLock");
    printBool(cpu.tryLock(&guard));
    println(" : second tryLock fails");
    cpu.unlock(&guard);
    return 0;
}
