// Reading and writing files with handles
int main() {
    int h = fileOpen("log.txt", FILE_WRITE);         // create or truncate
    fileWrite(h, "first\n", 6);
    fileClose(h);

    h = fileOpen("log.txt", FILE_APPEND);            // add to the end
    fileWrite(h, "second\n", 7);
    fileClose(h);

    h = fileOpen("log.txt", FILE_READ);
    char buf[8];                                     // a small buffer: read in pieces
    int total = 0;
    for (;;) {
        int n = fileRead(h, buf, 8);                 // bytes read, 0 at the end of the file
        if (n <= 0) break;
        total += n;
        printf("read %d bytes\n", n);
    }
    fileClose(h);
    printlnInt(total);

    printlnInt(fileOpen("no/such/file", FILE_READ) < 0);   // errors are negative handles
    print(readFile("log.txt"));                      // the whole file at once
    return 0;
}
