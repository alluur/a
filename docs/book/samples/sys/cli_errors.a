// Mistakes on the command line
import cli;

// builds an ArgParser with two options and parses the given words
bool tryParse(char* a, char* b) {
    cli.ArgParser p("tool", null);
    p.addFlag("-v", "verbose");
    p.addOption("-o", "output", "x");
    char* args[3];
    args[0] = "tool";
    args[1] = a;
    args[2] = b;
    return p.parse(b == null ? 2 : 3, args);   // the message goes to standard error
}

int main() {
    printBool(tryParse("-v", "file"));         // fine
    println(" : -v file");
    printBool(tryParse("-x", null));           // unknown option
    println(" : -x");
    printBool(tryParse("-o", null));           // an option without its value
    println(" : -o");
    printBool(tryParse("-v=3", null));         // "=value" works with long names only (--name=value)
    println(" : -v=3");
    return 0;
}
