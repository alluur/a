// Short flags can be combined; "--" ends the options
// book: args=-ac -o out.bin first -- -b - second
import cli;

int main(int argc, char** argv) {
    cli.ArgParser p("pack", "Packs files");
    p.addFlag("-a", "all");
    p.addFlag("-b", "binary");
    p.addFlag("-c", "compress");
    p.addOption("-o", "output", "a.out");
    if (!p.parse(argc, argv)) return 1;
    printBool(p.flag("-a")); printBool(p.flag("-b")); printBool(p.flag("-c"));    // -ac is -a and -c
    println("");
    println(p.option("-o"));
    for (int i = 0; i < p.positionalCount(); i++) {
        println(p.positional(i));                 // after "--" everything is an argument, even -b;
    }                                             // a lone "-" is an argument too (usually "standard input")
    return 0;
}
