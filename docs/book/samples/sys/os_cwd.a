// The working directory
import os;
import cunistd;

// the last component of a path
char* baseName(char* path) {
    int slash = -1;
    for (int i = 0; path[i] != 0; i++) {
        if (path[i] == '/') slash = i;
    }
    return &path[slash + 1];
}

int main() {
    makeDir("work");
    char* before = os.getCwd();              // a new heap string, null on error
    printBool(before != null);
    println(" : the working directory is known");

    chdir("work");                           // chdir comes from the C library module
    char* inside = os.getCwd();
    println(baseName(inside));               // only the last name: the full path differs on every machine
    printBool(strlen(inside) > strlen(before));
    println(" : the new path is longer");

    chdir("..");
    printBool(streq(os.getCwd(), before));
    println(" : and back where we started");
    return 0;
}
