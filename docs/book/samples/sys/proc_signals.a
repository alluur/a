// Signals: handlers, raise and kill
// book: linux-only
import cunistd;

int received;

void onUsr1(int sig) {
    received = received + 1;              // do little in a handler: set a flag and return
}

int main() {
    signal(SIGUSR1, onUsr1);
    raise(SIGUSR1);                       // a signal to ourselves
    kill(getpid(), SIGUSR1);              // the same through kill
    printf("handler ran %d times\n", received);

    signal(SIGUSR1, SIG_IGN);             // ignore it from now on
    raise(SIGUSR1);
    printf("still %d\n", received);

    signal(SIGUSR1, SIG_DFL);             // back to the default action
    int pid = fork();
    if (pid == 0) {
        raise(SIGUSR1);                   // the default action of SIGUSR1 ends the program
        _exit(0);
    }
    int status;
    waitpid(pid, &status, 0);
    printf("child died from signal %d\n", status & 127);
    return 0;
}
