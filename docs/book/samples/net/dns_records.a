// Reading the record types of a DNS reply
import dns;
import netaddr;

// writes "mail.example.org" as length-prefixed labels, returns the new end
int putName(char* b, int p, char* name) {
    int labelAt = p++;
    int len = 0;
    for (int i = 0; ; i++) {
        if (name[i] == '.' || name[i] == 0) {
            b[labelAt] = len;
            if (name[i] == 0) break;
            labelAt = p++;
            len = 0;
        } else {
            b[p++] = name[i];
            len++;
        }
    }
    b[p++] = 0;
    return p;
}

int put16(char* b, int p, int v) { b[p] = v >> 8; b[p + 1] = v & 255; return p + 2; }

// starts an answer record: the name is a pointer (0xC00C) to the name in the question, then type, class, ttl and
// the data length (filled in later by end)
int begin(char* b, int p, int type, int ttl) {
    p = put16(b, p, 0xC00C);
    p = put16(b, p, type);
    p = put16(b, p, 1);
    p = put16(b, p, 0);
    p = put16(b, p, ttl);
    return put16(b, p, 0);
}

int end(char* b, int dataStart, int p) {
    put16(b, dataStart - 2, p - dataStart);
    return p;
}

int main() {
    char r[512];
    int p = dns.buildQuery("example.org", dns.MX, 0x0707, r);   // the question
    r[2] = 0x81; r[3] = 0x80;                                  // a reply
    r[7] = 5;                                                  // five answers

    int at = begin(r, p, dns.MX, 3600);                        // 10 mail.example.org
    p = put16(r, at, 10);
    p = end(r, at, putName(r, p, "mail.example.org"));
    at = begin(r, p, dns.TXT, 300);
    r[at] = 11;
    memcpy(&r[at + 1], "v=spf1 -all", 11);
    p = end(r, at, at + 12);
    at = begin(r, p, dns.A, 60);
    p = end(r, at, put16(r, put16(r, at, 0x5DB8), 0xD822));    // 93.184.216.34
    at = begin(r, p, dns.AAAA, 60);
    netaddr.ip6Parse("2606:2800:220:1::1", &r[at]);
    p = end(r, at, at + 16);
    at = begin(r, p, dns.SRV, 60);                             // priority 5, weight 7, port 5060, target
    p = put16(r, put16(r, put16(r, at, 5), 7), 5060);
    p = end(r, at, putName(r, p, "sip.example.org"));

    printf("%d records\n", dns.parseReply(r, p, 0x0707));
    for (int i = 0; i < dns.recordCount(); i++) {
        dns.Record* rec = dns.recordAt(i);
        printf("%-5s ttl %-5d %s\n", dns.typeName(rec->type), rec->ttl, dns.recordText(rec));
    }

    // a cut-off packet is refused instead of read past its end
    printf("truncated: %d\n", dns.parseReply(r, p - 10, 0x0707));
    return 0;
}
