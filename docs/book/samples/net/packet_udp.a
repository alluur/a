// packet: a UDP datagram inside IPv4 inside Ethernet, built and taken apart
import packet;
import netaddr;

int main() {
    char src[6]; char dst[6];
    netaddr.macParse("02:00:00:00:00:01", src);
    netaddr.macParse("02:00:00:00:00:02", dst);
    int a = netaddr.ipParse("10.0.0.1");
    int b = netaddr.ipParse("10.0.0.2");

    // build from the inside out: payload -> UDP -> IPv4 -> Ethernet (every layer writes its own checksum)
    char udp[100]; char ip[150]; char frame[200];
    int un = packet.udpBuild(a, b, 5353, 53, "hello", 5, udp);
    int in = packet.ipBuild(a, b, packet.PROTO_UDP, 64, 4242, udp, un, ip);
    int n = packet.ethBuild(dst, src, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(&frame[14], 20));                      // the IPv4 header

    // take it apart from the outside in
    packet.Eth* e = new packet.Eth();
    packet.Ip* h = new packet.Ip();
    packet.Udp* u = new packet.Udp();
    packet.ethParse(frame, n, e);
    packet.ipParse(&frame[e->offset], n - e->offset, h);
    char* seg = &frame[e->offset + h->offset];
    packet.udpParse(seg, h->totalLen - h->headerLen, u);
    printf("IPv4: ttl %d, protocol %d, id %d, header checksum ok: %s\n", h->ttl, h->proto, h->id, h->checksumOk ? "yes" : "no");
    printf("UDP: port %d to port %d, %d bytes of data\n", u->srcPort, u->dstPort, u->length - 8);
    printf("data: %.5s\n", &seg[u->offset]);
    printf("UDP checksum ok: %s\n", packet.udpChecksumOk(a, b, seg, u->length) ? "yes" : "no");

    // flip one bit of the data: the checksum notices
    seg[u->offset] = seg[u->offset] ^ 1;
    printf("after damage: %s\n", packet.udpChecksumOk(a, b, seg, u->length) ? "yes" : "no");
    return 0;
}
