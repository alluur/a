// Time limits: setTimeout, waitReadable and the three results of recv
import net;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);

    // nobody is connecting: waiting for a client with a time limit says so after 100 ms
    printf("client waiting: %s\n", net.waitReadable(listener, 100) ? "yes" : "no");

    int client = net.connect("127.0.0.1", port);
    printf("client waiting now: %s\n", net.waitReadable(listener, 1000) ? "yes" : "no");
    int server = net.accept(listener);

    // recv on a quiet connection waits forever, unless the socket has a time limit
    net.setTimeout(server, 150);
    char buf[16];
    int r = net.recv(server, buf, 16);
    printf("quiet connection: recv returned a negative number: %s\n", r < 0 ? "yes" : "no");

    // the three results of recv: data (> 0), end of data (0), error or time out (< 0)
    net.sendText(client, "abc");
    r = net.recv(server, buf, 16);
    printf("with data: %d\n", r);
    net.close(client);
    r = net.recv(server, buf, 16);
    printf("peer closed: %d\n", r);

    net.close(server);
    net.close(listener);
    return 0;
}
