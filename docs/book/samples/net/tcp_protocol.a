// A line-based protocol: one request per line, one answer per line
import net;

// the "server": reads one request line and answers it
void serve(int c) {
    char line[128];
    if (net.recvLine(c, line, 128) < 0) return;
    char out[160];
    if (startsWith(line, "ADD ")) {
        int a = atoi(&line[4]);
        int sp = indexOf(&line[4], ' ');
        format(out, 160, "OK %d\n", a + atoi(&line[4 + sp + 1]));
    } else if (streq(line, "TIME")) {
        format(out, 160, "ERR no clock here\n");
    } else {
        format(out, 160, "ERR unknown command: %s\n", line);
    }
    net.sendText(c, out);
}

// the "client": sends a request and returns the answer line
void ask(int server, int client, char* request) {
    net.sendText(client, request);
    net.sendText(client, "\r\n");                // telnet style: both \r\n and \n end a line
    serve(server);
    char answer[160];
    net.recvLine(client, answer, 160);
    printf("%-10s -> %s\n", request, answer);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int client = net.connect("127.0.0.1", net.localPort(listener));
    int conn = net.accept(listener);

    ask(conn, client, "ADD 40 2");
    ask(conn, client, "ADD 7 -3");
    ask(conn, client, "TIME");
    ask(conn, client, "HELLO");

    // a line longer than the buffer comes out in pieces: size the buffer for the longest line you accept
    net.sendText(client, "0123456789ABCDEF\n");
    char small[8];
    for (int i = 1; i <= 3; i++) {
        net.recvLine(conn, small, 8);
        printf("piece %d: %s\n", i, small);
    }

    net.close(client);
    net.close(conn);
    net.close(listener);
    return 0;
}
