// netutil: is something listening on a port?
import netutil;
import net;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);

    // portOpen connects and closes again; tcpPing also tells how long it took (ms)
    printf("port open: %s\n", netutil.portOpen("127.0.0.1", port, 1000) ? "yes" : "no");
    printf("connected within 1000 ms: %s\n", netutil.tcpPing("127.0.0.1", port, 1000) >= 0 ? "yes" : "no");

    net.close(listener);
    printf("after closing the listener: %s\n", netutil.portOpen("127.0.0.1", port, 300) ? "yes" : "no");
    printf("tcpPing then returns %d\n", netutil.tcpPing("127.0.0.1", port, 300));
    return 0;
}
