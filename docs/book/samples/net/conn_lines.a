// conn: buffered reads and writes on a connection
import conn;

int main() {
    conn.Listener* listener = new conn.Listener(0);       // port 0: any free port
    int port = listener->port();
    conn.Connection* client = conn.open("127.0.0.1", port, 1000);
    conn.Connection* server = listener->accept(1000);

    // writes are collected in a buffer and leave as one packet on flush
    client->writeLine("first line");
    client->writeText("second ");
    client->writeLine("line");
    client->write("0123456789", 10);
    client->flush();

    char line[64];
    server->readLine(line, 64);
    printf("line: %s\n", line);
    server->readLine(line, 64);
    printf("line: %s\n", line);

    // everything that is already received waits in the read buffer
    printf("buffered: %d bytes\n", server->buffered());
    char digits[11];
    int n = server->readExact(digits, 10);
    digits[n] = 0;
    printf("exactly 10 bytes: %s\n", digits);
    printf("readable now: %s\n", server->readable(0) ? "yes" : "no");

    // end of the connection: readLine returns -1, read returns 0
    client->close();
    printf("readLine at the end: %d\n", server->readLine(line, 64));
    printf("bytes received: %d, bytes sent by the client: %d\n", server->bytesIn, client->bytesOut);

    server->close();
    listener->close();
    return 0;
}
