// netutil: an NTP exchange with a fake time server
import netutil;
import net;

int main() {
    // the request is 48 bytes; only the first byte is set: version 4, mode 3 (client)
    char req[48];
    int n = netutil.ntpBuildRequest(req);
    printf("request: %d bytes, first byte %02x\n", n, req[0]);

    // our "time server" is a UDP socket on the loopback interface
    int server = net.udpBind(0);
    net.setTimeout(server, 1000);
    netutil.NtpPending* p = netutil.ntpStart(net.parseIp("127.0.0.1"), net.localPort(server));
    char buf[100];
    int ip;
    int port;
    printf("the server received %d bytes\n", net.recvFrom(server, buf, 100, &ip, &port));

    // a reply: mode 4 (server), stratum 2, and the transmit time in bytes 40 to 43 as seconds since 1900.
    // 3913056000 seconds since 1900 is 2024-01-01 00:00:00 UTC
    char reply[48];
    memset(reply, 0, 48);
    reply[0] = 0x24;
    reply[1] = 2;
    reply[40] = 0xE9; reply[41] = 0x3C; reply[42] = 0x7F; reply[43] = 0x00;
    net.sendTo(server, ip, port, reply, 48);
    printf("Unix time from the reply: %d\n", netutil.ntpFinish(p, 1000));

    // stratum 0 means "the server does not know the time": the reply is refused
    reply[1] = 0;
    printf("stratum 0: %d\n", netutil.ntpParse(reply, 48));
    net.close(server);
    return 0;
}
