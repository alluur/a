// book: linux-only
// A server in its own process: the usual shape of a network program
import net;
import cunistd;

// runs in the child: serve clients one after the other
void serve(int listener, int clients) {
    for (int i = 0; i < clients; i++) {
        int c = net.accept(listener);
        char line[100];
        while (net.recvLine(c, line, 100) >= 0) {
            strUpper(line);                       // in place
            net.sendText(c, line);
            net.sendText(c, "\n");
        }
        net.close(c);
    }
}

int main() {
    // listen before fork: the port exists when the child starts, so the client cannot be too early
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    int pid = fork();
    if (pid == 0) {
        serve(listener, 2);
        _exit(0);
    }
    net.close(listener);

    for (int k = 1; k <= 2; k++) {
        int c = net.connect("127.0.0.1", port);
        char reply[100];
        net.sendText(c, "hello from client\n");
        net.recvLine(c, reply, 100);
        printf("client %d: %s\n", k, reply);
        net.sendText(c, "second line\n");
        net.recvLine(c, reply, 100);
        printf("client %d: %s\n", k, reply);
        net.close(c);
    }
    int status;
    waitpid(pid, &status, 0);
    printf("server exited with %d\n", (status >> 8) & 255);
    return 0;
}
