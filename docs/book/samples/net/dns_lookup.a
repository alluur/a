// book: compile-only
// Real DNS lookups: A, MX and TXT records and a reverse lookup (needs a network and a DNS server)
import dns;
import netaddr;
import netif;

int main() {
    // which servers will be asked (from /etc/resolv.conf, ipconfig ...)?
    int servers[8];
    int n = netif.dnsServers(servers, 8);
    for (int i = 0; i < n; i++) {
        printf("DNS server %s\n", netaddr.ipToText(servers[i]));
    }

    int ip = dns.lookupA("example.org");
    if (ip < 0) {
        println("no answer: no network, or the name does not exist");
        return 1;
    }
    printf("example.org has the address %s\n", netaddr.ipToText(ip));

    // query returns the number of answers, -1 when no server answered at all, 0 for "no such name"
    int count = dns.query("gmail.com", dns.MX);
    for (int i = 0; i < count; i++) {
        println(dns.recordText(dns.recordAt(i)));        // e.g. 5 gmail-smtp-in.l.google.com
    }
    count = dns.query("example.org", dns.TXT);
    for (int i = 0; i < count; i++) {
        println(dns.recordText(dns.recordAt(i)));
    }

    char* name = dns.reverse(ip);                        // the PTR record, or null
    printf("%s is called %s\n", netaddr.ipToText(ip), name == null ? "(no name)" : name);
    return 0;
}
