// book: linux-only
// The DNS client against a small DNS server of our own
import dns;
import net;
import netaddr;
import cunistd;

// a DNS server that knows two names; runs in the child process
void server(int socket, int queries) {
    for (int i = 0; i < queries; i++) {
        char q[600];
        char reply[600];
        char name[256];
        int ip;
        int port;
        int n = net.recvFrom(socket, q, 600, &ip, &port);
        dns.readName(q, n, 12, name, 256);              // the question starts after the 12 byte header
        int answer = 0;                                 // 0: no such name
        if (streq(name, "www.example.test")) answer = netaddr.ipFromBytes(10, 1, 2, 3);
        if (streq(name, "mail.example.test")) answer = netaddr.ipFromBytes(10, 1, 2, 4);
        int len = dns.buildReply(q, n, answer, reply);
        net.sendTo(socket, ip, port, reply, len);
    }
}

int main() {
    int socket = net.udpBind(0);
    int port = net.localPort(socket);
    int pid = fork();
    if (pid == 0) {
        server(socket, 4);
        _exit(0);
    }
    net.close(socket);

    // ask our server instead of the system's
    dns.setServer(netaddr.ipParse("127.0.0.1"), port);
    printf("www.example.test  -> %s\n", netaddr.ipToText(dns.lookupA("www.example.test")));
    printf("mail.example.test -> %s\n", netaddr.ipToText(dns.lookupA("mail.example.test")));

    // a name that does not exist: no answers, response code 3 (NXDOMAIN)
    int n = dns.query("nothing.example.test", dns.A);
    printf("nothing.example.test: %d answers, rcode %d\n", n, dns.rcode());

    // an address in text form needs no query at all
    printf("10.9.8.7 -> %s\n", netaddr.ipToText(dns.lookupA("10.9.8.7")));

    // net.resolve has its own resolver; net.setDns points it at our server too
    net.setDns("127.0.0.1", port);
    printf("net.resolve: %s\n", netaddr.ipToText(net.resolve("www.example.test")));

    int status;
    waitpid(pid, &status, 0);
    return 0;
}
