// packet: the TCP handshake and a data segment, described like tcpdump does
import packet;
import netaddr;

int clientIp;
int serverIp;
char clientMac[6];
char serverMac[6];

// wraps a TCP segment in IPv4 and Ethernet and prints the one-line description
void show(char* segment, int n, bool fromClient) {
    char ip[200];
    char frame[300];
    int in = 0;
    if (fromClient) {
        in = packet.ipBuild(clientIp, serverIp, packet.PROTO_TCP, 64, 1, segment, n, ip);
        n = packet.ethBuild(serverMac, clientMac, packet.ETH_IPV4, ip, in, frame);
    } else {
        in = packet.ipBuild(serverIp, clientIp, packet.PROTO_TCP, 64, 1, segment, n, ip);
        n = packet.ethBuild(clientMac, serverMac, packet.ETH_IPV4, ip, in, frame);
    }
    println(packet.describe(frame, n));
}

int main() {
    netaddr.macParse("02:00:00:00:00:01", clientMac);
    netaddr.macParse("02:00:00:00:00:02", serverMac);
    clientIp = netaddr.ipParse("10.0.0.1");
    serverIp = netaddr.ipParse("10.0.0.2");
    char seg[200];

    // three way handshake: SYN (with the maximum segment size option), SYN+ACK, ACK
    int n = packet.tcpBuild(clientIp, serverIp, 40000, 80, 1000, 0, packet.TCP_SYN, 65535, 1460, "", 0, seg);
    show(seg, n, true);
    packet.Tcp* t = new packet.Tcp();
    packet.tcpParse(seg, n, t);
    printf("  options: mss %d, header %d bytes, checksum ok: %s\n", t->mss, t->headerLen,
           packet.tcpChecksumOk(clientIp, serverIp, seg, n) ? "yes" : "no");
    n = packet.tcpBuild(serverIp, clientIp, 80, 40000, 5000, 1001, packet.TCP_SYN | packet.TCP_ACK, 65535, 1460, "", 0, seg);
    show(seg, n, false);
    n = packet.tcpBuild(clientIp, serverIp, 40000, 80, 1001, 5001, packet.TCP_ACK, 65535, 0, "", 0, seg);
    show(seg, n, true);

    // data: sequence numbers count bytes, so 18 bytes of request move the client from 1001 to 1019
    n = packet.tcpBuild(clientIp, serverIp, 40000, 80, 1001, 5001, packet.TCP_ACK | packet.TCP_PSH, 65535, 0,
                        "GET / HTTP/1.0\r\n\r\n", 18, seg);
    show(seg, n, true);
    n = packet.tcpBuild(serverIp, clientIp, 80, 40000, 5001, 1019, packet.TCP_ACK, 65535, 0, "", 0, seg);
    show(seg, n, false);

    // closing: FIN from the client
    n = packet.tcpBuild(clientIp, serverIp, 40000, 80, 1019, 5001, packet.TCP_FIN | packet.TCP_ACK, 65535, 0, "", 0, seg);
    show(seg, n, true);
    return 0;
}
