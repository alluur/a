// Subnets: network, broadcast and host range
import netaddr;

void show(char* label, int ip) {
    printf("%-10s %s\n", label, netaddr.ipToText(ip));
}

char* yn(bool v) { return v ? "yes" : "no"; }

int main() {
    int host;
    int bits;
    // "address/prefix": the address may be any host inside the subnet
    if (!netaddr.parseCidr("192.168.1.77/26", &host, &bits)) {
        println("bad CIDR text");
        return 1;
    }
    printf("prefix /%d, %d usable hosts\n", bits, netaddr.hostCount(bits));
    show("host", host);
    show("netmask", netaddr.maskFromPrefix(bits));
    show("network", netaddr.network(host, bits));
    show("first", netaddr.firstHost(host, bits));
    show("last", netaddr.lastHost(host, bits));
    show("broadcast", netaddr.broadcast(host, bits));

    // is an address inside a subnet?
    int lan = netaddr.ipParse("192.168.1.0");
    printf("192.168.1.77 in 192.168.1.0/24: %s\n", yn(netaddr.inSubnet(host, lan, 24)));
    printf("192.168.2.5 in 192.168.1.0/24: %s\n", yn(netaddr.inSubnet(netaddr.ipParse("192.168.2.5"), lan, 24)));

    // from a mask back to a prefix length; -1 when the mask is not a run of ones
    printf("255.255.255.0 is /%d\n", netaddr.prefixFromMask(netaddr.ipParse("255.255.255.0")));
    printf("255.0.255.0 is /%d\n", netaddr.prefixFromMask(netaddr.ipParse("255.0.255.0")));
    printf("10.0.0.0/33 parses: %s\n", yn(netaddr.parseCidr("10.0.0.0/33", &host, &bits)));
    return 0;
}
