// netutil: the Wake-on-LAN magic packet
import netutil;
import net;
import packet;

int main() {
    // 6 bytes of 0xFF, then the MAC address 16 times: 102 bytes
    char magic[110];
    int n = netutil.wolPacket("aa:bb:cc:00:11:22", magic);
    printf("magic packet: %d bytes\n", n);
    print(packet.hexdump(magic, 24));
    printf("a text that is not a MAC address: %d\n", netutil.wolPacket("not a mac", magic));

    // wakeOnLanTo sends it where you say; wakeOnLan uses 255.255.255.255 port 9
    // here we send to a UDP socket of our own instead of the whole network
    int listener = net.udpBind(0);
    net.setTimeout(listener, 1000);
    bool sent = netutil.wakeOnLanTo("aa:bb:cc:00:11:22", net.parseIp("127.0.0.1"), net.localPort(listener));
    char buf[200];
    int got = net.recvFrom(listener, buf, 200, null, null);
    printf("sent: %s, received %d bytes\n", sent ? "yes" : "no", got);
    net.close(listener);
    return 0;
}
