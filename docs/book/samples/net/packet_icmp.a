// packet: an ICMP echo request and reply (what ping sends)
import packet;
import netaddr;

int main() {
    char src[6]; char dst[6];
    netaddr.macParse("02:00:00:00:00:01", src);
    netaddr.macParse("02:00:00:00:00:02", dst);
    int a = netaddr.ipParse("10.0.0.1");
    int b = netaddr.ipParse("10.0.0.2");
    char icmp[100]; char ip[150]; char frame[200];

    // the request: type 8, an identifier, a sequence number and some data
    int cn = packet.icmpEcho(packet.ICMP_ECHO, 7, 1, "abcd", 4, icmp);
    int in = packet.ipBuild(a, b, packet.PROTO_ICMP, 64, 100, icmp, cn, ip);
    int n = packet.ethBuild(dst, src, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(icmp, cn));

    // the answer has type 0 and echoes identifier, sequence number and data
    packet.Icmp* m = new packet.Icmp();
    packet.icmpParse(icmp, cn, m);
    char reply[100];
    cn = packet.icmpEcho(packet.ICMP_ECHO_REPLY, m->id, m->seq, &icmp[m->offset], cn - m->offset, reply);
    in = packet.ipBuild(b, a, packet.PROTO_ICMP, 64, 101, reply, cn, ip);
    n = packet.ethBuild(src, dst, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));

    // the checksum covers the whole message
    packet.icmpParse(reply, cn, m);
    printf("type %d, id %d, seq %d, checksum ok: %s\n", m->type, m->id, m->seq, m->checksumOk ? "yes" : "no");
    reply[9] = reply[9] ^ 0x20;
    packet.icmpParse(reply, cn, m);
    printf("after changing a byte: %s\n", m->checksumOk ? "yes" : "no");
    return 0;
}
