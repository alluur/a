// book: compile-only
// ping and NTP against real hosts (needs a network; ping may need a permission)
import netutil;

int main() {
    // round trip time in milliseconds; -1 = no answer, -2 = this program may not send ICMP
    int ms = netutil.ping("example.org", 1000);
    if (ms >= 0) {
        printf("example.org answered in %d ms\n", ms);
    } else if (ms == -2) {
        println("not allowed to ping (try tcpPing, which needs no permission)");
    } else {
        println("no answer");
    }

    // a TCP ping: how long does connecting to a port take?
    int t = netutil.tcpPing("example.org", 443, 2000);
    printf("TCP connect time: %d ms\n", t);

    // the time from an NTP server, in seconds since 1970 (-1 on failure)
    int now = netutil.ntpTime("pool.ntp.org");
    if (now > 0) printf("the network time is %d\n", now);
    return 0;
}
