// packet: an ARP request and its reply as Ethernet frames
import packet;
import netaddr;

int main() {
    char alice[6];
    char bob[6];
    netaddr.macParse("02:00:00:00:00:01", alice);
    netaddr.macParse("02:00:00:00:00:02", bob);
    int aliceIp = netaddr.ipParse("10.0.0.1");
    int bobIp = netaddr.ipParse("10.0.0.2");

    // "who has 10.0.0.2? tell 10.0.0.1": a broadcast frame, 14 bytes of Ethernet header + 28 of ARP
    char frame[64];
    int n = packet.arpRequestFrame(alice, aliceIp, bobIp, frame);
    printf("%d bytes: %s\n", n, packet.describe(frame, n));
    print(packet.hexdump(frame, n));

    // take it apart again: first the Ethernet header, then the ARP packet behind it
    packet.Eth* eth = new packet.Eth();
    packet.ethParse(frame, n, eth);
    printf("to %s from %s, type %04x\n", netaddr.macToText(&eth->dst[0]), netaddr.macToText(&eth->src[0]), eth->type);
    packet.Arp* arp = new packet.Arp();
    packet.arpParse(&frame[eth->offset], n - eth->offset, arp);
    printf("operation %d (1 = request), sender %s, target %s\n", arp->op, netaddr.ipToText(arp->senderIp),
           netaddr.ipToText(arp->targetIp));

    // bob answers with his MAC address, directly to alice
    n = packet.arpReplyFrame(bob, bobIp, alice, aliceIp, frame);
    printf("%d bytes: %s\n", n, packet.describe(frame, n));

    // a frame that is too short is refused, not read past its end
    printf("parse 10 bytes: %s\n", packet.ethParse(frame, 10, eth) ? "ok" : "refused");
    return 0;
}
