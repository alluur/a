// Who is on the other end? Peer addresses and socket options
import net;
import netaddr;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int client = net.connect("127.0.0.1", net.localPort(listener));
    int server = net.accept(listener);

    // the server's side of the connection knows the client's address and port
    int ip;
    int port;
    if (net.peer(server, &ip, &port)) {
        printf("server sees the client at %s\n", netaddr.ipToText(ip));
        printf("  its port is the client's own port: %s\n", port == net.localPort(client) ? "yes" : "no");
    }
    // and the client's side knows the listener's port
    net.peer(client, &ip, &port);
    printf("client sees the server at %s, port matches: %s\n", netaddr.ipToText(ip),
           port == net.localPort(listener) ? "yes" : "no");
    printf("the client's own address is %s\n", netaddr.ipToText(net.localIp(client)));

    // socket options return true when the system accepted them
    printf("no delay: %d\n", net.setNoDelay(client, true));
    printf("keep alive: %d\n", net.setKeepAlive(client, true));
    printf("reuse address: %d\n", net.setReuse(listener, true));

    // asking for the peer of a socket that is not connected fails
    int udp = net.udpSocket();
    printf("peer of an unconnected socket: %d\n", net.peer(udp, &ip, &port));

    net.close(udp);
    net.close(client);
    net.close(server);
    net.close(listener);
    return 0;
}
