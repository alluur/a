// book: compile-only
// What this computer knows about its network (the output differs on every machine)
import netif;
import netaddr;

int main() {
    for (int i = 0; i < netif.interfaceCount(); i++) {
        netif.Iface* f = netif.interfaceAt(i);
        printf("%-8s %-15s mac %s mtu %d %s\n", f->name, netaddr.ipToText(f->ip), netaddr.macToText(&f->mac[0]),
               f->mtu, f->isUp() ? "up" : "down");
        printf("         received %d bytes in %d packets, sent %d bytes\n", f->rxBytes, f->rxPackets, f->txBytes);
    }
    printf("address used for outgoing traffic: %s\n", netaddr.ipToText(netif.localAddress()));
    printf("default gateway: %s\n", netaddr.ipToText(netif.defaultGateway()));

    // the neighbours this computer has talked to recently (the ARP cache)
    for (int i = 0; i < netif.arpCount(); i++) {
        netif.ArpEntry* e = netif.arpAt(i);
        if (e->complete) printf("%s is at %s\n", netaddr.ipToText(e->ip), netaddr.macToText(&e->mac[0]));
    }

    // and every TCP and UDP socket that is open right now
    for (int i = 0; i < netif.connectionCount(); i++) {
        netif.Socket* s = netif.connectionAt(i);
        printf("%s %s:%d %s\n", s->proto, netaddr.ipToText(s->localIp), s->localPort, netif.stateName(s->state));
    }
    return 0;
}
