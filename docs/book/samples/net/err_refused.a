// What failure looks like: negative handles and refused connections
import net;

int main() {
    // find a port nobody listens on: listen, remember the port, close again
    int probe = net.listenOn("127.0.0.1", 0, 1);
    int port = net.localPort(probe);
    net.close(probe);

    // connect returns a negative number when it cannot connect
    int c = net.connect("127.0.0.1", port);
    printf("connect to a closed port: %s\n", c < 0 ? "failed" : "connected");
    int c2 = net.connectTimeout("127.0.0.1", port, 500);
    printf("connectTimeout to a closed port: %s\n", c2 < 0 ? "failed" : "connected");

    // a port can only be listened on once
    int first = net.listenOn("127.0.0.1", 0, 4);
    int second = net.listenOn("127.0.0.1", net.localPort(first), 4);
    printf("first listener ok: %s\n", first >= 0 ? "yes" : "no");
    printf("second listener on the same port ok: %s\n", second >= 0 ? "yes" : "no");

    // an address that is not a number gives -1 (names are looked up by net.resolve, which may need DNS)
    printf("listenOn(\"not-an-ip\"): %d\n", net.listenOn("not-an-ip", 0, 4));
    printf("parseIp(\"1.2.3\"): %d\n", net.parseIp("1.2.3"));
    net.close(first);
    return 0;
}
