// conn: one thread serving several clients with a Poller
import conn;

int main() {
    conn.Listener* listener = new conn.Listener(0);
    int port = listener->port();
    conn.Connection* alice = conn.open("127.0.0.1", port, 1000);
    conn.Connection* bob = conn.open("127.0.0.1", port, 1000);
    conn.Connection* clients[2];
    clients[0] = listener->accept(1000);
    clients[1] = listener->accept(1000);

    // the tag is whatever you want to know when a handle is ready: here the index in clients[]
    conn.Poller* poller = new conn.Poller();
    poller->add(clients[0]->handle(), 0);
    poller->add(clients[1]->handle(), 1);
    printf("ready with nothing sent: %d\n", poller->wait(50));

    bob->writeLine("hello from bob");
    bob->flush();
    alice->writeLine("hello from alice");
    alice->flush();

    // the server loop: wait, serve everything that is ready, repeat until both clients are done
    char* said[2];
    said[0] = alloc(64);
    said[1] = alloc(64);
    int served = 0;
    while (served < 2) {
        int n = poller->wait(1000);
        for (int i = 0; i < n; i++) {
            int who = poller->readyTag(i);
            clients[who]->readLine(said[who], 64);
            clients[who]->writeLine("got it");
            clients[who]->flush();
            poller->remove(clients[who]->handle());
            served++;
        }
    }
    printf("client 0 said: %s\n", said[0]);
    printf("client 1 said: %s\n", said[1]);

    char answer[32];
    alice->readLine(answer, 32);
    printf("alice heard: %s\n", answer);
    bob->readLine(answer, 32);
    printf("bob heard: %s\n", answer);
    return 0;
}
