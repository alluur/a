// conn: time limits when accepting, connecting and reading
import conn;

int main() {
    conn.Listener* listener = new conn.Listener(0);
    int port = listener->port();

    // accept(ms) returns null when nobody connects within the time
    conn.Connection* none = listener->accept(100);
    printf("accept without a client: %s\n", none == null ? "null" : "a connection");

    conn.Connection* client = conn.open("127.0.0.1", port, 1000);
    conn.Connection* server = listener->accept(1000);
    printf("accept with a client: %s\n", server == null ? "null" : "a connection");

    // readLine gives -1 when the connection ended, and also when the time limit ran out
    server->setTimeout(100);
    char line[64];
    printf("quiet client: readLine returns %d\n", server->readLine(line, 64));

    // a listener that is gone: open fails, openRetry tries again after a pause and then gives up
    listener->close();
    client->close();
    server->close();
    printf("open to a closed port: %s\n", conn.open("127.0.0.1", port, 200) == null ? "null" : "a connection");
    conn.Connection* retry = conn.openRetry("127.0.0.1", port, 200, 3, 20);
    printf("openRetry, 3 tries: %s\n", retry == null ? "null" : "a connection");
    return 0;
}
