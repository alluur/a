// book: compile-only
// UDP broadcast and multicast: one sender, many receivers on a local network
import net;

int main() {
    // sender: a broadcast reaches every host on the local network
    int tx = net.udpSocket();
    net.setBroadcast(tx, true);                         // without this sendTo to .255 fails
    net.sendTo(tx, net.parseIp("255.255.255.255"), 9999, "anyone here?", 12);
    net.close(tx);

    // receiver: bind a port, then join a multicast group (224.0.0.0 to 239.255.255.255)
    int rx = net.udpBind(9999);
    if (rx < 0) {
        println("port 9999 is busy");
        return 1;
    }
    if (!net.joinMulticast(rx, net.parseIp("239.1.2.3"))) {
        println("cannot join the group");
    }
    net.setTimeout(rx, 2000);
    char buf[128];
    int from;
    int n = net.recvFrom(rx, buf, 127, &from, null);
    if (n >= 0) {
        buf[n] = 0;
        println(buf);
    }
    net.close(rx);
    return 0;
}
