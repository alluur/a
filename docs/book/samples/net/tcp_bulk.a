// book: linux-only
// Sending a megabyte: send blocks until the other side has made room
import net;
import cunistd;

const TOTAL = 1000000;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    int pid = fork();
    if (pid == 0) {
        // the child is the sender; one call per 10000 bytes, 100 calls
        int c = net.accept(listener);
        char block[10000];
        for (int i = 0; i < 10000; i++) block[i] = i % 251;
        for (int i = 0; i < TOTAL / 10000; i++) {
            if (net.send(c, block, 10000) != 10000) _exit(1);
        }
        net.close(c);
        _exit(0);
    }
    net.close(listener);

    // the parent reads until the sender closes (recv returns 0)
    int c = net.connect("127.0.0.1", port);
    char buf[4096];
    int total = 0;
    int sum = 0;
    for (;;) {
        int n = net.recv(c, buf, 4096);
        if (n <= 0) break;
        for (int i = 0; i < n; i++) sum += buf[i];
        total += n;
    }
    printf("received %d bytes, checksum %d\n", total, sum);
    net.close(c);
    int status;
    waitpid(pid, &status, 0);
    printf("sender exit code %d\n", (status >> 8) & 255);
    return 0;
}
