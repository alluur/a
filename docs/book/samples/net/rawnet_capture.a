// book: compile-only
// Raw frames: capture to a file and ask "who has this address?" (Linux, needs root or CAP_NET_RAW)
import rawnet;
import netaddr;

int main(int argc, char** argv) {
    char* ifname = "eth0";
    if (argc > 1) ifname = argv[1];

    // open returns -1 when the interface does not exist or the permission is missing
    int h = rawnet.open(ifname);
    if (h < 0) {
        println("cannot open a packet socket here (not root, or no such interface)");
        return 1;
    }
    rawnet.close(h);

    // write up to 20 frames, or whatever arrives within 5 seconds, into a file for Wireshark
    int frames = rawnet.capture(ifname, "dump.pcap", 20, 5000);
    printf("captured %d frames\n", frames);

    // ARP the default gateway's neighbour: which MAC address owns 192.168.1.1?
    char mac[6];
    if (rawnet.arping(ifname, netaddr.ipParse("192.168.1.1"), 1000, mac)) {
        printf("192.168.1.1 is at %s\n", netaddr.macToText(mac));
    } else {
        println("no answer");
    }

    // and a frame of our own: rawnet.send(h, frame, n) takes a complete Ethernet frame, e.g. from packet.ethBuild
    return 0;
}
