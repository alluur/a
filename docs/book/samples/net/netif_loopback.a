// netif: the loopback interface and our own socket in the system's table
import netif;
import netaddr;
import net;

int main() {
    // every system has a loopback interface; its name is "lo" on Linux and Android
    netif.Iface* lo = netif.findInterface("lo");
    if (lo == null) {
        println("no interface called lo on this system");
    } else {
        printf("%s: %s/%d loopback: %s up: %s\n", lo->name, netaddr.ipToText(lo->ip),
               netaddr.prefixFromMask(lo->mask), lo->isLoopback() ? "yes" : "no", lo->isUp() ? "yes" : "no");
    }

    // a listening socket shows up in the table of open sockets (netstat -l)
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    int found = 0;
    for (int i = 0; i < netif.connectionCount(); i++) {
        netif.Socket* s = netif.connectionAt(i);
        if (s->localPort == port && streq(s->proto, "tcp")) {
            printf("found it: %s on %s, state %s\n", s->proto, netaddr.ipToText(s->localIp), netif.stateName(s->state));
            found++;
        }
    }
    printf("matches for our port: %d\n", found);
    net.close(listener);
    return 0;
}
