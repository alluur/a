// netif: the loopback interface and its counters
import netif;
import netaddr;
import net;

int main() {
    // every system has a loopback interface; its name is "lo" on Linux and Android
    netif.Iface* lo = netif.findInterface("lo");
    if (lo == null) {
        println("no interface called lo on this system");
        return 0;
    }
    printf("%s: %s/%d loopback: %s up: %s\n", lo->name, netaddr.ipToText(lo->ip),
           netaddr.prefixFromMask(lo->mask), lo->isLoopback() ? "yes" : "no", lo->isUp() ? "yes" : "no");
    printf("no interface of that name: %s\n", netif.findInterface("no-such-card") == null ? "null" : "found");

    // the counters count packets since boot: send a datagram to ourselves and watch the receive counter grow.
    // Every call that looks things up reads the system again, so fetch the interface again to see new numbers
    int before = lo->rxPackets;
    int rx = net.udpBind(0);
    int tx = net.udpSocket();
    net.sendTo(tx, net.parseIp("127.0.0.1"), net.localPort(rx), "hello", 5);
    lo = netif.findInterface("lo");
    printf("packets received by lo grew: %s\n", lo->rxPackets > before ? "yes" : "no");
    net.close(rx);
    net.close(tx);
    return 0;
}
