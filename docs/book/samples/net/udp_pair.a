// UDP: two sockets exchange datagrams
import net;
import netaddr;

int main() {
    // udpBind(0) binds a free port on every interface; no connection is needed with UDP
    int a = net.udpBind(0);
    int b = net.udpBind(0);
    int loopback = netaddr.ipParse("127.0.0.1");
    net.setTimeout(a, 1000);
    net.setTimeout(b, 1000);

    // b sends one datagram to a
    int sent = net.sendTo(b, loopback, net.localPort(a), "ping", 4);
    printf("sent %d bytes\n", sent);

    // a receives it and learns who sent it
    char buf[64];
    int from;
    int fromPort;
    int n = net.recvFrom(a, buf, 63, &from, &fromPort);
    buf[n] = 0;
    printf("a got \"%s\" (%d bytes) from %s\n", buf, n, netaddr.ipToText(from));
    printf("the sender's port is b's port: %s\n", fromPort == net.localPort(b) ? "yes" : "no");

    // so a can answer without knowing anything else
    net.sendTo(a, from, fromPort, "pong", 4);
    n = net.recvFrom(b, buf, 63, null, null);
    buf[n] = 0;
    printf("b got \"%s\"\n", buf);

    net.close(a);
    net.close(b);
    return 0;
}
