// book: compile-only
// Talking to a real server: names, time limits and plain HTTP (needs the Internet)
import net;
import netaddr;

int main() {
    // names are looked up in /etc/hosts and then by DNS; -1 means "no such host"
    int ip = net.resolve("example.org");
    if (ip < 0) {
        println("cannot resolve example.org");
        return 1;
    }
    printf("example.org is %s\n", netaddr.ipToText(ip));

    // give up after 3 seconds instead of waiting for the system's own (long) time out
    int h = net.connectTimeout("example.org", 80, 3000);
    if (h < 0) {
        println("cannot connect");
        return 1;
    }
    net.setTimeout(h, 5000);                             // also applies to every recv and send
    net.sendText(h, "HEAD / HTTP/1.0\r\nHost: example.org\r\n\r\n");
    char line[200];
    if (net.recvLine(h, line, 200) >= 0) {
        println(line);                                   // e.g. HTTP/1.0 200 OK
    }
    net.close(h);

    // the smallest HTTP client: GET and return the body (HTTP/1.0, no redirects, no TLS)
    char* page = net.httpGet("example.org", 80, "/");
    if (page != null) printf("the page has %d bytes\n", strlen(page));
    return 0;
}
