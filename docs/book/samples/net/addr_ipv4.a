// IPv4 addresses as numbers
import netaddr;

void describe(char* text) {
    int ip = netaddr.ipParse(text);
    if (ip < 0) {
        printf("%-16s not an address\n", text);
        return;
    }
    printf("%-16s %-10u class %c", text, ip, netaddr.ipClass(ip));
    if (netaddr.isPrivate(ip))   print("  private");
    if (netaddr.isLoopback(ip))  print("  loopback");
    if (netaddr.isMulticast(ip)) print("  multicast");
    if (netaddr.isLinkLocal(ip)) print("  link-local");
    println("");
}

int main() {
    // an address is one int in host order: 192.168.1.77 = 0xC0A8014D
    int ip = netaddr.ipFromBytes(192, 168, 1, 77);
    printHex(ip); println("");
    println(netaddr.ipToText(ip));

    describe("192.168.1.77");
    describe("10.0.0.1");
    describe("172.20.5.9");
    describe("172.32.0.1");
    describe("127.0.0.1");
    describe("224.0.0.251");
    describe("169.254.10.20");
    describe("8.8.8.8");
    describe("1.2.3");
    describe("256.1.1.1");

    // the wire uses network byte order (big endian); this machine is little endian
    printHex(netaddr.htonl(ip)); println("");
    printHex(netaddr.htons(0x1234)); println("");
    return 0;
}
