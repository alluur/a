// Port names, host names and the Internet checksum
import netaddr;

char* valid(bool v) { return v ? "valid" : "invalid"; }

int main() {
    // well-known ports, both ways (servicePort gives -1 and serviceName gives null for a port that is not in the table)
    printf("port 443 is %s, port 22 is %s\n", netaddr.serviceName(443), netaddr.serviceName(22));
    printf("ssh is port %d, nope is port %d\n", netaddr.servicePort("ssh"), netaddr.servicePort("nope"));

    // host name syntax: letters, digits, hyphens and dots, no empty labels
    printf("my-host.example.org: %s\n", valid(netaddr.isHostname("my-host.example.org")));
    printf("-bad.example.org: %s\n", valid(netaddr.isHostname("-bad.example.org")));
    printf("a..b: %s\n", valid(netaddr.isHostname("a..b")));

    // the name that a PTR query asks for
    println(netaddr.reverseName(netaddr.ipFromBytes(1, 2, 3, 4)));

    // the example of RFC 1071: the bytes 00 01 f2 03 f4 f5 f6 f7 have the checksum 0x220d
    char data[10];
    data[0] = 0x00; data[1] = 0x01; data[2] = 0xf2; data[3] = 0x03;
    data[4] = 0xf4; data[5] = 0xf5; data[6] = 0xf6; data[7] = 0xf7;
    printf("checksum: %04x\n", netaddr.checksum(data, 8));

    // data that carries its own checksum adds up to zero: that is how receivers verify it
    data[8] = 0x22; data[9] = 0x0d;
    printf("with the checksum appended: %d\n", netaddr.checksum(data, 10));
    return 0;
}
