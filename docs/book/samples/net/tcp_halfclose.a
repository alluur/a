// shutdown: tell the other side that no more data follows
import net;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int client = net.connect("127.0.0.1", net.localPort(listener));
    int server = net.accept(listener);

    // the client sends its whole request and then closes only its sending direction
    net.sendText(client, "one request without a newline");
    net.shutdown(client, 1);

    // the server reads until the end of the data: recv returns 0
    char buf[100];
    int total = 0;
    for (;;) {
        int n = net.recv(server, &buf[total], 100 - total);
        if (n <= 0) break;
        total += n;
    }
    buf[total] = 0;
    printf("server read %d bytes: %s\n", total, buf);

    // the connection is still open in the other direction
    net.sendText(server, "answer");
    net.shutdown(server, 1);
    int n = net.recv(client, buf, 100);
    buf[n] = 0;
    printf("client read: %s\n", buf);
    printf("then the end: %d\n", net.recv(client, buf, 100));

    net.close(client);
    net.close(server);
    net.close(listener);
    return 0;
}
