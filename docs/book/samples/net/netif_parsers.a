// The parsers of netif, fed with fixed text instead of the live system
import netif;
import netaddr;

int main() {
    // /proc/net/route: addresses are little endian hex numbers
    char* routes =
        "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n"
        "eth0\t00000000\t0101A8C0\t0003\t0\t0\t100\t00000000\t0\t0\t0\n"
        "eth0\t0001A8C0\t00000000\t0001\t0\t0\t100\t00FFFFFF\t0\t0\t0\n";
    int n = netif.parseRoutes(routes);
    printf("%d routes\n", n);
    for (int i = 0; i < n; i++) {
        netif.Route* r = netif.routeAt(i);
        printf("%s: %s/%d via %s metric %d\n", r->device, netaddr.ipToText(r->dest),
               netaddr.prefixFromMask(r->mask), netaddr.ipToText(r->gateway), r->metric);
    }

    // /proc/net/arp
    char* arp =
        "IP address       HW type     Flags       HW address            Mask     Device\n"
        "192.168.1.1      0x1         0x2         aa:bb:cc:dd:ee:01     *        eth0\n"
        "192.168.1.20     0x1         0x0         00:00:00:00:00:00     *        eth0\n";
    n = netif.parseArp(arp);
    for (int i = 0; i < n; i++) {
        netif.ArpEntry* e = netif.arpAt(i);
        printf("%s is at %s on %s, complete: %s\n", netaddr.ipToText(e->ip), netaddr.macToText(&e->mac[0]),
               e->device, e->complete ? "yes" : "no");
    }

    // /proc/net/tcp: one listening socket and one connection
    char* tcp =
        "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n"
        "   0: 0100007F:1F90 00000000:0000 0A 00000000:00000000 00:00000000 00000000  1000        0 37 1 0000 100 0 0 10 0\n"
        "   1: 0201A8C0:C350 0100A8C0:0050 01 00000000:00000000 00:00000000 00000000     0        0 38 1 0000 100 0 0 10 0\n";
    n = netif.parseSockets(tcp, "tcp", true);
    for (int i = 0; i < n; i++) {
        netif.Socket* s = netif.connectionAt(i);
        printf("%s %s:%d -> %s:%d %s\n", s->proto, netaddr.ipToText(s->localIp), s->localPort,
               netaddr.ipToText(s->remoteIp), s->remotePort, netif.stateName(s->state));
    }
    return 0;
}
