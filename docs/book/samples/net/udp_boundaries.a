// A datagram arrives whole, or not at all
import net;

int main() {
    int rx = net.udpBind(0);
    int tx = net.udpSocket();
    int ip = net.parseIp("127.0.0.1");
    int port = net.localPort(rx);
    net.setTimeout(rx, 500);

    // three datagrams of different sizes ...
    net.sendTo(tx, ip, port, "one", 3);
    net.sendTo(tx, ip, port, "second datagram", 15);
    net.sendTo(tx, ip, port, "", 0);

    // ... come out as three separate receives, never merged (unlike a TCP stream)
    char buf[64];
    for (int i = 0; i < 3; i++) {
        int n = net.recvFrom(rx, buf, 64, null, null);
        printf("datagram %d has %d bytes\n", i + 1, n);
    }

    // a buffer that is too small cuts the datagram; the rest is lost
    net.sendTo(tx, ip, port, "0123456789", 10);
    int n = net.recvFrom(rx, buf, 4, null, null);
    buf[n] = 0;
    printf("buffer of 4: got %d bytes: %s\n", n, buf);
    printf("another receive times out: %d\n", net.recvFrom(rx, buf, 64, null, null));

    net.close(rx);
    net.close(tx);
    return 0;
}
