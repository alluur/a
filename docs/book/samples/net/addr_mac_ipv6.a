// MAC and IPv6 addresses
import netaddr;

char* yn(bool v) { return v ? "yes" : "no"; }

void v6(char* text) {
    char a[16];
    if (!netaddr.ip6Parse(text, a)) {
        printf("%s: not an IPv6 address\n", text);
        return;
    }
    printf("%s -> %s\n", text, netaddr.ip6ToText(a));
}

int main() {
    // a MAC address is 6 bytes; both ':' and '-' are accepted when parsing
    char mac[6];
    printf("parsed: %s\n", yn(netaddr.macParse("AA-bb-0c-0D-ee-01", mac)));
    println(netaddr.macToText(mac));
    printf("multicast: %s\n", yn(netaddr.macIsMulticast(mac)));
    printf("short text parsed: %s\n", yn(netaddr.macParse("aa:bb:cc", mac)));
    netaddr.macParse("ff:ff:ff:ff:ff:ff", mac);
    printf("broadcast: %s\n", yn(netaddr.macIsBroadcast(mac)));

    // an IPv6 address is 16 bytes in network order; the text form is shortened with ::
    v6("2001:0db8:0000:0000:0000:ff00:0042:8329");
    v6("2001:db8::ff00:42:8329");
    v6("::1");
    v6("::");
    v6("fe80::1:0:0:2");
    v6("1:2:3:4:5:6:7:8:9");

    char a[16];
    netaddr.ip6Parse("::1", a);
    printf("::1 is loopback: %s\n", yn(netaddr.ip6IsLoopback(a)));
    netaddr.ip6Parse("fe80::1", a);
    printf("fe80::1 is link-local: %s\n", yn(netaddr.ip6IsLinkLocal(a)));

    // an IPv4 address inside IPv6 (::ffff:a.b.c.d) and back
    netaddr.ip6FromV4(netaddr.ipParse("10.1.2.3"), a);
    println(netaddr.ip6ToText(a));
    int v4;
    if (netaddr.ip6ToV4(a, &v4)) println(netaddr.ipToText(v4));
    return 0;
}
