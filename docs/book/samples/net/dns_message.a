// A DNS query and reply, byte by byte
import dns;
import net;
import packet;
import netaddr;

int main() {
    // a query for the A record of www.example.org: 12 byte header + the name as labels + type + class
    char query[100];
    int n = dns.buildQuery("www.example.org", dns.A, 0x1234, query);
    printf("the query is %d bytes\n", n);
    print(packet.hexdump(query, n));

    // names are checked: an empty label is refused (use another buffer, a failed call has already written into it)
    char junk[100];
    printf("buildQuery(\"bad..name\") returns %d\n", dns.buildQuery("bad..name", dns.A, 1, junk));

    // a server answers with the question again plus answer records; buildReply makes a minimal one
    char reply[200];
    int rn = dns.buildReply(query, n, netaddr.ipParse("93.184.216.34"), reply);
    printf("the reply is %d bytes, flags %02x%02x\n", rn, reply[2], reply[3]);

    // parseReply checks the id and decodes the records into dns.recordAt(i)
    int count = dns.parseReply(reply, rn, 0x1234);
    printf("records: %d\n", count);
    dns.Record* r = dns.recordAt(0);
    printf("%s %s %d %s\n", dns.typeName(r->type), r->name, r->ttl, dns.recordText(r));

    // a reply for a different query id is not ours
    printf("wrong id: %d\n", dns.parseReply(reply, rn, 0x9999));

    // the answer "no such name" is a reply with response code 3 and no records
    rn = dns.buildReply(query, n, 0, reply);
    printf("NXDOMAIN: %d records, rcode %d\n", dns.parseReply(reply, rn, 0x1234), dns.rcode());
    return 0;
}
