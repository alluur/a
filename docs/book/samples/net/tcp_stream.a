// TCP is a stream of bytes, not a series of messages
import net;

// recv may return fewer bytes than asked for: loop until all n bytes are there
int recvAll(int h, char* buf, int n) {
    int got = 0;
    while (got < n) {
        int r = net.recv(h, &buf[got], n - got);
        if (r <= 0) break;
        got += r;
    }
    return got;
}

int sum(char* data, int n) {
    int s = 0;
    for (int i = 0; i < n; i++) s += data[i];
    return s;
}

int main() {
    int server = net.listenOn("127.0.0.1", 0, 4);
    int client = net.connect("127.0.0.1", net.localPort(server));
    int peer = net.accept(server);

    // three separate writes of 1000 bytes each ...
    char block[1000];
    for (int i = 0; i < 1000; i++) block[i] = 'a' + i % 26;
    for (int i = 0; i < 3; i++) {
        net.send(client, block, 1000);
    }

    // ... arrive as 3000 bytes with no boundaries; ask for what you expect
    char* in = alloc(3000);
    int got = recvAll(peer, in, 3000);
    printf("received %d bytes\n", got);
    printf("checksum %d, expected %d\n", sum(in, 3000), 3 * sum(block, 1000));

    // net.send only returns after all bytes are handed to the system
    printf("send returned %d\n", net.send(client, "tail", 4));
    net.close(client);
    net.close(peer);
    net.close(server);
    return 0;
}
