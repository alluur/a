// Waiting for several sockets at once with poll
import net;

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    int a = net.connect("127.0.0.1", port);
    int b = net.connect("127.0.0.1", port);
    int sa = net.accept(listener);
    int sb = net.accept(listener);

    int handles[2];
    int events[2];
    int ready[2];
    handles[0] = sa; handles[1] = sb;
    events[0] = net.READABLE; events[1] = net.READABLE;

    // nothing was sent yet: poll waits 50 ms and returns 0; with 0 ms it only looks (a non-blocking check)
    printf("ready sockets: %d\n", net.poll(handles, events, ready, 2, 50));
    printf("look without waiting: %s\n", net.waitReadable(sa, 0) ? "data" : "nothing yet");

    // data on the second connection only
    net.sendText(b, "ping from b");
    int n = net.poll(handles, events, ready, 2, 1000);
    printf("ready sockets: %d\n", n);
    for (int i = 0; i < 2; i++) {
        printf("  socket %d readable: %s\n", i, (ready[i] & net.READABLE) != 0 ? "yes" : "no");
    }

    char buf[32];
    int got = net.recv(sb, buf, 31);
    buf[got] = 0;
    println(buf);

    // a closed peer also makes a socket readable: reading then gives 0
    net.close(a);
    n = net.poll(handles, events, ready, 2, 1000);
    printf("ready after a closed: %d, socket 0 readable: %s\n", n, (ready[0] & net.READABLE) != 0 ? "yes" : "no");
    printf("read gives %d\n", net.recv(sa, buf, 31));

    // a socket with room to send is WRITABLE
    events[1] = net.WRITABLE;
    net.poll(&handles[1], &events[1], &ready[1], 1, 0);
    printf("writable: %s\n", (ready[1] & net.WRITABLE) != 0 ? "yes" : "no");

    net.close(b); net.close(sa); net.close(sb); net.close(listener);
    return 0;
}
