// packet: save frames to a .pcap file that Wireshark opens, and read them back
import packet;
import netaddr;

int main() {
    char src[6]; char dst[6];
    netaddr.macParse("02:00:00:00:00:01", src);
    netaddr.macParse("02:00:00:00:00:02", dst);
    int a = netaddr.ipParse("10.0.0.1");
    int b = netaddr.ipParse("10.0.0.2");
    char udp[100]; char ip[150]; char frame[200];

    // two frames with time stamps (seconds and microseconds)
    packet.PcapWriter* w = new packet.PcapWriter("dump.pcap");
    for (int i = 0; i < 2; i++) {
        int un = packet.udpBuild(a, b, 4000 + i, 53, "query", 5, udp);
        int in = packet.ipBuild(a, b, packet.PROTO_UDP, 64, i, udp, un, ip);
        int n = packet.ethBuild(dst, src, packet.ETH_IPV4, ip, in, frame);
        w->write(frame, n, 1700000000 + i, 250000 * (i + 1));
    }
    printf("wrote %d packets\n", w->packets);
    w->close();

    // the file starts with a magic number, then one record per frame
    char* raw = readFile("dump.pcap");
    printf("first bytes: %02x %02x %02x %02x\n", raw[0], raw[1], raw[2], raw[3]);

    packet.PcapReader* r = new packet.PcapReader("dump.pcap");
    char buf[200];
    int len;
    while ((len = r->next(buf, 200)) >= 0) {
        printf("%d.%06d  %s\n", r->sec, r->usec, packet.describe(buf, len));
    }
    r->close();
    printf("a file that is not there: %s\n", new packet.PcapReader("missing.pcap")->ok() ? "opened" : "not opened");
    return 0;
}
