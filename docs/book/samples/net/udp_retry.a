// UDP can lose packets: time out and ask again
import net;

int main() {
    int server = net.udpBind(0);
    int client = net.udpSocket();
    int ip = net.parseIp("127.0.0.1");
    int port = net.localPort(server);
    net.setTimeout(client, 100);

    char buf[64];
    int attempt = 0;
    int answered = 0;
    while (attempt < 5 && !answered) {
        attempt++;
        net.sendTo(client, ip, port, "ping", 4);

        // the "network" drops the first two requests: the server reads them and does not answer
        int from;
        int fromPort;
        net.recvFrom(server, buf, 64, &from, &fromPort);
        if (attempt == 3) {
            net.sendTo(server, from, fromPort, "pong", 4);
        }

        int n = net.recvFrom(client, buf, 63, null, null);
        if (n < 0) {
            printf("attempt %d: no answer within 100 ms\n", attempt);
        } else {
            buf[n] = 0;
            printf("attempt %d: answer \"%s\"\n", attempt, buf);
            answered = 1;
        }
    }
    net.close(server);
    net.close(client);
    return 0;
}
