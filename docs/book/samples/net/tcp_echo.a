// A TCP server and a client in one program
import net;

int main() {
    // port 0 asks the system for a free port; localPort tells which one we got
    int server = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(server);
    printf("listening on an ephemeral port: %s\n", port > 0 ? "yes" : "no");

    // the connection is completed by the system while the server waits in its backlog,
    // so one thread can play both sides as long as the messages are small
    int client = net.connect("127.0.0.1", port);
    int peer = net.accept(server);

    net.sendText(client, "hello server\n");
    char line[128];
    net.recvLine(peer, line, 128);
    printf("server got: %s\n", line);

    net.sendText(peer, "hello client\n");
    net.recvLine(client, line, 128);
    printf("client got: %s\n", line);

    // closing one side shows up as end of data (0) on the other
    net.close(client);
    char buf[16];
    printf("recv after the client closed: %d\n", net.recv(peer, buf, 16));
    net.close(peer);
    net.close(server);
    return 0;
}
