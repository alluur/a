// The colour picker dialog
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;
int chosen = -2;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

// called when the dialog is closed: the colour as 0xFFRRGGBB, or 0 when cancelled
int picked(int color) { chosen = color; return 0; }

int main() {
    screen = new wsrv.Headless(420, 500);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "picker");

    // (display, title, start colour, callback)
    gui.Window* w = gcode.pickColor(d, "Choose a colour", 0x3478C0, picked);
    settle();
    wsrv.Win* sw = srv->windowAt(0);
    printf("a dialog window of %d x %d pixels\n", sw->w, sw->h);
    screen->moveTo(410, 490);
    settle();
    gimg.savePng(srv->screen, "out.png");

    screen->tap(13, 13);                                    // Enter presses the default button, OK
    settle();
    printf("chosen: %06X\n", chosen & 0xFFFFFF);
    return 0;
}
