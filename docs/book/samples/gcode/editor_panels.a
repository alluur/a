// Tabs, find bar, outline and status bar around the editor
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

// one document per tab: the text, its language and a title
gcode.Doc* makeDoc(char* title, char* text) {
    gcode.Doc* doc = new gcode.Doc();
    doc->setText(text);
    doc->setLanguage(asyntax.Lang.A);
    doc->setTitle(title);
    return doc;
}

int main() {
    wsrv.Headless* screen = new wsrv.Headless(720, 360);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "panels");

    gcode.Doc* util = makeDoc("util.a", "int count;\n\nint next() {\n    count += 1;\n    return count;\n}\n\nint reset() {\n    count = 0;\n    return count;\n}\n");
    gcode.Doc* main = makeDoc("main.a", "int main() {\n    return 0;\n}\n");

    gcode.CodeEditor* ed = new gcode.CodeEditor();
    ed->blink = false;
    ed->setDoc(util);                                        // the editor shows one document at a time
    gcode.TabBar* tabs = new gcode.TabBar();
    tabs->addTab("util.a", (int) util);                      // the tab keeps the Doc as its user data
    tabs->addTab("main.a", (int) main);
    tabs->setModified(1, true);                              // a dot on the tab
    tabs->select(0);
    gcode.Outline* outline = new gcode.Outline(ed);          // follows the document the editor shows
    outline->w = 170;
    outline->flex = 0;                                       // keeps its width
    gcode.FindBar* find = new gcode.FindBar(ed);
    gcode.EditorStatus* status = new gcode.EditorStatus(ed);

    gui.Window* w = d->createWindowAt("IDE parts", 10, 36, 700, 310, 0);
    gui.Box* right = gui.vbox(0, 0);
    right->add(tabs);
    ed->flex = 1;
    right->add(ed);
    right->add(find);
    right->add(status->bar);
    right->flex = 1;
    gui.Box* row = gui.hbox(0, 0);
    row->add(outline);
    row->add(right);
    w->setRoot(row);
    w->setFocus(ed);
    settle();

    find->open(false);                                       // false: find only, true: find and replace
    find->setPattern("count");
    settle();
    printf("pattern \"count\": %d matches, the selected one is number %d\n", find->matchCount, find->matchIndex);
    printf("outline: %d symbols; tabs: %d; status: %s\n", outline->symbolCount(), tabs->tabCount(), status->bar->text(1));
    screen->moveTo(715, 355);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
