// One editor, four themes: every editor can have a Look of its own
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

char* code = "// A class with a method\n"
             "class Counter {\n"
             "    int count;\n"
             "    int next() {\n"
             "        count += 1;\n"
             "        return count;   // 1, 2, 3 ...\n"
             "    }\n"
             "}\n"
             "const NAME = \"counter\";\n";

// an editor with its own Look in the named theme
gcode.CodeEditor* make(char* theme) {
    gcode.Look* look = new gcode.Look();                 // a Look holds a theme, a font and the editor preferences
    look->setThemeName(theme);
    look->highlightLine = false;
    gcode.CodeEditor* e = new gcode.CodeEditor();
    e->setLook(look);                                    // instead of the shared gcode.theLook()
    e->blink = false;
    e->setText(code);
    e->doc->setLanguage(asyntax.Lang.A);
    e->flex = 1;
    return e;
}

int main() {
    wsrv.Headless* screen = new wsrv.Headless(640, 400);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "themes");

    gui.Window* w = d->createWindowAt("Themes", 10, 36, 620, 350, 0);
    gui.Box* grid = gui.vbox(2, 0);
    gui.Box* top = gui.hbox(2, 0);
    gui.Box* bottom = gui.hbox(2, 0);
    top->flex = 1;
    bottom->flex = 1;
    top->add(make("light"));
    top->add(make("monokai"));
    bottom->add(make("solarized-dark"));
    bottom->add(make("nord"));
    grid->add(top);
    grid->add(bottom);
    w->setRoot(grid);
    settle();
    printf("themes shown: light, monokai, solarized-dark, nord\n");
    screen->moveTo(630, 395);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
