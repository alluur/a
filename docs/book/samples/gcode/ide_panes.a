// Find in files, a program with input, and the documentation
// book: shot=out.png
// book: linux-only
import wsrv;
import gui;
import gcode;
import aproject;
import asys;
import cstdlib;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }
void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int main() {
    asys.mkdirs("proj/src");
    asys.mkdirs("docs");
    put("proj/src/main.a", "int main() {\n    // TODO: handle errors\n    return run();\n}\n");
    put("proj/src/run.a", "int run() {\n    // TODO: parse arguments\n    return 0;\n}\n");
    put("docs/GUIDE.md", "# Guide\n\nStart with the [tutorial](TUTORIAL.md).\n\n- build with F7\n- run with F5\n");
    put("docs/TUTORIAL.md", "# Tutorial\n\nWrite `main.a` and press F5.\n");
    setenv("AIDE_DOCS", "docs", 1);                      // where DocView looks for Markdown files

    screen = new wsrv.Headless(700, 520);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "ide");

    gcode.SearchPane* search = new gcode.SearchPane();
    gcode.RunPane* run = new gcode.RunPane();
    gcode.DocView* docs = new gcode.DocView();
    gui.Window* w = d->createWindowAt("IDE panes", 10, 36, 680, 470, 0);
    gui.Box* top = gui.hbox(0, 0);
    top->flex = 1;
    top->add(search);
    top->add(docs);
    gui.Box* col = gui.vbox(0, 0);
    col->add(top);
    col->add(run);
    w->setRoot(col);
    settle();

    // find in files: the pane searches from a timer; step() does it by hand
    aproject.Ignore* ign = new aproject.Ignore();
    ign->addBuiltin();
    search->setRoot("proj", ign);
    search->search("TODO");
    for (int i = 0; i < 200 && search->running; i++) { search->step(); }
    printf("search: %d matches in %d files\n", search->matches, search->files);

    // the documentation: Markdown files of the folder, shown as pages with links
    printf("documentation pages: %d\n", docs->openDocs());
    docs->showPage("docs/GUIDE.md", true);

    // a program with input: what you type goes to its standard input
    aproject.Job* job = new aproject.Job();
    char* script = "echo 'name?'; read n; echo \"hello $n\"";
    char* argv[4];
    argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = script; argv[3] = null;
    job->start(&argv[0], null, null);
    run->start(job, "greeter");
    for (int i = 0; i < 100 && run->output->lineCount() < 1; i++) { srv->step(0); d->pump(10); }
    settle();
    screen->moveTo(695, 515);
    settle();
    gimg.savePng(srv->screen, "out.png");                  // the picture: the program waits for its input
    run->sendLine("Ada");
    for (int i = 0; i < 100 && run->running; i++) { srv->step(0); d->pump(10); }
    settle();
    printf("the program ended: exit code %d, output lines: %d, line 3 of the output: %s\n", run->exitCode, run->output->lineCount(), run->output->lineText(2));
    return 0;
}
