defaults: tab width 4, spaces 1, theme dark
saved: 0
[editor]
tabWidth = 2
insertSpaces = true
lineNumbers = true
wordWrap = false
fontSize = 14
autoIndent = true
trimOnSave = false
finalNewline = false
theme = nord
font = mono

[window]
x = 80
y = 60
width = 960
height = 640
maximized = false

[recent]
file = "/home/ada/main.a"
file = "/home/ada/util.a"

[keys]
file.save = ctrl+s
loaded: 0, tab width 2, theme nord, recent: /home/ada/main.a then /home/ada/util.a
a damaged file: tab width clamped to 16, 2 line(s) not understood
a missing file: -2 (no such file), the settings keep their values: 16
