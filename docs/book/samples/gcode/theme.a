// Themes: colours for the editor, checked for contrast
import atheme;
import asyntax;

int main() {
    printf("built in: %s\n", atheme.builtinNames());

    // a theme is a set of named colours and a colour (and style) per kind of token
    atheme.Theme* dark = atheme.builtin("dark");
    char hex[12];
    atheme.formatColor(dark->color(atheme.Col.Background), &hex[0]);
    printf("dark: background %s, ", &hex[0]);
    atheme.formatColor(dark->tokenColor(asyntax.Tok.Keyword), &hex[0]);
    printf("keywords %s, bold %d\n", &hex[0], (dark->tokenStyle(asyntax.Tok.Keyword) & atheme.STYLE_BOLD) != 0);

    // a theme file names only what it changes: the rest comes from "base"
    char* ini = "[theme]\nname = My theme\nbase = dark\n[colors]\nbackground = #101820\nforeground = #f0f0f0\n"
                "[tokens]\nkeyword = #ff8800 bold\ncomment = #dddddd italic\n";
    atheme.Warnings warn();
    atheme.Theme* mine = atheme.parseTheme(ini, strlen(ini), &warn);
    atheme.formatColor(mine->color(atheme.Col.Background), &hex[0]);
    printf("%s: background %s, string colour kept from dark: %d, warnings: %d\n", mine->name, &hex[0],
           mine->tokenColor(asyntax.Tok.String) == dark->tokenColor(asyntax.Tok.String), warn.count);

    // the contrast checker: WCAG ratio * 100 (4.5:1 is the minimum for text)
    atheme.Warnings problems();
    mine->validate(&problems);
    printf("validate: %d warning(s)\n", problems.count);
    int ratio = atheme.contrast(mine->tokenColor(asyntax.Tok.Comment), mine->color(atheme.Col.Background));
    printf("comments on the background: contrast %d, that is %d.%02d:1\n", ratio, ratio / 100, ratio % 100);
    mine->setColor(atheme.Col.Foreground, 0x303030);          // dark gray text on a dark background
    atheme.Warnings again();
    mine->validate(&again);
    printf("after making the text dark: %d warning(s)\n", again.count);
    for (int i = 0; i < again.count && i < 2; i++) { printf("  %s\n", again.items[i]); }

    // colour helpers
    int c = 0;
    atheme.parseColor("#fa0", &c);                            // short form
    printf("#fa0 = %06x, lighter %06x, darker %06x, 256-colour index %d\n", c, atheme.lighten(c, 30), atheme.darken(c, 30), atheme.to256(c));
    return 0;
}
