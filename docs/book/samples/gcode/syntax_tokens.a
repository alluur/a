// Highlighting: the spans of a line, and the state that carries over
import asyntax;
import acode;

// the names of the token kinds, in the order of the enum Tok
char* kindName(int k) {
    char* names[24] = {"plain", "keyword", "type", "builtin", "constant", "number", "string", "char", "escape", "comment", "doc",
                       "preproc", "operator", "punct", "function", "variable", "tag", "attribute", "heading", "emphasis", "link", "code", "quote", "error"};
    return names[k];
}

// lex one line (state = what the previous line left behind) and print the spans
int lex(int state, char* text) {
    asyntax.Token tok[64];
    int end = 0;
    int n = asyntax.lexLine(asyntax.Lang.A, state, text, strlen(text), &tok[0], 64, &end);   // a pure function
    printf("%-40s", text);
    for (int i = 0; i < n; i++) {
        if (tok[i].kind == asyntax.Tok.Plain || tok[i].kind == asyntax.Tok.Punct) { continue; }
        printf(" %.*s=%s", tok[i].len, &text[tok[i].start], kindName(tok[i].kind));
    }
    printf("   [state after: %d]\n", end);
    return end;
}

int main() {
    // spans cover the line without gaps; here only the interesting ones are printed
    int s = lex(0, "int x = 0x1F + 'a'; // note");
    s = lex(s, "if (x) return \"hi\\n\";");
    println("a block comment that spans lines changes the state:");
    s = lex(s, "/* starts here");
    s = lex(s, "still inside int x;");
    s = lex(s, "ends */ return 1;");

    // the language of a file
    printf("main.a: %s, Makefile: %s, run.sh: %s, notes.md: %s\n",
           asyntax.languageName(asyntax.detectLanguage("main.a", null)), asyntax.languageName(asyntax.detectLanguage("Makefile", null)),
           asyntax.languageName(asyntax.detectLanguage("run.sh", null)), asyntax.languageName(asyntax.detectLanguage("notes.md", null)));
    printf("a script without extension: %s\n", asyntax.languageName(asyntax.detectLanguage("tool", "#!/usr/bin/env python3")));
    return 0;
}
