// The terminal panel: a real shell command in the colours of the theme
// book: shot=out.png
// book: linux-only
import wsrv;
import gui;
import gcode;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

int main() {
    wsrv.Headless* screen = new wsrv.Headless(520, 230);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "terminal");

    gcode.theLook()->setThemeName("nord");                 // the panel follows the theme of the editor
    gui.Window* w = d->createWindowAt("Terminal", 10, 36, 500, 170, 0);
    gcode.TerminalPane* term = new gcode.TerminalPane();
    gui.Box* col = gui.vbox(0, 0);
    col->add(term);
    w->setRoot(col);
    settle();
    // start(display, command): a pseudo terminal with the command; the panel collects the process when it ends
    printf("started: %d\n", term->start(d, "printf '\\033[32mbuild ok\\033[0m\\n'; printf 'program says: '; echo $TERM; sleep 1"));
    for (int i = 0; i < 100; i++) { srv->step(0); d->pump(10); }
    settle();
    printf("row 1: %s\n", term->lineText(0));
    printf("row 2: %s\n", term->lineText(1));
    screen->moveTo(515, 225);
    settle();
    gimg.savePng(srv->screen, "out.png");
    term->stop();
    return 0;
}
