// The text of a document: a Buffer with lines, edits and undo
import acode;

// print every line with its number
void show(acode.Buffer* b) {
    for (int i = 0; i < b->lineCount(); i++) {
        int len = 0;
        char* p = b->linePtr(i, &len);            // a pointer into the text: no copy, not NUL terminated
        printf("%2d| %.*s\n", i + 1, len, p);
    }
}

int changes;
int onChange(int user, acode.Change* c) {         // called after every change, also by undo and redo
    changes++;
    return 0;
}

int main() {
    acode.Buffer b();                              // objects with a constructor are declared with parentheses
    b.addListener(onChange, 0);
    b.setText("alpha\nbeta\ngamma\n", 17);         // (text, number of bytes)
    printf("%d lines, %d bytes, version %d, modified %d\n", b.lineCount(), b.length(), b.version, b.modified());
    b.markSaved();                                 // this state is what is on disk now

    b.insert(b.lineStart(1), "-> ", 3);            // offsets are bytes; lineStart(i) is the offset of line i
    b.remove(b.lineStart(2), b.lineStart(2) + 2);  // remove "ga"
    show(&b);
    printf("version %d, modified %d, listener calls %d\n", b.version, b.modified(), changes);

    int snapshot[8];                               // undo gives back the cursor snapshot stored with the step
    b.undo(&snapshot[0], 8);
    b.undo(&snapshot[0], 8);
    show(&b);
    printf("modified %d, can redo %d\n", b.modified(), b.canRedo());     // back at the saved state: not modified

    // positions: which line is byte 8 on, and what does a line hold
    printf("byte 8 is on line %d (counting from 0)\n", b.lineAt(8));
    b.dispose();                                   // gives everything back
    return 0;
}
