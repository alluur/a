// Search and replace in a buffer, with regular expressions
import afind;
import acode;
import asys;

int main() {
    acode.Buffer b();
    acode.Editor e(&b);
    char* text = "ada@example.org, grace@navy.mil;\nalan@kings.edu\n";
    b.setText(text, strlen(text));

    afind.Finder f(&b);
    f.setPattern("(\\w+)@(\\w+)", afind.OPT_REGEX | afind.OPT_NOWRAP);   // options: OPT_REGEX OPT_ICASE OPT_WORD OPT_NOWRAP
    printf("matches: %d\n", f.count(100));                // counting does not disturb the current match

    int from = 0;
    while (f.findNext(from)) {                            // findNext(offset): the first match at or after it (NOWRAP: none after the end)
        char* hit = b.getText(f.curStart, f.curEnd);
        printf("  line %d: %s\n", b.lineAt(f.curStart) + 1, hit);
        asys.free(hit);
        from = f.curEnd;
    }

    // replace all: $1 and $2 are the groups. It is ONE undo step for the whole text.
    int n = f.replaceAll(&e, "$2:$1");
    printf("replaced %d:\n%s", n, b.flatten());
    e.undo();
    printf("after one undo the text is back: %d\n", streq(b.flatten(), text));

    // plain text, ignoring case, whole words only
    f.setPattern("ADA", afind.OPT_ICASE | afind.OPT_WORD);
    printf("\"ADA\" as a whole word: %d match(es)\n", f.count(100));
    f.setPattern("(", afind.OPT_REGEX);                   // a pattern that does not compile
    printf("bad pattern: ok %d, error: %s\n", f.ok, f.error);
    return 0;
}
