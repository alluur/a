// Files, directories and errors with asys
import asys;

int main() {
    // every call returns a value >= 0, or -ERRNO; errText turns the number into words
    asys.mkdirs("work/notes/old");                          // like mkdir -p
    char* text = "first line\nsecond line\n";
    int rc = asys.writeFileAtomic("work/notes/a.txt", text, strlen(text));   // temp file, fsync, rename
    printf("write: %d\n", rc);

    int len = 0;
    int err = 0;
    char* data = asys.readFile("work/notes/a.txt", &len, -1, &err);     // (path, &length, size limit, &error)
    printf("read %d bytes: %s", len, data);
    asys.free(data);                                        // asys memory is freed with asys.free

    data = asys.readFile("work/notes/missing.txt", &len, -1, &err);
    printf("missing file: %s (%s)\n", data == null ? "null" : "found", asys.errText(err));
    data = asys.readFile("work/notes", &len, -1, &err);     // a directory is not a regular file
    printf("a directory: %s\n", asys.errText(err));
    data = asys.readFile("work/notes/a.txt", &len, 5, &err);   // a size limit
    printf("limit of 5 bytes: %s\n", asys.errText(err));

    asys.writeFile("work/notes/b.txt", "bee", 3);
    asys.Stat st;
    asys.stat("work/notes/b.txt", &st);
    printf("b.txt: %d bytes, file %d, directory %d\n", st.size, st.isFile(), st.isDir());

    // the content of a directory: names and kinds, folders first, no stat call per entry
    asys.DirList dir;
    asys.listDir("work/notes", &dir);
    dir.sort(true, true);                                   // (directories first, ignore case)
    for (int i = 0; i < dir.count; i++) {
        printf("  %s%s\n", dir.name(i), dir.kind(i) == asys.K_DIR ? "/" : "");
    }
    dir.dispose();

    printf("rename: %d, then a.txt exists: %d, c.txt exists: %d\n", asys.rename("work/notes/a.txt", "work/notes/c.txt"), asys.exists("work/notes/a.txt"), asys.exists("work/notes/c.txt"));
    printf("valid file names: 'ok.a' %d, 'a/b' %d, '..' %d\n", asys.validName("ok.a"), asys.validName("a/b"), asys.validName(".."));
    return 0;
}
