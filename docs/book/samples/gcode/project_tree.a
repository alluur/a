// A project tree with .gitignore rules
import aproject;
import asys;

// print a tree the way an explorer would show it
void show(aproject.FileTree* t, aproject.TreeNode* n, int depth) {
    for (int i = 0; i < n->nkids; i++) {
        aproject.TreeNode* k = n->kids[i];
        printf("%*s%s%s\n", depth * 2, "", k->name, k->isDir() ? "/" : "");
        if (k->isDir()) {
            t->load(k);                              // folders are read when they are opened, not before
            show(t, k, depth + 1);
        }
    }
}

int main() {
    asys.mkdirs("proj/src");
    asys.mkdirs("proj/build");
    asys.mkdirs("proj/node_modules/x");
    asys.writeFile("proj/main.a", "int main() { return 0; }\n", 25);
    asys.writeFile("proj/src/util.a", "int one() { return 1; }\n", 24);
    asys.writeFile("proj/src/notes.txt", "n", 1);
    asys.writeFile("proj/build/out.o", "o", 1);
    asys.writeFile("proj/node_modules/x/i.js", "x", 1);
    asys.writeFile("proj/.gitignore", "build/\n*.txt\n", 13);

    aproject.Ignore ign();
    ign.addBuiltin();                                // .git, node_modules, *.o ...
    ign.loadFile("proj/.gitignore", "");             // the project's own rules
    printf("%d rules\n", ign.count);
    printf("src/notes.txt ignored: %d, src/util.a ignored: %d, build ignored (as a directory): %d\n",
           ign.ignored("src/notes.txt", false), ign.ignored("src/util.a", false), ign.ignored("build", true));

    aproject.FileTree* tree = new aproject.FileTree("proj", &ign);
    tree->load(tree->root);
    show(tree, tree->root, 0);

    // glob matching: * stays inside a name, ** crosses folders
    printf("globs: *.a matches main.a: %d, src/*.a matches src/x/y.a: %d, **/y.a matches src/x/y.a: %d\n",
           aproject.globMatch("*.a", "main.a"), aproject.globMatch("src/*.a", "src/x/y.a"), aproject.globMatch("**/y.a", "src/x/y.a"));
    return 0;
}
