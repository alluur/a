// Running a child process with pipes that never block
// book: linux-only
import asys;

// runs "sh -c script", collects what it writes and waits for it
void run(char* script, int flags, char** env) {
    asys.Process p();                                 // with parentheses: a plain declaration is not constructed
    char* argv[4];
    argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = script; argv[3] = null;
    int rc = p.start(&argv[0], null, env, flags);     // (argv, working directory, extra environment, flags)
    if (rc < 0) { printf("cannot start: %s\n", asys.errText(rc)); return; }
    char out[400];
    char err[400];
    int no = 0;
    int ne = 0;
    while (p.running || p.outFd >= 0 || p.errFd >= 0) {
        p.waitReadable(50);                           // wait until a pipe has data or the child ended
        char tmp[200];
        int n = p.read(1, &tmp[0], 200);              // 1 = standard output; > 0 bytes, 0 = closed, < 0 = nothing yet
        if (n > 0 && no + n < 399) { memcpy(&out[no], &tmp[0], n); no = no + n; }
        if (n == 0) { p.closeOut(); }
        n = p.read(2, &tmp[0], 200);                  // 2 = standard error
        if (n > 0 && ne + n < 399) { memcpy(&err[ne], &tmp[0], n); ne = ne + n; }
        if (n == 0) { p.closeErr(); }
        if (p.running) { p.tryWait(); }
    }
    while (no > 0 && out[no - 1] == '\n') { no--; }       // cut the final line break, replace the others by "/"
    while (ne > 0 && err[ne - 1] == '\n') { ne--; }
    out[no] = 0;
    err[ne] = 0;
    for (int i = 0; i < no; i++) { if (out[i] == '\n') { out[i] = '/'; } }
    printf("stdout [%s]  stderr [%s]  exit code %d\n", &out[0], &err[0], p.exitCode);
}

int main() {
    run("echo hello; echo oops 1>&2; exit 4", asys.P_STDOUT | asys.P_STDERR, null);
    run("echo hello; echo oops 1>&2", asys.P_STDOUT | asys.P_MERGE, null);       // one pipe for both
    char* env[2];
    env[0] = "GREETING=hi from env"; env[1] = null;
    run("echo $GREETING", asys.P_STDOUT, &env[0]);
    char* argv[2];
    argv[0] = "/no/such/program"; argv[1] = null;
    asys.Process bad();
    printf("a program that does not exist: %s\n", asys.errText(bad.start(&argv[0], null, null, 0)));
    return 0;
}
