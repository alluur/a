// Commands with keys, and the command palette
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import adp;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;
gcode.Commands* cmds;
gcode.Palette* palette;
gui.Window* w;
char last[60] = "(nothing yet)";

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

// a command function gets the user data it was registered with
int save(int user) { strcpy(&last[0], "file.save ran"); return 0; }
int wrap(int user) { strcpy(&last[0], "view.wrap ran"); return 0; }
int build(int user) { strcpy(&last[0], "build.run ran"); return 0; }
int openPalette(int user) { palette->showCommands(w, cmds); return 0; }

void ctrl(int key, int uni, bool shift) {
    screen->keyDown(adp.KEY_CTRL, 0);
    if (shift) { screen->keyDown(adp.KEY_SHIFT, 0); }
    screen->tap(key, uni);
    if (shift) { screen->keyUp(adp.KEY_SHIFT, 0); }
    screen->keyUp(adp.KEY_CTRL, 0);
    settle();
}

int main() {
    screen = new wsrv.Headless(520, 300);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "commands");

    w = d->createWindowAt("Commands", 10, 36, 500, 250, 0);
    gcode.CodeEditor* ed = new gcode.CodeEditor();
    ed->blink = false;
    ed->setText("int main() {\n    return 0;\n}\n");
    gui.Box* col = gui.vbox(0, 0);
    col->add(ed);
    w->setRoot(col);
    w->setFocus(ed);

    // a registry: (id, title, keys, function, user data). install() offers the keys to it before the focused widget.
    cmds = new gcode.Commands();
    cmds->add("file.save", "File: Save", "ctrl+s", save, 0);
    cmds->add("view.wrap", "View: Toggle word wrap", "ctrl+alt+w", wrap, 0);
    cmds->add("build.run", "Build: Build and run", "f5", build, 0);
    cmds->add("palette.open", "Palette: Show commands", "ctrl+shift+p", openPalette, 0);
    cmds->install(w);
    palette = new gcode.Palette();
    settle();

    ctrl('s', 's', false);                              // Ctrl+S
    printf("after Ctrl+S: %s\n", &last[0]);
    printf("who owns Ctrl+S: %s\n", cmds->byKeys('s', adp.MOD_CTRL)->title);
    printf("rebinding Ctrl+S to a key that is taken: %d\n", cmds->setKeys("file.save", "f5"));   // refused: conflict

    ctrl('p', 'p', true);                               // Ctrl+Shift+P opens the palette
    screen->typeText("wra");                            // fuzzy matching narrows the list
    settle();
    printf("palette: %d of %d commands match \"wra\": %s\n", palette->shownCount(), palette->itemCount(), palette->shownLabel(0));
    screen->moveTo(515, 295);
    settle();
    gimg.savePng(srv->screen, "out.png");
    screen->tap(adp.KEY_ENTER, 13);                     // Enter runs the chosen command
    settle();
    printf("after Enter: %s\n", &last[0]);
    return 0;
}
