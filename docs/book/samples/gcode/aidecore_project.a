// A new project, its .aide file and the compiler command line
import aidecore;
import asys;

int main() {
    // a project from a template: a folder with main.a, README.md and the project file .aide
    char* mainPath = null;
    int rc = aidecore.newProject(aidecore.TPL_CONSOLE, "demo", "demo", &mainPath);
    printf("newProject: %d, templates: %s, %s, %s, %s\n", rc, aidecore.templateName(0), aidecore.templateName(1), aidecore.templateName(2), aidecore.templateName(3));

    aidecore.Project p();
    p.load("demo");                                   // reads demo/.aide (a missing file gives the defaults)
    printf("project %s, main file %s, loaded %d\n", p.name, p.mainFile, p.loaded);

    // settings and run configurations are saved in the same file; sections this version does not know are kept
    p.flags = asys.strDup("-DTRACE");              // extra compiler flags
    p.version = 3;
    aidecore.RunConfig* rcfg = p.addRun("with arguments");
    rcfg->args = asys.strDup("--verbose 'two words'");
    p.save();

    // the build plan: the command line of the compiler and where the program goes
    aidecore.Project q();
    q.load("demo");
    char* source = q.mainPath();
    aidecore.BuildPlan* plan = aidecore.makeBuildPlan(&q, source, "/usr/bin/ac", false, null);
    printf("command: %s", plan->display);             // the line the output panel shows
    printf("program: %s\n", aidecore.baseName(plan->outPath));
    printf("run configurations: %d, the first is \"%s\"\n", q.nruns, q.runs[0]->name);

    // words: a command line split the way a shell would
    aidecore.Words w(q.runs[0]->args);
    printf("%d words:", w.count);
    for (int i = 0; i < w.count; i++) { printf(" [%s]", w.argv[i]); }
    println("");
    printf("%s\n", aidecore.shellQuote("it's a $file"));
    return 0;
}
