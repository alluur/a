// An editor on a buffer: typing, auto indent, comments, several cursors, undo
import acode;

acode.Buffer* b;
acode.Editor* e;

void show(char* what) {
    printf("-- %s\n", what);
    for (int i = 0; i < b->lineCount(); i++) {
        int len = 0;
        char* p = b->linePtr(i, &len);
        if (len > 0 || i < b->lineCount() - 1) { printf("   %.*s\n", len, p); }
    }
}

int main() {
    b = new acode.Buffer();
    e = new acode.Editor(b);                         // cursors, commands and undo over a buffer
    e->setLanguage("a");                              // comment syntax, indent rules ...
    e->typeString("int main() {");
    e->newline();                                     // auto indent: one level after '{'
    e->typeString("return 0;");
    show("typed");
    e->moveHome(false);
    e->moveHome(false);                               // smart Home: first press = first non-blank, second = column 0
    e->toggleLineComment();                           // comment the line with "//", again to take it off
    show("commented");
    e->toggleLineComment();

    // several cursors: a cursor on every line, then one edit for all of them
    b->setText("one\ntwo\nthree\n", 14);
    e->setCursor(0);
    e->addCursor(4, 4);
    e->addCursor(8, 8);
    printf("cursors: %d\n", e->cursorCount());
    e->typeString("* ");
    show("a bullet on every line");
    e->undo();                                        // one undo step for all cursors, cursors restored
    printf("after undo: %d cursors, caret line %d\n", e->cursorCount(), e->caretLine());

    e->clearExtraCursors();
    e->selectAll();
    e->changeCase(true);
    show("upper case");
    e->gotoLine(1, 0);
    e->duplicateLines();
    show("line 2 duplicated");
    return 0;
}
