// A build that never blocks, and the problems it reports
// book: linux-only
import aproject;
import asys;

int main() {
    // BuildJob runs any command; a real project uses startCompiler("main.a", "main", null)
    // to run the A compiler `ac`. Here a shell script plays a compiler that complains with
    // an error, a warning and a note.
    char* script = "echo 'compiling main.a'; "
                   "echo 'main.a:3:5: error: expected ; after the statement'; "
                   "echo 'util.c:10:1: warning: unused variable x'; "
                   "echo 'Makefile:2: note: see the manual'; "
                   "exit 1";
    char* argv[4];
    argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = script; argv[3] = null;

    aproject.BuildJob* job = new aproject.BuildJob();
    job->startCommand(&argv[0], null);
    while (job->poll()) { asys.sleepMs(5); }       // poll() reads what arrived and never waits; true while it runs

    printf("exit code %d, %d problems (%d errors, %d warnings)\n", job->exitCode, job->problemCount,
           job->countOf(aproject.SEV_ERROR), job->countOf(aproject.SEV_WARNING));
    for (int i = 0; i < job->problemCount; i++) {
        aproject.Problem* p = &job->problems[i];
        printf("  %s:%d:%d %s: %s\n", p->path, p->line, p->col, aproject.severityName(p->severity), p->message);
    }
    // the output as it came, for the output panel
    char* text = job->readAll();
    printf("the output has %d bytes; the first line is: ", strlen(text));
    for (int i = 0; text[i] != 0 && text[i] != '\n'; i++) { printChar(text[i]); }
    println("");
    return 0;
}
