// The user's settings: a file that survives bad input
import atheme;

int main() {
    atheme.Settings s();
    printf("defaults: tab width %d, spaces %d, theme %s\n", s.tabWidth, s.insertSpaces, s.theme);

    s.tabWidth = 2;
    s.theme = "nord";
    s.addRecentFile("/home/ada/main.a");
    s.addRecentFile("/home/ada/util.a");
    s.addRecentFile("/home/ada/main.a");               // an old entry moves to the front, no duplicates
    s.setBinding("file.save", "ctrl+s");               // keys the user rebinds: action = keys
    printf("saved: %d\n", s.save("config/settings.ini"));     // atomic; the folder is made when needed
    printf("%s", s.toIni());

    atheme.Settings t();
    printf("loaded: %d, tab width %d, theme %s, recent: %s then %s\n", t.load("config/settings.ini"), t.tabWidth, t.theme, t.recentFiles[0], t.recentFiles[1]);

    // values are checked and clamped; lines that mean nothing are counted, not fatal
    atheme.Settings u();
    char* bad = "[editor]\ntabWidth = 5000\nwordWrap = maybe\nnonsense = 1\nnot an entry\n";
    int unknown = u.parse(bad, strlen(bad));
    printf("a damaged file: tab width clamped to %d, %d line(s) not understood\n", u.tabWidth, unknown);
    printf("a missing file: %d (no such file), the settings keep their values: %d\n", u.load("config/missing.ini"), u.tabWidth);
    return 0;
}
