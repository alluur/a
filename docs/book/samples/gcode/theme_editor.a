// The theme editor changes the colours of every open editor while you work
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import atheme;
import asyntax;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 60; i++) { srv->step(0); d->pump(0); } }

int main() {
    wsrv.Headless* screen = new wsrv.Headless(900, 880);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "themes");

    gcode.ThemeEditor* te = new gcode.ThemeEditor();         // edits the shared Look: gcode.theLook()
    gui.Window* tw = te->show(d);                            // its own window, with a live preview editor
    tw->move(10, 36);
    settle();
    printf("editing the theme \"%s\", %d warnings\n", te->currentName, te->warningCount);

    // entries 0..23 are the colours (atheme.Col), 24..47 the syntax styles (24 + asyntax.Tok)
    int keyword = 24 + asyntax.Tok.Keyword;
    te->selectEntry(keyword);
    te->setEntry(keyword, 0xFF8800, atheme.STYLE_BOLD);     // orange and bold; live: the editor changes at once
    te->setEntry(24 + asyntax.Tok.Comment, 0x303030, 0);    // a comment colour that nobody can read
    settle();
    printf("every editor now uses keyword colour %06X, dirty: %d\n", gcode.theLook()->tokColor(asyntax.Tok.Keyword) & 0xFFFFFF, te->dirty);
    printf("the contrast check found %d warning(s)\n", te->warningCount);
    screen->moveTo(895, 875);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
