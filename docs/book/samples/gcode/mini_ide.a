// A small IDE: explorer, outline, tabs, editor, find bar, build output and status bar
// book: gui
// book: window=1100x700
// book: wait=2500
// book: key=ctrl+f
// book: type=total
import gui;
import guix;
import asys;
import aproject;
import gcode;

gui.Display* display;
gcode.CodeEditor* editor;
gcode.TabBar* tabs;
gcode.OutputPane* output;
gcode.FindBar* findBar;
aproject.BuildJob* job;

// open a file in a tab: an existing tab if there is one, else a new document
void openFile(char* path) {
    for (int i = 0; i < tabs->tabCount(); i++) {
        gcode.Doc* known = (gcode.Doc*) tabs->dataOf(i);
        if (known->buf->path != null && streq(known->buf->path, path)) { tabs->select(i); return; }
    }
    gcode.Doc* doc = new gcode.Doc();
    if (doc->open(path) < 0) { return; }                       // reads the file, finds the language and the indentation
    tabs->addTab(doc->title, (int) doc);                       // the tab keeps the Doc
    tabs->select(tabs->tabCount() - 1);
}

int treeOpened(int tree) { openFile(((gcode.FileTree*) tree)->openedPath); return 0; }
int tabSelected(int bar) { editor->setDoc((gcode.Doc*) tabs->dataOf(tabs->selected)); return 0; }
int tabClosed(int bar) { return 0; }
int jump(int pane) {                                            // a click on a problem opens the file at that line
    openFile(output->jumpPath);
    editor->gotoLine(output->jumpLine - 1, output->jumpCol - 1);
    return 0;
}

int cmdSave(int item) { editor->doc->save(null); tabs->setModified(tabs->selected, false); return 0; }
int cmdFind(int item) { findBar->open(false); return 0; }
int cmdBuild(int item) {
    job = new aproject.BuildJob();
    if (job->startCompiler(editor->doc->buf->path, "program", null) < 0) { output->appendLine("the A compiler ac was not found (set AC)"); }
    else { output->attachBuild(job); }                          // follows the job from a timer; problems fill the list
    return 0;
}
int edited(int editorWidget) { tabs->setModified(tabs->selected, editor->doc->isModified()); return 0; }

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int main() {
    asys.mkdirs("mini/src");                                    // a project to look at (the sample runs in a scratch directory)
    put("mini/main.a", "import sum;\n\nint main() {\n    int total = sum(10);\n    printf(\"%d\\n\", total);\n    return 0;\n}\n");
    put("mini/src/sum.a", "int sum(int n) {\n    int total = 0;\n    for (int i = 1; i <= n; i++) { total += i; }\n    return total;\n}\n");

    gui.caretBlinks = false;
    display = gui.connect(null);
    gui.Window* win = display->createWindow("mini IDE", 980, 620, 0);

    editor = new gcode.CodeEditor();
    editor->blink = false;
    editor->onChange = edited;
    tabs = new gcode.TabBar();
    tabs->onSelect = tabSelected;
    tabs->onClose = tabClosed;
    findBar = new gcode.FindBar(editor);
    gcode.EditorStatus* status = new gcode.EditorStatus(editor);
    gcode.FileTree* files = new gcode.FileTree();
    files->setRoot("mini");
    files->onOpen = treeOpened;
    gcode.Outline* outline = new gcode.Outline(editor);
    output = new gcode.OutputPane();
    output->onJump = jump;

    gcode.PanelTabs* side = new gcode.PanelTabs();             // the sidebar has two pages
    side->addPage("Files", files);
    side->addPage("Outline", outline);
    gui.Box* centre = gui.vbox(0, 0);
    editor->flex = 1;
    centre->add(tabs);
    centre->add(editor);
    centre->add(findBar);
    gcode.Dock* dock = new gcode.Dock();                        // sidebar | centre over the bottom panel, with draggable dividers
    dock->setSidebar(side);
    dock->setCenter(centre);
    dock->setBottom(output);

    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Save", cmdSave)->accel("Ctrl+S");
    guix.Menu* edit = bar->addMenu("&Edit");
    edit->add("Find...", cmdFind)->accel("Ctrl+F");
    guix.Menu* run = bar->addMenu("&Build");
    run->add("Build this file", cmdBuild)->accel("F7");

    gui.Box* col = gui.vbox(0, 0);
    col->add(bar);
    col->add(dock);
    col->add(status->bar);
    win->setRoot(col);
    openFile("mini/main.a");
    openFile("mini/src/sum.a");
    files->revealRel("src/sum.a");
    win->setFocus(editor);
    display->run();
    return 0;
}
