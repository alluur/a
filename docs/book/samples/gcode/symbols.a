// Symbols of a source file and completion
import asyntax;
import acode;

int main() {
    char* src = "module shapes;\n"
                "const SIDES = 4;\n"
                "class Circle {\n"
                "    int radius;\n"
                "    int area() { return 3 * radius * radius; }\n"
                "    void grow(int by) { radius += by; }\n"
                "}\n"
                "int main() { Circle c; return c.area(); }\n"
                "// int hidden() is in a comment\n";
    acode.Buffer b();
    b.setText(src, strlen(src));

    // found from the token stream, so strings and comments never produce symbols
    asyntax.SymbolList syms();
    asyntax.symbols(&b, asyntax.Lang.A, &syms);
    for (int i = 0; i < syms.count; i++) {
        asyntax.Symbol* s = &syms.items[i];
        printf("line %d: %-8s %s%s%s\n", s->line + 1, asyntax.symKindName(s->kind), s->parent != null ? s->parent : "", s->parent != null ? "." : "", s->name);
    }
    syms.dispose();

    // completion: the keywords of the language, the symbols and the words of the open buffers
    asyntax.Completer comp();
    comp.addBuffer(&b, asyntax.Lang.A);
    asyntax.Candidate cands[10];
    int n = comp.complete("re", asyntax.Lang.A, &cands[0], 10);
    printf("completing \"re\":");
    for (int i = 0; i < n; i++) { printf(" %s", cands[i].text); }
    println("");
    n = comp.complete("ci", asyntax.Lang.A, &cands[0], 10);
    printf("completing \"ci\": %s (kind %d: 0 symbol, 1 keyword, 2 word)\n", cands[0].text, cands[0].kind);
    return 0;
}
