// The project explorer and the build output
// book: shot=out.png
// book: linux-only
import wsrv;
import gui;
import gcode;
import aproject;
import asys;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }
void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int opened(int tree) {
    gcode.FileTree* t = (gcode.FileTree*) tree;
    printf("file opened: %s\n", t->selectedRel());
    return 0;
}

int jump(int pane) {                                    // a click on a problem
    gcode.OutputPane* p = (gcode.OutputPane*) pane;
    printf("jump to %s line %d, column %d\n", p->jumpPath, p->jumpLine, p->jumpCol);
    return 0;
}

int main() {
    asys.mkdirs("shop/src/lib");
    asys.mkdirs("shop/docs");
    put("shop/main.a", "int main() { return 0; }\n");
    put("shop/src/cart.a", "int total() { return 0; }\n");
    put("shop/src/lib/money.a", "int cents() { return 0; }\n");
    put("shop/README.md", "# shop\n");
    put("shop/.gitignore", "docs/\n");

    screen = new wsrv.Headless(680, 360);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "panes");

    gcode.FileTree* files = new gcode.FileTree();
    files->setRoot("shop");                               // lazy: folders are read when they open; .gitignore is applied
    files->onOpen = opened;
    files->w = 200;
    files->flex = 0;
    gcode.OutputPane* out = new gcode.OutputPane();
    out->onJump = jump;

    gui.Window* w = d->createWindowAt("Panes", 10, 36, 660, 300, 0);
    gui.Box* row = gui.hbox(0, 0);
    row->add(files);
    row->add(out);
    w->setRoot(row);
    settle();
    files->revealRel("src/lib/money.a");                  // open the folders above it and select it
    settle();

    // a build: the job's output is followed from a timer, problems are collected from the lines
    char* script = "echo '\\033[1mcompiling\\033[0m src/cart.a'; echo 'src/cart.a:1:5: error: undeclared identifier total2'; "
                   "echo 'src/lib/money.a:1:1: warning: unused function cents'; exit 1";
    char* argv[4];
    argv[0] = "/bin/sh"; argv[1] = "-c"; argv[2] = script; argv[3] = null;
    aproject.BuildJob* job = new aproject.BuildJob();
    job->startCommand(&argv[0], null);
    out->attachBuild(job);
    for (int i = 0; i < 100 && out->jobRunning; i++) { srv->step(0); d->pump(10); }
    settle();
    printf("errors %d, warnings %d, exit code %d\n", out->errorCount(), out->warningCount(), out->exitCode);

    out->showProblems();                                  // the Problems tab
    settle();
    screen->click(380, 76);                               // a click on the first problem calls onJump
    settle();
    screen->moveTo(676, 356);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
