// The code editor widget: highlighting, gutter markers and a selection
// book: shot=out.png
import wsrv;
import gui;
import gcode;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 40; i++) { srv->step(0); d->pump(0); } }

int main() {
    wsrv.Headless* screen = new wsrv.Headless(560, 330);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "editor");

    gui.Window* w = d->createWindowAt("main.a", 20, 40, 520, 260, 0);
    gcode.theLook()->setThemeName("dark");              // one Look is shared by all gcode widgets
    gcode.CodeEditor* ed = new gcode.CodeEditor();      // has a document of its own
    ed->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(ed);
    w->setRoot(col);
    w->setFocus(ed);

    ed->setText("// Sum of the first n numbers\n"
                "int sum(int n) {\n"
                "    int total = 0;\n"
                "    for (int i = 1; i <= n; i++) {\n"
                "        total += i;\n"
                "    }\n"
                "    return totl;\n"
                "}\n"
                "\n"
                "int main() {\n"
                "    printf(\"%d\\n\", sum(10));\n"
                "    return 0;\n"
                "}\n");
    ed->doc->setLanguage(asyntax.Lang.A);                // colours by language
    ed->doc->addMark(6, 11, 4, gcode.SEV_ERROR, "undeclared identifier 'totl'");   // (line, column, length, severity, text)
    ed->doc->addMark(2, 8, 5, gcode.SEV_WARNING, "total is set but not used");
    ed->doc->toggleBookmark(9);                          // a bookmark on line 10 (lines count from 0)
    ed->gotoLine(4, 8);
    ed->select(ed->buf->lineStart(3) + 4, ed->buf->lineStart(5) + 5);      // a selection over the loop
    settle();

    printf("%d lines, caret on line %d, %d visible rows, language %s\n", ed->buf->lineCount(), ed->ed->caretLine() + 1, ed->visibleRows(),
           asyntax.languageName(ed->doc->lang));
    printf("marker message at line 7: %s\n", ed->doc->markMessage(6, 12));
    screen->moveTo(550, 320);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
