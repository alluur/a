// Find in files and quick open
import aproject;
import asys;

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int main() {
    asys.mkdirs("proj/src");
    put("proj/main.a", "// TODO: parse options\nint main() { return run(); }\n");
    put("proj/src/run.a", "int run() {\n    // TODO: do the work\n    return 0;\n}\n");
    put("proj/src/util.a", "int helper() { return 1; }\n");
    put("proj/README.md", "Todo list lives in the source.\n");

    aproject.Ignore ign();
    ign.addBuiltin();

    // find in files: start(folder, text, flags, ignore rules, lines of context). It works in steps,
    // so a front end keeps drawing while it runs; step(ms) does at most that many milliseconds of work.
    aproject.FindJob* job = new aproject.FindJob();
    job->start("proj", "TODO", aproject.FIND_ICASE, &ign, 1);
    while (job->step(20) == aproject.FIND_RUNNING) { }
    printf("%d matches in %d files\n", job->count, job->filesSearched);
    for (int i = 0; i < job->count; i++) {
        aproject.FindResult* r = &job->results[i];
        printf("  %s:%d:%d: %s\n", r->path, r->line + 1, r->col + 1, r->text);
    }

    // the same as a regular expression, only in A files
    job->fileFilter = "*.a";
    job->start("proj", "return \\w+\\(\\)", aproject.FIND_REGEX, &ign, 0);
    while (job->step(20) == aproject.FIND_RUNNING) { }
    printf("regular expression: %d match(es), the first is \"%.*s\"\n", job->count, job->results[0].len, &job->results[0].text[job->results[0].col]);

    // quick open: a fuzzy search over the file names of the project
    aproject.QuickOpen quick();
    quick.index("proj", &ign);
    aproject.QuickMatch hits[5];
    int n = quick.query("sru", &hits[0], 5);
    printf("\"sru\" finds:");
    for (int i = 0; i < n; i++) { printf(" %s", hits[i].path); }
    println("");
    n = quick.query("a", &hits[0], 5);
    printf("\"a\" finds %d files, best first:", n);
    for (int i = 0; i < n; i++) { printf(" %s", hits[i].path); }
    println("");
    return 0;
}
