// Snippets: templates that fit the indentation of the line
import aidecore;
import acode;

int main() {
    acode.Buffer b();
    acode.Editor e(&b);
    e.setLanguage("a");
    aidecore.SnippetSet snips();                       // the built-in snippets (and snippets.ini of the user: snips.load(dir))
    printf("%d snippets, for example %s (%s) and %s (%s)\n", snips.count, snips.names[0], snips.infos[0], snips.names[5], snips.infos[5]);

    e.typeString("int main() {");
    e.newline();                                       // the caret is now one level in
    e.typeString("for");                               // type the name of a snippet ...
    snips.expandWord(&b, &e);                          // ... Tab does this in an editor: the word is replaced by the snippet
    e.typeString("n");                                 // the caret is where $0 was
    println(b.flatten());

    // your own snippet
    snips.addEscaped("todo", "// TODO($0): \\n");
    e.moveDocEnd(false);
    e.newline();
    e.typeString("todo");
    snips.expandWord(&b, &e);
    e.typeString("ada");
    println("--");
    println(b.flatten());
    return 0;
}
