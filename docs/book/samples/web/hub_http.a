// The HTTP side of a hub: health check, routes, static files, one port for both protocols
import wshub;
import httpx;
import http;
import websocket;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }                  // the hub serves while the client waits (see ws_echo)

int showUser(httpx.Context* x) {
    char* id = x->req->param("id");                      // from the pattern /users/:id
    char shout[10];
    shout[0] = 0;
    x->req->queryValue("shout", &shout[0], 10);          // from ?shout=yes
    char text[100];
    format(&text[0], 100, "user %s%s", id, shout[0] != 0 ? "!" : "");
    x->res->text(200, &text[0]);
    return 0;
}

int stamp(httpx.Context* x) {                            // middleware: runs around every route
    x->next();
    x->res->setHeader("X-Served-By", "hub");
    return 0;
}

int onHttp(wshub.Hub* h, wshub.Client* c, httpx.Request* req, httpx.Response* res) {
    if (!streq(&req->path[0], "/hello")) return 0;       // 0: not ours, the hub goes on with the router, the files, 404
    res->html(200, "<h1>hello</h1>");
    return 1;                                            // 1: we answered
}

void get(char* path) {
    char url[100];
    format(&url[0], 100, "http://127.0.0.1:%d%s", hub->port, path);
    http.Response* r = http.get(&url[0]);
    char* by = r->header("X-Served-By");
    printf("GET %s -> %d %s\n", path, r->status, r->body);
    if (by != null) printf("    header X-Served-By: %s\n", by);
}

int echo(wshub.Hub* h, wshub.Client* c, char* data, int n, int isText) {
    h->sendData(c, data, n, isText == 1);
    return 0;
}

int main() {
    makeDir("www");
    writeFile("www/index.html", "<p>static page</p>");   // the hub serves the files of a directory
    hub = new wshub.Hub();
    hub->onMessage = echo;
    hub->onHttp = onHttp;
    hub->staticDir = "www";
    hub->router = new httpx.Router();
    hub->router->get("/users/:id", showUser);
    hub->router->use(stamp, null);
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    get("/healthz");
    get("/hello");
    get("/users/42");
    get("/users/7?shout=yes");
    get("/");
    get("/nothing");

    char url[100];                                       // the same port speaks WebSocket
    format(&url[0], 100, "ws://127.0.0.1:%d/", hub->port);
    websocket.WebSocket* ws = websocket.connect(&url[0]);
    ws->sendText("and a WebSocket");
    websocket.Message* m = ws->receiveMessage();
    printf("WebSocket on the same port: %s\n", m->data);
    printf("HTTP requests counted: %d\n", hub->stats->httpRequests);
    return 0;
}
