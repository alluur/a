// Who may connect: onUpgrade, an Origin list and subprotocols
import wshub;
import websocket;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }                  // the hub serves while the client waits (see ws_echo)

// Called for every upgrade request that passed the Origin check. 0: accept, or the HTTP status to answer with.
int onUpgrade(wshub.Hub* h, wshub.Client* c, websocket.HandshakeInfo* info) {
    char cookie[100];
    if (startsWith(&info->path[0], "/admin")) return 404;                 // no such endpoint
    if (!info->headerInto("Cookie", &cookie[0], 100)) return 401;          // not logged in
    if (!contains(&cookie[0], "session=letmein")) return 403;              // logged in, but not as somebody we know
    return 0;
}

void tryConnect(char* label, char* path, websocket.Options* o) {
    char url[100];
    format(&url[0], 100, "ws://127.0.0.1:%d%s", hub->port, path);
    websocket.WebSocket* ws = websocket.connectWith(&url[0], o);
    if (ws == null) {
        printf("%-26s refused, HTTP status %d\n", label, websocket.status());
        return;
    }
    printf("%-26s connected, subprotocol \"%s\"\n", label, ws->protocol);
    ws->dispose();
}

int main() {
    hub = new wshub.Hub();
    hub->onUpgrade = onUpgrade;
    hub->wsOptions = new websocket.ServerOptions();
    hub->wsOptions->origins = "https://app.example.org";       // a comma separated allow-list ("*": any Origin)
    hub->wsOptions->protocols = "chat, superchat";             // what the server speaks, best first
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    websocket.Options* o = new websocket.Options();
    o->origin = "https://app.example.org";
    tryConnect("no cookie:", "/", o);

    o->cookie = "session=guest";
    tryConnect("cookie of a stranger:", "/", o);

    o->cookie = "session=letmein";
    tryConnect("good cookie:", "/", o);
    tryConnect("good cookie, /admin:", "/admin", o);

    o->protocols = "v2.chat, superchat, chat";                 // the client's wish list; the server picks one it knows
    tryConnect("with subprotocols:", "/", o);

    o->origin = "https://evil.example.com";
    tryConnect("another Origin:", "/", o);
    o->origin = null;
    tryConnect("no Origin at all:", "/", o);                   // a policy without requireOrigin lets non-browsers in
    printf("upgrades refused: %d\n", hub->stats->rejected);
    return 0;
}
