// The httpx client: requests, replies, JSON, and the difference between an error reply and no reply
import httpx;
import wshub;
import json;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }                  // the hub is our test server; it runs while the client waits

// ---- the server side: three routes ---------------------------------------------------------------------------------------
int user(httpx.Context* x) {
    char text[100];
    format(&text[0], 100, "{\"id\":%s,\"name\":\"Ada\",\"tags\":[\"a\",\"b\"]}", x->req->param("id"));
    x->res->json(200, &text[0]);
    return 0;
}

// answers with what it received
int echo(httpx.Context* x) {
    char* type = x->req->header("Content-Type");
    char* who = x->req->header("X-Client");
    char text[200];
    format(&text[0], 200, "%s, type %s, body %d bytes \"%s\", X-Client %s", &x->req->method[0], type == null ? "-" : type, x->req->bodyLen,
           x->req->bodyLen > 0 ? x->req->body : "", who == null ? "-" : who);
    x->res->text(200, &text[0]);
    return 0;
}

int secret(httpx.Context* x) { x->res->error(403); return 0; }

// ---- the client side ----------------------------------------------------------------------------------------------------
char base[40];

void show(char* what, httpx.Reply* r) {
    if (r == null) { printf("%-9s no reply: %s\n", what, httpx.error()); return; }
    printf("%-9s %d  %s\n", what, r->status, r->body);
    r->dispose();
}

int main() {
    hub = new wshub.Hub();
    hub->router = new httpx.Router();
    hub->router->get("/users/:id", user);
    hub->router->any("/echo", echo);
    hub->router->get("/secret", secret);
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    format(&base[0], 40, "http://127.0.0.1:%d", hub->port);

    httpx.Client* c = httpx.newClient();
    c->keepAlive = true;                                  // keep the connection for the next request to the same server
    c->headers->set("X-Client", "book");                  // sent with every request
    char url[80];

    format(&url[0], 80, "%s/users/7", &base[0]);
    httpx.Reply* r = c->get(&url[0]);
    json.Json* j = json.parse(r->body);                   // the body is always followed by a 0 byte: it is a string
    printf("user: id %d, name %s, %d tags\n", j->get("id")->asInt(), j->get("name")->asString(), j->get("tags")->size());
    printf("Content-Type of the answer: %s\n", r->header("Content-Type"));
    r->dispose();
    r = c->get(&url[0]);
    printf("second request on the same connection: reused=%d\n", r->reused);
    r->dispose();

    format(&url[0], 80, "%s/echo", &base[0]);
    show("POST json", c->postJson(&url[0], "{\"x\":1}"));
    show("POST form", c->postForm(&url[0], "a=1&b=two"));
    show("PUT text", c->put(&url[0], "hello", 5, "text/plain"));
    show("DELETE", c->del(&url[0]));

    println("answers that are errors are still answers:");
    format(&url[0], 80, "%s/secret", &base[0]);
    show("forbidden", c->get(&url[0]));
    format(&url[0], 80, "%s/nothing", &base[0]);
    show("missing", c->get(&url[0]));

    println("no answer at all:");
    show("refused", c->get("http://127.0.0.1:1/"));       // nothing listens on port 1
    show("ftp", c->get("ftp://example.org/"));
    return 0;
}
