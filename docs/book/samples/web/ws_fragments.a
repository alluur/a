// A message in pieces: sending fragments, and receiving them as they arrive
import websocket;

// Prints the frames that a (server side, so unmasked) object has queued, then hands them to the other side.
void carry(websocket.WebSocket* from, websocket.WebSocket* to) {
    char* p = from->outData();
    int left = from->outPending();
    websocket.Frame f;
    while (left > 0) {
        int h = websocket.parseHeader(p, left, &f);
        printf("  frame: opcode %2d  fin=%d  payload %d\n", f.opcode, f.fin, f.length);
        p = &p[h + f.length];
        left = left - h - f.length;
    }
    to->feed(from->outData(), from->outPending());
    from->outConsumed(from->outPending());
}

// Called for every piece of a message as it arrives; flags: 1 = first piece, 2 = last piece.
int onPiece(websocket.WebSocket* ws, int opcode, char* data, int n, int flags) {
    printf("  piece of %d bytes, flags %d: \"%.*s\"\n", n, flags, n, data);
    return 0;
}

int main() {
    websocket.WebSocket* server = websocket.create(null, false);
    websocket.WebSocket* client = websocket.create(null, true);

    println("beginMessage / sendFragment / endMessage, with a ping in between:");
    server->beginMessage(websocket.OP_TEXT);
    server->sendFragment("Hello", 5);
    server->ping();                          // control frames may be sent between the fragments of a message
    server->sendFragment(", ", 2);
    server->sendFragment("world", 5);
    server->endMessage();                    // the last frame has FIN set
    carry(server, client);
    websocket.Message* m = client->takeMessage();
    printf("the client's takeMessage: \"%s\" (one message, %d bytes)\n", m->data, m->length);
    m->dispose();
    client->outConsumed(client->outPending());   // the pong the client queued for the ping

    println("setFragmentSize(4) cuts every message into frames of at most 4 bytes:");
    server->setFragmentSize(4);
    server->sendText("0123456789");
    carry(server, client);
    client->takeMessage()->dispose();
    server->setFragmentSize(0);

    println("a stream handler gets the pieces and keeps nothing:");
    client->setStreamHandler(onPiece);
    server->beginMessage(websocket.OP_BINARY);
    server->sendFragment("abc", 3);
    server->sendFragment("defgh", 5);
    server->endMessage();
    carry(server, client);
    printf("takeMessage afterwards: %s\n", client->takeMessage() == null ? "null" : "a message");
    return 0;
}
