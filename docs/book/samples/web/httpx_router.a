// A router, middleware and Basic authentication, tested without a network
import httpx;

// ---- handlers: int handler(httpx.Context* x); the answer goes into x->res ------------------------------------------------
int showUser(httpx.Context* x) {
    char text[100];
    format(&text[0], 100, "user %s", x->req->param("id"));            // :id of the pattern, percent-decoded
    x->res->text(200, &text[0]);
    return 0;
}

int showPost(httpx.Context* x) {
    char text[100];
    format(&text[0], 100, "post %s of user %s", x->req->param("post"), x->req->param("id"));
    x->res->text(200, &text[0]);
    return 0;
}

int showFile(httpx.Context* x) {
    char text[100];
    format(&text[0], 100, "file %s", x->req->param("*"));            // * takes the rest of the path
    x->res->text(200, &text[0]);
    return 0;
}

int showStats(httpx.Context* x) {
    x->res->text(200, "3 users online");
    return 0;
}

int createItem(httpx.Context* x) {
    x->res->text(201, x->req->body);
    x->res->setHeader("Location", "/items/1");
    return 0;
}

// Middleware: runs before the route. Calling x->next() goes on; not calling it ends the request here.
int guard(httpx.Context* x) {
    if (startsWith(&x->req->path[0], "/admin")) {
        char user[40];
        char pass[40];
        if (!httpx.checkBasic(x->req, &user[0], 40, &pass[0], 40) || !httpx.constantTimeEquals(&pass[0], "secret")) {
            httpx.unauthorized(x->res, "Basic", "admin area");        // 401 and WWW-Authenticate
            return 0;
        }
    }
    x->next();
    x->res->setHeader("X-Checked", "yes");                            // after the route: the answer exists now
    return 0;
}

// Feeds one request, as bytes, to the parser, then to the router: what a server does with a socket.
void run(httpx.Router* router, char* method, char* target, char* headers, char* body) {
    char raw[400];
    format(&raw[0], 400, "%s %s HTTP/1.1\r\nHost: x\r\n%s\r\n%s", method, target, headers, body);
    httpx.RequestParser* parser = httpx.newParser();
    httpx.Request* req = httpx.newRequest();
    httpx.Response* res = httpx.newResponse();
    parser->reset(req);
    parser->feed(&raw[0], strlen(&raw[0]));
    printf("%-7s %-26s ", method, target);
    if (parser->failed()) {
        printf("-> the parser refuses it: %d %s\n", parser->errorStatus, httpx.statusText(parser->errorStatus));
    } else {
        router->handle(req, res);
        printf("-> %d ", res->status);
        if (res->head) printf("(HEAD: the head says Content-Length %d, no body follows)", res->contentLength());
        else printf("%s", res->body == null ? "" : res->body);
        char* extra = res->headers->get("Allow");
        if (extra == null) extra = res->headers->get("WWW-Authenticate");
        if (extra != null) printf("  [%s]", extra);
        if (res->headers->has("X-Checked")) printf("  (X-Checked)");
        printf("\n");
    }
    parser->dispose(); req->dispose(); res->dispose();
}

int main() {
    httpx.Router* router = new httpx.Router();
    router->use(guard, null);
    router->get("/users/:id", showUser);
    router->get("/users/:id/posts/:post", showPost);
    router->get("/files/*", showFile);
    router->post("/items", createItem);
    router->get("/admin/stats", showStats);

    run(router, "GET", "/users/42?verbose=1", "", "");
    run(router, "GET", "/users/a%20b", "", "");
    run(router, "GET", "/users/42/posts/7", "", "");
    run(router, "GET", "/files/docs/a/b.txt", "", "");
    run(router, "POST", "/items", "Content-Length: 5\r\n", "apple");
    run(router, "GET", "/nothing", "", "");
    run(router, "DELETE", "/users/42", "", "");
    run(router, "OPTIONS", "/items", "", "");
    run(router, "HEAD", "/users/42", "", "");
    run(router, "GET", "/admin/stats", "", "");
    run(router, "GET", "/admin/stats", "Authorization: Basic YWRtaW46c2VjcmV0\r\n", "");     // admin:secret
    run(router, "GET", "/admin/stats", "Authorization: Basic YWRtaW46d3Jvbmc=\r\n", "");     // admin:wrong
    run(router, "POST", "/items", "Content-Length: 3\r\nTransfer-Encoding: chunked\r\n", "abc");
    return 0;
}
