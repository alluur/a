// Limits of a hub: too many clients, too big a message, a silent client
import wshub;
import websocket;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }                  // the hub serves while the client waits (see ws_echo)

int echo(wshub.Hub* h, wshub.Client* c, char* data, int n, int isText) {
    h->sendData(c, data, n, isText == 1);
    return 0;
}

websocket.WebSocket* open() {
    char url[80];
    format(&url[0], 80, "ws://127.0.0.1:%d/", hub->port);
    return websocket.connect(&url[0]);
}

// Sends a text of n bytes and says what came back.
void sendSize(websocket.WebSocket* ws, int n) {
    char* text = alloc(n + 1);
    memset(text, 'x', n);
    ws->sendText(text);
    websocket.Message* m = ws->receiveMessage();         // null when the hub closed the connection instead
    if (m != null) { printf("%3d bytes: echoed back\n", n); m->dispose(); }
    else printf("%3d bytes: the hub closed the connection, code %d\n", n, ws->closeCode);
}

int main() {
    hub = new wshub.Hub();
    hub->onMessage = echo;
    hub->maxClients = 2;                                 // default 1000: the third connection is turned away
    hub->maxMessage = 100;                               // default 1 MiB: a bigger message ends the connection
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    websocket.WebSocket* a = open();
    websocket.WebSocket* b = open();
    websocket.WebSocket* c = open();
    if (c == null) printf("third client: refused with HTTP status %d\n", websocket.status());
    printf("clients on the hub: %d, turned away so far: %d\n", hub->count(), hub->stats->rejected);

    sendSize(a, 80);
    sendSize(a, 200);

    hub->idleTimeoutMs = 150;                            // default 0 = never: now a client that sends nothing for 150 ms is closed
    websocket.Message* m = b->waitMessage(5000);         // b has been silent all along; null when the hub closes the connection
    printf("silent client: %s, close code %d, idle closes counted: %d\n", m == null ? "closed by the hub" : "a message", b->closeCode, hub->stats->idleClosed);
    return 0;
}
