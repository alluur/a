// Text and binary messages, and what they cost on the wire
import websocket;

// A "network" for two WebSocket objects that have no socket: hand the queued bytes over.
void carry(websocket.WebSocket* from, websocket.WebSocket* to) {
    to->feed(from->outData(), from->outPending());
    from->outConsumed(from->outPending());
}

int main() {
    websocket.WebSocket* client = websocket.create(null, true);     // null: no socket, the object only does the protocol
    websocket.WebSocket* server = websocket.create(null, false);

    client->sendText("h\xc3\xa9llo");                  // UTF-8: 5 characters, 6 bytes
    client->sendBinary("\xff\xfe\x00\x01", 4);         // binary may hold anything, zero bytes included
    client->sendText("");                              // an empty message is a message
    printf("the client queued %d bytes for 3 messages\n", client->outPending());
    carry(client, server);
    websocket.Message* m = server->takeMessage();
    while (m != null) {
        printf("  the server received a %s message of %d bytes\n", m->isText() ? "text" : "binary", m->length);
        m->dispose();
        m = server->takeMessage();
    }

    // sendText checks that the text is UTF-8; a refused message queues nothing
    bool sent = client->sendText("broken \xff byte");
    printf("sendText with an invalid byte: %s, %d bytes queued\n", sent ? "sent" : "refused", client->outPending());

    // frame overhead: a client masks (4 bytes more), the length field grows with the size
    int sizes[4] = { 5, 125, 126, 70000 };
    char* big = alloc(70000);
    for (int i = 0; i < 4; i++) {
        client->sendBinary(big, sizes[i]);
        int c = client->outPending();
        client->outConsumed(c);
        server->sendBinary(big, sizes[i]);
        int s = server->outPending();
        server->outConsumed(s);
        printf("%5d bytes of payload: client frame %5d bytes, server frame %5d bytes\n", sizes[i], c, s);
    }

    // the older receive(buf, max, &opcode): a message that fills the buffer exactly gets no terminating zero
    char buf[16];
    memset(&buf[0], '#', 16);
    int opcode;
    server->sendText("12345678");
    carry(server, client);
    int n = client->receive(&buf[0], 8, &opcode);      // the message is already here, so this does not wait
    printf("receive(buf, 8): %d bytes, the byte after them is '%c' (not 0)\n", n, buf[8]);
    return 0;
}
