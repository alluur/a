// A peer that breaks the rules: the close code the library answers with
import websocket;
import encoding;

// Feeds hand-made bytes (hex) to a fresh server-side object, as if a client had sent them.
void attack(char* what, char* hex, int maxMessage) {
    websocket.WebSocket* server = websocket.create(null, false);
    if (maxMessage > 0) server->setMaxMessage(maxMessage);
    char bytes[64];
    int n = encoding.hexDecode(hex, &bytes[0]);
    server->feed(&bytes[0], n);
    char* out = server->outData();                       // what the server queued: a close frame 88 LL CC CC ...
    int code = server->outPending() >= 4 ? ((out[2] & 255) << 8) | (out[3] & 255) : 0;
    printf("%-34s -> close %d, closed=%d  %s\n", what, code, server->closed, &server->failReason[0]);
    server->dispose();
}

int main() {
    // the mask key is 00000000 everywhere, so the payload bytes can be read as they are
    attack("an unmasked frame",               "810268" "69", 0);
    attack("text that is not UTF-8",          "8183" "00000000" "fffefd", 0);
    attack("a text with an overlong 'a'",     "8182" "00000000" "c1a1", 0);
    attack("reserved bit RSV1, no extension", "c180" "00000000", 0);
    attack("unknown opcode 3",                "8380" "00000000", 0);
    attack("a ping that is fragmented",       "0980" "00000000", 0);
    attack("a ping with 126 bytes",           "89fe007e" "00000000", 0);
    attack("a continuation with no message",  "8080" "00000000", 0);
    attack("length 126 used for 5 bytes",     "81fe0005" "00000000", 0);
    attack("close with the code 1005",        "8882" "00000000" "03ed", 0);
    attack("a close with a one byte payload", "8881" "00000000" "03", 0);
    attack("11 bytes where 10 are allowed",   "818b" "00000000" "68656c6c6f20776f726c64", 10);
    attack("a frame announcing 1 TiB",        "82ff" "0000010000000000" "00000000", 0);
    return 0;
}
