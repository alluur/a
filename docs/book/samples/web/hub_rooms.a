// A chat server with rooms: wshub
import wshub;
import websocket;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }                  // the hub serves while a client waits (see ws_echo)

// The server: three callbacks. Every argument is a number or a pointer.
int onOpen(wshub.Hub* h, wshub.Client* c) {
    char* name = alloc(40);
    strcpy(name, &c->path[1]);                           // the path of the upgrade request, "/ann" -> "ann"
    c->user = name;                                      // c->user is ours to use
    return 0;
}

// "join room", "leave room", "say room text"
int onMessage(wshub.Hub* h, wshub.Client* c, char* data, int n, int isText) {
    char* cmd = strdup(data);                            // data is only valid during this call
    char reply[100];
    if (startsWith(cmd, "join ")) {
        h->join(c, &cmd[5]);
        format(&reply[0], 100, "you are in %s (%d there)", &cmd[5], h->roomSize(&cmd[5]));
        h->sendText(c, &reply[0]);
    } else if (startsWith(cmd, "say ")) {
        int sp = indexOf(&cmd[4], ' ');
        cmd[4 + sp] = 0;                                 // cmd+4 is the room, cmd+5+sp the text
        format(&reply[0], 100, "%s: %s", c->user, &cmd[5 + sp]);
        h->publish(&cmd[4], &reply[0], strlen(&reply[0]), true, c->id);   // everybody in the room except the sender
    }
    return 0;
}

int onClose(wshub.Hub* h, wshub.Client* c, int code) {
    printf("hub: %s left with code %d\n", c->user, code);
    return 0;
}

websocket.WebSocket* join(char* name) {
    char url[80];
    format(&url[0], 80, "ws://127.0.0.1:%d/%s", hub->port, name);
    return websocket.connect(&url[0]);
}

// sends a command and waits for the answer
void ask(char* who, websocket.WebSocket* ws, char* cmd) {
    ws->sendText(cmd);
    websocket.Message* m = ws->receiveMessage();
    printf("%s <- %s\n", who, m->data);
    m->dispose();
}

// waits for a message that must come, or (expected = false) gives a message that must not come 40 ms to show up
void hear(char* who, websocket.WebSocket* ws, bool expected) {
    websocket.Message* m = expected ? ws->receiveMessage() : ws->waitMessage(40);
    printf("%s hears: %s\n", who, m == null ? "(nothing)" : m->data);
    if (m != null) m->dispose();
}

int main() {
    hub = new wshub.Hub();
    hub->onOpen = onOpen;
    hub->onMessage = onMessage;
    hub->onClose = onClose;
    hub->listenOn("127.0.0.1", 0, null);                 // this machine only (hub->listen(port) takes every interface)
    net.setIdleHook(serve);

    websocket.WebSocket* ann = join("ann");
    websocket.WebSocket* bob = join("bob");
    websocket.WebSocket* cy = join("cy");
    printf("clients: %d\n", hub->count());

    ask("ann", ann, "join red");
    ask("bob", bob, "join red");
    ask("bob", bob, "join blue");
    ask("cy", cy, "join blue");
    printf("rooms: %d, red has %d, blue has %d\n", hub->roomCount(), hub->roomSize("red"), hub->roomSize("blue"));

    ann->sendText("say red hi red");
    hear("bob", bob, true);
    hear("cy", cy, false);
    hear("ann", ann, false);

    bob->sendText("say blue hi blue");
    hear("cy", cy, true);

    hub->broadcastText("server: restart in 5 minutes");  // every client, in every room
    hear("ann", ann, true);
    hear("bob", bob, true);
    hear("cy", cy, true);

    bob->closeWith(1000, "bye");
    for (int i = 0; i < 20; i++) hub->poll(0);
    printf("clients: %d, red has %d, blue has %d\n", hub->count(), hub->roomSize("red"), hub->roomSize("blue"));
    return 0;
}
