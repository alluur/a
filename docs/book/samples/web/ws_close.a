// Closing a WebSocket: status codes, reasons and what each side sees
import websocket;
import conn;
import net;

int listener;
websocket.WebSocket* server;

// The server of ws_echo, with two commands: "kick" closes with a code of our own, "drop" cuts the connection.
int serve() {
    if (server == null) {
        int fd = net.acceptSome(listener);
        if (fd < 0) return 0;
        server = websocket.accept(conn.create(fd), null, 0);
        server->setNonBlocking(true);
        return 0;
    }
    server->pump();
    websocket.Message* m = server->takeMessage();
    while (m != null) {
        if (streq(m->data, "kick")) server->closeWith(4001, "you were kicked");
        if (streq(m->data, "drop")) server->abort();
        m->dispose();
        m = server->takeMessage();
    }
    return 0;
}

websocket.WebSocket* open() {
    char url[80];
    format(&url[0], 80, "ws://127.0.0.1:%d/", net.localPort(listener));
    return websocket.connect(&url[0]);
}

void report(char* who, websocket.WebSocket* ws) {
    printf("  %s: closed=%d, peer's code %d, reason \"%s\"\n", who, ws->closed, ws->closeCode, ws->closeReason);
}

int main() {
    listener = net.listenOn("127.0.0.1", 0, 4);
    net.setNonBlocking(listener, true);
    net.setIdleHook(serve);

    println("the client closes with 1000 and a reason:");
    websocket.WebSocket* ws = open();
    ws->closeWith(1000, "all done");
    report("client", ws);
    report("server", server);
    ws->dispose(); server->dispose(); server = null;

    println("the server closes with 4001 (our own code):");
    ws = open();
    ws->sendText("kick");
    websocket.Message* m = ws->receiveMessage();      // null: the close frame ended the conversation
    printf("  receiveMessage returned %s\n", m == null ? "null" : "a message");
    report("client", ws);
    ws->dispose(); server->dispose(); server = null;

    println("the server cuts the connection without a close frame:");
    ws = open();
    ws->sendText("drop");
    m = ws->receiveMessage();
    report("client", ws);
    ws->dispose(); server->dispose(); server = null;

    println("codes and reasons that closeWith refuses (nothing is sent):");
    ws = open();
    printf("  1006: %d, 999: %d, 5000: %d\n", ws->closeWith(1006, null), ws->closeWith(999, null), ws->closeWith(5000, null));
    char* text = alloc(200);
    for (int i = 0; i < 124; i++) text[i] = 'x';
    printf("  a reason of 124 bytes: %d\n", ws->closeWith(1000, text));
    printf("  closeSent is still %d\n", ws->closeSent);
    ws->closeWith(1000, null);
    printf("  after the close frame: sendText -> %d\n", ws->sendText("late"));
    ws->dispose(); server->dispose();
    return 0;
}
