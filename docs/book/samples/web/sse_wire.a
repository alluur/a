// Server-Sent Events: the text format, written and parsed
import sse;
import strings;

int main() {
    // what a server writes: one block of lines per event, ended by an empty line
    char* a = sse.eventText("update", "line 1\nline 2", "7", 0);     // event name, data, id, retry (0: none)
    char* b = sse.eventText(null, "just data", null, 3000);
    printf("%s--\n%s--\n", a, b);
    printf("a comment line: %s", sse.commentText("keep-alive"));
    printf("a newline in the event name: %s\n", sse.eventText("x\ny", "data", null, 0) == null ? "refused (null)" : "written");

    // what a client reads: a byte stream cut anywhere (here into pieces of 5 bytes), line ends LF, CR or CRLF
    char* stream = ": hello\r\nretry: 1500\r\nevent: tick\r\nid: 1\r\ndata: one\r\n\r\n"
                   "data: two\ndata: lines\n\n"
                   "event: nodata\n\n"
                   "id: 9\rdata: cr only\r\r";
    sse.Parser* p = sse.newParser();
    int n = strlen(stream);
    for (int at = 0; at < n; at = at + 5) {
        int len = n - at < 5 ? n - at : 5;
        p->feed(&stream[at], len);
        sse.Event* e = p->take();
        while (e != null) {
            char* data = strings.replace(e->data, "\n", "\\n");
            printf("event \"%s\", data \"%s\", id \"%s\"\n", e->event, data, e->id);
            e->dispose();
            e = p->take();
        }
    }
    printf("retry: %d ms, last id: \"%s\", events seen: %d\n", p->retryMs, p->lastId, p->eventsSeen);
    p->dispose();
    return 0;
}
