// JSON-RPC 2.0: a method table that answers text, with no transport at all
import jsonrpc;
import json;

// A handler gets the call and returns a NEW json value (or null after c->fail). Never return the params.
json.Json* add(jsonrpc.Call* c) {
    json.Json* a = c->param(0, "a");                     // positional [1,2] or named {"a":1,"b":2}
    json.Json* b = c->param(1, "b");
    if (a == null || b == null || !a->isNumber() || !b->isNumber()) {
        c->fail(jsonrpc.INVALID_PARAMS, "need numbers a and b", null);
        return null;
    }
    return json.newInt(a->asInt() + b->asInt());
}

int logged = 0;
json.Json* logCall(jsonrpc.Call* c) {                        // used as a notification: nobody reads its result
    logged++;
    return null;
}

json.Json* withdraw(jsonrpc.Call* c) {
    json.Json* data = json.newObject();                  // an error of our own, with data
    data->set("balance", json.newInt(10));
    c->fail(-32001, "insufficient funds", data);
    return null;
}

void send(jsonrpc.Dispatcher* d, char* request) {
    int n;
    char* reply = d->handleText(request, -1, &n);        // -1: the text ends at its zero byte
    printf("--> %s\n", request);
    if (reply == null) println("<-- (no reply)");
    else { printf("<-- %s\n", reply); free(reply); }
}

int main() {
    jsonrpc.Dispatcher* d = new jsonrpc.Dispatcher();
    d->add("add", add);
    d->add("log", logCall);
    d->add("withdraw", withdraw);

    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,2],\"id\":1}");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":{\"a\":40,\"b\":2},\"id\":\"x7\"}");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,\"two\"],\"id\":2}");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"nope\",\"id\":3}");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"withdraw\",\"id\":4}");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"log\",\"params\":[\"hi\"]}");          // no id: a notification
    printf("   (the notification ran: %d)\n", logged);

    println("a batch: two requests, one notification, one invalid entry");
    send(d, "[{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[1,1],\"id\":1},"
            "{\"jsonrpc\":\"2.0\",\"method\":\"log\"},"
            "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"params\":[2,2],\"id\":2},"
            "42]");
    send(d, "[{\"jsonrpc\":\"2.0\",\"method\":\"log\"}]");     // only notifications: no reply at all
    send(d, "[]");
    send(d, "{\"jsonrpc\":\"2.0\",\"method\":\"add\",\"id\":{}}");
    send(d, "{\"jsonrpc\": \"2.0\", \"method\": \"add\", ");
    return 0;
}
