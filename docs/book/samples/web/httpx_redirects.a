// Redirects: which method survives, how many are followed, and where credentials stop
import httpx;
import wshub;
import net;

wshub.Hub* hubA;                                         // the server we ask
wshub.Hub* hubB;                                         // another origin: same machine, other port

int serve() { hubA->poll(0); hubB->poll(0); return 0; }

// answers with what it received, so that we can see what survived the redirect
int echo(httpx.Context* x) {
    char* auth = x->req->header("Authorization");
    char text[120];
    format(&text[0], 120, "%s with %d body bytes, Authorization: %s", &x->req->method[0], x->req->bodyLen, auth == null ? "(none)" : auth);
    x->res->text(200, &text[0]);
    return 0;
}

int go(httpx.Context* x) {                               // /go/301 redirects with the status 301, and so on
    x->res->redirect(atoi(x->req->param("code")), "/echo");
    return 0;
}

int loop(httpx.Context* x) { x->res->redirect(302, "/loop"); return 0; }

int elsewhere(httpx.Context* x) {                        // to the other hub: another port is another origin
    char to[60];
    format(&to[0], 60, "http://127.0.0.1:%d/echo", hubB->port);
    x->res->redirect(302, &to[0]);
    return 0;
}

wshub.Hub* makeHub() {
    wshub.Hub* h = new wshub.Hub();
    h->router = new httpx.Router();
    h->router->any("/echo", echo);
    h->router->any("/go/:code", go);
    h->router->get("/loop", loop);
    h->router->get("/elsewhere", elsewhere);
    h->listenOn("127.0.0.1", 0, null);
    return h;
}

void show(char* what, httpx.Reply* r) {
    if (r == null) { printf("%-22s no reply: %s\n", what, httpx.error()); return; }
    printf("%-22s %d after %d redirect(s): %s\n", what, r->status, r->redirects, r->body);
    r->dispose();
}

int main() {
    hubA = makeHub();
    hubB = makeHub();
    net.setIdleHook(serve);
    httpx.Client* c = httpx.newClient();
    char url[80];

    // POST a body to a URL that redirects
    int codes[5] = { 301, 302, 303, 307, 308 };
    for (int i = 0; i < 5; i++) {
        format(&url[0], 80, "http://127.0.0.1:%d/go/%d", hubA->port, codes[i]);
        char what[30];
        format(&what[0], 30, "POST, redirect %d:", codes[i]);
        show(&what[0], c->postJson(&url[0], "{\"a\":1}"));
    }

    // redirects can be switched off, or limited
    format(&url[0], 80, "http://127.0.0.1:%d/go/302", hubA->port);
    c->maxRedirects = 0;
    httpx.Reply* r = c->get(&url[0]);
    printf("%-22s %d, Location: %s\n", "maxRedirects = 0:", r->status, r->header("Location"));
    r->dispose();
    c->maxRedirects = 5;
    format(&url[0], 80, "http://127.0.0.1:%d/loop", hubA->port);
    show("a redirect loop:", c->get(&url[0]));

    // credentials that were set for one server must not follow a redirect to another one
    c->maxRedirects = 10;
    c->headers->set("Authorization", "Bearer secret");
    format(&url[0], 80, "http://127.0.0.1:%d/go/302", hubA->port);
    show("same origin:", c->get(&url[0]));
    format(&url[0], 80, "http://127.0.0.1:%d/elsewhere", hubA->port);
    show("other origin:", c->get(&url[0]));
    return 0;
}
