// Retries and time limits: a server that fails twice, and one that never answers
import httpx;
import wshub;
import net;

wshub.Hub* hub;
int attempts = 0;

int serve() { hub->poll(0); return 0; }

// Fails with 503 twice, then works.
int flaky(httpx.Context* x) {
    attempts++;
    if (attempts <= 2) {
        x->res->text(503, "try again later");
        x->res->setHeader("Retry-After", "0");          // seconds; the client honours it (at most 5 s)
        return 0;
    }
    x->res->text(200, "finally");
    return 0;
}

int main() {
    hub = new wshub.Hub();
    hub->router = new httpx.Router();
    hub->router->get("/flaky", flaky);
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "http://127.0.0.1:%d/flaky", hub->port);

    httpx.Client* c = httpx.newClient();
    httpx.Reply* r = c->get(&url[0]);                    // retries = 0: the first answer is the answer
    printf("no retries:  %d \"%s\" after %d attempt(s)\n", r->status, r->body, attempts);

    attempts = 0;
    c->retries = 3;                                      // after 502, 503, 504, 429 and connection errors; not for POST or PATCH
    c->retryBackoffMs = 10;                              // the pause before the first retry, then doubled
    r = c->get(&url[0]);
    printf("3 retries:   %d \"%s\" after %d attempt(s)\n", r->status, r->body, attempts);

    // A server that accepts the connection and says nothing
    int silent = net.listenOn("127.0.0.1", 0, 4);
    format(&url[0], 80, "http://127.0.0.1:%d/", net.localPort(silent));
    c->retries = 0;
    c->headerTimeoutMs = 200;                            // default 15000; the other limits are connect, send, body and total
    r = c->get(&url[0]);
    printf("silent server: %s (%s)\n", r == null ? "no reply" : "a reply", httpx.error());
    return 0;
}
