// Multipart forms: building an upload and reading it on the server
import httpx;
import wshub;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }

// The server: split the body into its parts and describe them.
int upload(httpx.Context* x) {
    httpx.Part* parts[8];
    int n = httpx.parseMultipart(x->req->header("Content-Type"), x->req->body, x->req->bodyLen, &parts[0], 8);
    if (n < 0) { x->res->text(400, "not a multipart body"); return 0; }
    char text[400];
    text[0] = 0;
    for (int i = 0; i < n; i++) {
        char line[120];
        if (parts[i]->filename != null)
            format(&line[0], 120, "file  %s: \"%s\", %s, %d bytes\n", parts[i]->name, parts[i]->filename, parts[i]->contentType, parts[i]->length);
        else
            format(&line[0], 120, "field %s = \"%s\"\n", parts[i]->name, parts[i]->data);
        strcat(&text[0], &line[0]);
    }
    httpx.freeParts(&parts[0], n);
    x->res->text(200, &text[0]);
    return 0;
}

int main() {
    hub = new wshub.Hub();
    hub->router = new httpx.Router();
    hub->router->post("/upload", upload);
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    httpx.Multipart* form = httpx.newMultipart();         // names and file names are escaped for you
    form->addField("title", "Holiday \"photos\"");
    form->addField("note", "line 1\r\nline 2");           // a field may hold line breaks
    char data[300];
    for (int i = 0; i < 300; i++) data[i] = i;            // binary, zero bytes included
    form->addFile("picture", "beach.png", "image/png", &data[0], 300);
    printf("content type: %.19s; boundary=...\n", form->contentType());

    char url[80];
    format(&url[0], 80, "http://127.0.0.1:%d/upload", hub->port);
    httpx.Client* c = httpx.newClient();
    httpx.Reply* r = c->postMultipart(&url[0], form);
    printf("status %d\n%s", r->status, r->body);

    r = c->postJson(&url[0], "{\"not\":\"multipart\"}");   // the same route with a different body
    printf("status %d: %s\n", r->status, r->body);
    return 0;
}
