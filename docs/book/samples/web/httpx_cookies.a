// Cookies: a jar that remembers Set-Cookie and sends the right ones back
import httpx;
import wshub;
import net;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }

int login(httpx.Context* x) {
    x->res->addHeader("Set-Cookie", "sid=abc123; Path=/; HttpOnly");
    x->res->addHeader("Set-Cookie", "theme=dark; Path=/prefs");           // only for URLs under /prefs
    x->res->redirect(302, "/echo");                                       // the cookies are already in the jar when the client follows
    return 0;
}

int logout(httpx.Context* x) {
    x->res->addHeader("Set-Cookie", "sid=; Path=/; Max-Age=0");           // Max-Age=0: delete it
    x->res->text(200, "bye");
    return 0;
}

int echo(httpx.Context* x) {
    char* cookie = x->req->header("Cookie");
    char text[100];
    format(&text[0], 100, "Cookie header: %s", cookie == null ? "(none)" : cookie);
    x->res->text(200, &text[0]);
    return 0;
}

void get(httpx.Client* c, char* path) {
    char url[100];
    format(&url[0], 100, "http://127.0.0.1:%d%s", hub->port, path);
    httpx.Reply* r = c->get(&url[0]);
    printf("GET %-13s -> %s\n", path, r->body);
    r->dispose();
}

int main() {
    hub = new wshub.Hub();
    hub->router = new httpx.Router();
    hub->router->get("/login", login);
    hub->router->get("/logout", logout);
    hub->router->get("/echo", echo);
    hub->router->get("/prefs/echo", echo);
    hub->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    println("a client without a jar forgets every cookie:");
    httpx.Client* plain = httpx.newClient();
    get(plain, "/login");
    get(plain, "/echo");

    println("a client with a jar:");
    httpx.Client* c = httpx.newClient();
    c->cookies = httpx.newCookieJar();
    get(c, "/login");                                    // sets two cookies, then redirects to /echo
    get(c, "/prefs/echo");                               // the path of both cookies matches
    get(c, "/echo");                                     // theme is for /prefs only
    httpx.Cookie* sid = c->cookies->find("sid", "127.0.0.1");
    printf("in the jar: sid=%s, HttpOnly=%d, path %s; %d cookies\n", sid->value, sid->httpOnly, sid->path, c->cookies->n);
    get(c, "/logout");
    get(c, "/prefs/echo");
    printf("in the jar: %d cookie\n", c->cookies->n);
    return 0;
}
