// A WebSocket echo server and client in one thread
import websocket;
import conn;
import net;

int listener;                       // the listening socket
websocket.WebSocket* server;        // the server's end of the one connection

// Runs while the client waits for the network (see net.setIdleHook): it plays the server.
int serve() {
    if (server == null) {
        int fd = net.acceptSome(listener);            // the listener is non-blocking: negative when nobody is there yet
        if (fd < 0) return 0;
        char path[256];
        server = websocket.accept(conn.create(fd), &path[0], 256);
        printf("server: upgrade for %s\n", &path[0]);
        server->setNonBlocking(true);                // the server must never wait: the client is in the same thread
        return 0;
    }
    server->pump();                                  // read what has arrived (answers pings by itself)
    websocket.Message* m = server->takeMessage();
    while (m != null) {
        if (m->isText()) server->sendText(m->data); else server->sendBinary(m->data, m->length);
        m->dispose();
        m = server->takeMessage();
    }
    return 0;
}

int main() {
    listener = net.listenOn("127.0.0.1", 0, 4);      // port 0: the system picks one; 127.0.0.1: this machine only
    net.setNonBlocking(listener, true);
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "ws://127.0.0.1:%d/echo", net.localPort(listener));

    websocket.WebSocket* ws = websocket.connect(&url[0]);
    if (ws == null) { println(websocket.error()); return 1; }
    printf("client: connected, status %d\n", websocket.status());

    ws->sendText("hello");
    websocket.Message* m = ws->receiveMessage();     // waits for one whole message
    printf("client: %s message \"%s\" (%d bytes)\n", m->isText() ? "text" : "binary", m->data, m->length);
    m->dispose();

    ws->sendBinary("\x01\x02\x00\x03", 4);
    m = ws->receiveMessage();
    printf("client: %s message of %d bytes, byte 2 is %d\n", m->isText() ? "text" : "binary", m->length, m->data[2]);
    m->dispose();

    ws->closeWith(1000, "done");                     // the closing handshake
    printf("client: closed=%d code=%d\n", ws->closed, ws->closeCode);
    ws->dispose();
    server->dispose();
    return 0;
}
