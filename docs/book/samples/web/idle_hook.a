// net.setIdleHook: a client and its server in one thread, no threads and no polling loop
import net;

int listener;
int peer = -1;                  // the accepted connection, once there is one
int hookCalls = 0;

// The hook. net calls it every few milliseconds while a blocking call of the client side waits.
// It must not wait itself (a blocking call inside it would stop the client, which is waiting for us),
// so it uses the "Some" calls and waitReadable(h, 0).
int serve() {
    hookCalls++;
    if (peer < 0) {
        peer = net.acceptSome(listener);                  // needs a non-blocking listener; negative: nobody yet
        return 0;
    }
    if (net.waitReadable(peer, 0)) {                      // 0 ms: is there something to read right now?
        char line[100];
        int n = net.recvLine(peer, &line[0], 100);
        if (n < 0) { net.close(peer); peer = -1; return 0; }
        char answer[120];
        format(&answer[0], 120, "you said: %s\n", &line[0]);
        net.sendText(peer, &answer[0]);
    }
    return 0;
}

int main() {
    listener = net.listenOn("127.0.0.1", 0, 4);
    net.setNonBlocking(listener, true);
    net.setIdleHook(serve);                               // from now on, every wait of net runs serve() now and then

    int c = net.connect("127.0.0.1", net.localPort(listener));
    net.sendText(c, "first\n");
    char buf[100];
    net.recvLine(c, &buf[0], 100);                        // blocks: while it waits, the server answers
    println(&buf[0]);
    net.sendText(c, "second\n");
    net.recvLine(c, &buf[0], 100);
    println(&buf[0]);

    printf("the hook ran: %s\n", hookCalls > 0 ? "yes" : "no");
    net.setIdleHook(null);                                // switch it off again
    net.close(c);
    net.close(listener);
    return 0;
}
