// Keepalive: pings after silence, and a peer that stops answering
import websocket;

websocket.WebSocket* client;
websocket.WebSocket* server;

// The clock is a parameter of tick(now), so the sample can run time at any speed.
void at(int ms, bool serverAnswers) {
    client->tick(ms);
    if (client->outPending() > 0) {
        bool ping = (client->outData()[0] & 15) == websocket.OP_PING;
        printf("t=%4d ms: the client sends %s\n", ms, ping ? "a ping" : "a close frame");
        server->feed(client->outData(), client->outPending());      // the server's feed() queues the pong...
        client->outConsumed(client->outPending());
        if (serverAnswers && ping) {
            client->clockNow = ms + 40;                             // ... which needs 40 ms to come back
            client->feed(server->outData(), server->outPending());
        }
        server->outConsumed(server->outPending());
    }
    if (client->closed) printf("t=%4d ms: closed by the library: code %d, \"%s\"\n", ms, client->localCloseCode, &client->failReason[0]);
}

int main() {
    client = websocket.create(null, true);
    server = websocket.create(null, false);
    client->setKeepalive(1000, 500);                     // ping after 1000 ms without a sign of life, give up 500 ms later
    client->lastRx = 0;

    at(500, true);                                       // too early: nothing happens
    at(1000, true);                                      // a ping, answered at once
    printf("          round trip of that ping: %d ms\n", client->rttMs);
    at(1500, true);
    at(2100, false);                                     // the next ping is not answered
    at(2400, true);
    at(2600, true);                                      // 500 ms passed since the ping
    printf("sendText on the dead connection: %d\n", client->sendText("hello?"));
    return 0;
}
