// A secure WebSocket (wss://) to a wshub with TLS
import websocket;
import wshub;
import x509;
import tls;
import net;
import testcert;

wshub.Hub* hub;

int serve() { hub->poll(0); return 0; }               // the hub serves while the client waits (see ws_echo)

int echo(wshub.Hub* h, wshub.Client* c, char* data, int n, int isText) {
    h->sendData(c, data, n, isText == 1);
    return 0;
}

int main() {
    hub = new wshub.Hub();
    hub->onMessage = echo;
    hub->listenOn("127.0.0.1", 0, tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM));   // TLS handshakes inside the hub
    net.setIdleHook(serve);
    char url[80];
    format(&url[0], 80, "wss://127.0.0.1:%d/", hub->port);

    // 1. Nobody trusts our throw-away certificate yet: the client refuses it
    x509.clearRoots();                                 // also keeps the system's roots out of this sample
    websocket.WebSocket* ws = websocket.connect(&url[0]);
    printf("untrusted: %s (%s)\n", ws == null ? "refused" : "connected", websocket.error());

    // 2. A client that skips the check (encrypts, but does not know who it talks to)
    websocket.Options* o = new websocket.Options();
    o->verify = false;
    ws = websocket.connectWith(&url[0], o);
    printf("verify=false: %s\n", ws == null ? "refused" : "connected");
    ws->dispose();

    // 3. Trust the certificate: the normal case
    x509.addRootPem(testcert.CERT_PEM);
    ws = websocket.connect(&url[0]);
    ws->sendText("hello over TLS");
    websocket.Message* m = ws->receiveMessage();
    printf("trusted: echo \"%s\", status %d\n", m->data, websocket.status());
    m->dispose();
    ws->closeWith(1000, null);
    ws->dispose();
    printf("TLS handshakes that failed on the server: %d\n", hub->stats->tlsFailures);
    return 0;
}
