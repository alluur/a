// Compiling a pattern and reading its groups
import regex;

int main() {
    regex.Regex* re = regex.compile("(\\w+)@(\\w+)\\.com", 0);
    if (!re->ok) {
        printf("bad pattern: %s\n", re->error);
        return 1;
    }
    char* text = "write to bob@example.com or ann@site.com";

    // caps holds a start and an end offset for the whole match and for every group
    int caps[66];
    int at = re->search(text, strlen(text), 0, caps);
    printf("first match starts at %d\n", at);
    for (int g = 0; g <= re->groups; g++) {
        printf("group %d = \"%.*s\"\n", g, caps[2 * g + 1] - caps[2 * g], &text[caps[2 * g]]);
    }

    // matchFull needs the whole text to match, matchAt is anchored at one position
    printf("full: %d\n", re->matchFull("bob@example.com", 15, caps));
    printf("full: %d\n", re->matchFull("mail bob@example.com", 20, caps));
    printf("anchored at 9: ends at %d\n", re->matchAt(text, strlen(text), 9, caps));
    printf("no match: %d\n", re->search("nothing here", 12, 0, caps));
    re->dispose();
    return 0;
}
