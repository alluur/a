// Named groups, back references and non-capturing groups
import regex;

int main() {
    // a date: groups can be named, and looked up by name
    regex.Regex* re = regex.compile("(?P<year>\\d{4})-(?P<month>\\d\\d)-(?P<day>\\d\\d)", 0);
    char* text = "released 2024-03-17, patched 2024-04-02";
    int caps[66];
    int at = re->search(text, strlen(text), 0, caps);
    char* names[3] = {"year", "month", "day"};
    for (int i = 0; i < 3; i++) {
        int g = re->groupIndex(names[i]);
        printf("%-5s is group %d: %.*s\n", names[i], g, caps[2 * g + 1] - caps[2 * g], &text[caps[2 * g]]);
    }
    printf("unknown name -> %d, groups: %d\n", re->groupIndex("hour"), re->groups);
    printf("at %d\n", at);

    // \1 repeats what group 1 matched: find doubled words
    regex.Regex* dup = regex.compile("\\b(\\w+) \\1\\b", 0);
    char* s = "this is is a test of the the matcher";
    int pos = 0;
    while (dup->search(s, strlen(s), pos, caps) >= 0) {
        printf("doubled: %.*s\n", caps[3] - caps[2], &s[caps[2]]);
        pos = caps[1];
    }

    // (?:...) groups without capturing, so the group numbers stay small
    regex.Regex* nc = regex.compile("(?:ab)+(c)", 0);
    nc->search("xababc", 6, 0, caps);
    printf("non-capturing: %d group, it matched \"%c\"\n", nc->groups, "xababc"[caps[2]]);

    // a group that did not take part has the offsets -1
    regex.Regex* opt = regex.compile("(a)|(b)", 0);
    opt->search("b", 1, 0, caps);
    printf("group 1: %d %d, group 2: %d %d\n", caps[2], caps[3], caps[4], caps[5]);
    return 0;
}
