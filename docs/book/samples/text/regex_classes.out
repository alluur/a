\d+              <12> <3> <7> <4> <50>
\w+              <ab12> <cd_3> <7> <Zed> <4> <50> <x>
[a-c]+           <ab> <c>
[^a-z ]+         <12> <_3> <-7-> <Z> <4.50>
[[:alpha:]]+     <ab> <cd> <Zed> <x>
\d+\.\d+         <4.50>
\d{2}            <12> <50>
\d{1,}           <12> <3> <7> <4> <50>
Z|x|cd           <cd> <Z> <x>
<.+>             <<a><b>>
<.+?>            <<a>> <<b>>
colou?r          <color> <colour>
