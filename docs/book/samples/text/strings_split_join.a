// Splitting a line into fields and joining them again
import strings;

int main() {
    char* line = "red,green,,blue";
    char* parts[8];
    int n = strings.split(line, ',', parts, 8);       // one character as the separator
    printf("%d parts\n", n);
    for (int i = 0; i < n; i++) {
        printf("  [%d] \"%s\"\n", i, parts[i]);       // the empty field is kept
    }
    println(strings.join(parts, n, " | "));

    // max limits the number of pieces; the rest of the text is dropped
    char* few[2];
    int m = strings.split("1 2 3 4", ' ', few, 2);
    printf("%d: %s %s\n", m, few[0], few[1]);

    // a text without the separator comes back as one piece
    printf("%d\n", strings.split("single", ',', parts, 8));
    return 0;
}
