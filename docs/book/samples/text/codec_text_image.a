// Drawing text with the built-in 5x7 font and reading it back
import codec;

int main() {
    codec.Image* pic = codec.textToImage("A+B", 1);
    printf("%d x %d pixels\n", pic->w, pic->h);
    print(codec.toAscii(pic, 1));

    // a larger, two line picture is read back exactly (scale 0 = detect the scale)
    codec.Image* page = codec.textToImage("Line one\nSecond: 42", 2);
    println(codec.imageToText(page, 0));

    // a few flipped pixels are tolerated: the reader picks the closest glyph
    for (int i = 0; i < 6; i++) {
        int x = (i * 37 + 5) % page->w;
        int y = (i * 53 + 3) % page->h;
        page->set(x, y, 255 - page->get(x, y));
    }
    println(codec.imageToText(page, 2));
    return 0;
}
