// The string functions every program has, no import needed
int main() {
    char* s = "  The A programming language  ";

    char* copy = strdup(s);                 // trim() works in place, so work on a copy
    char* t = trim(copy);
    printf("[%s]\n", t);

    printf("find     = %d\n", find(t, "programming"));
    printf("contains = %d\n", contains(t, "language"));
    printf("indexOf  = %d\n", indexOf(t, 'A'));
    printf("starts   = %d, ends = %d\n", startsWith(t, "The"), endsWith(t, "age"));
    println(substr(t, 4, 1));               // a new string: start 4, length 1
    println(substr(t, 6, 11));

    char* up = strdup(t);
    strUpper(up);                           // also in place
    println(up);
    printf("streqi = %d, streq = %d\n", streqi("Hello", "hELLO"), streq("Hello", "hELLO"));
    printf("apple before banana: %d\n", strcmp("apple", "banana") < 0);
    return 0;
}
