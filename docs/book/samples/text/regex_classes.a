// Character classes, quantifiers and alternatives
import regex;

void findAll(char* pat, char* text) {
    regex.Regex* re = regex.compile(pat, 0);
    if (!re->ok) { printf("%s: %s\n", pat, re->error); return; }
    int n = strlen(text);
    int caps[66];
    int pos = 0;
    printf("%-16s", pat);
    while (pos <= n) {
        int at = re->search(text, n, pos, caps);
        if (at < 0) { break; }
        printf(" <%.*s>", caps[1] - caps[0], &text[at]);
        pos = caps[1] > at ? caps[1] : at + 1;
    }
    println("");
    re->dispose();
}

int main() {
    char* t = "ab12 cd_3 -7- Zed 4.50 x";
    findAll("\\d+", t);                  // digits
    findAll("\\w+", t);                  // letters, digits and _
    findAll("[a-c]+", t);                // a range
    findAll("[^a-z ]+", t);              // anything but lower case letters and blanks
    findAll("[[:alpha:]]+", t);          // POSIX class
    findAll("\\d+\\.\\d+", t);           // a literal dot needs a backslash
    findAll("\\d{2}", t);                // exactly two
    findAll("\\d{1,}", t);               // one or more
    findAll("Z|x|cd", t);                // alternatives: the first that fits wins
    findAll("<.+>", "<a><b>");           // greedy: as much as possible
    findAll("<.+?>", "<a><b>");          // lazy: as little as possible
    findAll("colou?r", "color colour");  // optional
    return 0;
}
