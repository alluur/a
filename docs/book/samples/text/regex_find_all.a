// Finding every match in a text
import regex;

int main() {
    regex.Regex* re = regex.compile("(\\d+)-(\\d+)", 0);
    char* text = "pages 10-15, 22-30 and 104-110; not 7 or 8-";
    int n = strlen(text);

    int caps[66];
    int pos = 0;
    int found = 0;
    while (pos <= n) {
        int at = re->search(text, n, pos, caps);
        if (at < 0) { break; }
        int lo = atoi(&text[caps[2]]);              // group 1 and group 2 as numbers
        int hi = atoi(&text[caps[4]]);
        found++;
        printf("#%d at %2d: %.*s  (%d pages)\n", found, at, caps[1] - caps[0], &text[at], hi - lo + 1);
        // continue after the match; an empty match must move on by one
        pos = caps[1] > at ? caps[1] : at + 1;
    }
    printf("%d matches\n", found);
    re->dispose();
    return 0;
}
