// Saving a picture as PGM, PBM and BMP and loading it again
import codec;

int main() {
    codec.Image* pic = codec.textToImage("File IO", 2);
    printf("picture: %d x %d\n", pic->w, pic->h);

    codec.writePgm(pic, "pic.pgm");                  // 8 bit grey
    codec.writePbm(pic, "pic.pbm", 128, true);       // 1 bit, binary form
    codec.writePbm(pic, "pic.txt.pbm", 128, false);  // 1 bit, plain text form
    codec.writeBmp(pic, "pic.bmp");

    char* names[4] = {"pic.pgm", "pic.pbm", "pic.txt.pbm", "pic.bmp"};
    for (int i = 0; i < 4; i++) {
        int h = fileOpen(names[i], FILE_READ);
        char buf[64];
        int size = 0;
        int n;
        while ((n = fileRead(h, buf, 64)) > 0) { size = size + n; }
        fileClose(h);
        printf("%-12s %5d bytes\n", names[i], size);
    }

    codec.Image* a = codec.readPgm("pic.pgm");
    codec.Image* b = codec.readBmp("pic.bmp");
    printf("PGM read back: \"%s\"\n", codec.imageToText(a, 2));
    printf("BMP read back: \"%s\"\n", codec.imageToText(b, 2));
    printf("missing file: %d\n", codec.readBmp("nothing.bmp") == null);
    return 0;
}
