// Building text piece by piece with a StringBuilder
import strings;

int main() {
    strings.StringBuilder sb;            // lives on the stack; the text grows on the heap
    sb.append("items:");
    for (int i = 1; i <= 5; i++) {
        sb.appendChar(' ');
        sb.appendInt(i * i);
    }
    println(sb.view());                  // a view: valid until the next append
    printf("length = %d\n", sb.length());

    char* kept = sb.toString();          // an independent copy
    sb.clear();
    sb.append("fresh start");
    printf("builder: %s (%d)\n", sb.view(), sb.length());
    printf("copy   : %s\n", kept);
    return 0;
}
