// Hexadecimal and URL (percent) encoding
import encoding;

int main() {
    char raw[4] = {'A', 255, 0, 'z'};
    char* hex = encoding.hexEncode(raw, 4);          // always lowercase
    println(hex);

    char back[16];
    int n = encoding.hexDecode("48656C6c6f", back);  // upper and lower case digits are fine
    back[n] = 0;
    printf("%d bytes: %s\n", n, back);
    printf("odd length: %d\n", encoding.hexDecode("abc", back));   // -1
    printf("not hex   : %d\n", encoding.hexDecode("zz", back));    // -1

    // URL encoding keeps letters, digits and - _ . ~ and escapes the rest
    println(encoding.urlEncode("a b&c=d/e~f_g.h-i"));
    println(encoding.urlEncode("café"));             // every UTF-8 byte is escaped
    println(encoding.urlDecode("a%20b%26c+d"));      // + becomes a space
    println(encoding.urlDecode("100%zz"));           // a broken escape is kept as it is
    return 0;
}
