// Converting between text and code points
import utf8;

int main() {
    // text to an array of code points ...
    int cps[32];
    int n = utf8.toCodepoints("Aé€😀", cps, 32);
    for (int i = 0; i < n; i++) {
        printf("%d: U+%X\n", i, cps[i]);
    }

    // ... and back: build "Hello" plus a snowman and a heart
    int hello[8] = {72, 101, 108, 108, 111, 0x2603, 0x2764};
    char* text = utf8.fromCodepoints(hello, 7);
    printf("%s (%d bytes, %d characters)\n", text, strlen(text), utf8.length(text));

    // encode one code point into a small buffer
    char buf[5];
    int len = utf8.encode(0x20AC, buf);              // the euro sign
    buf[len] = 0;
    printf("euro: %s is %d bytes:", buf, len);
    for (int i = 0; i < len; i++) { printf(" %02X", buf[i]); }
    println("");
    return 0;
}
