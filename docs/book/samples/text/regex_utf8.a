// Regular expressions work on UTF-8 characters
import regex;

int main() {
    char* text = "Grüße aus Zürich: 日本語のテキスト";

    // . and negated classes consume a whole character, not one byte
    regex.Regex* re = regex.compile("Gr.{3}", 0);
    int caps[66];
    int at = re->search(text, strlen(text), 0, caps);
    printf("\"%.*s\" is %d bytes\n", caps[1] - caps[0], &text[at], caps[1] - caps[0]);

    // \w includes every non-ASCII letter
    regex.Regex* word = regex.compile("\\w+", 0);
    int pos = 0;
    int n = strlen(text);
    while (word->search(text, n, pos, caps) >= 0) {
        printf("<%.*s>", caps[1] - caps[0], &text[caps[0]]);
        pos = caps[1];
    }
    println("");

    // a class with a range of code points: hiragana and katakana
    regex.Regex* kana = regex.compile("[ぁ-ヶ]+", 0);
    kana->search(text, n, 0, caps);
    printf("kana: %.*s\n", caps[1] - caps[0], &text[caps[0]]);

    // case folding (?i) is for ASCII letters only
    printf("Ü vs ü: %d\n", regex.compile("(?i)ü", 0)->search("Ü", 2, 0, null));
    return 0;
}
