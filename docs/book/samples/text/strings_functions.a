// Searching, replacing and padding with the strings module
import strings;

int main() {
    char* s = "one fish two fish red fish";

    printf("count(\"fish\")       = %d\n", strings.count(s, "fish"));
    printf("count(\"aa\" in aaaa) = %d\n", strings.count("aaaa", "aa"));   // matches do not overlap
    printf("lastIndexOf('f')    = %d\n", strings.lastIndexOf(s, 'f'));
    println(strings.replace(s, "fish", "cat"));
    println(strings.replace(s, "fish", ""));          // deleting by replacing with nothing
    println(strings.reverse("stressed"));
    println(strings.repeat("=-", 8));
    println(strings.concat("foo", "bar"));

    // padding builds aligned columns
    println(strings.padLeft("7", 3, '0'));
    println(strings.padRight("name", 10, '.'));
    println(strings.padLeft("toolong", 3, ' '));      // never cuts: too long text is returned as it is

    println(strings.capitalize("hello"));
    println(strings.upper("MiXed Case"));
    println(strings.lower("MiXed Case"));
    printBool(strings.isBlank(" \t ")); println("");
    printBool(strings.isBlank(" x ")); println("");
    return 0;
}
