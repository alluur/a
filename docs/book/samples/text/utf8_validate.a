// Checking and repairing bytes that are not valid UTF-8
import utf8;

void check(char* label, char* s) {
    printf("%-18s valid=%d length=%d\n", label, utf8.isValid(s), utf8.length(s));
}

int main() {
    check("plain ascii", "hello");
    check("accents", "caf\xC3\xA9");
    check("lone continuation", "a\x80z");                // 0x80 cannot start a character
    check("truncated euro", "x\xE2\x82");                // the third byte is missing
    check("overlong NUL", "\xC0\x80");                   // C0 and C1 are never valid

    // invalid bytes decode as U+FFFD, one byte at a time, so a scan never gets stuck
    int cp;
    int used = utf8.decode("\xFF!", 0, &cp);
    printf("decode(0xFF): U+%04X, %d byte\n", cp, used);
    return 0;
}
