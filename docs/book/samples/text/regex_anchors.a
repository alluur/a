// Anchors and word boundaries
import regex;

void show(char* pat, char* text, int flags) {
    regex.Regex* re = regex.compile(pat, flags);
    int caps[66];
    int at = re->search(text, strlen(text), 0, caps);
    if (at < 0) {
        printf("%-12s no match\n", pat);
    } else {
        printf("%-12s \"%.*s\" at %d\n", pat, caps[1] - caps[0], &text[at], at);
    }
    re->dispose();
}

int main() {
    char* text = "cat\nconcatenate cat";
    show("cat", text, 0);                // the first one, inside the first line
    show("^cat", text, 0);               // ^ is the start of the text only ...
    show("^con", text, 0);               // ... so the second line does not count
    show("(?m)^con", text, 0);           // (?m): ^ and $ work on every line
    show("cat$", text, 0);               // the end of the text
    show("cat$", "cat\n", 0);            // $ also matches before a final newline
    show("\\bcat\\b", "concatenate cat", 0);   // a whole word only
    show("\\Bcat\\B", "concatenate cat", 0);   // inside a word
    show("\\Acat", "cat", 0);            // \A and \Z never depend on (?m)
    show("cat\\Z", "cat\n", 0);          // \Z is the very end: this fails
    show("^CAT", "cat", regex.F_ICASE);  // the flag argument instead of (?i)
    return 0;
}
