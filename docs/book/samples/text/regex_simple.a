// The simple functions: matches, test, search, quote
import regex;

int main() {
    // these four use the old simple dialect: ( ) | { } are ordinary characters
    printf("matches: %d\n", regex.matches("a.c", "abc"));        // the whole text
    printf("matches: %d\n", regex.matches("a.c", "abcd"));
    printf("test   : %d\n", regex.test("[0-9]+", "room 101"));    // anywhere in the text
    printf("test   : %d\n", regex.test("main()", "int main() {"));    // parentheses are plain here

    int len;
    int at = regex.search("[a-z]+@[a-z]+", "mail bob@site now", &len);
    printf("search : at %d, length %d\n", at, len);

    // quote() escapes everything special, so user input can be searched for literally
    char* q = regex.quote("1+1=2 (really?)");
    println(q);
    printf("literal: %d\n", regex.test(q, "is 1+1=2 (really?) true"));

    // compile(pattern, F_SIMPLE) gives the same dialect as an object;
    // without it the full syntax applies and ( ) are a group
    regex.Regex* simple = regex.compile("a(b)", regex.F_SIMPLE);
    regex.Regex* full = regex.compile("a(b)", 0);
    printf("simple: %d, full: %d\n", simple->search("a(b)", 4, 0, null), full->search("a(b)", 4, 0, null));
    return 0;
}
