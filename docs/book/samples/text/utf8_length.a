// Bytes and characters are not the same thing
import utf8;

int main() {
    char* s = "naïve café, 日本語, 😀";
    printf("bytes      : %d\n", strlen(s));          // strlen counts bytes
    printf("code points: %d\n", utf8.length(s));     // utf8.length counts characters

    // walk the text one code point at a time
    int pos = 0;
    int cp;
    while (s[pos] != 0) {
        int used = utf8.decode(s, pos, &cp);
        if (cp > 127) {
            printf("U+%04X uses %d bytes at offset %d\n", cp, used, pos);
        }
        pos = pos + used;
    }

    // byte offset of the character with index 6 (the 7th): "naïve " is 6 characters but 7 bytes
    printf("offset of character 6: %d\n", utf8.byteOffset(s, 6));
    printf("reversed: %s\n", utf8.reverse(s));       // reverses characters, not bytes
    return 0;
}
