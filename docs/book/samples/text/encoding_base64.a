// Base64: binary data as text
import encoding;

int main() {
    // the RFC 4648 test vectors: the padding grows as the input shortens
    char* inputs[5] = {"f", "fo", "foo", "foob", "foobar"};
    for (int i = 0; i < 5; i++) {
        printf("%-7s -> %s\n", inputs[i], encoding.base64Encode(inputs[i], strlen(inputs[i])));
    }

    // decoding needs an output buffer of about strlen * 3 / 4 bytes and returns the byte count
    char out[64];
    int n = encoding.base64Decode("SGVsbG8sIEEgbGFuZ3VhZ2Uh", out);
    out[n] = 0;
    printf("decoded %d bytes: %s\n", n, out);

    // binary data works too, because the length is passed explicitly
    char bytes[4] = {0, 255, 16, 128};
    println(encoding.base64Encode(bytes, 4));

    printf("bad input: %d\n", encoding.base64Decode("@@@", out));   // -1 = not base64
    return 0;
}
