// A tiny image from rows of 0 and 1, and its pixels
import codec;

int main() {
    // "1" is a dark pixel
    codec.Image* img = codec.binaryToImage("01110\n10001\n11111\n10001\n10001\n");
    printf("%d x %d\n", img->w, img->h);
    print(codec.imageToBinary(img, 128));            // back to text: pixels below 128 are dark

    printf("pixel(1,0) = %d, pixel(0,0) = %d\n", img->get(1, 0), img->get(0, 0));
    printf("outside the image: %d\n", img->get(99, 99));      // reads as white

    codec.Image* big = img->scaleUp(2);              // every pixel becomes a 2x2 block
    printf("scaled: %d x %d\n", big->w, big->h);
    print(codec.toAscii(big, 1));                    // draw it with characters

    img->invert();
    print(codec.toAscii(img, 1));
    return 0;
}
