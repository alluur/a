// Flags (?i) (?s) (?m) and look-ahead
import regex;

void tryIt(char* label, char* pat, char* text, int flags) {
    regex.Regex* re = regex.compile(pat, flags);
    int caps[66];
    int at = re->search(text, strlen(text), 0, caps);
    if (at < 0) {
        printf("%-30s -> no match\n", label);
        return;
    }
    printf("%-30s -> at %d, \"", label, at);
    for (int i = caps[0]; i < caps[1]; i++) {     // show a newline as \n
        if (text[i] == '\n') { print("\\n"); } else { printChar(text[i]); }
    }
    println("\"");
    re->dispose();
}

int main() {
    tryIt("case matters", "hello", "Say HELLO", 0);
    tryIt("(?i) ignores case", "(?i)hello", "Say HELLO", 0);
    tryIt("F_ICASE does the same", "hello", "Say HELLO", regex.F_ICASE);
    tryIt("(?i:...) for part only", "h(?i:ELLO)", "hello", 0);
    tryIt("... the rest is exact", "h(?i:ELLO)", "Hello", 0);

    tryIt(". stops at a newline", "a.b", "a\nb", 0);
    tryIt("(?s) lets . cross it", "(?s)a.b", "a\nb", 0);
    tryIt("F_DOTALL does too", "a.b", "a\nb", regex.F_DOTALL);

    tryIt("(?m) with $", "(?m)\\d+$", "12 apples\n34\n56 pears", 0);
    tryIt("without (?m)", "\\d+$", "12 apples\n34\n56 pears", 0);

    // look-ahead looks without consuming: a number followed by "px"
    tryIt("(?=px) positive look-ahead", "\\d+(?=px)", "10em 24px 3pt", 0);
    tryIt("(?!px) negative look-ahead", "\\d+(?!\\d|px)", "10px 20em", 0);
    return 0;
}
