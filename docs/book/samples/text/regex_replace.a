// Replacing matches, with and without groups
import regex;

int main() {
    char* text = "Smith, John; Doe, Jane; Roe, Richard";

    // $1 and $2 stand for the groups; ${n} is the same when a digit follows
    println(regex.replaceGroups("(\\w+), (\\w+)", text, "$2 $1"));
    println(regex.replaceGroups("(\\w+), (\\w+)", text, "${2}_$1"));
    println(regex.replaceGroups("(\\w+), (\\w+)", text, "$0 costs $$5"));   // $0 = whole match, $$ = a dollar

    // squeeze runs of blanks
    println(regex.replaceGroups("\\s+", "a   b \t c", " "));

    // an empty match is replaced too, between all characters and at both ends
    println(regex.replaceGroups("x*", "abc", "-"));

    // a group that did not take part is replaced by nothing
    println(regex.replaceGroups("(a)|(b)", "ab", "[$1|$2]"));

    // replaceAll uses the replacement text literally (and the simple dialect, see below)
    println(regex.replaceAll("o", "foo boo", "0"));
    return 0;
}
