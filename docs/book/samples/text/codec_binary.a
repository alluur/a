// Text as binary digits, and back
import codec;

int main() {
    println(codec.textToBinary("Hi!", " "));         // 8 digits per byte, a separator between them
    println(codec.textToBinary("A", ""));
    println(codec.binaryToText("01001000 01101001 00100001"));

    // numbers with a fixed width
    println(codec.intToBinary(37, 8));
    printf("%d\n", codec.binaryToInt("100101"));

    // raw bytes, with any separator
    char data[3] = {255, 0, 170};
    char* bin = codec.bytesToBinary(data, 3, "|");
    println(bin);
    char back[8];
    int n = codec.binaryToBytes(bin, back);
    printf("%d bytes back, last = %d\n", n, back[2]);

    // one byte per bit, as a neural network input wants it, and packed again
    char bits[24];
    codec.bytesToBits(data, 3, bits);
    for (int i = 0; i < 24; i++) { printChar('0' + bits[i]); }
    println("");
    char packed[3];
    printf("packed %d bytes, first = %d\n", codec.bitsToBytes(bits, 24, packed), packed[0]);
    return 0;
}
