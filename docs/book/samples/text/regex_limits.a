// Errors and limits: bad patterns, too many groups, runaway matching
import regex;

int main() {
    // a pattern that does not compile reports why, and where
    char* bad[4] = {"(abc", "a**", "[z-a]", "\\1(a)"};
    for (int i = 0; i < 4; i++) {
        regex.Regex* re = regex.compile(bad[i], 0);
        printf("%-7s ok=%d error=\"%s\" at %d\n", bad[i], re->ok, re->error, re->errorPos);
    }

    // at most 32 capturing groups
    char pat[200];
    char* p = pat;
    for (int i = 0; i < 33; i++) { *p = '('; p++; *p = 'a'; p++; *p = ')'; p++; }
    *p = 0;
    regex.Regex* many = regex.compile(pat, 0);
    printf("33 groups: ok=%d (%s)\n", many->ok, many->error);

    // a classic trap: nested quantifiers backtrack for ever. The engine gives up after 5 million steps.
    regex.Regex* evil = regex.compile("(a+)+b", 0);
    char* aaa = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    int at = evil->search(aaa, strlen(aaa), 0, null);
    printf("(a+)+b on 32 a's: result %d, exceeded=%d\n", at, evil->exceeded);

    // the limit can be changed per pattern
    evil->stepLimit = 1000;
    evil->search("aaaaaaaaaaaa", 12, 0, null);
    printf("with stepLimit 1000: exceeded=%d\n", evil->exceeded);
    return 0;
}
