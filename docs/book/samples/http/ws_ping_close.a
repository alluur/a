// WebSocket ping, pong and the closing handshake
import websocket;
import conn;

websocket.WebSocket* client;
websocket.WebSocket* server;

void connectPair() {
    conn.Listener* l = new conn.Listener(0);
    conn.Connection* c = conn.open("127.0.0.1", l->port(), 1000);
    char key[40];
    websocket.clientSend(c, "localhost", l->port(), "/", key);
    server = websocket.accept(l->accept(1000), null, 0);
    client = websocket.clientFinish(c, key);
}

int main() {
    connectPair();
    char buf[100];
    int op;

    // ping and pong are control frames. receive() answers a ping by itself and hides the pong,
    // so a program only sees them by reading the raw connection
    client->ping();
    client->sendText("after the ping");
    int n = server->receive(buf, 100, &op);                // answers the ping, then returns the message
    printf("server got: %s\n", buf);
    int b0 = client->c->readByte();
    int b1 = client->c->readByte();
    printf("the client's connection holds a frame: %02x %02x (opcode %d, no payload)\n", b0, b1, b0 & 15);

    // closing: the side that wants to stop sends a close frame with a status code
    // 1000 normal, 1001 going away, 1002 protocol error, 4000 to 4999 for your own use
    client->close(4001);
    n = server->receive(buf, 100, &op);
    printf("server: receive returned %d, close code %d, closed: %s\n", n, server->closeCode, server->closed ? "yes" : "no");

    // nothing can be sent on a closed socket
    printf("send after close: %s\n", server->sendText("too late") ? "ok" : "refused");
    return 0;
}
