// book: linux-only
// Who do you trust? The same server, six different clients
import net;
import tls;
import x509;
import cunistd;
import testcert;

int port;

// connects, does the TLS handshake and reports what happened
void attempt(char* label, char* host, bool verify) {
    int fd = net.connect("127.0.0.1", port);
    if (tls.wrap(fd, host, verify)) {
        char buf[32];
        int n = net.recv(fd, buf, 31);
        buf[n] = 0;
        printf("%-34s ok, the server says \"%s\"\n", label, buf);
    } else {
        printf("%-34s refused: %s\n", label, tls.lastError());
    }
    net.close(fd);
}

int main() {
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 8);
    port = net.localPort(listener);
    if (fork() == 0) {
        for (int i = 0; i < 6; i++) {
            int c = net.accept(listener);
            if (tls.wrapServer(c, cfg)) net.sendText(c, "welcome");
            net.close(c);
        }
        _exit(0);
    }
    net.close(listener);

    x509.clearRoots();                                      // no trusted certificates at all
    attempt("no trusted roots:", "localhost", true);
    attempt("verification switched off:", "any name", false);

    x509.addRootPem(testcert.OTHER_CA_PEM);                 // trust somebody else
    attempt("trusting another authority:", "localhost", true);

    x509.addRootPem(testcert.CERT_PEM);                     // now trust the server's own certificate
    attempt("trusted, but the wrong name:", "example.org", true);
    attempt("trusted, right name:", "localhost", true);
    attempt("trusted, the address instead:", "127.0.0.1", true);
    return 0;
}
