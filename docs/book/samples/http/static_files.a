// Serving a directory with http.serveFile
import http;
import net;

int listener;

// one request/response round trip, with the server side inline
void fetch(char* method, char* path) {
    int client = net.connect("127.0.0.1", net.localPort(listener));
    http.sendRequest(client, method, "localhost", path, null, null, 0);
    int c = net.accept(listener);
    http.Request* q = new http.Request();
    http.readRequest(c, q);
    http.serveFile(c, "www", q);                        // the files below "www" are public, nothing else
    net.close(c);
    http.Response* r = http.readResponse(client);
    printf("%-6s %-20s -> %d", method, path, r->status);
    if (r->status == 200) printf(" %s, %d bytes", r->header("Content-Type"), r->bodyLen);
    println("");
    net.close(client);
}

int main() {
    makeDir("www");
    writeFile("www/index.html", "<h1>home</h1>");
    writeFile("www/data.json", "{\"a\":1}");
    writeFile("secret.txt", "outside the web root");

    listener = net.listenOn("127.0.0.1", 0, 8);
    fetch("GET", "/");                                  // a directory gets its index.html
    fetch("GET", "/data.json");
    fetch("HEAD", "/data.json");                        // the headers only
    fetch("GET", "/missing.txt");
    fetch("GET", "/../secret.txt");                     // trying to leave the directory
    fetch("GET", "/%2e%2e/secret.txt");                 // the same, escaped
    fetch("DELETE", "/");                               // only GET and HEAD
    net.close(listener);

    println(http.mimeType("photo.JPG"));
    println(http.mimeType("archive.tar.gz"));
    return 0;
}
