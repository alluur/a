// book: linux-only
// When a request fails: null and http.error()
import http;
import net;
import cunistd;

void tryGet(char* what, char* url) {
    http.Response* r = http.get(url);
    if (r == null) {
        printf("%-28s failed: %s\n", what, http.error());
    } else {
        printf("%-28s status %d\n", what, r->status);
    }
}

int main() {
    // a port with nobody behind it
    int probe = net.listenOn("127.0.0.1", 0, 1);
    int closedPort = net.localPort(probe);
    net.close(probe);

    // a server that is not an HTTP server (it answers with something else), then one that hangs up at once
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    if (fork() == 0) {
        int c = net.accept(listener);
        net.sendText(c, "this is not HTTP\r\n\r\n");
        net.close(c);
        c = net.accept(listener);
        net.close(c);
        _exit(0);
    }
    net.close(listener);

    char url[100];
    tryGet("not a URL", "example.org/x");
    format(url, 100, "http://127.0.0.1:%d/", closedPort);
    tryGet("closed port", url);
    format(url, 100, "http://127.0.0.1:%d/", port);
    tryGet("a server that is not HTTP", url);
    tryGet("a server that hangs up", url);
    return 0;
}
