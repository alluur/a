// book: linux-only
// A WebSocket echo server and client in two processes
import websocket;
import conn;
import cunistd;

// the server process: accept one client, echo every message until it closes
void echoServer(conn.Listener* listener) {
    conn.Connection* c = listener->accept(5000);
    websocket.WebSocket* ws = websocket.accept(c, null, 0);
    if (ws == null) return;
    char buf[1024];
    int op;
    int n;
    while ((n = ws->receive(buf, 1024, &op)) >= 0) {
        if (op == websocket.OP_TEXT) ws->sendText(buf);
        else ws->sendBinary(buf, n);
    }
}

int main() {
    conn.Listener* listener = new conn.Listener(0);
    int port = listener->port();
    int pid = fork();
    if (pid == 0) {
        echoServer(listener);
        _exit(0);
    }
    listener->close();

    char url[100];
    format(url, 100, "ws://127.0.0.1:%d/echo", port);
    websocket.WebSocket* ws = websocket.connect(url);
    if (ws == null) {
        println("handshake failed");
        return 1;
    }

    char buf[1024];
    int op;
    ws->sendText("hello");
    int n = ws->receive(buf, 1024, &op);
    printf("text: %d bytes, opcode %d: %s\n", n, op, buf);

    char data[4];
    data[0] = 1; data[1] = 2; data[2] = 0; data[3] = 255;       // binary data may contain zero bytes
    ws->sendBinary(data, 4);
    n = ws->receive(buf, 1024, &op);
    printf("binary: %d bytes, opcode %d, last byte %d\n", n, op, buf[3]);

    ws->close(1000);                                              // 1000 = normal closure
    int status;
    waitpid(pid, &status, 0);
    printf("server exited with %d\n", (status >> 8) & 255);
    return 0;
}
