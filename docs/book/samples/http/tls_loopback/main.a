// book: linux-only
// TLS over a real socket: tls.wrap and tls.wrapServer
import net;
import tls;
import x509;
import cunistd;
import testcert;

// the server process: accept, do the handshake, then net.recv / net.send are encrypted
void server(int listener, tls.Config* cfg) {
    int c = net.accept(listener);
    if (tls.wrapServer(c, cfg)) {
        char buf[100];
        int n = net.recv(c, buf, 99);
        buf[n] = 0;
        char reply[200];
        format(reply, 200, "TLS server says: you wrote \"%s\"", buf);
        net.sendText(c, reply);
    }
    net.close(c);
}

int main() {
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    int pid = fork();
    if (pid == 0) {
        server(listener, cfg);
        _exit(0);
    }
    net.close(listener);

    x509.addRootPem(testcert.CERT_PEM);                      // trust the test certificate
    int fd = net.connect("127.0.0.1", port);
    if (!tls.wrap(fd, "localhost", true)) {                  // the host name is checked against the certificate
        printf("handshake failed: %s\n", tls.lastError());
        return 1;
    }
    tls.Tls* session = tls.sessionOf(fd);
    printf("cipher suite: %s\n", session->suiteName);
    printf("certificate subject: %s\n", tls.peerName(session));

    net.sendText(fd, "hello over TLS");                      // same net calls, now encrypted
    char buf[200];
    int n = net.recv(fd, buf, 199);
    buf[n] = 0;
    println(buf);
    net.close(fd);                                           // sends close_notify first

    int status;
    waitpid(pid, &status, 0);
    return 0;
}
