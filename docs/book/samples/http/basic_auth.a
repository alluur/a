// book: linux-only
// HTTP Basic authentication
import http;
import net;
import cunistd;
import encoding;

void handler(http.Request* q, int client) {
    char* auth = q->header("Authorization");
    // the header is "Basic " and then user:password in base64
    if (auth != null && startsWith(auth, "Basic ")) {
        char plain[100];
        int n = encoding.base64Decode(&auth[6], plain);
        plain[n] = 0;
        if (streq(plain, "ada:lovelace")) {
            http.respond(client, 200, "text/plain", "welcome, ada");
            return;
        }
    }
    net.sendText(client, "HTTP/1.1 401 Unauthorized\r\nWWW-Authenticate: Basic realm=\"demo\"\r\n"
                         "Content-Length: 0\r\nConnection: close\r\n\r\n");
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        for (int i = 0; i < 3; i++) {
            int c = net.accept(listener);
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) handler(q, c);
            net.close(c);
        }
        _exit(0);
    }
    net.close(listener);

    char url[100];
    format(url, 100, "http://127.0.0.1:%d/secret", port);
    http.Response* r = http.get(url);
    printf("without credentials: %d, %s\n", r->status, r->header("WWW-Authenticate"));

    // http.basicAuth returns the complete header line, ending in \r\n: ready for the extra headers of http.request
    char* header = http.basicAuth("ada", "lovelace");
    char shown[100];
    strcpy(shown, header);
    shown[strlen(shown) - 2] = 0;                        // cut off the \r\n for printing
    printf("header line: %s\n", shown);
    r = http.request("GET", url, header, null, 0);
    printf("right password: %d %s\n", r->status, r->body);
    r = http.request("GET", url, http.basicAuth("ada", "wrong"), null, 0);
    printf("wrong password: %d\n", r->status);
    return 0;
}
