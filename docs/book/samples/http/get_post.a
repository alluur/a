// book: linux-only
// An HTTP client and an HTTP server, each in its own process
import http;
import net;
import cunistd;

// the handler gets the parsed request and answers with http.respond
void handler(http.Request* q, int client) {
    char body[300];
    format(body, 300, "%s %s (%d body bytes: %s)", &q->method[0], &q->path[0], q->bodyLen, q->body);
    http.respond(client, 200, "text/plain", body);
}

// what http.serve does, but on a listening socket that we made, so that we know its port
void serve(int listener, int count) {
    for (int i = 0; i < count; i++) {
        int c = net.accept(listener);
        http.Request* q = new http.Request();
        if (http.readRequest(c, q)) handler(q, c);
        net.close(c);
    }
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    int pid = fork();
    if (pid == 0) {
        serve(listener, 3);
        _exit(0);
    }
    net.close(listener);

    char url[100];
    format(url, 100, "http://127.0.0.1:%d/hello", port);

    http.Response* r = http.get(url);
    printf("GET:  %d %s\n", r->status, r->body);
    r = http.post(url, "{\"id\":1}", "application/json");
    printf("POST: %d %s\n", r->status, r->body);
    r = http.request("PUT", url, "X-Version: 2\r\n", "new text", 8);
    printf("PUT:  %d %s\n", r->status, r->body);
    printf("Content-Type of the last answer: %s\n", r->header("Content-Type"));

    int status;
    waitpid(pid, &status, 0);
    return 0;
}
