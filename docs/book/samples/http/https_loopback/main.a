// book: linux-only
// http.get and http.post over https, against an HTTPS server in a child process
import http;
import net;
import tls;
import x509;
import cunistd;
import testcert;

void handler(http.Request* q, int client) {
    char body[200];
    format(body, 200, "secure %s %s", &q->method[0], &q->path[0]);
    http.respond(client, 200, "text/plain", body);
}

// what http.serveTls does for each connection: TLS handshake first, then the usual HTTP
void serve(int listener, tls.Config* cfg, int count) {
    for (int i = 0; i < count; i++) {
        int c = net.accept(listener);
        if (tls.wrapServer(c, cfg)) {
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) handler(q, c);
        }
        net.close(c);
    }
}

int main() {
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        serve(listener, cfg, 3);
        _exit(0);
    }
    net.close(listener);

    char url[100];
    format(url, 100, "https://localhost:%d/page", port);

    // without trust the request fails and says why
    x509.clearRoots();
    http.Response* r = http.get(url);
    printf("untrusted: %s\n", r == null ? http.error() : "an answer");

    // trust the server's certificate: https:// URLs work like http:// ones
    x509.addRootPem(testcert.CERT_PEM);
    r = http.get(url);
    printf("GET:  %d %s\n", r->status, r->body);
    r = http.post(url, "x=1", "text/plain");
    printf("POST: %d %s\n", r->status, r->body);
    return 0;
}
