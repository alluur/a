// What HTTP looks like on the wire
import http;
import net;

// prints a block of text with visible line ends
void dump(char* label, char* text) {
    printf("--- %s\n", label);
    for (int i = 0; text[i] != 0; i++) {
        if (text[i] == 13) print("\\r");
        else if (text[i] == 10) println("\\n");
        else printChar(text[i]);
    }
    int n = strlen(text);
    if (n > 0 && text[n - 1] != 10) println("");
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int client = net.connect("127.0.0.1", net.localPort(listener));
    int server = net.accept(listener);

    // the client half of http.get / http.post: a request line, headers, an empty line, an optional body
    http.sendRequest(client, "POST", "example.test", "/items?id=7", "X-Demo: yes\r\n", "name=Ada", 8);

    // read what arrived with plain net calls, so that we see every byte
    char raw[400];
    int n = net.recv(server, raw, 399);
    raw[n] = 0;
    dump("request as received by the server", raw);

    // a response is a status line, headers, an empty line and the body; Content-Length says how long it is
    http.respond(server, 201, "text/plain", "created");
    net.shutdown(server, 1);
    http.Response* r = http.readResponse(client);
    printf("status %d, %d body bytes: %s\n", r->status, r->bodyLen, r->body);
    dump("headers of the response", r->headers);

    net.close(client);
    net.close(server);
    net.close(listener);
    return 0;
}
