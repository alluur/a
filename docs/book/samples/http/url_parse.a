// Taking a URL apart with http.parseUrl
import http;
import encoding;

void show(char* url) {
    http.Url* u = new http.Url();
    if (!http.parseUrl(url, u)) {
        printf("%-38s -> not an http(s) URL\n", url);
        return;
    }
    printf("%-38s -> %s host=%s port=%d path=%s\n", url, u->scheme, u->host, u->port, u->path);
}

int main() {
    show("http://example.org/index.html");
    show("https://example.org");                       // no path: "/"
    show("http://localhost:8080/api/items?id=7&x=1");   // the query stays in the path
    show("HTTP://Example.ORG:81");
    show("ftp://example.org/file");
    show("example.org/index.html");
    show("http:///nohost");

    // the characters of a query value that mean something else must be escaped
    char* escaped = encoding.urlEncode("Ada & Bob = 100%");
    println(escaped);
    println(encoding.urlDecode(escaped));
    println(encoding.urlDecode("a+b%20c"));
    return 0;
}
