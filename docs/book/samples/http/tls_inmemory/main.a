// A TLS 1.3 handshake without a network: the client and server state machines side by side
import tls;
import x509;
import testcert;

// moves whatever one side wants to send into the other, until both are quiet
void pump(tls.Tls* a, tls.Tls* b) {
    for (int round = 0; round < 50; round++) {
        bool moved = false;
        if (tls.outLength(a) > 0) {
            tls.feed(b, tls.outData(a), tls.outLength(a));
            tls.outConsumed(a, tls.outLength(a));
            moved = true;
        }
        if (tls.outLength(b) > 0) {
            tls.feed(a, tls.outData(b), tls.outLength(b));
            tls.outConsumed(b, tls.outLength(b));
            moved = true;
        }
        if (!moved) return;
    }
}

int main() {
    x509.addRootPem(testcert.CERT_PEM);                          // the client trusts our test certificate
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);

    tls.Tls* client = tls.client("localhost", true);             // true: check the certificate
    tls.Tls* server = tls.accept(cfg);
    printf("before the handshake: client ready %d\n", tls.ready(client));
    pump(client, server);                                        // ClientHello ... Finished, in both directions
    printf("after: client ready %d, server ready %d\n", tls.ready(client), tls.ready(server));
    printf("cipher suite: %s\n", client->suiteName);
    printf("the server's certificate is for: %s\n", tls.peerName(client));

    // application data is encrypted by write() and decrypted by readApp()
    tls.write(client, "hello server", 12);
    printf("bytes the client wants to put on the wire: %d\n", tls.outLength(client));
    pump(client, server);
    char buf[100];
    int n = tls.readApp(server, buf, 99);
    buf[n] = 0;
    printf("server read: %s\n", buf);

    tls.write(server, "hello client", 12);
    pump(client, server);
    n = tls.readApp(client, buf, 99);
    buf[n] = 0;
    printf("client read: %s\n", buf);

    // close_notify: the polite goodbye that tells a truncated stream from a finished one
    tls.shutdown(client);
    pump(client, server);
    printf("server saw the goodbye: %s\n", tls.closed(server) ? "yes" : "no");
    return 0;
}
