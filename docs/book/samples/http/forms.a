// book: linux-only
// Query strings and form posts
import http;
import net;
import cunistd;
import encoding;

void handler(http.Request* q, int client) {
    // a form post carries "a=1&b=2" in the body; queryValue reads q->query, so put the body there
    // (q->query holds 1024 bytes, so a body that is longer must not be copied)
    if (streq(&q->method[0], "POST") && q->bodyLen < 1000) {
        strcpy(&q->query[0], q->body);
    }
    char city[64];
    char name[64];
    bool haveName = http.queryValue(q, "name", name, 64);
    bool haveCity = http.queryValue(q, "city", city, 64);
    char reply[200];
    format(reply, 200, "%s: name=%s city=%s", &q->method[0], haveName ? name : "-", haveCity ? city : "-");
    http.respond(client, 200, "text/plain", reply);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        for (int i = 0; i < 3; i++) {
            int c = net.accept(listener);
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) handler(q, c);
            net.close(c);
        }
        _exit(0);
    }
    net.close(listener);

    char base[100];
    format(base, 100, "http://127.0.0.1:%d/who", port);

    // values in a URL must be escaped; the server gets them decoded
    char url[300];
    format(url, 300, "%s?name=%s&city=%s", base, encoding.urlEncode("Ada Lovelace"), encoding.urlEncode("Zurich & Bern"));
    println(url + strlen(base));
    println(http.get(url)->body);

    // postForm sends application/x-www-form-urlencoded
    println(http.postForm(base, "name=Alan+Turing&city=Wilmslow")->body);

    // parameters that are not there are simply false
    format(url, 300, "%s?city=Oslo", base);
    println(http.get(url)->body);
    return 0;
}
