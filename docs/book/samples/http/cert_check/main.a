// Looking at a certificate and checking it for a host name and a date
import x509;
import testcert;

void verdict(char* label, x509.Cert** chain, char* host, int when) {
    char* problem = x509.verifyChain(chain, 1, host, when);
    printf("%-30s %s\n", label, problem == null ? "accepted" : problem);
}

int main() {
    x509.Cert* chain[1];
    int count = x509.parsePem(testcert.CERT_PEM, chain, 1);
    x509.Cert* c = chain[0];
    printf("%d certificate, subject %s, self-issued: %s\n", count, c->cn, x509.isSelfIssued(c) ? "yes" : "no");
    for (int i = 0; i < c->sanCount; i++) {
        printf("alternative name: %s%s\n", c->san[i], c->sanIp[i] ? " (an IP address)" : "");
    }
    printf("public key: %s\n", c->keyKind == 2 ? "EC" : "RSA");

    // does the certificate fit the name you typed? a certificate lists the names it is good for
    printf("localhost: %d, 127.0.0.1: %d, LOCALHOST: %d, example.org: %d\n", x509.matchesHost(c, "localhost"),
           x509.matchesHost(c, "127.0.0.1"), x509.matchesHost(c, "LOCALHOST"), x509.matchesHost(c, "example.org"));

    // a chain is accepted when it fits the name, is valid on the date, and ends in a trusted root
    int y2024 = 1704067200;                             // 2024-01-01 in Unix seconds
    x509.clearRoots();
    verdict("nobody is trusted:", chain, "localhost", y2024);
    x509.addRootPem(testcert.CERT_PEM);                 // a self-signed certificate that we choose to trust
    verdict("trusted, right name:", chain, "localhost", y2024);
    verdict("wrong name:", chain, "example.org", y2024);
    verdict("one year before its start:", chain, "localhost", 1546300800);   // 2019-01-01
    verdict("after it expired:", chain, "localhost", 4200000000);           // the year 2103
    return 0;
}
