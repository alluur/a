// book: linux-only
// Compressed responses: the client unpacks them for you
import http;
import net;
import cunistd;

void handler(http.Request* q, int client) {
    // a text that compresses well: 100 repetitions of one sentence
    char* text = alloc(5000);
    for (int i = 0; i < 100; i++) strcat(text, "The quick brown fox jumps over the lazy dog. ");
    int n = strlen(text);
    char* accept = q->header("Accept-Encoding");
    if (accept != null && contains(accept, "gzip")) {
        http.respondGzip(client, 200, "text/plain", text, n);
    } else {
        http.respondBytes(client, 200, "text/plain", text, n);
    }
}

void show(char* label, http.Response* r) {
    char* encoding = r->header("Content-Encoding");
    printf("%s: %d bytes on the wire (%s), %d bytes of text\n", label, atoi(r->header("Content-Length")),
           encoding == null ? "plain" : encoding, r->bodyLen);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        for (int i = 0; i < 2; i++) {
            int c = net.accept(listener);
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) handler(q, c);
            net.close(c);
        }
        _exit(0);
    }
    net.close(listener);

    char url[100];
    format(url, 100, "http://127.0.0.1:%d/", port);
    show("without asking", http.get(url));

    http.setCompression(true);                           // adds Accept-Encoding: gzip, deflate to every request
    http.Response* r = http.get(url);
    show("asking for gzip", r);
    printf("the first sentence: %.44s\n", r->body);
    return 0;
}
