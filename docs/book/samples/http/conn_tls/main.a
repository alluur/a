// book: linux-only
// One piece of code for plain and for TLS connections: conn.Connection
import conn;
import net;
import tls;
import x509;
import cunistd;
import testcert;

// the protocol: one question, one answer. This code neither knows nor cares whether the bytes are encrypted
void serveLine(conn.Connection* c) {
    char line[100];
    if (c->readLine(line, 100) >= 0) {
        strUpper(line);
        c->writeLine(line);
        c->flush();
    }
}

void askLine(conn.Connection* c, char* question) {
    c->writeLine(question);
    c->flush();
    char answer[100];
    c->readLine(answer, 100);
    printf("asked \"%s\", the answer is \"%s\"\n", question, answer);
    c->close();
}

int main() {
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    if (fork() == 0) {
        // first client: plain. second client: TLS handshake first, then the very same function
        serveLine(new conn.Connection(net.accept(listener)));
        int fd = net.accept(listener);
        if (tls.wrapServer(fd, cfg)) serveLine(new conn.Connection(fd));
        _exit(0);
    }
    net.close(listener);

    askLine(new conn.Connection(net.connect("127.0.0.1", port)), "hello in the clear");

    x509.addRootPem(testcert.CERT_PEM);
    int fd = net.connect("127.0.0.1", port);
    if (tls.wrap(fd, "localhost", true)) {
        askLine(new conn.Connection(fd), "hello over TLS");
    }
    return 0;
}
