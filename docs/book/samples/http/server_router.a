// book: linux-only
// A server that routes by method and path and answers with status codes
import http;
import net;
import cunistd;

int count = 0;                                         // how many items were created (lives in the server process)

void handler(http.Request* q, int client) {
    char* path = &q->path[0];
    char* method = &q->method[0];
    if (streq(path, "/hello")) {
        char name[64];
        if (http.queryValue(q, "name", name, 64)) {
            char text[128];
            format(text, 128, "hello, %s!", name);
            http.respond(client, 200, "text/plain", text);
        } else {
            http.respond(client, 400, "text/plain", "missing ?name=");
        }
    } else if (streq(path, "/items")) {
        if (streq(method, "POST")) {
            count++;
            http.respond(client, 201, "text/plain", "created");
        } else if (streq(method, "GET")) {
            char text[64];
            format(text, 64, "%d items", count);
            http.respond(client, 200, "text/plain", text);
        } else {
            http.respond(client, 405, "text/plain", "use GET or POST");
        }
    } else {
        http.respond(client, 404, "text/plain", "no such page");
    }
}

void serve(int listener, int n) {
    for (int i = 0; i < n; i++) {
        int c = net.accept(listener);
        http.Request* q = new http.Request();
        if (http.readRequest(c, q)) handler(q, c); else http.respond(c, 400, "text/plain", "bad request");
        net.close(c);
    }
}

void show(int port, char* method, char* path, char* body) {
    char url[200];
    format(url, 200, "http://127.0.0.1:%d%s", port, path);
    http.Response* r = http.request(method, url, null, body, body == null ? 0 : strlen(body));
    if (r == null) {
        printf("%s %s failed: %s\n", method, path, http.error());
        return;
    }
    printf("%-6s %-22s -> %d %s: %s\n", method, path, r->status, http.statusText(r->status), r->body);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        serve(listener, 8);
        _exit(0);
    }
    net.close(listener);

    show(port, "GET", "/hello?name=Ada%20Lovelace", null);   // %20 is decoded by queryValue
    show(port, "GET", "/hello", null);
    show(port, "GET", "/items", null);
    show(port, "POST", "/items", "{}");
    show(port, "POST", "/items", "{}");
    show(port, "GET", "/items", null);
    show(port, "DELETE", "/items", null);
    show(port, "GET", "/missing", null);
    return 0;
}
