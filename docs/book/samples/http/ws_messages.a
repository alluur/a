// WebSocket messages: text, binary, large and fragmented
import websocket;
import conn;

websocket.WebSocket* client;
websocket.WebSocket* server;
conn.Connection* rawClient;

// a connected pair in one process (the handshake halves need no second thread)
void connectPair() {
    conn.Listener* l = new conn.Listener(0);
    rawClient = conn.open("127.0.0.1", l->port(), 1000);
    char key[40];
    websocket.clientSend(rawClient, "localhost", l->port(), "/", key);
    server = websocket.accept(l->accept(1000), null, 0);
    client = websocket.clientFinish(rawClient, key);
}

int main() {
    connectPair();
    char buf[200];
    int op;

    // a message is text (opcode 1, should be UTF-8) or binary (opcode 2); the opcode tells which one arrived
    client->sendText("hello server");
    int n = server->receive(buf, 200, &op);
    printf("server: %d bytes, opcode %d, \"%s\"\n", n, op, buf);
    char data[3];
    data[0] = 0; data[1] = 0xFF; data[2] = 0;
    server->sendBinary(data, 3);
    n = client->receive(buf, 200, &op);
    printf("client: %d bytes, opcode %d\n", n, op);

    // a big message is split into frames by the length field, not by you: 70000 bytes in one call
    char* big = alloc(70000);
    for (int i = 0; i < 70000; i++) big[i] = 'a' + i % 26;
    char* in = alloc(70100);
    client->sendBinary(big, 70000);
    n = server->receive(in, 70100, &op);
    printf("big message: %d bytes, identical: %s\n", n, memcmp(in, big, 70000) == 0 ? "yes" : "no");

    // a message longer than your buffer is cut, not overflowed
    client->sendText("this text is longer than the buffer");
    n = server->receive(buf, 10, &op);
    printf("buffer of 10: %d bytes\n", n);

    // fragmentation: one text message in two frames (FIN bit clear on the first); receive joins them
    char f1[40];
    char f2[40];
    int l1 = websocket.buildFrame(websocket.OP_TEXT, false, true, 0x01020304, "frag", 4, f1);
    int l2 = websocket.buildFrame(websocket.OP_CONT, true, true, 0x05060708, "ment", 4, f2);
    rawClient->write(f1, l1);
    rawClient->write(f2, l2);
    rawClient->flush();
    n = server->receive(buf, 200, &op);
    printf("two frames became %d bytes: %s\n", n, buf);
    return 0;
}
