// Three ways an HTTP response says where its body ends
import http;
import net;

// plays the server for one response: sends the bytes we choose, then closes
http.Response* answer(int listener, char* raw) {
    int client = net.connect("127.0.0.1", net.localPort(listener));
    int server = net.accept(listener);
    net.sendText(server, raw);
    net.close(server);
    http.Response* r = http.readResponse(client);
    net.close(client);
    return r;
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);

    // 1. Content-Length: exactly that many bytes follow
    http.Response* r = answer(listener, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello, this part is ignored");
    printf("Content-Length: %d bytes: %s\n", r->bodyLen, r->body);

    // 2. chunked: pieces of "hex size, CRLF, data, CRLF", ended by a chunk of size 0
    r = answer(listener, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
                         "5\r\nhello\r\n"
                         "7\r\n, world\r\n"
                         "0\r\n\r\n");
    printf("chunked: %d bytes: %s\n", r->bodyLen, r->body);

    // 3. neither: the body is everything until the server closes the connection (HTTP/1.0 style)
    r = answer(listener, "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nbody until close");
    printf("until close: %d bytes: %s\n", r->bodyLen, r->body);

    // no body at all
    r = answer(listener, "HTTP/1.1 204 No Content\r\n\r\n");
    printf("204: status %d, %d body bytes\n", r->status, r->bodyLen);
    net.close(listener);
    return 0;
}
