// WebSocket frames, byte by byte (the examples of RFC 6455)
import websocket;

void bytes(char* data, int n) {
    for (int i = 0; i < n; i++) printf("%02x ", data[i]);
    println("");
}

int main() {
    // a text frame: FIN + opcode 1, length 5, the payload
    char out[400];
    int n = websocket.buildFrame(websocket.OP_TEXT, true, false, 0, "Hello", 5, out);
    printf("unmasked, %d bytes: ", n);
    bytes(out, n);

    // frames from a client must be masked: a 4 byte key, and the payload xor-ed with it
    n = websocket.buildFrame(websocket.OP_TEXT, true, true, 0x37fa213d, "Hello", 5, out);
    printf("masked,   %d bytes: ", n);
    bytes(out, n);

    // parseHeader returns the header length (0: need more bytes, -1: not valid)
    websocket.Frame* f = new websocket.Frame();
    printf("parseHeader with only 3 bytes: %d\n", websocket.parseHeader(out, 3, f));
    int hl = websocket.parseHeader(out, n, f);
    printf("header %d bytes, opcode %d, final %d, masked %d, payload %d bytes\n", hl, f->opcode, f->fin, f->masked, f->length);
    websocket.unmask(&out[f->headerLen], f->length, f->maskKey);      // the same call masks and unmasks
    out[f->headerLen + f->length] = 0;
    printf("payload: %s\n", &out[f->headerLen]);

    // the length field grows with the payload: 7 bits, then 16 bits, then 64 bits
    char* big = alloc(70000);
    char* frame = alloc(70100);
    int sizes[3];
    sizes[0] = 125; sizes[1] = 126; sizes[2] = 70000;
    for (int i = 0; i < 3; i++) {
        n = websocket.buildFrame(websocket.OP_BINARY, true, false, 0, big, sizes[i], frame);
        websocket.parseHeader(frame, n, f);
        printf("payload %5d bytes: header %2d bytes, frame %5d bytes\n", sizes[i], f->headerLen, n);
    }

    // the three reserved bits must be zero
    char bad[2];
    bad[0] = 0xF1; bad[1] = 0;
    printf("reserved bits set: %d\n", websocket.parseHeader(bad, 2, f));
    return 0;
}
