// book: linux-only
// A secure WebSocket (wss) by hand: conn.Connection works the same on a plain or a TLS socket
import websocket;
import conn;
import net;
import tls;
import x509;
import cunistd;
import testcert;

// the server process: TLS handshake, then the WebSocket handshake on the same connection, then echo
void server(int listener, tls.Config* cfg) {
    int fd = net.accept(listener);
    if (!tls.wrapServer(fd, cfg)) return;
    websocket.WebSocket* ws = websocket.accept(new conn.Connection(fd), null, 0);
    if (ws == null) return;
    char buf[200];
    int op;
    while (ws->receive(buf, 200, &op) >= 0) {
        ws->sendText(buf);
    }
}

int main() {
    tls.Config* cfg = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    int listener = net.listenOn("127.0.0.1", 0, 4);
    int port = net.localPort(listener);
    if (fork() == 0) {
        server(listener, cfg);
        _exit(0);
    }
    net.close(listener);

    x509.addRootPem(testcert.CERT_PEM);
    int fd = net.connect("127.0.0.1", port);
    if (!tls.wrap(fd, "localhost", true)) {
        printf("TLS failed: %s\n", tls.lastError());
        return 1;
    }
    // websocket.connect only knows ws://; the two halves of the handshake take any connection
    conn.Connection* c = new conn.Connection(fd);
    char key[40];
    websocket.clientSend(c, "localhost", port, "/secure", key);
    websocket.WebSocket* ws = websocket.clientFinish(c, key);
    if (ws == null) {
        println("WebSocket handshake failed");
        return 1;
    }
    char buf[200];
    int op;
    ws->sendText("hello through TLS and WebSocket");
    int n = ws->receive(buf, 200, &op);
    printf("echo: %s\n", buf);
    ws->close(1000);
    return 0;
}
