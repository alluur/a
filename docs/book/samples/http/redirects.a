// book: linux-only
// http.get follows redirects (up to five)
import http;
import net;
import cunistd;

void redirect(int client, char* location) {
    char head[300];
    format(head, 300, "HTTP/1.1 302 Found\r\nLocation: %s\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", location);
    net.sendText(client, head);
}

void handler(http.Request* q, int client) {
    char* path = &q->path[0];
    if (streq(path, "/old")) redirect(client, "/new");                // a path on the same server
    else if (streq(path, "/new")) http.respond(client, 200, "text/plain", "you reached /new");
    else redirect(client, "/loop");                                   // /loop redirects to itself
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 16);
    int port = net.localPort(listener);
    if (fork() == 0) {
        for (int i = 0; i < 9; i++) {
            int c = net.accept(listener);
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) handler(q, c);
            net.close(c);
        }
        _exit(0);
    }
    net.close(listener);

    char url[100];
    format(url, 100, "http://127.0.0.1:%d/old", port);
    http.Response* r = http.get(url);
    printf("GET /old: %d %s\n", r->status, r->body);

    // request() does not follow anything: you see the redirect itself
    r = http.request("GET", url, null, null, 0);
    printf("request /old: %d, Location: %s\n", r->status, r->header("Location"));

    // a redirect that never ends is stopped after the sixth request
    format(url, 100, "http://127.0.0.1:%d/loop", port);
    r = http.get(url);
    printf("GET /loop: %s\n", r == null ? http.error() : "an answer");
    return 0;
}
