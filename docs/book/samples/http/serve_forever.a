// book: compile-only
// A web server that keeps running: http.serve on a fixed port (stop it with Ctrl+C)
import http;

void handler(http.Request* q, int client) {
    if (streq(&q->path[0], "/hello")) {
        char name[64];
        if (!http.queryValue(q, "name", name, 64)) strcpy(name, "stranger");
        char body[160];
        format(body, 160, "<h1>Hello, %s!</h1>", name);
        http.respond(client, 200, "text/html", body);
    } else {
        http.respond(client, 404, "text/plain", "not found");
    }
}

int main() {
    println("try http://localhost:8080/hello?name=World");
    // one request at a time, forever (count 0); it returns at once if the port is taken.
    // The port is fixed: http.serve has no way to tell you a port picked by the system.
    http.serve(8080, handler, 0);
    println("could not listen on port 8080");

    // or serve the files of a directory:  http.serveStatic(8080, "www", 0);
    return 1;
}
