// book: compile-only
// Fetching an https:// page (needs the Internet and the system's trusted certificates)
import http;

int main() {
    // TLS 1.3 with certificate and host name checks is automatic for https:// URLs
    http.Response* r = http.get("https://example.org/");
    if (r == null) {
        // e.g. "the certificate has expired" or "the certificate is for a different host name"
        printf("failed: %s\n", http.error());
        return 1;
    }
    printf("%d %s, %d bytes\n", r->status, r->header("Content-Type"), r->bodyLen);

    // for a server with a self-signed certificate you can turn the check off (do that only for servers you know)
    http.setVerify(false);
    r = http.get("https://192.168.1.10:8443/");
    if (r != null) println(r->body);
    return 0;
}
