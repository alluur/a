// book: linux-only
// Request and response headers
import http;
import net;
import cunistd;

void handler(http.Request* q, int client) {
    // header names are not case sensitive; header() returns a copy, or null when the header is missing
    char* agent = q->header("user-agent");
    char* token = q->header("X-Token");
    char* absent = q->header("X-Nothing");
    char body[200];
    format(body, 200, "agent=%s token=%s absent=%s", agent, token, absent == null ? "(none)" : absent);

    // respond() always sends Content-Type, Content-Length, Connection and Server; for more headers write the response yourself
    char head[300];
    format(head, 300, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\n"
                      "X-Served-By: demo\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n", strlen(body));
    net.sendText(client, head);
    net.sendText(client, body);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 8);
    int port = net.localPort(listener);
    if (fork() == 0) {
        int c = net.accept(listener);
        http.Request* q = new http.Request();
        if (http.readRequest(c, q)) handler(q, c);
        net.close(c);
        _exit(0);
    }
    net.close(listener);

    // the extra headers of http.request are raw text: one line per header, each ending in \r\n
    char url[100];
    format(url, 100, "http://127.0.0.1:%d/", port);
    http.Response* r = http.request("GET", url, "X-Token: s3cret\r\nAccept: text/plain\r\n", null, 0);
    println(r->body);
    println(r->header("x-served-by"));                  // any capitalisation works
    println(r->header("CACHE-CONTROL"));
    printf("no such header: %s\n", r->header("ETag") == null ? "null" : "found");

    // the raw header block is available too, for http.headerOf or for your own parsing
    char value[100];
    http.headerOf(r->headers, "Content-Length", value, 100);
    printf("Content-Length: %s, body bytes: %d\n", value, r->bodyLen);
    return 0;
}
