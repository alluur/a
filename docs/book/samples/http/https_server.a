// book: compile-only
// An HTTPS server: the certificate and key come from PEM files   (see examples/httpsd.a for the full program)
import http;
import tls;

void handler(http.Request* q, int client) {
    http.respond(client, 200, "text/plain", "hello over TLS");
}

int main() {
    char* cert = readFile("cert.pem");           // the server's certificate first, then any intermediates
    char* key = readFile("key.pem");             // RSA, or EC P-256 / P-384
    if (cert == null || key == null) {
        println("need cert.pem and key.pem");
        return 1;
    }
    tls.Config* cfg = tls.loadConfig(cert, key);
    if (cfg == null) {
        printf("bad certificate or key: %s\n", tls.lastError());
        return 1;
    }
    http.serveTls(8443, cfg, handler, 0);       // test with: curl --cacert cert.pem https://localhost:8443/
    return 0;
}
