// The WebSocket handshake: an HTTP upgrade request
import websocket;
import conn;

int main() {
    // the key in the RFC: the server proves that it understood the request by hashing the key with a fixed GUID
    println(websocket.acceptKey("dGhlIHNhbXBsZSBub25jZQ=="));

    conn.Listener* listener = new conn.Listener(0);
    int port = listener->port();
    conn.Connection* c = conn.open("127.0.0.1", port, 1000);
    conn.Connection* s = listener->accept(1000);

    // client, first half: GET with Upgrade: websocket and a random Sec-WebSocket-Key
    char key[40];
    websocket.clientSend(c, "localhost", port, "/chat", key);

    // server: reads the request, checks it and answers "101 Switching Protocols"
    char path[64];
    websocket.WebSocket* server = websocket.accept(s, path, 64);
    printf("server accepted: %s, path %s\n", server != null ? "yes" : "no", path);

    // client, second half: checks Sec-WebSocket-Accept
    websocket.WebSocket* client = websocket.clientFinish(c, key);
    printf("client finished: %s\n", client != null ? "yes" : "no");

    client->sendText("hello server");
    char buf[100];
    int op;
    int n = server->receive(buf, 100, &op);
    printf("server received %d bytes, opcode %d: %s\n", n, op, buf);
    client->close(1000);
    server->close(1000);
    listener->close();

    // a plain HTTP request is refused with "400 Bad Request"
    conn.Listener* l2 = new conn.Listener(0);
    conn.Connection* browser = conn.open("127.0.0.1", l2->port(), 1000);
    browser->writeLine("GET / HTTP/1.1");
    browser->writeLine("Host: localhost");
    browser->writeLine("");
    browser->flush();
    printf("accept of a plain request: %s\n", websocket.accept(l2->accept(1000), null, 0) == null ? "null" : "a WebSocket");
    char line[80];
    browser->readLine(line, 80);
    println(line);
    return 0;
}
