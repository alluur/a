// A password hash in the format of /etc/shadow ($6$, SHA-512 crypt)
import syscrypt;

void check(char* what, bool ok) {
    printf("%-26s %s\n", what, ok ? "accepted" : "rejected");
}

int main() {
    // the test vector of Ulrich Drepper's specification of SHA-crypt
    char* h = syscrypt.sha512crypt("Hello world!", "$6$saltstring");
    println(h);

    // the hash is "$6$" + salt + "$" + 86 characters; $6$ is the id of the method
    printlnInt(strlen(h));

    // verify takes the stored hash as the setting: it reads the salt out of it
    check("right password", syscrypt.verify("Hello world!", h));
    check("wrong password", syscrypt.verify("Hello world", h));

    // a hash made by openssl passwd -6 or mkpasswd works too
    char* fromShadow = "$6$abcdefgh$ltjgWl6579NluT/Vi1nwEvcil.G5Nbc4NiXZaNGStk8PSwGfQv72N2CKPPrVACtLtip/cZ/1GM/O6IND4WQhG.";
    check("hash from openssl", syscrypt.verify("secret", fromShadow));
    return 0;
}
