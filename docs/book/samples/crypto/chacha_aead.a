// ChaCha20-Poly1305 with the test vector of RFC 8439
import chacha;
import secure;

int main() {
    // RFC 8439 section 2.8.2
    char key[32]; char nonce[12]; char aad[12];
    for (int i = 0; i < 32; i++) key[i] = 0x80 + i;          // 80 81 ... 9f
    secure.fromHex("070000004041424344454647", nonce, 12);
    secure.fromHex("50515253c0c1c2c3c4c5c6c7", aad, 12);

    char* text = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    int n = strlen(text);                                    // 114 bytes

    char sealed[140];
    chacha.seal(key, nonce, aad, 12, text, n, sealed);       // n bytes of cipher text, then the 16 byte tag
    println(secure.toHex(sealed, 32));                       // the start of the cipher text
    println(secure.toHex(sealed + n, 16));                   // the tag
    printBool(streq(secure.toHex(sealed + n, 16), "1ae10b594f09e26a7e902ecbd0600691"));
    println(" : the tag matches RFC 8439");

    char back[140];
    bool ok = chacha.open(key, nonce, aad, 12, sealed, n + 16, back);
    back[n] = 0;
    printf("opened: %s\n", ok ? "yes" : "no");
    println(back);
    return 0;
}
