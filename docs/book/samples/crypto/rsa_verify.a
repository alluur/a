// Verifying RSA signatures (PKCS#1 v1.5 and PSS)
import rsa;
import hash;
import secure;

// a throw-away 2048 bit public key (modulus and exponent as hex); the signatures were made with the private half
char* N =
    "95012e3d3d47ffb080f6e0fb7d381abf97be9948b0aff717db603565d241f332"
      "3c3647d11ca6f458a9af8063bd285e861a886b336965f64ae16b447b96c9e946"
      "1502ebeccc8354af3ed76e6a623321d8f7255a09ec3a2a3bfa741fc0fd19fa00"
      "01ef350dc390696a643a9756289756610215dff5f4456d555447a55588a402fe"
      "791b4c6ebd4f2970ba0c3316129e4e746abe22ade1d61759f96db2ce80c5f6cd"
      "511f1eed4aef02f1808fc0a8e69e9e5bba6e96beeb7e271b9015b2ece5b56ed5"
      "2c2b7dfae0dc985ecf9d3abe16093f950cb97ce0309dcb5a73597a98d367a633"
      "44482bd72eabd26bd71bfc71479006f5b10cfd9fb4ade1ff5669f121801b60b3";
char* SIG_PKCS1 =
    "24ab83b5f69113677597ed2a08452a87fa3ec7c22695103baf3e7469ba6d1441"
      "81fdbe5d845c2ebf38ce37647e6d9b10904ea53e1082e3db25cd15c8d0fe394a"
      "2e4ca5b2dc9b9518e1bbfc78037790ebac18d68ab0475c4fda49141e94880cf5"
      "6c4f0fa3f150e632701c0b509982c03361d4467d9d1dd439e3bd814570ed94e8"
      "d43d2461be9e081d7d45748b27b098be46a694d94cbc8b8bb4fe4849e0cbf7f9"
      "29179df46ce7d3199bc86e62129f023ebc939acbce2ebfa6585068bcc0eec64d"
      "2d80d92bf24f86e7ac836a67d03cf7f2ffe21f92f8b0e6a333f18c338dca4a8c"
      "2a7144071515cf7c1cabb51e90d97bc6650686bf6290f52c1ab78e37a954d557";
char* SIG_PSS =
    "1dd9531d4890d38456b6476d0770bfbb71a8cfeb9dc8fd857247990b911a590d"
      "e0a18fee83f75924134e80d503ab06c31f4c9ce7f7275843b2bcf7c484bf1ea8"
      "92e12ff25aa356355a1ffe9b653ecfc431b86a5514151210cd15fdcf5fb60efa"
      "bf235bbe76f3841546231a244d0bbb7d940d9a40547c632356fd0c569d7d29c7"
      "9e257a106a428889a41c1206459b1bb0fe8231638da8b4d10472958f7e68e5ee"
      "4578b3d754b2c6cd1efaf59774f9cef29719a2ca8e26c198d2b3c7df47c859f0"
      "ecf3c8a725a6eafd591a8c835e14317a64c45a9ccc88227b0b00dea7e0ab9d2a"
      "e9cfd93f9dbc1ceac7e9b609d7de1f58707bc4e20622524b9e8ae1cb256a143d";

void show(char* what, bool ok) {
    printf("%-40s %s\n", what, ok ? "valid" : "rejected");
}

int main() {
    char n[256]; char e[3]; char sig[256]; char digest[32];
    secure.fromHex(N, n, 256);
    secure.fromHex("010001", e, 3);                      // 65537, the usual public exponent

    // what is signed is the hash of the message, not the message
    char* message = "The A Programming Language";
    hash.sha256Raw(message, strlen(message), digest);

    secure.fromHex(SIG_PKCS1, sig, 256);
    show("PKCS#1 v1.5 signature", rsa.verifyPkcs1(n, 256, e, 3, 256, digest, sig, 256));   // 256 = SHA-256

    secure.fromHex(SIG_PSS, sig, 256);
    show("PSS signature", rsa.verifyPss(n, 256, e, 3, 256, digest, sig, 256));

    // a PSS signature is not a PKCS#1 signature, and a changed message does not verify
    show("PSS signature read as PKCS#1", rsa.verifyPkcs1(n, 256, e, 3, 256, digest, sig, 256));
    char* other = "The A Programming Language!";
    hash.sha256Raw(other, strlen(other), digest);
    show("PSS signature, another message", rsa.verifyPss(n, 256, e, 3, 256, digest, sig, 256));
    return 0;
}
