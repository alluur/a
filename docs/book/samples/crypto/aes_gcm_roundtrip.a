// Encrypting a message, and what happens when it is changed
import aes;
import secure;

int main() {
    char key[32];
    char iv[12];
    secure.bytes(key, 32);                          // a fresh random key and nonce
    secure.bytes(iv, 12);
    aes.Gcm* g = aes.gcm(key, 32);

    char* message = "Meet me at the old bridge at noon.";
    int n = strlen(message);
    char* header = "msg-id=42";                     // sent in the clear, but protected from changes
    char sealed[100];
    aes.seal(g, iv, header, strlen(header), message, n, sealed);
    printf("plain %d bytes, sealed %d bytes\n", n, n + 16);

    char back[100];
    if (aes.open(g, iv, header, strlen(header), sealed, n + 16, back)) {
        back[n] = 0;
        println(back);
    }

    sealed[3] = sealed[3] ^ 1;                      // an attacker flips one bit of the cipher text
    printBool(aes.open(g, iv, header, strlen(header), sealed, n + 16, back));
    println(" : open after the cipher text was changed");
    sealed[3] = sealed[3] ^ 1;

    printBool(aes.open(g, iv, "msg-id=43", 9, sealed, n + 16, back));
    println(" : open with another header");
    printBool(aes.open(g, iv, header, strlen(header), sealed, n + 15, back));
    println(" : open with a truncated message");
    return 0;
}
