// DES on single blocks (legacy: 56 bit keys can be searched)
import des;
import secure;

int main() {
    char key[8]; char block[8]; char out[8]; char back[8];
    secure.fromHex("133457799bbcdff1", key, 8);          // the key of the classic worked example
    secure.fromHex("0123456789abcdef", block, 8);

    des.encryptBlock(key, block, out);                   // always exactly 8 bytes in, 8 bytes out
    println(secure.toHex(out, 8));                       // 85e813540f0ab405
    des.decryptBlock(key, out, back);
    println(secure.toHex(back, 8));

    // every 8th bit of a DES key is a parity bit and is ignored: flip them all and nothing changes
    char key2[8];
    for (int i = 0; i < 8; i++) key2[i] = key[i] ^ 1;
    char out2[8];
    des.encryptBlock(key2, block, out2);
    printf("other parity bits, same result: %s\n", streq(secure.toHex(out, 8), secure.toHex(out2, 8)) ? "yes" : "no");

    // the same plain text block always gives the same cipher text block (ECB): patterns show through
    char twice[16];
    for (int i = 0; i < 8; i++) { twice[i] = block[i]; twice[8 + i] = block[i]; }
    char both[16];
    des.encryptBlock(key, twice, both);
    des.encryptBlock(key, twice + 8, both + 8);
    printf("equal blocks give equal cipher blocks: %s\n", streq(secure.toHex(both, 8), secure.toHex(both + 8, 8)) ? "yes" : "no");
    return 0;
}
