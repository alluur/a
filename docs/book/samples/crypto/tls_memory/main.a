// A TLS 1.3 handshake between two sessions in one program
import tls;
import x509;
import pki;

// A TLS session does no input or output itself. Whatever it wants to send is in its output buffer;
// this function is "the network": it carries the bytes both ways until nothing moves any more.
void pump(tls.Tls* a, tls.Tls* b) {
    char* wire = alloc(70000);
    bool moved = true;
    while (moved) {
        moved = false;
        int n = tls.outLength(a);
        if (n > 0) {
            memcpy(wire, tls.outData(a), n);
            tls.outConsumed(a, n);
            tls.feed(b, wire, n);
            moved = true;
        }
        n = tls.outLength(b);
        if (n > 0) {
            memcpy(wire, tls.outData(b), n);
            tls.outConsumed(b, n);
            tls.feed(a, wire, n);
            moved = true;
        }
    }
}

int main() {
    x509.clearRoots();
    x509.addRootPem(pki.ROOT);                          // the client trusts the book's test root
    tls.Config* cfg = tls.loadConfig(pki.LEAF, pki.KEY);   // the server's certificate and private key

    tls.Tls* client = tls.clientOnly("www.example.test", true, 0x1303);   // offer ChaCha20-Poly1305 only
    tls.Tls* server = tls.accept(cfg);
    pump(client, server);                               // the whole handshake

    printf("client ready: %s, server ready: %s\n", tls.ready(client) ? "yes" : "no", tls.ready(server) ? "yes" : "no");
    printf("cipher suite: %s\n", client->suiteName);
    printf("server certificate: %s\n", client->leaf->cn);

    tls.write(client, "hello server\n", 13);           // application data, encrypted
    pump(client, server);
    char buf[100];
    int n = tls.readApp(server, buf, 99);
    buf[n] = 0;
    printf("server received %d bytes: %s", n, buf);

    tls.write(server, "hello over TLS\n", 15);
    pump(client, server);
    n = tls.readApp(client, buf, 99);
    buf[n] = 0;
    printf("client received: %s", buf);

    tls.shutdown(client);                               // close_notify: a clean goodbye
    pump(client, server);
    printf("server saw the goodbye: %s\n", tls.closed(server) ? "yes" : "no");
    return 0;
}
