// Hex text: toHex and fromHex
import secure;

int main() {
    char data[4];
    data[0] = 0xde; data[1] = 0xad; data[2] = 0xbe; data[3] = 0xef;
    println(secure.toHex(data, 4));                       // lower case, two characters per byte

    char back[8];
    int n = secure.fromHex("DEADBEEF00ff", back, 8);       // upper and lower case are both fine
    printf("%d bytes: %s\n", n, secure.toHex(back, n));

    printlnInt(secure.fromHex("abc", back, 8));            // odd length: -1
    printlnInt(secure.fromHex("xyz1", back, 8));           // not hex: -1
    printlnInt(secure.fromHex("00112233445566778899", back, 8));   // would not fit: -1
    printlnInt(secure.fromHex("", back, 8));               // nothing is fine: 0 bytes
    printlnInt(secure.fromHex("0a0b\n", back, 8));         // a trailing newline is ignored
    return 0;
}
