// A message channel: the nonce is a counter, so it never repeats and replays are noticed
import chacha;
import secure;

// the nonce is 4 zero bytes and an 8 byte message counter
void nonceFor(int counter, char* nonce) {
    for (int i = 0; i < 4; i++) nonce[i] = 0;
    for (int i = 0; i < 8; i++) nonce[4 + i] = (counter >> (56 - 8 * i)) & 255;
}

int sendCounter;                                   // what the sender uses next
int expectCounter;                                 // what the receiver expects next

void send(char* key, char* text, char* wire) {
    char nonce[12];
    nonceFor(sendCounter, nonce);
    sendCounter++;
    chacha.seal(key, nonce, "chat", 4, text, strlen(text), wire);
}

bool receive(char* key, char* wire, int n, char* out) {
    char nonce[12];
    nonceFor(expectCounter, nonce);
    bool ok = chacha.open(key, nonce, "chat", 4, wire, n + 16, out);
    if (ok) {
        out[n] = 0;
        expectCounter++;                           // only a good message moves the counter on
    }
    return ok;
}

int main() {
    char key[32];
    secure.bytes(key, 32);
    char w1[64]; char w2[64]; char w3[64]; char out[64];

    send(key, "first", w1);
    send(key, "second", w2);
    send(key, "third", w3);

    printf("first:  %s\n", receive(key, w1, 5, out) ? out : "rejected");
    printf("replay of the first: %s\n", receive(key, w1, 5, out) ? out : "rejected");
    printf("third before the second: %s\n", receive(key, w3, 5, out) ? out : "rejected");
    printf("second: %s\n", receive(key, w2, 6, out) ? out : "rejected");
    printf("third:  %s\n", receive(key, w3, 5, out) ? out : "rejected");
    return 0;
}
