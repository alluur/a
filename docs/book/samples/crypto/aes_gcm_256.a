// AES-256-GCM: the same call with a 32 byte key
import aes;
import secure;
import cstring;                                    // memcmp

int main() {
    char key[32]; char iv[12]; char aad[20]; char plain[60];
    // test case 16 of the GCM specification
    secure.fromHex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", key, 32);
    secure.fromHex("cafebabefacedbaddecaf888", iv, 12);
    secure.fromHex("feedfacedeadbeeffeedfacedeadbeefabaddad2", aad, 20);
    secure.fromHex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72"
                   "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39", plain, 60);

    aes.Gcm* g = aes.gcm(key, 32);                  // 16 or 32 bytes: AES-128 or AES-256
    char out[80];
    aes.seal(g, iv, aad, 20, plain, 60, out);
    println(secure.toHex(out + 60, 16));
    printBool(streq(secure.toHex(out + 60, 16), "76fc6ece0f4e1768cddf8853bb2d551b"));
    println(" : the tag matches the published one");

    // open() checks the tag first and only then decrypts
    char decoded[60];
    printBool(aes.open(g, iv, aad, 20, out, 76, decoded));
    println(" : and it decrypts again");
    printBool(memcmp(decoded, plain, 60) == 0);
    println(" : to the original text");
    return 0;
}
