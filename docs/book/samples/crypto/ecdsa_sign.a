// Signing with ECDSA P-256: a DER signature, a new one every time
import ec;
import hash;
import secure;

// ec.sign returns SEQUENCE { INTEGER r, INTEGER s }; ec.verify wants r and s separately
// (a leading zero byte in an INTEGER is fine)
bool verifyDer(char* pub, char* digest, char* der) {
    int rlen = der[3] & 255;
    char* r = &der[4];
    int slen = der[5 + rlen] & 255;
    char* s = &der[6 + rlen];
    return ec.verify(256, pub, 65, digest, 32, r, rlen, s, slen);
}

void show(char* what, bool ok) {
    printf("%-38s %s\n", what, ok ? "valid" : "rejected");
}

int main() {
    // key pair from RFC 6979 (a published test key: never use it for anything real)
    char priv[32]; char pub[65]; char digest[32];
    secure.fromHex("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721", priv, 32);
    secure.fromHex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6"
                   "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299", pub, 65);

    hash.sha256Raw("sign this", 9, digest);
    char sig1[80]; char sig2[80];
    int n1 = ec.sign(256, priv, digest, 32, sig1);        // returns the length of the DER signature
    int n2 = ec.sign(256, priv, digest, 32, sig2);
    printf("signature lengths: %s\n", (n1 >= 8 && n1 <= 72 && n2 >= 8 && n2 <= 72) ? "between 8 and 72 bytes" : "unexpected");
    printf("starts with the SEQUENCE tag 0x30: %s\n", sig1[0] == 0x30 ? "yes" : "no");

    show("first signature", verifyDer(pub, digest, sig1));
    show("second signature", verifyDer(pub, digest, sig2));
    bool same = n1 == n2 && streq(secure.toHex(sig1, n1), secure.toHex(sig2, n2));
    printf("the two signatures are identical: %s\n", same ? "yes" : "no");   // every signature uses a random nonce

    hash.sha256Raw("sign that", 9, digest);
    show("first signature, another message", verifyDer(pub, digest, sig1));
    return 0;
}
