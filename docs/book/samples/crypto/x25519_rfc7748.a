// X25519 key agreement with the test vector of RFC 7748
import x25519;
import secure;

int main() {
    char alicePriv[32]; char bobPriv[32];
    secure.fromHex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", alicePriv, 32);
    secure.fromHex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb", bobPriv, 32);

    char alicePub[32]; char bobPub[32];
    x25519.base(alicePub, alicePriv);                    // public key = private key times the base point
    x25519.base(bobPub, bobPriv);
    printf("Alice public: %s\n", secure.toHex(alicePub, 32));
    printf("Bob public:   %s\n", secure.toHex(bobPub, 32));

    char s1[32]; char s2[32];
    x25519.scalarmult(s1, alicePriv, bobPub);            // Alice: her private key with Bob's public key
    x25519.scalarmult(s2, bobPriv, alicePub);            // Bob: the other way round
    printf("shared:       %s\n", secure.toHex(s1, 32));
    printBool(streq(secure.toHex(s1, 32), secure.toHex(s2, 32)));
    println(" : both sides computed the same secret");
    printBool(streq(secure.toHex(s1, 32), "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"));
    println(" : and it is the one in the RFC");
    return 0;
}
