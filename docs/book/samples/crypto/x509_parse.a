// Reading a certificate
import x509;
import ctime;

// a test certificate for www.example.test, made for this book (valid from 2024 to 2100)
char* LEAF =
    "-----BEGIN CERTIFICATE-----\n"
    "MIIBhDCCASmgAwIBAgICB9EwCgYIKoZIzj0EAwIwLzEUMBIGA1UECgwLQSBCb29r\n"
    "IFRlc3QxFzAVBgNVBAMMDkJvb2sgVGVzdCBSb290MCAXDTI0MDEwMTAwMDAwMFoY\n"
    "DzIxMDAwMTAxMDAwMDAwWjAbMRkwFwYDVQQDDBB3d3cuZXhhbXBsZS50ZXN0MFkw\n"
    "EwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEjMHYgRItb+UCCAG38DaHn7D40gjBrmzR\n"
    "cfi1Q86mgHtd+ye0E9hMeaBvFaOma147/115GePOgMCKGUnoyl9uoaNHMEUwDAYD\n"
    "VR0TAQH/BAIwADA1BgNVHREELjAsghB3d3cuZXhhbXBsZS50ZXN0ghIqLmNkbi5l\n"
    "eGFtcGxlLnRlc3SHBMAAAgcwCgYIKoZIzj0EAwIDSQAwRgIhAIaPgWHCnfKyYx8p\n"
    "TBiUf9a6Llrj0q5Hc/nwN1Qe/888AiEA0neBS0BxB30NpVzR7GdqS6wCDJjxbJM4\n"
    "EOflCVzPtRw=\n"
    "-----END CERTIFICATE-----\n";

// seconds since 1970 as a date
char* day(int t) {
    char* buf = alloc(16);
    strftime(buf, 16, "%Y-%m-%d", gmtime(&t));
    return buf;
}

int main() {
    x509.Cert* list[2];
    int n = x509.parsePem(LEAF, list, 2);               // every CERTIFICATE block of a PEM text
    x509.Cert* c = list[0];                             // (x509.parse takes the DER bytes instead)
    printf("certificates found: %d\n", n);
    printf("common name:  %s\n", c->cn);
    printf("valid from:   %s\n", day(c->notBefore));
    printf("valid until:  %s\n", day(c->notAfter));
    printf("public key:   %s\n", c->keyKind == 2 ? "elliptic curve" : "RSA");
    printf("curve:        P-%d\n", c->curve);
    printf("signed with:  %s, SHA-%d\n", c->sigKind == 3 ? "ECDSA" : "RSA", c->sigHash);
    printf("is a CA:      %s\n", c->isCA ? "yes" : "no");
    for (int i = 0; i < c->sanCount; i++) {             // subject alternative names
        printf("alt name %d:   %s%s\n", i + 1, c->san[i], c->sanIp[i] ? " (IP address)" : "");
    }
    printf("self issued:  %s\n", x509.isSelfIssued(c) ? "yes" : "no");
    return 0;
}
