// What a TLS client refuses: wrong host name, unknown authority
import tls;
import x509;
import pki;

void pump(tls.Tls* a, tls.Tls* b) {
    char* wire = alloc(70000);
    bool moved = true;
    while (moved) {
        moved = false;
        int n = tls.outLength(a);
        if (n > 0) { memcpy(wire, tls.outData(a), n); tls.outConsumed(a, n); tls.feed(b, wire, n); moved = true; }
        n = tls.outLength(b);
        if (n > 0) { memcpy(wire, tls.outData(b), n); tls.outConsumed(b, n); tls.feed(a, wire, n); moved = true; }
    }
}

// one connection attempt; says how it ended from the client's point of view
void connect(char* title, char* trustedRoot, char* host, bool verify) {
    x509.clearRoots();
    if (trustedRoot != null) x509.addRootPem(trustedRoot);
    tls.Tls* client = tls.client(host, verify);
    tls.Tls* server = tls.accept(tls.loadConfig(pki.LEAF, pki.KEY));
    pump(client, server);
    printf("%s\n    ", title);
    if (tls.ready(client)) println("connected");
    else printf("refused: %s\n", client->error);
}

int main() {
    connect("trusted root, right name", pki.ROOT, "www.example.test", true);
    connect("trusted root, wrong name", pki.ROOT, "mail.example.test", true);
    connect("another root is trusted", pki.OTHER_ROOT, "www.example.test", true);
    connect("no root is trusted", null, "www.example.test", true);
    connect("verification switched off", null, "anything.at.all", false);   // encrypted, but with whom?
    return 0;
}
