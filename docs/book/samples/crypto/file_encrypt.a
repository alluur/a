// Encrypting a file: nonce, cipher text and tag in one file
import aes;
import secure;
import os;

// file layout: 12 bytes nonce | cipher text | 16 bytes tag
void encryptFile(aes.Gcm* g, char* path, char* text) {
    int n = strlen(text);
    char* file = alloc(12 + n + 16);
    secure.bytes(file, 12);                                  // a new random nonce for every file
    aes.seal(g, file, "v1", 2, text, n, file + 12);          // "v1" is authenticated but not encrypted
    int h = fileOpen(path, FILE_WRITE);
    fileWrite(h, file, 12 + n + 16);
    fileClose(h);
}

// returns the text, or null when the file was changed or the key is wrong
char* decryptFile(aes.Gcm* g, char* path) {
    char* file = alloc(100000);
    int h = fileOpen(path, FILE_READ);
    int total = fileRead(h, file, 100000);
    fileClose(h);
    char* plain = alloc(total);
    if (!aes.open(g, file, "v1", 2, file + 12, total - 12, plain)) return null;
    plain[total - 28] = 0;
    return plain;
}

int main() {
    char key[32];
    secure.bytes(key, 32);
    aes.Gcm* g = aes.gcm(key, 32);

    char* secret = "the safe combination is 4-8-15-16-23-42";
    encryptFile(g, "notes.enc", secret);
    printf("size on disk: %d bytes (the text has %d)\n", os.fileSize("notes.enc"), strlen(secret));
    char* back = decryptFile(g, "notes.enc");
    printf("decrypted: %s\n", back);

    // damage one byte in the middle of the file, like a failing disk or a malicious editor would
    int h = fileOpen("notes.enc", FILE_READ);
    char* data = alloc(200);
    int n = fileRead(h, data, 200);
    fileClose(h);
    data[20] = data[20] ^ 0x40;
    h = fileOpen("notes.enc", FILE_WRITE);
    fileWrite(h, data, n);
    fileClose(h);
    printf("after the damage: %s\n", decryptFile(g, "notes.enc") == null ? "refused" : "accepted");

    // another key cannot read it either
    secure.bytes(key, 32);
    printf("with another key: %s\n", decryptFile(aes.gcm(key, 32), "notes.enc") == null ? "refused" : "accepted");
    return 0;
}
