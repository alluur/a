// Verifying an ECDSA P-256 signature (test vector of RFC 6979)
import ec;
import hash;
import secure;

void show(char* what, bool ok) {
    printf("%-34s %s\n", what, ok ? "valid" : "rejected");
}

int main() {
    // the public key as an uncompressed point: 04 || X || Y
    char pub[65]; char r[32]; char s[32]; char digest[32];
    secure.fromHex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6"
                   "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299", pub, 65);
    secure.fromHex("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", r, 32);
    secure.fromHex("f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8", s, 32);

    // the signature belongs to the SHA-256 hash of "sample"
    hash.sha256Raw("sample", 6, digest);
    show("signature of \"sample\"", ec.verify(256, pub, 65, digest, 32, r, 32, s, 32));

    hash.sha256Raw("sample!", 7, digest);                  // another message
    show("the same signature, other message", ec.verify(256, pub, 65, digest, 32, r, 32, s, 32));

    hash.sha256Raw("sample", 6, digest);
    s[31] = s[31] ^ 1;                                     // a damaged signature
    show("damaged s", ec.verify(256, pub, 65, digest, 32, r, 32, s, 32));
    s[31] = s[31] ^ 1;

    pub[64] = pub[64] ^ 1;                                 // a point that is not on the curve
    show("a public key off the curve", ec.verify(256, pub, 65, digest, 32, r, 32, s, 32));
    return 0;
}
