// ECDSA on P-384 with SHA-384 (test vector of RFC 6979)
import ec;
import hash;
import secure;

void show(char* what, bool ok) {
    printf("%-34s %s\n", what, ok ? "valid" : "rejected");
}

int main() {
    char pub[97]; char r[48]; char s[48]; char digest[48];
    secure.fromHex("04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13"
                   "8015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720", pub, 97);
    secure.fromHex("94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46", r, 48);
    secure.fromHex("99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8", s, 48);

    // the curve is the first argument: 256 or 384. The hash is chosen by the signer; here SHA-384
    int n = hash.digest(384, "sample", 6, digest);         // hash.digest(bits, ...) returns the digest size
    printf("digest of %d bytes\n", n);
    show("P-384 signature", ec.verify(384, pub, 97, digest, 48, r, 48, s, 48));

    // a point of the wrong size for the curve is refused
    show("the same data checked as P-256", ec.verify(256, pub, 97, digest, 48, r, 48, s, 48));
    return 0;
}
