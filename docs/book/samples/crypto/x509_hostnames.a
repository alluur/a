// Which host names does a certificate cover?
import x509;

char* LEAF =
    "-----BEGIN CERTIFICATE-----\n"
    "MIIBhDCCASmgAwIBAgICB9EwCgYIKoZIzj0EAwIwLzEUMBIGA1UECgwLQSBCb29r\n"
    "IFRlc3QxFzAVBgNVBAMMDkJvb2sgVGVzdCBSb290MCAXDTI0MDEwMTAwMDAwMFoY\n"
    "DzIxMDAwMTAxMDAwMDAwWjAbMRkwFwYDVQQDDBB3d3cuZXhhbXBsZS50ZXN0MFkw\n"
    "EwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEjMHYgRItb+UCCAG38DaHn7D40gjBrmzR\n"
    "cfi1Q86mgHtd+ye0E9hMeaBvFaOma147/115GePOgMCKGUnoyl9uoaNHMEUwDAYD\n"
    "VR0TAQH/BAIwADA1BgNVHREELjAsghB3d3cuZXhhbXBsZS50ZXN0ghIqLmNkbi5l\n"
    "eGFtcGxlLnRlc3SHBMAAAgcwCgYIKoZIzj0EAwIDSQAwRgIhAIaPgWHCnfKyYx8p\n"
    "TBiUf9a6Llrj0q5Hc/nwN1Qe/888AiEA0neBS0BxB30NpVzR7GdqS6wCDJjxbJM4\n"
    "EOflCVzPtRw=\n"
    "-----END CERTIFICATE-----\n";

void try(x509.Cert* c, char* host) {
    printf("%-24s %s\n", host, x509.matchesHost(c, host) ? "matches" : "does not match");
}

int main() {
    x509.Cert* list[1];
    x509.parsePem(LEAF, list, 1);
    x509.Cert* c = list[0];             // alternative names: www.example.test, *.cdn.example.test, 192.0.2.7

    try(c, "www.example.test");
    try(c, "WWW.Example.TEST");         // host names are not case sensitive
    try(c, "example.test");             // not listed
    try(c, "static.cdn.example.test");  // the wildcard covers exactly one label
    try(c, "a.b.cdn.example.test");     // two labels: no
    try(c, "cdn.example.test");         // the wildcard needs a label: no
    try(c, "192.0.2.7");                // an IP address must be listed as an IP address
    try(c, "192.0.2.8");
    return 0;
}
