// Storing and checking passwords: a random salt per user, a slow hash
import syscrypt;
import secure;

// 16 random salt characters from the alphabet that crypt hashes use
char* newSalt() {
    char* alphabet = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    char raw[16];
    secure.bytes(raw, 16);
    char* setting = alloc(32);
    strcpy(setting, "$6$");
    for (int i = 0; i < 16; i++) setting[3 + i] = alphabet[(raw[i] & 255) % 64];
    return setting;
}

// what goes into the user database: salt and hash in one string
char* enroll(char* password) {
    return syscrypt.sha512crypt(password, newSalt());
}

bool login(char* password, char* stored) {
    return syscrypt.verify(password, stored);
}

int main() {
    char* annsHash = enroll("correct horse battery staple");
    char* bobsHash = enroll("correct horse battery staple");     // the same password

    printf("stored hash starts with: %s\n", substr(annsHash, 0, 3));
    printf("length: %d\n", strlen(annsHash));                      // $6$ + 16 salt + $ + 86
    printf("Ann and Bob have equal hashes: %s\n", streq(annsHash, bobsHash) ? "yes" : "no");   // the salts differ

    printf("Ann logs in with the right password: %s\n", login("correct horse battery staple", annsHash) ? "yes" : "no");
    printf("Ann logs in with a wrong password:   %s\n", login("password123", annsHash) ? "yes" : "no");
    printf("Bob's hash accepts Ann's password:   %s\n", login("correct horse battery staple", bobsHash) ? "yes" : "no");
    return 0;
}
