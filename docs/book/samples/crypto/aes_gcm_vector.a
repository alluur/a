// AES-128-GCM against a published test vector
import aes;
import secure;

int main() {
    // test case 4 of "The Galois/Counter Mode of Operation (GCM)" by McGrew and Viega
    char key[16]; char iv[12]; char aad[20]; char plain[60];
    secure.fromHex("feffe9928665731c6d6a8f9467308308", key, 16);
    secure.fromHex("cafebabefacedbaddecaf888", iv, 12);
    secure.fromHex("feedfacedeadbeeffeedfacedeadbeefabaddad2", aad, 20);
    secure.fromHex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72"
                   "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39", plain, 60);

    aes.Gcm* g = aes.gcm(key, 16);                  // the key schedule is done once; 16 bytes = AES-128
    char out[80];                                   // cipher text (60 bytes) followed by the tag (16 bytes)
    aes.seal(g, iv, aad, 20, plain, 60, out);

    println(secure.toHex(out, 60));                 // cipher text
    println(secure.toHex(out + 60, 16));            // authentication tag
    printBool(streq(secure.toHex(out + 60, 16), "5bc94fbc3221a5db94fae95ae7121a47"));
    println(" : the tag matches the published one");
    return 0;
}
