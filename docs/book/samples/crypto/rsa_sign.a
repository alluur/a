// Signing with RSA-PSS and checking the signature
import rsa;
import hash;
import secure;

// a throw-away 2048 bit key pair: never put a real private key into source code
char* N =
    "95012e3d3d47ffb080f6e0fb7d381abf97be9948b0aff717db603565d241f332"
      "3c3647d11ca6f458a9af8063bd285e861a886b336965f64ae16b447b96c9e946"
      "1502ebeccc8354af3ed76e6a623321d8f7255a09ec3a2a3bfa741fc0fd19fa00"
      "01ef350dc390696a643a9756289756610215dff5f4456d555447a55588a402fe"
      "791b4c6ebd4f2970ba0c3316129e4e746abe22ade1d61759f96db2ce80c5f6cd"
      "511f1eed4aef02f1808fc0a8e69e9e5bba6e96beeb7e271b9015b2ece5b56ed5"
      "2c2b7dfae0dc985ecf9d3abe16093f950cb97ce0309dcb5a73597a98d367a633"
      "44482bd72eabd26bd71bfc71479006f5b10cfd9fb4ade1ff5669f121801b60b3";
char* D =
    "0273bb0591f919d9973db8d51aa9ee32c1f60682be399f18dae8d9e81b8e2f48"
      "dfd9cad3c3a371b8f5cde8107c1fea724d847a3325e46229b84cf21b108fb111"
      "90adf420f8fa9e4da5fc989a1294a1d576b7bc2416a99c61514d50ea759fd44f"
      "e4b84188c0f3a2f077c6c90fc76a3a272d881b9fea0dac6f6f8c2049e88e3e68"
      "583a2eee310311786ab57a6e17e257d571cdc9e2846bfaac4d7318543d974e2b"
      "1ee8d26c8f588a91bdc514400eebec4a15677e489fb48076322901dc20598f01"
      "7134be1392b7c17220157a9709e25b344f230e2c55d88e9533630a404b980b09"
      "6b64a83723b0c517e27323ce92a7ade624e9b88ccbb4517920abfee92c19e701";

void show(char* what, bool ok) {
    printf("%-40s %s\n", what, ok ? "valid" : "rejected");
}

int main() {
    char n[256]; char d[256]; char e[3]; char digest[32];
    secure.fromHex(N, n, 256);
    secure.fromHex(D, d, 256);                           // the private exponent
    secure.fromHex("010001", e, 3);

    char* message = "pay 10 euros to Ann";
    hash.sha256Raw(message, strlen(message), digest);

    char sig1[256]; char sig2[256];
    printBool(rsa.signPss(n, 256, d, 256, 256, digest, sig1));   // sign the digest; the signature is as long as n
    println(" : signed");
    rsa.signPss(n, 256, d, 256, 256, digest, sig2);
    show("signature checks with the public key", rsa.verifyPss(n, 256, e, 3, 256, digest, sig1, 256));
    printf("two signatures are equal: %s\n", streq(secure.toHex(sig1, 256), secure.toHex(sig2, 256)) ? "yes" : "no");   // random salt
    show("the second one checks as well", rsa.verifyPss(n, 256, e, 3, 256, digest, sig2, 256));

    sig1[100] = sig1[100] ^ 1;                            // one bit of the signature flipped
    show("a damaged signature", rsa.verifyPss(n, 256, e, 3, 256, digest, sig1, 256));
    return 0;
}
