// The plain ChaCha20 stream cipher (no authentication)
import chacha;
import secure;

int main() {
    // RFC 8439 section 2.4.2: block counter 1
    char key[32]; char nonce[12];
    for (int i = 0; i < 32; i++) key[i] = i;
    secure.fromHex("000000000000004a00000000", nonce, 12);

    char* text = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
    int n = strlen(text);
    char cipher[140];
    chacha.xorStream(key, nonce, 1, text, n, cipher);        // in and out may also be the same buffer
    println(secure.toHex(cipher, 24));

    // the same call decrypts: XOR with the same key stream twice gives the text back
    char plain[140];
    chacha.xorStream(key, nonce, 1, cipher, n, plain);
    plain[n] = 0;
    println(plain);

    // nothing detects a change: a stream cipher alone gives secrecy, not integrity
    cipher[0] = cipher[0] ^ 0x01;
    chacha.xorStream(key, nonce, 1, cipher, n, plain);
    plain[n] = 0;
    println(plain);                                          // 'L' became 'M', and nobody complains
    return 0;
}
