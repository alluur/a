// Two AEADs with the same shape: AES-GCM and ChaCha20-Poly1305
import aes;
import chacha;
import secure;

int main() {
    char key[32];
    char nonce[12];
    secure.bytes(key, 32);
    secure.bytes(nonce, 12);
    char* aad = "version=1";
    char* text = "same message, two ciphers";
    int n = strlen(text);

    char a[80]; char c[80];
    aes.Gcm* g = aes.gcm(key, 32);
    aes.seal(g, nonce, aad, 9, text, n, a);
    chacha.seal(key, nonce, aad, 9, text, n, c);
    printf("both give %d + 16 bytes\n", n);
    printf("same cipher text: %s\n", streq(secure.toHex(a, n), secure.toHex(c, n)) ? "yes" : "no");

    char back[80];
    printf("AES-GCM opens its own message: %s\n", aes.open(g, nonce, aad, 9, a, n + 16, back) ? "yes" : "no");
    printf("ChaCha20-Poly1305 opens the AES-GCM message: %s\n", chacha.open(key, nonce, aad, 9, a, n + 16, back) ? "yes" : "no");
    printf("ChaCha20-Poly1305 opens its own message: %s\n", chacha.open(key, nonce, aad, 9, c, n + 16, back) ? "yes" : "no");
    return 0;
}
