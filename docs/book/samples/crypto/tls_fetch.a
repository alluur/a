// Fetching a page over HTTPS with the blocking TLS stream
// book: compile-only
import tls;

int main() {
    // resolves the name, connects, does the handshake and checks the certificate against the system roots
    tls.Stream* s = tls.connect("example.com", 443, true);
    if (s == null) {
        println(tls.lastError());                    // why it failed: DNS, refused, bad certificate ...
        return 1;
    }
    char* request = "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n";
    tls.sendAll(s, request, strlen(request));
    char buf[512];
    int n = tls.recv(s, buf, 511);                   // decrypted bytes, 0 when the server has closed
    buf[n] = 0;
    println(buf);
    tls.close(s);
    return 0;
}
