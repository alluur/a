// More rounds make a guess more expensive; other formats are refused
import syscrypt;

void check(char* what, bool ok) {
    printf("%-30s %s\n", what, ok ? "accepted" : "rejected");
}

int main() {
    // the default is 5000 rounds; "rounds=N$" asks for another count (1000 to 999999999)
    char* h = syscrypt.sha512crypt("Hello world!", "$6$rounds=10000$saltstringsaltstring");
    println(h);                                  // the salt was cut to 16 characters; the rounds are part of the hash
    check("rounds read from the hash", syscrypt.verify("Hello world!", h));

    // salts of different lengths; the salt ends at the next $
    println(syscrypt.sha512crypt("pw", "$6$ab"));
    println(syscrypt.sha512crypt("pw", "$6$ab$ignored after the dollar"));

    // only $6$ is supported
    printf("$5$ (SHA-256 crypt) gives null: %s\n", syscrypt.sha512crypt("pw", "$5$salt") == null ? "yes" : "no");
    check("$1$ (MD5 crypt)", syscrypt.verify("pw", "$1$salt$whatever"));
    check("plain text", syscrypt.verify("pw", "plain text"));
    return 0;
}
