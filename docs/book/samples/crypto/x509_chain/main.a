// Checking a certificate chain against trusted roots
import x509;
import pki;

// verifyChain returns null for "trusted", or a sentence that says what is wrong
void verify(char* title, char* rootPem, char* host, int now) {
    x509.clearRoots();                              // forget the roots; this also stops the system roots from loading
    x509.addRootPem(rootPem);                       // trust exactly this one
    x509.Cert* chain[1];
    x509.parsePem(pki.LEAF, chain, 1);
    char* why = x509.verifyChain(chain, 1, host, now);   // now: seconds since 1970, given by the caller
    printf("%-28s %s\n", title, why == null ? "trusted" : why);
}

int main() {
    int today = 1790000000;                         // 2026-09-21, fixed so that the output does not change
    verify("good", pki.ROOT, "www.example.test", today);
    verify("wrong host name", pki.ROOT, "mail.example.test", today);
    verify("unknown authority", pki.OTHER_ROOT, "www.example.test", today);
    verify("not valid yet (year 2000)", pki.ROOT, "www.example.test", 946684800);
    verify("expired (year 2110)", pki.ROOT, "www.example.test", 4417977600);

    x509.clearRoots();                              // and now with an empty trust store
    x509.Cert* chain[1];
    x509.parsePem(pki.LEAF, chain, 1);
    printf("%-28s %s\n", "no trusted roots", x509.verifyChain(chain, 1, "www.example.test", today));
    printf("trusted roots: %d\n", x509.rootsLoaded());
    return 0;
}
