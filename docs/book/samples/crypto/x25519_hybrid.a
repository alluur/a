// From key agreement to an encrypted message
import x25519;
import chacha;
import hash;
import secure;

int main() {
    // each side makes a key pair; only the public halves cross the network
    char aPriv[32]; char aPub[32]; char bPriv[32]; char bPub[32];
    secure.bytes(aPriv, 32);
    secure.bytes(bPriv, 32);
    x25519.base(aPub, aPriv);
    x25519.base(bPub, bPriv);

    // Alice: shared secret, hashed into a key (never use the raw secret as a key)
    char shared[32];
    x25519.scalarmult(shared, aPriv, bPub);
    char key[32];
    hash.sha256Raw(shared, 32, key);

    char nonce[12];
    secure.bytes(nonce, 12);
    char* message = "hello Bob, this is Alice";
    int n = strlen(message);
    char sealed[80];
    chacha.seal(key, nonce, "alice->bob", 10, message, n, sealed);

    // Bob: the same secret from his side, the same key, then open
    char shared2[32];
    x25519.scalarmult(shared2, bPriv, aPub);
    char key2[32];
    hash.sha256Raw(shared2, 32, key2);
    char plain[80];
    if (chacha.open(key2, nonce, "alice->bob", 10, sealed, n + 16, plain)) {
        plain[n] = 0;
        printf("Bob read: %s\n", plain);
    }
    return 0;
}
