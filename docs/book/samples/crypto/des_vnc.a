// The VNC password scheme: DES is here for this
import des;
import secure;

int main() {
    // the server sends 16 random bytes; here they are fixed so that the output repeats
    char challenge[16];
    for (int i = 0; i < 16; i++) challenge[i] = i;

    char answer[16];
    des.vncResponse("secret", challenge, answer);        // at most 8 password characters are used
    println(secure.toHex(answer, 16));

    char other[16];
    des.vncResponse("Secret", challenge, other);
    printf("\"Secret\" gives the same answer: %s\n", streq(secure.toHex(answer, 16), secure.toHex(other, 16)) ? "yes" : "no");

    des.vncResponse("secretXYZ", challenge, other);      // everything after the 8th character is ignored
    des.vncResponse("secretXY", challenge, answer);
    printf("\"secretXYZ\" and \"secretXY\" agree: %s\n", streq(secure.toHex(answer, 16), secure.toHex(other, 16)) ? "yes" : "no");
    return 0;
}
