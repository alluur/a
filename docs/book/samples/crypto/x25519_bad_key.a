// Refusing a bad public key
import x25519;
import secure;

int main() {
    char priv[32];
    secure.bytes(priv, 32);

    // the all-zero point has a tiny order: whatever your private key is, the result would be all zeros,
    // so an attacker who sends it would know your "secret"
    char evil[32];
    for (int i = 0; i < 32; i++) evil[i] = 0;
    char out[32];
    printBool(x25519.scalarmult(out, priv, evil));
    println(" : accepted the zero point");

    char pub[32];
    x25519.base(pub, priv);
    printBool(x25519.scalarmult(out, priv, pub));
    println(" : accepted an honest public key");
    return 0;
}
