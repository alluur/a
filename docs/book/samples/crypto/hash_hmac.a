// HMAC: a hash with a secret key proves who made a message
import hash;
import secure;

int main() {
    // RFC 4231 test case 2
    char* key = "Jefe";
    char* data = "what do ya want for nothing?";
    char mac[32];
    hash.hmacSha256(key, 4, data, strlen(data), mac);
    println(secure.toHex(mac, 32));

    // the receiver computes the tag again and compares. Compare in constant time: a plain
    // comparison stops at the first different byte, and the time it takes tells an attacker how many bytes were right
    char received[32];
    for (int i = 0; i < 32; i++) received[i] = mac[i];
    printf("tag accepted: %s\n", hash.equalConstantTime(mac, received, 32) ? "yes" : "no");
    received[31] = received[31] ^ 1;
    printf("changed tag accepted: %s\n", hash.equalConstantTime(mac, received, 32) ? "yes" : "no");

    // the same call for other hash sizes: hmac(bits, ...) returns the tag length
    char mac512[64];
    int n = hash.hmac(512, key, 4, data, strlen(data), mac512);
    printf("HMAC-SHA-512: %d bytes\n", n);
    return 0;
}
