// TLS over a real socket on the loopback interface
// book: linux-only
import tls;
import x509;
import net;
import cunistd;
import pki;

// the server: a child process, so that the two sides do not share one heap
void serve(int listener) {
    tls.Config* cfg = tls.loadConfig(pki.LEAF, pki.KEY);
    int c = net.accept(listener);
    if (!tls.wrapServer(c, cfg)) _exit(2);          // the TLS handshake
    char line[100];
    net.recvLine(c, line, 100);                      // from here on net.* encrypts and decrypts by itself
    net.sendText(c, "you said: ");
    net.sendText(c, line);
    net.sendText(c, "\n");
    net.close(c);                                    // sends close_notify first
    _exit(0);
}

int main() {
    int listener = net.listenOn("127.0.0.1", 0, 4);   // port 0: the system picks a free port
    int port = net.localPort(listener);               // so ask which one it is
    int pid = fork();
    if (pid == 0) serve(listener);
    net.close(listener);

    x509.clearRoots();
    x509.addRootPem(pki.ROOT);
    int fd = net.connect("127.0.0.1", port);
    if (!tls.wrap(fd, "www.example.test", true)) {    // handshake; the name is checked against the certificate
        printf("handshake failed: %s\n", tls.lastError());
        return 1;
    }
    tls.Tls* t = tls.sessionOf(fd);
    printf("connected with %s to %s\n", t->suiteName, t->leaf->cn);

    net.sendText(fd, "hello\n");
    char reply[100];
    net.recvLine(fd, reply, 100);
    println(reply);
    net.close(fd);
    int status;
    waitpid(pid, &status, 0);
    printf("server exit code: %d\n", (status >> 8) & 255);
    return 0;
}
