// Why a nonce must never be used twice with the same key
import aes;
import secure;

int main() {
    char key[16];
    char iv[12];
    secure.bytes(key, 16);
    for (int i = 0; i < 12; i++) iv[i] = 7;         // the mistake: a fixed nonce

    aes.Gcm* g = aes.gcm(key, 16);
    char* a = "attack at dawn!!";
    char* b = "retreat at dusk!";
    char ca[40];
    char cb[40];
    aes.seal(g, iv, "", 0, a, 16, ca);
    aes.seal(g, iv, "", 0, b, 16, cb);

    // GCM encrypts by XOR with a key stream that depends only on key and nonce. The same stream twice:
    // cipher1 XOR cipher2 == plain1 XOR plain2, and the key has dropped out. An eavesdropper without the key
    // can use this to recover text from guesses.
    int same = 0;
    for (int i = 0; i < 16; i++) {
        int viaCipher = (ca[i] ^ cb[i]) & 255;
        int viaPlain = (a[i] ^ b[i]) & 255;
        if (viaCipher == viaPlain) same++;
    }
    printf("%d of 16 bytes: cipher1^cipher2 equals plain1^plain2\n", same);

    // knowing the first message, the second one falls out
    char guess[17];
    for (int i = 0; i < 16; i++) guess[i] = (ca[i] ^ cb[i] ^ a[i]) & 255;
    guess[16] = 0;
    print("recovered: ");
    println(guess);
    return 0;
}
