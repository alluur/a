// SHA-256 and SHA-512: fixed size fingerprints
import hash;
import secure;

int main() {
    char* abc = "abc";
    println(hash.sha256(abc, 3));                         // the text form: 64 hex characters
    println(hash.sha512(abc, 3));

    // hash.digest(bits, ...) picks the size at run time and returns the digest length
    char d[64];
    int n = hash.digest(384, abc, 3, d);
    printf("SHA-384: %d bytes, %s...\n", n, substr(secure.toHex(d, n), 0, 16));

    // one changed character changes everything
    println(hash.sha256("abd", 3));

    // empty input still has a hash
    println(hash.sha256("", 0));
    return 0;
}
