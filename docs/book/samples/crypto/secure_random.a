// Random bytes for keys: secure.bytes
import secure;

int main() {
    char a[32];
    char b[32];
    bool ok = secure.bytes(a, 32);          // false only if the system has no random source
    printf("got 32 random bytes: %s\n", ok ? "yes" : "no");
    secure.bytes(b, 32);
    printf("two draws differ: %s\n", streq(secure.toHex(a, 32), secure.toHex(b, 32)) ? "no" : "yes");

    // fresh values for nonces and identifiers: 16 bytes that do not repeat
    char u1[16];
    char u2[16];
    secure.unique(u1);
    secure.unique(u2);
    printf("two unique() values differ: %s\n", streq(secure.toHex(u1, 16), secure.toHex(u2, 16)) ? "no" : "yes");

    // never use rand() for keys: after the same seed it gives the same numbers, and anyone can predict it
    srand(1);
    int first = rand();
    srand(1);
    printf("rand() repeats after the same seed: %s\n", rand() == first ? "yes" : "no");
    return 0;
}
