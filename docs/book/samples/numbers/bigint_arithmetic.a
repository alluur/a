// Arithmetic on BigInt values
import bigint;

int main() {
    bigint.BigInt* a = bigint.parse("123456789012345678901234567890");
    bigint.BigInt* b = bigint.parse("-987654321098765432109876543210");

    println(bigint.add(a, b)->toString());
    println(bigint.sub(a, b)->toString());
    println(bigint.mul(a, b)->toString());
    println(bigint.negate(a)->toString());

    // numbers are immutable: a is unchanged by the calls above
    printf("a is still %s\n", a->toString());

    // comparing: -1, 0 or 1
    printf("cmp(a, b) = %d, cmp(b, a) = %d, cmp(a, a) = %d\n", bigint.cmp(a, b), bigint.cmp(b, a), bigint.cmp(a, a));

    // division works by a small number (below 2^31) and gives the remainder too
    int rem;
    bigint.BigInt* q = bigint.divSmall(a, 97, &rem);
    printf("a / 97 = %s remainder %d\n", q->toString(), rem);
    println(bigint.mulSmall(q, 97)->toString());     // 97 * q is a minus the remainder

    // small values: back to an int, and a bad text is null
    bigint.BigInt* small = bigint.mul(bigint.fromInt(123456), bigint.fromInt(-1000));
    printf("fits in an int: %d\n", small->toInt());
    printf("parse(\"12x\") is null: %d\n", bigint.parse("12x") == null);
    printf("zero? %d %d\n", bigint.fromInt(0)->isZero(), a->isZero());
    return 0;
}
