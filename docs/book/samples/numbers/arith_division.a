// Division with a rounding rule you choose
import arith;

int main() {
    printf("%6s %6s %9s %9s %9s %9s\n", "a", "b", "a / b", "floorDiv", "ceilDiv", "roundDiv");
    int a[4] = {7, -7, 7, -7};
    int b[4] = {2, 2, -2, -2};
    for (int i = 0; i < 4; i++) {
        printf("%6d %6d %9d %9d %9d %9d\n", a[i], b[i], a[i] / b[i],
               arith.floorDiv(a[i], b[i]), arith.ceilDiv(a[i], b[i]), arith.roundDiv(a[i], b[i]));
    }
    printf("floorMod(-7, 3) = %d\n", arith.floorMod(-7, 3));
    printf("absDiff(3, -9) = %d, sign(-5) = %d\n", arith.absDiff(3, -9), arith.sign(-5));
    int big = 9223372036854775807;
    printf("avg(big, big - 2) = %d (a + b would overflow)\n", arith.avg(big, big - 2));

    printf("isqrt(10^18) = %d\n", arith.isqrt(1000000000000000000));
    printf("iroot(1000, 3) = %d, iroot(999, 3) = %d\n", arith.iroot(1000, 3), arith.iroot(999, 3));
    printf("isSquare(144) = %d, isSquare(145) = %d\n", arith.isSquare(144), arith.isSquare(145));
    return 0;
}
