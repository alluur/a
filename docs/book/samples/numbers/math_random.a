// Random numbers that repeat when the seed repeats
import math;

int main() {
    // the global generator of the standard library: seed it to get the same sequence every time
    srand(2024);
    printf("rand():");
    for (int i = 0; i < 5; i++) { printf(" %d", rand() % 100); }
    println("");
    srand(2024);
    printf("again  :");
    for (int i = 0; i < 5; i++) { printf(" %d", rand() % 100); }
    println("");

    // math.randRange(lo, hi) and math.shuffle use the same generator
    srand(7);
    printf("dice   :");
    for (int i = 0; i < 8; i++) { printf(" %d", math.randRange(1, 6)); }
    println("");

    int deck[8] = {1, 2, 3, 4, 5, 6, 7, 8};
    math.shuffle(deck, 8);
    printf("shuffle:");
    for (int i = 0; i < 8; i++) { printf(" %d", deck[i]); }
    println("");
    return 0;
}
