// Counting functions and digit tricks
import arith;

int main() {
    printf("fibonacci(92) = %d\n", arith.fibonacci(92));         // the largest that fits in 64 bits
    printf("factorial(20) = %d\n", arith.factorial(20));
    printf("catalan(10) = %d\n", arith.catalan(10));
    printf("binomial(52, 5) = %d poker hands\n", arith.binomial(52, 5));
    printf("collatzSteps(27) = %d\n", arith.collatzSteps(27));

    printf("digitCount(9876543210) = %d, digitSum = %d\n", arith.digitCount(9876543210), arith.digitSum(9876543210));
    printf("reverseDigits(12345) = %d\n", arith.reverseDigits(12345));
    printf("palindromes among 120..140:");
    for (int i = 120; i <= 140; i++) { if (arith.isPalindrome(i)) { printf(" %d", i); } }
    println("");
    return 0;
}
