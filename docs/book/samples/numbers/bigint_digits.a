// Counting digits: the digit sum of 2^1000 and the first 1000-digit Fibonacci number
import bigint;

int digitSum(bigint.BigInt* n) {
    char* s = n->toString();
    int sum = 0;
    for (int i = 0; s[i] != 0; i++) { sum = sum + s[i] - '0'; }
    return sum;
}

int main() {
    bigint.BigInt* p = bigint.pow(bigint.fromInt(2), 1000);
    printf("2^1000 has %d digits, digit sum %d\n", p->digits(), digitSum(p));

    // walk along the Fibonacci numbers until one has 1000 digits
    bigint.BigInt* a = bigint.fromInt(1);
    bigint.BigInt* b = bigint.fromInt(1);
    int index = 2;
    while (b->digits() < 1000) {
        bigint.BigInt* c = bigint.add(a, b);
        a = b;
        b = c;
        index++;
    }
    printf("fib(%d) is the first with 1000 digits\n", index);
    return 0;
}
