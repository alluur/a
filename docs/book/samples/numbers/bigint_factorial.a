// Numbers far beyond 64 bits: factorials and Fibonacci
import bigint;

int main() {
    // 20! is the largest factorial that fits in an int; 50! needs a BigInt
    bigint.BigInt* f = bigint.factorial(50);
    printf("50! = %s\n", f->toString());
    printf("it has %d digits\n", f->digits());

    // the 300th Fibonacci number
    bigint.BigInt* fib = bigint.fibonacci(300);
    printf("fib(300) = %s\n", fib->toString());

    // 2 to the power of 200
    bigint.BigInt* two = bigint.fromInt(2);
    println(bigint.pow(two, 200)->toString());
    return 0;
}
