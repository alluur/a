// The mathematical functions for doubles
import dmath;

int main() {
    printlnDouble(dmath.sqrt(2));                    // correctly rounded, the same on every CPU
    printlnDouble(dmath.cbrt(27));
    printlnDouble(dmath.pow(2, 0.5));
    printlnDouble(dmath.exp(1));
    printlnDouble(dmath.log(dmath.E));
    printlnDouble(dmath.log10(1000));
    printlnDouble(dmath.log2(1024));
    printlnDouble(dmath.hypot(3, 4));

    // trigonometry works in radians
    printlnDouble(dmath.sin(dmath.PI / 2));
    printlnDouble(dmath.cos(dmath.PI));
    println(doubleToFixed(dmath.tan(dmath.PI / 4), 12));
    println(doubleToFixed(dmath.atan2(1, 1) * 4, 15));   // pi again
    println(doubleToFixed(dmath.asin(0.5) * 180 / dmath.PI, 10));   // degrees

    // rounding to whole numbers
    printf("floor(-2.5) = %s, ceil(2.1) = %s, round(2.5) = %s, round(-2.5) = %s, trunc(-2.7) = %s\n",
           doubleToText(dmath.floor(-2.5)), doubleToText(dmath.ceil(2.1)), doubleToText(dmath.round(2.5)),
           doubleToText(dmath.round(-2.5)), doubleToText(dmath.trunc(-2.7)));
    printlnDouble(dmath.fmod(10.5, 3));
    printlnDouble(dmath.fabs(-0.25));
    printlnDouble(dmath.fmin(3, 7) + dmath.fmax(3, 7));
    printlnDouble(dmath.copysign(5, -0.0));

    // the constants
    printlnDouble(dmath.PI);
    printlnDouble(dmath.TAU);
    printlnDouble(dmath.EPSILON);
    printf("sqrt(-1) is NaN: %d, INFINITY is infinite: %d\n", isNaN(dmath.sqrt(-1)), isInf(dmath.INFINITY));
    return 0;
}
