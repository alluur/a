// Everyday integer mathematics
import math;

int main() {
    printf("gcd(84, 36) = %d, lcm(4, 6) = %d\n", math.gcd(84, 36), math.lcm(4, 6));
    printf("pow(3, 13) = %d\n", math.pow(3, 13));
    printf("isqrt(1000000) = %d, isqrt(99) = %d\n", math.isqrt(1000000), math.isqrt(99));    // rounded down

    printf("factorial(10) = %d\n", math.factorial(10));
    printf("fibonacci(50) = %d\n", math.fibonacci(50));
    printf("binomial(10, 3) = %d\n", math.binomial(10, 3));

    // % keeps the sign of the dividend; mod() and floorDiv() round towards minus infinity
    printf("-7 %% 3 = %d, mod(-7, 3) = %d\n", -7 % 3, math.mod(-7, 3));
    printf("-7 / 2 = %d, floorDiv(-7, 2) = %d\n", -7 / 2, math.floorDiv(-7, 2));

    printf("clamp(15, 0, 10) = %d, sign(-8) = %d\n", math.clamp(15, 0, 10), math.sign(-8));
    printf("popcount(255) = %d, ilog2(1000) = %d\n", math.popcount(255), math.ilog2(1000));
    printf("digitSum(98765) = %d\n", math.digitSum(98765));

    // primes
    printf("isPrime(97) = %d, isPrime(91) = %d, nextPrime(100) = %d\n", math.isPrime(97), math.isPrime(91), math.nextPrime(100));
    printf("powMod(2, 100, 1000007) = %d\n", math.powMod(2, 100, 1000007));

    // statistics on an array
    int a[6] = {14, 3, 99, -4, 27, 8};
    printf("sum %d, min %d, max %d\n", math.sum(a, 6), math.minOf(a, 6), math.maxOf(a, 6));
    return 0;
}
