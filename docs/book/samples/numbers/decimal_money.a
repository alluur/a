// Exact money arithmetic with the decimal module
import decimal;

int main() {
    // a value is a whole number of cents when the scale is 2
    int price = decimal.parse("19.99", 2);            // 1999
    int qty = 3;
    int net = price * qty;
    printf("%d x %s = %s\n", qty, decimal.format(price, 2), decimal.format(net, 2));

    // tax: percentOf rounds half away from zero
    int tax = decimal.percentOf(net, 190, 1);          // 19.0 percent (190 with one decimal)
    printf("tax 19.0%%    = %s\n", decimal.format(tax, 2));
    printf("total        = %s\n", decimal.format(net + tax, 2));
    printf("with commas  = %s\n", decimal.formatMoney(123456789));

    // the classic float trap does not exist: 0.10 + 0.20 is exactly 0.30
    int sum = decimal.parse("0.10", 2) + decimal.parse("0.20", 2);
    printf("0.10 + 0.20  = %s, equals 0.30: %d\n", decimal.format(sum, 2), sum == decimal.parse("0.30", 2));

    // negative amounts and rounding of extra digits
    printf("parse(-12.345, 2) = %d\n", decimal.parse("-12.345", 2));    // -1235: half away from zero
    printf("format(-5, 2) = %s\n", decimal.format(-5, 2));
    printf("formatMoney(-1234567) = %s\n", decimal.formatMoney(-1234567));
    printf("parse(abc) = %d, isValid = %d\n", decimal.parse("abc", 2), decimal.isValid("abc"));
    return 0;
}
