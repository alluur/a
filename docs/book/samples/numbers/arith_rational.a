// Exact fractions with operators
import arith;

int main() {
    arith.Rational a = arith.rat(1, 3);
    arith.Rational b = arith.rat(1, 6);
    arith.Rational c = a + b;                        // always kept in lowest terms
    printf("1/3 + 1/6 = %s\n", c.str());
    printf("1/3 - 1/6 = %s\n", (a - b).str());
    printf("1/3 * 1/6 = %s\n", (a * b).str());
    printf("1/3 / 1/6 = %s\n", (a / b).str());          // 2 prints without a denominator
    printf("-(1/3)    = %s\n", (-a).str());

    printf("rat(6, -8) = %s, num %d den %d\n", arith.rat(6, -8).str(), arith.rat(6, -8).num, arith.rat(6, -8).den);
    printf("1/3 < 1/2: %d, 2/4 == 1/2: %d\n", a < arith.rat(1, 2), arith.rat(2, 4) == arith.rat(1, 2));

    // 7/2 rounded three ways
    arith.Rational h = arith.rat(7, 2);
    printf("floor %d, ceil %d, round %d\n", h.floor(), h.ceil(), h.round());

    // the harmonic number 1 + 1/2 + ... + 1/10, exactly
    arith.Rational sum = arith.rat(0);
    for (int i = 1; i <= 10; i++) { sum = sum + arith.rat(1, i); }
    printf("H(10) = %s\n", sum.str());

    printf("denominator 0 gives %s\n", arith.rat(1, 0).str());      // the fraction 0/1, not a crash
    return 0;
}
