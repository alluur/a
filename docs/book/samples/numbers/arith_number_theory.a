// Number theory: primes, factors, modular arithmetic
import arith;

int main() {
    // factorizing: the prime factors with repeats
    int primes[64];
    int n = arith.factorize(360, primes, 64);
    printf("360 =");
    for (int i = 0; i < n; i++) { printf(" %d", primes[i]); }
    println("");
    n = arith.factorize(600851475143, primes, 64);
    printf("600851475143 has %d prime factors, the largest is %d\n", n, primes[n - 1]);
    printf("totient(36) = %d, divisorCount(360) = %d\n", arith.totient(36), arith.divisorCount(360));

    // isPrime is exact for every 64-bit number
    printf("isPrime(1000000007) = %d\n", arith.isPrime(1000000007));
    printf("isPrime(2305843009213693951) = %d (2^61 - 1)\n", arith.isPrime(2305843009213693951));
    printf("isPrime(2305843009213693953) = %d\n", arith.isPrime(2305843009213693953));
    printf("nextPrime(1000) = %d\n", arith.nextPrime(1000));

    // gcd, lcm and the extended Euclid: a*x + b*y = gcd
    int x;
    int y;
    int g = arith.extGcd(240, 46, &x, &y);
    printf("gcd(240, 46) = %d = 240*(%d) + 46*(%d); lcm = %d\n", g, x, y, arith.lcm(240, 46));

    // modular arithmetic without overflow: a * b mod m for huge numbers
    printf("mulMod = %d\n", arith.mulMod(9000000000000000000, 9000000000000000000, 1000000007));
    printf("powMod(2, 1000, 1000000007) = %d\n", arith.powMod(2, 1000, 1000000007));
    printf("modInverse(3, 11) = %d (3 * 4 = 12 = 1 mod 11)\n", arith.modInverse(3, 11));
    printf("modInverse(4, 8) = %d (none exists)\n", arith.modInverse(4, 8));
    return 0;
}
