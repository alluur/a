// Fixed-point numbers: fractions on plain ints
import fixed;

int main() {
    // an int holding value * 2^20; ONE is 1.0
    printf("ONE = %d, HALF = %d\n", fixed.ONE, fixed.HALF);
    int a = fixed.fromText("2.5");
    int b = fixed.fromInt(3);
    int c = fixed.mul(a, b);                          // + and - are the plain operators, * and / need a function
    print("2.5 * 3 = "); fixed.putln(c, 3);
    print("2.5 / 3 = "); fixed.putln(fixed.div(a, b), 6);
    print("2.5 + 3 = "); fixed.putln(a + b, 1);
    print("1/3     = "); fixed.putln(fixed.ratio(1, 3), 8);
    print("fromParts(3, 141593) = "); fixed.putln(fixed.fromParts(3, 141593), 6);
    print("PI      = "); fixed.putln(fixed.PI, 6);

    // rounding and clamping
    int x = fixed.fromText("-2.75");
    printf("toInt(-2.75) = %d (towards minus infinity)\n", fixed.toInt(x));
    print("floor: "); fixed.putln(fixed.floor(x), 1);
    print("round: "); fixed.putln(fixed.round(x), 1);
    print("abs  : "); fixed.putln(fixed.abs(x), 2);
    print("clamp: "); fixed.putln(fixed.clamp(x, fixed.fromInt(-2), fixed.fromInt(2)), 1);
    printf("sign of -2.75: %d\n", fixed.sign(x));
    print("min(2.5, 3): "); fixed.putln(fixed.min(a, b), 1);
    print("max(2.5, 3): "); fixed.putln(fixed.max(a, b), 1);

    // the resolution is 2^-20: about one millionth
    print("smallest step: "); fixed.putln(1, 9);
    return 0;
}
