// Multiplying, dividing and changing the scale of decimals
import decimal;

int main() {
    // an exchange rate with 4 decimals applied to an amount with 2 decimals
    int amount = decimal.parse("250.00", 2);
    int rate = decimal.parse("1.0845", 4);
    int a4 = decimal.rescale(amount, 2, 4);            // same value, scale 4
    int converted = decimal.mul(a4, rate, 4);          // both operands have scale 4
    printf("250.00 x 1.0845 = %s (scale 4)\n", decimal.format(converted, 4));
    printf("rounded to cents: %s\n", decimal.format(decimal.rescale(converted, 4, 2), 2));

    // division keeps the scale and rounds
    int third = decimal.div(decimal.parse("1", 6), decimal.parse("3", 6), 6);
    printf("1 / 3 = %s\n", decimal.format(third, 6));
    int share = decimal.div(decimal.parse("100.00", 2), decimal.parse("7", 2), 2);
    printf("100.00 / 7 = %s\n", decimal.format(share, 2));
    printf("division by zero gives %d\n", decimal.div(500, 0, 2));

    // rescale to a smaller scale rounds half away from zero
    printf("rescale(1005, 3, 2) = %d, rescale(-1005, 3, 2) = %d\n", decimal.rescale(1005, 3, 2), decimal.rescale(-1005, 3, 2));
    printf("pow10(6) = %d\n", decimal.pow10(6));
    return 0;
}
