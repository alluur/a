// Modular exponentiation with fixed size big numbers
import bn;
import encoding;

// the modulus 2^255 - 19, as 32 big-endian bytes
void prime(char* out) {
    for (int i = 0; i < 32; i++) { out[i] = 0xFF; }
    out[0] = 0x7F;
    out[31] = 0xED;
}

int main() {
    char pbytes[32];
    prime(pbytes);
    bn.Num* p = bn.fromBytes(pbytes, 32, 9);         // 9 limbs of 30 bits hold 270 bits
    printf("p has %d bits\n", bn.bitLength(p));

    bn.Mont* m = bn.mont(p);                         // the modulus must be odd

    // Fermat: for a prime p, a^(p-1) = 1 (mod p)
    bn.Num* e = bn.copy(p);
    bn.sub(e, e, bn.fromInt(1, 9));
    bn.Num* r = bn.powMod(m, bn.fromInt(2, 9), e);
    printf("2^(p-1) mod p == 1: %d\n", bn.cmp(r, bn.fromInt(1, 9)) == 0);

    // an ordinary power with a result that wraps: 3^100 mod p, printed in hex
    bn.Num* s = bn.powMod(m, bn.fromInt(3, 9), bn.fromInt(100, 9));
    char out[32];
    bn.toBytes(s, out, 32);
    println(encoding.hexEncode(out, 32));

    // a number that is not a prime breaks the rule
    bn.Num* n15 = bn.fromInt(15, 1);
    bn.Mont* m15 = bn.mont(n15);
    bn.Num* t = bn.powMod(m15, bn.fromInt(2, 1), bn.fromInt(14, 1));
    printf("2^14 mod 15 = %d (not 1: 15 is not prime)\n", t->d[0]);
    return 0;
}
