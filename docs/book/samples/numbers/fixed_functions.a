// Square roots, powers, trigonometry and activation functions in fixed point
import fixed;

void line(char* label, int x) {
    printf("%-14s", label);
    fixed.putln(x, 6);
}

int main() {
    line("sqrt(2)", fixed.sqrt(fixed.fromInt(2)));
    line("sqrt(0.25)", fixed.sqrt(fixed.fromText("0.25")));
    line("exp(1)", fixed.exp(fixed.ONE));
    line("log(e)", fixed.log(fixed.E));
    line("pow(2, 0.5)", fixed.pow(fixed.fromInt(2), fixed.HALF));
    line("sin(pi/6)", fixed.sin(fixed.PI / 6));
    line("cos(pi/3)", fixed.cos(fixed.PI / 3));
    line("sigmoid(0)", fixed.sigmoid(0));
    line("sigmoid(2)", fixed.sigmoid(fixed.fromInt(2)));
    line("tanh(1)", fixed.tanh(fixed.ONE));
    line("relu(-3)", fixed.relu(fixed.fromInt(-3)));
    line("relu(1.5)", fixed.relu(fixed.fromText("1.5")));

    // the limits: products must stay below 2^62 in raw units, i.e. about +-2048 for each factor
    int big = fixed.fromInt(2000);
    line("2000 * 2000", fixed.mul(big, big));
    return 0;
}
