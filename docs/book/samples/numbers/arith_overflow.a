// Overflow checks and saturating arithmetic
import arith;

int main() {
    int big = 9223372036854775807;                   // the largest int
    printf("big + 1 wraps to %d\n", big + 1);
    printf("addOverflows(big, 1) = %d\n", arith.addOverflows(big, 1));
    printf("mulOverflows(3037000500, 3037000500) = %d\n", arith.mulOverflows(3037000500, 3037000500));

    int r = 0;
    if (arith.checkedAdd(40, 2, &r)) { printf("checkedAdd(40, 2) = %d\n", r); }
    r = 123;
    if (!arith.checkedMul(big, 2, &r)) { printf("checkedMul failed, r is still %d\n", r); }

    // saturating: stick at the limit instead of wrapping
    printf("satAdd(big, 1000) = %d\n", arith.satAdd(big, 1000));
    printf("satSub(-big, 1000) = %d\n", arith.satSub(-big, 1000));
    printf("satMul(big, -2) = %d\n", arith.satMul(big, -2));

    // clamp to the range of a narrower integer
    printf("clampBits(300, 8, unsigned) = %d\n", arith.clampBits(300, 8, false));
    printf("clampBits(-300, 8, signed) = %d\n", arith.clampBits(-300, 8, true));
    printf("clampBits(100, 8, signed) = %d\n", arith.clampBits(100, 8, true));
    return 0;
}
