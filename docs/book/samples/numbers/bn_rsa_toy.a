// A toy RSA round trip on top of bn (real keys are 2048 bits; these are tiny)
import bn;
import arith;

// the number v as a bn.Num of 3 limbs (90 bits)
bn.Num* num(int v) { return bn.fromInt(v, 3); }

int main() {
    int p = 1000003;
    int q = 1000033;
    int n = p * q;
    int phi = (p - 1) * (q - 1);
    int e = 65537;
    int d = arith.modInverse(e, phi);                // the private exponent: e * d = 1 mod phi
    printf("n = %d, e = %d, d = %d\n", n, e, d);

    bn.Mont* m = bn.mont(num(n));
    int message = 424242424242;                      // must be below n
    bn.Num* cipher = bn.powMod(m, num(message), num(e));
    bn.Num* plain = bn.powMod(m, cipher, num(d));

    printf("message   = %d\n", message);
    printf("encrypted = %d\n", cipher->d[0] | (cipher->d[1] << 30));    // two 30 bit limbs
    printf("decrypted = %d\n", plain->d[0] | (plain->d[1] << 30));
    printf("round trip ok: %d\n", bn.cmp(plain, num(message)) == 0);
    return 0;
}
