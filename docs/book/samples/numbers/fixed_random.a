// Random fixed-point numbers with a seed
import fixed;

int main() {
    fixed.seed(42);
    printf("uniform in [0, 1):");
    for (int i = 0; i < 5; i++) { printf(" "); fixed.put(fixed.rand()); }
    println("");

    fixed.seed(42);                                   // the same seed repeats the numbers
    printf("same again       :");
    for (int i = 0; i < 5; i++) { printf(" "); fixed.put(fixed.rand()); }
    println("");

    printf("randRange(10, 20):");
    for (int i = 0; i < 5; i++) { printf(" "); fixed.put(fixed.randRange(fixed.fromInt(10), fixed.fromInt(20))); }
    println("");

    // gauss(): approximately a normal distribution, mean 0 and deviation 1
    int sum = 0;
    int n = 2000;
    for (int i = 0; i < n; i++) { sum = sum + fixed.gauss(); }
    print("mean of 2000 gauss() values: "); fixed.putln(sum / n, 3);
    printf("raw next() is a non-negative integer: %d\n", fixed.next() >= 0);
    return 0;
}
