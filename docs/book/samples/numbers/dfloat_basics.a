// Floating point numbers: the double type
int main() {
    double a = 2.5;
    double b = a * 3 + 0.25;                         // ints and doubles mix; ints are converted
    printlnDouble(b);                                // the shortest text that reads back exactly
    printlnDouble(0.1 + 0.2);                        // the famous binary rounding: 0.30000000000000004
    printlnDouble(1.0 / 3);
    printlnDouble(1e22);
    printlnDouble(5e-324);                           // the smallest positive double

    // comparing and converting
    printf("a < b: %d, a == 2.5: %d\n", a < b, a == 2.5);
    int whole = (int) b;                             // a cast truncates towards zero
    printf("(int) 7.75 = %d, (int) -7.75 = %d\n", whole, (int) (0 - b));
    a += 1.5;
    a *= 2;
    printlnDouble(a);

    // text in and out
    println(doubleToFixed(3.14159265, 3));           // exactly rounded: 3.142
    println(doubleToSci(123456.789, 2));
    println(doubleToText(0.5));
    printlnDouble(parseDouble("123.456e2"));
    printlnDouble(parseDouble("junk"));              // no digits: 0

    // special values
    double big = 1e308 * 10;                         // overflow gives infinity
    double nan = big - big;                          // infinity minus infinity is not a number
    printf("isInf: %d, isNaN: %d, isFinite(1.5): %d\n", isInf(big), isNaN(nan), isFinite(1.5));
    printf("nan == nan: %d\n", nan == nan);
    return 0;
}
