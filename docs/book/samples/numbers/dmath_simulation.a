// A small physics calculation: a ball thrown at an angle
import dmath;

int main() {
    double g = 9.81;
    double speed = 20;                               // metres per second
    printf("%6s %8s %8s %8s\n", "angle", "range", "height", "time");
    for (int deg = 15; deg <= 75; deg += 15) {
        double rad = deg * dmath.PI / 180;
        double vx = speed * dmath.cos(rad);
        double vy = speed * dmath.sin(rad);
        double time = 2 * vy / g;
        double range = vx * time;
        double height = vy * vy / (2 * g);
        printf("%5d  %8s %8s %8s\n", deg, doubleToFixed(range, 2), doubleToFixed(height, 2), doubleToFixed(time, 2));
    }
    return 0;
}
