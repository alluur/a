// A double is 64 bits: sign, exponent, fraction
int main() {
    double values[4] = {1.0, -2.5, 0.1, 1e300};
    for (int i = 0; i < 4; i++) {
        int bits = __bits(values[i]);                // the raw IEEE 754 pattern as an int
        printf("%-6s 0x%016X  sign %d  exponent %4d  fraction 0x%013X\n",
               doubleToText(values[i]), bits, (bits >> 63) & 1, (bits >> 52) & 0x7FF, bits & 0xFFFFFFFFFFFFF);
    }

    // going the other way: build a double from its bits
    double half = __dbl(0x3FE0000000000000);         // exponent 1022: 2^-1
    printlnDouble(half);
    double inf = __dbl(0x7FF0000000000000);
    printlnDouble(inf);

    // adding the smallest step to 1.0 gives the next double
    double next = __dbl(__bits(1.0) + 1);
    printlnDouble(next);                             // 1.0000000000000002
    printf("1.0 + 1e-16 == 1.0: %d\n", 1.0 + 1e-16 == 1.0);
    return 0;
}
