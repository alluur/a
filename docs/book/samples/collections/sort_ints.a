// Sorting numbers and searching a sorted array
import sort;

void show(char* label, int* a, int n) {
    printf("%-9s", label);
    for (int i = 0; i < n; i++) { printf(" %d", a[i]); }
    println("");
}

int main() {
    int a[10] = {42, -7, 19, 3, 88, 3, 0, 25, -100, 61};
    printf("sorted? %d\n", sort.isSorted(a, 10));
    sort.sortInts(a, 10);                           // in place, ascending
    show("ascending", a, 10);
    printf("sorted? %d\n", sort.isSorted(a, 10));

    sort.reverseInts(a, 10);
    show("reversed", a, 10);
    sort.sortInts(a, 10);

    // binary search: the array must be sorted; the result is an index or -1
    printf("find 25 -> %d\n", sort.binarySearch(a, 10, 25));
    printf("find 26 -> %d\n", sort.binarySearch(a, 10, 26));
    printf("find -100 -> %d\n", sort.binarySearch(a, 10, -100));

    // a larger array: 5000 numbers from a simple generator, then checked
    int* big = (int*) alloc(5000 * 8);
    int x = 12345;
    for (int i = 0; i < 5000; i++) { x = (x * 1103515245 + 12345) & 0x7FFFFFFF; big[i] = x % 1000; }
    sort.sortInts(big, 5000);
    printf("5000 numbers sorted: %d, smallest %d, largest %d\n", sort.isSorted(big, 5000), big[0], big[4999]);
    return 0;
}
