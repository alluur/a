// Graph search, shortest paths and ordering
import algo;

void showOrder(char* label, int* order, int n) {
    printf("%-12s", label);
    for (int i = 0; i < n; i++) { printf(" %d", order[i]); }
    println("");
}

int main() {
    algo.Graph* g = new algo.Graph(6);
    g->undirected(0, 1, 7);
    g->undirected(0, 2, 9);
    g->undirected(0, 5, 14);
    g->undirected(1, 2, 10);
    g->undirected(2, 5, 2);
    g->undirected(2, 3, 11);
    g->undirected(3, 4, 6);
    g->undirected(4, 5, 9);

    int order[6];
    showOrder("bfs from 0", order, g->bfs(0, order));
    showOrder("dfs from 0", order, g->dfs(0, order));

    int dist[6];
    g->dijkstra(0, dist);
    printf("distances from 0:");
    for (int i = 0; i < 6; i++) { printf(" %d", dist[i]); }
    println("");
    printf("components: %d, path 0->4: %d\n", g->components(), g->hasPath(0, 4));

    // a directed graph: build order of a project
    algo.Graph* deps = new algo.Graph(5);
    deps->edge(0, 1, 1);     // 0 before 1
    deps->edge(0, 2, 1);
    deps->edge(1, 3, 1);
    deps->edge(2, 3, 1);
    deps->edge(3, 4, 1);
    printf("topological: %d\n", deps->topological(order));
    showOrder("order", order, 5);
    deps->edge(4, 0, 1);     // now there is a cycle
    printf("with a cycle: %d\n", deps->topological(order));
    return 0;
}
