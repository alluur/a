// A queue (first in, first out) and a min-heap
import collections;

int main() {
    // a queue serves in arrival order
    collections.IntQueue q;
    for (int i = 1; i <= 4; i++) { q.push(i * 100); }
    printf("peek = %d, size = %d\n", q.peek(), q.size());
    while (!q.isEmpty()) { printf("%d ", q.pop()); }
    println("");
    printf("pop on empty: %d\n", q.pop());

    // a heap always gives the smallest element first, whatever the push order
    collections.IntHeap h;
    int data[7] = {42, 7, 19, 3, 88, 3, 25};
    for (int i = 0; i < 7; i++) { h.push(data[i]); }
    printf("smallest = %d\n", h.peek());
    while (!h.isEmpty()) { printf("%d ", h.pop()); }     // that is heap sort
    println("");

    // a max-heap: push negated numbers
    for (int i = 0; i < 7; i++) { h.push(-data[i]); }
    printf("largest three: %d %d %d\n", -h.pop(), -h.pop(), -h.pop());
    return 0;
}
