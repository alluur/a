// Union-find: which things belong together?
import algo;

int main() {
    // eight towns; roads join them step by step
    algo.UnionFind* u = new algo.UnionFind(8);
    printf("start: %d groups\n", u->groups);

    int from[5] = {0, 2, 1, 4, 3};
    int to[5]   = {1, 3, 3, 5, 0};
    for (int i = 0; i < 5; i++) {
        bool merged = u->unite(from[i], to[i]);
        printf("road %d-%d: %s, groups = %d\n", from[i], to[i], merged ? "joins two groups" : "already connected", u->groups);
    }
    printf("0 and 2 connected: %d\n", u->same(0, 2));
    printf("0 and 4 connected: %d\n", u->same(0, 4));
    printf("same representative for 0 and 3: %d\n", u->find(0) == u->find(3));
    return 0;
}
