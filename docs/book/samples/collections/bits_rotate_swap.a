// Rotating, byte swapping and reversing bits
import bits;

int main() {
    uint32 x = 0x12345678;
    printf("rotl32(x, 8)  = 0x%08X\n", bits.rotl32(x, 8));     // bits leaving on the left come back on the right
    printf("rotr32(x, 8)  = 0x%08X\n", bits.rotr32(x, 8));
    printf("rotl32(x, 32) = 0x%08X (a full turn)\n", bits.rotl32(x, 32));
    printf("rotl64        = 0x%016X\n", bits.rotl64(0x8000000000000001, 4));

    // changing the byte order: little endian <-> big endian
    printf("bswap16(0xAABB)     = 0x%04X\n", bits.bswap16(0xAABB));
    printf("bswap32(0x12345678) = 0x%08X\n", bits.bswap32(0x12345678));
    printf("bswap64             = 0x%016X\n", bits.bswap64(0x0102030405060708));

    // reversing the order of the bits
    printf("rev8(0b00000110)  = %d\n", bits.rev8(6));          // 0b01100000
    printf("rev16(1)          = 0x%04X\n", bits.rev16(1));
    printf("rev32(1)          = 0x%08X\n", bits.rev32(1));

    // watch a bit travel round the whole 32 bit word
    uint32 p = 0x40000001;
    for (int i = 0; i < 3; i++) {
        printf("%032b\n", p);
        p = bits.rotl32(p, 1);
    }
    printf("%032b\n", p);
    return 0;
}
