// Sorting with your own order, searching, and rearranging
import algo;

void show(char* label, int* a, int n) {
    printf("%-18s", label);
    for (int i = 0; i < n; i++) { printf(" %d", a[i]); }
    println("");
}

// a comparator returns < 0, 0 or > 0: here, order by the last digit
int byLastDigit(int a, int b) { return a % 10 - b % 10; }

int main() {
    int a[8] = {31, 12, 45, 22, 91, 13, 5, 80};
    algo.sortBy(a, 8, byLastDigit);                 // stable: 31 stays before 91, 12 before 22
    show("by last digit", a, 8);
    algo.sortDesc(a, 8);
    show("descending", a, 8);

    int s[9] = {1, 2, 2, 2, 5, 7, 7, 9, 12};
    printf("lowerBound(2) = %d, upperBound(2) = %d, countEqual(2) = %d\n",
           algo.lowerBound(s, 9, 2), algo.upperBound(s, 9, 2), algo.countEqual(s, 9, 2));
    printf("lowerBound(6) = %d (where 6 would be inserted)\n", algo.lowerBound(s, 9, 6));
    int n = algo.unique(s, 9);                      // sorted input: drops repeated neighbours
    show("unique", s, n);

    int r[6];
    algo.iota(r, 6, 1);                             // 1 2 3 4 5 6
    algo.rotate(r, 6, 2);                           // two places to the left
    show("rotate by 2", r, 6);
    printf("kth smallest (k=2): %d\n", algo.kthSmallest(r, 6, 2));

    int p[7] = {9, 1, 8, 2, 7, 3, 6};
    int below = algo.partition(p, 7, 5);            // everything < 5 first (no other order is promised)
    printf("%d elements are below 5, sum %d\n", below, algo.sum(p, 7));
    printf("largest %d, smallest %d\n", p[algo.indexOfMax(p, 7)], p[algo.indexOfMin(p, 7)]);
    for (int i = 0; i < 7; i++) { printf("%s%d", i == below ? " | " : " ", p[i]); }
    println("");

    // all arrangements of three numbers in order
    int perm[3] = {1, 2, 3};
    do { printf("%d%d%d ", perm[0], perm[1], perm[2]); } while (algo.nextPermutation(perm, 3));
    println("");
    return 0;
}
