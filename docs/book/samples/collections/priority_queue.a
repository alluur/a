// A priority queue: the value with the smallest priority comes out first
import collections;

int main() {
    char* jobs[5] = {"write report", "fix outage", "lunch", "reply to mail", "deploy"};
    int urgency[5] = {3, 1, 5, 4, 2};            // 1 is the most urgent

    collections.PriorityQueue pq;
    for (int i = 0; i < 5; i++) {
        pq.push(urgency[i], i);                  // the value is the job number
    }
    printf("%d jobs waiting\n", pq.size());
    while (!pq.isEmpty()) {
        int p = pq.peekPriority();
        int job = pq.pop();
        printf("priority %d: %s\n", p, jobs[job]);
    }
    return 0;
}
