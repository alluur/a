// Sets of ints and strings
import collections;

int main() {
    // finding the first repeated number
    collections.IntSet seen;
    int data[8] = {4, 8, 15, 16, 23, 8, 42, 4};
    for (int i = 0; i < 8; i++) {
        if (seen.has(data[i])) {
            printf("first repeat: %d at index %d\n", data[i], i);
            break;
        }
        seen.add(data[i]);
    }
    seen.add(4);                                 // adding twice keeps one
    printf("size %d, has 15: %d\n", seen.size(), seen.has(15));
    printf("remove 16: %d, again: %d, size %d\n", seen.remove(16), seen.remove(16), seen.size());

    // a set of strings: the text is copied, so a buffer can be reused
    collections.StrSet tags;
    char buf[16];
    char* kinds[5] = {"red", "green", "red", "blue", "green"};
    for (int i = 0; i < 5; i++) {
        strcpy(buf, kinds[i]);
        tags.add(buf);
    }
    printf("distinct colours: %d\n", tags.size());
    printf("blue? %d  pink? %d\n", tags.has("blue"), tags.has("pink"));

    // iterate over the slots of the IntSet
    int sum = 0;
    for (int s = 0; s < seen.capacity(); s++) {
        if (seen.usedAt(s)) { sum = sum + seen.valueAt(s); }
    }
    printf("sum of members: %d\n", sum);
    return 0;
}
