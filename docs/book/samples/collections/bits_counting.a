// Counting bits and powers of two
import bits;

int main() {
    int values[5] = {0, 1, 40, 255, 0x0F00};
    printf("%-6s %8s %6s %4s %4s %5s\n", "value", "popcount", "parity", "clz", "ctz", "log2");
    for (int i = 0; i < 5; i++) {
        int v = values[i];
        printf("%-6d %8d %6d %4d %4d %5d\n", v, bits.popcount(v), bits.parity(v), bits.clz(v), bits.ctz(v), bits.log2(v));
    }
    // clz and ctz of 0 are the full width, log2 of 0 is -1
    printf("32 bit versions of 40: clz32 = %d, ctz32 = %d\n", bits.clz32(40), bits.ctz32(40));
    printf("-1 has %d bits set\n", bits.popcount(-1));

    // powers of two
    int tests[4] = {64, 100, 1, 0};
    for (int i = 0; i < 4; i++) {
        printf("%3d: isPow2 = %d, nextPow2 = %d\n", tests[i], bits.isPow2(tests[i]), bits.nextPow2(tests[i]));
    }
    printf("mask(5) = %d, mask(12) = 0x%X, mask(64) = %d\n", bits.mask(5), bits.mask(12), bits.mask(64));
    return 0;
}
