// Single bits, bit fields and signed values in a few bits
import bits;

int main() {
    // single bits
    int flags = 0;
    flags = bits.set(flags, 0);
    flags = bits.set(flags, 3);
    flags = bits.flip(flags, 1);
    printf("flags = %d (0b%b), bit 3 = %d, bit 2 = %d\n", flags, flags, bits.get(flags, 3), bits.get(flags, 2));
    flags = bits.clear(flags, 0);
    printf("after clear(0): %b\n", flags);

    // a 16 bit RGB565 colour: 5 bits red, 6 bits green, 5 bits blue
    int c = 0xF81F;                                  // magenta
    printf("RGB565 0x%04X: r=%d g=%d b=%d\n", c, bits.field(c, 11, 5), bits.field(c, 5, 6), bits.field(c, 0, 5));
    int dark = bits.insert(c, 5, 6, 0x10);           // set green to 16
    printf("green changed: 0x%04X\n", dark);

    // the low bits as a signed number: a 12 bit sample from a sensor
    int raw = 0xFF6;
    printf("12-bit 0x%X as signed: %d\n", raw, bits.signExtend(raw, 12));
    printf("signExtend(0x7F, 8) = %d, signExtend(0x80, 8) = %d\n", bits.signExtend(0x7F, 8), bits.signExtend(0x80, 8));
    printf("fitsSigned(127, 8) = %d, fitsSigned(128, 8) = %d, fitsUnsigned(255, 8) = %d\n",
           bits.fitsSigned(127, 8), bits.fitsSigned(128, 8), bits.fitsUnsigned(255, 8));

    // unsigned 64-bit helpers for plain ints
    int big = -1;                                    // 2^64 - 1 as an unsigned value
    printf("udiv(-1, 10) = %d\n", bits.udiv(big, 10));
    printf("umod(-1, 10) = %d\n", bits.umod(big, 10));
    printf("ucmp(-1, 5) = %d (above), but as signed numbers -1 < 5 is %d\n", bits.ucmp(big, 5), big < 5);
    return 0;
}
