// Sizes, hexadecimal text and hex dumps
import bytebuf;

int main() {
    // sizes for people: powers of 1024 or of 1000
    int sizes[5] = {512, 1536, 1048576, 5000000, 3221225472};
    for (int i = 0; i < 5; i++) {
        printf("%10d  %-10s %s\n", sizes[i], bytebuf.humanSize(sizes[i]), bytebuf.humanSizeSI(sizes[i]));
    }

    // parsing them: "10MB" is decimal, "10M" and "10MiB" are binary, -1 means not a size
    char* texts[6] = {"10MB", "10M", "10MiB", "2 KB", "1.5G", "ten"};
    for (int i = 0; i < 6; i++) { printf("parseSize(%s) = %d\n", texts[i], bytebuf.parseSize(texts[i])); }

    // hexadecimal text of binary data, and back
    println(bytebuf.hex("Hello", 5));
    int n;
    char* raw = bytebuf.fromHex("48656c6c6f21", &n);
    printf("%d bytes: %s\n", n, raw);

    // a classic hex dump: offset, 16 bytes in hex, and the printable characters
    print(bytebuf.hexdump("The A language\n\x00\x01\xFF and more text here", 38));
    return 0;
}
