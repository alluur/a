// Dynamic programming and string algorithms
import algo;

int main() {
    int gains[9] = {-2, 1, -3, 4, -1, 2, 1, -5, 4};
    printf("best run of consecutive elements sums to %d\n", algo.maxSubarray(gains, 9));

    int seq[8] = {10, 9, 2, 5, 3, 7, 101, 18};
    printf("longest increasing subsequence: %d\n", algo.lis(seq, 8));

    printf("editDistance(kitten, sitting) = %d\n", algo.editDistance("kitten", "sitting"));
    printf("lcsLength(AGGTAB, GXTXAYB) = %d\n", algo.lcsLength("AGGTAB", "GXTXAYB"));
    printf("kmpFind(abracadabra, cad) = %d\n", algo.kmpFind("abracadabra", "cad"));
    printf("countOccurrences(abracadabra, abra) = %d\n", algo.countOccurrences("abracadabra", "abra"));
    printf("isSubsequence(ace, abcde) = %d\n", algo.isSubsequence("ace", "abcde"));
    printf("isSubsequence(aec, abcde) = %d\n", algo.isSubsequence("aec", "abcde"));

    // the sieve of Eratosthenes: flags[i] is 1 when i is prime
    char flags[51];
    int count = algo.sieve(50, flags);
    printf("%d primes up to 50:", count);
    for (int i = 0; i <= 50; i++) { if (flags[i]) { printf(" %d", i); } }
    println("");

    // 0/1 knapsack: the best value that fits into the capacity
    int weights[4] = {1, 3, 4, 5};
    int values[4] = {1, 4, 5, 7};
    printf("knapsack(capacity 7) = %d\n", algo.knapsack(weights, values, 4, 7));
    return 0;
}
