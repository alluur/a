// A hash map from ints to ints: remembering results
import collections;

collections.IntMap memo;

// the length of the Collatz chain of n, remembered for every number seen
int chain(int n) {
    if (n == 1) { return 1; }
    if (memo.has(n)) { return memo.get(n, 0); }
    int next = n % 2 == 0 ? n / 2 : 3 * n + 1;
    int len = 1 + chain(next);
    memo.put(n, len);
    return len;
}

int main() {
    int best = 1;
    int bestLen = 1;
    for (int n = 1; n <= 30; n++) {
        int len = chain(n);
        if (len > bestLen) { best = n; bestLen = len; }
    }
    printf("longest chain below 31: n = %d with %d steps\n", best, bestLen);
    printf("remembered %d numbers\n", memo.size());
    printf("memo[27] = %d, memo[1000003] = %d (fallback)\n", memo.get(27, -1), memo.get(1000003, -1));

    // walk the slots: usedAt tells which hold a key (the order is by hash, not by insertion)
    int longer = 0;
    for (int s = 0; s < memo.capacity(); s++) {
        if (memo.usedAt(s) && memo.valueAt(s) > 100) { longer++; }
    }
    printf("%d remembered numbers have a chain longer than 100\n", longer);
    return 0;
}
