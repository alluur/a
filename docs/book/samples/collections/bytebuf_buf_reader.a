// Building a binary message with Buf and parsing it with Reader
import bytebuf;

int main() {
    // message: magic "AB", a 4 byte length (filled in last), a version, a name and a few numbers
    bytebuf.Buf* b = new bytebuf.Buf();
    b->text("AB");
    int lenAt = b->size();
    b->u32be(0);                                     // a placeholder for the length
    b->u8(2);
    b->cstr("sensor-7");                             // text with its NUL
    b->u16be(1500);
    b->varint(300);                                  // a compact number: 7 bits per byte
    b->svarint(-5);                                  // signed, zig-zag coded
    b->patch32be(lenAt, b->size() - 6);              // now fill in the real length
    printf("message is %d bytes:\n%s", b->size(), bytebuf.hexdump(b->data, b->size()));

    // reading it back; every read is range checked
    bytebuf.Reader* r = new bytebuf.Reader(b->data, b->size());
    r->skip(2);
    int length = r->u32be();
    int version = r->u8();
    char* name = r->cstr();
    int port = r->u16be();
    int big = r->varint();
    int neg = r->svarint();
    printf("length=%d version=%d name=%s port=%d varint=%d svarint=%d\n", length, version, name, port, big, neg);
    printf("left over: %d, bad: %d\n", r->remaining(), r->bad);

    // reading past the end gives 0 and sets the bad flag
    int more = r->u32le();
    printf("past the end: %d, bad: %d\n", more, r->bad);
    return 0;
}
