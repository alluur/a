// A growable list of strings
import collections;
import sort;

int main() {
    collections.StrList* names = new collections.StrList();
    names->push("pear");
    names->push("apple");
    names->push("fig");
    names->push("banana");

    // the list keeps the pointers; it does not copy the text
    printf("size = %d, first = %s, indexOf(fig) = %d\n", names->size(), names->get(0), names->indexOf("fig"));
    printf("get(9) is null: %d\n", names->get(9) == null);

    sort.sortStrings(names->items(), names->size());     // in place, by byte value
    for (int i = 0; i < names->size(); i++) { printf("%d: %s\n", i, names->get(i)); }

    printf("pop = %s, size = %d\n", names->pop(), names->size());
    return 0;
}
