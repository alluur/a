// A growable list of ints, also usable as a stack
import collections;
import sort;

void show(char* label, collections.IntList* l) {
    printf("%-14s", label);
    for (int i = 0; i < l->size(); i++) { printf(" %d", l->get(i)); }
    println("");
}

int main() {
    collections.IntList* l = new collections.IntList();
    for (int i = 1; i <= 5; i++) { l->push(i * 10); }
    show("pushed", l);

    l->insert(2, 25);                     // shifts the rest to the right
    show("insert(2, 25)", l);
    printf("removeAt(0) = %d\n", l->removeAt(0));
    show("after", l);
    printf("indexOf(40) = %d, has(99) = %d\n", l->indexOf(40), l->has(99));

    l->set(1, 22);
    l->reverse();
    show("set+reverse", l);

    // as a stack: push and pop at the end
    printf("pop = %d, last = %d, size = %d\n", l->pop(), l->last(), l->size());

    // out of range is not an error: get returns 0 and set does nothing
    printf("get(100) = %d\n", l->get(100));

    // items() gives the raw array, ready for the sort module
    sort.sortInts(l->items(), l->size());
    show("sorted", l);
    l->clear();
    printf("empty: %d\n", l->isEmpty());
    return 0;
}
