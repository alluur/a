// Reading and writing integers in a chosen byte order
import bytebuf;

void dump(char* p, int n) {
    for (int i = 0; i < n; i++) { printf("%02X ", p[i]); }
    println("");
}

int main() {
    char buf[16];
    bytebuf.putU32be(buf, 0xCAFEBABE);               // big endian: most significant byte first
    print("be: "); dump(buf, 4);
    bytebuf.putU32le(buf, 0xCAFEBABE);               // little endian: least significant first
    print("le: "); dump(buf, 4);

    // the same bytes read both ways
    printf("getU32be = 0x%X\n", bytebuf.getU32be(buf));
    printf("getU32le = 0x%X\n", bytebuf.getU32le(buf));
    printf("getU16le = 0x%X, getU16be = 0x%X\n", bytebuf.getU16le(buf), bytebuf.getU16be(buf));

    // signed readers: 0xFF is -1 as a byte, 65534 is -2 as 16 bits
    buf[0] = 0xFF; buf[1] = 0xFE; buf[2] = 0xFF; buf[3] = 0xFF;
    printf("getU8 = %d, getI8 = %d\n", bytebuf.getU8(buf), bytebuf.getI8(buf));
    printf("getU16be = %d, getI16be = %d\n", bytebuf.getU16be(buf), bytebuf.getI16be(buf));
    printf("getI32be = %d\n", bytebuf.getI32be(buf));

    // 64 bits: the value is a uint64
    bytebuf.putU64be(buf, 0x0102030405060708);
    print("u64be: "); dump(buf, 8);
    uint64 back = bytebuf.getU64le(buf);             // read the other way round
    printf("as little endian: 0x%016X\n", back);
    return 0;
}
