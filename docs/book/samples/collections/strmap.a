// Counting words with a hash map from strings to ints
import collections;
import sort;

int main() {
    char* text = "the cat saw the dog and the dog saw the cat";
    collections.StrMap counts;                     // an object on the stack
    char* words[16];
    int n = 0;
    int start = 0;
    for (int i = 0;; i++) {                        // split on blanks by hand
        if (text[i] == ' ' || text[i] == 0) {
            words[n] = substr(text, start, i - start);
            counts.put(words[n], counts.get(words[n], 0) + 1);   // fallback 0 for a new word
            n++;
            start = i + 1;
            if (text[i] == 0) { break; }
        }
    }
    printf("%d words, %d distinct\n", n, counts.size());

    // the slots come in hash order: collect the keys and sort them to print in a stable order
    char* keys[16];
    int k = 0;
    for (int s = 0; s < counts.capacity(); s++) {
        if (counts.keyAt(s) != null) { keys[k] = counts.keyAt(s); k++; }
    }
    sort.sortStrings(keys, k);
    for (int i = 0; i < k; i++) { printf("%-4s %d\n", keys[i], counts.get(keys[i], 0)); }

    printf("has dog: %d, has cow: %d\n", counts.has("dog"), counts.has("cow"));
    printf("remove dog: %d, again: %d, size now %d\n", counts.remove("dog"), counts.remove("dog"), counts.size());
    return 0;
}
