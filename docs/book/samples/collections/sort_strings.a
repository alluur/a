// Sorting strings by byte value
import sort;

int main() {
    char* names[6] = {"mango", "Zebra", "apple", "Banana", "cherry", "apple pie"};
    sort.sortStrings(names, 6);                     // moves the pointers, not the text
    for (int i = 0; i < 6; i++) { println(names[i]); }
    // capital letters come first because 'A'..'Z' (65..90) are below 'a'..'z' (97..122)

    // for a case-blind order, sort lower-case copies and keep the originals alongside
    char* keys[6];
    for (int i = 0; i < 6; i++) { keys[i] = strdup(names[i]); strLower(keys[i]); }
    sort.sortStrings(keys, 6);
    println("case-blind:");
    for (int i = 0; i < 6; i++) { printf("  %s\n", keys[i]); }
    return 0;
}
