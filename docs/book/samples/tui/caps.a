// What a terminal can do, worked out from its TERM name
import term;

void show(char* termName, char* colorTerm, bool utf8, bool noColor) {
    term.Caps c;
    term.capsFor(&c, termName, colorTerm, utf8, noColor);   // the pure function behind capsFromEnv()
    printf("%-18s colours %-8d", termName, c.colors);
    printf(" utf8 %d mouse %d altScreen %d paste %d title %d\n", c.utf8, c.mouse, c.altScreen, c.bracketedPaste, c.title);
}

int main() {
    show("xterm", null, true, false);
    show("xterm-256color", null, true, false);
    show("xterm", "truecolor", true, false);         // COLORTERM raises an xterm to 24 bit
    show("kitty", null, true, false);
    show("linux", null, true, false);                // the Linux console: no mouse, no alternate screen
    show("vt100", null, true, false);
    show("dumb", null, true, false);
    show("xterm-256color", null, true, true);        // NO_COLOR removes colours
    show("xterm-256color", null, false, false);      // a C locale: ASCII instead of box drawing

    // dumb terminals cannot address the cursor, so a full screen program must refuse to start
    term.Caps d;
    term.capsFor(&d, "dumb", null, true, false);
    printf("dumb can address the cursor: %d\n", d.cursorAddr);
    return 0;
}
