// How many cells a character takes
import tscreen;

void show(char* label, char* text) {
    printf("%-22s %2d cells, %2d bytes\n", label, tscreen.textWidth(text), strlen(text));
}

int main() {
    show("ASCII", "hello");
    show("accented (Latin-1)", "h\xc3\xa9llo");
    show("CJK (wide)", "\xe4\xb8\x96\xe7\x95\x8c");              // two characters, two cells each
    show("emoji (wide)", "\xf0\x9f\x98\x80");                      // one character, two cells
    show("e + combining acute", "e\xcc\x81");                      // two code points, one cell
    show("fullwidth A", "\xef\xbc\xa1");

    // a wide character at the edge of a screen does not fit: it is replaced by a blank
    tscreen.Screen s(5, 1);
    s.clear(0);
    s.text(0, 0, "ab\xe4\xb8\x96\xe7\x95\x8c", 0);                // a, b, then 2 wide characters: only one fits (cells 2-3), the next one does not
    print("on a 5 column screen: ");
    print(s.dump());                                              // 'ab' + one wide character; the second does not fit

    // fitBytes: how many bytes of a text fit into n cells (never cuts a character)
    char* t = "ab\xe4\xb8\x96\xe7\x95\x8c";
    printf("fitBytes(%d cells) = %d, fitBytes(3) = %d\n", 6, tscreen.fitBytes(t, 6), tscreen.fitBytes(t, 3));
    return 0;
}
