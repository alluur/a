// Key names: from text to a key, and from a key back to the bytes a terminal sends
import term;

// print the bytes readably
void showBytes(char* b, int n) {
    for (int i = 0; i < n; i++) {
        int c = b[i] & 255;
        if (c == 27) print("ESC ");
        else if (c < 32) { print("^"); printChar(c + 64); print(" "); }
        else { printChar(c); print(" "); }
    }
}

void roundTrip(char* spec) {
    int mods = 0;
    int key = term.parseKey(spec, &mods);          // "Ctrl+S" -> 's' with MOD_CTRL
    if (key < 0) { printf("%-12s not a key\n", spec); return; }
    char name[40];
    term.keyName(key, mods, &name[0], 40);         // and back: the canonical spelling
    char bytes[16];
    int n = term.encodeKey(key, mods, &bytes[0]);  // what a terminal would send
    printf("%-12s -> %-12s mods %d  bytes: ", spec, &name[0], mods);
    showBytes(&bytes[0], n);
    println("");
}

int main() {
    roundTrip("Ctrl+S");
    roundTrip("ctrl-alt-up");
    roundTrip("Shift+Tab");
    roundTrip("F10");
    roundTrip("Alt+Enter");
    roundTrip("Hyper+Q");

    // keyIs compares an event with a key name; an upper case letter counts as Shift + the letter
    term.Decoder dec();
    term.Event e;
    dec.feedText("\eF");                           // Alt+Shift+F arrives as ESC F
    dec.next(&e);
    printf("Alt+Shift+F matches: %d, Alt+F matches: %d\n", term.keyIs(&e, "Alt+Shift+F"), term.keyIs(&e, "Alt+F"));
    return 0;
}
