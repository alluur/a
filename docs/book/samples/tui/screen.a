// Drawing into a screen buffer without any terminal
import tscreen;

int main() {
    tscreen.Screen s(34, 7);                     // a stack object needs the parentheses: they run the constructor
    s.clear(0);
    // a style is one int: foreground, background, attributes
    int cyan = tscreen.style(tscreen.CYAN, 0, 0);
    int gold = tscreen.style(tscreen.rgb(255, 200, 0), 0, tscreen.A_BOLD);
    s.box(1, 0, 32, 5, tscreen.BOX_ROUND, cyan);
    int next = s.text(3, 1, "Hello, ", gold);    // text() returns the column after the text
    s.text(next, 1, "wide: \xe4\xb8\x96\xe7\x95\x8c", gold);
    s.textEllipsis(3, 2, "this text is much too long for the box", 28, 0);
    s.hline(2, 3, 30, '=', cyan);

    // everything is clipped: nothing leaves the rectangle
    s.pushClip(0, 5, 10, 1);
    s.text(0, 5, "clipped to ten cells", 0);
    s.popClip();
    print(s.dump());                             // the grid as plain text, one line per row

    // the cells keep their style: read one back
    int st = s.styleAt(4, 1);
    printf("bold: %d, foreground is 24 bit: %d\n", tscreen.attrOf(st) & tscreen.A_BOLD, tscreen.fgOf(st) >> 24 == 1);
    return 0;
}
