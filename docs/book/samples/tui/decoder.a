// Turning terminal bytes into key, mouse and paste events
import term;

term.Decoder* dec;

// A terminal sends escape sequences. Show them readably, then what they decode to.
void show(char* label, char* bytes) {
    term.Event e;
    char name[64];
    dec->feedText(bytes);
    dec->flush();                         // the Esc timeout has "expired": a lone Esc is a key
    print(label);
    print(":");
    while (dec->next(&e)) {
        term.describe(&e, &name[0], 64);
        print("  ");
        print(&name[0]);
    }
    println("");
}

int main() {
    dec = new term.Decoder();
    show("letter", "a");
    show("UTF-8", "\xc3\xa9");            // e with an acute accent: one key, the code point
    show("Ctrl+S", "\x13");
    show("arrow keys", "\e[A\e[B\eOC\eOD");
    show("Ctrl+Up", "\e[1;5A");
    show("Alt+x", "\ex");
    show("F5", "\e[15~");
    show("Shift+Tab", "\e[Z");
    show("mouse click", "\e[<0;10;5M\e[<0;10;5m");   // SGR: press, release at column 10, row 5 (1 based)
    show("wheel", "\e[<64;3;3M");
    show("paste", "\e[200~hello\nworld\e[201~");
    show("lone Esc", "\e");
    return 0;
}
