// The command palette and fuzzy matching
import tui;
import tuix;

tui.App* app;
char ran[40];

int run(int which) {
    format(&ran[0], 40, "ran command %d", which, 0, 0, 0);
    return 0;
}

int main() {
    // fuzzyScore(pattern, text, positions, max): the letters of the pattern must appear in order.
    // -1 is no match; consecutive letters and word starts score higher.
    int pos[8];
    char* texts[4] = {"Save File", "Show Foo", "Toggle Sidebar", "Open File"};
    for (int i = 0; i < 4; i++) {
        int score = tuix.fuzzyScore("sf", texts[i], &pos[0], 8);
        printf("sf in %-15s score %d", texts[i], score);
        if (score >= 0) { printf(", letters at %d and %d", pos[0], pos[1]); }
        println("");
    }

    app = new tui.App();
    app->initHeadless(44, 12);
    app->setRoot(new tui.Label("the editor"));
    // a command has a name, an optional key (it is registered as a shortcut too) and a function
    app->addCommand("File: Save", "Ctrl+S", run, 1);
    app->addCommand("File: Open", "Ctrl+O", run, 2);
    app->addCommand("View: Toggle sidebar", "Ctrl+B", run, 3);
    app->addCommand("Run: Build and run", "F5", run, 4);
    app->pump(0);

    tui.Dialog* palette = tuix.newCommandPalette(app);
    app->showDialog(palette);
    app->type("sb");                         // s...b: "Toggle sidebar" is the only match
    println(app->text());
    app->press("Enter");
    printf("%s\n", &ran[0]);

    app->press("Ctrl+O");                    // the key given to addCommand works anywhere
    printf("%s\n", &ran[0]);
    return 0;
}
