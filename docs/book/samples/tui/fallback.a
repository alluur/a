// The same program on a poor terminal: fewer colours, no mouse, ASCII boxes
// book: tui compile-only
import tui;

int main() {
    tui.App* app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    // app->caps says what the terminal can do; the toolkit already picked a theme to match
    char info[120];
    format(&info[0], 120, "colours: %d, utf8: %d, mouse: %d", app->caps->colors, app->caps->utf8, app->caps->mouse, 0);
    tui.Frame* frame = new tui.Frame("Capabilities");
    tui.Box* col = tui.vbox(1, 1);
    col->add(new tui.Label(&info[0]));
    tui.CheckBox* c = new tui.CheckBox("a check box");
    c->checked = true;
    col->add(c);
    tui.ProgressBar* p = new tui.ProgressBar();
    p->setValue(60);
    col->add(p);
    frame->add(col);
    app->setRoot(frame);
    return app->run();
}
