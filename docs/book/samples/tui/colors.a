// Colours are downgraded to the nearest colour the terminal has
import tscreen;
import term;

void show(char* name, int colour) {
    printf("%-14s", name);
    int depths[3] = {term.COLORS_256, term.COLORS_16, term.COLORS_8};
    for (int i = 0; i < 3; i++) {
        int c = tscreen.downgrade(colour, depths[i]);
        // a palette colour is idx(n): the low byte is the entry n
        printf("  %3d: %s %-3d", depths[i], (c >> 24) == 2 ? "idx" : "???", c & 255);
    }
    println("");
}

int main() {
    show("orange", tscreen.rgb(255, 128, 0));
    show("sea green", tscreen.hex(0x20B2AA));
    show("light gray", tscreen.rgb(200, 200, 200));
    show("bright red", tscreen.BRIGHT_RED);        // 16 colours keep it; 8 colours make it plain red (and bold)
    show("palette 208", tscreen.idx(208));          // a 256 colour entry
    // the default colour (0) is never changed
    printf("default colour stays: %d\n", tscreen.downgrade(0, term.COLORS_8) == 0);
    // no colours at all: everything becomes the default colour
    printf("no colours: %d\n", tscreen.downgrade(tscreen.rgb(1, 2, 3), term.COLORS_NONE) == 0);
    // the nearest ANSI colour of a 24 bit value, and the palette entry of the xterm 256 cube
    printf("nearest16(0xFF8000) = %d, paletteRgb(208) = %06x\n", tscreen.nearest16(0xFF8000), tscreen.paletteRgb(208));
    return 0;
}
