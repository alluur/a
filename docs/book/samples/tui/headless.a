// Driving an application without a terminal
import tui;

tui.App* app;
tui.Label* status;
tui.TextInput* name;
tui.CheckBox* shout;

int onGo(int input) {
    char text[80];
    format(&text[0], 80, shout->checked ? "HELLO, %s!" : "Hello, %s!", name->getText(), 0, 0, 0);
    status->setText(&text[0]);
    return 0;
}

int main() {
    app = new tui.App();
    app->initHeadless(36, 7);                       // a 36 x 7 screen, no terminal: events come from feed()
    tui.Frame* frame = new tui.Frame("Form");
    tui.Box* col = tui.vbox(0, 1);
    status = new tui.Label("(nothing yet)");
    name = new tui.TextInput("");
    name->onEnter = onGo;
    shout = new tui.CheckBox("&Shout");
    col->add(status);
    col->add(name);
    col->add(shout);
    frame->add(col);
    app->setRoot(frame);
    app->pump(0);                                   // lay out and paint one frame
    println(app->text());                           // the screen as text

    app->type("Ada");                               // keys go to the focused widget: the text field
    app->press("Alt+S");                            // a mnemonic: the & in "&Shout"
    app->press("Enter");
    println(app->text());

    app->click(3, 4);                               // a mouse click (column, row) on the check box: it unchecks it
    app->click(3, 3);                               // a click in the text field gives it the focus again
    app->press("Enter");
    println(app->text());
    printf("shout is %d, focus is on the text field: %d\n", shout->checked, app->focus == name);
    return 0;
}
