// Reading a directory for a file picker
import tuix;
import cunistd;

int main() {
    // build a small tree in the current directory (a sample runs in a scratch directory)
    mkdir("project");
    mkdir("project/src");
    writeFile("project/main.a", "int main() { return 0; }\n");
    writeFile("project/README", "notes\n");
    writeFile("project/.hidden", "x");
    writeFile("project/Zebra.txt", "z");

    tuix.DirList dl;
    dl.load("project", false, true);          // (directory, show hidden files, ask for sizes)
    dl.sort();                                // directories first, then by name without regard to case
    for (int i = 0; i < dl.count; i++) {
        if (dl.isDir(i)) { printf("%s/\n", dl.name(i)); }
        else { printf("%-10s %3d bytes\n", dl.name(i), dl.sizeOf(i)); }
    }
    dl.load("project", true);                 // with hidden files
    printf("with hidden files: %d entries\n", dl.count);

    // path helpers that never touch the disk
    printf("%s\n", tuix.joinPath("project", "main.a"));
    printf("%s\n", tuix.parentPath("/home/ada/project"));
    printf("%s\n", tuix.cleanPath("/home/ada", "../bob/./notes"));
    return 0;
}
