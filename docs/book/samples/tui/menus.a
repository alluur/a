// A menu bar with accelerators and a submenu
import tui;

tui.App* app;
char last[60];

// every menu item calls f(item); the item is passed as an int
int act(int item) {
    tui.MenuItem* it = (tui.MenuItem*) item;
    char plain[40];
    int n = 0;
    char* t = it->text.str();
    for (int i = 0; t[i] != 0 && n < 38; i++) {          // the text still has its mnemonic marker '&'
        if (t[i] != '&') { plain[n] = t[i]; n++; }
    }
    plain[n] = 0;
    format(&last[0], 60, "last action: %s", &plain[0], 0, 0, 0);
    return 0;
}

int main() {
    app = new tui.App();
    app->initHeadless(34, 11);
    tui.Box* col = tui.vbox(0, 0);
    tui.MenuBar* bar = new tui.MenuBar();
    tui.Menu* file = bar->addMenu("&File");               // Alt+F opens it
    file->add("&New", act, "Ctrl+N");                      // the accelerator text is also the shortcut
    file->add("&Open...", act, "Ctrl+O");
    file->addSeparator();
    tui.MenuItem* wrap = file->addCheck("&Wrap lines", true, act);
    tui.Menu* recent = file->addSub("&Recent");
    recent->add("one.a", act);
    recent->add("two.a", act);
    file->add("&Quit", act, "Ctrl+Q");
    tui.Menu* help = bar->addMenu("&Help");
    help->add("&About", act, "F1");
    col->add(bar);
    tui.Label* body = new tui.Label("body of the program");
    body->flex = 1;
    col->add(body);
    app->setMenuBar(bar);                                   // F10, Alt+letter and the accelerators now work everywhere
    app->setRoot(col);
    app->pump(0);

    app->press("Alt+F");
    println(app->text());                                   // the open menu: the first item is selected
    app->press("Escape");
    println(app->text());                                   // closed again: only the bar and the body

    app->press("Ctrl+O");                                   // an accelerator works with the menu closed
    printf("%s\n", &last[0]);
    app->press("F10");
    app->press("w");                                        // a letter chooses the item with that mnemonic
    printf("%s, checked now: %d\n", &last[0], wrap->checked);
    return 0;
}
