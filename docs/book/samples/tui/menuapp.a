// A menu bar, shortcuts and a status line
// book: tui compile-only
import tui;

tui.App* app;
tui.TextInput* editor;
tui.StatusBar* status;

int doNew(int item) { editor->setText(""); status->message("new document", 3000); return 0; }
int doUpper(int item) {
    // change the text in place
    char* t = editor->getText();
    char buf[200];
    int n = 0;
    for (; t[n] != 0 && n < 198; n++) { buf[n] = (t[n] >= 'a' && t[n] <= 'z') ? t[n] - 32 : t[n]; }
    buf[n] = 0;
    editor->setText(&buf[0]);
    return 0;
}
int doQuit(int item) { app->quit(0); return 0; }

int main() {
    app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    app->setTitle("menu demo");

    tui.MenuBar* bar = new tui.MenuBar();
    tui.Menu* file = bar->addMenu("&File");
    file->add("&New", doNew, "Ctrl+N");
    file->addSeparator();
    file->add("&Quit", doQuit, "Ctrl+Q");
    tui.Menu* edit = bar->addMenu("&Edit");
    edit->add("&Upper case", doUpper, "Ctrl+U");
    app->setMenuBar(bar);                          // F10 and Alt+letter open the menus; the accelerators work everywhere
    app->addShortcut("Ctrl+C", doQuit);            // in raw mode Ctrl+C is an ordinary key: say what it does

    tui.Box* col = tui.vbox(0, 0);
    col->add(bar);
    col->add(new tui.Label(" Type something, then try Edit > Upper case.\n\n"));   // room for the menu to drop into
    editor = new tui.TextInput("type here");
    col->add(editor);
    tui.Label* fill = new tui.Label("");
    fill->flex = 1;
    col->add(fill);
    status = new tui.StatusBar();
    status->set(0, "F10 opens the menu");
    col->add(status);
    app->setRoot(col);
    return app->run();
}
