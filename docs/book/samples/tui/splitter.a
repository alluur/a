// A splitter that you drag with the mouse
// book: tui compile-only
import tui;

int main() {
    tui.App* app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    tui.Splitter* split = new tui.Splitter(true);       // side by side
    tui.Frame* left = new tui.Frame("Left");
    left->add(new tui.Label("drag the\ndivider"));
    tui.Frame* right = new tui.Frame("Right");
    right->add(new tui.Label("with the mouse"));
    split->add(left);
    split->add(right);
    app->setRoot(split);
    return app->run();
}
