// Running a child program and collecting its output
// book: linux-only
import term;

int main() {
    term.Process p;
    // startShell runs a command line through /bin/sh; standard output and standard error
    // of the child come through ONE pipe (p.fd), which a real program watches next to the keyboard
    if (!p.startShell("echo first; echo to-stderr 1>&2; echo last; exit 3")) {
        println("cannot start");
        return 1;
    }
    char buf[256];
    int total = 0;
    for (;;) {
        int n = p.read(&buf[total], 200 - total);       // 0 at the end of the output
        if (n <= 0) { break; }
        total = total + n;
    }
    buf[total] = 0;
    print(&buf[0]);
    int status = p.finish();                             // waits for the child, returns its exit status
    printf("%d bytes, exit status %d\n", total, status);
    return 0;
}
