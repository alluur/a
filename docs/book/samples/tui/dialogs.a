// Dialogs: a custom dialog, then the ready-made questions
import tui;
import tuix;

tui.App* app;

int main() {
    app = new tui.App();
    app->initHeadless(46, 11);
    app->setRoot(new tui.Label("the program behind the dialogs"));
    app->pump(0);

    // a Dialog holds a content widget and buttons; showDialog returns at once
    tui.Label* text = new tui.Label(tuix.wrapText("The file has changed on disk. Load it again?", 30));
    tui.Dialog* d = new tui.Dialog("File changed", text);
    d->addButton("&Reload", 1, true);                  // (label, result code, is the default button)
    d->addButton("&Keep mine", 2);
    app->showDialog(d);
    println(app->text());
    app->press("Alt+K");                               // the mnemonic presses the button
    printf("result %d, dialog still open: %d\n", d->result, d->open);

    // the blocking forms run a nested event loop. A headless app cannot wait for a person,
    // so the keys are queued first with inject(); a real program just calls them
    app->inject("\r");
    printf("askYesNo + Enter: %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));
    app->inject("\x1b" "n");                           // Alt+N: the mnemonic of &No
    printf("askYesNo + Alt+N: %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));
    app->inject("\x1b");
    printf("askYesNo + Esc: %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));

    app->inject("Ada\r");
    char* who = tuix.prompt(app, "Name", "Your name:", "");
    printf("prompt returned '%s'\n", who);
    app->inject("\x1b");
    printf("a cancelled prompt returns null: %d\n", tuix.prompt(app, "Name", "Your name:", "") == null);
    return 0;
}
