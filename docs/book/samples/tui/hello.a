// A first full screen program: a label, a text field and two buttons
// book: tui compile-only
import tui;

tui.App* app;
tui.Label* greeting;
tui.TextInput* name;

int onGreet(int button) {
    char* who = name->getText();
    char text[120];
    format(&text[0], 120, "Hello, %s!", who[0] ? who : "world", 0, 0, 0);
    greeting->setText(&text[0]);
    return 0;
}

int onQuit(int button) { app->quit(0); return 0; }

int main() {
    app = new tui.App();
    // start() takes over the terminal: raw mode, alternate screen, mouse.
    // It returns false when there is no terminal (a pipe, TERM=dumb).
    if (!app->start()) {
        println("this program needs a terminal");
        return 1;
    }
    tui.Frame* frame = new tui.Frame("Greeter");
    tui.Box* col = tui.vbox(1, 1);
    greeting = new tui.Label("Type a name and press Greet.");
    name = new tui.TextInput("");
    name->onEnter = onGreet;           // Enter in the field does what the button does
    tui.Button* greet = new tui.Button("&Greet");
    greet->onClick = onGreet;
    tui.Button* quit = new tui.Button("&Quit");
    quit->onClick = onQuit;
    tui.Box* row = tui.hbox(2, 0);
    row->add(greet);
    row->add(quit);
    col->add(greeting);
    col->add(name);
    col->add(row);
    frame->add(col);
    app->setRoot(frame);
    return app->run();     // until quit(); the terminal is restored on the way out
}
