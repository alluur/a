// An application with tabs: a tree, a table and a form
// book: tui compile-only
import tui;
import tuix;

tui.App* app;
tui.StatusBar* status;
tuix.Table* table;

int onSelectRow(int t) {
    char text[80];
    format(&text[0], 80, "%s selected", table->cell(table->selectedRow(), 0), 0, 0, 0);
    status->set(0, &text[0]);
    return 0;
}

int onQuit(int item) { app->quit(0); return 0; }

int main() {
    app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    app->addShortcut("Ctrl+Q", onQuit);

    tui.TabView* tabs = new tui.TabView();

    tuix.TreeView* tree = new tuix.TreeView();
    int lib = tree->addNode(0, "lib", 0, false);
    tree->addNode(lib, "term.a", 0, false);
    tree->addNode(lib, "tscreen.a", 0, false);
    tree->addNode(lib, "tui.a", 0, false);
    tree->addNode(0, "main.a", 0, false);
    tree->addNode(0, "README.md", 0, false);
    tabs->addPage(tree, "&Tree");

    table = new tuix.Table();
    table->addColumn("Module", 0);
    table->addColumn("Lines", 8, 2);
    table->addRow("term", "1962");
    table->addRow("tscreen", "1005");
    table->addRow("tui", "3797");
    table->addRow("tuix", "2079");
    table->onSelect = onSelectRow;
    tabs->addPage(table, "T&able");

    tui.Box* form = tui.vbox(1, 1);
    form->add(new tui.CheckBox("Wrap lines"));
    tui.Slider* volume = new tui.Slider();
    volume->max = 10;
    volume->value = 4;
    form->add(volume);
    tui.ProgressBar* bar = new tui.ProgressBar();
    bar->setValue(35);
    form->add(bar);
    tabs->addPage(form, "&Form");

    tui.Box* col = tui.vbox(0, 0);
    tabs->flex = 1;
    col->add(tabs);
    status = new tui.StatusBar();
    status->set(0, "Alt+1 .. Alt+3 switch tabs, Ctrl+Q quits");
    col->add(status);
    app->setRoot(col);
    return app->run();
}
