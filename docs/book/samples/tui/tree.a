// A tree whose branches are filled when you open them
import tui;
import tuix;

tui.App* app;
tuix.TreeView* tree;

// called once, the first time a lazy node is expanded: add its children now
int onExpand(int t, int node) {
    char name[40];
    for (int i = 1; i <= 3; i++) {
        format(&name[0], 40, "%s.%d", tree->nodeText(node), i, 0, 0);
        tree->addNode(node, &name[0], 0, false);      // (parent, text, your data, lazy)
    }
    printf("expanding %s\n", tree->nodeText(node));
    return 0;
}

int main() {
    app = new tui.App();
    app->initHeadless(22, 8);
    tree = new tuix.TreeView();
    tree->onExpand = onExpand;
    int src = tree->addNode(0, "src", 0, true);       // node 0 is the invisible root
    tree->addNode(0, "docs", 0, true);
    tree->addNode(0, "README", 0, false);
    app->setRoot(tree);
    app->pump(0);
    println(app->text());

    app->press("Right");                              // opens "src": the hook runs
    println(app->text());
    app->press("Left");                               // closes it again
    app->press("Right");                              // opens it again: the hook does not run twice
    app->press("Down");
    app->press("Down");
    printf("selected: %s, children of src: %d\n", tree->nodeText(tree->selected()), tree->childCount(src));
    return 0;
}
