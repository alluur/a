// The colour dialog
// book: tui compile-only
import tui;
import tuix;
import tscreen;

int main() {
    tui.App* app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    tui.Label* back = new tui.Label("");
    app->setRoot(back);
    // newColorDialog + showDialog is the form without waiting; colorDialog(app, initial) blocks
    tui.Dialog* d = tuix.newColorDialog(app, tscreen.rgb(200, 100, 50));
    app->showDialog(d);
    return app->run();
}
