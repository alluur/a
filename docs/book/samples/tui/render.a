// The diff renderer writes only what changed
import tscreen;
import term;

// show the escape sequences readably
void showOut(tscreen.Out* o) {
    for (int i = 0; i < o->n; i++) {
        int c = o->b[i] & 255;
        if (c == 27) { print("<ESC>"); }
        else if (c == 13) { print("<CR>"); }
        else { printChar(c); }
    }
    println("");
}

int main() {
    tscreen.Screen s(20, 3);
    tscreen.Out out();
    term.Caps caps();
    term.capsFor(&caps, "xterm-256color", null, true, false);

    s.clear(0);
    s.text(0, 0, "status: ready", 0);
    s.render(&out, &caps);
    printf("first frame: %d bytes\n", out.n);
    out.clear();

    s.render(&out, &caps);                      // nothing changed
    printf("same frame again: %d bytes\n", out.n);

    s.text(8, 0, "BUSY ", tscreen.style(tscreen.RED, 0, tscreen.A_BOLD));
    out.clear();
    s.render(&out, &caps);                      // one move, one style, five characters
    print("one word changed: ");
    showOut(&out);

    // the same colour on terminals with fewer colours
    s.text(0, 2, "colour", tscreen.style(tscreen.rgb(255, 128, 0), 0, 0));
    int depths[3] = {term.COLORS_TRUE, term.COLORS_256, term.COLORS_16};
    char* names[3] = {"24 bit:", "256:", "16:"};
    for (int i = 0; i < 3; i++) {
        caps.colors = depths[i];
        s.invalidate();                          // forget what the terminal shows: send everything
        out.clear();
        s.render(&out, &caps);
        print(names[i]);
        print(" ");
        showOut(&out);
    }
    return 0;
}
