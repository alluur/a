// The file open dialog, and what it returns
// book: tui compile-only
import tui;
import tuix;
import cunistd;

tui.App* app;
tui.Label* result;

int doOpen(int button) {
    // fileOpenDialog(app, title, start directory, filter) runs a nested event loop
    // and returns the full path, or null when the user cancelled
    char* start = tuix.joinPath(tuix.currentDir(), "docs");   // the start directory must be an absolute path
    char* path = tuix.fileOpenDialog(app, "Open a file", start, "");
    char text[200];
    format(&text[0], 200, "chosen: %s", path != null ? path : "(cancelled)", 0, 0, 0);
    result->setText(&text[0]);
    return 0;
}

int doQuit(int button) { app->quit(0); return 0; }

int main() {
    // a few files for the dialog to list (the program runs in a scratch directory)
    mkdir("docs");
    mkdir("docs/images");
    writeFile("docs/intro.md", "# intro\n");
    writeFile("docs/guide.md", "# guide\n");
    writeFile("docs/notes.txt", "notes\n");

    app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    tui.Box* col = tui.vbox(1, 1);
    tui.Button* open = new tui.Button("&Open...");
    open->onClick = doOpen;
    tui.Button* quit = new tui.Button("&Quit");
    quit->onClick = doQuit;
    result = new tui.Label("nothing chosen yet");
    col->add(open);
    col->add(quit);
    col->add(result);
    app->setRoot(col);
    return app->run();
}
