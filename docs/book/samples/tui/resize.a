// Following the size of the terminal
// book: tui compile-only
import tui;

tui.App* app;
tui.Label* size;

// called after the toolkit has changed the screen size (app->cols and app->rows are new; the layout is redone before the next frame)
int resized(int a) {
    char text[60];
    format(&text[0], 60, "the terminal is %d columns by %d rows", app->cols, app->rows, 0, 0);
    size->setText(&text[0]);
    return 0;
}

int main() {
    app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    tui.Frame* frame = new tui.Frame("Resize the window");
    size = new tui.Label("");
    frame->add(size);
    app->setRoot(frame);
    app->onResizeHook = resized;
    resized(0);                       // the first size is known after start()
    return app->run();
}
