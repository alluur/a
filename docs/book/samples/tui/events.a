// The low-level terminal layer: raw mode and a loop over events
// book: tui compile-only
import term;

int main() {
    term.Terminal t();                      // with the parentheses: they run the constructor
    if (!t.open()) { println("this program needs a terminal"); return 1; }
    t.enter();                              // raw mode, alternate screen, mouse and bracketed paste
    t.writeStr("\e[1;1HPress keys, click, paste. Ctrl+Q quits.\e[2;1H");
    int row = 3;
    term.Event e;
    char name[80];
    for (;;) {
        t.wait(250);                        // input, a resize or 250 ms
        while (t.next(&e)) {
            if (e.kind == term.EV_KEY && term.keyIs(&e, "Ctrl+Q")) { t.leave(); return 0; }
            term.describe(&e, &name[0], 80);
            char line[120];
            format(&line[0], 120, "\e[%d;1H%d: %s\e[K", row, row - 2, &name[0], 0);
            t.writeStr(&line[0]);
            if (row < 22) { row++; }
        }
    }
    return 0;
}
