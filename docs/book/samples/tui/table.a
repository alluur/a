// A table that sorts when you click a header
import tui;
import tuix;

int main() {
    tui.App* app = new tui.App();
    app->initHeadless(30, 7);
    tuix.Table* t = new tuix.Table();
    t->addColumn("Name", 0);                  // width 0: takes the space that is left
    t->addColumn("Size", 9, 2);               // (title, width, align): 2 = right
    t->addRow("main.a", "1204");
    t->addRow("util.a", "98");
    t->addRow("README", "3500");
    t->addRow("Makefile", "412");
    app->setRoot(t);
    app->pump(0);
    println(app->text());

    app->click(22, 0);                        // click the "Size" header: sorts by number, not by text
    println(app->text());
    app->click(22, 0);                        // again: the other direction
    println(app->text());
    app->click(2, 0);                         // the Name column: text, no matter the case
    println(app->text());
    return 0;
}
