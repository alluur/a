// Timers and the application loop: a clock you can fast-forward
import tui;

tui.App* app;
tui.Label* clock;
int ticks;
int fired;

int tick(int user) {
    ticks++;
    char text[40];
    format(&text[0], 40, "ticks: %d", ticks, 0, 0, 0);
    clock->setText(&text[0]);
    return 0;
}

int once(int user) { fired = user; return 0; }

int main() {
    app = new tui.App();
    app->initHeadless(20, 1);
    clock = new tui.Label("ticks: 0");
    app->setRoot(clock);
    app->pump(0);

    // addTimer(ms, function, your data, repeat) -> an id. A headless app has a fake clock,
    // so the program decides when time passes and the output never depends on the machine.
    int t = app->addTimer(100, tick, 0, true);
    app->addTimer(250, once, 42, false);
    for (int step = 1; step <= 4; step++) {
        app->advanceClock(100);
        app->pump(0);                         // runs the timers that are due, then repaints
        char row[40];
        app->screen->rowText(0, &row[0], 40);                  // what the screen shows in row 0
        printf("%3d ms: '%s'  one-shot fired: %d\n", step * 100, &row[0], fired);
    }
    app->cancelTimer(t);
    app->advanceClock(1000);
    app->pump(0);
    printf("after cancelling: ticks still %d\n", ticks);
    return 0;
}
