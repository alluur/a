// A text pane that follows program output and understands colour codes
import tui;
import tuix;
import tscreen;

int main() {
    tui.App* app = new tui.App();
    app->initHeadless(30, 5);
    tuix.TextPane* pane = new tuix.TextPane();
    app->setRoot(pane);
    app->pump(0);

    // output arrives in pieces, not in lines: an unfinished line is shown anyway
    pane->append("building ");
    pane->append("main.a\n");
    pane->append("\e[31merror\e[0m: missing ;\r\n");     // ANSI colours; \r\n is one newline
    pane->append("done");
    println(app->text());

    // the colour is in the style of the cell: 'error' starts at column 0 of line 1
    int st = app->screen->styleAt(0, 1);
    printf("'error' is red: %d, 'done' is the normal style: %d\n",
           tscreen.fgOf(st) == tscreen.RED, app->screen->styleAt(0, 2) == tui.theme->text);

    // more lines than rows: the pane follows the end, like a terminal
    for (int i = 1; i <= 6; i++) {
        char line[24];
        format(&line[0], 24, "\nline %d", i, 0, 0, 0);
        pane->append(&line[0]);
    }
    app->pump(0);
    println(app->text());
    printf("lines kept: %d, following the end: %d\n", pane->lineCount(), pane->follow);
    return 0;
}
