// Layout: boxes, flexible children, a splitter and tabs
import tui;

int main() {
    tui.App* app = new tui.App();
    app->initHeadless(44, 12);

    // a row: a fixed-width list, then a splitter between two panes that share the rest
    tui.Box* column = tui.vbox(0, 0);
    column->add(new tui.Label(" layout demo"));

    tui.Splitter* split = new tui.Splitter(true);       // true: side by side
    split->flex = 1;                                      // takes all the height that is left
    split->ratio = 400;                                   // the first pane gets 40 per cent

    tui.Frame* left = new tui.Frame("Files");
    left->add(new tui.Label("main.a\nutil.a"));
    split->add(left);

    tui.TabView* tabs = new tui.TabView();
    tabs->addPage(new tui.Label("the first page"), "&One");     // Alt+1 and Alt+2 also switch
    tabs->addPage(new tui.Label("the second page"), "&Two");
    split->add(tabs);
    column->add(split);

    tui.StatusBar* status = new tui.StatusBar();
    status->set(0, "ready");
    status->set(1, "Ln 1", 2);                            // segment 1, right aligned
    column->add(status);

    app->setRoot(column);
    app->pump(0);
    println(app->text());

    app->press("Alt+2");
    app->press("Tab");
    printf("page %d of %d is visible; splitter first pane: %d cells\n", tabs->current() + 1, tabs->pageCount(), split->firstSize());
    return 0;
}
