// A list that narrows as you type
import tui;

tui.App* app;
tui.ListView* list;
char chosen[40];

int onActivate(int l) {
    format(&chosen[0], 40, "chosen: %s (data %d)", list->selectedText(), list->selectedData(), 0, 0);
    return 0;
}

int main() {
    app = new tui.App();
    app->initHeadless(26, 7);
    list = new tui.ListView();
    list->filterable = true;                // typing narrows the list (a substring match, no case)
    list->onActivate = onActivate;          // Enter or a double click
    char* fruit[10] = {"apple", "apricot", "banana", "blueberry", "cherry", "date", "fig", "grape", "kiwi", "lemon"};
    for (int i = 0; i < 10; i++) { list->add(fruit[i], i * 100); }    // (text, your own data)
    app->setRoot(list);
    app->pump(0);
    println(app->text());                   // 10 items, 7 rows: a scroll bar on the right

    app->type("rr");                        // "berry" is not here, but "rr" is in blueberry and cherry
    println(app->text());
    app->press("Down");
    app->press("Enter");
    printf("%s\n", &chosen[0]);

    app->press("Backspace");
    app->press("Backspace");
    app->type("an");                        // banana
    printf("after typing 'an': %d item(s) shown, selected: %s\n", list->nshown, list->selectedText());
    return 0;
}
