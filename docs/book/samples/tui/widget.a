// Writing your own widget
import tui;
import tscreen;
import term;

// A meter you move with the arrow keys or by dragging.
public class Meter : tui.Widget {
public:
    int value;
    Meter() {
        super();                                  // do not forget: it sets up the widget
        focusable = true;                         // it can take the keyboard focus
    }
    virtual int prefW() { return 20; }            // the size it would like
    virtual int prefH() { return 1; }
    virtual void paint(tscreen.Screen* s, int ox, int oy) {
        // (ox, oy) is where the top left cell of the widget is on the screen
        s->fill(ox, oy, w, 1, ' ', tui.theme->progressTrack);
        s->fill(ox, oy, w * value / 100, 1, ' ', hasFocus() ? tui.theme->selection : tui.theme->progressFill);
        char label[8];
        format(&label[0], 8, "%d%%", value, 0, 0, 0);
        s->text(ox + 1, oy, &label[0], tscreen.withBg(tui.theme->text, tscreen.COL_KEEP));
    }
    virtual bool onKeyPress(term.Event* e) {      // return true when the key was used
        if (e->key == term.KEY_RIGHT) { value = value < 95 ? value + 5 : 100; invalidate(); return true; }
        if (e->key == term.KEY_LEFT) { value = value > 5 ? value - 5 : 0; invalidate(); return true; }
        return false;
    }
    virtual bool onMouse(term.Event* e, int lx, int ly) {   // lx, ly: relative to the widget
        if (e->button == term.MB_LEFT && e->action == term.MA_PRESS) {
            app->capture = this;                  // get all mouse events until the button is released
            value = lx * 100 / w;
            invalidate();
            return true;
        }
        if (e->action == term.MA_DRAG) { value = lx * 100 / w; invalidate(); return true; }
        return e->action == term.MA_RELEASE;
    }
}

int main() {
    tui.App* app = new tui.App();
    app->initHeadless(24, 3);
    Meter* m = new Meter();
    tui.Box* col = tui.vbox(0, 0);
    col->add(new tui.Label("volume"));
    col->add(m);
    app->setRoot(col);
    app->pump(0);
    app->press("Tab");                            // focus the meter
    for (int i = 0; i < 6; i++) { app->press("Right"); }
    printf("after six Right keys: %d\n", m->value);
    app->mouseDown(12, 1);
    app->mouseDrag(18, 1);
    app->mouseUp(18, 1);
    printf("after dragging to column 18: %d\n", m->value);
    println(app->text());
    // the bar is drawn with styles, not characters: count the cells in the "focused fill" style
    int filled = 0;
    for (int x = 0; x < 24; x++) {
        if (app->screen->styleAt(x, 1) == tui.theme->selection || tscreen.bgOf(app->screen->styleAt(x, 1)) == tscreen.bgOf(tui.theme->selection)) { filled++; }
    }
    printf("filled cells: %d of 24\n", filled);
    return 0;
}
