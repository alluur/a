// Running a build and showing its output while it runs
// book: tui compile-only linux-only
import tui;
import tuix;
import term;

tui.App* app;
tuix.TextPane* output;
term.Process* proc;

// called by the loop when the child's pipe has data (or has closed)
int outputReady(int fd, int user) {
    char buf[512];
    int n = proc->read(&buf[0], 500);
    if (n > 0) { output->appendBytes(&buf[0], n); return 0; }
    app->unwatchFd(fd);
    int status = proc->finish();
    char line[60];
    format(&line[0], 60, "\e[36m[finished with status %d]\e[0m", status, 0, 0, 0);
    output->appendLine(&line[0]);
    return 0;
}

int doBuild(int button) {
    proc = new term.Process();
    output->clear();
    proc->startShell("for f in main util io; do echo \"compiling $f.a\"; done; echo '\\033[31merror\\033[0m: io.a:3: missing ;'; exit 1");
    app->watchFd(proc->fd, outputReady, 0);       // the loop now also waits for the child
    return 0;
}

int doQuit(int button) { app->quit(0); return 0; }

int main() {
    app = new tui.App();
    if (!app->start()) { println("this program needs a terminal"); return 1; }
    tui.Box* col = tui.vbox(0, 0);
    tui.Box* bar = tui.hbox(1, 0);
    tui.Button* b = new tui.Button("&Build");
    b->onClick = doBuild;
    tui.Button* q = new tui.Button("&Quit");
    q->onClick = doQuit;
    bar->add(b);
    bar->add(q);
    output = new tuix.TextPane();
    output->flex = 1;
    col->add(bar);
    col->add(output);
    app->setRoot(col);
    return app->run();
}
