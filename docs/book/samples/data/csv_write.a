// Writing CSV: quoting only where it is needed
import csv;

int main() {
    println(csv.quote("plain", ','));
    println(csv.quote("has, comma", ','));
    println(csv.quote("say \"hi\"", ','));
    println(csv.quote("a;b", ';'));                       // depends on the separator
    println(csv.quote("a;b", ','));

    char* row[4] = {"Smith, John", "42", "he said \"hi\"", ""};
    char* line = csv.joinLine(row, 4, ',');
    println(line);

    // and the line reads back as the same four fields
    char* back[8];
    int n = csv.parseLine(line, ',', back, 8);
    printf("%d fields, first = %s, third = %s\n", n, back[0], back[2]);
    return 0;
}
