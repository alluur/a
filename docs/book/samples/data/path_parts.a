// Taking file names apart and putting them together
import path;

int main() {
    char* p = "/home/ann/docs/report.final.txt";
    printf("dirname   : %s\n", path.dirname(p));
    printf("basename  : %s\n", path.basename(p));
    printf("extension : %s\n", path.extension(p));      // from the last dot
    printf("stem      : %s\n", path.stem(p));
    printf("absolute  : %d, relative: %d\n", path.isAbsolute(p), path.isAbsolute("docs/a.txt"));

    // edge cases
    printf("dirname(\"file.txt\")   = %s\n", path.dirname("file.txt"));       // the current directory
    printf("dirname(\"/file.txt\")  = %s\n", path.dirname("/file.txt"));
    printf("extension(\".bashrc\")  = \"%s\" (a leading dot is not an extension)\n", path.extension(".bashrc"));
    printf("extension(\"README\")   = \"%s\"\n", path.extension("README"));
    printf("basename(\"a/b/\")      = %s (a trailing slash is ignored)\n", path.basename("a/b/"));
    printf("stem(\"a.tar.gz\")      = %s\n", path.stem("a.tar.gz"));

    // backslashes count as separators too, and drive letters are understood
    printf("Windows name: basename %s, absolute %d\n", path.basename("C:\\data\\x.csv"), path.isAbsolute("C:\\data\\x.csv"));
    return 0;
}
