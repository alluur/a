// Calendar arithmetic: leap years, month lengths and days between dates
import datetime;

int main() {
    int years[5] = {1900, 2000, 2023, 2024, 2100};
    for (int i = 0; i < 5; i++) {
        printf("%d: leap %d, February has %d days\n", years[i], datetime.isLeapYear(years[i]), datetime.daysInMonth(years[i], 2));
    }

    // days between two dates: subtract the day numbers
    int a = datetime.daysFromCivil(2024, 1, 1);
    int b = datetime.daysFromCivil(2024, 12, 25);
    printf("days from 2024-01-01 to 2024-12-25: %d\n", b - a);
    printf("days since the epoch for 2000-01-01: %d\n", datetime.daysFromCivil(2000, 1, 1));

    // the weekday of any date (0 = Sunday)
    int w = datetime.dayOfWeek(1969, 7, 20);
    printf("the Moon landing was on a %s\n", datetime.weekdayName(w));

    // print the calendar of a month
    int year = 2024;
    int month = 2;
    printf("\n   %s %d\n", datetime.monthName(month), year);
    println("Su Mo Tu We Th Fr Sa");
    int first = datetime.dayOfWeek(year, month, 1);
    for (int i = 0; i < first; i++) { print("   "); }
    int days = datetime.daysInMonth(year, month);
    for (int day = 1; day <= days; day++) {
        printf("%2d ", day);
        if ((first + day) % 7 == 0) { println(""); }
    }
    println("");
    return 0;
}
