// Compressing and decompressing: zlib, gzip and raw deflate
import zlib;
import hash;

int main() {
    char* text = "To be, or not to be, that is the question: Whether 'tis nobler in the mind to suffer "
                 "the slings and arrows of outrageous fortune, or to take arms against a sea of troubles "
                 "and by opposing end them. To die, to sleep, no more; and by a sleep to say we end "
                 "the heart-ache and the thousand natural shocks that flesh is heir to.";
    int len = strlen(text);
    printf("original     : %d bytes\n", len);

    int n;
    char* z = zlib.compress(text, len, &n);          // the zlib container: 2 byte header + data + Adler-32
    printf("zlib         : %d bytes\n", n);
    int back;
    char* plain = zlib.decompress(z, n, &back);
    printf("decompressed : %d bytes, same text: %d\n", back, streq(plain, text));

    char* gz = zlib.gzip(text, len, &n);             // what a .gz file contains: header, data, CRC-32, length
    printf("gzip         : %d bytes, starts with %02X %02X\n", n, gz[0], gz[1]);
    plain = zlib.gunzip(gz, n, &back);
    printf("gunzipped    : %d bytes, same text: %d\n", back, streq(plain, text));

    char* raw = zlib.deflate(text, len, &n);         // no container at all
    printf("raw deflate  : %d bytes\n", n);
    plain = zlib.inflate(raw, n, &back);
    printf("inflated     : %d bytes, same text: %d\n", back, streq(plain, text));

    // the checksums that the containers carry are the ones of the hash module
    printf("CRC-32 %08X, Adler-32 %08X\n", hash.crc32(text, len), hash.adler32(text, len));
    return 0;
}
