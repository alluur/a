// Edge cases: the empty message, block boundaries and a million letters
import hash;

int main() {
    println(hash.sha256("", 0));                              // the hash of nothing is not nothing
    println(hash.md5("", 0));

    // padding changes at 55, 56 and 64 bytes: all these lengths must work
    char* data = alloc(1000);
    for (int i = 0; i < 1000; i++) { data[i] = 'a' + i % 26; }
    int lens[5] = {55, 56, 63, 64, 1000};
    for (int i = 0; i < 5; i++) {
        printf("sha256 of %4d bytes: %.32s...\n", lens[i], hash.sha256(data, lens[i]));
    }

    // the NIST long message test: one million times 'a'
    char* mil = alloc(1000001);
    memset(mil, 'a', 1000000);
    println(hash.sha256(mil, 1000000));
    println(hash.sha1(mil, 1000000));

    // a binary message with zero bytes inside: pass the length, not a string
    char bin[4] = {0, 0, 0, 0};
    println(hash.sha1(bin, 4));
    return 0;
}
