// An associative memory that repairs damaged patterns
import nn;

// draws a 5x5 pattern of +1 / -1 values
void draw(int* p) {
    for (int y = 0; y < 5; y++) {
        for (int x = 0; x < 5; x++) { printChar(p[y * 5 + x] > 0 ? '#' : '.'); }
        println("");
    }
}

// patterns are written as text: '#' is +1, anything else -1
void parse(char* rows, int* out) {
    for (int i = 0; i < 25; i++) { out[i] = rows[i] == '#' ? 1 : -1; }
}

int main() {
    int plus[25];
    int cross[25];
    parse("..#.."
          "..#.."
          "#####"
          "..#.."
          "..#..", plus);
    parse("#...#"
          ".#.#."
          "..#.."
          ".#.#."
          "#...#", cross);

    nn.Hopfield* h = new nn.Hopfield(25);
    h->store(plus);
    h->store(cross);
    printf("stored %d patterns, energy of '+' is %d\n", h->stored, h->energy(plus));

    // damage the plus: flip five of its 25 cells
    int noisy[25];
    for (int i = 0; i < 25; i++) { noisy[i] = plus[i]; }
    int flips[5] = {0, 3, 9, 13, 21};
    for (int i = 0; i < 5; i++) { noisy[flips[i]] = -noisy[flips[i]]; }
    println("damaged:");
    draw(noisy);
    printf("energy %d\n", h->energy(noisy));

    int sweeps = h->recall(noisy, 10);
    printf("recalled after %d sweeps:\n", sweeps);
    draw(noisy);
    int same = 1;
    for (int i = 0; i < 25; i++) { if (noisy[i] != plus[i]) { same = 0; } }
    printf("identical to the stored plus: %d, energy %d\n", same, h->energy(noisy));
    return 0;
}
