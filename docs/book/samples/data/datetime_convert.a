// Converting between Unix timestamps and calendar dates (all UTC)
import datetime;

int main() {
    // a fixed timestamp: 1 000 000 000 seconds after the epoch
    datetime.DateTime* d = new datetime.DateTime(1000000000);
    printf("%s\n", d->toString());
    printf("date %s, time %s\n", d->dateString(), d->timeString());
    printf("weekday %d = %s, day of the year %d\n", d->weekday, datetime.weekdayName(d->weekday), d->yearDay);

    // the other way round
    int t = datetime.toUnix(2024, 2, 29, 12, 30, 15);
    printf("2024-02-29 12:30:15 UTC = %d\n", t);
    printf("same through the object: %d\n", d->toUnix());

    // epoch and a date before it
    printf("%s\n", (new datetime.DateTime(0))->toString());
    printf("%s\n", (new datetime.DateTime(-1))->toString());               // one second before
    printf("%s\n", (new datetime.DateTime(-86400 * 365 * 30))->toString());

    // set() reuses an object
    d->set(1700000000);
    printf("%s (%s, %s)\n", d->toString(), datetime.weekdayName(d->weekday), datetime.monthName(d->month));
    return 0;
}
