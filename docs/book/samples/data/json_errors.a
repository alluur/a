// What happens with bad JSON
import json;

void tryParse(char* text) {
    json.Json* v = json.parse(text);
    if (v == null) {
        printf("%-22s -> error: %s\n", text, json.errorMessage());
    } else {
        printf("%-22s -> ok: %s\n", text, json.stringify(v));
    }
}

int main() {
    tryParse("{\"a\": 1}");
    tryParse("[1, 2, 3");              // missing bracket
    tryParse("{\"a\" 1}");             // missing colon
    tryParse("{a: 1}");                // keys need quotes
    tryParse("[1, 2,]");               // no trailing comma
    tryParse("'text'");                // single quotes are not JSON
    tryParse("tru");
    tryParse("[1] x");                 // text after the value
    tryParse("\"open");                // unterminated string
    tryParse("");
    tryParse("  42  ");                // a bare value is fine, blanks are fine
    return 0;
}
