// Real time zones, with daylight saving, from the C library
import clib;

int main() {
    int winter = 1735687800;                       // 2024-12-31 23:30:00 UTC
    int summer = 1720000000;                       // 2024-07-03 09:46:40 UTC

    // a zone is a POSIX rule in the TZ variable: name, offset (positive = west of Greenwich), then daylight rules
    char* zones[4] = {"UTC0", "EET-2EEST,M3.5.0/3,M10.5.0/4", "PST8PDT,M3.2.0,M11.1.0", "JST-9"};
    char* cities[4] = {"UTC", "Helsinki", "Los Angeles", "Tokyo"};
    char text[80];
    printf("%-12s %-26s %s\n", "", "winter", "summer");
    for (int i = 0; i < 4; i++) {
        setenv("TZ", zones[i], 1);
        tzset();
        strftime(text, 80, "%Y-%m-%d %H:%M %Z", localtime(&winter));
        printf("%-12s %-26s", cities[i], text);
        strftime(text, 80, "%m-%d %H:%M %Z", localtime(&summer));
        printf(" %s\n", text);
    }

    // mktime goes the other way: a local date and time to a timestamp
    setenv("TZ", "EET-2EEST,M3.5.0/3,M10.5.0/4", 1);
    tzset();
    tm t;
    memset(&t, 0, sizeof(tm));
    t.tm_year = 2024 - 1900;
    t.tm_mon = 5;                                  // June (0 based)
    t.tm_mday = 21;
    t.tm_hour = 12;
    t.tm_isdst = -1;                               // let the library decide
    printf("2024-06-21 12:00 in Helsinki is %d seconds after the epoch\n", mktime(&t));
    return 0;
}
