// Damaged data is detected, not decoded into garbage
import zlib;

int main() {
    char* text = "checksums protect the data: checksums protect the data: checksums protect the data";
    int len = strlen(text);
    int n;
    char* gz = zlib.gzip(text, len, &n);
    int out;

    printf("intact        : %s\n", zlib.gunzip(gz, n, &out) != null ? "ok" : "null");

    gz[n - 8] = gz[n - 8] ^ 1;                       // flip one bit of the CRC-32
    printf("bad CRC       : %s\n", zlib.gunzip(gz, n, &out) != null ? "ok" : "null");
    gz[n - 8] = gz[n - 8] ^ 1;

    gz[0] = 0x50;                                    // not a gzip header any more
    printf("bad header    : %s\n", zlib.gunzip(gz, n, &out) != null ? "ok" : "null");
    gz[0] = 0x1F;

    printf("cut short     : %s\n", zlib.gunzip(gz, n - 20, &out) != null ? "ok" : "null");
    printf("not compressed: %s\n", zlib.decompress("this is plain text", 18, &out) != null ? "ok" : "null");
    printf("repaired      : %s\n", zlib.gunzip(gz, n, &out) != null ? "ok" : "null");
    return 0;
}
