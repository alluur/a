// Splitting CSV lines, with quotes and other separators
import csv;

void show(char* line, int sep) {
    char* f[16];
    int n = csv.parseLine(line, sep, f, 16);
    printf("%s\n  -> %d fields:", line, n);
    for (int i = 0; i < n; i++) { printf(" [%s]", f[i]); }
    println("");
}

int main() {
    show("apple,banana,cherry", ',');
    show("a,,c,", ',');                                   // empty fields count: this line has four
    show("\"Smith, John\",42,\"says \"\"hi\"\"\"", ',');  // a comma inside quotes, "" is one quote
    show("name;city;note", ';');                          // any separator
    show("tab\tseparated\tvalues", 9);
    show("", ',');                                        // an empty line is one empty field
    show("x,y,z,w", ',');
    char* f[2];
    printf("with max 2: %d fields\n", csv.parseLine("x,y,z,w", ',', f, 2));
    return 0;
}
