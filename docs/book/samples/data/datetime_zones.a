// Time zones by hand: add the offset to the timestamp
import datetime;

// the local time in a zone that is `hours` hours from UTC (no daylight saving here)
void show(char* city, int unix, int hours, int minutes) {
    datetime.DateTime d(unix + hours * 3600 + minutes * 60);
    printf("%-9s %s  (UTC%+d:%02d)\n", city, d.toString(), hours, minutes < 0 ? -minutes : minutes);
}

int main() {
    int t = datetime.toUnix(2024, 12, 31, 23, 30, 0);     // 23:30 on New Year's Eve in UTC
    show("UTC", t, 0, 0);
    show("Helsinki", t, 2, 0);                              // already 2025
    show("Kolkata", t, 5, 30);
    show("Honolulu", t, -10, 0);
    show("St John's", t, -3, -30);
    return 0;
}
