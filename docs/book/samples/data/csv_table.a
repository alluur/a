// A small report from CSV data
import csv;

int main() {
    char* lines[5] = {
        "item,qty,price",
        "pencil,12,0.35",
        "\"notebook, A5\",3,2.90",
        "eraser,7,0.60",
        "\"ruler 30\"\"\",2,1.25"
    };
    int totalCents = 0;
    for (int i = 1; i < 5; i++) {                        // skip the header line
        char* f[8];
        csv.parseLine(lines[i], ',', f, 8);
        int qty = atoi(f[1]);
        // the price "2.90" in cents: whole part * 100 + the digits after the dot
        int dot = indexOf(f[2], '.');
        int cents = atoi(f[2]) * 100 + atoi(&f[2][dot + 1]);
        printf("%-14s %3d x %5s = %4d cents\n", f[0], qty, f[2], qty * cents);
        totalCents = totalCents + qty * cents;
    }
    printf("total: %d.%02d\n", totalCents / 100, totalCents % 100);
    return 0;
}
