// Joining, normalising and changing extensions
import path;

int main() {
    // join puts exactly one separator between the parts
    println(path.join("data", "in.csv"));
    println(path.join("data/", "in.csv"));
    println(path.join("data", "/in.csv"));           // an absolute second part wins
    println(path.join("", "in.csv"));
    println(path.join("a", ""));

    // normalize removes ".", "..", and doubled separators, without touching the disk
    println(path.normalize("a//b/./c/../d"));
    println(path.normalize("/usr/local/../lib/./x"));
    println(path.normalize("../../a/b/.."));         // leading .. of a relative path stay
    println(path.normalize("/.."));                  // you cannot go above the root
    println(path.normalize("a/.."));                 // nothing left: the current directory

    // swapping extensions
    println(path.withExtension("notes/todo.txt", ".bak"));
    println(path.withExtension("archive", ".zip"));
    println(path.withExtension("pics/photo.jpeg", ""));    // an empty extension removes it
    return 0;
}
