// Reading INI text
import ini;

int main() {
    char* text =
        "; global setting before any section\n"
        "name = demo\n"
        "\n"
        "[server]\n"
        "port = 8080\n"
        "host = \"my site ; fast\"   ; a comment after the value\n"
        "debug = yes\n"
        "# another comment style\n"
        "[paths]\n"
        "root=/var/www\n";
    ini.Ini* c = ini.parse(text);

    printf("%d settings\n", c->count);
    printf("name      = %s\n", c->get("", "name", "?"));          // keys before a section: section ""
    printf("host      = %s\n", c->get("server", "host", "?"));    // quotes keep blanks and semicolons
    printf("port      = %d\n", c->getInt("server", "port", 80));
    printf("debug     = %d\n", c->getBool("server", "debug", false));
    printf("root      = %s\n", c->get("paths", "root", "?"));

    // fallbacks for missing keys or values of the wrong kind
    printf("timeout   = %d (missing, so the fallback)\n", c->getInt("server", "timeout", 30));
    printf("host as int = %d (not a number)\n", c->getInt("server", "host", -1));
    printf("has port: %d, has colour: %d\n", c->has("server", "port"), c->has("server", "colour"));
    printf("names are case-sensitive: %s\n", c->get("Server", "port", "not found"));
    return 0;
}
