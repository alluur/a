// Building JSON and writing it as text
import json;

int main() {
    json.Json* user = json.newObject();
    user->set("id", json.newInt(42));
    user->set("name", json.newString("Ann \"Ace\" Lee"));   // quotes are escaped on output
    user->set("admin", json.newBool(true));
    user->set("manager", json.newNull());

    json.Json* skills = json.newArray();
    skills->push(json.newString("compilers"));
    skills->push(json.newString("COBOL"));
    skills->push(json.newInt(1952));
    user->set("skills", skills);

    json.Json* address = json.newObject();
    address->set("city", json.newString("Arlington"));
    user->set("address", address);

    println(json.stringify(user));            // compact: no blanks
    println(json.pretty(user));               // indented by two spaces

    user->set("id", json.newInt(43));         // set replaces an existing member, keeping its place
    printf("id is now %d, members: %d\n", user->get("id")->asInt(), user->size());

    json.Json* empty = json.newArray();
    println(json.stringify(empty));
    println(json.stringify(json.newObject()));
    return 0;
}
