// Reading a document, changing it, and writing it back
import json;

int main() {
    json.Json* cfg = json.parse("{\"port\": 8080, \"debug\": false, \"ratio\": 0.75, \"big\": 1e3, \"hosts\": [\"a\", \"b\"]}");

    // numbers with a fraction or an exponent keep their original text ...
    println(json.stringify(cfg));
    printf("asInt of 0.75 = %d (truncated), of 1e3 = %d\n", cfg->get("ratio")->asInt(), cfg->get("big")->asInt());

    // ... and are written back unchanged, so a round trip does not lose digits
    cfg->set("port", json.newInt(9090));
    cfg->set("debug", json.newBool(true));
    cfg->get("hosts")->push(json.newString("c"));
    cfg->set("version", json.newString("2"));
    println(json.stringify(cfg));

    // pretty printing re-parses to the same document
    json.Json* again = json.parse(json.pretty(cfg));
    printf("same text after pretty and parse: %d\n", streq(json.stringify(again), json.stringify(cfg)));
    return 0;
}
