// The cryptographic hashes, with their published test vectors for "abc"
import hash;
import encoding;

// prints a hex digest; the long ones go on two lines
void show(char* name, char* hex) {
    if (strlen(hex) <= 64) {
        printf("%-8s %s\n", name, hex);
    } else {
        printf("%-8s %.64s\n         %s\n", name, hex, &hex[64]);
    }
}

int main() {
    char* abc = "abc";
    show("MD5", hash.md5(abc, 3));                            // 32 hex characters
    show("SHA-1", hash.sha1(abc, 3));                         // 40
    show("SHA-256", hash.sha256(abc, 3));                     // 64
    show("SHA-512", hash.sha512(abc, 3));                     // 128

    char raw[64];
    hash.sha384Raw(abc, 3, raw);                              // SHA-384 only comes as raw bytes
    show("SHA-384", encoding.hexEncode(raw, 48));

    // digest() picks the hash by its size in bits and returns the length in bytes
    int sizes[5] = {128, 160, 256, 384, 512};
    for (int i = 0; i < 5; i++) {
        int n = hash.digest(sizes[i], abc, 3, raw);
        printf("digest(%d) is %d bytes: %.16s...\n", sizes[i], n, encoding.hexEncode(raw, n));
    }
    printf("digest(100) is %d bytes (unknown size)\n", hash.digest(100, abc, 3, raw));
    return 0;
}
