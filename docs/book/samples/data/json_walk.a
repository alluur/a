// Walking a JSON document of unknown shape
import json;

void walk(json.Json* v, int depth) {
    for (int i = 0; i < depth; i++) { print("  "); }
    if (v->isObject()) {
        printf("object with %d members\n", v->size());
        for (int i = 0; i < v->size(); i++) {
            for (int k = 0; k <= depth; k++) { print("  "); }
            printf("%s:\n", v->keyAt(i));
            walk(v->at(i), depth + 2);            // at(i) is the value of member i
        }
    } else if (v->isArray()) {
        printf("array of %d\n", v->size());
        for (int i = 0; i < v->size(); i++) { walk(v->at(i), depth + 1); }
    } else if (v->isString()) {
        printf("string \"%s\"\n", v->asString());
    } else if (v->isNumber()) {
        printf("number %d\n", v->asInt());
    } else if (v->isBool()) {
        printf("bool %d\n", v->asBool());
    } else {
        println("null");
    }
}

int main() {
    json.Json* doc = json.parse("{\"id\": 7, \"tags\": [\"x\", \"y\"],"
                                " \"owner\": {\"name\": \"Bo\", \"active\": false, \"manager\": null},"
                                " \"scores\": [[1, 2], [3]]}");
    walk(doc, 0);
    return 0;
}
