// Packing files into a tar archive in memory and reading them back
import tar;

int main() {
    tar.Writer* w = new tar.Writer();
    w->addDir("docs");
    w->add("docs/hello.txt", "Hello, tar!", 11);
    w->add("docs/notes.txt", "second file", 11);
    w->add("empty.txt", "", 0);

    int n;
    char* archive = w->finish(&n);               // a new buffer with the whole archive
    printf("archive is %d bytes (512 per header, 512 per data block, 1024 at the end)\n", n);

    // listing: next() moves to the following entry and fills name, size, isDir and data
    tar.Reader* r = new tar.Reader(archive, n);
    while (r->next()) {
        printf("%-4s %-15s %3d bytes mode %o\n", r->isDir ? "dir" : "file", r->name, r->size, r->mode);
        if (!r->isDir && r->size > 0) {
            char* copy = substr(r->data, 0, r->size);        // r->data points into the archive
            printf("     content: %s\n", copy);
        }
    }
    printf("damaged: %d\n", r->bad);

    // a damaged header (the checksum no longer fits) stops the reading
    archive[3] = 'X';
    tar.Reader* bad = new tar.Reader(archive, n);
    printf("first entry readable: %d, damaged: %d\n", bad->next(), bad->bad);
    return 0;
}
