// Parsing JSON and navigating the result
import json;

int main() {
    char* text = "{\"name\": \"Ada\", \"age\": 36, \"admin\": true,"
                 " \"langs\": [\"A\", \"C\", \"asm\"],"
                 " \"address\": {\"city\": \"Helsinki\", \"zip\": \"00100\"},"
                 " \"nick\": null}";
    json.Json* doc = json.parse(text);
    if (doc == null) {                       // parse returns null on a syntax error
        println(json.errorMessage());
        return 1;
    }

    printf("name  = %s\n", doc->get("name")->asString());
    printf("age   = %d\n", doc->get("age")->asInt());
    printf("admin = %d\n", doc->get("admin")->asBool());
    printf("city  = %s\n", doc->get("address")->get("city")->asString());

    json.Json* langs = doc->get("langs");
    printf("%d languages:", langs->size());
    for (int i = 0; i < langs->size(); i++) { printf(" %s", langs->at(i)->asString()); }
    println("");

    // a missing member is null, so test before you walk further
    printf("has email: %d, get(\"email\") is null: %d\n", doc->has("email"), doc->get("email") == null);

    // the *Or helpers return a fallback for a missing member or one of the wrong kind
    printf("intOr(age) = %d, intOr(height) = %d\n", doc->intOr("age", -1), doc->intOr("height", -1));
    printf("intOr(name) = %d (a string is not a number)\n", doc->intOr("name", -1));
    printf("stringOr(nick) = %s\n", doc->stringOr("nick", "(none)"));    // null is not a string
    printf("boolOr(admin) = %d\n", doc->boolOr("admin", false));

    // what kind of value is it?
    printf("nick is null: %d, langs is array: %d\n", doc->get("nick")->isNull(), langs->isArray());
    printf("address is object: %d\n", doc->get("address")->isObject());
    return 0;
}
