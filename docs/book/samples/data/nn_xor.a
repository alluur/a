// A tiny neural network learns XOR
import nn;
import fixed;

int main() {
    // XOR is the classic problem a single neuron cannot solve: it needs a hidden layer
    int x[8]  = {0, 0,   0, 1,   1, 0,   1, 1};            // four samples of two inputs
    int t[4]  = {0, 1, 1, 0};                              // the wanted outputs
    int xs[8];
    int ts[4];
    for (int i = 0; i < 8; i++) { xs[i] = fixed.fromInt(x[i]); }     // fixed-point numbers: 1.0 = fixed.ONE
    for (int i = 0; i < 4; i++) { ts[i] = fixed.fromInt(t[i]); }

    fixed.seed(7);                                         // the start weights come from this generator
    int sizes[3] = {2, 4, 1};                              // 2 inputs, 4 hidden neurons, 1 output
    nn.Network* net = new nn.Network(3, sizes, nn.ACT_TANH, nn.ACT_SIGMOID);
    printf("%d parameters\n", net->parameters());

    for (int s = 0; s < 4; s++) {
        printf("before: %d xor %d -> ", x[s * 2], x[s * 2 + 1]);
        fixed.putln(net->forward(&xs[s * 2])[0], 3);
    }

    int loss = net->fit(xs, ts, 4, 3000, fixed.fromText("0.5"), 0);    // 3000 epochs, learning rate 0.5
    print("final loss: "); fixed.putln(loss, 6);

    int right = 0;
    for (int s = 0; s < 4; s++) {
        int y = net->forward(&xs[s * 2])[0];
        int answer = y > fixed.HALF ? 1 : 0;                // round to the nearest of 0 and 1
        printf("after : %d xor %d -> ", x[s * 2], x[s * 2 + 1]);
        fixed.put(y);
        printf("  (answer %d)\n", answer);
        if (answer == t[s]) { right++; }
    }
    printf("%d of 4 right\n", right);
    return 0;
}
