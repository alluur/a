// Escapes and Unicode in JSON strings
import json;

int main() {
    // \n, \t, \" and \\ are decoded; \u00e9 is an accented letter
    json.Json* v = json.parse("[\"line one\\nline two\", \"tab\\there\", \"quote \\\" and slash \\\\\","
                              " \"caf\\u00e9\", \"\\ud83d\\ude00\", \"日本\"]");
    for (int i = 0; i < v->size(); i++) {
        printf("%d: %s\n", i, v->at(i)->asString());
    }
    printf("the smiley is %d bytes in UTF-8\n", strlen(v->at(4)->asString()));

    // the writer escapes what must be escaped and keeps UTF-8 as it is
    json.Json* o = json.newArray();
    o->push(json.newString("a\"b\\c\nd\te"));
    o->push(json.newString("caf\xC3\xA9"));
    o->push(json.newString("bell\x07"));              // control characters become \u00XX
    println(json.stringify(o));
    return 0;
}
