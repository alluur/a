// How well different data compresses
import zlib;

int main() {
    // 1. very repetitive data shrinks a lot
    char* rep = alloc(10001);
    for (int i = 0; i < 10000; i++) { rep[i] = "abcdefgh"[i % 8]; }

    // 2. pseudo random bytes cannot be compressed: they grow by a few bytes
    char* rnd = alloc(10001);
    int x = 1234567;
    for (int i = 0; i < 10000; i++) { x = (x * 1103515245 + 12345) & 0x7FFFFFFF; rnd[i] = (x >> 16) & 255; }

    // 3. text made of eight words in random order
    char* txt = alloc(10001);
    char* words[8] = {"the ", "quick ", "brown ", "fox ", "jumps ", "over ", "lazy ", "dogs "};
    int o = 0;
    x = 99;
    while (o < 9990) {
        x = (x * 1103515245 + 12345) & 0x7FFFFFFF;
        char* w = words[(x >> 16) % 8];
        for (int k = 0; w[k] != 0 && o < 10000; k++) { txt[o] = w[k]; o++; }
    }

    char* names[3] = {"repetitive", "random", "word soup"};
    char* data[3] = {rep, rnd, txt};
    int lens[3] = {10000, 10000, o};
    for (int i = 0; i < 3; i++) {
        int n;
        char* z = zlib.compress(data[i], lens[i], &n);
        printf("%-11s %6d -> %6d bytes (%d%%)\n", names[i], lens[i], n, n * 100 / lens[i]);
    }

    // the effort can be chosen: 1 is fastest, 9 searches longest for repeats
    for (int level = 1; level <= 9; level += 4) {
        int n;
        zlib.deflateLevel(txt, o, level, &n);
        printf("level %d on the word soup: %d bytes\n", level, n);
    }
    return 0;
}
