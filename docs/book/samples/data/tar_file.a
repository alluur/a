// Writing a tar archive to disk and reading it from the file
import tar;

int main() {
    tar.Writer* w = new tar.Writer();
    w->add("a.txt", "AAAA", 4);
    w->add("deep/dir/b.txt", "BB", 2);
    char* longName = "a_very_long_directory_name_for_testing_the_prefix_field_of_ustar_headers_x/"
                     "another_long_directory_name_to_pass_the_hundred_byte_mark/file.txt";
    printf("long name has %d characters\n", strlen(longName));
    printf("added long name: %d\n", w->add(longName, "L", 1));
    int n;
    char* archive = w->finish(&n);

    int h = fileOpen("out.tar", FILE_WRITE);
    fileWrite(h, archive, n);
    fileClose(h);

    // read the file back in chunks
    char* back = alloc(n + 1);
    int got = 0;
    h = fileOpen("out.tar", FILE_READ);
    int k;
    while ((k = fileRead(h, &back[got], 4096)) > 0) { got = got + k; }
    fileClose(h);
    printf("wrote %d bytes, read %d bytes\n", n, got);

    tar.Reader* r = new tar.Reader(back, got);
    while (r->next()) {
        int n = strlen(r->name);
        printf("%.30s%s (%d B, name of %d characters)\n", r->name, n > 30 ? "..." : "", r->size, n);
    }

    // a name that cannot be split into prefix and name is refused
    char tooLong[300];
    memset(tooLong, 'x', 299);
    tooLong[299] = 0;
    printf("299 characters without a slash: %d\n", w->add(tooLong, "z", 1));
    return 0;
}
