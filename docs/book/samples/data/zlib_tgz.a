// A .tar.gz: tar and zlib together
import tar;
import zlib;

int main() {
    tar.Writer* w = new tar.Writer();
    char* body = "line of text that repeats\nline of text that repeats\nline of text that repeats\n";
    for (int i = 1; i <= 3; i++) {
        char name[32];
        format(name, 32, "logs/day%d.txt", i);
        w->add(name, body, strlen(body));
    }
    int tarLen;
    char* archive = w->finish(&tarLen);

    int gzLen;
    char* gz = zlib.gzip(archive, tarLen, &gzLen);
    printf("tar: %d bytes, gzipped: %d bytes\n", tarLen, gzLen);
    int h = fileOpen("logs.tar.gz", FILE_WRITE);     // an ordinary file that `tar xzf` understands
    fileWrite(h, gz, gzLen);
    fileClose(h);

    // unpack: gunzip, then read the tar entries
    int plainLen;
    char* plain = zlib.gunzip(gz, gzLen, &plainLen);
    tar.Reader* r = new tar.Reader(plain, plainLen);
    while (r->next()) { printf("%s: %d bytes\n", r->name, r->size); }
    return 0;
}
