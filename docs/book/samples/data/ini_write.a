// Changing a configuration and writing it back
import ini;

int main() {
    ini.Ini* c = ini.parse("[db]\nhost = localhost\nport = 5432\n[ui]\ntheme = dark\n");

    c->set("db", "port", "6543");                 // replaces
    c->set("db", "user", "admin");                // adds
    c->set("cache", "size", "128");               // a new section
    printf("removed theme: %d, removed nothing: %d\n", c->remove("ui", "theme"), c->remove("ui", "colour"));

    print(c->toString());                         // INI text again
    println("----");

    // the file functions: write the text, read it with load
    writeFile("app.ini", c->toString());
    ini.Ini* d = ini.load("app.ini");
    printf("loaded: db.user = %s, cache.size = %d\n", d->get("db", "user", "?"), d->getInt("cache", "size", 0));
    printf("missing file gives null: %d\n", ini.load("nope.ini") == null);

    // booleans: true/yes/on/1 and false/no/off/0, in lower case; anything else gives the fallback
    ini.Ini* b = ini.parse("[x]\na = on\nb = off\nc = Yes\n");
    printf("a=%d b=%d\n", b->getBool("x", "a", false), b->getBool("x", "b", true));
    printf("c=%d (Yes is not recognised, so the fallback true is returned)\n", b->getBool("x", "c", true));
    return 0;
}
