// One neuron learns AND and OR, but cannot learn XOR
import nn;
import fixed;

// trains a perceptron on a 2-input truth table and reports what it learned
void learn(char* name, int* targets) {
    int x[8] = {0, 0, 0, 1, 1, 0, 1, 1};
    int xs[8];
    for (int i = 0; i < 8; i++) { xs[i] = fixed.fromInt(x[i]); }

    nn.Perceptron* p = new nn.Perceptron(2);
    int epochs = p->fit(xs, targets, 4, 100, fixed.fromText("0.25"));
    printf("%-4s %3d epochs, answers:", name, epochs);
    for (int s = 0; s < 4; s++) { printf(" %d", p->predict(&xs[s * 2])); }
    int ok = 1;
    for (int s = 0; s < 4; s++) { if (p->predict(&xs[s * 2]) != targets[s]) { ok = 0; } }
    printf("  %s\n", ok ? "learned" : "failed");
}

int main() {
    int andT[4] = {0, 0, 0, 1};
    int orT[4] = {0, 1, 1, 1};
    int xorT[4] = {0, 1, 1, 0};
    learn("AND", andT);
    learn("OR", orT);
    learn("XOR", xorT);          // no straight line separates the two classes: the 100 epochs run out
    return 0;
}
