// HMAC: a hash that needs a secret key
import hash;
import encoding;

int main() {
    // RFC 4231 test case 2
    char* key = "Jefe";
    char* msg = "what do ya want for nothing?";
    char mac[64];
    hash.hmacSha256(key, 4, msg, strlen(msg), mac);
    println(encoding.hexEncode(mac, 32));

    // hmac() works with every hash: pick it by the size in bits
    int n = hash.hmac(512, key, 4, msg, strlen(msg), mac);
    printf("HMAC-SHA512 (%d bytes): %.32s...\n", n, encoding.hexEncode(mac, n));
    n = hash.hmac(160, key, 4, msg, strlen(msg), mac);
    printf("HMAC-SHA1   (%d bytes): %s\n", n, encoding.hexEncode(mac, n));

    // verifying a message: compare the MACs without stopping at the first difference
    char other[64];
    hash.hmacSha256(key, 4, msg, strlen(msg), mac);
    hash.hmacSha256(key, 4, "what do ya want for nothing!", 28, other);
    printf("same message: %d\n", hash.equalConstantTime(mac, mac, 32));
    printf("changed message: %d\n", hash.equalConstantTime(mac, other, 32));
    return 0;
}
