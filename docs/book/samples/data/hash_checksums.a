// Checksums: CRC-32, Adler-32, FNV-1a and djb2
import hash;

void line(char* text) {
    int n = strlen(text);
    char quoted[40];
    format(quoted, 40, "\"%s\"", text);
    printf("%-12s crc32 %08X  adler32 %08X  fnv1a %08X  djb2 %08X\n", quoted,
           hash.crc32(text, n), hash.adler32(text, n), hash.fnv1a(text, n), hash.djb2(text, n));
}

int main() {
    line("123456789");              // the standard check string: its CRC-32 is CBF43926
    line("");
    line("hello");
    line("Wikipedia");

    // crc32Update continues a checksum, so big data can be fed in pieces
    int crc = hash.crc32Update(0, "1234", 4);
    crc = hash.crc32Update(crc, "56789", 5);
    printf("in two pieces: %08X\n", crc);

    // one changed letter changes everything
    printf("hello vs hellp: %08X vs %08X\n", hash.crc32("hello", 5), hash.crc32("hellp", 5));
    return 0;
}
