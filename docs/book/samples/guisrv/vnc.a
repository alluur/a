// A display behind a VNC server, with a tiny viewer of our own
import wsrv;
import wvnc;
import net;

wsrv.Server* srv;
int sock;

// read exactly n bytes from the viewer socket; the server is in this program, so give it turns while we wait
void readN(char* buf, int n) {
    int got = 0;
    for (int i = 0; i < 400 && got < n; i++) {
        srv->step(0);
        if (net.waitReadable(sock, 5)) {
            int r = net.recv(sock, &buf[got], n - got);
            if (r <= 0) { return; }
            got = got + r;
        }
    }
}

void be16(char* b, int at, int v) { b[at] = (v >> 8) & 255; b[at + 1] = v & 255; }
int get16(char* b, int at) { return ((b[at] & 255) << 8) | (b[at + 1] & 255); }

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    wvnc.Vnc* vnc = new wvnc.Vnc(64, 48, port, "127.0.0.1");     // a 64 x 48 display, listening on 127.0.0.1:port
    srv = new wsrv.Server(vnc, 0);                               // the display server on top of it
    sock = net.connect("127.0.0.1", port);

    char buf[256];
    readN(&buf[0], 12);                                           // 1. the server says which RFB version it speaks
    buf[11] = 0;
    printf("server: %s\n", &buf[0]);
    net.send(sock, "RFB 003.008\n", 12);                          // we agree
    readN(&buf[0], 2);                                            // 2. security types: how many, then the list
    printf("security types: %d, first is %d (1 = none)\n", buf[0], buf[1]);
    buf[0] = 1;
    net.send(sock, &buf[0], 1);                                   // choose "none"
    readN(&buf[0], 4);                                            // 3. security result: 0 = ok
    printf("security result: %d\n", get16(&buf[0], 2));
    buf[0] = 1;
    net.send(sock, &buf[0], 1);                                   // 4. ClientInit: share the display
    readN(&buf[0], 24);                                           // ServerInit: size, pixel format, name length
    int nameLen = (get16(&buf[0], 20) << 16) | get16(&buf[0], 22);
    printf("display: %d x %d, %d bits per pixel\n", get16(&buf[0], 0), get16(&buf[0], 2), buf[4]);
    readN(&buf[24], nameLen);
    buf[24 + nameLen] = 0;
    printf("name: %s\n", &buf[24]);

    // ask for the whole picture (FramebufferUpdateRequest) and read the Raw rectangle
    buf[0] = 3; buf[1] = 0;
    be16(&buf[0], 2, 0); be16(&buf[0], 4, 0); be16(&buf[0], 6, 64); be16(&buf[0], 8, 48);
    net.send(sock, &buf[0], 10);
    char head[16];
    readN(&head[0], 4);
    printf("update message %d with %d rectangle(s)\n", head[0], get16(&head[0], 2));
    readN(&head[0], 12);
    printf("rectangle %d x %d at %d,%d, encoding %d (0 = raw)\n", get16(&head[0], 4), get16(&head[0], 6), get16(&head[0], 0), get16(&head[0], 2), head[11]);
    char* pixels = malloc(64 * 48 * 4);
    readN(pixels, 64 * 48 * 4);
    // the first pixel: blue, green, red, unused. It is the top of the background gradient
    printf("first pixel (b,g,r): %d %d %d\n", pixels[0] & 255, pixels[1] & 255, pixels[2] & 255);
    printf("viewers connected: %d\n", vnc->viewers());
    return 0;
}
