// The window manager: moving, stacking, maximizing, and closing
// book: shot=out.png
import wsrv;
import gui;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;
int closeAsked;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); } }

// the window decides: the server only asks. Returning 1 keeps the window open.
int onClose(int window) { closeAsked++; return 1; }

gui.Window* make(char* title, int x, int y) {
    gui.Window* w = d->createWindowAt(title, x, y, 150, 70, 0);
    gui.Box* col = gui.vbox(0, 10);
    col->add(new gui.Label(title));
    w->setRoot(col);
    return w;
}

void order(char* what) {
    printf("%s:", what);
    for (int i = 0; i < srv->windowCount(); i++) { printf(" %s", srv->windowAt(i)->title); }   // bottom first
    println("");
}

int main() {
    screen = new wsrv.Headless(400, 260);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "wm");

    gui.Window* a = make("A", 20, 50);
    gui.Window* b = make("B", 200, 60);
    a->onClose = onClose;
    settle();
    wsrv.Win* wa = srv->windowAt(0);
    wsrv.Win* wb = srv->windowAt(1);
    order("stacking order");

    // drag A by its title bar: press on the bar (the bar is 26 pixels above the client area)
    screen->moveTo(wa->x + 30, wa->y - 13);
    screen->buttonDown(1);
    screen->moveTo(wa->x + 30 + 90, wa->y - 13 + 60);
    screen->buttonUp(1);
    settle();
    printf("A moved to %d,%d; clicking it raised it\n", wa->x, wa->y);
    order("stacking order");

    // the close button: the server asks A to close, A refuses
    screen->click(wa->x + wa->w - 12, wa->y - 13);
    settle();
    printf("close button pressed: A was asked %d time(s), it is still there: %d windows\n", closeAsked, srv->windowCount());

    // maximize B: the client is told its new size
    srv->toggleMaximize(wb);
    settle();
    printf("B maximized: server %d x %d, client %d x %d\n", wb->w, wb->h, b->w, b->h);
    srv->toggleMaximize(wb);
    settle();
    printf("B restored: %d x %d\n", wb->w, wb->h);
    screen->moveTo(390, 250);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
