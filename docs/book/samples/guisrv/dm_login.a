// The login screen of the display manager
// book: shot=out.png
import wsrv;
import gui;
import dm;
import gimg;
import net;

int main() {
    dm.Config* cfg = new dm.Config();
    writeFile("users.txt", dm.makeUserLine("ada", "hunter2", "saltsalt", 1000, 1000, "/home/ada", ""));
    cfg->usersFile = "users.txt";
    cfg->greeting = "Welcome to the example machine";
    int probe = net.listen(0, 1);
    cfg->displayPort = net.localPort(probe);
    net.close(probe);

    wsrv.Headless* screen = new wsrv.Headless(480, 400);
    wsrv.Server* srv = new wsrv.Server(screen, cfg->displayPort);
    gui.caretBlinks = false;
    dm.Manager* m = new dm.Manager(srv, cfg);      // connects to the server as a client and shows the login window
    for (int i = 0; i < 20; i++) { m->step(0); }
    printf("windows: %d (the login window)\n", srv->windowCount());

    // type a user name and a wrong password. The window has no frame, so the text boxes are
    // at the server's window position + their position in the window
    wsrv.Win* w = srv->windowAt(0);
    screen->click(w->x + m->userBox->absX() + 10, w->y + m->userBox->absY() + 10);
    screen->typeText("ada");
    screen->tap(adp.KEY_TAB, 0);
    screen->typeText("wrong");
    screen->tap(adp.KEY_ENTER, 13);
    for (int i = 0; i < 30; i++) { m->step(0); }
    printf("status line: %s\n", m->status->text);
    printf("failed logins: %d, session running: %d\n", m->failures, m->sessionRunning());
    screen->moveTo(470, 390);
    for (int i = 0; i < 10; i++) { m->step(0); }
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
