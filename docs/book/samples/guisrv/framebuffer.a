// The framebuffer backend: Linux input events and key layouts
import wsrv;
import wfb;

void show(wsrv.Backend* b) {
    wsrv.InputEvent ev;
    while (b->nextEvent(&ev) != 0) {       // what the display server would receive
        if (ev.kind == wsrv.IE_MOVE) { printf("  pointer at %d,%d\n", ev.x, ev.y); }
        else if (ev.kind == wsrv.IE_DOWN) { printf("  button %d down\n", ev.button); }
        else if (ev.kind == wsrv.IE_UP) { printf("  button %d up\n", ev.button); }
        else if (ev.kind == wsrv.IE_SCROLL) { printf("  wheel %d\n", ev.button); }
        else if (ev.kind == wsrv.IE_KEYDOWN) { printf("  key down: key %d, character %d\n", ev.key, ev.uni); }
    }
}

int main() {
    // without /dev/fb0 (or without permission) the backend says why it cannot work
    wfb.Framebuffer* fb = new wfb.Framebuffer("/nonexistent/fb0", "us");
    printf("opened: %d, error: %s\n", fb->ok(), fb->error());

    // but its translation of evdev events needs no device: a relative mouse, its buttons and the wheel
    fb->w = 800;
    fb->h = 600;
    println("mouse:");
    fb->handleEvent(2, 0, 10);             // (type EV_REL, code REL_X, value): 10 right
    fb->handleEvent(2, 1, 5);              // 5 down
    fb->handleEvent(1, 0x110, 1);          // (EV_KEY, BTN_LEFT, pressed)
    fb->handleEvent(1, 0x110, 0);
    fb->handleEvent(2, 8, 1);              // REL_WHEEL: one step up
    show(fb);

    // Linux key codes become characters through a layout: "us" or "fi" (Finnish, with AltGr)
    int uni = 0;
    println("keys on a Finnish layout:");
    wfb.useLayout("fi");
    wfb.keyFor(16, false, false, &uni);    // code 16 is the Q key
    printf("  Q key: '%c'\n", uni);
    wfb.keyFor(40, false, false, &uni);    // the key right of L
    printf("  key 40: U+%04X, with Shift: ", uni);        // a with diaeresis, a Latin-1 character
    wfb.keyFor(40, true, false, &uni);
    printf("U+%04X\n", uni);
    wfb.keyFor(8, false, true, &uni);      // the 7 key with AltGr
    printf("  7 with AltGr: '%c'\n", uni);
    wfb.useLayout("us");
    wfb.keyFor(8, false, true, &uni);
    printf("  7 with AltGr on \"us\": '%c' (AltGr changes nothing there)\n", uni);
    return 0;
}
