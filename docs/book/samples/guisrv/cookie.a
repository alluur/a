// A display server that needs a cookie
import wsrv;
import gui;
import net;
import cstdlib;

wsrv.Server* srv;
int serve(int unused) { srv->step(0); return 0; }

int main() {
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(new wsrv.Headless(200, 100), port);
    gui.idleHook = serve;

    // the cookie is a shared secret: at least 16 bytes as hex text
    printf("a short secret is refused: %d\n", srv->setCookie("abcd") == false);
    char* cookie = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
    srv->setCookie(cookie);
    printf("server has a cookie: %d\n", srv->hasCookie());

    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    // the client answers a challenge with HMAC-SHA256(cookie, nonce); the cookie itself never travels
    gui.Display* ok = gui.connectWith(&spec[0], "with-cookie", cookie);
    printf("right cookie: connected %d\n", ok != null);
    gui.Display* bad = gui.connectWith(&spec[0], "wrong", "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100");
    printf("wrong cookie: connected %d\n", bad != null);
    printf("clients the server keeps: %d\n", srv->clientCount());

    // listening on another address is only allowed with a cookie
    wsrv.Server* open = new wsrv.Server(new wsrv.Headless(100, 100), 0);
    printf("0.0.0.0 without a cookie: %d\n", open->listenOn("0.0.0.0", 0));
    return 0;
}
