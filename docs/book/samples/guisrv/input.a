// Moving the pointer and typing from a program
// book: shot=out.png
import wsrv;
import gui;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;
int clicks;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); } }
int onClick(int b) { clicks++; return 0; }

// a widget's centre on the screen = window position + position inside the window
void clickOn(gui.Window* w, gui.Widget* wd) {
    wsrv.Win* win = srv->findWindow(d->clientNum, w->id);
    screen->click(win->x + wd->absX() + wd->w / 2, win->y + wd->absY() + wd->h / 2);
    settle();
}

int main() {
    screen = new wsrv.Headless(320, 190);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    gui.caretBlinks = false;                       // a blinking caret would make the picture differ from run to run
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "input");

    gui.Window* w = d->createWindow("Name", 240, 100, 0);
    gui.Box* col = gui.vbox(8, 12);
    gui.TextBox* name = new gui.TextBox();
    gui.Button* ok = new gui.Button("Count");
    ok->onClick = onClick;
    col->add(name);
    col->add(ok);
    w->setRoot(col);
    w->fit();
    settle();

    clickOn(w, name);                               // the click gives the text box the keyboard focus
    screen->typeText("Ada Lovelace");               // keys go to the focused window
    screen->tap(adp.KEY_BACKSPACE, 0);              // (key code, character): one key, down and up
    settle();
    printf("the text box holds \"%s\"\n", name->text());

    clickOn(w, ok);
    clickOn(w, ok);
    printf("button clicks: %d\n", clicks);
    screen->moveTo(300, 180);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
