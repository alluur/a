// A small display server program: VNC and a web page on one screen
// book: compile-only
import wsrv;
import wvnc;
import wweb;

int main(int argc, char** argv) {
    int vncPort = argc > 1 ? atoi(argv[1]) : 5900;
    int webPort = argc > 2 ? atoi(argv[2]) : 8080;

    // the first backend is the "primary" one: it decides the size of the screen
    wvnc.Vnc* vnc = new wvnc.Vnc(1024, 768, vncPort, "127.0.0.1");
    if (!vnc->ok()) { println("cannot listen on the VNC port"); return 1; }
    wsrv.Server* srv = new wsrv.Server(vnc, 7000);        // clients connect to 127.0.0.1:7000 (ADISPLAY=0)
    if (!srv->ok) { println("cannot listen on the display port"); return 1; }

    // a second view of the same screen: any browser, with a token in the address
    wweb.Web* web = new wweb.Web(1024, 768, webPort, "127.0.0.1", "mytoken12");
    if (!web->ok()) { println("cannot start the web server"); return 1; }
    srv->addBackend(web);
    printf("open %s in a browser, or a VNC viewer on port %d\n", web->url(), vncPort);

    srv->run();                                           // for ever: accept clients, route input, draw
    return 0;
}
