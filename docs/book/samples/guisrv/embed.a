// A display server and its client in one program
// book: shot=out.png
import wsrv;
import gui;
import gimg;
import net;

wsrv.Server* srv;
gui.Display* d;

// The client library calls this while it waits: let the server in the same process do its work
int serve(int unused) { srv->step(0); return 0; }

// let both sides handle everything that is pending
void settle() {
    d->sync();
    for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); }
}

// ask the system for a free port (the server needs a number to listen on)
int freePort() {
    int h = net.listen(0, 1);
    int p = net.localPort(h);
    net.close(h);
    return p;
}

int main() {
    wsrv.Headless* screen = new wsrv.Headless(360, 200);      // a backend with no output: a 360 x 200 "monitor"
    int port = freePort();
    srv = new wsrv.Server(screen, port);                      // listens on 127.0.0.1:port
    printf("server is listening: %d\n", srv->ok);
    gui.idleHook = serve;

    char display[40];
    format(&display[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&display[0], "demo");                   // the ADISPLAY form "host:port"
    gui.Window* w = d->createWindow("Hello", 220, 90, 0);
    gui.Box* col = gui.vbox(8, 12);
    col->add(new gui.Label("A window in a server"));
    gui.Button* b = new gui.Button("OK");
    b->primary = true;
    col->add(b);
    w->setRoot(col);
    w->fit();
    settle();

    printf("clients: %d, windows: %d\n", srv->clientCount(), srv->windowCount());
    wsrv.Win* win = srv->windowAt(0);
    printf("window \"%s\", client area %d x %d\n", win->title, win->w, win->h);
    screen->moveTo(350, 190);                                 // the pointer out of the way (the server draws it)
    settle();
    gimg.savePng(srv->screen, "out.png");                    // the whole screen, title bar and all
    return 0;
}
