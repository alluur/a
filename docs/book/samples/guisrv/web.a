// The display in a web browser: the page and its token
import wsrv;
import wweb;
import net;
import cstring;

wsrv.Server* srv;
int port;

// a plain HTTP request to the web backend; the server is in this program, so it gets turns while we wait
char* fetch(char* path) {
    int s = net.connect("127.0.0.1", port);
    char req[200];
    format(&req[0], 200, "GET %s HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n", path, 0, 0, 0);
    net.send(s, &req[0], strlen(&req[0]));
    char* reply = malloc(40000);
    int n = 0;
    for (int i = 0; i < 300; i++) {
        srv->step(0);
        if (net.waitReadable(s, 5)) {
            int r = net.recv(s, &reply[n], 39000 - n);
            if (r <= 0) { break; }
            n = n + r;
        }
    }
    reply[n] = 0;
    net.close(s);
    return reply;
}

// the first line of a reply: "HTTP/1.1 200 OK"
void statusLine(char* label, char* reply) {
    char line[60];
    int n = 0;
    while (reply[n] != 0 && reply[n] != '\r' && n < 58) { line[n] = reply[n]; n++; }
    line[n] = 0;
    printf("%-16s %s\n", label, &line[0]);
}

int main() {
    int probe = net.listen(0, 1);
    port = net.localPort(probe);
    net.close(probe);
    // a 320 x 200 display; the token is a shared secret in the address
    wweb.Web* web = new wweb.Web(320, 200, port, "127.0.0.1", "secret123");
    srv = new wsrv.Server(web, 0);
    printf("web backend listening: %d\n", web->ok());

    char* page = fetch("/?t=secret123");
    statusLine("right token:", page);
    printf("the page has a canvas: %d, the token is in it: %d\n", strstr(page, "<canvas") != null, strstr(page, "secret123") != null);
    statusLine("wrong token:", fetch("/?t=guessguess"));
    // after a wrong token the backend makes the next try wait: this connection is simply closed
    char* again = fetch("/?t=secret123");
    printf("right token, at once: %s\n", again[0] == 0 ? "connection closed (wait a moment)" : "served");
    printf("viewers (WebSocket connections): %d\n", web->viewers());

    // an invalid token needs at least 8 letters or digits: the backend refuses to start
    wweb.Web* weak = new wweb.Web(320, 200, 0, "127.0.0.1", "abc");
    printf("token \"abc\": backend ok: %d\n", weak->ok());
    return 0;
}
