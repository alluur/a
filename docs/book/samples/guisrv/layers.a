// Layers: a wallpaper below, a panel above, and ordinary windows between them
// book: shot=out.png
import wsrv;
import gui;
import adp;
import gfx;
import gimg;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 20; i++) { srv->step(0); d->pump(0); } }

int main() {
    screen = new wsrv.Headless(400, 240);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "desktop");

    // the wallpaper: no frame, never above another window, never takes the focus
    gui.Window* paper = d->createWindowAt("wallpaper", 0, 0, 400, 240, adp.F_NODECOR | adp.F_BELOW | adp.F_NOFOCUS);
    gui.Canvas* art = new gui.Canvas(400, 240);
    art->surf->gradientV(0, 0, 400, 240, gfx.rgb(255, 190, 120), gfx.rgb(120, 40, 90));
    art->surf->fillCircle(320, 70, 36, gfx.rgb(255, 240, 200));
    paper->setRoot(art);

    // a panel: no frame, above everything, no focus
    gui.Window* panel = d->createWindowAt("panel", 0, 0, 400, 26, adp.F_NODECOR | adp.F_ABOVE | adp.F_NOFOCUS);
    gui.Box* bar = gui.hbox(8, 4);
    bar->add(new gui.Label("Apps   Files   Terminal"));
    panel->setRoot(bar);

    // an ordinary window, put so that its title bar is partly under the panel
    gui.Window* w = d->createWindowAt("Notes", 90, 60, 200, 100, 0);
    gui.Box* col = gui.vbox(0, 12);
    col->add(new gui.Label("A normal window"));
    w->setRoot(col);
    settle();

    // drag it up so that it goes under the panel: the panel stays on top
    wsrv.Win* win = srv->windowAt(1);
    screen->moveTo(win->x + 40, win->y - 13);
    screen->buttonDown(1);
    screen->moveTo(win->x + 40, 14);
    screen->buttonUp(1);
    settle();
    for (int i = 0; i < srv->windowCount(); i++) {
        wsrv.Win* x = srv->windowAt(i);
        printf("%-9s at %3d,%3d  frame %d  below %d  above %d\n", x->title, x->x, x->y, x->decorated(), (x->flags & adp.F_BELOW) != 0, (x->flags & adp.F_ABOVE) != 0);
    }
    screen->moveTo(399, 239);
    settle();
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
