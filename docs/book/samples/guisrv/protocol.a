// Speaking the display protocol by hand
// book: shot=out.png
import wsrv;
import adp;
import net;
import gimg;
import gfx;

wsrv.Server* srv;
int sock;
adp.Bytes* msg;

// Q_PING is answered with E_PONG after everything before it was handled: a way to wait for the server.
// (The server runs in this very program, so we have to give it turns.)
void sync() {
    adp.Bytes ping();
    ping.begin(adp.Q_PING);
    ping.add32(1);
    ping.finish();
    net.send(sock, ping.data, ping.len);
    char buf[64];
    for (int i = 0; i < 200; i++) {
        srv->step(0);
        if (net.waitReadable(sock, 10)) {
            if (net.recv(sock, &buf[0], 64) > 0 && adp.get32(&buf[0], 4) == adp.E_PONG) { return; }
        }
    }
}

// send the message that is built in msg: int32 length, int32 opcode, payload
void send() {
    msg->finish();
    net.send(sock, msg->data, msg->len);
    sync();
}

int main() {
    wsrv.Headless* screen = new wsrv.Headless(240, 140);
    int probe = net.listen(0, 1);                      // find a free port
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    msg = new adp.Bytes();

    sock = net.connect("127.0.0.1", port);
    msg->begin(adp.Q_HELLO);                           // version, then the name of the client
    msg->add32(adp.VERSION);
    msg->addText("raw");
    msg->finish();
    net.send(sock, msg->data, msg->len);
    char buf[256];
    int n = 0;
    for (int i = 0; i < 100 && n == 0; i++) {         // the server answers on its next turn
        srv->step(0);
        if (net.waitReadable(sock, 10)) { n = net.recv(sock, &buf[0], 256); }
    }
    // the answer: length, opcode, then version, client number, screen width, screen height
    printf("reply: %d bytes, opcode %d (E_WELCOME is %d)\n", n, adp.get32(&buf[0], 4), adp.E_WELCOME);
    printf("screen %d x %d, we are client %d\n", adp.get32(&buf[0], 16), adp.get32(&buf[0], 20), adp.get32(&buf[0], 12));

    // create window 1: id, x, y, w, h, flags, title
    msg->begin(adp.Q_CREATE);
    msg->add32(1); msg->add32(40); msg->add32(30); msg->add32(150); msg->add32(60); msg->add32(0);
    msg->addText("By hand");
    send();

    // the pixels: for each one blue, green, red, alpha. Present a vertical orange gradient
    msg->begin(adp.Q_PRESENT);
    msg->add32(1); msg->add32(0); msg->add32(0); msg->add32(150); msg->add32(60);
    for (int y = 0; y < 60; y++) {
        for (int x = 0; x < 150; x++) {
            char px[4];
            px[0] = 20; px[1] = 120 + y * 2; px[2] = 255; px[3] = 255;
            msg->addBytes(&px[0], 4);
        }
    }
    send();

    printf("windows: %d, title \"%s\"\n", srv->windowCount(), srv->windowAt(0)->title);
    wsrv.Win* win = srv->windowAt(0);
    printf("client area at %d,%d size %d x %d\n", win->x, win->y, win->w, win->h);
    int p = srv->screen->get(60, 50);                  // a pixel inside the window, on the screen
    printf("pixel on the screen: %08x\n", p);
    screen->moveTo(230, 130);                          // the pointer out of the way
    srv->step(0);
    gimg.savePng(srv->screen, "out.png");
    return 0;
}
