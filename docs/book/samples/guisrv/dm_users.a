// Users, password hashes and the display manager's configuration file
import dm;

int main() {
    // a users file has one line per user: name:hash:uid:gid:home:session
    char* ada = dm.makeUserLine("ada", "hunter2", "saltsalt", 1000, 1000, "/home/ada", "");
    char* low = dm.makeUserLine("daemon", "pw", "saltsalt", 5, 5, "/", "");
    char* hash = dm.field(ada, 1, ':');
    hash[12] = 0;                                  // keep "$6$" + the salt + "$": the rest is the SHA-512 digest
    printf("hash starts with %s\n", hash);
    printf("fields of the line: name %s, uid %s, home %s\n", dm.field(ada, 0, ':'), dm.field(ada, 2, ':'), dm.field(ada, 4, ':'));
    char all[800];
    format(&all[0], 800, "# users\n%s\n%s\nlocked:!:1001:1001:/home/locked:\n", ada, low, 0, 0);
    writeFile("users.txt", &all[0]);

    dm.Config* cfg = new dm.Config();
    cfg->usersFile = "users.txt";                  // "system" would read /etc/passwd and /etc/shadow
    printf("right password:   %d\n", dm.authenticate(cfg, "ada", "hunter2") != null);
    printf("wrong password:   %d\n", dm.authenticate(cfg, "ada", "hunter3") != null);
    printf("unknown user:     %d\n", dm.authenticate(cfg, "nobody", "hunter2") != null);
    printf("locked account:   %d\n", dm.authenticate(cfg, "locked", "") != null);
    printf("uid 5 < minuid %d: %d\n", cfg->minUid, dm.authenticate(cfg, "daemon", "pw") != null);
    cfg->minUid = 0;
    printf("with minuid = 0:  %d\n", dm.authenticate(cfg, "daemon", "pw") != null);

    // the configuration file: key = value, # starts a comment, unknown keys are ignored
    writeFile("adm.conf", "# display 3, VNC on 5905\nport = 3\nVNC = 5\nlayout = fi\ngreeting = Hello there\nminuid = 500\nallowroot = 1\nunknown = x\n");
    dm.Config* c2 = new dm.Config();
    printf("loaded: %d, port %d, vnc %d, layout %s, greeting '%s', minuid %d, allowroot %d\n",
           dm.loadConfig(c2, "adm.conf"), c2->displayPort, c2->vncPort, c2->layout, c2->greeting, c2->minUid, c2->allowRoot);
    printf("a missing file: %d\n", dm.loadConfig(c2, "missing.conf"));
    return 0;
}
