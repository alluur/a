// The page the web backend serves
import wwebpage;
import cstring;

// the text of line n (0 based) of s, up to 70 characters
void showLine(char* s, int n) {
    int line = 0;
    int i = 0;
    while (s[i] != 0 && line < n) { if (s[i] == '\n') { line++; } i++; }
    char text[72];
    int k = 0;
    while (s[i] != 0 && s[i] != '\n' && k < 70) { text[k] = s[i]; k++; i++; }
    text[k] = 0;
    printf("  %s\n", &text[0]);
}

int main() {
    // The whole page, a canvas and a script, is a string inside the module: a program that
    // serves it needs no files. The token is written into a placeholder.
    char* page = wwebpage.html();
    println("the first lines:");
    showLine(page, 0);
    showLine(page, 5);
    char* marker = strstr(page, "@TOKEN@");
    printf("placeholder in the page: %d\n", marker != null);
    char* served = wwebpage.withToken(page, "abcd1234");
    printf("after withToken: placeholder %d, token present %d\n", strstr(served, "@TOKEN@") != null, strstr(served, "var token = \"abcd1234\"") != null);
    printf("the page opens a WebSocket on /ws: %d\n", strstr(page, "/ws") != null);
    return 0;
}
