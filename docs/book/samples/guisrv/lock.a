// The screen locker takes all input until the right password is typed
import wsrv;
import gui;
import glock;
import adp;
import net;

wsrv.Server* srv;
wsrv.Headless* screen;
gui.Display* d;
int clicks;
int checks;

int serve(int unused) { srv->step(0); return 0; }
void settle() { d->sync(); for (int i = 0; i < 30; i++) { srv->step(0); d->pump(0); } }
int onClick(int b) { clicks++; return 0; }

// glock asks us whether a password is right: 1 = yes
int check(int password) {
    checks++;
    return streq((char*) password, "open sesame") ? 1 : 0;
}

void type(char* password) {
    screen->typeText(password);
    screen->tap(adp.KEY_ENTER, 13);
    settle();
}

int main() {
    screen = new wsrv.Headless(400, 300);
    int probe = net.listen(0, 1);
    int port = net.localPort(probe);
    net.close(probe);
    srv = new wsrv.Server(screen, port);
    gui.idleHook = serve;
    char spec[40];
    format(&spec[0], 40, "127.0.0.1:%d", port, 0, 0, 0);
    d = gui.connectAs(&spec[0], "app");

    gui.Window* w = d->createWindow("App", 160, 80, 0);
    gui.Button* b = new gui.Button("Press");
    b->onClick = onClick;
    gui.Box* col = gui.vbox(0, 10);
    col->add(b);
    w->setRoot(col);
    settle();
    wsrv.Win* win = srv->findWindow(d->clientNum, w->id);
    int bx = win->x + b->absX() + 10;
    int by = win->y + b->absY() + 8;
    screen->click(bx, by);
    settle();
    printf("before locking: %d click(s), locked: %d\n", clicks, srv->locked());

    glock.Locker* locker = new glock.Locker(d, "ada", check);    // a window with the flag F_LOCK
    settle();
    printf("locked: %d, the lock window covers the screen: %d x %d\n", srv->locked(), srv->lockWindow()->w, srv->lockWindow()->h);
    screen->click(bx, by);                                       // goes to the locker, not to the button
    settle();
    printf("click on the button while locked: still %d\n", clicks);

    type("wrong");
    printf("wrong password: %d failure(s), unlocked: %d\n", locker->failures, locker->unlocked);
    type("open sesame");                                          // right, but too soon: a mistake costs a second
    printf("right password at once: unlocked %d, checked %d times\n", locker->unlocked, checks);
    sleepMs(1100);
    type("open sesame");
    printf("right password after the wait: unlocked %d, locked %d\n", locker->unlocked, srv->locked());

    screen->click(bx, by);
    settle();
    printf("the button works again: %d clicks\n", clicks);
    return 0;
}
