// A list box: select and activate
// book: gui
// book: dclick=170,175
import gui;

gui.ListBox* list;
gui.Label* info;
gui.Label* last;

int selected(int self) {                                 // one click, or the arrow keys
    char text[64];
    format(&text[0], 64, "Selected: %s (row %d)", list->item(list->selected), list->selected);
    info->setText(&text[0]);
    return 0;
}

int activated(int self) {                                // double click or Enter
    char text[64];
    format(&text[0], 64, "Activated: %s", list->item(list->selected));
    last->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Fruit", 260, 260, 0);
    gui.Box* col = gui.vbox(8, 14);
    info = new gui.Label("Nothing selected");
    col->add(info);
    list = new gui.ListBox();
    list->flex = 1;
    char* fruit[7] = {"Apple", "Banana", "Cherry", "Date", "Elderberry", "Fig", "Grape"};
    for (int i = 0; i < 7; i++) {
        list->addItem(fruit[i]);
    }
    list->onSelect = selected;
    list->onActivate = activated;
    col->add(list);
    last = new gui.Label("");
    col->add(last);
    w->setRoot(col);
    d->run();
    return 0;
}
