// Labels, buttons and check boxes
// book: gui
import gui;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Basic widgets", 300, 200, 0);
    gui.Box* col = gui.vbox(8, 14);

    col->add(new gui.Label("A label, left aligned"));
    gui.Label* mid = new gui.Label("Centred");
    mid->align = 1;                                      // 0 left, 1 centre, 2 right
    col->add(mid);
    gui.Label* right = new gui.Label("Right aligned, in the accent colour");
    right->align = 2;
    right->color = gui.cAccent;
    col->add(right);

    gui.Box* row = gui.hbox(8, 0);                       // a row of three buttons
    row->add(new gui.Button("Normal"));
    gui.Button* main = new gui.Button("Primary");
    main->primary = true;
    row->add(main);
    gui.Button* off = new gui.Button("Disabled");
    off->setEnabled(false);
    row->add(off);
    col->add(row);

    gui.CheckBox* on = new gui.CheckBox("A check box that is checked");
    on->setChecked(true);
    col->add(on);
    col->add(new gui.CheckBox("One that is not"));

    w->setRoot(col);
    w->fit();                                            // the window gets the size the content wants
    d->run();
    return 0;
}
