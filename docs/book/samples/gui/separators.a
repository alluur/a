// Separators and spacers
// book: gui
import gui;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Sections", 240, 190, 0);
    gui.Box* col = gui.vbox(6, 14);
    col->add(new gui.Label("Section one"));
    col->add(new gui.Separator());                       // a thin line across a column
    col->add(new gui.Label("Section two"));
    col->add(new gui.Spacer(24));                        // 24 pixels of nothing

    gui.Box* row = gui.hbox(10, 0);
    row->add(new gui.Label("Left"));
    row->add(new gui.Separator());                       // the same widget draws a vertical line in a row
    row->add(new gui.Label("Right"));
    col->add(row);

    gui.Box* bar = gui.hbox(6, 0);
    gui.Spacer* push = new gui.Spacer(1);
    push->flex = 1;                                      // an elastic spacer pushes the button to the right
    bar->add(push);
    bar->add(new gui.Button("OK"));
    col->add(bar);
    w->setRoot(col);
    d->run();
    return 0;
}
