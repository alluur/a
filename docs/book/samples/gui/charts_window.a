// Charts, a gauge, a switch and stars in a window
// book: gui
// book: click=92,100
// book: click=92,100
// book: click=92,100
// book: click=92,100
// book: click=92,100
import gui;
import gchart;
import gfx;

gchart.Chart* chart;
gchart.Gauge* gauge;
int cpu;
int step = 0;
int samples[8] = {35, 52, 61, 48, 73, 88, 64, 41};      // the "measurements" of this demo

int push(int self) {
    int v = samples[step % 8];
    step++;
    chart->push(cpu, v);                                 // the chart scrolls by itself
    gauge->setValue(v);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Monitor", 400, 340, 0);
    gui.Box* col = gui.vbox(8, 12);

    gui.Box* top = gui.hbox(10, 0);
    gui.Button* add = new gui.Button("Add sample");
    add->onClick = push;
    top->add(add);
    top->add(new gui.Label("Auto"));
    top->add(new gchart.Switch(false));
    col->add(top);

    chart = new gchart.Chart(gchart.LINE);
    cpu = chart->addSeries("CPU %", 0);
    chart->setRange(0, 100);
    chart->title = "Load";
    chart->flex = 1;                                     // fills the free space
    for (int i = 0; i < 12; i++) { chart->push(cpu, 30 + (i * 37) % 40); }
    col->add(chart);

    gui.Box* bottom = gui.hbox(14, 0);
    gauge = new gchart.Gauge(0, 100);
    bottom->add(gauge);
    gui.Box* mood = gui.vbox(6, 0);
    mood->add(new gui.Label("How is it?"));
    mood->add(new gchart.Rating(5, 4));
    bottom->add(mood);
    col->add(bottom);

    w->setRoot(col);
    d->run();
    return 0;
}
