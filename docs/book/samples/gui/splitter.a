// A splitter: two panes and a divider you can drag
// book: gui
// book: drag=161,164,230,164
import gui;
import guix;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Splitter", 340, 180, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.Splitter* split = new guix.Splitter(true, 120);   // side by side; the first pane is 120 pixels wide
    split->flex = 1;
    gui.ListBox* list = new gui.ListBox();
    list->addItem("Inbox");
    list->addItem("Drafts");
    list->addItem("Sent");
    list->addItem("Archive");
    split->add(list);                                    // the first widget
    gui.TextArea* text = new gui.TextArea();
    text->setText("The second pane takes the rest.\nDrag the divider to change the split.");
    split->add(text);                                    // the second one
    col->add(split);

    w->setRoot(col);
    d->run();
    return 0;
}
