// A confirmation dialog
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int answered(int yes) {                                  // 1 for Yes, 0 for No or a closed window
    info->setText(yes != 0 ? "The file was deleted" : "Nothing was deleted");
    return 0;
}

int ask(int self) {
    guix.confirm(disp, "Delete", "Delete notes.txt for good?", answered);
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Files", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("notes.txt");
    col->add(info);
    gui.Button* b = new gui.Button("Delete...");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
