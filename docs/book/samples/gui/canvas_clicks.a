// A canvas: a surface you draw on, and its mouse events
// book: gui
// book: click=80,110
// book: click=150,140
// book: click=210,100
import gui;
import adp;
import gfx;

gui.Label* where;
int dots = 0;

int mouse(int self) {
    gui.Canvas* c = (gui.Canvas*) self;
    if (c->lastKind == adp.M_DOWN && c->lastButton == 1) {      // a left button press
        int colours[3] = {gfx.RED, gfx.BLUE, gfx.GREEN};
        c->surf->fillCircle(c->lastX, c->lastY, 14, colours[dots % 3]);   // draw into the canvas's own surface
        dots++;
        c->invalidate();                                         // and ask for a repaint
        char text[48];
        format(&text[0], 48, "Dot %d at %d, %d", dots, c->lastX, c->lastY);   // coordinates inside the canvas
        where->setText(&text[0]);
    }
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Canvas", 270, 170, 0);
    gui.Box* col = gui.vbox(8, 12);
    gui.Canvas* canvas = new gui.Canvas(240, 120);
    canvas->flex = 0;                                            // keep the size of the surface
    canvas->onMouseEvent = mouse;
    col->add(canvas);
    where = new gui.Label("Click on the canvas");
    col->add(where);
    w->setRoot(col);
    w->fit();
    d->run();
    return 0;
}
