// Text fields: placeholder, password, Enter
// book: gui
// book: type=ann
// book: key=tab
// book: type=secret1
// book: key=enter
import gui;

gui.TextBox* user;
gui.TextBox* pass;
gui.Label* status;

int signIn(int self) {
    char text[96];
    format(&text[0], 96, "Signed in as %s (%d characters)", user->text(), strlen(pass->text()));
    status->setText(&text[0]);
    return 0;
}

int main() {
    gui.caretBlinks = false;                             // a solid caret: the same picture every time
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Sign in", 300, 190, 0);
    gui.Box* col = gui.vbox(6, 14);
    col->add(new gui.Label("User name"));
    user = new gui.TextBox();
    user->placeholder = "your name";                     // grey text while the field is empty and unfocused
    col->add(user);
    col->add(new gui.Label("Password"));
    pass = new gui.TextBox();
    pass->password = true;                               // shows asterisks
    pass->onEnter = signIn;                              // Enter in the field
    col->add(pass);
    status = new gui.Label("Waiting");
    status->color = gui.cTextDim;
    col->add(status);
    w->setRoot(col);
    w->setFocus(user);                                   // the keyboard goes here first
    d->run();
    return 0;
}
