// A table: columns, rows and sorting
// book: gui
// book: click=222,98
import gui;
import guix;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Files", 360, 200, 0);
    gui.Box* col = gui.vbox(8, 12);

    guix.TableView* table = new guix.TableView();
    table->addColumn("Name", 150);                       // title and width; columns before rows
    table->addColumn("Size", 80);
    table->addColumn("Type", 90);
    table->setAlign(1, 1);                               // right align the numbers
    table->addRow("notes.txt\t1204\ttext");              // the cells of a row are separated by tabs
    table->addRow("photo.png\t88411\timage");
    table->addRow("Makefile\t310\ttext");
    table->addRow("archive.tar\t2048000\tarchive");
    table->addRow("todo.md\t96\ttext");
    int row = table->addEmptyRow();                      // or an empty row and one cell at a time
    table->setCell(row, 0, "readme");
    table->setCell(row, 1, "5120");
    table->setCell(row, 2, "text");
    col->add(table);

    w->setRoot(col);
    d->run();                                            // a click on a header sorts by that column
    return 0;
}
