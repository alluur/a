// Timers: d->after calls a function later
// book: gui
// book: wait=2000
import gui;

gui.Display* disp;
gui.Label* label;
gui.ProgressBar* bar;

int tick(int step) {                                     // the argument given to after()
    bar->setValue(step * 20);
    char text[32];
    format(&text[0], 32, "Tick %d of 5", step);
    label->setText(&text[0]);
    if (step < 5) {
        disp->after(150, tick, step + 1);                // a timer fires once: start the next one
    } else {
        label->setText("Finished");
    }
    return 0;
}

int never(int arg) {
    label->setText("this timer was not cancelled");
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Timers", 260, 90, 0);
    gui.Box* col = gui.vbox(10, 14);
    label = new gui.Label("Waiting");
    col->add(label);
    bar = new gui.ProgressBar();
    col->add(bar);
    w->setRoot(col);

    disp->after(300, tick, 1);                           // in 300 ms: tick(1)
    int id = disp->after(1000, never, 0);
    disp->cancel(id);                                    // cancel() takes the number after() returned
    disp->run();
    return 0;
}
