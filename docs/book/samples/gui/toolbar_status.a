// A toolbar with icons and a status bar
// book: gui
// book: click=130,100
import gui;
import guix;

guix.StatusBar* status;

int tool(int self) {
    guix.IconButton* b = (guix.IconButton*) self;
    status->setText(0, b->tooltip);                      // the tool tip is also the name
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Tools", 340, 160, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.Toolbar* bar = new guix.Toolbar();
    bar->addButton(guix.ICON_NEW, "New", tool);
    bar->addButton(guix.ICON_OPEN, "Open", tool);
    bar->addButton(guix.ICON_SAVE, "Save", tool);
    bar->addSeparator();
    bar->addButton(guix.ICON_CUT, "Cut", tool);
    bar->addButton(guix.ICON_COPY, "Copy", tool);
    bar->addButton(guix.ICON_PASTE, "Paste", tool);
    bar->addSeparator();
    guix.IconButton* star = bar->addButton(guix.ICON_STAR, "Favourite", tool);
    star->toggle = true;                                 // stays pressed after a click
    star->checked = true;
    col->add(bar);

    gui.TextArea* area = new gui.TextArea();
    area->flex = 1;
    col->add(area);

    status = new guix.StatusBar();
    status->addSection(0);                               // width 0: takes the rest
    status->addSection(90);
    status->setText(0, "Ready");
    status->setText(1, "Ln 1, Col 1");
    col->add(status);
    w->setRoot(col);
    d->run();
    return 0;
}
