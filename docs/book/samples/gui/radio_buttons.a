// Radio buttons in a group
// book: gui
// book: click=70,172
import gui;
import guix;

gui.Label* info;

int changed(int self) {
    guix.RadioGroup* g = (guix.RadioGroup*) self;
    char* sizes[3] = {"small", "medium", "large"};
    char text[48];
    format(&text[0], 48, "Size: %s", sizes[g->selectedIndex()]);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Radio", 220, 160, 0);
    gui.Box* col = gui.vbox(6, 14);
    col->add(new gui.Label("Pick a size"));
    guix.RadioGroup* group = new guix.RadioGroup();      // the group first, then the buttons
    col->add(new guix.RadioButton("Small", group));
    col->add(new guix.RadioButton("Medium", group));
    col->add(new guix.RadioButton("Large", group));
    info = new gui.Label("");
    col->add(info);
    group->onChange = changed;
    group->selectIndex(0);                               // exactly one button is always chosen
    w->setRoot(col);
    d->run();
    return 0;
}
