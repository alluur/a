// A tree
// book: gui
import gui;
import guix;

gui.Label* info;

int picked(int self) {
    guix.TreeView* t = (guix.TreeView*) self;
    char text[64];
    format(&text[0], 64, "Selected: %s", t->selected->text);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Tree", 280, 260, 0);
    gui.Box* col = gui.vbox(8, 12);

    guix.TreeView* tree = new guix.TreeView();
    tree->flex = 1;
    guix.TreeNode* book = tree->addRoot("book");         // a top level node
    guix.TreeNode* src = book->add("src");               // its children
    src->add("50-graphics.md");
    src->add("51-gui-basics.md");
    guix.TreeNode* samples = book->add("samples");
    samples->add("gfx");
    samples->add("gui");
    guix.TreeNode* tools = tree->addRoot("tools");
    tools->add("samples.py");
    tools->add("shots.py");
    tree->expand(book, true);
    tree->expand(src, true);
    tree->expand(tools, true);
    info = new gui.Label("");
    tree->onSelect = picked;
    col->add(tree);
    col->add(info);
    w->setRoot(col);
    tree->select(src);
    d->run();
    return 0;
}
