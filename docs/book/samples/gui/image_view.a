// A picture in a window: ImageView
// book: gui
import gui;
import gfx;
import gimg;

int main() {
    // make a picture, save it, and load it again like any file
    gfx.Surface* art = new gfx.Surface(200, 120);
    art->gradientV(0, 0, 200, 120, gfx.rgb(120, 190, 250), gfx.rgb(250, 230, 190));
    art->fillCircle(150, 35, 16, gfx.YELLOW);
    art->fillRoundRect(0, 85, 200, 35, 0, gfx.rgb(70, 150, 80));
    art->text(gfx.sansBold(), 10, 8, "From a PNG file", gfx.WHITE);
    gimg.savePng(art, "landscape.png");

    gfx.Surface* picture = gimg.load("landscape.png");
    if (picture == null) { return 1; }
    gfx.Surface* thumb = gimg.fit(picture, 80, 80);      // smaller, same proportions

    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Pictures", 300, 200, 0);
    gui.Box* col = gui.vbox(8, 12);
    col->add(new gui.ImageView(picture));
    gui.Box* row = gui.hbox(10, 0);
    row->add(new gui.ImageView(thumb));
    char text[64];
    format(&text[0], 64, "A thumbnail: %d x %d", thumb->w, thumb->h);
    row->add(new gui.Label(&text[0]));
    col->add(row);
    w->setRoot(col);
    w->fit();
    d->run();
    return 0;
}
