// The save file dialog
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int chosen(int path) {
    if (path == 0) {
        info->setText("Not saved");
    } else {
        char text[160];
        format(&text[0], 160, "Would save to %s", (char*) path);
        info->setText(&text[0]);
    }
    return 0;
}

int ask(int self) {
    // title, start directory, suggested name; the dialog asks before it replaces a file that exists
    guix.saveFile(disp, "Save as", ".", "report.txt", chosen);
    return 0;
}

int main() {
    gui.caretBlinks = false;
    writeFile("report.txt", "last year\n");
    writeFile("budget.csv", "a,b\n");
    makeDir("archive");
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Report", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("Unsaved");
    col->add(info);
    gui.Button* b = new gui.Button("Save as...");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
