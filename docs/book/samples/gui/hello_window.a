// A window with a label and a button
// book: gui
// book: wait=800
// book: click=170,133
import gui;

int count = 0;
gui.Label* label;

int clicked(int self) {                                  // every callback gets the widget as an int
    count++;
    char text[64];
    format(&text[0], 64, "You clicked %d time%s", count, count == 1 ? "" : "s");
    label->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);                  // reads the ADISPLAY variable
    if (d == null) {
        eprintln("no display server: start adisplayd and set ADISPLAY");
        return 1;
    }
    gui.Window* w = d->createWindow("Hello", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);                     // spacing 10, padding 14
    label = new gui.Label("Press the button");
    col->add(label);
    gui.Button* b = new gui.Button("Click me");
    b->primary = true;
    b->onClick = clicked;
    col->add(b);
    w->setRoot(col);
    d->run();                                            // until the last window is closed
    return 0;
}
