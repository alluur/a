// Window events: keys, resizing and closing
// book: gui
// book: key=x
import gui;

gui.Label* info;
int closeTries = 0;

int unusedKey(int window, int key, int uni) {            // keys that no widget wanted
    char text[64];
    format(&text[0], 64, "Last key: %d (%c)", key, uni);
    info->setText(&text[0]);
    return 0;
}

int resized(int window) {
    gui.Window* w = (gui.Window*) window;
    char text[64];
    format(&text[0], 64, "Resized to %d x %d", w->w, w->h);
    info->setText(&text[0]);
    return 0;
}

int askClose(int window) {                               // return non zero to keep the window open
    closeTries++;
    if (closeTries == 1) {
        info->setText("Close it once more to quit");
        return 1;
    }
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Events", 260, 80, 0);
    gui.Box* col = gui.vbox(8, 14);
    info = new gui.Label("Press a key, resize or close the window");
    col->add(info);
    w->setRoot(col);
    w->onKey = unusedKey;
    w->onResize = resized;
    w->onClose = askClose;
    d->run();
    return 0;
}
