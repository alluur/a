// A counter, first version: a label and two buttons
// book: gui
// book: click=200,133
// book: click=200,133
// book: click=200,133
import gui;
import gfx;

int count = 0;
gui.Label* shown;

void show() {
    char text[32];
    format(&text[0], 32, "%d", count);
    shown->setText(&text[0]);
}

int plus(int self) { count++; show(); return 0; }
int minus(int self) { count--; show(); return 0; }

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Counter", 220, 100, 0);
    gui.Box* col = gui.vbox(10, 14);

    shown = new gui.Label("0");
    shown->align = 1;
    shown->font = gfx.sansBold();
    col->add(shown);

    gui.Box* row = gui.hbox(10, 0);
    gui.Button* less = new gui.Button("-");
    less->onClick = minus;
    less->flex = 1;                                      // both buttons share the width
    row->add(less);
    gui.Button* more = new gui.Button("+");
    more->onClick = plus;
    more->flex = 1;
    more->primary = true;
    row->add(more);
    col->add(row);

    w->setRoot(col);
    d->run();
    return 0;
}
