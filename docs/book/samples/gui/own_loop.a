// Your own main loop with pump
// book: gui
import gui;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Work", 280, 100, 0);
    gui.Box* col = gui.vbox(10, 14);
    gui.Label* label = new gui.Label("Working");
    col->add(label);
    gui.ProgressBar* bar = new gui.ProgressBar();
    col->add(bar);
    w->setRoot(col);

    // instead of d->run(): one step of work, then let the library handle events for up to 5 ms
    int done = 0;
    while (!d->quit) {
        if (done < 100) {
            done++;
            bar->setValue(done);
            if (done == 100) {
                label->setText("All 100 steps done");
            }
        }
        d->pump(5);                                      // paints, reads events, runs timers
    }
    println("window closed");
    return 0;
}
