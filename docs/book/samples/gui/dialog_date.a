// The date dialog and the calendar widget
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int chosen(int packed) {                                 // year * 10000 + month * 100 + day, 0 when cancelled
    char text[48];
    format(&text[0], 48, "%04d-%02d-%02d", packed / 10000, packed / 100 % 100, packed % 100);
    info->setText(packed == 0 ? "Cancelled" : &text[0]);
    return 0;
}

int ask(int self) {
    guix.chooseDate(disp, "Pick a date", 2025, 3, 14, chosen);   // starts on 14 March 2025
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Planner", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("No date");
    col->add(info);
    gui.Button* b = new gui.Button("Date...");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
