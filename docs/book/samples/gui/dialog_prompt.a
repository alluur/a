// Asking for a line of text
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int answered(int text) {                                 // a char*, or 0 when the dialog was cancelled
    if (text == 0) {
        info->setText("Cancelled");
    } else {
        char line[96];
        format(&line[0], 96, "Hello, %s!", (char*) text);
        info->setText(&line[0]);
    }
    return 0;
}

int ask(int self) {
    guix.prompt(disp, "Your name", "What is your name?", "Ada", answered);   // the last text is the starting value
    return 0;
}

int main() {
    gui.caretBlinks = false;
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Greeter", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("Who are you?");
    col->add(info);
    gui.Button* b = new gui.Button("Introduce yourself");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
