// The open file dialog
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int chosen(int path) {                                   // the path as a char*, 0 when cancelled
    if (path == 0) {
        info->setText("No file chosen");
    } else {
        info->setText((char*) path);
    }
    return 0;
}

int ask(int self) {
    guix.openFile(disp, "Open a file", ".", chosen);     // the start directory
    return 0;
}

int main() {
    gui.caretBlinks = false;
    writeFile("notes.txt", "some notes\n");              // so that the dialog has something to list
    writeFile("todo.txt", "buy milk\n");
    writeFile("photo.png", "not really a picture");
    makeDir("projects");

    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Viewer", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("No file");
    col->add(info);
    gui.Button* b = new gui.Button("Open...");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
