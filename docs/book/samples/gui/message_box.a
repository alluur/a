// A message box
// book: gui
// book: click=170,133
import gui;

gui.Display* disp;

int save(int self) {
    gui.messageBox(disp, "Saved", "Three files were saved.");   // a small window with an OK button
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Editor", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    col->add(new gui.Label("Press the button to save"));
    gui.Button* b = new gui.Button("Save all");
    b->onClick = save;
    col->add(b);
    w->setRoot(col);
    disp->run();                                         // ends when both windows are closed
    return 0;
}
