// Your own widget: a knob
// book: gui
// book: click=100,140
// book: click=100,140
// book: scroll=100,140,4
import gui;
import gfx;
import adp;

class Knob : gui.Widget {
    public int value;                                    // 0 to 100

    public Knob() {
        super();                                         // always first
        focusable = true;                                // it can take the keyboard focus
    }

    public virtual int prefW() { return 90; }
    public virtual int prefH() { return 90; }
    public virtual bool wantsScroll() { return true; }   // without this the wheel never reaches the widget

    public void set(int v) {
        value = (v < 0) ? 0 : (v > 100) ? 100 : v;
        invalidate();                                    // ask for a repaint of this widget
    }

    // ox, oy: where the widget's top left corner is on the surface
    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int cx = ox + w / 2;
        int cy = oy + h / 2;
        s->thickArc(cx, cy, 30, 40, 135, 405, gui.cBorder);                       // the track
        if (value > 0) {
            s->thickArc(cx, cy, 30, 40, 135, 135 + 270 * value / 100, gui.cAccent);
        }
        char text[16];
        format(&text[0], 16, "%d", value);
        s->textCentered(gfx.sansBold(), cx - 20, cy - 10, 40, 20, &text[0], gui.cText);
        if (win != null && win->focusWidget == this) {
            s->circle(cx, cy, 44, gui.cAccent);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            set(value + 10);                             // (a click gives a focusable widget the focus by itself)
        } else if (kind == adp.M_SCROLL) {
            set(value + button * 5);                     // the wheel: +1 up, -1 down
        }
        return true;                                     // the event is used
    }

    public virtual bool onKey(int down, int key, int uni, int mods) {
        if (down != 0 && key == adp.KEY_UP) { set(value + 1); return true; }
        if (down != 0 && key == adp.KEY_DOWN) { set(value - 1); return true; }
        return false;
    }
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Knob", 130, 130, 0);
    gui.Box* col = gui.vbox(6, 12);
    col->add(new Knob());
    w->setRoot(col);
    d->run();
    return 0;
}
