// A combo box (drop-down list)
// book: gui
// book: click=170,117
import gui;
import guix;

gui.Label* info;

int picked(int self) {
    guix.ComboBox* c = (guix.ComboBox*) self;
    char text[64];
    format(&text[0], 64, "Selected %d: %s", c->selected, c->text());
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Combo", 260, 220, 0);
    gui.Box* col = gui.vbox(8, 14);
    col->add(new gui.Label("Colour"));
    guix.ComboBox* c = new guix.ComboBox();
    char* names[5] = {"Red", "Orange", "Yellow", "Green", "Blue"};
    for (int i = 0; i < 5; i++) {
        c->addItem(names[i]);
    }
    c->select(3);                                        // start with Green (this also calls onChange)
    c->onChange = picked;
    col->add(c);
    info = new gui.Label("");
    col->add(info);
    w->setRoot(col);
    d->run();
    return 0;
}
