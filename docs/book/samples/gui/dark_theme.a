// A dark colour scheme
// book: gui
import gui;
import guix;

int main() {
    // the widgets read these globals when they paint: set them before you build the window
    gui.cBack = 0xFF22262E;
    gui.cText = 0xFFE6E8EE;
    gui.cTextDim = 0xFF8C92A0;
    gui.cAccent = 0xFF5B9DFF;
    gui.cAccentText = 0xFF10131A;
    gui.cField = 0xFF2C313B;
    gui.cBorder = 0xFF4A5160;
    gui.cButton = 0xFF343A46;
    gui.cButtonHot = 0xFF414958;
    gui.cButtonDown = 0xFF2A2F39;
    gui.cSelect = 0xFF3A4A66;
    guix.cPanel = 0xFF2C313B;                            // menu popups
    gui.caretBlinks = false;

    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Dark", 320, 250, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.MenuBar* bar = new guix.MenuBar();
    bar->background = 0xFF2C313B;                        // the bar and the toolbar have a colour of their own
    bar->addMenu("&File")->add("Quit", null);
    bar->addMenu("&View");
    col->add(bar);

    gui.Box* body = gui.vbox(8, 12);
    body->add(new gui.Label("Everything follows the scheme"));
    gui.TextBox* field = new gui.TextBox();
    field->setText("A text field");
    body->add(field);
    gui.Box* row = gui.hbox(8, 0);
    row->add(new gui.Button("Cancel"));
    gui.Button* ok = new gui.Button("OK");
    ok->primary = true;
    row->add(ok);
    body->add(row);
    gui.CheckBox* c = new gui.CheckBox("A check box");
    c->setChecked(true);
    body->add(c);
    gui.ListBox* list = new gui.ListBox();
    list->addItem("First");
    list->addItem("Second");
    list->addItem("Third");
    list->select(1);
    list->flex = 1;
    body->add(list);
    gui.Slider* s = new gui.Slider(0, 100);
    s->setValue(40);
    body->add(s);
    body->flex = 1;
    col->add(body);
    w->setRoot(col);
    d->run();
    return 0;
}
