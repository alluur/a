// A menu bar with accelerators
// book: gui
// book: click=66,87
import gui;
import guix;

gui.Label* info;

int chosen(int item) {                                   // every menu callback gets the item
    guix.MenuItem* m = (guix.MenuItem*) item;
    char text[64];
    format(&text[0], 64, "You chose: %s", m->text);
    info->setText(&text[0]);
    return 0;
}

gui.Display* disp;

int quit(int item) {
    disp->quit = true;                                   // the event loop ends
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Menus", 320, 200, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");             // Alt+F opens it
    file->add("New", chosen)->accel("Ctrl+N");           // the accelerator works while the bar is in the window
    file->add("Open...", chosen)->accel("Ctrl+O");
    file->add("Save", chosen)->accel("Ctrl+S");
    file->add("Save as...", chosen)->accel("Ctrl+Shift+S");
    file->addSeparator();
    file->add("Print", chosen)->disable();               // a disabled item is grey and does nothing
    file->add("Quit", quit)->accel("Ctrl+Q");
    guix.Menu* edit = bar->addMenu("&Edit");
    edit->add("Undo", chosen)->accel("Ctrl+Z");
    edit->add("Redo", chosen)->accel("Ctrl+Y");
    bar->addMenu("&Help")->add("About", chosen);
    col->add(bar);                                       // at the top of the window

    gui.Box* body = gui.vbox(6, 12);
    info = new gui.Label("Open a menu, or press Alt+F");
    body->add(info);
    col->add(body);
    w->setRoot(col);
    disp->run();
    return 0;
}
