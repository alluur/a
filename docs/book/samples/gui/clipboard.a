// The clipboard
// book: gui
// book: click=170,136
// book: click=170,171
// book: key=ctrl+v
import gui;

gui.Display* disp;
gui.TextBox* source;

int copy(int self) {
    disp->setClipboard(source->text());                  // any program on the display can paste it
    return 0;
}

int main() {
    gui.caretBlinks = false;
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Clipboard", 300, 130, 0);
    gui.Box* col = gui.vbox(8, 14);
    source = new gui.TextBox();
    source->setText("Text to copy");
    col->add(source);
    gui.Button* b = new gui.Button("Copy with setClipboard()");
    b->onClick = copy;
    col->add(b);
    gui.TextBox* target = new gui.TextBox();
    target->placeholder = "paste here with Ctrl+V";      // Ctrl+A, C, X and V work in every TextBox
    col->add(target);
    w->setRoot(col);
    disp->run();
    return 0;
}
