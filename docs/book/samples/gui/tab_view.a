// Tabs
// book: gui
// book: click=170,100
import gui;
import guix;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Settings", 320, 190, 0);
    gui.Box* col = gui.vbox(0, 8);

    guix.TabView* tabs = new guix.TabView();
    tabs->flex = 1;

    gui.Box* general = gui.vbox(8, 12);                  // every page is a widget, usually a Box
    general->add(new gui.CheckBox("Check for updates"));
    general->add(new gui.CheckBox("Start with the system"));
    tabs->addTab("General", general);

    gui.Box* look = gui.vbox(8, 12);
    look->add(new gui.Label("Font size"));
    look->add(new gui.Slider(8, 24));
    gui.CheckBox* dark = new gui.CheckBox("Dark colours");
    dark->setChecked(true);
    look->add(dark);
    tabs->addTab("Appearance", look);

    gui.Box* about = gui.vbox(8, 12);
    about->add(new gui.Label("Version 1.0"));
    tabs->addTab("About", about);

    col->add(tabs);
    w->setRoot(col);
    d->run();
    return 0;
}
