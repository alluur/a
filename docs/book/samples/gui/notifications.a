// Notification cards
// book: gui
// book: window=560x260
// book: click=170,133
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
int count = 0;

int notify(int self) {
    count++;
    char text[48];
    format(&text[0], 48, "Message number %d has arrived.", count);
    // kind: 0 information, 1 warning, 2 error; the last number is how long it stays (ms)
    guix.notify(disp, count == 1 ? "New mail" : "Low disk space", &text[0], count == 1 ? 0 : 1, 60000);
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Mail", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    col->add(new gui.Label("Click to get a notification"));
    gui.Button* b = new gui.Button("Notify");
    b->onClick = notify;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
