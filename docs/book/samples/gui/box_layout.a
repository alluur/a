// Boxes: rows and columns inside each other
// book: gui
import gui;

gui.Box* panel(bool vertical, int spacing, int padding, int colour) {
    gui.Box* b = new gui.Box(vertical, spacing, padding);
    b->background = colour;                              // boxes are invisible unless you give them a colour
    b->border = 0xFF9CA0AA;
    return b;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Layout", 300, 200, 0);

    gui.Box* root = panel(true, 10, 12, 0xFFD6E4F8);     // a column: spacing 10, padding 12
    gui.Box* top = panel(false, 6, 6, 0xFFFFF2D8);       // a row
    top->add(new gui.Label("Name"));
    top->add(new gui.TextBox());
    root->add(top);

    gui.Box* buttons = panel(false, 12, 4, 0xFFFFFFFF);
    buttons->add(new gui.Button("One"));
    buttons->add(new gui.Button("Two"));
    buttons->add(new gui.Button("Three"));
    root->add(buttons);

    gui.Box* list = panel(true, 0, 8, 0xFFE4F4E4);       // no spacing: the labels touch
    list->add(new gui.Label("A column inside a column"));
    list->add(new gui.Label("with its own padding"));
    root->add(list);

    w->setRoot(root);
    w->fit();
    d->run();
    return 0;
}
