// A multi-line text area that counts what you type
// book: gui
// book: key=down
// book: key=end
// book: key=enter
// book: type=Third line
import gui;

gui.TextArea* area;
gui.Label* info;

int changed(int self) {
    char text[64];
    format(&text[0], 64, "%d lines, %d characters", area->lineCount(), strlen(area->text()));
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.caretBlinks = false;
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Notes", 300, 200, 0);
    gui.Box* col = gui.vbox(8, 12);
    area = new gui.TextArea();
    area->flex = 1;                                      // fills the window
    area->onChange = changed;                            // after every edit
    area->setText("First line\nSecond line");
    col->add(area);
    info = new gui.Label("");
    col->add(info);
    w->setRoot(col);
    changed(0);
    w->setFocus(area);
    d->run();
    return 0;
}
