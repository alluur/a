// A scroll view around a long column
// book: gui
// book: scroll=150,150,-5
import gui;
import guix;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Scrolling", 280, 200, 0);
    gui.Box* col = gui.vbox(0, 8);

    gui.Box* many = gui.vbox(4, 8);                      // the content: 40 labels, taller than the window
    for (int i = 1; i <= 40; i++) {
        char text[40];
        format(&text[0], 40, "Row number %d", i);
        many->add(new gui.Label(&text[0]));
    }
    guix.ScrollView* view = new guix.ScrollView();
    view->fitWidth = true;                               // as wide as the view: only up and down
    view->flex = 1;
    view->setContent(many);
    col->add(view);

    w->setRoot(col);
    d->run();
    return 0;
}
