// A to-do list, finished: done marks, remove, count and a file
// book: gui
// book: type=Buy milk
// book: key=enter
// book: type=Write the chapter
// book: key=enter
// book: type=Call Ann
// book: key=enter
// book: click=150,157
// book: click=124,319
import gui;

const MAX = 50;
char* tasks[MAX];
bool done[MAX];
int count = 0;
gui.TextBox* entry;
gui.ListBox* list;
gui.Label* summary;

void save() {                                            // one line per task: "x text" or "- text"
    char* text = "";
    for (int i = 0; i < count; i++) {
        text = appendLine(text, done[i] ? "x " : "- ", tasks[i]);
    }
    writeFile("todo.txt", text);
}

char* appendLine(char* old, char* mark, char* task) {       // old + mark + task + a newline, as a new string
    char* r = malloc(strlen(old) + strlen(mark) + strlen(task) + 2);
    strcpy(r, old);
    strcat(r, mark);
    strcat(r, task);
    strcat(r, "\n");
    return r;
}

void refresh() {
    int keep = list->selected;
    list->clear();
    int open = 0;
    for (int i = 0; i < count; i++) {
        char line[128];
        format(&line[0], 128, "%s %s", done[i] ? "[x]" : "[ ]", tasks[i]);
        list->addItem(&line[0]);
        if (!done[i]) { open++; }
    }
    if (keep >= 0 && keep < count) { list->select(keep); }
    char text[48];
    format(&text[0], 48, "%d of %d tasks open", open, count);
    summary->setText(&text[0]);
    save();
}

int addTask(int self) {
    char* text = entry->text();
    if (strlen(text) > 0 && count < MAX) {
        tasks[count] = strdup(text);
        done[count] = false;
        count++;
        entry->setText("");
        refresh();
    }
    return 0;
}

int toggleTask(int self) {
    int i = list->selected;
    if (i >= 0) { done[i] = !done[i]; refresh(); }
    return 0;
}

int removeTask(int self) {
    int i = list->selected;
    if (i < 0) { return 0; }
    for (int k = i; k < count - 1; k++) { tasks[k] = tasks[k + 1]; done[k] = done[k + 1]; }
    count--;
    list->selected = -1;
    refresh();
    return 0;
}

int main() {
    gui.caretBlinks = false;
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("To do", 320, 300, 0);
    gui.Box* col = gui.vbox(8, 12);

    gui.Box* row = gui.hbox(8, 0);
    entry = new gui.TextBox();
    entry->placeholder = "New task";
    entry->flex = 1;
    entry->onEnter = addTask;
    row->add(entry);
    gui.Button* add = new gui.Button("Add");
    add->onClick = addTask;
    row->add(add);
    col->add(row);

    list = new gui.ListBox();
    list->flex = 1;
    col->add(list);

    gui.Box* buttons = gui.hbox(8, 0);
    gui.Button* t = new gui.Button("Done / not done");
    t->onClick = toggleTask;
    t->flex = 1;
    buttons->add(t);
    gui.Button* r = new gui.Button("Remove");
    r->onClick = removeTask;
    r->flex = 1;
    buttons->add(r);
    col->add(buttons);
    summary = new gui.Label("");
    col->add(summary);

    w->setRoot(col);
    w->setFocus(entry);
    refresh();
    d->run();
    return 0;
}
