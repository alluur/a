// Flex: sharing the free space
// book: gui
import gui;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Flex", 380, 220, 0);
    gui.Box* col = gui.vbox(8, 10);

    gui.Box* search = gui.hbox(8, 0);
    search->add(new gui.Label("Search"));               // flex 0: its preferred size
    gui.TextBox* field = new gui.TextBox();
    field->flex = 1;                                    // takes what is left
    search->add(field);
    search->add(new gui.Button("Go"));
    col->add(search);

    gui.Box* shares = gui.hbox(6, 0);                    // shares of the free width: 1 : 2 : 1
    int weights[3] = {1, 2, 1};
    for (int i = 0; i < 3; i++) {
        char t[16];
        format(&t[0], 16, "flex %d", weights[i]);
        gui.Button* b = new gui.Button(&t[0]);
        b->flex = weights[i];
        shares->add(b);
    }
    col->add(shares);

    gui.ListBox* list = new gui.ListBox();               // flex 1 in a column: it grows downwards
    list->flex = 1;
    list->addItem("Everything below the rows");
    list->addItem("belongs to this list");
    col->add(list);

    w->setRoot(col);                                     // no fit(): the window keeps 380 x 220
    d->run();
    return 0;
}
