// The icons of guix
// book: shot=out.png
import gui;
import guix;
import gfx;
import gimg;

int main() {
    char* names[31] = {"NEW", "OPEN", "SAVE", "CUT", "COPY", "PASTE", "UNDO", "REDO", "PLUS", "MINUS",
                       "CLOSE", "CHECK", "LEFT", "RIGHT", "UP", "DOWN", "REFRESH", "SEARCH", "HOME", "SETTINGS",
                       "TRASH", "PLAY", "PAUSE", "STOP", "STAR", "INFO", "WARNING", "BUILD", "BUG", "FOLDER", "PANEL"};
    gfx.Surface* s = new gfx.Surface(490, 230);
    s->clear(gui.cBack);
    for (int i = 0; i < 31; i++) {
        int x = 8 + (i % 7) * 68;
        int y = 10 + (i / 7) * 44;
        guix.drawIcon(s, i + 1, x + 26, y, gui.cText);   // 16 x 16 pixels, any surface, any colour
        s->text(gfx.sans(), x + 34 - gfx.textWidth(gfx.sans(), names[i]) / 2, y + 17, names[i], gui.cTextDim);
    }
    printf("ICON_NEW = %d, ICON_SETTINGS = %d, ICON_PANEL = %d\n", guix.ICON_NEW, guix.ICON_SETTINGS, guix.ICON_PANEL);
    gimg.savePng(s, "out.png");
    return 0;
}
