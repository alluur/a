// Three sliders and a colour swatch
// book: gui
// book: drag=81,186,267,186
// book: drag=81,216,160,216
// book: drag=81,246,318,246
import gui;
import guix;

guix.Swatch* swatch;
gui.Label* hex;
gui.Slider* red;
gui.Slider* green;
gui.Slider* blue;

int mixed(int self) {
    int colour = 0xFF000000 | (red->value << 16) | (green->value << 8) | blue->value;
    swatch->color = colour;
    swatch->invalidate();
    char text[24];
    format(&text[0], 24, "#%06X", colour & 0xFFFFFF);
    hex->setText(&text[0]);
    return 0;
}

gui.Slider* row(gui.Box* col, char* name) {
    gui.Box* r = gui.hbox(8, 0);
    r->add(new gui.Label(name));
    gui.Slider* s = new gui.Slider(0, 255);
    s->flex = 1;
    s->onChange = mixed;
    r->add(s);
    col->add(r);
    return s;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Mixer", 300, 230, 0);
    gui.Box* col = gui.vbox(8, 14);
    swatch = new guix.Swatch(0xFF000000, 100, 50);       // colour, width, height
    swatch->flex = 0;
    col->add(swatch);
    hex = new gui.Label("#000000");
    col->add(hex);
    red = row(col, "R");
    green = row(col, "G");
    blue = row(col, "B");
    w->setRoot(col);
    d->run();
    return 0;
}
