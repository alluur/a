// The clock face widget as a module (clockface.a)
import gui;
import gfx;
module clockface;

public class ClockFace : gui.Widget {
    public int hour;
    public int minute;
    public int second;
    public bool showSeconds;

    public ClockFace() {
        super();
        showSeconds = true;
    }

    public virtual int prefW() { return 200; }
    public virtual int prefH() { return 200; }

    public void setTime(int h, int m, int s) {
        hour = h;
        minute = m;
        second = s;
        invalidate();                                    // paint again
    }

    // angle in degrees, 0 = three o'clock, clockwise
    private void hand(gfx.Surface* s, int cx, int cy, int angle, int length, int width, int colour) {
        int xs[4];
        int ys[4];
        xs[0] = cx + width * gfx.icos(angle + 90) / 1024;
        ys[0] = cy + width * gfx.isin(angle + 90) / 1024;
        xs[1] = cx + length * gfx.icos(angle) / 1024;
        ys[1] = cy + length * gfx.isin(angle) / 1024;
        xs[2] = cx + width * gfx.icos(angle - 90) / 1024;
        ys[2] = cy + width * gfx.isin(angle - 90) / 1024;
        xs[3] = cx - 12 * gfx.icos(angle) / 1024;
        ys[3] = cy - 12 * gfx.isin(angle) / 1024;
        s->fillPolygon(xs, ys, 4, colour);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int cx = ox + w / 2;
        int cy = oy + h / 2;
        int r = ((w < h) ? w : h) / 2 - 6;
        s->fillCircle(cx, cy, r, gfx.WHITE);
        s->circle(cx, cy, r, gui.cBorder);
        for (int i = 0; i < 60; i++) {
            int len = (i % 5 == 0) ? 12 : 4;
            int a = i * 6;
            s->line(cx + (r - len) * gfx.icos(a) / 1024, cy + (r - len) * gfx.isin(a) / 1024,
                    cx + (r - 2) * gfx.icos(a) / 1024, cy + (r - 2) * gfx.isin(a) / 1024, i % 5 == 0 ? gui.cText : gui.cTextDim);
        }
        hand(s, cx, cy, (hour % 12) * 30 + minute / 2 - 90, r * 5 / 10, 4, gui.cText);
        hand(s, cx, cy, minute * 6 + second / 10 - 90, r * 8 / 10, 3, gui.cText);
        if (showSeconds) {
            hand(s, cx, cy, second * 6 - 90, r * 9 / 10, 1, gfx.RED);
        }
        s->fillCircle(cx, cy, 4, showSeconds ? gfx.RED : gui.cText);
    }
}
