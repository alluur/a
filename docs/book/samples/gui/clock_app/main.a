// A live analog clock in UTC, or a frozen one: clock 10:08:35
// book: gui
// book: args=10:08:35
// book: click=70,326
import gui;
import gfx;
import datetime;
import clockface;

gui.Display* disp;
clockface.ClockFace* face;
gui.Label* digital;
gui.CheckBox* seconds;

void show(int h, int m, int s) {
    face->setTime(h, m, s);
    char text[32];
    format(&text[0], 32, "%02d:%02d:%02d UTC", h, m, s);
    digital->setText(&text[0]);
}

int tick(int arg) {                                      // once a second
    datetime.DateTime* now = new datetime.DateTime(datetime.now());
    show(now->hour, now->minute, now->second);
    disp->after(1000, tick, 0);                          // a timer fires once: start the next one
    return 0;
}

int secondsToggled(int self) {
    face->showSeconds = seconds->checked;
    face->invalidate();
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Clock", 240, 290, 0);
    gui.Box* col = gui.vbox(8, 12);
    face = new clockface.ClockFace();
    col->add(face);
    digital = new gui.Label("");
    digital->align = 1;
    digital->font = gfx.sansBold();
    col->add(digital);
    seconds = new gui.CheckBox("Show the second hand");
    seconds->setChecked(true);
    seconds->onChange = secondsToggled;
    col->add(seconds);
    w->setRoot(col);

    if (argc > 1) {
        show(atoi(argv[1]), atoi(&argv[1][3]), atoi(&argv[1][6]));   // HH:MM:SS from the command line: no ticking
    } else {
        tick(0);
    }
    disp->run();
    return 0;
}
