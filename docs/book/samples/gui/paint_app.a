// A drawing program, finished: colours, brush size, clear and save
// book: gui
// book: click=93,95
// book: drag=100,150,420,150
// book: click=221,95
// book: drag=100,200,300,270
// book: click=189,95
// book: drag=300,200,100,270
// book: click=125,95
// book: drag=360,200,440,270
import gui;
import gimg;
import gfx;
import adp;

int colours[8] = {0xFF202020, 0xFFD03030, 0xFFE08020, 0xFFE0C820, 0xFF30A040, 0xFF3070D8, 0xFF8040C0, 0xFFFFFFFF};

// our own widget: a row of colour cells
class Palette : gui.Widget {
    public int selected;
    public Palette() { super(); focusable = false; }
    public virtual int prefW() { return 8 * 32 - 6; }
    public virtual int prefH() { return 26; }
    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        for (int i = 0; i < 8; i++) {
            s->fillRoundRect(ox + i * 32, oy, 26, 26, 4, colours[i]);
            s->roundRect(ox + i * 32, oy, 26, 26, 4, i == selected ? gui.cAccent : gui.cBorder);
        }
    }
    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && mx / 32 < 8) {
            selected = mx / 32;
            invalidate();
        }
        return true;
    }
}

Palette* palette;
gui.Slider* size;
gui.Canvas* canvas;
gui.Label* status;
int lastX = -1;
int lastY = -1;

void dab(int x, int y) {
    canvas->surf->fillCircle(x, y, size->value, colours[palette->selected]);
}

int mouse(int self) {
    gui.Canvas* c = (gui.Canvas*) self;
    if (c->lastKind == adp.M_DOWN && c->lastButton == 1) {
        dab(c->lastX, c->lastY);
        lastX = c->lastX;
        lastY = c->lastY;
    } else if (c->lastKind == adp.M_MOVE && lastX >= 0) {
        int steps = max(abs(c->lastX - lastX), abs(c->lastY - lastY));   // a dab for every pixel travelled
        for (int i = 1; i <= steps; i++) {
            dab(lastX + (c->lastX - lastX) * i / steps, lastY + (c->lastY - lastY) * i / steps);
        }
        lastX = c->lastX;
        lastY = c->lastY;
    } else if (c->lastKind == adp.M_UP) {
        lastX = -1;
    }
    c->invalidate();
    return 0;
}

int clear(int self) { canvas->surf->clear(gfx.WHITE); canvas->invalidate(); return 0; }

int save(int self) {
    status->setText(gimg.savePng(canvas->surf, "painting.png") ? "Saved painting.png" : "Could not save");
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Paint", 380, 330, 0);
    gui.Box* col = gui.vbox(8, 8);

    gui.Box* bar = gui.hbox(6, 0);
    palette = new Palette();
    bar->add(palette);
    size = new gui.Slider(1, 12);
    size->setValue(5);
    size->flex = 1;                                      // the brush radius
    bar->add(size);
    gui.Button* b1 = new gui.Button("Clear");
    b1->onClick = clear;
    bar->add(b1);
    gui.Button* b2 = new gui.Button("Save");
    b2->onClick = save;
    bar->add(b2);
    col->add(bar);

    canvas = new gui.Canvas(528, 260);
    canvas->flex = 0;
    canvas->onMouseEvent = mouse;
    col->add(canvas);
    status = new gui.Label("");
    col->add(status);
    w->setRoot(col);
    w->fit();
    d->run();
    return 0;
}
