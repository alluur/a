// One callback for several buttons: userData
// book: gui
// book: click=170,133
// book: click=250,133
// book: click=90,133
import gui;

int total = 0;
gui.Label* shown;

int add(int self) {
    gui.Button* b = (gui.Button*) self;                  // which button was it?
    total = total + b->userData;                         // a field of every widget, for your own use
    char text[48];
    format(&text[0], 48, "Total: %d (last: %s)", total, b->text);
    shown->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Adder", 260, 100, 0);
    gui.Box* col = gui.vbox(10, 14);
    shown = new gui.Label("Total: 0");
    col->add(shown);
    gui.Box* row = gui.hbox(10, 0);
    int amounts[3] = {1, 10, 100};
    char* names[3] = {"+1", "+10", "+100"};
    for (int i = 0; i < 3; i++) {
        gui.Button* b = new gui.Button(names[i]);
        b->userData = amounts[i];
        b->onClick = add;                                // the same function for all three
        b->flex = 1;
        row->add(b);
    }
    col->add(row);
    w->setRoot(col);
    d->run();
    return 0;
}
