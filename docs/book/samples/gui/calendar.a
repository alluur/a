// The calendar widget
// book: gui
// book: click=186,220
import gui;
import guix;

gui.Label* info;

int picked(int self) {
    guix.Calendar* c = (guix.Calendar*) self;
    char text[48];
    format(&text[0], 48, "Picked %04d-%02d-%02d", c->year, c->month, c->day);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Calendar", 290, 300, 0);
    gui.Box* col = gui.vbox(8, 12);
    guix.Calendar* cal = new guix.Calendar();
    cal->setDate(2025, 3, 14);                           // year, month, day
    cal->onChange = picked;                              // a click on a day, or the keys
    col->add(cal);
    info = new gui.Label("Pick a day");
    col->add(info);
    w->setRoot(col);
    d->run();
    return 0;
}
