// A spin box for numbers
// book: gui
// book: click=170,117
// book: key=up
// book: key=up
// book: key=pgup
import gui;
import guix;

gui.Label* info;

int spun(int self) {
    guix.SpinBox* s = (guix.SpinBox*) self;
    char text[48];
    format(&text[0], 48, "%d copies = %d sheets", s->value, s->value * 2);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Print", 260, 120, 0);
    gui.Box* col = gui.vbox(8, 14);
    col->add(new gui.Label("Copies"));
    guix.SpinBox* s = new guix.SpinBox(1, 99);           // minimum and maximum
    s->step = 1;
    col->add(s);
    info = new gui.Label("");
    col->add(info);
    s->onChange = spun;
    s->setValue(5);                                      // calls spun
    w->setRoot(col);
    d->run();
    return 0;
}
