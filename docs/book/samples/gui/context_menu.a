// A context menu on the right mouse button
// book: gui
// book: rclick=120,150
import gui;
import guix;

gui.Label* info;
guix.Menu* menu;
gui.TextArea* area;

int rightClick(int widget) {
    gui.Widget* wd = (gui.Widget*) widget;
    menu->popup(wd->win, wd->win->lastMouseX, wd->win->lastMouseY);   // where the pointer is
    return 0;
}

int chosen(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    info->setText(m->text);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Context menu", 300, 190, 0);
    gui.Box* col = gui.vbox(8, 12);
    area = new gui.TextArea();
    area->setText("Right click anywhere in this text.");
    area->onContext = rightClick;                        // called on a right click (any widget has it)
    area->flex = 1;
    col->add(area);
    info = new gui.Label("");
    col->add(info);

    menu = new guix.Menu();
    menu->add("Cut", chosen);
    menu->add("Copy", chosen);
    menu->add("Paste", chosen);
    menu->addSeparator();
    menu->add("Select all", chosen);
    w->setRoot(col);
    d->run();
    return 0;
}
