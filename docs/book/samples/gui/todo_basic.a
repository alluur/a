// A to-do list, first version
// book: gui
// book: type=Buy milk
// book: key=enter
// book: type=Write the chapter
// book: key=enter
// book: type=Call Ann
// book: key=enter
import gui;

gui.TextBox* entry;
gui.ListBox* list;

int addTask(int self) {                                  // the button and Enter in the field both come here
    char* text = entry->text();
    if (strlen(text) > 0) {
        list->addItem(text);
        entry->setText("");                              // empty the field for the next task
    }
    return 0;
}

int main() {
    gui.caretBlinks = false;
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("To do", 320, 240, 0);
    gui.Box* col = gui.vbox(8, 12);

    gui.Box* row = gui.hbox(8, 0);
    entry = new gui.TextBox();
    entry->placeholder = "New task";
    entry->flex = 1;
    entry->onEnter = addTask;
    row->add(entry);
    gui.Button* add = new gui.Button("Add");
    add->onClick = addTask;
    row->add(add);
    col->add(row);

    list = new gui.ListBox();
    list->flex = 1;
    col->add(list);

    w->setRoot(col);
    w->setFocus(entry);
    d->run();
    return 0;
}
