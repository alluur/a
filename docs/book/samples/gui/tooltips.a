// Tool tips
// book: gui
// book: move=170,131
// book: pause=1300
// book: pointer=keep
import gui;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Tips", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    col->add(new gui.Label("Rest the pointer on the button"));
    gui.Button* b = new gui.Button("Save");
    b->tooltip = "Writes the document to disk";          // a field of every widget
    col->add(b);
    w->setRoot(col);
    d->run();
    return 0;
}
