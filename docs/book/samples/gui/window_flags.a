// Several windows: positions and flags
// book: gui
// book: window=480x280
import gui;
import adp;

gui.Window* make(gui.Display* d, char* title, int x, int y, int w, int h, int flags, char* text) {
    gui.Window* win = d->createWindowAt(title, x, y, w, h, flags);   // x, y: the top left of the client area
    gui.Box* col = gui.vbox(6, 12);
    col->add(new gui.Label(text));
    win->setRoot(col);
    return win;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    make(d, "Normal", 20, 60, 190, 90, 0, "Resizable");
    make(d, "Fixed", 250, 60, 190, 90, adp.F_FIXED, "F_FIXED: no resizing");
    make(d, "Bare", 100, 190, 220, 50, adp.F_NODECOR, "F_NODECOR: no title bar");
    d->run();                                            // ends when the last window is closed
    return 0;
}
