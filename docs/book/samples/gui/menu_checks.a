// Check items and submenus
// book: gui
// book: click=113,87
// book: click=140,176
import gui;
import guix;

gui.Label* info;

int toggled(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    char text[64];
    format(&text[0], 64, "%s is %s", m->text, m->checked ? "on" : "off");   // checked has already changed
    info->setText(&text[0]);
    return 0;
}

int picked(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    char text[64];
    format(&text[0], 64, "Zoom set to %s (id %d)", m->text, m->id);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Options", 320, 220, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.MenuBar* bar = new guix.MenuBar();
    bar->addMenu("&File")->add("Close", toggled);
    guix.Menu* view = bar->addMenu("&View");
    view->addCheck("Word wrap", true, toggled);          // text, initial state, callback
    view->addCheck("Line numbers", false, toggled);
    view->addSeparator();
    guix.Menu* zoom = new guix.Menu();                   // a menu inside a menu
    zoom->add("50 %", picked)->setId(50);
    zoom->add("100 %", picked)->setId(100);
    zoom->add("200 %", picked)->setId(200);
    view->addSub("Zoom", zoom);
    col->add(bar);

    gui.Box* body = gui.vbox(6, 12);
    info = new gui.Label("Pick something from the View menu");
    body->add(info);
    col->add(body);
    w->setRoot(col);
    d->run();
    return 0;
}
