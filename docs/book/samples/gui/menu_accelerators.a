// Accelerators: keys that run menu items
// book: gui
// book: key=ctrl+n
// book: key=ctrl+n
// book: key=f5
import gui;
import guix;

gui.Label* info;
int actions = 0;

int run(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    actions++;
    char text[64];
    format(&text[0], 64, "%s (%d actions so far)", m->text, actions);
    info->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Accelerators", 320, 120, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* m = bar->addMenu("&Actions");
    m->add("New", run)->accel("Ctrl+N");                 // letters with Ctrl, Shift and Alt
    m->add("Refresh", run)->accel("F5");                 // function keys
    m->add("Delete", run)->accel("Del");
    m->add("Fullscreen", run)->accel("Alt+Enter");
    col->add(bar);
    gui.Box* body = gui.vbox(6, 12);
    info = new gui.Label("Press Ctrl+N, F5, Del or Alt+Enter");
    body->add(info);
    col->add(body);
    w->setRoot(col);
    d->run();
    return 0;
}
