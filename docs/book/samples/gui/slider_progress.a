// A slider that drives a progress bar
// book: gui
// book: drag=62,128,241,128
import gui;

gui.Label* label;
gui.ProgressBar* bar;

int moved(int self) {
    gui.Slider* s = (gui.Slider*) self;                  // the callback argument is the widget
    char text[32];
    format(&text[0], 32, "Value: %d", s->value);
    label->setText(&text[0]);
    bar->setValue(s->value);                             // 0 to 100
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Slider", 300, 130, 0);
    gui.Box* col = gui.vbox(8, 14);
    label = new gui.Label("Value: 0");
    col->add(label);
    gui.Slider* s = new gui.Slider(0, 100);              // minimum and maximum
    s->onChange = moved;
    col->add(s);
    bar = new gui.ProgressBar();
    col->add(bar);
    w->setRoot(col);
    d->run();
    return 0;
}
