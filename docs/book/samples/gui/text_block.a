// Text that wraps: TextBlock
// book: gui
import gui;
import gfx;
import guix;

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("About", 300, 210, 0);
    gui.Box* col = gui.vbox(10, 14);
    gui.Label* title = new gui.Label("Aytict notes");
    title->font = gfx.sansBold();                        // a Label can use another font
    col->add(title);
    // a Label is one line; a TextBlock breaks lines at the width it gets
    guix.TextBlock* text = new guix.TextBlock("A small notebook program. The text of this block wraps at the width of the window, so you can resize the window and the lines flow again.\nA new paragraph starts after a newline.");
    col->add(text);
    guix.TextBlock* small = new guix.TextBlock("Centred and grey");
    small->align = 1;                                    // 0 left, 1 centre, 2 right
    small->color = gui.cTextDim;
    col->add(small);
    w->setRoot(col);
    d->run();
    return 0;
}
