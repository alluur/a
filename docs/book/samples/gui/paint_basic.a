// A drawing program, first version: lines with the mouse
// book: gui
// book: drag=120,250,220,250
// book: drag=220,250,220,180
// book: drag=220,180,120,180
// book: drag=120,180,120,250
// book: drag=120,180,170,140
// book: drag=170,140,220,180
import gui;
import gfx;
import adp;

int lastX = -1;                                          // -1: the button is not down
int lastY = -1;

int mouse(int self) {
    gui.Canvas* c = (gui.Canvas*) self;
    if (c->lastKind == adp.M_DOWN && c->lastButton == 1) {
        lastX = c->lastX;                                // a stroke starts
        lastY = c->lastY;
    } else if (c->lastKind == adp.M_MOVE && lastX >= 0) {
        c->surf->line(lastX, lastY, c->lastX, c->lastY, gfx.BLACK);    // join the last point to this one
        lastX = c->lastX;
        lastY = c->lastY;
        c->invalidate();
    } else if (c->lastKind == adp.M_UP) {
        lastX = -1;                                      // the stroke ends
    }
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    gui.Window* w = d->createWindow("Paint", 344, 244, 0);
    gui.Box* col = gui.vbox(8, 12);
    gui.Canvas* canvas = new gui.Canvas(320, 220);
    canvas->flex = 0;
    canvas->onMouseEvent = mouse;
    col->add(canvas);
    w->setRoot(col);
    d->run();
    return 0;
}
