// A counter, finished: limits, step, keyboard and a title
// book: gui
// book: click=215,133
// book: click=215,133
// book: click=215,133
// book: key=+
import gui;
import guix;

const MAX = 20;
int count = 0;
gui.Window* win;
gui.Label* shown;
gui.Button* less;
gui.Button* more;
guix.SpinBox* step;

void show() {
    char text[32];
    format(&text[0], 32, "%d", count);
    shown->setText(&text[0]);
    format(&text[0], 32, "Counter: %d", count);
    win->setTitle(&text[0]);                             // the title follows the value
    less->setEnabled(count > -MAX);                      // the buttons give up at the limits
    more->setEnabled(count < MAX);
}

void add(int delta) {
    count = count + delta;
    if (count > MAX) { count = MAX; }
    if (count < -MAX) { count = -MAX; }
    show();
}

int plus(int self) { add(step->value); return 0; }
int minus(int self) { add(-step->value); return 0; }
int reset(int self) { count = 0; show(); return 0; }

int keyPressed(int window, int key, int uni) {           // keys no widget used
    if (uni == '+') { add(step->value); }
    if (uni == '-') { add(-step->value); }
    if (uni == '0') { reset(0); }
    return 0;
}

int main() {
    gui.Display* d = gui.connect(null);
    if (d == null) { return 1; }
    win = d->createWindow("Counter", 240, 185, 0);
    gui.Box* col = gui.vbox(10, 14);

    shown = new gui.Label("0");
    shown->align = 1;
    shown->font = gfx.sansBold();
    col->add(shown);
    gui.Box* row = gui.hbox(10, 0);
    less = new gui.Button("-");
    less->onClick = minus;
    less->flex = 1;
    row->add(less);
    more = new gui.Button("+");
    more->onClick = plus;
    more->flex = 1;
    more->primary = true;
    row->add(more);
    col->add(row);

    gui.Box* stepRow = gui.hbox(10, 0);
    stepRow->add(new gui.Label("Step"));
    step = new guix.SpinBox(1, 5);
    step->setValue(2);
    stepRow->add(step);
    col->add(stepRow);
    gui.Button* r = new gui.Button("Reset (0)");
    r->onClick = reset;
    col->add(r);

    win->setRoot(col);
    win->onKey = keyPressed;
    show();
    d->run();
    return 0;
}
