// The colour dialog
// book: gui
// book: click=170,133
import gui;
import guix;

gui.Display* disp;
gui.Label* info;

int chosen(int colour) {                                 // 0xFFRRGGBB, or 0 when cancelled
    char text[48];
    format(&text[0], 48, "Colour %06X", colour & 0xFFFFFF);
    info->setText(colour == 0 ? "Cancelled" : &text[0]);
    return 0;
}

int ask(int self) {
    guix.chooseColor(disp, "Pick a colour", 0xFF3C78D8, chosen);   // the colour it starts with
    return 0;
}

int main() {
    disp = gui.connect(null);
    if (disp == null) { return 1; }
    gui.Window* w = disp->createWindow("Paint", 260, 110, 0);
    gui.Box* col = gui.vbox(10, 14);
    info = new gui.Label("No colour yet");
    col->add(info);
    gui.Button* b = new gui.Button("Colour...");
    b->onClick = ask;
    col->add(b);
    w->setRoot(col);
    disp->run();
    return 0;
}
