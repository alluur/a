// Parsing mail that other people wrote: character sets, mistakes and limits
import mail;

void defects(char* label, mail.Part* p) {
    printf("%s: defects %d", label, p->defects);
    if (p->defects & mail.D_NO_END_BOUNDARY) printf(" NO_END_BOUNDARY");
    if (p->defects & mail.D_BAD_ENCODING) printf(" BAD_ENCODING");
    if (p->defects & mail.D_BAD_CHARSET) printf(" BAD_CHARSET");
    if (p->defects & mail.D_TOO_MANY_PARTS) printf(" TOO_MANY_PARTS");
    if (p->defects & mail.D_TOO_BIG) printf(" TOO_BIG");
    printf("\n");
}

int main() {
    // 1. Latin-1 text, bare LF line ends, a missing closing boundary: read anyway
    char* msg1 =
        "From: Ann <ann@example.org>\n"
        "Subject: =?ISO-8859-1?Q?Gr=FC=DFe?=\n"
        "MIME-Version: 1.0\n"
        "Content-Type: multipart/mixed; boundary=\"XX\"\n"
        "\n"
        "This preamble is ignored.\n"
        "--XX\n"
        "Content-Type: text/plain; charset=iso-8859-1\n"
        "Content-Transfer-Encoding: 8bit\n"
        "\n"
        "Gr\xFC\xDF" "e aus M\xFCnchen\n"
        "--XX\n"
        "Content-Type: text/plain; charset=utf-8\n"
        "Content-Transfer-Encoding: base64\n"
        "\n"
        "R3LDvMOfZQ==\n";                                  // and no "--XX--" at the end
    mail.Part* p = mail.parse(msg1, strlen(msg1), null);
    printf("subject: %s\n", p->decodedHeader("Subject"));
    for (int i = 0; i < p->nchildren; i++) printf("part %d (%s): %s\n", i, p->child(i)->charset, p->child(i)->body);
    defects("message", p);

    // 2. a part with a character set nobody knows, and quoted-printable that is not quite right
    char* msg2 =
        "Content-Type: multipart/mixed; boundary=B\r\n\r\n"
        "--B\r\nContent-Type: text/plain; charset=x-martian\r\n\r\nstays as it is\r\n"
        "--B\r\nContent-Type: text/plain\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n100=ZZ sure, 100=3D100\r\n"
        "--B--\r\n";
    mail.Part* q = mail.parse(msg2, strlen(msg2), null);
    defects("part 0", q->child(0));
    defects("part 1", q->child(1));
    printf("part 1 decoded: %s\n", q->child(1)->body);

    // 3. limits: a message with 6 parts, read with a limit of 4
    mail.Buf b;
    b.addText("Content-Type: multipart/mixed; boundary=B\r\n\r\n");
    for (int i = 0; i < 6; i++) b.addText("--B\r\n\r\nx\r\n");
    b.addText("--B--\r\n");
    mail.ParseOptions* o = mail.newParseOptions();
    o->maxParts = 4;
    mail.Part* r = mail.parse(b.d, b.len, o);
    printf("maxParts 4: %d parts kept\n", r->nchildren);
    defects("message", r);
    o->maxSize = 50;
    mail.Part* big = mail.parse(b.d, b.len, o);
    printf("maxSize 50: %s (%s)\n", big == null ? "refused" : "parsed", big == null ? mail.error() : "");
    return 0;
}
