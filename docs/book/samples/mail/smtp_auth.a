// Logging in to an SMTP server: which mechanism, and when the password is NOT sent
import smtp;
import smtpd;
import net;

smtpd.Server* srv;
int serve() { srv->poll(0); return 0; }
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    printf("  [server] message stored, logged in as: %s\n", s->authUser == null ? "nobody" : s->authUser);
    return 0;
}

smtp.Options* options(char* user, char* pass) {
    smtp.Options* o = smtp.newOptions();
    o->record = true;
    o->username = user;
    o->password = pass;
    o->startTls = smtp.STARTTLS_NEVER;           // this server has no TLS: see the next sample
    return o;
}

// connect, send one message, print what happened and the lines of the dialogue about logging in
void attempt(char* label, smtp.Options* o) {
    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, o);
    bool ok = c->connect();
    printf("%s\n  connect: %s\n", label, ok ? "ok" : c->error);
    if (ok) {
        char* rc[1];
        rc[0] = "bob@example.org";
        smtp.Result* r = c->send("ann@example.org", &rc[0], 1, "hi\n", 3);
        printf("  send: ok=%d code=%d\n", r->ok, r->code);
        c->quit();
    }
    // the lines of the transcript that are about logging in (the CRAM-MD5 challenge, "S: 334", is different every time)
    char* at = c->transcript();
    while (*at != 0) {
        char* nl = strchr(at, 10);
        if (startsWith(at, "C: AUTH") || startsWith(at, "C: ****") || startsWith(at, "S: 235") || startsWith(at, "S: 535") || startsWith(at, "S: 530")) printf("    %.*s\n", (int) (nl - at), at);
        at = nl + 1;
    }
}

int main() {
    srv = smtpd.newServer();
    srv->core->hostname = "mail.example.org";
    srv->core->addLocalDomain("example.org");
    srv->core->addUser("ann", "secret");
    srv->core->deliverHook = deliver;
    srv->core->idPrefix = "Q";
    srv->core->authRequired = true;              // no MAIL FROM before AUTH
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    attempt("1. no login at all", options(null, null));
    attempt("2. CRAM-MD5: the client proves it knows the password, it never sends it", options("ann", "secret"));
    attempt("3. a wrong password", options("ann", "wrong"));

    // PLAIN and LOGIN send the password as it is: both sides must agree to do that without TLS
    srv->core->allowInsecureAuth = true;         // the server offers PLAIN and LOGIN on a plain connection
    smtp.Options* o = options("ann", "secret");
    o->authMethods = smtp.AUTH_PLAIN;
    attempt("4. PLAIN without TLS: the client refuses", o);
    o = options("ann", "secret");
    o->authMethods = smtp.AUTH_PLAIN;
    o->allowPlainAuth = true;
    attempt("5. PLAIN with allowPlainAuth (the transcript hides the password)", o);

    char url[100];
    format(&url[0], 100, "smtp://ann:secret@127.0.0.1:%d", srv->port);
    smtp.Client* c = smtp.connect(&url[0]);
    printf("6. a URL with a password: %s\n", c == null ? smtp.error() : "connected");
    return 0;
}
