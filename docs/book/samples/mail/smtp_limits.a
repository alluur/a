// Limits of the SMTP server: message size, recipients per message, messages per session
import smtp;
import smtpd;
import net;

smtpd.Server* srv;
int stored = 0;

int serve() { srv->poll(0); return 0; }
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) { stored++; return 0; }

char* text(int n) {                              // n bytes of 60-character lines
    char* b = alloc(n + 1);
    for (int i = 0; i < n; i++) b[i] = (i % 61 == 60) ? '\n' : 'x';
    b[n] = 0;
    return b;
}

void say(int h, char* cmd) {                     // a raw line to the server and the first line of the answer
    char line[200];
    net.sendText(h, cmd);
    net.recvLine(h, &line[0], 200);
    printf("  %s\n", &line[0]);
}

int main() {
    srv = smtpd.newServer();
    srv->core->addLocalDomain("example.org");
    srv->core->deliverHook = deliver;
    srv->core->idPrefix = "Q";
    srv->core->maxMessage = 2000;                // advertised as SIZE 2000
    srv->core->maxRecipients = 2;
    srv->core->maxMessagesPerSession = 2;
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, smtp.newOptions());
    c->connect();
    printf("the server advertises SIZE %d\n", c->sizeLimit);
    char* rc[3];
    rc[0] = "a@example.org";  rc[1] = "b@example.org";  rc[2] = "c@example.org";

    smtp.Result* r = c->send("x@example.net", &rc[0], 1, text(5000), 5000);
    printf("5000 bytes: ok=%d code=%d, \"%s\" (nothing was sent: the client read SIZE)\n", r->ok, r->code, r->why());
    r = c->send("x@example.net", &rc[0], 3, text(100), 100);
    printf("3 recipients, the limit is 2: ok=%d, codes %d %d %d\n", r->ok, r->rcptCode[0], r->rcptCode[1], r->rcptCode[2]);
    r = c->send("x@example.net", &rc[0], 1, text(100), 100);
    printf("second message: ok=%d\n", r->ok);
    r = c->send("x@example.net", &rc[0], 1, text(100), 100);
    printf("third message: ok=%d code=%d \"%s\", connection open: %d\n", r->ok, r->code, r->why(), c->isOpen());

    // A client that does not announce SIZE (a raw socket) is stopped when the data gets too long
    int h = net.connect("127.0.0.1", srv->port);
    char line[200];
    net.recvLine(h, &line[0], 200);
    printf("a raw client sends 5000 bytes without SIZE:\n");
    net.sendText(h, "EHLO raw\r\n");
    for (int i = 0; i < 6; i++) net.recvLine(h, &line[0], 200);
    say(h, "MAIL FROM:<x@example.net>\r\n");
    say(h, "RCPT TO:<a@example.org>\r\n");
    say(h, "DATA\r\n");
    char* big = text(5000);
    for (int i = 0; i < 5000; i += 100) { char* piece = alloc(101); memcpy(piece, &big[i], 100); piece[100] = 0; net.sendText(h, piece); net.sendText(h, "\r\n"); }
    say(h, ".\r\n");
    printf("messages stored in all: %d\n", stored);
    return 0;
}
