// Reading a mailbox with POP3: STAT, LIST, UIDL, TOP and RETR
import pop3;
import pop3d;
import asys;
import net;

pop3d.Server* srv;
int serve() { srv->poll(0); return 0; }

void put(char* name, char* text) { asys.writeFile(name, text, strlen(text)); }

void show(char* s) {                                // the server sends CR LF line ends; print plain newlines
    for (int i = 0; s[i] != 0; i++) if (s[i] != 13) printf("%c", s[i]);
}

int main() {
    // The mailbox is a Maildir: one file per message in new/ (and cur/ for the ones that were seen)
    asys.mkdirs("box/ann/new");
    asys.mkdirs("box/ann/cur");
    put("box/ann/new/1000.m1", "From: bob@example.org\nSubject: Lunch\n\nHi Ann,\n.noon?\nBob\n");
    put("box/ann/new/1001.m2", "From: carol@example.org\nSubject: Report\n\nAttached.\n");
    put("box/ann/cur/0999.old:2,S", "Subject: Old news\n\nYou read this.\n");

    srv = pop3d.newServer();
    srv->addUser("ann", "secret", "box/ann");
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    pop3.Options* o = pop3.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->startTls = pop3.STARTTLS_NEVER;
    o->allowPlainLogin = true;                      // there is no TLS here: USER and PASS would go in the clear
    pop3.Client* c = pop3.newClient("127.0.0.1", srv->port, o);
    if (!c->connect()) { println(c->error); return 1; }

    int count = c->count();                         // STAT
    printf("%d messages, %d bytes in all\n", count, c->octets);
    for (int i = 1; i <= count; i++) {
        char uid[100];
        c->uidl(i, &uid[0], 100);                   // UIDL: a name that stays the same for a message
        printf("  %d: %d bytes, uidl %s\n", i, c->size(i), &uid[0]);   // LIST n
    }

    int n;
    char* top = c->top(1, 1, &n);                   // the header and 1 line of the body: a preview without the download
    printf("\nTOP 1 1 (%d bytes):\n", n);
    show(top);
    char* msg = c->retr(1, &n);                     // the whole message
    printf("\nRETR 1 (%d bytes):\n", n);
    show(msg);
    printf("(the line \".noon?\" came through with its dot: the wire form is \"..noon?\")\n");

    printf("\nmessage 9: %s\n", c->retr(9, &n) == null ? c->error : "?");
    printf("message 0: size %d\n", c->size(0));
    c->quit();
    c->dispose();
    return 0;
}
