// Base64 and quoted-printable: how bodies travel in 7-bit mail
import mail;

// print a Buf with the CR of CR LF left out
void showBuf(char* label, mail.Buf* b) {
    printf("%s (%d bytes)\n", label, b->len);
    char* out = alloc(b->len + 1);
    int k = 0;
    for (int i = 0; i < b->len; i++) { if (b->d[i] != 13) { out[k] = b->d[i]; k++; } }
    out[k] = 0;
    printf("%s", out);
    if (k > 0 && out[k - 1] != 10) printf("\n");
}

int main() {
    // base64: 3 bytes become 4 characters, "=" pads the end; wrap = lines of 76 characters
    mail.Buf b;
    mail.base64Encode("Hello, World!", 13, &b, false);
    showBuf("base64, no wrap", &b);
    mail.Buf w;
    char* data = alloc(100);
    for (int i = 0; i < 100; i++) data[i] = i;          // 100 bytes: every one is different
    mail.base64Encode(data, 100, &w, true);
    showBuf("100 binary bytes, wrapped", &w);

    // strict decoding refuses garbage; the lenient form (the one for message bodies) skips it
    mail.Buf d1;
    mail.Buf d2;
    printf("strict:  %d\n", mail.base64Decode("SGVsbG8h!!!", 11, &d1, true));
    printf("lenient: %d -> \"%s\"\n", mail.base64Decode("SGVs bG8h\r\nSGk", 14, &d2, false), d2.text());

    // quoted-printable: ASCII stays readable, other bytes and "=" become =XX, a long line gets a soft break "="
    mail.Buf q;
    char* text = "Gr\xC3\xBC\xC3\x9F" "e = nice \nline two ends with a blank \nA very long line of ordinary text that goes on and on and on and on and on and on, past the limit.\n";
    mail.qpEncode(text, strlen(text), &q, false);
    showBuf("quoted-printable", &q);
    mail.Buf back;
    mail.qpDecode(q.d, q.len, &back, false, true);      // true: LF line ends in the result
    printf("decoded again: %d bytes, same as the original: %s\n", back.len, (back.len == strlen(text) && memcmp(back.d, text, back.len) == 0) ? "yes" : "no");

    // the cost: base64 adds a third; quoted-printable adds almost nothing to text and a lot to binary
    mail.Buf s64;
    mail.Buf sqp;
    mail.base64Encode(data, 100, &s64, true);
    mail.qpEncode(data, 100, &sqp, true);
    mail.Buf t64;
    mail.Buf tqp;
    mail.base64Encode(text, strlen(text), &t64, true);
    mail.qpEncode(text, strlen(text), &tqp, false);
    printf("binary: base64 %d, quoted-printable %d\n", s64.len, sqp.len);
    printf("text:   base64 %d, quoted-printable %d\n", t64.len, tqp.len);
    return 0;
}
