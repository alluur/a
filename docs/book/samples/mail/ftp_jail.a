// The server's jail: paths that try to leave it, symbolic links, and per-user rights
import ftp;
import ftpd;
import asys;
import net;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

ftp.Client* login(char* user, char* pass) {
    ftp.Options* o = ftp.newOptions();
    o->username = user;
    o->password = pass;
    o->authTls = ftp.STARTTLS_NEVER;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    if (!c->connect()) printf("login as %s: %s\n", user, c->error);
    return c;
}

void get(ftp.Client* c, char* path) {
    int n = 0;
    char* d = c->retrieveAll(path, &n, 100);
    printf("  RETR %-22s %s", path, d != null ? d : c->error);
    if (d == null) printf("\n");
}

int main() {
    asys.mkdirs("jail/ann/sub");                       // ann's jail is jail/ann ...
    asys.writeFile("jail/ann/mine.txt", "mine\n", 5);
    asys.writeFile("jail/ann/sub/deep.txt", "deep\n", 5);
    asys.writeFile("jail/secret.txt", "SECRET\n", 7);   // ... and this file is outside of it
    char target[400];
    format(&target[0], 400, "%s/jail/secret.txt", asys.getcwd());
    asys.symlink(&target[0], "jail/ann/link.txt");      // a link inside the jail that points outside

    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "jail/ann", ftpd.P_ALL);
    srv->addUser("guest", "guest", "jail/ann", ftpd.P_READ | ftpd.P_LIST);      // may look, not touch
    srv->addAnonymous("jail/ann/sub", ftpd.P_READ | ftpd.P_LIST);               // anybody, read only, only below sub
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    ftp.Client* c = login("ann", "secret");
    printf("ann tries to leave her jail:\n");
    c->cwd("sub");
    c->cwd("../../../..");
    printf("  cwd ../../../.. gives pwd %s (\"..\" at the top stays at the top)\n", c->pwd());
    get(c, "mine.txt");
    get(c, "sub/../mine.txt");
    get(c, "../secret.txt");
    get(c, "/../secret.txt");
    get(c, "/etc/passwd");                              // an absolute path starts at the root of the jail
    get(c, "%2e%2e/secret.txt");                        // nothing is decoded: this is just a strange name
    get(c, "sub\\..\\mine.txt");                        // a backslash is not allowed in a name
    get(c, "link.txt");                                 // the link to the outside
    ftp.EntryList* l = c->listEntries("");
    printf("  the listing shows %d entries; link.txt is %s\n", l->count, l->find("link.txt") == null ? "not among them" : "there");
    printf("  store through the link: %d, %s\n", c->store("link.txt", "overwritten\n", 12), c->error);
    int len = 0;
    char* secret = asys.readFile("jail/secret.txt", &len);
    printf("  jail/secret.txt after that: %d bytes, unchanged: %s\n", len, memcmp(secret, "SECRET\n", 7) == 0 ? "yes" : "no");
    c->quit();

    c = login("guest", "guest");
    printf("guest (read and list only):\n");
    get(c, "mine.txt");
    printf("  STOR: %d, %s\n", c->store("new.txt", "x", 1), c->error);
    printf("  DELE: %d, %s\n", c->dele("mine.txt"), c->error);
    c->quit();

    c = login("anonymous", "me@example.org");
    printf("anonymous: pwd %s\n", c->pwd());
    get(c, "deep.txt");
    get(c, "../mine.txt");
    c->quit();

    login("ann", "wrong");
    login("nobody", "x");
    printf("logins refused: %d\n", srv->loginFailures);
    return 0;
}
