// Directory listings: Unix, DOS and MLSD formats, and LIST, NLST and MLSD from a live server
import ftp;
import ftpd;
import asys;
import net;
import netio;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

void show(char* label, ftp.EntryList* l) {
    printf("%s: %d entries, %d lines not understood\n", label, l->count, l->unparsed);
    for (int i = 0; i < l->count; i++) {
        ftp.Entry* e = l->get(i);
        printf("  %-16s kind %d  size %-5d perms %s%s%s\n", e->name, e->kind, e->size, e->perms == null ? "-" : e->perms, e->target == null ? "" : "  -> ", e->target == null ? "" : e->target);
    }
}

void parse(char* label, char* text, bool mlsd) {
    ftp.EntryList l;
    ftp.parseListing(text, strlen(text), mlsd, &l, 1794580200);      // 1794580200: "now", for dates without a year
    show(label, &l);
}

int main() {
    // 1. What servers send. The parser turns all three into the same kind of Entry (kind 1 file, 2 directory, 3 link).
    parse("Unix ls -l", "total 12\r\n-rw-r--r--   1 ftp ftp   1024 Nov 03 14:30 report final.pdf\r\n"
                        "drwxr-xr-x   2 ftp ftp   4096 Jan 15  2023 archive\r\n"
                        "lrwxrwxrwx   1 ftp ftp      9 Mar 01 09:00 latest -> report.pdf\r\n"
                        "this line is not a listing\r\n", false);
    parse("DOS / IIS", "11-03-26  02:30PM                 1024 report.pdf\r\n01-15-23  09:00AM       <DIR>          archive\r\n", false);
    parse("MLSD", "type=file;size=1024;modify=20261103143000;perm=adfr; report.pdf\r\ntype=dir;modify=20230115090000; archive\r\ntype=cdir; .\r\n", true);

    // 2. A live server: the same directory through MLSD (listEntries), NLST (names only) and LIST (parsed here)
    asys.mkdirs("ftproot/photos");
    asys.writeFile("ftproot/a.txt", "abc", 3);
    asys.writeFile("ftproot/b file.txt", "0123456789", 10);
    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "ftproot", ftpd.P_ALL);
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    ftp.Options* o = ftp.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->authTls = ftp.STARTTLS_NEVER;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    c->connect();
    printf("\nserver has MLSD: %d\n", c->hasMlsd);

    ftp.EntryList* l = c->listEntries("");
    ftp.Entry* e = l->find("b file.txt");
    printf("MLSD: %d entries; \"%s\" is %d bytes, perms %s\n", l->count, e->name, e->size, e->perms);
    char* names = c->nlst("");
    int lines = 0;
    for (int i = 0; names[i] != 0; i++) if (names[i] == 10) lines++;
    printf("NLST: %d names, no sizes: %s\n", lines, strstr(names, "b file.txt") != null ? "b file.txt is there" : "?");

    netio.Queue raw;
    c->list("", &raw);                              // the raw text of LIST
    raw.reserve(1);
    char* text = raw.data();
    text[raw.pending()] = 0;
    ftp.EntryList parsed;
    ftp.parseListing(text, raw.pending(), false, &parsed, 0);
    ftp.Entry* f = parsed.find("b file.txt");
    printf("LIST: %d entries; \"%s\" is %d bytes; unparsed %d\n", parsed.count, f->name, f->size, parsed.unparsed);
    c->quit();
    return 0;
}
