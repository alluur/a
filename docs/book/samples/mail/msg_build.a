// Building a plain message and looking at what goes on the wire
import mail;

// The wire format has CR LF line ends; print it with plain newlines so the page stays readable.
void show(char* wire, int n) {
    char* out = alloc(n + 1);
    int k = 0;
    for (int i = 0; i < n; i++) { if (wire[i] != 13) { out[k] = wire[i]; k++; } }
    out[k] = 0;
    printf("%s", out);
}

int main() {
    mail.Message* m = mail.newMessage();
    m->from("Ann <ann@example.org>");
    m->to("Bob <bob@example.org>, carol@example.org");
    m->cc("dave@example.org");
    m->bcc("secret@example.org");                 // an envelope recipient only: it never appears in the text
    m->subject("Lunch on Friday?");
    m->setDate(1794580200, 0);                    // fixed, so that this page is the same every time
    m->setMessageId("<lunch-1@example.org>");
    m->text("Hi Bob,\nshall we meet at noon?\n");

    int n;
    char* wire = m->build(&n);                    // a heap string with CR LF line ends
    printf("%d bytes\n\n", n);
    show(wire, n);

    printf("\nBcc in the text: %s\n", contains(wire, "Bcc") ? "yes" : "no");
    mail.AddressList* r = m->recipients();        // the envelope: To, Cc and Bcc together
    printf("envelope recipients (%d):\n", r->count);
    for (int i = 0; i < r->count; i++) printf("  %s\n", r->get(i)->addr);

    // Date and Message-ID are made for you when you do not set them
    mail.Message* d = mail.newMessage();
    d->from("ann@example.org");
    d->to("bob@example.org");
    d->text("x\n");
    char* w2 = d->build(&n);
    printf("made by build(): Date %s, Message-ID %s\n", contains(w2, "\r\nDate: ") ? "yes" : "no", contains(w2, "\r\nMessage-ID: <") ? "yes" : "no");
    return 0;
}
