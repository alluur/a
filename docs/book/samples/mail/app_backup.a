// A backup job: upload files over FTP, then check every file with SHA-256
import ftp;
import ftpd;
import hash;
import asys;
import net;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

char* names[4];
char* sums[4];                       // SHA-256 of each local file, made before the upload

void makeData() {
    asys.mkdirs("data/docs");
    asys.writeFile("data/notes.txt", "Remember the milk.\n", 19);
    asys.writeFile("data/empty.dat", "", 0);
    asys.writeFile("data/docs/plan.md", "# Plan\n\n1. Back up.\n2. Verify.\n", 31);
    char* photo = alloc(20000);
    for (int i = 0; i < 20000; i++) photo[i] = (i * 31 + i / 256) & 255;       // 20000 bytes of "picture"
    asys.writeFile("data/photo.bin", photo, 20000);
    names[0] = "notes.txt";  names[1] = "empty.dat";  names[2] = "docs/plan.md";  names[3] = "photo.bin";
}

bool uploadOne(ftp.Client* c, char* name) {
    char local[200];
    format(&local[0], 200, "data/%s", name);
    char* slash = strrchr(name, '/');
    if (slash != null) {                                         // a file in a subdirectory: make it first (it may exist)
        char dir[100];
        format(&dir[0], 100, "%.*s", (int) (slash - name), name);
        c->mkd(&dir[0]);
    }
    return c->upload(&local[0], name, false);
}

// Download the file again and compare the hash: the server's answer "226 transfer complete" is not proof.
bool verify(ftp.Client* c, int i) {
    int n;
    char* back = c->retrieveAll(names[i], &n, 1000000);
    if (back == null) { printf("  %-14s cannot be read back: %s\n", names[i], c->error); return false; }
    char* sum = hash.sha256(back, n);
    bool ok = streq(sum, sums[i]);
    printf("  %-14s %6d bytes  %.12s  %s\n", names[i], n, sum, ok ? "ok" : "DIFFERENT");
    return ok;
}

int main() {
    makeData();
    asys.mkdirs("vault");
    srv = ftpd.newServer();
    srv->addUser("backup", "s3cret", "vault", ftpd.P_READ | ftpd.P_LIST | ftpd.P_WRITE);    // may add files; may not delete or rename
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    ftp.Options* o = ftp.newOptions();
    o->username = "backup";
    o->password = "s3cret";
    o->authTls = ftp.STARTTLS_NEVER;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    if (!c->connect()) { println(c->error); return 1; }

    printf("uploading:\n");
    for (int i = 0; i < 4; i++) {
        char local[200];
        format(&local[0], 200, "data/%s", names[i]);
        int n;
        sums[i] = hash.sha256(asys.readFile(&local[0], &n), n);
        printf("  %-14s %s\n", names[i], uploadOne(c, names[i]) ? "sent" : c->error);
    }
    printf("verifying:\n");
    int bad = 0;
    for (int i = 0; i < 4; i++) if (!verify(c, i)) bad++;
    printf("%d file(s) differ\n", bad);

    // Somebody damages a file on the server (one byte). The next check finds it, and the backup is repaired.
    asys.writeFile("vault/photo.bin", "damaged", 7);
    printf("\nafter damage on the server:\n");
    verify(c, 3);
    printf("uploading photo.bin again: %s\n", uploadOne(c, "photo.bin") ? "sent" : c->error);
    verify(c, 3);

    printf("\nthe backup user cannot delete: %d (%s)\n", c->dele("notes.txt"), c->error);
    c->quit();
    return 0;
}
