// Dot-stuffing and line ends: what the client puts on the wire, and what the server stores
import smtp;
import smtpd;
import mail;
import net;

// ---- a tap: a tiny server that answers "yes" to everything and records the DATA bytes exactly -----------------
int lsn;
int peer = -1;
mail.Buf line;                       // the line being collected
mail.Buf wireData;                   // what came between DATA and the final dot line
bool inData = false;

void reply(char* s) { net.sendText(peer, s); }

int tap() {
    if (peer < 0) {
        peer = net.acceptSome(lsn);
        if (peer >= 0) { net.setNonBlocking(peer, true); reply("220 tap\r\n"); }
        return 0;
    }
    char buf[2048];
    int n = net.recvSome(peer, &buf[0], 2048);
    for (int i = 0; i < n; i++) {
        line.addByte(buf[i]);
        if (buf[i] != 10) continue;
        char* t = line.text();
        if (inData && streq(t, ".\r\n")) { inData = false; reply("250 stored\r\n"); }
        else if (inData) wireData.add(line.d, line.len);
        else if (startsWith(t, "DATA")) { inData = true; reply("354 go\r\n"); }
        else if (startsWith(t, "QUIT")) reply("221 bye\r\n");
        else reply("250 ok\r\n");
        line.clear();
    }
    return 0;
}

// ---- the real server, for the second half ------------------------------------------------------------------------
smtpd.Server* srv;
char* stored;
int storedLen;
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    stored = malloc(n + 1);
    memcpy(stored, data, n);
    storedLen = n;
    return 0;
}
int hook() { tap(); srv->poll(0); return 0; }

void visible(char* s, int n) {                       // CR and LF written out, so that nothing is hidden
    for (int i = 0; i < n; i++) {
        if (s[i] == 13) printf("\\r"); else if (s[i] == 10) printf("\\n\n"); else printf("%c", s[i]);
    }
}

int main() {
    lsn = net.listenOn("127.0.0.1", 0, 4);
    net.setNonBlocking(lsn, true);
    srv = smtpd.newServer();
    srv->core->addLocalDomain("example.org");
    srv->core->deliverHook = deliver;
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(hook);

    // A message with a line that is only ".", a line that starts with a dot, bare LF line ends and no final newline
    char* body = "Dear Bob,\nthe next line is a single dot:\n.\n.hidden line\r\nlast line, no newline";
    char* rcpt[1];
    rcpt[0] = "bob@example.org";

    smtp.Client* c = smtp.newClient("127.0.0.1", net.localPort(lsn), smtp.newOptions());
    c->connect();
    smtp.Result* r = c->send("ann@example.net", &rcpt[0], 1, body, strlen(body));
    c->quit();
    printf("client sent %d bytes of message, the tap saw %d bytes (ok=%d):\n", (int) strlen(body), wireData.len, r->ok);
    visible(wireData.d, wireData.len);

    smtp.Client* d = smtp.newClient("127.0.0.1", srv->port, smtp.newOptions());
    d->connect();
    r = d->send("ann@example.net", &rcpt[0], 1, body, strlen(body));
    d->quit();
    printf("\nthe server stored %d bytes (ok=%d):\n", storedLen, r->ok);
    visible(stored, storedLen);
    return 0;
}
