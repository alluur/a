// An FTP session: log in, make a directory, upload, download, list, rename, delete
import ftp;
import ftpd;
import asys;
import net;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

// The server lists in the order of the directory; sort the names so the output is always the same.
void listing(ftp.Client* c, char* path) {
    ftp.EntryList* l = c->listEntries(path);
    char* names[20];
    int n = l->count;
    for (int i = 0; i < n; i++) names[i] = l->get(i)->name;
    for (int i = 1; i < n; i++) {                                // insertion sort
        char* x = names[i];
        int j = i - 1;
        while (j >= 0 && strcmp(names[j], x) > 0) { names[j + 1] = names[j]; j--; }
        names[j + 1] = x;
    }
    printf("list \"%s\": ", path);
    for (int i = 0; i < n; i++) {
        ftp.Entry* e = l->find(names[i]);
        printf("%s%s%s (%d)", i > 0 ? ", " : "", e->name, e->kind == ftp.K_DIR ? "/" : "", e->size);
    }
    printf("\n");
    l->dispose();
}

int main() {
    asys.mkdirs("ftproot");
    asys.writeFile("ftproot/hello.txt", "Hello from the server\n", 22);

    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "ftproot", ftpd.P_ALL);    // her jail is the directory ftproot
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    ftp.Options* o = ftp.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->authTls = ftp.STARTTLS_NEVER;                         // this server has no TLS: see ftp_tls
    o->record = true;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    if (!c->connect()) { println(c->error); return 1; }
    printf("logged in: %d, pwd %s\n", c->loggedIn, c->pwd());

    c->mkd("notes");
    c->cwd("notes");
    printf("in %s after cwd\n", c->pwd());
    c->store("todo.txt", "buy milk\n", 9);                    // upload from memory
    c->cwd("/");
    listing(c, "");
    listing(c, "notes");

    int n;
    char* data = c->retrieveAll("hello.txt", &n, 1000);      // download into memory (at most 1000 bytes)
    printf("hello.txt: %d bytes: %s", n, data);
    printf("size of notes/todo.txt: %d\n", c->size("notes/todo.txt"));

    c->rename("notes/todo.txt", "done.txt");
    c->dele("hello.txt");
    c->rmd("notes");
    listing(c, "");
    printf("dele of a file that is gone: %d (%s)\n", c->dele("hello.txt"), c->error);
    c->quit();

    // the commands that went out (the data connections' port numbers are left out: they change)
    printf("\ncommands sent:");
    char* t = c->transcript();
    while (*t != 0) {
        char* nl = strchr(t, 10);
        if (startsWith(t, "C: ") && !startsWith(t, "C: PASS")) printf(" %.*s;", (int) (nl - t - 3), t + 3);
        t = nl + 1;
    }
    printf("\n");
    return 0;
}
