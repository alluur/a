// Attachments: binary data, odd file names, and saving them safely
import mail;
import asys;

int main() {
    char* data = alloc(256);
    for (int i = 0; i < 256; i++) data[i] = i;                     // every byte value, NUL included

    mail.Message* m = mail.newMessage();
    m->from("ann@example.org");
    m->to("bob@example.org");
    m->text("Files attached.\n");
    m->attach("all-bytes.bin", "application/octet-stream", data, 256);
    m->attach("Gr\xC3\xBC\xC3\x9F" "e.txt", "text/plain", "hi\n", 3);         // non-ASCII name: RFC 2231 plus a plain fallback
    m->attach("../../etc/passwd", "text/plain", "not really\n", 11);    // a sender may write anything as a name
    m->attach("a\r\nBcc: x@y.z.pdf", "application/pdf", "x", 1);       // control characters become "_": no header injection

    int n;
    char* wire = m->build(&n);
    int notes = 0;
    for (int i = 0; i + 8 < n; i++) if (memcmp(&wire[i], "filename*", 9) == 0) notes++;
    printf("%d bytes on the wire, %d name(s) in the RFC 2231 form, Bcc header injected: %s\n", n, notes, contains(wire, "\r\nBcc:") ? "yes" : "no");

    // the receiver: names come from strangers, so make them fit for a directory with safeFilename()
    mail.Part* p = mail.parse(wire, n, null);
    asys.mkdirs("saved");
    for (int i = 0; i < p->attachmentCount(); i++) {
        mail.Part* a = p->attachment(i);
        char* name = mail.safeFilename(a->filename);
        char path[300];
        format(&path[0], 300, "saved/%s", name);
        asys.writeFile(&path[0], a->body, a->bodyLen);
        printf("%d: sent as [%s], saved as [%s], %d bytes\n", i, a->filename, name, a->bodyLen);
    }

    asys.DirList dl;
    asys.listDir("saved", &dl);
    dl.sort(false, false);
    printf("in the directory:");
    for (int i = 0; i < dl.count; i++) printf(" %s", dl.name(i));
    printf("\n");
    int len = 0;
    char* back = asys.readFile("saved/all-bytes.bin", &len);
    printf("all-bytes.bin: %d bytes, identical to the original: %s\n", len, (len == 256 && memcmp(back, data, 256) == 0) ? "yes" : "no");
    return 0;
}
