// ASCII and binary transfers: what happens to line ends, and why binary files need TYPE I
import ftp;
import ftpd;
import asys;
import net;
import mail;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

void bytes(char* label, char* d, int n) {              // print the bytes as hex, so that CR (0d) and LF (0a) can be seen
    printf("%s (%d bytes):", label, n);
    for (int i = 0; i < n; i++) printf(" %02x", d[i] & 255);
    printf("\n");
}

void diskFile(char* label, char* path) {
    int n = 0;
    char* d = asys.readFile(path, &n);
    bytes(label, d, n);
}

// What really travels on a data connection in ASCII mode: a second, raw connection to the server
void onTheWire(char* file) {
    int ctl = net.connect("127.0.0.1", srv->port);
    char b[1000];
    net.recv(ctl, &b[0], 1000);                          // the greeting
    net.sendText(ctl, "USER ann\r\nPASS secret\r\nTYPE A\r\nEPSV\r\n");
    mail.Buf reply;
    while (!contains(reply.text(), "229 ")) { int k = net.recv(ctl, &b[0], 1000); reply.add(&b[0], k); }
    int data = net.connect("127.0.0.1", ftp.parseEpsv(strstr(reply.text(), "(|||")));
    char cmd[100];
    format(&cmd[0], 100, "RETR %s\r\n", file);
    net.sendText(ctl, &cmd[0]);
    mail.Buf wire;
    int k = net.recv(data, &b[0], 1000);
    while (k > 0) { wire.add(&b[0], k); k = net.recv(data, &b[0], 1000); }
    bytes("  on the wire in ASCII mode", wire.d, wire.len);
    net.close(data);
    net.close(ctl);
}

int main() {
    asys.mkdirs("ftproot");
    asys.writeFile("ftproot/text.txt", "one\ntwo\r\nthree\n", 15);        // LF, CR LF and LF
    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "ftproot", ftpd.P_ALL);
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    ftp.Options* o = ftp.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->authTls = ftp.STARTTLS_NEVER;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    c->connect();

    int n;
    printf("downloading a file that has LF and CR LF line ends:\n");
    char* d = c->retrieveAll("text.txt", &n, 100);                 // TYPE I (binary) is the default
    bytes("  binary", d, n);
    c->type(false);                                                // TYPE A: ASCII
    d = c->retrieveAll("text.txt", &n, 100);
    bytes("  ASCII", d, n);
    onTheWire("text.txt");

    printf("\nuploading \"ff 0a 00 0d 0a 41\" (not text at all):\n");
    char data[6];
    data[0] = 255; data[1] = 10; data[2] = 0; data[3] = 13; data[4] = 10; data[5] = 'A';
    c->store("ascii.dat", &data[0], 6);                            // we are still in ASCII mode
    diskFile("  stored in ASCII mode", "ftproot/ascii.dat");
    c->type(true);
    c->store("binary.dat", &data[0], 6);
    diskFile("  stored in binary mode", "ftproot/binary.dat");
    c->quit();
    return 0;
}
