// Sending one message with the SMTP client to the SMTP server module
import smtp;
import smtpd;
import mail;
import net;

smtpd.Server* srv;
char* received;                      // the last message the server accepted
int receivedLen;

int serve() { srv->poll(0); return 0; }          // runs while the client waits (net.setIdleHook)

// The delivery hook: the server hands over each accepted message. Return 0 to say "250 stored".
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    received = malloc(n + 1);
    memcpy(received, data, n);
    received[n] = 0;
    receivedLen = n;
    printf("[server] message from <%s> for %d recipient(s)\n", s->from, s->nrcpt);
    return 0;
}

int main() {
    srv = smtpd.newServer();
    srv->core->hostname = "mail.example.org";
    srv->core->addLocalDomain("example.org");        // we accept mail for @example.org, and nothing else
    srv->core->deliverHook = deliver;
    srv->core->idPrefix = "Q";                       // queue ids Q1, Q2 ... instead of random ones
    srv->listenOn("127.0.0.1", 0, null);             // this machine only, a free port
    net.setIdleHook(serve);

    smtp.Options* o = smtp.newOptions();
    o->heloName = "client.example.net";
    o->record = true;                                // keep a transcript of the dialogue
    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, o);
    if (!c->connect()) { println(c->error); return 1; }
    printf("connected to %s: SIZE limit %d, 8BITMIME %d, STARTTLS %d\n\n", c->serverName, c->sizeLimit, c->has8bit, c->hasStartTls);

    mail.Message* m = mail.newMessage();
    m->from("ann@example.net");
    m->to("bob@example.org");
    m->subject("Hello Bob");
    m->setDate(1794580200, 0);
    m->setMessageId("<hello-1@example.net>");
    m->text("Hi Bob, this went through SMTP.\n");
    smtp.Result* r = c->sendMessage(m);              // MAIL FROM, RCPT TO, DATA from the message itself
    printf("ok=%d code=%d status=%d accepted=%d rejected=%d\n", r->ok, r->code, r->status, r->accepted, r->rejected);
    printf("the server said: %s\n\n", r->why());
    c->quit();

    printf("%s", c->transcript());
    mail.Part* p = mail.parse(received, receivedLen, null);
    printf("\nreceived %d bytes, subject \"%s\", body: %s", receivedLen, p->header("Subject"), p->body);
    c->dispose();
    return 0;
}
