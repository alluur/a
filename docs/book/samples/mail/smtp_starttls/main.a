// STARTTLS: an SMTP connection that turns into TLS, and what the client checks
import smtp;
import smtpd;
import net;
import tls;
import x509;
import testcert;

smtpd.Server* srv;
int serve() { srv->poll(0); return 0; }
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    printf("  [server] stored a message, encrypted: %d, user: %s\n", s->tls, s->authUser == null ? "-" : s->authUser);
    return 0;
}

void attempt(char* label, smtp.Options* o) {
    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, o);
    bool ok = c->connect();
    printf("%s\n  connect: %s, secure: %d, logged in: %d\n", label, ok ? "ok" : c->error, c->secure, c->authenticated);
    if (ok) {
        char* rc[1];
        rc[0] = "bob@example.org";
        smtp.Result* r = c->send("ann@example.org", &rc[0], 1, "hi\n", 3);
        printf("  send: ok=%d code=%d %s\n", r->ok, r->code, r->ok ? "" : r->why());
        c->quit();
    }
    c->dispose();
}

int main() {
    srv = smtpd.newServer();
    srv->core->hostname = "mail.example.org";
    srv->core->addLocalDomain("example.org");
    srv->core->addUser("ann", "secret");
    srv->core->deliverHook = deliver;
    srv->core->idPrefix = "Q";
    srv->core->tlsConfig = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);     // this switches STARTTLS on
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    x509.clearRoots();                                  // forget the roots of this machine
    x509.addRootPem(testcert.OTHER_CA_PEM);             // we trust some other authority, not the one that made our certificate

    smtp.Options* o = smtp.newOptions();
    o->startTls = smtp.STARTTLS_REQUIRED;
    attempt("1. STARTTLS required, certificate not trusted", o);

    x509.addRootPem(testcert.CERT_PEM);                 // now we trust it
    o = smtp.newOptions();
    o->startTls = smtp.STARTTLS_REQUIRED;
    o->username = "ann";
    o->password = "secret";
    attempt("2. trusted certificate, then AUTH (PLAIN is fine now: the link is encrypted)", o);

    o = smtp.newOptions();
    o->startTls = smtp.STARTTLS_REQUIRED;
    o->verify = false;                                  // encrypted, but not checking who is at the other end
    attempt("3. verify = false: it works with any certificate, and protects against nothing but eavesdroppers", o);

    srv->core->requireTls = true;                       // the server refuses mail on a plain connection
    o = smtp.newOptions();
    o->startTls = smtp.STARTTLS_NEVER;
    attempt("4. the client never asks for TLS, the server insists", o);
    return 0;
}
