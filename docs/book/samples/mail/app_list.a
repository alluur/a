// A tiny mailing list: receive with smtpd, rewrite with mail, forward with smtp
import smtp;
import smtpd;
import mail;
import asys;
import net;

smtpd.Server* listHost;          // the list's own server: accepts mail for team@lists.example
smtpd.Server* mailHost;          // the members' mail host: stores into Maildirs
char* queue[8];                  // accepted by the list, not forwarded yet
int queueLen[8];
int queued = 0;

int serve() { listHost->poll(0); mailHost->poll(0); return 0; }      // both servers, whenever a client waits

int onlyTheList(smtpd.Core* core, smtpd.Session* s, char* addr) { return streq(addr, "team@lists.example") ? 0 : 550; }

// A callback must not wait for the network (it runs inside the idle hook), so it only queues the message.
int enqueue(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    queue[queued] = malloc(n + 1);
    memcpy(queue[queued], data, n);
    queueLen[queued] = n;
    queued++;
    return 0;
}

// Mark each queued message as list mail and send one copy to all members.
void forwardAll(char** members, int count) {
    for (int i = 0; i < queued; i++) {
        mail.Part* p = mail.parse(queue[i], queueLen[i], null);
        if (p->header("List-Id") != null) { printf("list: dropped a message that has been through a list\n"); continue; }
        char subject[300];
        format(&subject[0], 300, "[team] %s", p->header("Subject") ?? "");
        p->headers->set("Subject", &subject[0]);
        p->headers->add("List-Id", "<team.lists.example>");
        p->headers->add("Precedence", "list");
        int n;
        char* wire = mail.serialize(p, null, &n);
        smtp.Client* c = smtp.newClient("127.0.0.1", mailHost->port, smtp.newOptions());
        c->connect();
        smtp.Result* r = c->send("team-bounces@lists.example", members, count, wire, n);   // bounces go to this address
        printf("list: forwarded \"%s\" to %d members, %d accepted\n", &subject[0], count, r->accepted);
        c->quit();
        c->dispose();
    }
    queued = 0;
}

void post(char* from, char* to, char* text) {              // somebody sends a message to an address
    smtp.Client* c = smtp.newClient("127.0.0.1", listHost->port, smtp.newOptions());
    c->connect();
    char* rcpt[1];
    rcpt[0] = to;
    smtp.Result* r = c->send(from, &rcpt[0], 1, text, strlen(text));
    printf("%s -> %s: %s\n", from, to, r->ok ? "accepted" : r->why());
    c->quit();
    c->dispose();
}

char* readOnlyMessage(char* mailbox) {                     // the one file in spool/<mailbox>/new
    char dir[100];
    format(&dir[0], 100, "spool/%s/new", mailbox);
    asys.DirList dl;
    asys.listDir(&dir[0], &dl);
    char path[200];
    format(&path[0], 200, "%s/%s", &dir[0], dl.name(0));
    return asys.readFile(&path[0], null);
}

int main() {
    listHost = smtpd.newServer();
    listHost->core->addLocalDomain("lists.example");
    listHost->core->rcptHook = onlyTheList;
    listHost->core->deliverHook = enqueue;
    listHost->listenOn("127.0.0.1", 0, null);
    mailHost = smtpd.newServer();
    mailHost->core->addLocalDomain("example.org");
    mailHost->core->maildir = "spool";
    mailHost->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    char* members[3];
    members[0] = "ann@example.org";  members[1] = "bob@example.org";  members[2] = "carol@example.org";
    post("dave@example.net", "team@lists.example", "From: dave@example.net\nSubject: Friday lunch\n\nNoon at the usual place.\n");
    post("dave@example.net", "other@lists.example", "Subject: wrong address\n\nhi\n");
    forwardAll(&members[0], 3);

    char* mine = readOnlyMessage("carol");
    mail.Part* m = mail.parse(mine, strlen(mine), null);
    printf("carol's copy: Subject \"%s\", List-Id %s, Precedence %s\n", m->header("Subject"), m->header("List-Id"), m->header("Precedence"));
    printf("ann's mailbox: %s\n", readOnlyMessage("ann") != null ? "one message" : "empty");

    post("carol@example.org", "team@lists.example", mine);     // she replies with the list mail itself: a loop
    forwardAll(&members[0], 3);
    return 0;
}
