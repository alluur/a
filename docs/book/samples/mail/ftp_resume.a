// Resuming an interrupted download and upload with REST, and appending with APPE
import ftp;
import ftpd;
import asys;
import net;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

char* pattern(int n) {                                   // n bytes that are all different from their neighbours
    char* p = alloc(n + 1);
    for (int i = 0; i < n; i++) p[i] = 'a' + (i * 7 + i / 26) % 26;
    p[n] = 0;
    return p;
}

int sizeOf(char* path) {
    asys.Stat st;
    return asys.stat(path, &st) < 0 ? -1 : st.size;
}

bool sameFile(char* path, char* want, int n) {
    int len = 0;
    char* d = asys.readFile(path, &len);
    return d != null && len == n && memcmp(d, want, n) == 0;
}

int main() {
    char* whole = pattern(1000);
    asys.mkdirs("ftproot");
    asys.mkdirs("local");
    asys.writeFile("ftproot/big.dat", whole, 1000);

    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "ftproot", ftpd.P_ALL);
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);
    ftp.Options* o = ftp.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->authTls = ftp.STARTTLS_NEVER;
    o->record = true;
    ftp.Client* c = ftp.newClient("127.0.0.1", srv->port, o);
    c->connect();

    // 1. A download that stopped after 400 bytes: the file is there, but short
    asys.writeFile("local/big.dat", whole, 400);
    printf("local file before: %d bytes\n", sizeOf("local/big.dat"));
    printf("download with resume: %d\n", c->download("big.dat", "local/big.dat", true));    // true: continue at the end of the file
    printf("local file after: %d bytes, identical to the original: %d\n", sizeOf("local/big.dat"), sameFile("local/big.dat", whole, 1000));

    // 2. An upload that stopped after 300 bytes
    c->store("part.dat", whole, 300);
    printf("\nserver file before: %d bytes\n", c->size("part.dat"));
    asys.writeFile("local/part.dat", whole, 1000);
    printf("upload with resume: %d\n", c->upload("local/part.dat", "part.dat", true));
    printf("server file after: %d bytes, identical: %d\n", c->size("part.dat"), sameFile("ftproot/part.dat", whole, 1000));

    // 3. APPE adds to the end of a file (or creates it)
    c->store("log.txt", "one\n", 4);
    c->append("log.txt", "two\n", 4);
    c->append("new.txt", "three\n", 6);
    printf("\nlog.txt: %d bytes, new.txt: %d bytes\n", sizeOf("ftproot/log.txt"), sizeOf("ftproot/new.txt"));

    // 4. What the client said: REST gave the offset, RETR and STOR came after it
    char* t = c->transcript();
    printf("\ncommands that matter:");
    while (*t != 0) {
        char* nl = strchr(t, 10);
        if (startsWith(t, "C: REST") || startsWith(t, "C: RETR") || startsWith(t, "C: STOR") || startsWith(t, "C: APPE")) printf(" %.*s;", (int) (nl - t - 3), t + 3);
        t = nl + 1;
    }
    printf("\n");
    c->quit();
    return 0;
}
