// Deleting with POP3: nothing happens until QUIT, and UIDL tells new mail from old
import pop3;
import pop3d;
import asys;
import net;

pop3d.Server* srv;
int serve() { srv->poll(0); return 0; }

void put(char* name, char* text) { asys.writeFile(name, text, strlen(text)); }

int filesIn(char* dir) {
    asys.DirList dl;
    int n = asys.listDir(dir, &dl);
    dl.dispose();
    return n;
}

pop3.Client* login() {
    pop3.Options* o = pop3.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->startTls = pop3.STARTTLS_NEVER;
    o->allowPlainLogin = true;
    pop3.Client* c = pop3.newClient("127.0.0.1", srv->port, o);
    c->connect();
    return c;
}

int main() {
    asys.mkdirs("box/ann/new");
    put("box/ann/new/1000.a", "Subject: one\n\nfirst\n");
    put("box/ann/new/1001.b", "Subject: two\n\nsecond\n");
    put("box/ann/new/1002.c", "Subject: three\n\nthird\n");
    srv = pop3d.newServer();
    srv->addUser("ann", "secret", "box/ann");
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    // 1. DELE only marks. A connection that breaks (no QUIT) deletes nothing.
    pop3.Client* c = login();
    c->dele(1);
    printf("1. marked message 1; STAT now says %d messages\n", c->count());
    c->dispose();                                      // closes the connection without QUIT
    for (int i = 0; i < 100; i++) srv->poll(1);        // let the server notice
    printf("   connection dropped: %d files in the mailbox\n", filesIn("box/ann/new"));

    // 2. RSET takes the marks back; QUIT carries them out
    c = login();
    c->dele(1);
    c->dele(2);
    c->reset();
    printf("2. marked 1 and 2, then RSET: STAT says %d messages\n", c->count());
    c->dele(2);
    c->quit();                                         // now it is deleted for real
    printf("   after QUIT: %d files in the mailbox\n", filesIn("box/ann/new"));
    c->dispose();

    // 3. Leaving mail on the server: remember the UIDLs you have seen, fetch only the others
    put("box/ann/new/1003.d", "Subject: four\n\nfourth\n");
    char* seen = "1000.a";                             // remembered from the last run of the program
    c = login();
    int count = c->count();
    printf("3. %d messages on the server, 1 seen before\n", count);
    for (int i = 1; i <= count; i++) {
        char uid[100];
        c->uidl(i, &uid[0], 100);
        if (streq(&uid[0], seen)) { printf("   %s: seen, skipped\n", &uid[0]); continue; }
        int n;
        char* msg = c->retr(i, &n);
        printf("   %s: fetched %d bytes\n", &uid[0], n);
    }
    c->quit();
    return 0;
}
