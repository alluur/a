// Non-ASCII text in headers: RFC 2047 encoded words
import mail;

void encode(char* label, char* s) {
    mail.Buf b;
    mail.encodeWords(s, strlen(s), &b);
    printf("%s\n  %s\n", label, b.text());
    b.release();
}

void decode(char* label, char* s) {
    mail.Buf b;
    mail.decodeWords(s, strlen(s), &b);
    printf("%s\n  %s\n", label, b.text());
    b.release();
}

int main() {
    // Header fields are ASCII. Other text travels as "=?charset?B or Q?text?=" words.
    // The encoder picks B (base64) or Q (quoted-printable), whichever is shorter, and leaves plain words alone.
    encode("ASCII stays as it is:", "Lunch on Friday");
    encode("only the words that need it are encoded (here Q is shorter):", "\xC3\x84rger mit der Rechnung f\xC3\xBCr Mai");
    encode("all non-Latin (B):", "\xE6\x97\xA5\xE6\x9C\xAC\xE8\xAA\x9E\xE3\x81\xAE\xE3\x83\x86\xE3\x82\xB9\xE3\x83\x88");
    encode("a long text is cut into words of at most 75 characters:",
           "Gr\xC3\xBC\xC3\x9F" "e aus M\xC3\xBCnchen und dem restlichen Bayern, mit vielen weiteren sch\xC3\xB6nen Worten dahinter");

    // Decoding knows the old character sets too, and joins what was split
    decode("Latin-1 and UTF-8 words in one text:", "=?ISO-8859-1?Q?Andr=E9?= and =?utf-8?B?w7w=?=");
    decode("the blank between two words is dropped:", "=?UTF-8?Q?a?= =?UTF-8?Q?b?= and =?UTF-8?Q?c?=");
    decode("a character split over two words is joined:", "=?UTF-8?Q?=C3?= =?UTF-8?Q?=84?=");
    decode("an unknown character set stays as it is:", "=?x-klingon?Q?qapla=27?=");

    // The builder does this for subjects and display names; parse() undoes it
    mail.Message* m = mail.newMessage();
    m->from("\"M\xC3\xBCller, Ann\" <ann@example.org>");
    m->to("bob@example.org");
    m->subject("Gr\xC3\xBC\xC3\x9F" "e");
    m->setDate(1794580200, 0);
    m->setMessageId("<w1@example.org>");
    m->text("x\n");
    int n;
    char* wire = m->build(&n);
    mail.Part* p = mail.parse(wire, n, null);
    printf("on the wire:\n  From: %s\n  Subject: %s\n", p->header("From"), p->header("Subject"));
    char* subj = p->decodedHeader("Subject");
    mail.AddressList* from = p->addresses("From");
    printf("decoded:\n  Subject: %s\n  From: name [%s], address [%s]\n", subj, from->get(0)->name, from->get(0)->addr);
    return 0;
}
