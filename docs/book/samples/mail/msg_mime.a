// Multipart messages: text and HTML, an inline picture and an attachment, then walk the tree
import mail;

void tree(mail.Part* p, int depth) {
    for (int i = 0; i < depth; i++) printf("  ");
    printf("%s/%s", p->type, p->subtype);
    if (p->encoding != null) printf("  [%s]", p->encoding);
    if (p->filename != null) printf("  file=%s", p->filename);
    if (p->contentId != null) printf("  cid=%s", p->contentId);
    if (p->disposition != null) printf("  %s", p->disposition);
    if (!p->isMultipart()) printf("  %d bytes", p->bodyLen);
    printf("\n");
    for (int i = 0; i < p->nchildren; i++) tree(p->child(i), depth + 1);
}

int main() {
    char* png = "\x89PNG\r\n\x1a\n-pretend picture data-";    // not a real picture: bytes are bytes to the mail module
    mail.Message* m = mail.newMessage();
    m->from("ann@example.org");
    m->to("bob@example.org");
    m->subject("Newsletter");
    m->setDate(1794580200, 0);
    m->setMessageId("<news-1@example.org>");
    m->setBoundaryPrefix("B");                               // boundaries B1, B2 ...: the same on every run
    m->text("Hello! The picture needs an HTML viewer.\n");
    m->html("<p>Hello! <img src=\"cid:logo1\"></p>");
    m->attachInline("logo.png", "image/png", png, strlen(png), "logo1");
    m->attach("terms.pdf", "application/pdf", "%PDF-1.4 fake", 13);

    int n;
    char* wire = m->build(&n);
    mail.Part* p = mail.parse(wire, n, null);
    tree(p, 0);

    printf("\nleaf parts: %d, attachments: %d\n", p->leafCount(), p->attachmentCount());
    mail.Part* a = p->attachment(0);
    printf("first attachment: %s, %s/%s, %d bytes\n", a->filename, a->type, a->subtype, a->bodyLen);
    mail.Part* pic = p->findContentId("logo1");
    printf("the part of cid:logo1: %s, begins with PNG: %s\n", pic->filename, memcmp(&pic->body[1], "PNG", 3) == 0 ? "yes" : "no");
    printf("plain text: %s", p->firstText("plain")->body);
    printf("html text:  %s\n", p->firstText("html")->body);

    // Only text: no multipart at all. Text and one attachment: multipart/mixed.
    mail.Message* t = mail.newMessage();
    t->from("ann@example.org");
    t->to("bob@example.org");
    t->text("just text\n");
    char* w2 = t->build(&n);
    mail.Part* q = mail.parse(w2, n, null);
    printf("\nonly text -> %s/%s\n", q->type, q->subtype);
    return 0;
}
