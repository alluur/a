// The SMTP server as a mail drop: messages go into a Maildir, one per recipient
import smtp;
import smtpd;
import asys;
import net;

smtpd.Server* srv;
int serve() { srv->poll(0); return 0; }

// A Maildir file is named  <time>.<random>.<queue id>  : the middle part differs from run to run, so it is not printed
void listing(char* path) {
    asys.DirList dl;
    asys.listDir(path, &dl);
    dl.sort(false, false);
    printf("%s:", path);
    for (int i = 0; i < dl.count; i++) {
        char* name = dl.name(i);
        char* firstDot = strchr(name, '.');
        char* lastDot = strrchr(name, '.');
        if (firstDot != null && lastDot != firstDot) printf(" %.*s.<random>%s", (int) (firstDot - name), name, lastDot); else printf(" %s", name);
    }
    printf("\n");
    dl.dispose();
}

int main() {
    srv = smtpd.newServer();
    srv->core->hostname = "mail.example.org";
    srv->core->addLocalDomain("example.org");
    srv->core->maildir = "spool";                    // spool/<mailbox>/new/<file>, made on demand
    srv->core->useFakeTime = true;                   // a fixed clock and fixed ids: the same output on every run
    srv->core->fakeTime = 1794580200;
    srv->core->idPrefix = "Q";
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, smtp.newOptions());
    c->connect();
    char* rcpts[4];
    rcpts[0] = "Bob@Example.ORG";                    // the mailbox name is made from the local part, in lower case
    rcpts[1] = "carol.smith+news@example.org";
    rcpts[2] = "\"../../etc/cron\"@example.org";      // a legal address (quoted local part), but never a path
    rcpts[3] = "o'neil@example.org";                 // also valid, but outside a-z 0-9 . _ + - : refused too
    char* msg = "From: ann@example.net\nSubject: Hello\n\nHi there.\n";
    smtp.Result* r = c->send("ann@example.net", &rcpts[0], 4, msg, strlen(msg));
    printf("accepted %d, rejected %d\n", r->accepted, r->rejected);
    for (int i = 0; i < r->count; i++) printf("  %-30s %d\n", rcpts[i], r->rcptCode[i]);
    c->quit();

    listing("spool");
    listing("spool/bob/new");
    listing("spool/carol.smith+news/new");

    // the file that Bob got: the server added Return-Path and Received at the top
    asys.DirList dl;
    asys.listDir("spool/bob/new", &dl);
    char path[300];
    format(&path[0], 300, "spool/bob/new/%s", dl.name(0));
    int n;
    char* file = asys.readFile(&path[0], &n);
    printf("\n--- the message in Bob's Maildir (%d bytes)\n", n);
    for (int i = 0; i < n; i++) if (file[i] != 13) printf("%c", file[i]);
    return 0;
}
