// Header fields: folding long lines, reading a header block, and address lists
import mail;

void show(mail.Buf* b) {                             // print a Buf without the CR of CR LF
    for (int i = 0; i < b->len; i++) if (b->d[i] != 13) printf("%c", b->d[i]);
}

void list(char* text) {
    mail.AddressList l;
    int n = mail.parseAddressList(text, strlen(text), &l);
    printf("%s\n", text);
    if (n < 0) printf("  refused: %s\n", mail.error());
    for (int i = 0; i < l.count; i++) {
        mail.Address* a = l.get(i);
        printf("  name [%s]  address [%s]  group [%s]\n", a->name, a->addr, a->group == null ? "" : a->group);
    }
    l.dispose();
}

void fmt(char* label, char* name, char* addr) {
    mail.Buf b;
    bool ok = mail.formatAddress(&b, name, addr);
    printf("%s -> %s\n", label, ok ? b.text() : "refused");
}

int main() {
    // 1. Folding: a line over 78 characters is broken at a blank. A word that is too long stays whole.
    mail.Buf b;
    char* subject = "The quarterly report for the northern region, including the corrected figures from March and the new forecast";
    mail.foldHeader(&b, "Subject", subject, strlen(subject));
    char* refs = "<a-very-long-message-id-that-cannot-be-broken-anywhere@example.org> <b@x>";
    mail.foldHeader(&b, "References", refs, strlen(refs));
    show(&b);
    mail.Buf bad;
    printf("a value with a line break is refused: %d\n\n", mail.foldHeader(&bad, "Subject", "x\r\nBcc: evil@example.org", 24));

    // 2. Reading a header block: continuation lines are joined, names are found without regard to case
    char* text = "Received: from a.example\r\n by mx.example; Fri, 13 Nov 2026 14:30:00 +0000\r\n"
                 "received: from b.example by a.example\r\n"
                 "Subject: Hello\r\n  there\r\n"
                 "\r\n"
                 "Body starts here\r\n";
    mail.Headers h;
    int used = 0;
    mail.parseHeaders(text, strlen(text), &h, &used, mail.MAX_HEADERS, mail.MAX_HEADER_BYTES, mail.MAX_HEADER_LINE);
    printf("%d fields, the body starts at byte %d: \"%.4s\"\n", h.count, used, &text[used]);
    for (int i = 0; i < h.count; i++) printf("  [%s] = [%s]\n", h.items[i]->name, h.items[i]->value);
    printf("get(\"SUBJECT\") is \"%s\"; Received occurs %d times\n\n", h.get("SUBJECT"), h.countOf("received"));
    h.dispose();

    // 3. Address lists: names, comments, quoted names, groups; and what is refused
    list("Ann <ann@example.org>, bob@example.org (Bob), \"Carol, the Boss\" <carol@example.org>");
    list("Team: dave@example.org, erin@example.org;, frank@example.org");
    list("a b@example.org");
    fmt("\nformat a name", "Ann", "ann@example.org");
    fmt("a comma in the name", "Doe, John", "john@example.org");          // quoted
    fmt("a non-ASCII name", "J\xC3\xBCrgen", "juergen@example.org");      // an encoded word
    fmt("a line break in the name", "Evil\r\nBcc: x@example.org", "e@example.org");
    char* addr = "ann..o@example.org";
    printf("validAddress(%s): %d\n", addr, mail.validAddress(addr, strlen(addr)));
    return 0;
}
