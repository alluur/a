// FTPS: FTP over TLS, explicit (AUTH TLS) and implicit, with the data connections encrypted too
import ftp;
import ftpd;
import net;
import tls;
import x509;
import asys;
import testcert;

ftpd.Server* srv;
int serve() { srv->poll(0); return 0; }

ftp.Options* options(bool tlsFromStart) {
    ftp.Options* o = ftp.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->record = true;
    o->useTls = tlsFromStart;                  // implicit FTPS: TLS before the first byte
    return o;
}

// the lines of the transcript that are about TLS
void tlsLines(ftp.Client* c) {
    char* t = c->transcript();
    while (*t != 0) {
        char* nl = strchr(t, 10);
        if (startsWith(t, "C: AUTH") || startsWith(t, "C: PBSZ") || startsWith(t, "C: PROT") || startsWith(t, "C: PASS")) printf("    %.*s\n", (int) (nl - t), t);
        t = nl + 1;
    }
}

void session(char* label, ftp.Options* o, int port) {
    ftp.Client* c = ftp.newClient("127.0.0.1", port, o);
    bool ok = c->connect();
    printf("%s\n  login: %s, control encrypted: %d, data encrypted: %d\n", label, ok ? "ok" : c->error, c->secure, c->dataProtected);
    if (ok) {
        if (c->store("secret.txt", "for your eyes only\n", 19)) {
            int n;
            char* d = c->retrieveAll("secret.txt", &n, 100);
            printf("  stored and fetched back: %s", d);
        } else {
            printf("  store failed: %s\n", c->error);
        }
        tlsLines(c);
        c->quit();
    }
    c->dispose();
}

int main() {
    asys.mkdirs("ftproot");
    x509.addRootPem(testcert.CERT_PEM);                       // trust the throw-away certificate
    srv = ftpd.newServer();
    srv->addUser("ann", "secret", "ftproot", ftpd.P_ALL);
    srv->tlsConfig = tls.loadConfig(testcert.CERT_PEM, testcert.KEY_PEM);
    srv->requireTls = true;                                   // no USER / PASS before TLS
    srv->requireDataTls = true;                               // no transfer without PROT P
    srv->listenOn("127.0.0.1", 0, null);                      // explicit FTPS: plain port, AUTH TLS
    srv->listenOn("127.0.0.1", 0, srv->tlsConfig);            // implicit FTPS: TLS from the first byte
    net.setIdleHook(serve);

    ftp.Options* o = options(false);
    o->authTls = ftp.STARTTLS_NEVER;
    session("1. a plain client", o, srv->port);
    session("2. explicit FTPS (AUTH TLS, then PBSZ 0 and PROT P)", options(false), srv->port);
    session("3. implicit FTPS on the second port", options(true), srv->net->listenerPort(1));
    o = options(false);
    o->protectData = false;                                   // login is encrypted, the data would not be
    session("4. the client skips PROT P, the server insists on it", o, srv->port);
    return 0;
}
