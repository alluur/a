// Who gets the message: recipient rules on the server, partial failures on the client
import smtp;
import smtpd;
import mail;
import net;

smtpd.Server* srv;
int delivered = 0;

int serve() { srv->poll(0); return 0; }

// The recipient hook runs for every RCPT TO. 0 accepts; any other number is sent as the reply code.
int checkRcpt(smtpd.Core* core, smtpd.Session* s, char* addr) {
    if (streq(addr, "nobody@example.org")) return 550;    // no such mailbox: permanent
    if (streq(addr, "full@example.org")) return 450;      // mailbox full: try again later
    return 0;
}

// The delivery hook runs after the message has arrived. 0 stores it; a code refuses it (4xx: try again, 5xx: never).
int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    if (contains(data, "BUY NOW")) return 554;
    if (contains(data, "DISK FULL")) return 451;
    delivered++;
    printf("  [server] stored the message for %d recipient(s): ", s->nrcpt);
    for (int i = 0; i < s->nrcpt; i++) printf("%s ", s->rcpt[i]);
    printf("\n");
    return 0;
}

void send(char* label, bool allOrNothing, char** rcpts, int n) {
    smtp.Options* o = smtp.newOptions();
    o->allOrNothing = allOrNothing;
    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, o);
    c->connect();
    smtp.Result* r = c->send("ann@example.net", rcpts, n, "Subject: hi\n\nhello\n", 19);
    printf("%s: ok=%d accepted=%d rejected=%d, last code %d (%s)\n", label, r->ok, r->accepted, r->rejected, r->code, r->why());
    for (int i = 0; i < r->count; i++) printf("  %-20s %d\n", rcpts[i], r->rcptCode[i]);
    c->quit();
    c->dispose();
}

void sendBody(char* body) {
    smtp.Client* c = smtp.newClient("127.0.0.1", srv->port, smtp.newOptions());
    c->connect();
    char* rcpt[1];
    rcpt[0] = "bob@example.org";
    smtp.Result* r = c->send("ann@example.net", &rcpt[0], 1, body, strlen(body));
    printf("message \"%s\": ok=%d code=%d temporary=%d (%s)\n", body, r->ok, r->code, r->temporary, r->why());
    c->quit();
    c->dispose();
}

int main() {
    srv = smtpd.newServer();
    srv->core->hostname = "mail.example.org";
    srv->core->addLocalDomain("example.org");            // only these domains are ours; anything else is "relay access denied"
    srv->core->rcptHook = checkRcpt;
    srv->core->deliverHook = deliver;
    srv->core->idPrefix = "Q";                           // fixed queue ids: the output is the same on every run
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(serve);

    char* rcpts[4];
    rcpts[0] = "bob@example.org";
    rcpts[1] = "nobody@example.org";
    rcpts[2] = "full@example.org";
    rcpts[3] = "eve@other.example";                      // not a local domain: the server is not an open relay
    send("default (the others still get it)", false, &rcpts[0], 4);
    send("allOrNothing (one refusal cancels everything)", true, &rcpts[0], 4);
    send("only a good recipient", false, &rcpts[0], 1);
    send("only bad recipients", false, &rcpts[1], 3);
    sendBody("BUY NOW");                                 // the server refuses the message itself
    sendBody("DISK FULL");
    printf("messages stored by the server: %d, recipients refused: %d\n", delivered, srv->core->stats->rcptRefused);
    return 0;
}
