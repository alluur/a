// stats: descriptive statistics: mean, variance, quantiles (all nine definitions), mode, skewness, kurtosis, covariance, correlations (Pearson, Spearman,
// Kendall), ranks, means, covariance matrices, sorting, NaN and edge cases. Expected output: tests/algo2_ref/gen_t446.py (exact fractions, the statistics module).
import cstdio;
import asys;
import stats;
import matrix;
import dmath;

int seed = 1234567;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

void pv(char* name, double v) {
    printf("%s", name);
    printfd(" %.9g\n", __bits(v));
}

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.9g", __bits(v[i])); }
    printf("\n");
}

bool isNan(double v) { return v != v; }

void chk(char* label, bool v) {
    printf("%s: %d\n", label, v);
}

int main() {
    int base = asys.memInUse();
    // ---- data: 23 numbers with one decimal, 17 integers with ties, and a second variable
    double x[23];
    double y[23];
    for (int i = 0; i < 23; i++) { x[i] = (double) (lcg() % 1000) / 10.0; }
    for (int i = 0; i < 23; i++) { y[i] = 0.5 * x[i] + (double) (lcg() % 400) / 10.0 - 20.0; }
    double t[17];
    double u[17];
    for (int i = 0; i < 17; i++) { t[i] = (double) (lcg() % 9 + 1); }
    for (int i = 0; i < 17; i++) { u[i] = (double) (lcg() % 6); }
    dumpV("x", x, 23);
    dumpV("y", y, 23);
    dumpV("t", t, 17);
    dumpV("u", u, 17);

    pv("sum", stats.sum(x, 23));
    pv("mean", stats.mean(x, 23));
    pv("variance (n - 1)", stats.variance(x, 23, 1));
    pv("variance (n)", stats.variance(x, 23, 0));
    pv("stddev (n - 1)", stats.stddev(x, 23, 1));
    pv("stddev (n)", stats.stddev(x, 23, 0));
    pv("sem", stats.sem(x, 23));
    pv("minimum", stats.minimum(x, 23));
    pv("maximum", stats.maximum(x, 23));
    pv("range", stats.rangeOf(x, 23));
    pv("median", stats.median(x, 23));
    pv("iqr", stats.iqr(x, 23, 7));
    pv("mad", stats.mad(x, 23));
    double ps[7] = {0.0, 0.1, 0.25, 0.5, 0.75, 0.9, 1.0};
    for (int m = 1; m <= 9; m++) {
        double q[7];
        stats.quantiles(x, 23, ps, 7, q, m);
        char name[32];
        sprintf(name, "quantile type %d", m);
        dumpV(name, q, 7);
    }
    double q4[3];
    double ps2[3] = {0.333333333333, 0.05, 0.995};
    stats.quantiles(t, 17, ps2, 3, q4, 6);
    dumpV("quantiles of t, type 6", q4, 3);
    stats.quantiles(t, 17, ps2, 3, q4, 8);
    dumpV("quantiles of t, type 8", q4, 3);
    pv("mode of t", stats.mode(t, 17));
    double modes[9];
    printf("multimode of t: %d modes:", stats.multimode(t, 17, modes, 9));
    int nm = stats.multimode(t, 17, modes, 9);
    for (int i = 0; i < nm; i++) { printfd(" %g", __bits(modes[i])); }
    printf("\n");
    double small[2];
    int cnt1 = stats.multimode(t, 17, small, 1);
    printfd("multimode with room for 1: count %d, first %g\n", cnt1, __bits(small[0]));
    pv("mode of u", stats.mode(u, 17));
    pv("skewness (biased)", stats.skewness(x, 23, true));
    pv("skewness (unbiased)", stats.skewness(x, 23, false));
    pv("excess kurtosis (biased)", stats.kurtosis(x, 23, true, true));
    pv("kurtosis (biased, Pearson)", stats.kurtosis(x, 23, true, false));
    pv("excess kurtosis (unbiased)", stats.kurtosis(x, 23, false, true));
    pv("covariance (n - 1)", stats.covariance(x, y, 23, 1));
    pv("covariance (n)", stats.covariance(x, y, 23, 0));
    pv("pearson", stats.correlation(x, y, 23));
    pv("spearman (x, y)", stats.spearman(x, y, 23));
    pv("spearman (t, u) with ties", stats.spearman(t, u, 17));
    pv("kendall (x, y)", stats.kendall(x, y, 23));
    pv("kendall (t, u) with ties", stats.kendall(t, u, 17));
    double rk[17];
    printf("ranks: %d\n", stats.ranks(t, 17, rk));
    dumpV("ranks of t", rk, 17);
    double z[23];
    printf("zscores: %d\n", stats.zscores(x, 23, z, 0));
    dumpV("z (first 6)", z, 6);
    pv("geometric mean of t", stats.geometricMean(t, 17));
    pv("harmonic mean of t", stats.harmonicMean(t, 17));
    double w[17];
    for (int i = 0; i < 17; i++) { w[i] = (double) (i + 1); }
    pv("weighted mean of t", stats.weightedMean(t, w, 17));
    pv("geometric mean with a zero", stats.geometricMean(u, 17));

    // ---- covariance matrix and correlation matrix of 3 variables (12 observations)
    matrix.Matrix data(12, 3);
    for (int i = 0; i < 12; i++) {
        data.d[i * 3] = (double) (lcg() % 50) / 5.0;
        data.d[i * 3 + 1] = (double) (lcg() % 50) / 5.0 + data.d[i * 3] * 0.5;
        data.d[i * 3 + 2] = (double) (lcg() % 20) - data.d[i * 3];
    }
    matrix.Matrix cov = stats.covarianceMatrix(&data, 1);
    matrix.Matrix cor = stats.correlationMatrix(&data);
    printf("covariance matrix:");
    for (int i = 0; i < 9; i++) { printfd(" %.9g", __bits(cov.d[i])); }
    printf("\ncorrelation matrix:");
    for (int i = 0; i < 9; i++) { printfd(" %.9g", __bits(cor.d[i])); }
    printf("\n");
    cov.dispose(); cor.dispose(); data.dispose();

    // ---- sorting
    {
        int n = 3000;
        double* a = (double*) asys.alloc(n * 8);
        double* b = (double*) asys.alloc(n * 8);
        for (int i = 0; i < n; i++) { a[i] = (double) (lcg() % 100000) / 7.0 - 5000.0; }
        double s0 = stats.sum(a, n);
        for (int i = 0; i < n; i++) { b[i] = a[i]; }
        stats.sortDoubles(a, n);
        bool ok = true;
        for (int i = 1; i < n; i++) { if (a[i - 1] > a[i]) { ok = false; } }
        printf("sortDoubles random: sorted %d, sum kept %d\n", ok, stats.sum(a, n) == s0 || dmath.fabs(stats.sum(a, n) - s0) < 1.0e-9);
        stats.sortDoubles(a, n);                                   // already sorted
        ok = true;
        for (int i = 1; i < n; i++) { if (a[i - 1] > a[i]) { ok = false; } }
        for (int i = 0; i < n; i++) { b[i] = a[n - 1 - i]; }
        stats.sortDoubles(b, n);                                   // reverse sorted
        bool same = true;
        for (int i = 0; i < n; i++) { if (a[i] != b[i]) { same = false; } }
        printf("sortDoubles sorted input stays sorted %d, reversed input becomes sorted %d\n", ok, same);
        for (int i = 0; i < n; i++) { a[i] = (double) (i % 3); }
        stats.sortDoubles(a, n);
        ok = true;
        for (int i = 1; i < n; i++) { if (a[i - 1] > a[i]) { ok = false; } }
        printfd("sortDoubles with only 3 distinct values: %d, first %g last %g\n", ok, __bits(a[0]), __bits(a[n - 1]));
        for (int i = 0; i < n; i++) { a[i] = 5.0; }
        stats.sortDoubles(a, n);
        printfd("sortDoubles of equal values: %g\n", __bits(a[1500]));
        // organ pipe and sawtooth patterns that are bad for naive quicksorts
        for (int i = 0; i < n; i++) { a[i] = (i < n / 2) ? (double) i : (double) (n - i); }
        stats.sortDoubles(a, n);
        ok = true;
        for (int i = 1; i < n; i++) { if (a[i - 1] > a[i]) { ok = false; } }
        printf("organ pipe: %d\n", ok);
        asys.free((char*) a);
        asys.free((char*) b);
    }

    // ---- edge cases and invalid input
    {
        double one[1] = {7.5};
        double two[2] = {1.0, 3.0};
        double nan = dmath.nan();
        double inf = dmath.INFINITY;
        double withNan[4] = {1.0, nan, 3.0, 4.0};
        double withInf[3] = {1.0, inf, 3.0};
        double both[2] = {inf, -inf};
        double cst[4] = {2.0, 2.0, 2.0, 2.0};
        pv("mean of one value", stats.mean(one, 1));
        chk("variance of one value (n - 1) is NaN", isNan(stats.variance(one, 1, 1)));
        pv("variance of one value (n)", stats.variance(one, 1, 0));
        pv("variance of two values", stats.variance(two, 2, 1));
        chk("mean of nothing is NaN", isNan(stats.mean(one, 0)));
        chk("mean of null is NaN", isNan(stats.mean(null, 3)));
        pv("sum of nothing", stats.sum(one, 0));
        pv("median of one value", stats.median(one, 1));
        pv("median of two values", stats.median(two, 2));
        chk("mean with NaN is NaN", isNan(stats.mean(withNan, 4)));
        chk("variance with NaN is NaN", isNan(stats.variance(withNan, 4, 1)));
        chk("median with NaN is NaN", isNan(stats.median(withNan, 4)));
        chk("quantile with NaN is NaN", isNan(stats.quantile(withNan, 4, 0.5, 7)));
        chk("minimum with NaN is NaN", isNan(stats.minimum(withNan, 4)));
        chk("mode with NaN is NaN", isNan(stats.mode(withNan, 4)));
        chk("spearman with NaN is NaN", isNan(stats.spearman(withNan, withNan, 4)));
        double r4[4];
        printf("ranks with NaN: %d, ranks of nothing: %d\n", stats.ranks(withNan, 4, r4), stats.ranks(one, 0, r4));
        printfd("mean with infinity %g, max with infinity %g\n", __bits(stats.mean(withInf, 3)), __bits(stats.maximum(withInf, 3)));
        chk("mean of inf and -inf is NaN", isNan(stats.mean(both, 2)));
        chk("variance with infinity is NaN", isNan(stats.variance(withInf, 3, 1)));
        pv("constant data: variance", stats.variance(cst, 4, 1));
        chk("constant data: skewness is NaN", isNan(stats.skewness(cst, 4, true)));
        chk("constant data: kurtosis is NaN", isNan(stats.kurtosis(cst, 4, true, true)));
        chk("constant data: correlation is NaN", isNan(stats.correlation(cst, two, 2)));
        chk("unbiased skewness needs 3 values (NaN otherwise)", isNan(stats.skewness(two, 2, false)));
        chk("unbiased kurtosis needs 4 values (NaN otherwise)", isNan(stats.kurtosis(x, 3, false, true)));
        chk("quantile p = -0.1 is NaN", isNan(stats.quantile(x, 23, -0.1, 7)));
        chk("quantile p = 1.1 is NaN", isNan(stats.quantile(x, 23, 1.1, 7)));
        chk("quantile p = NaN is NaN", isNan(stats.quantile(x, 23, nan, 7)));
        chk("quantile method 0 is NaN", isNan(stats.quantile(x, 23, 0.5, 0)));
        chk("quantile method 10 is NaN", isNan(stats.quantile(x, 23, 0.5, 10)));
        pv("quantile of one value, every method", stats.quantile(one, 1, 0.3, 1) + stats.quantile(one, 1, 0.3, 6) + stats.quantile(one, 1, 0.3, 9));
        chk("geometric mean with a negative value is NaN", isNan(stats.geometricMean(withNan, 4)));
        double neg[2] = {-1.0, 4.0};
        chk("geometric mean of a negative value is NaN", isNan(stats.geometricMean(neg, 2)));
        double nw[2] = {1.0, -1.0};
        chk("negative weight is NaN", isNan(stats.weightedMean(two, nw, 2)));
        double cz[3];
        printf("zscores of constant data: %d\n", stats.zscores(cst, 4, cz, 0));
        matrix.Matrix e;
        matrix.Matrix ce = stats.covarianceMatrix(&e, 1);
        printf("covarianceMatrix of an empty matrix: ok %d err %d\n", ce.ok(), ce.err);
        matrix.Matrix one1(1, 2);
        matrix.Matrix c1 = stats.covarianceMatrix(&one1, 1);
        printf("covarianceMatrix with one observation (n - 1): ok %d err %d\n", c1.ok(), c1.err);
        one1.dispose();
    }
    // the sum is compensated: a million tiny values next to a big one
    {
        int n = 100001;
        double* a = (double*) asys.alloc(n * 8);
        a[0] = 1.0e16;
        for (int i = 1; i < n; i++) { a[i] = 1.0; }
        printfd("compensated sum of 1e16 and 100000 ones: %.17g (a plain sum gives 1e16)\n", __bits(stats.sum(a, n)));
        asys.free((char*) a);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
