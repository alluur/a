// the formats that are accepted after the colon of an interpolated string: flags, width, .precision, length, letter (in this order)
int main() {
    int x = 5;
    int n = -42;
    int ch = 65;
    println($"[{x:5}] [{x:-5}] [{x:05}] [{x:+}] [{x:#x}] [{x:#08x}] [{x:.3}] [{x:8.3}] [{x:-8.3}]");
    println($"[{x:lld}] [{x:hhd}] [{x:zu}] [{x:ld}] [{x:5ld}] [{x:-+5d}] [{x: 5}] [{x:+05d}] [{x:#o}]");
    println($"[{n:5}] [{n:-8}] [{n:08}] [{n:+}] [{n: d}] [{n:x}] [{n:.5}] [{n:10.5}] [{n:hhd}]");
    println($"[{x:.0}] [{0:.0}] [{x:b}] [{x:#b}] [{ch:c}] [{ch:3c}] [{ch:-3c}]");
    char* s = "text";
    println($"[{s:8}] [{s:-8}] [{s:.2}] [{s:8.2}] [{s:-8.2s}] [{s:s}]");
    println($"[{x:6.2f}] [{x:-8.1e}] [{x:+.3f}] [{x:08.2f}] [{x:#.0f}] [{x:g}] [{x:10g}] [{x:G}]");
    return 0;
}
