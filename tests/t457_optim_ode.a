// optim: ordinary differential equations: fixed step RK4 and the adaptive Dormand-Prince method (Rk45): accuracy against closed form solutions, error ratios, step control,
// output at given times, backward integration, blow-ups and invalid input. Expected output: tests/algo2_ref/gen_t457.py (closed forms in 60 digit decimals, RK4 on linear
// systems as exact matrix polynomials in fractions).
import cstdio;
import asys;
import optim;
import dmath;

struct Par { double k; double w; int calls; }

void decay(double t, double* y, double* d, int n, void* c) { d[0] = -y[0]; }
void decayK(double t, double* y, double* d, int n, void* c) { Par* p = (Par*) c; p->calls++; d[0] = -p->k * y[0]; }
void osc(double t, double* y, double* d, int n, void* c) { d[0] = y[1]; d[1] = -y[0]; }
void logistic(double t, double* y, double* d, int n, void* c) { d[0] = y[0] * (1.0 - y[0]); }
void stiff(double t, double* y, double* d, int n, void* c) { d[0] = -50.0 * (y[0] - dmath.cos(t)); }
void blowup(double t, double* y, double* d, int n, void* c) { d[0] = y[0] * y[0]; }
void nanRhs(double t, double* y, double* d, int n, void* c) { d[0] = (t > 0.5) ? dmath.nan() : 1.0; }
void lotka(double t, double* y, double* d, int n, void* c) {
    d[0] = 1.5 * y[0] - 1.0 * y[0] * y[1];
    d[1] = -3.0 * y[1] + 1.0 * y[0] * y[1];
}
void lorenz(double t, double* y, double* d, int n, void* c) {
    d[0] = 10.0 * (y[1] - y[0]);
    d[1] = y[0] * (28.0 - y[2]) - y[1];
    d[2] = y[0] * y[1] - 8.0 / 3.0 * y[2];
}
void forced(double t, double* y, double* d, int n, void* c) { d[0] = dmath.cos(t); }

double lotkaH(double* y) { return 1.0 * y[0] - 3.0 * dmath.log(y[0]) + 1.0 * y[1] - 1.5 * dmath.log(y[1]); }

int main() {
    int base = asys.memInUse();
    double y0[1] = {1.0};
    double out[1];
    // ---- fixed step RK4 on y' = -y
    for (int steps = 10; steps <= 40; steps *= 2) {
        optim.rk4(decay, null, 1, 0.0, y0, 1.0, steps, out, null);
        printfd("rk4 y' = -y, %d steps: y(1) = %.12g\n", steps, __bits(out[0]));
    }
    {
        double e1;
        double e2;
        double e3;
        optim.rk4(decay, null, 1, 0.0, y0, 1.0, 10, out, null);
        e1 = dmath.fabs(out[0] - dmath.exp(-1.0));
        optim.rk4(decay, null, 1, 0.0, y0, 1.0, 20, out, null);
        e2 = dmath.fabs(out[0] - dmath.exp(-1.0));
        optim.rk4(decay, null, 1, 0.0, y0, 1.0, 40, out, null);
        e3 = dmath.fabs(out[0] - dmath.exp(-1.0));
        printf("RK4 is of order 4: error ratios between 15 and 17: %d %d\n", e1 / e2 > 15.0 && e1 / e2 < 17.0, e2 / e3 > 15.0 && e2 / e3 < 17.0);
    }
    double yo2[2] = {1.0, 0.0};
    double fin2[2];
    double traj[22];
    optim.rk4(osc, null, 2, 0.0, yo2, 2.0, 10, fin2, traj);
    printfd("rk4 oscillator, 10 steps to t = 2: (%.12g, %.12g)\n", __bits(fin2[0]), __bits(fin2[1]));
    printf("trajectory rows 0, 5 and 10: ");
    printfd("(%.9g, %.9g) (%.9g, %.9g) (%.9g, %.9g)\n", __bits(traj[0]), __bits(traj[1]), __bits(traj[10]), __bits(traj[11]), __bits(traj[20]), __bits(traj[21]));
    printf("the last trajectory row is the result: %d, the start is kept: %d\n", traj[20] == fin2[0] && traj[21] == fin2[1], y0[0] == 1.0);
    optim.rk4(decay, null, 1, 0.0, y0, -1.0, 100, out, null);
    printfd("rk4 backwards to t = -1: %.9g (e = 2.71828183)\n", __bits(out[0]));
    printf("rk4 with the same array for input and output: ");
    double same[1] = {1.0};
    optim.rk4(decay, null, 1, 0.0, same, 1.0, 40, same, null);
    printfd("%.12g\n", __bits(same[0]));

    // ---- adaptive Dormand-Prince
    {
        optim.Rk45 s(decay, null, 1, 0.0, y0, 1.0e-10, 1.0e-12, 0.0);
        int st = s.solveTo(2.0, 10000);
        printfd("rk45 y' = -y to t = 2: status %d, t = %g\n", st, __bits(s.t));
        printfd("  y(2) = %.7g\n", __bits(s.y[0]));
        printf("  steps below 60: %d, rejected steps below 10: %d, function evaluations = 6 per step + 2 at the start (+ 6 per rejected step): %d\n", s.nsteps < 60, s.nrejected < 10, s.nfev == 2 + 6 * (s.nsteps + s.nrejected));
        printf("  the error is within a few times the tolerance: %d\n", dmath.fabs(s.y[0] - dmath.exp(-2.0)) < 1.0e-8);
        s.dispose();
        printf("after dispose: ok %d, step status %d\n", s.ok(), s.step(1.0));
    }
    {
        optim.Rk45 s(osc, null, 2, 0.0, yo2, 1.0e-10, 1.0e-12, 0.0);
        s.solveTo(10.0, 100000);
        printfd("rk45 oscillator at t = 10: (%.7g, %.7g)\n", __bits(s.y[0]), __bits(s.y[1]));
        // energy y0^2 + y1^2 stays 1
        printf("  energy conserved to 1e-8: %d\n", dmath.fabs(s.y[0] * s.y[0] + s.y[1] * s.y[1] - 1.0) < 1.0e-8);
        s.dispose();
    }
    {
        double yl[1] = {0.1};
        optim.Rk45 s(logistic, null, 1, 0.0, yl, 1.0e-10, 1.0e-12, 0.0);
        s.solveTo(10.0, 100000);
        printfd("rk45 logistic at t = 10: %.7g\n", __bits(s.y[0]));
        s.dispose();
        double ys[1] = {0.0};
        optim.Rk45 t(stiff, null, 1, 0.0, ys, 1.0e-9, 1.0e-12, 0.0);
        int st = t.solveTo(3.0, 100000);
        printfd("rk45 on y' = -50 (y - cos t) (stiff, but solvable) at t = 3: status %d, y = %.7g\n", st, __bits(t.y[0]));
        printf("  steps below 800: %d\n", t.nsteps < 800);
        t.dispose();
    }
    {
        double ya[1] = {1.0};
        optim.Rk45 s(decay, null, 1, 0.0, ya, 1.0e-9, 1.0e-12, 0.0);
        s.solveTo(-2.0, 10000);
        printfd("rk45 backwards to t = -2: %.7g (e^2 = 7.3890561)\n", __bits(s.y[0]));
        s.dispose();
        double yb[2] = {1.0, 0.0};
        optim.Rk45 o(osc, null, 2, 0.0, yb, 1.0e-9, 1.0e-12, 0.0);
        double times[4] = {0.5, 1.0, 2.0, 3.0};
        double res[8];
        int st = o.solveAt(times, 4, res, 10000);
        printfd("solveAt: status %d, t = %g\n", st, __bits(o.t));
        for (int i = 0; i < 4; i++) { printfd("  t = %g: (%.7g, %.7g)\n", __bits(times[i]), __bits(res[i * 2]), __bits(res[i * 2 + 1])); }
        o.dispose();
        // the output times need not be increasing in the integration direction only when they are consistent
        double yc[1] = {0.0};
        optim.Rk45 f(forced, null, 1, 0.0, yc, 1.0e-10, 1.0e-12, 0.0);
        f.solveTo(1.5, 1000);
        printfd("y' = cos t: y(1.5) = %.7g (sin 1.5 = 0.9974950)\n", __bits(f.y[0]));
        f.dispose();
    }
    {
        // a context carries a parameter
        Par p;
        p.k = 2.5;
        p.calls = 0;
        double yk[1] = {3.0};
        optim.Rk45 s(decayK, &p, 1, 0.0, yk, 1.0e-10, 1.0e-12, 0.0);
        s.solveTo(1.0, 10000);
        printfd("y' = -2.5 y, y(0) = 3 at t = 1: %.7g, calls equal nfev %d\n", __bits(s.y[0]), p.calls == s.nfev);
        s.dispose();
        // an initial step can be given; the result stays within the tolerance
        double yh[1] = {1.0};
        optim.Rk45 g(decay, null, 1, 0.0, yh, 1.0e-10, 1.0e-12, 0.001);
        g.solveTo(2.0, 100000);
        printfd("with an initial step of 0.001: y(2) = %.7g, within 1e-8: %d\n", __bits(g.y[0]), dmath.fabs(g.y[0] - dmath.exp(-2.0)) < 1.0e-8);
        g.dispose();
        // single steps: each step() advances time, never beyond the end
        double yz[1] = {1.0};
        optim.Rk45 z(decay, null, 1, 0.0, yz, 1.0e-8, 1.0e-10, 0.0);
        double last = 0.0;
        bool increasing = true;
        int count = 0;
        while (z.t < 1.0 && count < 1000) {
            int st = z.step(1.0);
            if (st != 0 || z.t <= last) { increasing = false; }
            last = z.t;
            count++;
        }
        printf("single steps: time increases every step %d, ends exactly at 1: %d, step() at the end does nothing: %d\n", increasing, z.t == 1.0, z.step(1.0));
        z.dispose();
        // looser tolerances need fewer steps
        double yt[1] = {1.0};
        optim.Rk45 loose(decay, null, 1, 0.0, yt, 1.0e-4, 1.0e-6, 0.0);
        loose.solveTo(2.0, 1000);
        double yt2[1] = {1.0};
        optim.Rk45 tight(decay, null, 1, 0.0, yt2, 1.0e-12, 1.0e-14, 0.0);
        tight.solveTo(2.0, 100000);
        printf("a loose tolerance uses fewer steps than a tight one: %d\n", loose.nsteps < tight.nsteps);
        loose.dispose();
        tight.dispose();
    }
    {
        // Lotka-Volterra: the quantity H = y0 - 3 ln y0 + y1 - 1.5 ln y1 is conserved by the exact solution
        double yv[2] = {2.0, 1.0};
        double h0 = lotkaH(yv);
        optim.Rk45 s(lotka, null, 2, 0.0, yv, 1.0e-11, 1.0e-13, 0.0);
        s.solveTo(20.0, 1000000);
        printf("Lotka-Volterra over 20 time units: the conserved quantity drifts by less than 1e-7: %d (steps %d)\n", dmath.fabs(lotkaH(s.y) - h0) < 1.0e-7, s.nsteps > 20);
        s.dispose();
        // Lorenz: against RK4 with a very small step (the solution is smooth for a short time)
        double yw[3] = {1.0, 1.0, 1.0};
        double ref[3];
        optim.rk4(lorenz, null, 3, 0.0, yw, 1.0, 20000, ref, null);
        optim.Rk45 l(lorenz, null, 3, 0.0, yw, 1.0e-11, 1.0e-13, 0.0);
        l.solveTo(1.0, 100000);
        double dev = dmath.fmax(dmath.fabs(l.y[0] - ref[0]), dmath.fmax(dmath.fabs(l.y[1] - ref[1]), dmath.fabs(l.y[2] - ref[2])));
        printf("Lorenz to t = 1 agrees with RK4 with 20000 steps within 1e-8: %d\n", dev < 1.0e-8);
        l.dispose();
    }

    // ---- failures
    {
        double yb[1] = {1.0};
        optim.Rk45 s(blowup, null, 1, 0.0, yb, 1.0e-8, 1.0e-10, 0.0);
        int st = s.solveTo(2.0, 100000);
        printf("y' = y^2 from 1 blows up at t = 1: status %d (not OK: %d), the time reached is below 1.0000001: %d\n", st, st != 0, s.t < 1.0000001);
        s.dispose();
        double yn[1] = {0.0};
        optim.Rk45 n(nanRhs, null, 1, 0.0, yn, 1.0e-8, 1.0e-10, 0.0);
        st = n.solveTo(2.0, 100000);
        printf("right hand side returning NaN after t = 0.5: status %d (ERR_NAN = %d)\n", st, optim.ERR_NAN);
        n.dispose();
        double yl[1] = {0.1};
        optim.Rk45 m(logistic, null, 1, 0.0, yl, 1.0e-10, 1.0e-12, 0.0);
        st = m.solveTo(10.0, 5);
        printf("maxSteps 5: status %d (ERR_NO_CONVERGE = %d), steps %d\n", st, optim.ERR_NO_CONVERGE, m.nsteps);
        m.dispose();
        double ye[1] = {1.0};
        optim.Rk45 a(decay, null, 0, 0.0, ye, 1.0e-8, 1.0e-10, 0.0);
        optim.Rk45 b(decay, null, 1, 0.0, null, 1.0e-8, 1.0e-10, 0.0);
        optim.Rk45 c(decay, null, 1, 0.0, ye, 0.0, 1.0e-10, 0.0);
        optim.Rk45 d(decay, null, 1, 0.0, ye, 1.0e-8, -1.0, 0.0);
        optim.Rk45 e(decay, null, 1, dmath.nan(), ye, 1.0e-8, 1.0e-10, 0.0);
        optim.Rk45 f(null, null, 1, 0.0, ye, 1.0e-8, 1.0e-10, 0.0);
        double ynan[1] = {dmath.nan()};
        optim.Rk45 g(decay, null, 1, 0.0, ynan, 1.0e-8, 1.0e-10, 0.0);
        optim.Rk45 h(decay, null, 1, 0.0, ye, 1.0e-8, 1.0e-10, -1.0);
        printf("invalid arguments: n = 0 %d, null y0 %d, rtol 0 %d, atol < 0 %d, NaN time %d, null function %d, NaN state %d, negative step %d\n", a.err, b.err, c.err, d.err, e.err, f.err, g.err, h.err);
        printf("  (ERR_ARG = %d, ERR_NAN = %d)\n", optim.ERR_ARG, optim.ERR_NAN);
        double yq[1] = {1.0};
        optim.Rk45 q(decay, null, 1, 0.0, yq, 1.0e-8, 1.0e-10, 0.0);
        printf("tEnd = NaN: %d; solveTo the current time: %d; solveAt with null: %d, with count 0: %d\n", q.step(dmath.nan()), q.solveTo(0.0, 10), q.solveAt(null, 1, out, 10), q.solveAt(out, 0, out, 10));
        q.dispose();
        printf("rk4 invalid: n = 0 %d, steps 0 %d, null %d, NaN time %d (ERR_ARG = %d)\n", optim.rk4(decay, null, 0, 0.0, y0, 1.0, 10, out, null), optim.rk4(decay, null, 1, 0.0, y0, 1.0, 0, out, null),
               optim.rk4(decay, null, 1, 0.0, null, 1.0, 10, out, null), optim.rk4(decay, null, 1, dmath.nan(), y0, 1.0, 10, out, null), optim.ERR_ARG);
        printf("rk4 on a blow-up reports a non finite result: %d (ERR_NAN = %d)\n", optim.rk4(blowup, null, 1, 0.0, y0, 5.0, 10, out, null), optim.ERR_NAN);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
