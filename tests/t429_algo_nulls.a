// ds, strx and rng: null pointers, negative and absurd arguments and empty containers give 0, -1, false or null, never a crash
import cstdio;
import strx;
import ds;
import rng;

int main() {
    printf("%d %d %d\n", strx.fuzzyScore(null, "abc"), strx.fuzzyScore("a", null), strx.fuzzyScore(null, null));
    printf("%d %d\n", strx.levenshtein(null, -1, null, -1), strx.levenshteinMax(null, 5, "ab", 0, 3));
    printf("%d %d %d\n", strx.longestCommonSubstring(null, -1, null, -1), strx.lcsLength(null, -1, null, -1), strx.hamming(null, -1, null, -1));
    strx.SuffixArray sa(null, -1);
    printf("%d %d\n", sa.size(), sa.count("a"));
    strx.AhoCorasick ac;
    printf("%d %d\n", ac.add(null), ac.count(null));
    strx.LineDiff d;
    d.run(null, 0, null, 0);
    char* u = d.unified("a", "b");
    printf("[%s] %d\n", u, d.opCount());
    printf("%d %d\n", strx.globMatch(null, "a"), strx.naturalCompare("", ""));
    printf("%d\n", strx.jaro(null, -1, null, -1) == 1.0);
    printf("%d %d\n", strx.countPalindromes(null, -1), strx.longestPalindrome(null, -1, null));
    rng.Rng r;
    int a[4] = {1, 2, 3, 4};
    r.shuffle(null, 0);
    r.shuffle(&a[0], -5);
    printf("%d %d %d\n", r.below(-3), r.sample(3, 5, &a[0]), r.weighted(null, 0));
    ds.Deque dq(-5);
    printf("%d\n", dq.pushBack(1));
    ds.OrderedMap m;
    printf("%d %d %d\n", m.firstNode(), m.select(5), m.rank(5));
    // a null text is empty whatever the length says
    printf("%d %d %d\n", strx.indexOf(null, "a", 0, 7, -1), strx.countOf(null, null, true, 9, 9), strx.hamming(null, 4, null, 4));
    // negative lengths other than -1 behave like -1 (up to the 0)
    printf("%d %d\n", strx.levenshtein("abc", -7, "abd", -9), strx.indexOf("hello", "ll", 0, -3, -4));
    ds.HashMap h;
    printf("%d %d %d %d\n", h.get(1, -1), h.remove(1), h.first(), h.size());
    ds.BinaryHeap hp;
    printf("%d %d %d %d\n", hp.pop(), hp.peekHandle(), hp.update(5, 1), hp.remove(-1));
    ds.Trie t;
    printf("%d %d %d\n", t.get("x", -2), t.countPrefix(""), t.countWildcard("*"));
    ds.BitSet b(10);
    printf("%d %d %d\n", b.get(-1), b.get(10), b.nextSet(100));
    ds.Fenwick f(4);
    printf("%d %d\n", f.prefix(-1), f.sum(3, 1));
    return 0;
}
