// tscreen: drawing primitives - boxes, lines, fills, clipping, restyling, shadows, blits - checked as plain text and as styles
import tscreen;

void show(tscreen.Screen* s) { println(s->dump()); }

int main() {
    tscreen.Screen s(30, 12);
    println("-- the four border kinds");
    s.clear(0);
    s.box(0, 0, 8, 3, tscreen.BOX_SINGLE, 0);
    s.box(9, 0, 8, 3, tscreen.BOX_DOUBLE, 0);
    s.box(18, 0, 8, 3, tscreen.BOX_ROUND, 0);
    s.box(0, 4, 8, 3, tscreen.BOX_HEAVY, 0);
    s.box(9, 4, 2, 2, tscreen.BOX_SINGLE, 0);
    s.box(12, 4, 1, 3, tscreen.BOX_SINGLE, 0);
    s.box(14, 4, 3, 3, tscreen.BOX_NONE, 0);
    show(&s);

    println("-- fill, lines and a panel with a title");
    s.clear(0);
    s.fill(1, 1, 5, 2, '#', 0);
    s.hline(8, 1, 6, 0x2500, 0);
    s.vline(15, 0, 4, 0x2502, 0);
    s.panel(17, 1, 10, 4, tscreen.BOX_SINGLE, 0);
    s.text(19, 1, " Title ", 0);
    s.text(18, 2, "inside", 0);
    show(&s);

    println("-- clipping");
    s.clear(0);
    s.pushClip(2, 2, 6, 3);
    s.fill(0, 0, 30, 12, '.', 0);
    s.pushClip(4, 3, 10, 10);              // intersected with the outer clip
    s.fill(0, 0, 30, 12, 'X', 0);
    s.popClip();
    s.text(0, 4, "abcdefghijklmnop", 0);
    s.popClip();
    s.text(9, 8, "outside the clip again", 0);
    printlnInt(s.visible(3, 3) ? 1 : 0);
    show(&s);
    s.pushClip(5, 5, 0, 0);
    s.text(5, 5, "gone", 0);
    s.popClip();
    println(s.runeAt(5, 5) == ' ' ? "empty clip draws nothing" : "drawn");

    println("-- styles: restyle, attrs, COL_KEEP, shadow");
    s.clear(tscreen.style(tscreen.WHITE, tscreen.BLUE, 0));
    s.text(2, 1, "keep", tscreen.style(tscreen.YELLOW, tscreen.COL_KEEP, tscreen.A_BOLD));
    s.text(2, 2, "own", tscreen.style(tscreen.YELLOW, tscreen.RED, 0));
    printf("%x %x\n", tscreen.bgOf(s.styleAt(2, 1)), tscreen.bgOf(s.styleAt(2, 2)));
    printf("%x\n", tscreen.fgOf(s.styleAt(2, 1)));
    s.attrs(2, 1, 4, 1, tscreen.A_UNDERLINE, tscreen.A_BOLD);
    printf("attr %d\n", tscreen.attrOf(s.styleAt(3, 1)));
    s.restyle(2, 2, 3, 1, tscreen.style(tscreen.GREEN, tscreen.COL_KEEP, 0));
    printf("%x %x %c\n", tscreen.fgOf(s.styleAt(2, 2)), tscreen.bgOf(s.styleAt(2, 2)), s.runeAt(2, 2));
    s.shadow(10, 1, 3, 2);
    printf("%x %x %c\n", tscreen.fgOf(s.styleAt(10, 1)), tscreen.bgOf(s.styleAt(10, 1)), s.runeAt(10, 1));

    println("-- blit of one screen into another");
    tscreen.Screen small(6, 2);
    small.clear(0);
    small.text(0, 0, "ab\xe4\xb8\x96", 0);
    small.text(0, 1, "e\xcc\x81z", 0);
    s.clear(0);
    s.blit(&small, 3, 3);
    s.blit(&small, 28, 10);
    show(&s);

    println("-- the cursor and the size");
    s.setCursor(4, 5, 2);
    printf("%d %d %d %d\n", s.curShow, s.curX, s.curY, s.curShape);
    s.hideCursor();
    printf("%d\n", s.curShow);
    s.resize(10, 3);
    printf("%d x %d\n", s.w, s.h);
    s.text(0, 0, "resized", 0);
    show(&s);
    println("-- resize reuses the arrays while the size fits (alloc never frees), and the screen is blank afterwards");
    tscreen.Screen r(100, 50);
    int* first = r.ch;
    r.text(0, 0, "dirty", 7);
    r.resize(60, 30);
    printf("smaller: same arrays %d, blank %d\n", r.ch == first, r.runeAt(0, 0) == ' ');
    r.text(0, 0, "dirty", 7);
    r.resize(100, 50);
    printf("back: same arrays %d, blank %d style %d\n", r.ch == first, r.runeAt(0, 0) == ' ', r.styleAt(1, 0));
    r.resize(100, 51);
    int* bigger = r.ch;
    printf("bigger: new arrays %d\n", bigger != first);
    int moved = 0;
    for (int i = 0; i < 200; i++) {
        r.resize(80 + (i % 25), 40 + (i % 13));
        if (r.ch != bigger) { moved++; }
    }
    printf("200 resizes inside: arrays moved %d times\n", moved);
    r.resize(0, 0);
    printf("%d x %d\n", r.w, r.h);
    println("-- reading cells outside the screen is harmless");
    printf("%d %d\n", s.runeAt(-1, 0), s.runeAt(10, 3));
    return 0;
}
