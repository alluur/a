// ||=  &&=  ??= : the target is evaluated once, the right side only when it is needed
enum Mode { Off, On = 4 }
struct S { int a; bool flag; char* name; uint8 small; int8 neg; Mode mode; }

int calls;
int f(int v) { calls++; return v; }
int idx;
int next() { idx++; return idx - 1; }
int cell;
int* where() { calls++; return &cell; }
S gs;
int garr[3];

int main() {
    int a = 0;
    a ||= 5;  printlnInt(a);
    a ||= f(9); printlnInt(a); printlnInt(calls);       // 5, f not called
    a &&= 7; printlnInt(a);
    a = 0;
    a &&= f(100); printlnInt(a); printlnInt(calls);     // 0, f not called
    int b = 0;
    b ??= 3; printlnInt(b);
    b ??= f(4); printlnInt(b); printlnInt(calls);
    bool t = false;
    t ||= f(5); printlnInt(t);                           // a bool target holds 0 or 1
    t &&= f(0); printlnInt(t);
    printlnInt(calls);
    char* p = null;
    p ??= "default"; println(p);
    p ??= "other"; println(p);
    p &&= "replaced"; println(p);
    p = null;
    p &&= "never"; printlnInt(p == null);

    // the address of the target is computed exactly once
    int arr[4] = {0, 3, 0, 0};
    idx = 0;
    arr[next()] ||= 11; arr[next()] ||= 12; arr[next()] &&= 13; arr[next()] ??= 14;
    foreach (int v in arr) { printInt(v); print(" "); }
    println("");
    printlnInt(idx);
    calls = 0;
    *where() ||= 21; *where() ||= 22; *where() &&= 23;
    printlnInt(cell); printlnInt(calls);

    // fields, through pointers, globals, narrow types, enums
    S s;
    s.a ||= 8; s.flag ||= 3; s.name ??= "n"; s.small ||= 300; s.neg ||= 200; s.mode ??= Mode.On;
    printlnInt(s.a); printlnInt(s.flag); println(s.name); printlnInt(s.small); printlnInt(s.neg); printlnInt(s.mode);
    S* sp = &s;
    sp->a &&= 2; sp->small &&= 77; sp->neg &&= -5; sp->mode &&= Mode.Off;
    printlnInt(sp->a); printlnInt(sp->small); printlnInt(sp->neg); printlnInt(sp->mode);
    gs.a ||= 6; gs.name ??= "g"; garr[1] ||= 9; garr[1] &&= garr[1] + 1;
    printlnInt(gs.a); println(gs.name); printlnInt(garr[0] + garr[1] * 10 + garr[2] * 100);
    int* ip = &a;
    *ip ||= 42; printlnInt(a);

    // the value of the expression is the target after the statement; they nest and chain
    int x = (a ||= 1) + 1; printlnInt(x);
    int c = 0; c ||= c ||= 6; printlnInt(c);
    int d = 1; d &&= d &&= 0; printlnInt(d);
    uint8 u = 0; u ||= 256 + 5; printlnInt(u);
    int e = 0;
    if (e ||= 3) { println("then"); }
    if (!(e &&= 0)) { println("zero"); }
    // in loops and with a right side that has effects
    int n = 0;
    int hits = 0;
    foreach (int i in 0..5) { n ||= f(i + 10); hits += n; }
    printlnInt(n); printlnInt(hits);
    int lazy = 0;
    foreach (int i in 0..4) { lazy ??= i * 2; }
    printlnInt(lazy);
    calls = 0;
    int z = 0;
    z ||= 0; z ||= f(0); z ||= f(0);
    printlnInt(z); printlnInt(calls);
    return 0;
}
