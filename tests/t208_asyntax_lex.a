// asyntax: the lexers on samples of every language (token kind and text per line, the lexer state at every line start),
// language detection, token coverage invariants
import asyntax;
import acode;
import asys;

int checks;
int fails;

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

// prints every non-Plain token of a line as Kind(text)
void dump(int lang, int* state, char* line) {
    asyntax.Token tk[128];
    int es = 0;
    int len = strlen(line);
    int n = asyntax.lexLine(lang, *state, line, len, &tk[0], 128, &es);
    printf("[%d]", *state);
    int covered = 0;
    bool gapless = true;
    for (int i = 0; i < n; i++) {
        if (tk[i].start != covered || tk[i].len <= 0) { gapless = false; }
        covered = tk[i].start + tk[i].len;
        if (tk[i].kind != asyntax.Tok.Plain) {
            char buf[160];
            int l = tk[i].len;
            if (l > 150) { l = 150; }
            memcpy(&buf[0], &line[tk[i].start], l);
            buf[l] = 0;
            printf(" %s(%s)", asyntax.Tok.name(tk[i].kind), &buf[0]);
        }
    }
    println("");
    check(gapless && covered == len, "tokens cover the line without gaps");
    *state = es;
}

void lang(char* title, int language, char** lines, int n) {
    printf("== %s\n", title);
    int state = 0;
    for (int i = 0; i < n; i++) {
        dump(language, &state, lines[i]);
    }
    printf("[end %d]\n", state);
}

int main() {
    {
        char* l[12];
        l[0] = "#include <stdio.h>";
        l[1] = "/* block";
        l[2] = "   comment */ int x = 0x1F;";
        l[3] = "static const char* s = \"a\\n\\x41 \\\\ q\"; // tail";
        l[4] = "char c = 'x'; char d = '\\n';";
        l[5] = "#define MAX(a, b) \\";
        l[6] = "    ((a) > (b) ? (a) : (b))";
        l[7] = "int main(int argc, char** argv) { return printf(\"%d\", 1u + 2UL + 3.5e-2f); }";
        l[8] = "/** doc */ /// line doc";
        l[9] = "x <<= 2; y = a->b && c; z = a <=> b; unsigned long long q = 1'000;";
        l[10] = "";
        l[11] = "  \t  ";
        lang("C", asyntax.Lang.C, l, 12);
    }
    {
        char* l[10];
        l[0] = "import gui;";
        l[1] = "module demo;";
        l[2] = "const MAX = 100;  // limit";
        l[3] = "class Account : Base {";
        l[4] = "    public int balance;";
        l[5] = "    public Account(int b) { balance = b; super(); }";
        l[6] = "    private int a[3] = {1, 0b101, 0xFF_FF, 1_000_000};";
        l[7] = "    bool ok = true && x != null; double d = 1.5; uint8 b = 300;";
        l[8] = "    println(\"hi\\t\" \"there\"); __write(1, \"x\", 1);";
        l[9] = "}";
        lang("A", asyntax.Lang.A, l, 10);
    }
    {
        char* l[8];
        l[0] = "template <typename T> class Foo : public Bar<T> {";
        l[1] = "  std::vector<int> v; auto p = nullptr; // c++";
        l[2] = "  R\"(raw)\"; int x = 0b1010'1010;";
        l[3] = "  virtual void f() override { throw 1; }";
        l[4] = "};";
        l[5] = "#ifdef FOO";
        l[6] = "#  include \"foo.h\"";
        l[7] = "#endif";
        lang("C++", asyntax.Lang.Cpp, l, 8);
    }
    {
        char* l[12];
        l[0] = "#!/usr/bin/env python3";
        l[1] = "@decorator(1)";
        l[2] = "def hello(name, *args, **kw):";
        l[3] = "    \"\"\"Docstring with 'quotes'";
        l[4] = "    continues here\"\"\" + 'x'";
        l[5] = "    s = f\"{name}\\n\" + r'raw\\n' + b'bytes'";
        l[6] = "    return len(s) if s else None  # comment";
        l[7] = "class Foo(Base):";
        l[8] = "    x = 0x_ff + 1_000 + 3.14e10 + 2j";
        l[9] = "    t = '''multi";
        l[10] = "line''' ; True and False";
        l[11] = "async def g(): await x";
        lang("Python", asyntax.Lang.Python, l, 12);
    }
    {
        char* l[12];
        l[0] = "#!/bin/bash";
        l[1] = "# a comment";
        l[2] = "NAME=\"world $USER ${HOME}\"";
        l[3] = "if [ -f \"$1\" ]; then echo 'single' $(date) `x`; fi";
        l[4] = "cat <<EOF";
        l[5] = "here $document # not a comment";
        l[6] = "EOF";
        l[7] = "for i in 1 2 3; do echo $i; done | wc -l > out.txt 2>&1";
        l[8] = "echo \"multi";
        l[9] = "line\" && exit 0";
        l[10] = "function f() { local x=1; return $?; }";
        l[11] = "cat <<-'END'";
        lang("Shell", asyntax.Lang.Shell, l, 12);
    }
    {
        char* l[9];
        l[0] = "{";
        l[1] = "  \"name\": \"A \\\"quoted\\\" \\u00e9\",";
        l[2] = "  \"n\": -12.5e+3, \"ok\": true, \"no\": false, \"nil\": null,";
        l[3] = "  \"list\": [1, 2, {\"k\": \"v\"}],";
        l[4] = "  // comment";
        l[5] = "  /* block";
        l[6] = "  still */ \"x\": bad";
        l[7] = "}";
        l[8] = "";
        lang("JSON", asyntax.Lang.Json, l, 9);
    }
    {
        char* l[14];
        l[0] = "# Title";
        l[1] = "Some *emphasis*, **strong**, `code` and [a link](http://x.org/a_b).";
        l[2] = "- item one";
        l[3] = "  1. numbered \\* escaped";
        l[4] = "> quoted text";
        l[5] = "```c";
        l[6] = "int x = 1; # not a heading";
        l[7] = "```";
        l[8] = "after the fence https://example.com/path now";
        l[9] = "<!-- a comment";
        l[10] = "still comment --> <b>bold</b>";
        l[11] = "---";
        l[12] = "| a | b |";
        l[13] = "snake_case_word and 2 * 3 * 4";
        lang("Markdown", asyntax.Lang.Markdown, l, 14);
    }
    {
        char* l[9];
        l[0] = "; comment";
        l[1] = "[section one]";
        l[2] = "key = value # trailing";
        l[3] = "number=42";
        l[4] = "flag: yes";
        l[5] = "name = \"quoted ; not a comment\"";
        l[6] = "   indented = 'single'";
        l[7] = "no equals sign here";
        l[8] = "path=/usr/bin  ; comment";
        lang("INI", asyntax.Lang.Ini, l, 9);
    }
    {
        char* l[10];
        l[0] = "# toml";
        l[1] = "[package]";
        l[2] = "name = \"aide\"";
        l[3] = "version = 1.0";
        l[4] = "date = 1979-05-27T07:32:00Z";
        l[5] = "[[bin]]";
        l[6] = "text = \"\"\"multi";
        l[7] = "line\"\"\" # after";
        l[8] = "list = [1, 2, \"three\", true]";
        l[9] = "inline = { a = 1, b = false }";
        lang("TOML", asyntax.Lang.Toml, l, 10);
    }
    {
        char* l[12];
        l[0] = "<!DOCTYPE html>";
        l[1] = "<html lang=\"en\"><head><title>T &amp; U</title>";
        l[2] = "<!-- comment";
        l[3] = "--> <script type='text/javascript'>";
        l[4] = "var x = 1 < 2; // not <b>tags</b>";
        l[5] = "</script><style>";
        l[6] = "p { color: red; }";
        l[7] = "</style><p class=\"a";
        l[8] = "b\" id=x>text</p>";
        l[9] = "<img src=\"a.png\" />";
        l[10] = "<![CDATA[ x ]]> <?php echo 1; ?>";
        l[11] = "</body>";
        lang("HTML", asyntax.Lang.Html, l, 12);
    }
    {
        char* l[5];
        l[0] = "<?xml version=\"1.0\"?>";
        l[1] = "<root xmlns:a=\"u\"><a:item id=\"1\">text &#65; &lt;</a:item>";
        l[2] = "<script>not special in xml</script>";
        l[3] = "<!-- c --><empty/>";
        l[4] = "</root>";
        lang("XML", asyntax.Lang.Xml, l, 5);
    }
    {
        char* l[14];
        l[0] = "# Makefile";
        l[1] = "CC ?= gcc";
        l[2] = "OBJS := a.o b.o $(EXTRA)";
        l[3] = ".PHONY: all clean";
        l[4] = "all: build/ac $(OBJS)";
        l[5] = "build/ac: $(SRC) src/defs.inc";
        l[6] = "\t@mkdir -p build";
        l[7] = "\t$(CC) -o $@ $^ # compile";
        l[8] = "ifdef DEBUG";
        l[9] = "  CFLAGS += -g";
        l[10] = "endif";
        l[11] = "define RULE";
        l[12] = "$(1): $(2)";
        l[13] = "endef";
        lang("Makefile", asyntax.Lang.Makefile, l, 14);
    }
    {
        char* l[3];
        l[0] = "Just some text with \"quotes\" and 123.";
        l[1] = "  # not a comment";
        l[2] = "";
        lang("Text", asyntax.Lang.Text, l, 3);
    }
    // ---- language detection
    check(asyntax.detectLanguage("main.a", null) == asyntax.Lang.A, "main.a is A");
    check(asyntax.detectLanguage("lib/regex.a", null) == asyntax.Lang.A, "a path");
    check(asyntax.detectLanguage("shapes.am", null) == asyntax.Lang.A, ".am is A");
    check(asyntax.detectLanguage("x.c", null) == asyntax.Lang.C && asyntax.detectLanguage("x.H", null) == asyntax.Lang.C, "C (case insensitive)");
    check(asyntax.detectLanguage("x.cpp", null) == asyntax.Lang.Cpp && asyntax.detectLanguage("x.hpp", null) == asyntax.Lang.Cpp, "C++");
    check(asyntax.detectLanguage("a.py", null) == asyntax.Lang.Python, "Python");
    check(asyntax.detectLanguage("run.sh", null) == asyntax.Lang.Shell && asyntax.detectLanguage(".bashrc", null) == asyntax.Lang.Shell, "shell");
    check(asyntax.detectLanguage("d.json", null) == asyntax.Lang.Json, "JSON");
    check(asyntax.detectLanguage("README.md", null) == asyntax.Lang.Markdown, "Markdown");
    check(asyntax.detectLanguage("a.ini", null) == asyntax.Lang.Ini && asyntax.detectLanguage("x.conf", null) == asyntax.Lang.Ini, "INI");
    check(asyntax.detectLanguage("Cargo.toml", null) == asyntax.Lang.Toml, "TOML");
    check(asyntax.detectLanguage("i.html", null) == asyntax.Lang.Html && asyntax.detectLanguage("i.htm", null) == asyntax.Lang.Html, "HTML");
    check(asyntax.detectLanguage("i.xml", null) == asyntax.Lang.Xml && asyntax.detectLanguage("i.svg", null) == asyntax.Lang.Xml, "XML");
    check(asyntax.detectLanguage("Makefile", null) == asyntax.Lang.Makefile && asyntax.detectLanguage("sub/makefile", null) == asyntax.Lang.Makefile && asyntax.detectLanguage("rules.mk", null) == asyntax.Lang.Makefile, "Makefile");
    check(asyntax.detectLanguage("notes.txt", null) == asyntax.Lang.Text && asyntax.detectLanguage("noext", null) == asyntax.Lang.Text, "text");
    check(asyntax.detectLanguage("script", "#!/bin/sh") == asyntax.Lang.Shell, "shebang sh");
    check(asyntax.detectLanguage("script", "#!/usr/bin/env python3") == asyntax.Lang.Python, "shebang python");
    check(asyntax.detectLanguage("tool", "#!/usr/bin/env bash -e") == asyntax.Lang.Shell, "shebang bash");
    check(asyntax.detectLanguage("data", "<?xml version=\"1.0\"?>") == asyntax.Lang.Xml, "xml declaration");
    check(asyntax.detectLanguage("a.py", "#!/bin/sh") == asyntax.Lang.Python, "the extension wins over the shebang");
    check(asyntax.detectLanguage(null, "#!/bin/sh") == asyntax.Lang.Shell, "no name, shebang only");
    check(asyntax.languageFromName("python") == asyntax.Lang.Python && asyntax.languageFromName("sh") == asyntax.Lang.Shell && asyntax.languageFromName("nonsense") == asyntax.Lang.Text, "language names");
    for (int l = 0; l < asyntax.Lang.count; l++) {
        check(asyntax.languageFromName(asyntax.languageName(l)) == l, "every language name maps back");
    }
    // ---- long lines and tiny token tables never overflow
    {
        char* big = asys.alloc(20001);
        for (int i = 0; i < 20000; i++) { big[i] = (i % 3 == 0) ? '(' : ((i % 3 == 1) ? 'a' : '1'); }
        asyntax.Token small[4];
        int es = 0;
        int n = asyntax.lexLine(asyntax.Lang.C, 0, big, 20000, &small[0], 4, &es);
        int cover = 0;
        for (int i = 0; i < n; i++) { cover = cover + small[i].len; }
        check(n <= 4 && cover == 20000, "a 4 slot token table still covers a 20000 byte line");
        n = asyntax.lexLine(asyntax.Lang.Python, 0, big, 20000, &small[0], 2, &es);
        cover = 0;
        for (int i = 0; i < n; i++) { cover = cover + small[i].len; }
        check(n <= 2 && cover == 20000, "even with two slots");
        asys.free(big);
    }
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
