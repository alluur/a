import regex;
import utf8;

void t(char* pat, char* text) {
    int len = 0;
    int at = regex.search(pat, text, &len);
    printBool(regex.matches(pat, text)); print(" ");
    printInt(at); print(" "); printInt(len); print("  "); print(pat); print(" ~ "); println(text);
}

int main() {
    t("abc", "xxabcxx"); t("^abc", "abcd"); t("^abc", "xabc"); t("abc$", "xxabc"); t("abc$", "abcx");
    t("a.c", "a-c"); t("a*", "aaab"); t("a+b", "caaab"); t("ab?c", "ac"); t("ab?c", "abc"); t("ab?c", "abbc");
    t("[0-9]+", "abc123def"); t("[^0-9]+", "abc123def"); t("[a-c]x", "zbx"); t("\\d+\\.\\d+", "pi=3.14!"); t("\\w+@\\w+\\.com", "mail bob@site.com now");
    t("\\s+", "a   b"); t("x*", "yyy"); t(".*", "anything"); t("^$", ""); t("a.*z", "a1z2z3"); t("colou?r", "my color"); t("[abc-]+", "a-b-c");
    t("^[A-Z][a-z]*$", "Hello"); t("^[A-Z][a-z]*$", "hello"); t("\\.txt$", "notes.txt"); t("[\\d]+", "ab42");
    println(regex.replaceAll("[0-9]+", "a1b22c333", "#")); println(regex.replaceAll("\\s+", "a  b   c", " ")); println(regex.replaceAll("x*", "abc", "-"));
    println(regex.replaceAll("o", "foo boo", "00")); println(regex.replaceAll("^a", "aaa", "b")); println(regex.replaceAll("z", "none", "q"));
    printBool(regex.test("[0-9]", "abc1")); printBool(regex.test("[0-9]", "abc")); println("");

    // utf8
    char* s = "héllo €uro 😀!";
    printlnInt(strlen(s)); printlnInt(utf8.length(s)); printBool(utf8.isValid(s)); println("");
    int cp;
    int used = utf8.decode(s, 1, &cp); printlnInt(cp); printlnInt(used);
    printlnInt(utf8.byteOffset(s, 7));
    int cps[32]; int n = utf8.toCodepoints(s, cps, 32);
    printlnInt(n); printlnInt(cps[1]); printlnInt(cps[6]); printlnInt(cps[11]);
    println(utf8.fromCodepoints(cps, n)); println(utf8.reverse("añb€c"));
    char buf[8];
    printlnInt(utf8.encode(0x41, buf)); printlnInt(utf8.encode(0xE9, buf)); printlnInt(utf8.encode(0x20AC, buf)); printlnInt(utf8.encode(0x1F600, buf));
    printBool(utf8.isValid("ok")); printBool(utf8.isValid("bad\xff")); printBool(utf8.isValid("\xc3")); println("");
    return 0;
}
