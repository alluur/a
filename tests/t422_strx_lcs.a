// strx: longest common subsequence (length and text), longest common substring against brute force
import cstdio;
import cstring;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 31337;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void randText(char* buf, int len, int alpha) {
    for (int i = 0; i < len; i++) { buf[i] = 'a' + rnd(alpha); }
    buf[len] = 0;
}

int refLcs(char* a, int na, char* b, int nb) {
    int d[4000];
    int w = nb + 1;
    for (int i = 0; i <= na; i++) { d[i * w] = 0; }
    for (int j = 0; j <= nb; j++) { d[j] = 0; }
    for (int i = 1; i <= na; i++) {
        for (int j = 1; j <= nb; j++) {
            if (a[i - 1] == b[j - 1]) { d[i * w + j] = d[(i - 1) * w + j - 1] + 1; }
            else { d[i * w + j] = (d[(i - 1) * w + j] > d[i * w + j - 1]) ? d[(i - 1) * w + j] : d[i * w + j - 1]; }
        }
    }
    return d[na * w + nb];
}

bool isSubsequence(char* small, int ns, char* big, int nb) {
    int i = 0;
    for (int j = 0; j < nb && i < ns; j++) { if (small[i] == big[j]) { i++; } }
    return i == ns;
}

void subsequences() {
    char a[60];
    char b[60];
    int bad = 0;
    int badText = 0;
    for (int round = 0; round < 600; round++) {
        int na = rnd(40);
        int nb = rnd(40);
        int alpha = 1 + rnd(4);
        randText(&a[0], na, alpha);
        randText(&b[0], nb, alpha);
        int want = refLcs(&a[0], na, &b[0], nb);
        if (strx.lcsLength(&a[0], na, &b[0], nb) != want) { bad++; }
        int len = -5;
        char* l = strx.lcs(&a[0], na, &b[0], nb, &len);
        if (l == null || len != want || (int) strlen(l) != want || !isSubsequence(l, want, &a[0], na) || !isSubsequence(l, want, &b[0], nb)) { badText++; }
        strx.freeText(l);
    }
    check(bad == 0, "lcsLength agrees with the full table (600 random pairs)");
    check(badText == 0, "lcs returns a common subsequence of the right length (Hirschberg)");
    int len = 0;
    char* l = strx.lcs("AGGTAB", -1, "GXTXAYB", -1, &len);
    check(strcmp(l, "GTAB") == 0 && len == 4, "GTAB");
    strx.freeText(l);
    l = strx.lcs("", -1, "abc", -1, &len);
    check(strcmp(l, "") == 0 && len == 0, "empty input gives an empty text");
    strx.freeText(l);
    l = strx.lcs("abc", -1, "xyz", -1);
    check(strcmp(l, "") == 0, "nothing in common");
    strx.freeText(l);
    l = strx.lcs("abcabc", 3, "abcabc", -1, &len);
    check(strcmp(l, "abc") == 0 && len == 3, "explicit length");
    strx.freeText(l);
    check(strx.lcsLength("", -1, "", -1) == 0 && strx.lcsLength("abc", -1, "abc", -1) == 3 && strx.lcsLength("abcdef", -1, "acf", -1) == 3, "lcsLength basics");
    // UTF-8: the common subsequence is made of whole code points
    l = strx.lcs("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e", -1, "\xe6\x9c\xac\xe8\xaa\x9e\xe6\x97\xa5", -1, &len, true);
    check(len == 6 && strcmp(l, "\xe6\x9c\xac\xe8\xaa\x9e") == 0, "utf8 lcs keeps whole characters");
    strx.freeText(l);
    check(strx.lcsLength("\xe6\x97\xa5\xe6\x9c\xac", -1, "\xe6\x97\xa6\xe6\x9c\xac", -1, true) == 1 && strx.lcsLength("\xe6\x97\xa5\xe6\x9c\xac", -1, "\xe6\x97\xa6\xe6\x9c\xac", -1) == 5, "utf8 versus byte length");
    // bigger: 3000 x 3000 stays quick; and the sum of lengths is exact for a shuffled copy
    int n = 3000;
    char* x = alloc(n + 1);
    char* y = alloc(n + 1);
    for (int i = 0; i < n; i++) { x[i] = 'a' + rnd(4); y[i] = x[i]; }
    for (int e = 0; e < 100; e++) { y[rnd(n)] = 'a' + rnd(4); }
    int ll = strx.lcsLength(x, n, y, n);
    int hl = 0;
    char* hs = strx.lcs(x, n, y, n, &hl);
    check(ll == hl && ll >= n - 100 && isSubsequence(hs, hl, x, n) && isSubsequence(hs, hl, y, n), "3000 letter texts: lcsLength == length of lcs");
    strx.freeText(hs);
}

// brute force longest common substring: the length, and whether (sa, sb) really is a common substring of that length
int refLcSubstr(char* a, int na, char* b, int nb) {
    int best = 0;
    for (int i = 0; i < na; i++) {
        for (int j = 0; j < nb; j++) {
            int k = 0;
            while (i + k < na && j + k < nb && a[i + k] == b[j + k]) { k++; }
            if (k > best) { best = k; }
        }
    }
    return best;
}

void substrings() {
    char a[50];
    char b[50];
    int bad = 0;
    int badPos = 0;
    for (int round = 0; round < 600; round++) {
        int na = rnd(30);
        int nb = rnd(30);
        int alpha = 1 + rnd(4);
        randText(&a[0], na, alpha);
        randText(&b[0], nb, alpha);
        int sa = -9; int sb = -9;
        int len = strx.longestCommonSubstring(&a[0], na, &b[0], nb, &sa, &sb);
        int want = refLcSubstr(&a[0], na, &b[0], nb);
        if (len != want) { bad++; }
        if (want == 0) { if (sa != -1 || sb != -1) { badPos++; } }
        else if (sa < 0 || sb < 0 || sa + len > na || sb + len > nb || memcmp(&a[sa], &b[sb], len) != 0) { badPos++; }
    }
    check(bad == 0, "longestCommonSubstring agrees with brute force (600 random pairs)");
    check(badPos == 0, "the reported start positions are a real match");
    int sa = 0; int sb = 0;
    int len = strx.longestCommonSubstring("xabcdy", -1, "zzabcdq", -1, &sa, &sb);
    check(len == 4 && sa == 1 && sb == 2, "abcd");
    check(strx.longestCommonSubstring("", -1, "abc", -1, &sa, &sb) == 0 && sa == -1 && sb == -1, "empty text");
    check(strx.longestCommonSubstring("abc", -1, "xyz", -1) == 0, "nothing in common, no out pointers");
    check(strx.longestCommonSubstring("abcdef", 3, "defabc", 6, &sa, &sb) == 3 && sa == 0 && sb == 3, "explicit lengths");
    // the match may not run through the end of the first text into the second
    check(strx.longestCommonSubstring("ab", -1, "ba", -1) == 1, "no match across the join of the two texts");
    // bytes 0 and 255 are ordinary
    char p[8]; char q[8];
    p[0] = 0; p[1] = 255; p[2] = 1; p[3] = 0; p[4] = 255;
    q[0] = 7; q[1] = 0; q[2] = 255; q[3] = 1; q[4] = 9;
    check(strx.longestCommonSubstring(&p[0], 5, &q[0], 5, &sa, &sb) == 3 && sa == 0 && sb == 1, "binary data");
    // UTF-8: "e" with acute (C3 A9) and "e" with grave (C3 A8) share the byte C3, which is not a character
    char* x1 = "x\xc3\xa9y";
    char* y1 = "x\xc3\xa8y";
    check(strx.longestCommonSubstring(x1, -1, y1, -1, &sa, &sb) == 2 && sa == 0, "bytes: the common lead byte counts");
    check(strx.longestCommonSubstring(x1, -1, y1, -1, &sa, &sb, true) == 1 && sa == 0 && sb == 0, "utf8: only whole characters");
    check(strx.longestCommonSubstring("ab\xe6\x97\xa5\xe6\x9c\xac" "cd", -1, "zz\xe6\x97\xa5\xe6\x9c\xac" "cq", -1, &sa, &sb, true) == 7 && sa == 2 && sb == 2, "utf8: a match with multi byte characters (byte length)");
    // 300000 letters: linear time
    int n = 300000;
    char* u = alloc(n + 1);
    char* v = alloc(n + 1);
    for (int i = 0; i < n; i++) { u[i] = 'a' + rnd(26); v[i] = 'a' + rnd(26); }
    // plant a common run of 500 letters
    for (int i = 0; i < 500; i++) { v[123456 + i] = u[200000 + i]; }
    int got = strx.longestCommonSubstring(u, n, v, n, &sa, &sb);
    check(got >= 500 && got < 520 && memcmp(&u[sa], &v[sb], got) == 0, "300000 letters: finds the planted run of 500");
}

int main() {
    subsequences();
    substrings();
    printf("lcs: %d checks, %d failures\n", checks, fails);
    return fails;
}
