// tuix: DirList and the file dialogs (open, save, directory) on a real directory tree made by the test (Linux only)
import tui;
import tuix;
import term;
import tscreen;

char base[100];
tui.App* app;

int rmdirSys(char* p) {
    if (__ARCH == 0) { return __syscall(84, (int) p, 0, 0, 0, 0, 0); }
    return __syscall(35, -100, (int) p, 0x200, 0, 0, 0);
}

char* path(char* rel) { return tuix.joinPath(&base[0], rel); }

int symlinkSys(char* target, char* link) {
    if (__ARCH == 0) { return __syscall(88, (int) target, (int) link, 0, 0, 0, 0); }
    return __syscall(36, (int) target, -100, (int) link, 0, 0, 0);
}

int mkfifoSys(char* p) {
    if (__ARCH == 0) { return __syscall(133, (int) p, 0x11A4, 0, 0, 0, 0); }                 // mknod(path, S_IFIFO | 0644, 0)
    return __syscall(33, -100, (int) p, 0x11A4, 0, 0, 0);                                    // mknodat
}

void make(char* rel, char* content) { writeFile(path(rel), content); }

void cleanup() {
    char* files[8] = {"alpha.a", "beta.txt", "Gamma.A", ".hidden", "sub/inner.a", "sub/deeper/leaf.txt", "new.txt", "overwrite.txt"};
    for (int i = 0; i < 8; i++) { fileDelete(path(files[i])); }
    char* lk[7] = {"lk/fifo", "lk/to_dir", "lk/to_file", "lk/to_fifo", "lk/dangling", "lk/to_parent", "lk/plain.txt"};
    for (int i = 0; i < 7; i++) { fileDelete(path(lk[i])); }
    rmdirSys(path("lk/realdir"));
    rmdirSys(path("lk"));
    rmdirSys(path("sub/deeper"));
    rmdirSys(path("sub"));
    rmdirSys(path("zeta"));
    rmdirSys(&base[0]);
}

// a path relative to the test directory
char* rel(char* p) {
    int n = strlen(&base[0]);
    if (p == null) { return "(null)"; }
    if (strlen(p) >= n && startsWith(p, &base[0])) { if (p[n] == 0) { return "."; } return &p[n]; }
    return p;
}

void listRows(tui.ListView* l) {
    for (int i = 0; i < l->nshown; i++) { printf("  %s\n", l->itemText(l->shown[i])); }
}

int main() {
    if (__OS == 1) {
        println("skipped: no directory listing on Windows");
        return 0;
    }
    format(&base[0], 100, "/tmp/atui_t236_%d_%d", __ARCH, __OS, 0, 0);
    cleanup();
    makeDir(&base[0]);
    makeDir(path("sub"));
    makeDir(path("sub/deeper"));
    makeDir(path("zeta"));
    make("alpha.a", "hello");
    make("beta.txt", "0123456789");
    make("Gamma.A", "");
    make(".hidden", "x");
    make("sub/inner.a", "inner file");
    make("sub/deeper/leaf.txt", "leaf");

    println("-- DirList: directories first, then names without regard to case");
    tuix.DirList d;
    printf("loaded: %d\n", d.load(&base[0], false, true));
    d.sort();
    for (int i = 0; i < d.count; i++) { printf("%s %s %d\n", d.isDir(i) ? "dir " : "file", d.name(i), d.sizeOf(i)); }
    printf("with hidden files: ");
    d.load(&base[0], true, false);
    d.sort();
    printf("%d entries, first file '%s'\n", d.count, d.name(2));
    printf("a missing directory: %d\n", d.load("/nonexistent/dir", false));
    printf("a file is not a directory: %d\n", d.load(path("alpha.a"), false));
    printf("file sizes: %d %d %d\n", tuix.fileSizeOf(path("alpha.a")), tuix.fileSizeOf(path("Gamma.A")), tuix.fileSizeOf(path("nothing")));

    println("-- symbolic links and FIFOs: links are marked, nothing is opened (a FIFO without a writer used to hang load())");
    makeDir(path("lk"));
    makeDir(path("lk/realdir"));
    make("lk/plain.txt", "plain");
    int made = mkfifoSys(path("lk/fifo"));
    made = made + symlinkSys("realdir", path("lk/to_dir"));
    made = made + symlinkSys("plain.txt", path("lk/to_file"));
    made = made + symlinkSys("fifo", path("lk/to_fifo"));
    made = made + symlinkSys("nowhere", path("lk/dangling"));
    made = made + symlinkSys("..", path("lk/to_parent"));
    printf("created: %d\n", made == 0);
    d.load(path("lk"), false, true);
    d.sort();
    for (int i = 0; i < d.count; i++) { printf("%s %-9s link %d size %d\n", d.isDir(i) ? "dir " : "file", d.name(i), d.isLink(i), d.sizeOf(i)); }
    printf("modes: dir %x, file %x, link %x, link followed %x\n", tuix.fileMode(path("lk/realdir")) & 0xF000, tuix.fileMode(path("lk/plain.txt")) & 0xF000,
           tuix.fileMode(path("lk/to_file"), false) & 0xF000, tuix.fileMode(path("lk/to_file")) & 0xF000);
    printf("fifo %x, missing %d\n", tuix.fileMode(path("lk/to_fifo")) & 0xF000, tuix.fileMode(path("lk/nothing")));
    printf("isDirectory: %d %d %d %d\n", tuix.isDirectory(path("lk/realdir")), tuix.isDirectory(path("lk/to_dir")),
           tuix.isDirectory(path("lk/plain.txt")), tuix.isDirectory(path("lk/to_fifo")));
    printf("isRegularFile: %d %d %d\n", tuix.isRegularFile(path("lk/plain.txt")), tuix.isRegularFile(path("lk/to_file")), tuix.isRegularFile(path("lk/fifo")));
    printf("isSymlink: %d %d %d\n", tuix.isSymlink(path("lk/to_dir")), tuix.isSymlink(path("lk/realdir")), tuix.isSymlink(path("lk/dangling")));
    printf("sameFile: %d %d %d %d\n", tuix.sameFile(path("lk/plain.txt"), path("lk/to_file")), tuix.sameFile(path("lk/plain.txt"), path("lk/plain.txt")),
           tuix.sameFile(path("lk/plain.txt"), path("lk/fifo")), tuix.sameFile(path("lk/plain.txt"), path("lk/nothing")));
    printf("a FIFO or a link to one is not a directory: %d %d\n", d.load(path("lk/fifo"), false), d.load(path("lk/to_fifo"), false));
    printf("a link to a directory can be listed: %d (%d entries)\n", d.load(path("lk/to_dir"), false), d.count);
    fileDelete(path("lk/fifo"));
    fileDelete(path("lk/to_dir"));
    fileDelete(path("lk/to_file"));
    fileDelete(path("lk/to_fifo"));
    fileDelete(path("lk/dangling"));
    fileDelete(path("lk/to_parent"));
    fileDelete(path("lk/plain.txt"));
    rmdirSys(path("lk/realdir"));
    rmdirSys(path("lk"));

    println("-- path helpers");
    printf("%s\n", tuix.joinPath("/a/b", "c"));
    printf("%s\n", tuix.joinPath("/a/b/", "c"));
    printf("%s\n", tuix.parentPath("/a/b/c"));
    printf("%s\n", tuix.parentPath("/a"));
    printf("%s\n", tuix.parentPath("/"));
    printf("%s\n", tuix.parentPath("/a/b/"));
    printf("%s\n", tuix.cleanPath("/x/y", "z"));
    printf("%s\n", tuix.cleanPath("/x/y", "../z/./w"));
    printf("%s\n", tuix.cleanPath("/x/y", "/abs//path/../ok"));
    printf("%s\n", tuix.cleanPath("/x", "../../.."));

    app = new tui.App();
    app->initHeadless(70, 22);
    app->setRoot(new tui.Label("main window"));
    app->pump(0);

    println("-- the open dialog");
    tui.Dialog* dlg = tuix.newFileDialog(app, "Open a file", &base[0], "", false, false, "");
    app->showDialog(dlg);
    tui.ListView* lv = (tui.ListView*) dlg->content->kids[1];
    tui.TextInput* pathIn = (tui.TextInput*) dlg->content->kids[0];
    printf("the path field shows the directory: %s\n", rel(pathIn->getText()));
    println("entries:");
    listRows(lv);
    printf("focus is on the list: %d\n", app->focus == lv);
    println("-- type to filter, Enter on a directory goes in, ../ goes back");
    app->type("sub");
    printf("filter 'sub' leaves %d row\n", lv->nshown);
    app->press("Enter");
    printf("now in %s, the filter is cleared: '%s'\n", rel(pathIn->getText()), lv->filter.str());
    listRows(lv);
    app->press("Down");
    app->press("Down");
    app->press("Enter");
    printf("inner.a is a file: Enter picks it: result %d, %s\n", dlg->result, rel(tuix.fileDialogResult(dlg)));
    dlg = tuix.newFileDialog(app, "Open a file", &base[0], "", false, false, "");
    app->showDialog(dlg);
    lv = (tui.ListView*) dlg->content->kids[1];
    pathIn = (tui.TextInput*) dlg->content->kids[0];
    app->press("Down");
    app->press("Enter");
    app->press("Down");
    app->press("Enter");
    printf("down into sub and deeper: %s\n", rel(pathIn->getText()));
    listRows(lv);
    app->press("Home");
    app->press("Enter");
    printf("../ goes up: %s\n", rel(pathIn->getText()));
    println("-- the path field");
    pathIn->focusMe();
    pathIn->setText(path("zeta"));
    app->press("Enter");
    printf("typed a directory: now in %s (%d entries)\n", rel(pathIn->getText()), lv->count);
    printf("the list has the focus again: %d\n", app->focus == lv);
    pathIn->focusMe();
    pathIn->setText(path("sub/inner.a"));
    app->press("Enter");
    printf("typed a file name: result %d, path %s\n", dlg->result, rel(tuix.fileDialogResult(dlg)));
    printf("the dialog is closed: %d overlays\n", app->nov);

    println("-- a pattern: only matching files (and all directories)");
    dlg = tuix.newFileDialog(app, "Open", &base[0], "*.a", false, false, "");
    app->showDialog(dlg);
    lv = (tui.ListView*) dlg->content->kids[1];
    listRows(lv);
    app->press("Esc");
    printf("cancelled: result %d, path %s\n", dlg->result, rel(tuix.fileDialogResult(dlg)));

    println("-- hidden files with Alt+.");
    dlg = tuix.newFileDialog(app, "Open", &base[0], "", false, false, "");
    app->showDialog(dlg);
    lv = (tui.ListView*) dlg->content->kids[1];
    printf("before: %d entries\n", lv->count);
    app->press("Alt+.");
    printf("after: %d entries, first file %s\n", lv->count, lv->itemText(3));
    app->press("Alt+.");
    printf("again: %d entries\n", lv->count);
    app->press("Esc");

    println("-- the save dialog: the name field");
    dlg = tuix.newFileDialog(app, "Save as", &base[0], "", true, false, "new.txt");
    app->showDialog(dlg);
    tui.Widget* nameBox = dlg->content->kids[2];
    printf("a name field with the suggestion: %s\n", ((tui.TextInput*) nameBox->kids[1])->getText());
    printf("the list has the focus first: %d\n", app->focus == ((tui.ListView*) dlg->content->kids[1]));
    app->press("Tab");
    printf("Tab: focus on the name field: %d\n", app->focus == nameBox->kids[1]);
    app->press("Enter");
    printf("result %d, path %s\n", dlg->result, rel(tuix.fileDialogResult(dlg)));
    println("-- choosing an existing file asks before replacing it");
    make("overwrite.txt", "old");
    dlg = tuix.newFileDialog(app, "Save as", &base[0], "", true, false, "overwrite.txt");
    app->showDialog(dlg);
    app->press("Tab");
    app->inject("\x1b" "n");                          // the answer to the question: No (Alt+N)
    app->press("Enter");
    printf("answered No: still open %d, result %d\n", dlg->open, dlg->result);
    app->inject("\r\r");                              // Enter for the dialog, Enter for the question (Yes is the default)
    app->pump(0);
    printf("answered Yes: open %d, result %d, path %s\n", dlg->open, dlg->result, rel(tuix.fileDialogResult(dlg)));

    println("-- the directory dialog");
    dlg = tuix.newFileDialog(app, "Choose a folder", &base[0], "", false, true, "");
    app->showDialog(dlg);
    lv = (tui.ListView*) dlg->content->kids[1];
    println("only directories are listed:");
    listRows(lv);
    app->press("Down");
    app->press("Enter");
    printf("Enter on a directory in this mode goes in (result %d), now in %s\n", dlg->result, rel(((tui.TextInput*) dlg->content->kids[0])->getText()));
    printf("the Select button chooses the directory that is shown: ");
    tui.Button* ok = (tui.Button*) dlg->buttons->kids[0];
    ok->click();
    printf("result %d, path %s\n", dlg->result, rel(tuix.fileDialogResult(dlg)));
    cleanup();
    return 0;
}
