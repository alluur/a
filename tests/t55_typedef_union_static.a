typedef int Number;
typedef char* Text;
typedef Number* NumPtr;
struct Point { int x; int y; }
typedef Point Pt;
typedef func Handler;

union Value {
    int i;
    char bytes[8];
    char* text;
}

union Mixed { int small; Pt p; }

static int counter;
static int helper(Number n) { return n * 2; }

int next() {
    static int calls;
    static int start = 100;
    static char tag = 'x';
    static int table[4];
    calls++;
    table[calls % 4] = calls;
    return start + calls + table[calls % 4];
}

Text greet(Text who) {
    return who;
}

int main() {
    Number n = 21;
    Text t = "typedef text";
    NumPtr p = &n;
    Pt pt;
    pt.x = 3; pt.y = 4;
    println(t);
    printlnInt(*p * 2);
    printlnInt(pt.x + pt.y);
    printlnInt(sizeof(Pt));
    Handler h = helper;
    printlnInt(h(8));
    Value v;
    v.i = 0x41424344;
    printChar(v.bytes[0]); printChar(v.bytes[1]); printChar(v.bytes[3]); printChar('\n');
    printlnInt(sizeof(Value));
    printlnInt(sizeof(Mixed));
    Mixed m;
    m.p.x = 7; m.p.y = 9;
    printlnInt(m.small);
    for (int i = 0; i < 3; i++) {
        printlnInt(next());
    }
    typedef int Local;
    Local lv = 5;
    printlnInt(lv + counter);
    println(greet("hello"));
    return 0;
}
