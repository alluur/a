// evaluates function number fn for the arguments in a[], stores the results in out[] and returns how many there are
int evalRow(int fn, double* a, double* out) {
    if (fn == 1) { out[0] = stats.erf(a[0]); return 1; }
    if (fn == 2) { out[0] = stats.erfc(a[0]); return 1; }
    if (fn == 3) { out[0] = stats.lgamma(a[0]); return 1; }
    if (fn == 4) { out[0] = stats.gamma(a[0]); return 1; }
    if (fn == 5) { out[0] = stats.digamma(a[0]); return 1; }
    if (fn == 6) { out[0] = stats.incGammaP(a[0], a[1]); out[1] = stats.incGammaQ(a[0], a[1]); return 2; }
    if (fn == 7) {
        out[0] = stats.incBeta(a[0], a[1], a[2]);
        out[1] = stats.betaSf(a[0], a[1], a[2]);
        return 2;
    }
    if (fn == 8) { out[0] = stats.lbeta(a[0], a[1]); return 1; }
    if (fn == 9) { out[0] = stats.erfInv(a[0]); return 1; }
    if (fn == 10) { out[0] = stats.stdNormalQuantile(a[0]); return 1; }
    return 0;
}

double worstAll = 0.0;

// checks the rows of a table: nargs argument columns followed by nout expected values; every result has to be within tol (relative) of the expected value
void family(char* name, int fn, double* t, int tableBytes, int nargs, int nout, double tol, char* tolText) {
    int cols = nargs + nout;
    int rows = tableBytes / 8 / cols;
    double worst = 0.0;
    int fails = 0;
    for (int r = 0; r < rows; r++) {
        double out[4];
        int got = evalRow(fn, &t[r * cols], &out[0]);
        for (int k = 0; k < nout; k++) {
            double want = t[r * cols + nargs + k];
            double err = dmath.fabs(out[k] - want);
            if (want != 0.0) { err = err / dmath.fabs(want); }
            if (!(err <= tol) || got != nout) {
                fails++;
                if (fails <= 3) {
                    printfd("  FAIL %s row %d result %d: got %.17g want %.17g\n", name, r, k, __bits(out[k]), __bits(want));
                }
            }
            if (err > worst) { worst = err; }
        }
    }
    if (PROBE) { printfd("  worst relative error of %s: %.2e\n", name, __bits(worst)); }
    printf("%s: all within %s: %d\n", name, tolText, fails == 0);
}

// prints a value in a form that does not depend on rounding: nan, inf, -inf or the number with 10 digits
void show(char* label, double v) {
    print(label);
    if (v != v) { println(" nan"); }
    else if (v > 1.0e308 * 10.0) { println(" inf"); }
    else if (v < -1.0e308 * 10.0) { println(" -inf"); }
    else { printfd(" %.10g\n", __bits(v)); }
}

void edgeCases() {
    double inf = dmath.INFINITY;
    double nan = dmath.nan();
    show("erf(inf)", stats.erf(inf));
    show("erf(-inf)", stats.erf(-inf));
    show("erf(nan)", stats.erf(nan));
    show("erfc(inf)", stats.erfc(inf));
    show("erfc(-inf)", stats.erfc(-inf));
    show("lgamma(0)", stats.lgamma(0.0));
    show("lgamma(-1)", stats.lgamma(-1.0));
    show("lgamma(1)", stats.lgamma(1.0));
    show("lgamma(2)", stats.lgamma(2.0));
    show("lgamma(nan)", stats.lgamma(nan));
    show("gamma(5)", stats.gamma(5.0));
    show("gamma(0)", stats.gamma(0.0));
    show("gamma(-1)", stats.gamma(-1.0));
    show("gamma(172)", stats.gamma(172.0));
    show("digamma(0)", stats.digamma(0.0));
    show("digamma(-2)", stats.digamma(-2.0));
    show("digamma(nan)", stats.digamma(nan));
    show("incGammaP(0, 1)", stats.incGammaP(0.0, 1.0));
    show("incGammaP(1, -1)", stats.incGammaP(1.0, -1.0));
    show("incGammaP(1, 0)", stats.incGammaP(1.0, 0.0));
    show("incGammaQ(1, 0)", stats.incGammaQ(1.0, 0.0));
    show("incGammaP(2, inf)", stats.incGammaP(2.0, inf));
    show("incGammaP(nan, 1)", stats.incGammaP(nan, 1.0));
    show("incBeta(-0.1, 1, 1)", stats.incBeta(-0.1, 1.0, 1.0));
    show("incBeta(0, 1, 1)", stats.incBeta(0.0, 1.0, 1.0));
    show("incBeta(1, 1, 1)", stats.incBeta(1.0, 1.0, 1.0));
    show("incBeta(1.1, 1, 1)", stats.incBeta(1.1, 1.0, 1.0));
    show("incBeta(0.5, 0, 1)", stats.incBeta(0.5, 0.0, 1.0));
    show("incBeta(0.5, 1, nan)", stats.incBeta(0.5, 1.0, nan));
    show("stdNormalQuantile(0)", stats.stdNormalQuantile(0.0));
    show("stdNormalQuantile(1)", stats.stdNormalQuantile(1.0));
    show("stdNormalQuantile(0.5)", stats.stdNormalQuantile(0.5));
    show("stdNormalQuantile(1.5)", stats.stdNormalQuantile(1.5));
    show("stdNormalQuantile(-0.1)", stats.stdNormalQuantile(-0.1));
    show("stdNormalQuantile(nan)", stats.stdNormalQuantile(nan));
    show("erfInv(1)", stats.erfInv(1.0));
    show("erfInv(-1)", stats.erfInv(-1.0));
    show("erfInv(0)", stats.erfInv(0.0));
    show("erfInv(1.5)", stats.erfInv(1.5));
    show("erfcInv(0)", stats.erfcInv(0.0));
    show("erfcInv(2)", stats.erfcInv(2.0));
    show("erfcInv(1)", stats.erfcInv(1.0));
    show("erfcInv(3)", stats.erfcInv(3.0));
    show("lbeta(0, 1)", stats.lbeta(0.0, 1.0));
    show("lbeta(-1, 1)", stats.lbeta(-1.0, 1.0));
    show("lbeta(1, 1)", stats.lbeta(1.0, 1.0));
    show("beta(2, 3)", stats.beta(2.0, 3.0));
}

// identities that need no reference table
void identities() {
    int bad = 0;
    for (int i = -20; i <= 20; i++) {
        double x = (double) i * 0.37;
        if (stats.erf(-x) != -stats.erf(x)) { bad++; }
        if (dmath.fabs(stats.erf(x) + stats.erfc(x) - 1.0) > 4.0e-16) { bad++; }
    }
    printf("erf is odd and erf + erfc = 1 on 41 points: %d violations\n", bad);
    bad = 0;
    double fact = 1.0;
    for (int n = 1; n <= 20; n++) {
        fact = fact * (double) n;
        if (stats.gamma((double) (n + 1)) != fact) { bad++; }
    }
    printf("gamma(n + 1) = n! exactly for n = 1 .. 20: %d violations\n", bad);
    double g = stats.gamma(0.5);
    printf("gamma(0.5)^2 = pi: %d\n", dmath.fabs(g * g - dmath.PI) < 1.0e-15);
    bad = 0;
    for (int i = 1; i <= 30; i++) {
        double x = (double) i * 0.31;
        double p = stats.incGammaP(1.0, x);
        if (dmath.fabs(p - (1.0 - dmath.exp(-x))) > 1.0e-15) { bad++; }
        double q = stats.incGammaQ(1.0, x);
        if (dmath.fabs(q - dmath.exp(-x)) > 1.0e-15 * dmath.exp(-x) * 8.0) { bad++; }
        if (dmath.fabs(stats.incGammaP(0.5, x * x) - stats.erf(x)) > 1.0e-14) { bad++; }
        if (dmath.fabs(stats.incGammaP(3.0, x) + stats.incGammaQ(3.0, x) - 1.0) > 1.0e-15) { bad++; }
    }
    printf("P(1, x) = 1 - exp(-x), Q(1, x) = exp(-x), P(1/2, x^2) = erf(x), P + Q = 1: %d violations\n", bad);
    bad = 0;
    for (int i = 1; i < 20; i++) {
        double x = (double) i / 20.0;
        if (dmath.fabs(stats.incBeta(x, 1.0, 1.0) - x) > 1.0e-15) { bad++; }
        if (dmath.fabs(stats.incBeta(x, 3.0, 1.0) - x * x * x) > 1.0e-15) { bad++; }
        if (dmath.fabs(stats.incBeta(x, 1.0, 4.0) - (1.0 - dmath.pow(1.0 - x, 4.0))) > 2.0e-15) { bad++; }
        if (dmath.fabs(stats.incBeta(x, 2.5, 6.5) + stats.incBeta(1.0 - x, 6.5, 2.5) - 1.0) > 2.0e-14) { bad++; }
        if (dmath.fabs(stats.incBeta(x, 2.5, 6.5) + stats.betaSf(x, 2.5, 6.5) - 1.0) > 2.0e-14) { bad++; }
    }
    printf("I_x(1, 1) = x, I_x(3, 1) = x^3, I_x(1, 4) = 1 - (1 - x)^4, I_x(a, b) + I_{1-x}(b, a) = 1: %d violations\n", bad);
    bad = 0;
    double prev = -1.0;
    for (int i = 0; i <= 100; i++) {
        double v = stats.incBeta((double) i / 100.0, 7.0, 3.0);
        if (v < prev) { bad++; }
        prev = v;
    }
    printf("incBeta is increasing in x on a grid of 101 points: %d violations\n", bad);
    bad = 0;
    prev = -1.0;
    for (int i = 0; i <= 100; i++) {
        double v = stats.incGammaP(5.0, (double) i * 0.2);
        if (v < prev) { bad++; }
        prev = v;
    }
    printf("incGammaP is increasing in x: %d violations\n", bad);
    bad = 0;
    for (int i = 1; i < 50; i++) {
        double p = (double) i / 50.0;
        double x = stats.stdNormalQuantile(p);
        if (dmath.fabs(stats.stdNormalCdf(x) - p) > 4.0e-16) { bad++; }
        if (stats.stdNormalQuantile(1.0 - p) != -stats.stdNormalQuantile(p) && dmath.fabs(stats.stdNormalQuantile(1.0 - p) + stats.stdNormalQuantile(p)) > 1.0e-15) { bad++; }
        double y = stats.erfInv(p);
        if (dmath.fabs(stats.erf(y) - p) > 4.0e-16) { bad++; }
    }
    printf("stdNormalCdf(stdNormalQuantile(p)) = p, symmetry, erf(erfInv(p)) = p on 49 points: %d violations\n", bad);
}

int main() {
    family("erf", 1, T_ERF, sizeof(T_ERF), 1, 1, 1.0e-15, "1e-15");
    family("erfc", 2, T_ERFC, sizeof(T_ERFC), 1, 1, 1.0e-15, "1e-15");
    family("lgamma", 3, T_LGAMMA, sizeof(T_LGAMMA), 1, 1, 1.0e-15, "1e-15");
    family("gamma", 4, T_GAMMA, sizeof(T_GAMMA), 1, 1, 1.0e-15, "1e-15");
    family("digamma", 5, T_DIGAMMA, sizeof(T_DIGAMMA), 1, 1, 1.0e-14, "1e-14");
    family("incGammaP / incGammaQ", 6, T_INCGAMMA, sizeof(T_INCGAMMA), 2, 2, 1.0e-13, "1e-13");
    family("incBeta / betaSf", 7, T_INCBETA, sizeof(T_INCBETA), 3, 2, 1.0e-12, "1e-12");
    family("lbeta", 8, T_LBETA, sizeof(T_LBETA), 2, 1, 1.0e-14, "1e-14");
    family("erfInv", 9, T_ERFINV, sizeof(T_ERFINV), 1, 1, 1.0e-14, "1e-14");
    family("stdNormalQuantile", 10, T_NORMQ, sizeof(T_NORMQ), 1, 1, 1.0e-14, "1e-14");
    identities();
    edgeCases();
    return 0;
}
