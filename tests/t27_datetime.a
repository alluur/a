import datetime;
import strings;
int main() {
    int ts[6];
    ts[0] = 0; ts[1] = 86399; ts[2] = 951782400; ts[3] = 1700000000; ts[4] = -1; ts[5] = 4102444800;
    for (int i = 0; i < 6; i++) {
        datetime.DateTime* d = new datetime.DateTime(ts[i]);
        print(d->toString()); print(" "); printInt(d->weekday); print(" "); printInt(d->yearDay); print(" ");
        printlnInt(d->toUnix() == ts[i]);
    }
    printlnInt(datetime.toUnix(2000, 2, 29, 12, 0, 0));
    printBool(datetime.isLeapYear(1900)); printBool(datetime.isLeapYear(2000)); println("");
    printlnInt(datetime.daysInMonth(2024, 2));
    println(datetime.weekdayName(datetime.dayOfWeek(2026, 10, 11)));
    int n = datetime.now(); printBool(n > 1700000000); println("");
    println(strings.padLeft("42", 6, '0'));
    return 0;
}
