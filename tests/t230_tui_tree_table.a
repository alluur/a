// tuix: TreeView (lazy branches, keys, mouse) and Table (columns, sorting, selection)
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
tuix.TreeView* tv;
tuix.Table* tb;
int expands;
int collapses;
int selects;
int activates;

int onExpand(int tree, int node) {
    expands++;
    char buf[40];
    for (int i = 1; i <= 2; i++) {
        format(&buf[0], 40, "%s.%d", tv->nodeText(node), i, 0, 0);
        // the data of a node is its depth; only the first child of a top level node is lazy again
        tv->addNode(node, &buf[0], tv->nodeData(node) + 1, tv->nodeData(node) == 0 && i == 1);
    }
    return 0;
}
int onCollapse(int tree, int node) { collapses++; return 0; }
int onSelect(int t) { selects++; return 0; }
int onActivate(int t) { activates++; return 0; }

void treeState(char* what) {
    printf("-- %s (selected: %s)\n", what, tv->selected() == 0 ? "-" : tv->nodeText(tv->selected()));
    println(app->text());
}

int main() {
    app = new tui.App();
    app->initHeadless(26, 8);
    tui.Box* col = tui.vbox(0, 0);
    tv = new tuix.TreeView();
    tv->flex = 1;
    tv->onExpand = onExpand;
    tv->onCollapse = onCollapse;
    tv->onSelect = onSelect;
    tv->onActivate = onActivate;
    int a = tv->addNode(0, "alpha", 0, true);
    int b = tv->addNode(0, "beta", 0, true);
    int c = tv->addNode(0, "leaf", 7, false);
    tv->addNode(0, "gamma", 0, false);
    col->add(tv);
    app->setRoot(col);
    app->pump(0);
    treeState("collapsed tree");
    printf("expands %d\n", expands);

    println("-- Right expands a lazy node (the hook runs once)");
    app->press("Right");
    treeState("alpha expanded");
    printf("expands %d, children %d\n", expands, tv->childCount(a));
    app->press("Left");
    treeState("Left collapses");
    app->press("Right");
    printf("expanded again, the hook did not run again: expands %d, collapses %d\n", expands, collapses);
    app->press("Right");
    printf("Right on an expanded node goes to its first child: %s\n", tv->nodeText(tv->selected()));
    app->press("Right");
    treeState("alpha.1 is lazy too");
    app->press("Left");
    app->press("Left");
    printf("Left on a collapsed node goes to the parent: %s\n", tv->nodeText(tv->selected()));
    app->press("Left");
    treeState("alpha collapsed");

    println("-- Enter and Space toggle, a leaf activates");
    app->press("Down");
    app->press("Enter");
    printf("beta expanded: %d\n", tv->isExpanded(b));
    app->press("Space");
    printf("beta collapsed: %d\n", !tv->isExpanded(b));
    app->press("Down");
    app->press("Enter");
    printf("leaf activated: %d (data %d)\n", activates, tv->nodeData(tv->selected()));

    println("-- + - * and Home End");
    app->press("Home");
    app->press("+");
    app->press("*");
    treeState("* expands everything below");
    app->press("-");
    app->press("End");
    treeState("End");
    printf("the selection changed %d times\n", selects);

    println("-- scrolling in a small view and the wheel");
    app->press("Home");
    app->press("*");
    app->press("PgDn");
    treeState("PgDn");
    app->wheel(3, 2, true);
    app->wheel(3, 2, true);
    printf("top %d\n", tv->top);
    app->press("Down");
    printf("the selection is visible again: top %d\n", tv->top);

    println("-- mouse: click selects, click on the arrow toggles, double click toggles");
    app->press("Home");
    app->click(8, 1);
    printf("clicked on a row: %s\n", tv->nodeText(tv->selected()));
    int before = tv->isExpanded(tv->selected()) ? 1 : 0;
    app->advanceClock(1000);
    app->click(1, 0);
    printf("arrow click toggled the first node: %d -> %d\n", before, tv->isExpanded(tv->selected()) ? 1 : 0);

    println("-- removeChildren makes a lazy node load again");
    tv->removeChildren(a);
    tv->expand(a);
    printf("expands %d, children %d\n", expands, tv->childCount(a));
    tv->select(c);
    printf("select(node): %s\n", tv->nodeText(tv->selected()));
    println("-- a tall tree scrolls: End, wheel (the selection may leave the view), Down brings it back");
    for (int i = 0; i < 12; i++) {
        char nm[20];
        format(&nm[0], 20, "node%d", i, 0, 0, 0);
        tv->addNode(0, &nm[0], i, false);
    }
    app->press("End");
    treeState("End");
    printf("top %d\n", tv->top);
    app->wheel(3, 2, true);
    app->wheel(3, 2, true);
    printf("after the wheel: top %d, selected %s\n", tv->top, tv->nodeText(tv->selected()));
    app->press("Up");
    printf("Up: top %d, selected %s\n", tv->top, tv->nodeText(tv->selected()));
    app->mouseDown(25, 2);
    app->mouseDrag(25, 0);
    app->mouseUp(25, 0);
    printf("scroll bar dragged to the top: top %d\n", tv->top);
    tv->clear();
    app->pump(0);
    println(app->text());

    println("== Table ==");
    app = new tui.App();
    app->initHeadless(30, 7);
    col = tui.vbox(0, 0);
    tb = new tuix.Table();
    tb->flex = 1;
    tb->addColumn("Name", 0);
    tb->addColumn("Size", 7, 2);
    tb->addColumn("Kind", 6, 1);
    tb->onSelect = onSelect;
    tb->onActivate = onActivate;
    selects = 0;
    activates = 0;
    tb->addRow("zebra", "100", "A");
    tb->addRow("Apple", "20", "B");
    tb->addRow("mango", "3", "C");
    tb->addRow("banana", "1000", "D");
    tb->addRow("cherry", "20", "E");
    col->add(tb);
    app->setRoot(col);
    app->pump(0);
    app->press("Tab");
    println(app->text());
    println("-- keys");
    app->press("Down");
    app->press("Down");
    printf("selected row %d: %s\n", tb->selectedRow(), tb->cell(tb->selectedRow(), 0));
    app->press("Enter");
    printf("activates %d, selects %d\n", activates, selects);
    println("-- sort by clicking a header: strings ignore case");
    app->click(2, 0);
    println(app->text());
    printf("the selected row is still %s\n", tb->cell(tb->selectedRow(), 0));
    app->advanceClock(1000);
    app->click(2, 0);
    println("-- again: descending");
    println(app->text());
    println("-- numbers sort as numbers, equal values keep their order");
    app->advanceClock(1000);
    app->click(22, 0);
    println(app->text());
    app->advanceClock(1000);
    app->click(22, 0);
    println(app->text());
    println("-- more rows than the view: the scroll bar and the wheel");
    for (int i = 0; i < 10; i++) {
        char nm[20];
        format(&nm[0], 20, "row%d", i, 0, 0, 0);
        tb->addRow(&nm[0], "5", "x");
    }
    tb->sortBy(-1, false);
    app->pump(0);
    println(app->text());
    app->press("End");
    println(app->text());
    printf("selected row %d, top %d\n", tb->selectedRow(), tb->top);
    app->wheel(3, 3, true);
    printf("after the wheel: top %d, selection %d\n", tb->top, tb->selectedRow());
    app->advanceClock(1000);
    app->click(3, 3);
    printf("click selects the clicked row: %s\n", tb->cell(tb->selectedRow(), 0));
    tb->clear();
    app->pump(0);
    println(app->text());
    return 0;
}
