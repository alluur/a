// gcode_ide: SearchPane (find in files with options, a file filter, clicks that jump, stop), RunPane (output of a program, a line that sends input,
// end of input, exit codes, signals, Stop) and DocView (pages from a folder, links between pages, back, anchors)
import wsrv;
import gui;
import guix;
import gcode;
import aproject;
import atheme;
import asys;
import adp;
import gfx;
import cstdlib;
#include "gcode_harness.inc"

gui.Window* w;
int jumps = 0;
int finished = 0;
char lastJump[200];

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int rowY(gcode.RowList* l, int i) { return l->headerH + (i - l->top) * l->rowH + l->rowH / 2; }

int onSearchJump(int p) {
    gcode.SearchPane* sp = (gcode.SearchPane*) p;
    jumps++;
    format(&lastJump[0], 200, "%s %d:%d", sp->jumpPath, sp->jumpLine, sp->jumpCol);
    return 0;
}

int onRunFinished(int p) { finished++; return 0; }

void dumpResults(gcode.SearchPane* sp, int max) {
    printf("  results: %d lines, status [%s] tip [%s]\n", sp->results->lineCount(), sp->status->text, sp->status->tooltip);
    for (int i = 0; i < sp->results->lineCount() && i < max; i++) { printf("    %s\n", sp->results->lineText(i)); }
}

void runSearch(gcode.SearchPane* sp, char* pattern) {
    sp->search(pattern);
    for (int i = 0; i < 400 && sp->running; i++) { sp->step(); }
}

void searchTests() {
    printf("== SearchPane\n");
    rmtree("build/tests/t282");
    asys.mkdirs("build/tests/t282/proj/src");
    asys.mkdirs("build/tests/t282/proj/build");
    put("build/tests/t282/proj/src/main.a", "int main() {\n    // TODO: needle here\n    return needle(1) + Needle(2);\n}\n");
    put("build/tests/t282/proj/src/util.a", "int needleCount = 0;\nint other() { return 1; }\n");
    put("build/tests/t282/proj/notes.txt", "a needle in the notes\n  indented needle\n");
    put("build/tests/t282/proj/build/out.txt", "needle in an ignored folder\n");
    put("build/tests/t282/proj/.gitignore", "build/\n");
    aproject.Ignore* ign = new aproject.Ignore();
    ign->addBuiltin();
    ign->loadFile("build/tests/t282/proj/.gitignore", "");
    w = d->createWindow("Search", 760, 300, 0);
    gcode.SearchPane* sp = new gcode.SearchPane();
    sp->onJump = onSearchJump;
    gui.Box* col = gui.vbox(0, 0);
    col->add(sp);
    w->setRoot(col);
    settle();
    gcode.theLook()->setThemeName("dark");
    sp->setRoot("build/tests/t282/proj", ign);
    printf("empty search: %d, status [%s]\n", sp->search("") ? 1 : 0, sp->status->text);
    runSearch(sp, "needle");
    printf("needle (not case sensitive by default): matches %d, files %d\n", sp->matches, sp->files);
    dumpResults(sp, 10);
    sp->bCase->setChecked(true);
    runSearch(sp, "needle");
    printf("match case: matches %d, files %d\n", sp->matches, sp->files);
    sp->bCase->setChecked(false);
    sp->bWord->setChecked(true);
    runSearch(sp, "needle");
    printf("whole word: matches %d, files %d\n", sp->matches, sp->files);
    sp->bWord->setChecked(false);
    sp->bRegex->setChecked(true);
    runSearch(sp, "need[l]e\\(\\d\\)");
    printf("regular expression: matches %d\n", sp->matches);
    dumpResults(sp, 4);
    printf("bad expression: %d, status [%s]\n", sp->search("need(") ? 1 : 0, sp->status->text);
    sp->bRegex->setChecked(false);
    sp->filterBox->setText("*.txt");
    runSearch(sp, "needle");
    printf("only *.txt: matches %d, files %d\n", sp->matches, sp->files);
    sp->filterBox->setText("");
    runSearch(sp, "no such text anywhere");
    printf("nothing: matches %d, status [%s] tip [%s]\n", sp->matches, sp->status->text, sp->status->tooltip);

    // a click on a result jumps (path as listed, 1 based line and column)
    runSearch(sp, "needleCount");
    settle();
    printf("shown rows %d, first [%s]\n", sp->results->lineCount(), sp->results->lineText(0));
    clickWd(w, sp->results, 60, rowY(sp->results, 0));
    printf("jumps %d: %s\n", jumps, lastJump);
    // Enter in the find field starts a search; the button too
    sp->findBox->setText("indented");
    sp->findBox->focusMe();
    key(adp.KEY_ENTER, 13);
    for (int i = 0; i < 100 && sp->running; i++) { sp->step(); }
    printf("Enter in the field: matches %d, [%s]\n", sp->matches, sp->results->lineCount() > 0 ? sp->results->lineText(0) : "");
    clickWd(w, sp->bGo, 8, 8);
    for (int i = 0; i < 100 && sp->running; i++) { sp->step(); }
    printf("Search button: matches %d, running %d, Stop enabled %d\n", sp->matches, sp->running ? 1 : 0, sp->bStop->enabled ? 1 : 0);
    // a big project: the search runs in steps and can be stopped
    for (int i = 0; i < 150; i++) {
        char f[100];
        format(&f[0], 100, "build/tests/t282/proj/src/big%d.a", i);
        put(&f[0], "int x;\n// marker line\n");
    }
    sp->stepMs = 0;
    sp->search("marker");
    printf("started: running %d, Stop enabled %d, Search enabled %d\n", sp->running ? 1 : 0, sp->bStop->enabled ? 1 : 0, sp->bGo->enabled ? 1 : 0);
    for (int i = 0; i < 400 && sp->matches == 0; i++) { sp->step(); }
    bool partial = sp->running && sp->matches > 0 && sp->matches < 150;
    clickWd(w, sp->bStop, 8, 8);
    printf("one step found some, not all: %d; after Stop: running %d, Stop enabled %d, matches kept %d\n", partial ? 1 : 0, sp->running ? 1 : 0, sp->bStop->enabled ? 1 : 0, sp->matches > 0 ? 1 : 0);
    sp->stepMs = 20;
    runSearch(sp, "marker");
    printf("all of them: %d matches in %d files\n", sp->matches, sp->files);
    // a missing folder
    sp->setRoot("build/tests/t282/nothing", ign);
    printf("missing folder: %d [%s]\n", sp->search("x") ? 1 : 0, sp->status->text);
    sp->setRoot("", ign);
    printf("no folder: %d [%s]\n", sp->search("x") ? 1 : 0, sp->status->text);
    sp->setRoot("build/tests/t282/proj", ign);
    runSearch(sp, "needleCount");
    settle();
    printf("window checksum is stable: %d\n", shot(w) == shot(w) ? 1 : 0);
    w->close();
    settle();
}

void runTests() {
    printf("== RunPane\n");
    printf("processes can be started: %d\n", asys.canSpawn());
    w = d->createWindow("Run", 700, 300, 0);
    gcode.RunPane* rp = new gcode.RunPane();
    rp->onFinished = onRunFinished;
    gui.Box* col = gui.vbox(0, 0);
    col->add(rp);
    w->setRoot(col);
    settle();
    printf("idle: running %d, Stop enabled %d, status [%s]\n", rp->running ? 1 : 0, rp->bStop->enabled ? 1 : 0, rp->status->text);
    printf("send without a program: %d\n", rp->sendLine("hello") ? 1 : 0);
    if (!asys.canSpawn()) { w->close(); settle(); return; }
    aproject.RunJob* job = new aproject.RunJob();
    char* argv[5];
    argv[0] = "/bin/sh";
    argv[1] = "-c";
    argv[2] = "echo start; read a; echo got:$a; read b; echo second:$b; exit 3";
    argv[3] = null;
    printf("start: %d\n", job->start(&argv[0], null, null));
    rp->start(job, "the test program");
    printf("running %d, Stop enabled %d, status [%s]\n", rp->running ? 1 : 0, rp->bStop->enabled ? 1 : 0, rp->status->text);
    for (int i = 0; i < 200 && rp->output->lineCount() < 1; i++) { d->pump(20); }
    printf("first output: [%s]\n", rp->output->lineText(0));
    // the input line: text and Enter
    rp->input->setText("one");
    rp->input->focusMe();
    key(adp.KEY_ENTER, 13);
    for (int i = 0; i < 200 && rp->output->lineCount() < 3; i++) { d->pump(20); }
    printf("after the first line: %d lines, input field now [%s]\n", rp->output->lineCount(), rp->input->text());
    typeStr("two");
    key(adp.KEY_ENTER, 13);
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("ended: running %d, exit code %d, signal %d, finished callbacks %d, Stop enabled %d, input enabled %d\n", rp->running ? 1 : 0, rp->exitCode, rp->signal, finished, rp->bStop->enabled ? 1 : 0, rp->input->enabled ? 1 : 0);
    for (int i = 0; i < rp->output->lineCount(); i++) {
        char* t = rp->output->lineText(i);
        if (startsWith(t, "[the program ended")) { printf("  line %d: [the program ended with exit code 3 after ...]\n", i); }
        else { printf("  line %d: [%s]\n", i, t); }
    }
    printf("status [%s]\n", rp->status->text);
    clickWd(w, rp->bClear, 8, 8);
    printf("Clear: %d lines\n", rp->output->lineCount());

    // end of input (Ctrl+D) makes `cat` finish
    job = new aproject.RunJob();
    argv[2] = "cat";
    argv[3] = null;
    job->start(&argv[0], null, null);
    rp->start(job, "cat");
    rp->input->enabled = true;
    rp->input->setText("echoed");
    rp->input->focusMe();
    key(adp.KEY_ENTER, 13);
    for (int i = 0; i < 100 && rp->output->lineCount() < 2; i++) { d->pump(20); }
    printf("cat echoes: %d lines, [%s] [%s]\n", rp->output->lineCount(), rp->output->lineText(0), rp->output->lineText(1));
    ctrl('d');
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("after Ctrl+D: running %d, exit code %d\n", rp->running ? 1 : 0, rp->exitCode);
    printf("send after the end: %d\n", rp->sendLine("late") ? 1 : 0);

    // a program that is ended by a signal
    job = new aproject.RunJob();
    argv[2] = "kill -9 $$";
    job->start(&argv[0], null, null);
    rp->start(job, "crasher");
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("killed: exit code %d, signal %d (%s)\n", rp->exitCode, rp->signal, gcode.signalName(rp->signal));
    printf("status [%s]\n", rp->status->text);

    // Stop (button) and Ctrl+C in the empty input line
    job = new aproject.RunJob();
    argv[2] = "sleep 30";
    job->start(&argv[0], null, null);
    rp->start(job, "sleeper");
    d->pump(100);
    printf("sleeper runs: %d\n", rp->running ? 1 : 0);
    clickWd(w, rp->bStop, 8, 8);
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("after Stop: running %d, signal %d\n", rp->running ? 1 : 0, rp->signal);
    job = new aproject.RunJob();
    job->start(&argv[0], null, null);
    rp->start(job, "sleeper 2");
    rp->input->setText("");
    rp->input->focusMe();
    ctrl('c');
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("after Ctrl+C in the empty input line: running %d, signal %d\n", rp->running ? 1 : 0, rp->signal);
    // output with a compiler style line that can be clicked
    job = new aproject.RunJob();
    argv[2] = "echo 'prog.a:7:3: error: it broke'";
    job->start(&argv[0], null, null);
    rp->clear();
    rp->start(job, "message");
    for (int i = 0; i < 300 && rp->running; i++) { d->pump(20); }
    printf("lines: %d, first [%s]\n", rp->output->lineCount(), rp->output->lineText(0));
    w->close();
    settle();
}

int docOpened = 0;
int onDocFile(int dv) { docOpened++; return 0; }

void docTests() {
    printf("== DocView\n");
    rmtree("build/tests/t282d");
    asys.mkdirs("build/tests/t282d/docs/sub");
    put("build/tests/t282d/docs/LANGUAGE.md", "# The language\n\nSee [the GUI](GUI.md) and [a section](#second) and [a file](sub/example.a) and [the web](https://example.org).\n\n## First\n\ntext\n\n## Second\n\nmore text\n");
    put("build/tests/t282d/docs/GUI.md", "# Graphics\n\nBack to [the language](LANGUAGE.md#first).\n");
    put("build/tests/t282d/docs/ZZ.md", "# Last\n");
    put("build/tests/t282d/docs/notes.txt", "not a page\n");
    put("build/tests/t282d/docs/sub/example.a", "int main() { return 0; }\n");
    setenv("AIDE_DOCS", "build/tests/t282d/docs");
    w = d->createWindow("Docs", 800, 400, 0);
    gcode.DocView* dv = new gcode.DocView();
    dv->onOpenFile = onDocFile;
    gui.Box* col = gui.vbox(0, 0);
    col->add(dv);
    w->setRoot(col);
    settle();
    printf("docs folder: %s\n", gcode.findDocsDir());
    printf("pages: %d\n", dv->openDocs());
    for (int i = 0; i < dv->pages->count; i++) { printf("  %s (%s)\n", dv->pages->names[i], gcode.baseName(dv->pages->paths[i])); }
    settle();
    printf("the first page is shown: %s, selected row %d\n", gcode.baseName(dv->current), dv->pages->selected);
    clickWd(w, dv->pages, 40, rowY(dv->pages, 1));
    printf("click on the second row: %s\n", gcode.baseName(dv->current));
    printf("back: %d, now %s; back again: %d\n", dv->back() ? 1 : 0, gcode.baseName(dv->current), dv->back() ? 1 : 0);
    dv->linkClicked("GUI.md");
    printf("link to GUI.md: %s, row %d\n", gcode.baseName(dv->current), dv->pages->selected);
    dv->linkClicked("LANGUAGE.md#first");
    printf("link with an anchor: %s\n", gcode.baseName(dv->current));
    dv->linkClicked("#second");
    printf("anchor only: still %s\n", gcode.baseName(dv->current));
    dv->linkClicked("https://example.org");
    dv->linkClicked("mailto:x@y.z");
    dv->linkClicked("");
    dv->linkClicked(null);
    printf("web links change nothing: %s\n", gcode.baseName(dv->current));
    dv->linkClicked("sub/example.a");
    printf("link to a source file: opened %d, path %s\n", docOpened, gcode.baseName(dv->openPath));
    dv->linkClicked("missing.md");
    printf("link to a page that is not there: still %s\n", gcode.baseName(dv->current));
    printf("back to the start: ");
    int n = 0;
    while (dv->back()) { n++; }
    printf("%d steps, then %s\n", n, gcode.baseName(dv->current));
    printf("showPage on a missing file: %d\n", dv->showPage("build/tests/t282d/nothing.md", true) ? 1 : 0);
    printf("a plain text file: %d\n", dv->showPage("build/tests/t282d/docs/notes.txt", true) ? 1 : 0);
    // no documentation at all
    setenv("AIDE_DOCS", "build/tests/t282d/empty");
    asys.mkdirs("build/tests/t282d/empty");
    gcode.DocView* none = new gcode.DocView();
    printf("an empty folder: %d pages\n", none->openDocs());
    w->close();
    settle();
}

int main() {
    startServerSized(7382, "t282", 900, 700);
    gcode.theLook()->autoComplete = false;
    searchTests();
    runTests();
    docTests();
    return 0;
}
