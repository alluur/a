// examples/gui/codedemo.a, the small editor made of the gcode widgets, driven like a user: open files from the explorer, edit and save,
// find, go to line, the palette, quick open, go to symbol, build with errors that become markers, jump from the output, close with a
// question, hide and show panels; screenshots of the whole window in two themes
#define CODEDEMO_NOMAIN
import wsrv;
import gcode;
#include "examples/gui/codedemo.a"
#include "gcode_harness.inc"

CodeDemo* app;
gcode.CodeEditor* e;

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

void rows(char* label) {
    printf("%s: %d tabs:", label, app->tabs->tabCount());
    for (int i = 0; i < app->tabs->tabCount(); i++) {
        printf(" %s%s%s", (i == app->tabs->selected) ? "[" : "", app->tabs->titleOf(i), (i == app->tabs->selected) ? "]" : "");
        if (app->tabs->isModified(i)) { printf("*"); }
    }
    printf("\n");
}

void text(char* label) {
    char* t = e->getText();
    printf("%s: [", label);
    for (int i = 0; t[i] != 0 && i < 200; i++) { printf("%c", (t[i] == 10) ? '|' : t[i]); }
    printf("]\n");
    asys.free(t);
}

int main() {
    gcode.theLook()->autoComplete = false;
    rmtree("build/tests/t257_project");
    asys.mkdirs("build/tests/t257_project/src");
    put("build/tests/t257_project/src/main.a", "int helper(int a) {\n    return a * 2;\n}\n\nint main() {\n    printlnInt(helper(21));\n    return 0;\n}\n");
    put("build/tests/t257_project/src/broken.a", "int main() {\n    return missing(1);\n}\n");
    put("build/tests/t257_project/README.md", "# demo\n");
    startServerSized(7357, "t257", 1100, 800);
    gcode.theLook()->setThemeName("dark");
    app = new CodeDemo(d, "build/tests/t257_project", "build/tests/t257_project/settings.ini");
    app->compilerPath = "build/ac";
    e = app->editor;
    e->blink = false;
    settle();
    rows("start");
    printf("the explorer shows the project: %d rows, first %s\n", app->tree->visibleCount(), app->tree->nameAt(0));
    printf("title: %s, focus in the editor %d\n", app->win->title, app->win->focusWidget == e);
    printf("palette commands: %d, quick open index: %d files\n", app->commands->count, app->quick->count);

    // opening files from the explorer: a double click on a row, Enter
    app->tree->revealRel("src/main.a");
    settle();
    int r = app->tree->selected;
    int ry = app->tree->headerH + (r - app->tree->top) * app->tree->rowH + app->tree->rowH / 2;
    app->tree->dblMs = 100000;
    hb->click(screenX(app->win, app->tree, 80), screenY(app->win, app->tree, ry));
    hb->click(screenX(app->win, app->tree, 80), screenY(app->win, app->tree, ry));
    settle();
    rows("main.a opened");
    printf("the editor shows it: language %s, %d lines, title %s\n", asyntax.languageName(e->doc->lang), e->buf->lineCount(), app->win->title);
    printf("the outline lists its functions: %d symbols, first %s\n", app->outline->symbolCount(), "helper");
    app->tree->focusMe();
    app->tree->select(app->tree->indexOfPath("README.md"));
    key(adp.KEY_ENTER, 13);
    rows("README.md opened too");
    app->tree->focusMe();
    app->tree->select(app->tree->indexOfPath("src/main.a"));
    key(adp.KEY_ENTER, 13);
    rows("main.a again: no second tab");

    // editing: the tab shows the modified marker; Ctrl+S saves
    e->focusMe();
    e->gotoLine(4, 0);
    settle();
    typeStr("// a comment");
    key(adp.KEY_ENTER, 13);
    rows("typed");
    ctrl('s');
    rows("Ctrl+S");
    char* disk = asys.readFile("build/tests/t257_project/src/main.a", null, 1000, null);
    printf("on disk: %s\n", (strstr(disk, "// a comment") != null) ? "the comment is there" : "NOT SAVED");
    asys.free(disk);
    printf("status message: %s\n", app->status->bar->text(gcode.ST_MESSAGE));

    // find and go to line
    ctrl('f');
    printf("Ctrl+F: find bar open %d, replace row %d, focus in the field %d\n", app->find->isOpen(), app->find->replaceVisible, app->win->focusWidget == (gui.Widget*) app->find->findBox);
    typeStr("return");
    printf("find: %d matches, selected [%s]\n", app->find->matchCount, e->getSelectedText());
    key(adp.KEY_ESCAPE, 27);
    printf("Esc: closed %d, focus in the editor %d\n", !app->find->isOpen(), app->win->focusWidget == e);
    ctrl('g');
    typeStr("2");
    key(adp.KEY_ENTER, 13);
    printf("Ctrl+G 2: caret line %d\n", e->ed->caretLine());
    ctrl('h');
    printf("Ctrl+H: replace row %d\n", app->find->replaceVisible);
    key(adp.KEY_ESCAPE, 27);

    // the command palette and the bars of the window
    keyMods('p', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    printf("Ctrl+Shift+P: palette open %d\n", app->palette->open);
    typeStr("sidebar");
    key(adp.KEY_ENTER, 13);
    printf("Toggle Sidebar: sidebar visible %d, centre starts at x %d\n", app->dock->sideVisible, app->dock->center->x);
    ctrl('b');
    printf("Ctrl+B: sidebar visible %d\n", app->dock->sideVisible);
    ctrl('j');
    printf("Ctrl+J: bottom visible %d\n", app->dock->bottomVisible);
    ctrl('j');

    // quick open and go to symbol
    ctrl('p');
    typeStr("brok");
    printf("quick open: %d matches, first %s\n", app->palette->shownCount(), app->palette->shownLabel(0));
    key(adp.KEY_ENTER, 13);
    rows("broken.a opened by name");
    keyMods('o', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    printf("symbols: %d\n", app->palette->itemCount());
    key(adp.KEY_ESCAPE, 27);
    app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/src/main.a")));
    keyMods('o', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    typeStr("main");
    key(adp.KEY_ENTER, 13);
    printf("symbol main: caret line %d\n", e->ed->caretLine());

    // building (needs processes)
    printf("processes can be started: %d\n", asys.canSpawn());
    if (asys.canSpawn()) {
        app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/src/broken.a")));
        settle();
        key(adp.KEY_F1 + 6, 0);
        for (int i = 0; i < 400 && app->output->jobRunning; i++) { d->pump(25); }
        settle();
        printf("F7 on broken.a: finished, exit code %d, errors %d\n", app->output->exitCode, app->output->errorCount());
        printf("the problems list shows: %s\n", app->output->problems->messageAt(0));
        printf("the document has the marker: %d mark(s), on line %d\n", e->doc->nmarks, e->doc->marks[0].line);
        printf("the problems tab is shown: %d\n", app->output->problemsShown());
        // a click in the problems list jumps (the file is open already)
        app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/README.md")));
        gcode.ProblemsView* pv = app->output->problems;
        clickWd(app->win, pv, 100, pv->headerH + pv->rowH / 2);
        rows("after a click on the problem");
        printf("jumped: caret line %d (the error is on line 2)\n", e->ed->caretLine());

        // a program that builds and runs
        app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/src/main.a")));
        settle();
        key(adp.KEY_F1 + 4, 0);
        for (int i = 0; i < 400 && app->output->jobRunning; i++) { d->pump(25); }
        for (int i = 0; i < 200 && app->terminal->term->lineText(0)[0] == 0; i++) { d->pump(25); }
        for (int i = 0; i < 20; i++) { d->pump(25); }
        settle();
        printf("F5: exit code %d, errors %d, the terminal is shown: %d\n", app->output->exitCode, app->output->errorCount(), app->bottomPanel->selected() == 1);
        bool found = false;
        for (int rr = 0; rr < app->terminal->term->rows; rr++) {
            if (strstr(app->terminal->lineText(rr), "42") != null) { found = true; }
        }
        printf("the program printed 42 in the terminal: %d\n", found);
        app->terminal->stop();
        app->bottomPanel->select(0);
        app->output->showOutput();
    }

    // closing a changed tab asks first
    app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/README.md")));
    e->focusMe();
    typeStr("x");
    rows("README.md changed");
    ctrl('w');
    printf("Ctrl+W on a changed tab: the tab is still there %d\n", app->tabs->tabCount());
    key(adp.KEY_TAB, 9);
    key(adp.KEY_ENTER, 13);
    rows("No keeps it");
    ctrl('w');
    key(adp.KEY_ENTER, 13);
    rows("Yes closes it");
    ctrl('w');
    rows("an unchanged tab closes at once");

    // the quit question and the settings file
    app->newFile();
    e->focusMe();
    typeStr("unsaved");
    printf("quit with a changed tab asks: %d\n", app->quit());
    settle();
    settle();
    key(adp.KEY_TAB, 9);
    key(adp.KEY_ENTER, 13);
    printf("No: window still open %d\n", !app->win->closed);
    printf("settings file written when quitting for real: ");
    app->saveSettings();
    printf("%d\n", asys.isFile("build/tests/t257_project/settings.ini"));

    // the pictures of the whole window (the same on every target: what only a build leaves behind is removed first)
    app->output->clear();
    app->output->detachJob();
    asys.unlink("build/tests/t257_project/src/main.a.out");
    asys.unlink("build/tests/t257_project/src/broken.a.out");
    app->tree->refreshAll();
    app->bottomPanel->select(0);
    app->dock->showSidebar(true);
    app->dock->showBottom(true);
    app->tree->collapseAll();
    app->tree->revealRel("src/main.a");
    app->tabs->select(app->tabs->indexOfData((int) app->findDoc("build/tests/t257_project/src/main.a")));
    e->gotoLine(5, 4);
    app->status->setMessage("ready");
    settle();
    int darkShot = shot(app->win);
    printf("dark screenshot %u\n", darkShot);
    gcode.theLook()->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(app->win));
    gcode.theLook()->setThemeName("monokai");
    settle();
    printf("monokai screenshot %u\n", shot(app->win));
    gcode.theLook()->setThemeName("dark");
    settle();
    printf("dark again is the same picture: %d\n", shot(app->win) == darkShot);
    return 0;
}
