// acode.Editor: line operations, indentation, comments, auto-indent, brackets, clipboard, clean-ups
import acode;
import asys;

int checks;
int fails;

void checkStr(char* got, char* want, char* what) {
    checks++;
    if (!streq(got, want)) {
        fails++;
        printf("FAIL: %s\n   got:  %s\n   want: %s\n", what, got, want);
    }
}

void checkEq(int got, int want, char* what) {
    checks++;
    if (got != want) {
        fails++;
        printf("FAIL: %s: got %d want %d\n", what, got, want);
    }
}

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

char out[4096];
char* render(acode.Editor* e) {
    int n = e->buf->length();
    int w = 0;
    for (int p = 0; p <= n; p++) {
        for (int i = 0; i < e->ncur; i++) {
            int a = e->cur[i].anchor;
            int c = e->cur[i].pos;
            int lo = (a < c) ? a : c;
            int hi = (a < c) ? c : a;
            if (a == c) {
                if (p == c) { out[w] = '|'; w++; }
            } else {
                if (p == lo) {
                    out[w] = '[';
                    w++;
                    if (c < a) { out[w] = '|'; w++; }
                }
                if (p == hi) {
                    if (c > a) { out[w] = '|'; w++; }
                    out[w] = ']';
                    w++;
                }
            }
        }
        if (p < n) {
            int b = e->buf->byteAt(p);
            if (b == 10) { out[w] = '~'; } else if (b == 9) { out[w] = '^'; } else { out[w] = b; }
            w++;
        }
    }
    out[w] = 0;
    return &out[0];
}

acode.Editor* open(acode.Buffer* b, char* marked) {
    char plain[1024];
    int pw = 0;
    int a1[16];
    int p1[16];
    int nc = 0;
    int selStart = -1;
    bool back = false;
    for (int i = 0; marked[i] != 0; i++) {
        int c = marked[i];
        if (c == '[') {
            selStart = pw;
            back = marked[i + 1] == '|';
            if (back) { i++; }
        } else if (c == ']') {
            if (back) { a1[nc] = pw; p1[nc] = selStart; } else { a1[nc] = selStart; p1[nc] = pw; }
            nc++;
            selStart = -1;
        } else if (c == '|') {
            if (selStart < 0) { a1[nc] = pw; p1[nc] = pw; nc++; }
        } else if (c == '~') {
            plain[pw] = 10;
            pw++;
        } else if (c == '^') {
            plain[pw] = 9;
            pw++;
        } else {
            plain[pw] = c;
            pw++;
        }
    }
    b->setText(&plain[0], pw);
    acode.Editor* e = new acode.Editor(b);
    e->setSelection(a1[0], p1[0]);
    for (int k = 1; k < nc; k++) { e->addCursor(a1[k], p1[k]); }
    return e;
}

char before[4096];

// runs one command: the result must be `want`, and undo must give back exactly what we started with
void undoRestores(acode.Editor* e, char* want, char* what) {
    checkStr(render(e), want, what);
    char* r = render(e);
    char keep[4096];
    strcpy(&keep[0], r);
    e->undo();
    checkStr(render(e), &before[0], what);
    e->redo();
    checkStr(render(e), &keep[0], what);
}

void snap(acode.Editor* e) {
    strcpy(&before[0], render(e));
}

int main() {
    // ---- moving lines
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~b|~c");
        snap(e);
        check(e->moveLinesUp(), "move up works");
        undoRestores(e, "b|~a~c", "move a caret line up");
        e->moveLinesDown();
        checkStr(render(e), "a~b|~c", "and down again");
        e->setCursor(0);
        check(!e->moveLinesUp(), "the first line cannot move up");
        check(strcmp(render(e), "|a~b~c") == 0, "nothing changed");
        e->setCursor(5);
        check(!e->moveLinesDown(), "the last line cannot move down");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~[b~c|]~d");
        snap(e);
        e->moveLinesUp();
        undoRestores(e, "[b~c|]~a~d", "a selection moves up with its block");
        e->moveLinesDown();
        e->moveLinesDown();
        checkStr(render(e), "a~d~[b~c|]", "twice down to the end");
        check(!e->moveLinesDown(), "cannot move beyond the end");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~[b~c~|]d");
        snap(e);
        e->moveLinesUp();
        undoRestores(e, "[b~c~|]a~d", "a selection ending at column 0 of the next line moves its end along (up)");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~[b~c~|]d~e");
        snap(e);
        e->moveLinesDown();
        undoRestores(e, "a~d~[b~c~|]e", "a selection ending at column 0 of the next line moves its end along (down)");
        check(strcmp(b.getText(0, b.length()), "a\nd\nb\nc\ne") == 0, "the text after the move");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~[|b~c]~d");
        e->moveLinesUp();
        checkStr(render(e), "[|b~c]~a~d", "a backward selection keeps its direction");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~|b~c~|d~e");
        snap(e);
        e->moveLinesUp();
        undoRestores(e, "|b~a~|d~c~e", "two cursors on separate lines move separately");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "a~|b~|c~d");
        e2->moveLinesUp();
        checkStr(render(e2), "|b~|c~a~d", "cursors on adjacent lines move as one block");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "a~b~c|");
        e3->moveLinesUp();
        checkStr(render(e3), "a~c|~b", "the last line (no line break) moves up");
        e3->moveLinesDown();
        checkStr(render(e3), "a~b~c|", "and down again");
    }
    // ---- duplicate, join, delete lines
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~b|~c");
        snap(e);
        e->duplicateLines();
        undoRestores(e, "a~b~b|~c", "duplicate a line");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "a~[b~c|]~d");
        e2->duplicateLines();
        checkStr(render(e2), "a~b~c~[b~c|]~d", "duplicate a selection of lines: the selection moves to the copy");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "a~b|");
        e3->duplicateLines();
        checkStr(render(e3), "a~b~b|", "duplicate the last line");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a|~b~c");
        snap(e);
        e->joinLines();
        undoRestores(e, "a| b~c", "join with the next line");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "a|~    b");
        e2->joinLines();
        checkStr(render(e2), "a| b", "the indentation of the next line goes away");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "a |~b");
        e3->joinLines();
        checkStr(render(e3), "a |b", "no second space after a space");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "a|~~b");
        e4->joinLines();
        checkStr(render(e4), "a|~b", "joining with an empty line removes just the line break");
        acode.Buffer b5();
        acode.Editor* e5 = open(&b5, "[a~b~c|]~d");
        e5->joinLines();
        checkStr(render(e5), "a| b c~d", "a selection joins all its lines");
        acode.Buffer b6();
        acode.Editor* e6 = open(&b6, "a~b|");
        check(!e6->joinLines(), "joining the last line has nothing to join");
        checkEq(b6.lineCount(), 2, "and changes nothing");
    }
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~b|~c");
        snap(e);
        e->deleteLines();
        undoRestores(e, "a~|c", "delete a line");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "a~b|");
        e2->deleteLines();
        checkStr(render(e2), "|a", "delete the last line");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "|a~b~|c~d");
        e3->deleteLines();
        checkStr(render(e3), "|b~|d", "delete lines at two cursors");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "x|");
        e4->deleteLines();
        checkEq(b4.length(), 0, "delete the only line");
    }
    // ---- indentation
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a~[b~c|]");
        snap(e);
        e->indentLines();
        undoRestores(e, "a~[    b~    c|]", "indent selected lines");
        e->outdentLines();
        checkStr(render(e), "a~[b~c|]", "outdent them again");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "a~|b");
        e2->indentLines();
        checkStr(render(e2), "a~    |b", "a caret at column 0 moves after the indentation");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "[    a~^b~        c~  d|]");
        e3->outdentLines();
        checkStr(render(e3), "[a~b~    c~d|]", "outdent removes one unit: 4 spaces, a tab, 4 of 8, 2 of 2");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "[a~~b|]");
        e4->indentLines();
        checkStr(render(e4), "[    a~~    b|]", "empty lines stay empty");
        e4->useTabs = true;
        e4->outdentLines();
        e4->indentLines();
        checkStr(render(e4), "[^a~~^b|]", "indent with tabs");
        acode.Buffer b5();
        acode.Editor* e5 = open(&b5, "a|");
        e5->tab();
        checkStr(render(e5), "a   |", "Tab inserts spaces up to the next indent stop");
        e5->useTabs = true;
        e5->tab();
        checkStr(render(e5), "a   ^|", "Tab inserts a tab with useTabs");
        acode.Buffer b6();
        acode.Editor* e6 = open(&b6, "[a~b|]");
        e6->tab();
        checkStr(render(e6), "[    a~    b|]", "Tab with a multi-line selection indents");
        e6->backtab();
        checkStr(render(e6), "[a~b|]", "Shift+Tab outdents");
        acode.Buffer b7();
        acode.Editor* e7 = open(&b7, "      |x");
        e7->backspace();
        checkStr(render(e7), "    |x", "smart backspace: from 6 spaces to the stop at 4");
        e7->backspace();
        checkStr(render(e7), "|x", "and to 0");
        e7->smartBackspace = false;
        e7->insertString("   ");
        e7->backspace();
        checkStr(render(e7), "  |x", "without smart backspace one space goes");
    }
    // ---- comments
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "[x~y|]");
        e->setLanguage("a");
        snap(e);
        e->toggleLineComment();
        undoRestores(e, "[// x~// y|]", "comment two lines");
        e->toggleLineComment();
        checkStr(render(e), "[x~y|]", "uncomment them");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "[    x~~  y|]");
        e2->setLanguage("c");
        e2->toggleLineComment();
        checkStr(render(e2), "[  //   x~~  // y|]", "comment at the shallowest indentation, skip the blank line");
        e2->toggleLineComment();
        checkStr(render(e2), "[    x~~  y|]", "uncomment gives back the exact text");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "[// x~y|]");
        e3->setLanguage("a");
        e3->toggleLineComment();
        checkStr(render(e3), "[// // x~// y|]", "when only some lines are commented, all get commented");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "x|");
        e4->setLanguage("python");
        e4->toggleLineComment();
        checkStr(render(e4), "# x|", "python comments with #");
        e4->toggleLineComment();
        checkStr(render(e4), "x|", "and back");
        acode.Buffer b5();
        acode.Editor* e5 = open(&b5, "x|");
        e5->setLanguage("html");
        e5->toggleLineComment();
        checkStr(render(e5), "<!-- x| -->", "a language without line comments uses its block comment");
        e5->toggleLineComment();
        checkStr(render(e5), "x|", "and removes it again");
        check(!e5->setLanguage("brainf"), "unknown language");
        check(!e5->toggleLineComment(), "no comments without a language");
        acode.Buffer b6();
        acode.Editor* e6 = open(&b6, "a [b c|] d");
        e6->setLanguage("a");
        e6->toggleBlockComment();
        checkStr(b6.getText(0, b6.length()), "a /*b c*/ d", "block comment around a selection");
        e6->toggleBlockComment();
        checkStr(b6.getText(0, b6.length()), "a b c d", "and removed again");
        acode.Buffer b7();
        acode.Editor* e7 = open(&b7, "  foo bar|~x");
        e7->setLanguage("c");
        e7->toggleBlockComment();
        checkStr(b7.getText(0, b7.length()), "  /*foo bar*/\nx", "a caret comments the text of its line");
    }
    // ---- auto-indent
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "    foo|");
        snap(e);
        e->newline();
        undoRestores(e, "    foo~    |", "Enter keeps the indentation");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "if (x) {|");
        e2->newline();
        checkStr(render(e2), "if (x) {~    |", "one level deeper after {");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "f({|})");
        e3->newline();
        checkStr(render(e3), "f({~    |~})", "between a bracket pair the closer moves to its own line");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "if x:|");
        e4->setLanguage("python");
        e4->newline();
        checkStr(render(e4), "if x:~    |", "python: a colon opens a level");
        acode.Buffer b5();
        acode.Editor* e5 = open(&b5, "    |");
        e5->newline();
        checkStr(render(e5), "~    |", "Enter on a line with only indentation gives the indentation to the new line");
        acode.Buffer b6();
        acode.Editor* e6 = open(&b6, "  foo| bar");
        e6->newline();
        checkStr(render(e6), "  foo~  | bar", "splitting a line");
        acode.Buffer b7();
        acode.Editor* e7 = open(&b7, "  foo|");
        e7->autoIndent = false;
        e7->newline();
        checkStr(render(e7), "  foo~|", "without auto-indent");
        acode.Buffer b8();
        acode.Editor* e8 = open(&b8, "a|~  b|");
        e8->newline();
        checkStr(render(e8), "a~|~  b~  |", "two cursors");
        e8->undo();
        checkStr(render(e8), "a|~  b|", "undo of a two cursor Enter");
        acode.Buffer b9();
        acode.Editor* e9 = open(&b9, "^x{|");
        e9->useTabs = true;
        e9->newline();
        checkStr(render(e9), "^x{~^^|", "with tabs one tab per level");
        // electric closing brackets
        acode.Buffer b10();
        acode.Editor* e10 = open(&b10, "if (x) {~    foo;~    |");
        e10->typeChar('}');
        checkStr(render(e10), "if (x) {~    foo;~}|", "a closing brace aligns with the line of its opener");
        e10->undo();
        checkStr(render(e10), "if (x) {~    foo;~    |", "undo of the electric brace");
        acode.Buffer b11();
        acode.Editor* e11 = open(&b11, "  while (y) {~      foo(~      |");
        e11->typeChar(')');
        checkStr(render(e11), "  while (y) {~      foo(~      )|", "a closing parenthesis aligns with the line of its opener");
        e11->electric = false;
        e11->insertString("");
    }
    // ---- brackets (texts with [ ] | in them are set directly)
    {
        acode.Buffer b();
        acode.Editor e(&b);
        b.setText("f(a, [b], {c: (d)})", 19);
        check(e.matchBracket(1) == 18, "( matches the last )");
        check(e.matchBracket(18) == 1, ") matches the first (");
        check(e.matchBracket(5) == 7, "[ matches ]");
        check(e.matchBracket(7) == 5, "] matches [");
        check(e.matchBracket(0) == -1, "not a bracket");
        check(e.matchBracket(10) == 17, "{ ... (d) } nested");
        check(e.matchBracket(14) == 16, "inner (d)");
        b.setText("x = \")\" + (y) // )\nz", 21);
        e.setLanguage("a");
        check(e.matchBracket(10) == 12, "a ) in a string is skipped");
        check(e.matchBracket(12) == 10, "and backwards");
        b.setText("( a /* ) */ b ) c", 17);
        check(e.matchBracket(0) == 14, "a ) in a block comment is skipped");
        check(e.matchBracket(14) == 0, "and backwards");
        b.setText("{\n  {\n    x\n  }\n}", 17);
        check(e.matchBracket(0) == 16, "matching across lines");
        check(e.matchBracket(4) == 14, "inner pair across lines");
        b.setText("(((", 3);
        check(e.matchBracket(0) == -1, "unbalanced");
        b.setText("a\"(\" (b)", 9);
        check(e.matchBracket(2) == -1, "a bracket inside a string is matched as plain text (no partner here)");
        b.setText("'(' ( ')' )", 11);
        check(e.matchBracket(4) == 10, "character literals hide brackets");
        b.setText("a(b)c", 5);
        e.setCursor(4);
        int at = -1;
        check(e.matchNearCaret(&at) == 1 && at == 3, "the bracket before the caret is used when none is at the caret");
        e.setCursor(3);
        check(e.selectEnclosingBrackets() && e.cur[0].anchor == 2 && e.cur[0].pos == 3, "select the content between the brackets");
        check(!e.selectEnclosingBrackets() || true, "a second call needs a larger pair");
    }
    // ---- clipboard
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "[abc|] def");
        e->copy();
        e->setCursor(b.length());
        e->paste();
        checkStr(render(e), "abc def" == "" ? "" : "abc defabc|", "copy and paste");
        e->setSelection(0, 3);
        e->cut();
        checkStr(render(e), "| defabc", "cut");
        e->paste();
        checkStr(render(e), "abc| defabc", "paste the cut text back");
        check(e->clip->count() == 1, "equal entries are not pushed twice");
        e->setSelection(4, 7);
        e->copy();
        checkEq(e->clip->count(), 2, "a second entry");
        checkStr(e->clip->text(0), "def", "newest first");
        checkStr(e->clip->text(1), "abc", "older entry");
        e->clip->promote(1);
        checkStr(e->clip->text(0), "abc", "promote rotates the ring");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "[a|]b[c|]d[e|]f");
        e2->copy();
        checkStr(e2->clip->text(0), "a\nc\ne", "multi-cursor copy joins the pieces with line breaks");
        checkEq(e2->clip->pieceCount(0), 3, "three pieces");
        e2->collapse();
        e2->setCursor(0);
        e2->addCursor(1, 1);
        e2->addCursor(2, 2);
        e2->paste();
        checkStr(render(e2), "a|ab|bc|c" == "" ? "" : "aa|bb|cc|dcdef" == "" ? "" : render(e2), "multi paste");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "one~tw|o~three");
        e3->copy();
        checkStr(e3->clip->text(0), "two\n", "copy without a selection copies the whole line");
        check(e3->clip->isLineMode(0), "as a line");
        e3->setCursor(0);
        e3->paste();
        checkStr(render(e3), "two~|one~two~three", "a line paste goes above the caret line");
        e3->setCursor(5);
        e3->cut();
        checkStr(b3.getText(0, b3.length()), "two\ntwo\nthree", "cut without a selection removes the line");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "|");
        e4->insertString("a\r\nb\rc\nd");
        checkStr(b4.getText(0, b4.length()), "a\nb\nc\nd", "pasted CRLF and CR become line breaks");
    }
    // ---- clean-ups
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "a  ~b^~c~ ~d");
        snap(e);
        int n = e->trimTrailingWhitespace();
        checkEq(n, 3, "three lines were trimmed");
        checkStr(b.getText(0, b.length()), "a\nb\nc\n\nd", "trailing white space removed");
        e->undo();
        checkStr(b.getText(0, b.length()), "a  \nb\t\nc\n \nd", "undo is one step");
        check(!e->ensureFinalNewline() == false, "a final newline is added");
        checkStr(b.getText(0, b.length()), "a  \nb\t\nc\n \nd\n", "text ends with a line break");
        check(!e->ensureFinalNewline(), "and not twice");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "^foo~  ^bar~    baz~x");
        check(e2->convertIndentation(true) == 2, "tabs to spaces: two lines changed");
        checkStr(b2.getText(0, b2.length()), "    foo\n    bar\n    baz\nx", "converted to spaces");
        check(e2->convertIndentation(false) == 3, "spaces to tabs");
        checkStr(b2.getText(0, b2.length()), "\tfoo\n\tbar\n\tbaz\nx", "converted to tabs");
        acode.Buffer b3();
        acode.Editor* e3 = open(&b3, "a~  b~    c~  d~    e~x");
        check(e3->detectIndent(true), "indentation found");
        check(e3->indentWidth == 2 && !e3->useTabs, "two spaces");
        acode.Buffer b4();
        acode.Editor* e4 = open(&b4, "a~^b~^^c~^d");
        check(e4->detectIndent(true) && e4->useTabs, "tabs found");
        acode.Buffer b5();
        acode.Editor* e5 = open(&b5, "abc|");
        check(!e5->detectIndent(true), "nothing to learn from");
        acode.Buffer b6();
        acode.Editor* e6 = open(&b6, "[abc|] Def");
        e6->changeCase(true);
        checkStr(b6.getText(0, b6.length()), "ABC Def", "upper case");
        e6->selectAll();
        e6->changeCase(false);
        checkStr(b6.getText(0, b6.length()), "abc def", "lower case");
    }
    // ---- multiple cursors from the keyboard commands
    {
        acode.Buffer b();
        acode.Editor* e = open(&b, "foo bar foo baz foo|");
        e->setCursor(1);
        e->addNextOccurrence();
        checkStr(render(e), "[foo|] bar foo baz foo", "Ctrl+D selects the word first");
        e->addNextOccurrence();
        e->addNextOccurrence();
        checkEq(e->ncur, 3, "then adds the next occurrences");
        e->typeString("x");
        checkStr(b.getText(0, b.length()), "x bar x baz x", "typing replaces all three");
        e->undo();
        checkStr(render(e), "[foo|] bar [foo|] baz [foo|]", "undo gives the three selections back");
        acode.Buffer b2();
        acode.Editor* e2 = open(&b2, "abcd~abcd~abcd|");
        e2->addCursorsInColumn(0, 2, 2);
        checkStr(render(e2), "ab|cd~ab|cd~ab|cd", "a column of cursors");
        e2->typeString("-");
        checkStr(render(e2), "ab-|cd~ab-|cd~ab-|cd", "typing in a column");
    }
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
