// aidecore: the project file (with run configurations and sections that this version does not know), build plans, words and quoting,
// snippets, templates, recovery copies, the session, scales
import asys;
import acode;
import aproject;
import aidecore;

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

void rmtree(char* path) {
    asys.Stat st;
    if (asys.lstat(path, &st) != 0) { return; }
    if (st.isDir()) {
        asys.DirList dl();
        if (asys.listDir(path, &dl) >= 0) {
            for (int i = 0; i < dl.count; i++) {
                char* child = asys.join(path, dl.name(i));
                rmtree(child);
                asys.free(child);
            }
            dl.dispose();
        }
        asys.rmdir(path);
    } else {
        asys.unlink(path);
    }
}

void showWords(char* line) {
    aidecore.Words w(line);
    printf("words(%s): %d", line, w.count);
    for (int i = 0; i < w.count; i++) { printf(" [%s]", w.argv[i]); }
    printf("\n");
    w.dispose();
}

void showPlan(aidecore.BuildPlan* b) {
    if (b == null) { printf("  no plan\n"); return; }
    printf("  custom=%d check=%d display=%s", b->custom ? 1 : 0, b->check ? 1 : 0, b->display);
    printf("  out=%s source=%s\n", b->outPath, b->source != null ? b->source : "-");
}

char* text(acode.Buffer* b) {
    char* t = asys.strDup(b->flatten());
    for (int i = 0; t[i] != 0; i++) { if (t[i] == 10) { t[i] = '|'; } }
    return t;
}

int main() {
    rmtree("build/tests/t280");
    asys.mkdirs("build/tests/t280/proj/src");

    printf("== helpers\n");
    showWords("");
    showWords("a b   c");
    showWords("-x 'a b' c \"d e\" '' f");
    showWords("one'two three'four \"it's\"");
    char* q = aidecore.shellQuote("it's a $file");
    printf("quote: %s\n", q);
    asys.free(q);
    char* one[3];
    one[0] = "ac";
    one[1] = "my file.a";
    one[2] = "-r";
    char* cl = aidecore.commandLineText(&one[0], 3);
    printf("command line: %s", cl);
    asys.free(cl);
    printf("base %s dir %s | %s %s\n", aidecore.baseName("/a/b/c.a"), "x", aidecore.baseName("plain"), aidecore.baseName("/a/b/"));
    char* dn = aidecore.dirName("/a/b/c.a");
    char* dn2 = aidecore.dirName("c.a");
    char* dn3 = aidecore.dirName("/c.a");
    printf("dirName: %s %s %s\n", dn, dn2, dn3);
    asys.free(dn); asys.free(dn2); asys.free(dn3);
    printf("relativeTo: %s | %s | %s | %s\n", aidecore.relativeTo("/p", "/p/src/m.a"), aidecore.relativeTo("/p/", "/p/m.a"), aidecore.relativeTo("/p", "/pq/m.a"), aidecore.relativeTo("/p", "/p"));
    printf("parseNumber: %d %d %d\n", aidecore.parseNumber("42abc"), aidecore.parseNumber("x"), aidecore.parseNumber("0007"));
    printf("scales: %d first %d last %d; nearest 90 -> %d, 140 -> %d, 1000 -> %d, 0 -> %d\n", aidecore.scaleCount(), aidecore.scaleAt(0), aidecore.scaleAt(5), aidecore.nearestScale(90), aidecore.nearestScale(140), aidecore.nearestScale(1000), aidecore.nearestScale(0));

    printf("== project file\n");
    aidecore.Project p();
    int r = p.load("build/tests/t280/proj");
    printf("load without a file: %d (loaded %d) version %d config %s main '%s'\n", r < 0 ? 1 : 0, p.loaded ? 1 : 0, p.version, p.release ? "release" : "debug", p.mainFile);
    put("build/tests/t280/proj/.aide", "; a comment\n[project]\nname = Demo\nmain = src/main.a\nbuild =\nrun = --verbose input.txt\nignore = build, *.tmp\nflags = -D DEBUG=1 -x \"a b\"\noutput =\ntarget = windows\nversion = 7\nconfig = release\n\n"
        "[run Fast]\nprogram = /bin/echo\nargs = fast 'two words'\ncwd = src\nenv = A=1 B='x y'\n\n[run Slow]\nargs = slow\n\n[colors]\nkeyword = red\n# trailing\n");
    r = p.load("build/tests/t280/proj");
    printf("load: %d loaded %d name %s main %s run '%s'\n", r, p.loaded ? 1 : 0, p.name, p.mainFile, p.runArgs);
    printf("  ignore '%s' flags '%s' target %s version %d %s\n", p.ignore, p.flags, p.target, p.version, p.release ? "release" : "debug");
    printf("run configurations: %d\n", p.nruns);
    for (int i = 0; i < p.nruns; i++) {
        aidecore.RunConfig* rc = p.runs[i];
        printf("  %s: program '%s' args '%s' cwd '%s' env '%s'\n", rc->name, rc->program, rc->args, rc->cwd, rc->env);
    }
    char* mp = p.mainPath();
    printf("main path: %s\n", mp);
    asys.free(mp);
    char* on = p.defaultOutputName("/x/y/prog.a");
    printf("default output: %s\n", on);
    asys.free(on);
    p.target = asys.strDup("");
    on = p.defaultOutputName("noext");
    printf("default output (no extension, no target): %s\n", on);
    asys.free(on);
    // change something and save: the colours section of the file stays
    p.addRun("Third")->args = asys.strDup("3");
    p.removeRun("Slow");
    p.version = 8;
    printf("save: %d\n", p.save());
    char* saved = asys.readFile("build/tests/t280/proj/.aide", null, 100000, null);
    printf("---\n%s---\n", saved);
    asys.free(saved);
    aidecore.Project p2();
    p2.load("build/tests/t280/proj");
    printf("reloaded: %d run configurations, version %d, Third args '%s', Fast env '%s'\n", p2.nruns, p2.version, p2.findRun("Third")->args, p2.findRun("Fast")->env);
    printf("findRun missing: %d, remove missing: %d, add existing keeps it: %d\n", p2.findRun("nope") == null ? 1 : 0, p2.removeRun("nope") ? 1 : 0, p2.addRun("Fast") == p2.findRun("Fast") ? 1 : 0);
    // another program added a run configuration to the file: reloadRuns takes them in (the other settings stay)
    {
        char* more = asys.readFile("build/tests/t280/proj/.aide", null, 100000, null);
        char* more2 = asys.concat3(more, "\n[run Added]\nargs = -q\n", "");
        put("build/tests/t280/proj/.aide", more2);
        asys.free(more);
        asys.free(more2);
        p2.version = 99;
        p2.reloadRuns();
        printf("reloadRuns: %d configurations, Added args '%s', version still %d\n", p2.nruns, p2.findRun("Added")->args, p2.version);
    }
    // a hostile file: long lines, section names, odd keys
    put("build/tests/t280/proj/.aide", "[run ]\nargs = x\n[run a\nargs=y\n[project]\nversion = -5\nconfig = nonsense\n[run X]\nargs = 1\n[run X]\ncwd = c\n");
    p2.load("build/tests/t280/proj");
    printf("odd file: %d runs, version %d, %s, X args '%s' cwd '%s'\n", p2.nruns, p2.version, p2.release ? "release" : "debug", p2.findRun("X") ? p2.findRun("X")->args : "?", p2.findRun("X") ? p2.findRun("X")->cwd : "?");
    char* fs = aidecore.foreignSections("[project]\nname=a\n[other]\nx=1\n\n[run A]\nb=2\n[tail]\ny=2");
    printf("foreign: %s\n", fs != null ? fs : "(none)");
    asys.free(fs);
    fs = aidecore.foreignSections("[project]\nname=a\n");
    printf("foreign of nothing: %s\n", fs != null ? fs : "(none)");

    printf("== build plans\n");
    aidecore.Project b();
    b.load("/proj");
    b.name = asys.strDup("demo");
    aidecore.BuildPlan* plan = aidecore.makeBuildPlan(&b, "/proj/src/main.a", "/bin/ac", false, null);
    showPlan(plan);
    plan->dispose();
    b.release = true;
    b.version = 3;
    b.flags = asys.strDup("-D X=1 -q \"a b\"");
    b.target = asys.strDup("linux-arm64");
    plan = aidecore.makeBuildPlan(&b, "/proj/main.a", "/bin/ac", false, null);
    showPlan(plan);
    printf("  argc %d last '%s'\n", plan->argc, plan->argv[plan->argc - 1]);
    plan->dispose();
    plan = aidecore.makeBuildPlan(&b, "/proj/main.a", "/bin/ac", true, "/tmp/check/out");
    showPlan(plan);
    plan->dispose();
    b.output = asys.strDup("bin/app");
    plan = aidecore.makeBuildPlan(&b, "/proj/main.a", "/bin/ac", false, null);
    showPlan(plan);
    plan->dispose();
    b.output = asys.strDup("/abs/app");
    plan = aidecore.makeBuildPlan(&b, "/other/place/x.a", "/bin/ac", false, null);
    showPlan(plan);
    plan->dispose();
    b.buildCmd = asys.strDup("make all");
    plan = aidecore.makeBuildPlan(&b, null, null, false, null);
    showPlan(plan);
    plan->dispose();
    b.output = asys.strDup("");
    plan = aidecore.makeBuildPlan(&b, null, null, false, null);
    showPlan(plan);
    plan->dispose();
    plan = aidecore.makeBuildPlan(&b, "/proj/main.a", "/bin/ac", true, null);
    showPlan(plan);
    plan->dispose();
    b.buildCmd = asys.strDup("");
    plan = aidecore.makeBuildPlan(&b, null, "/bin/ac", false, null);
    printf("no source, no command: %s\n", plan == null ? "no plan" : "plan");
    char* cd = aidecore.makeCheckDir();
    printf("check dir made: %d, is a folder: %d, name: %s\n", cd != null ? 1 : 0, cd != null && asys.isDir(cd) ? 1 : 0, cd != null && strstrAt(cd, "aide-check-") ? "aide-check-..." : "?");
    if (cd != null) { asys.rmdir(cd); }
    char* rl = aidecore.runShellLine("/work dir", "A=1 B='x y' bad C=it's", "/p/my prog", "--flag 'a b'");
    printf("run line: %s\n", rl);
    asys.free(rl);

    printf("== ignore rules\n");
    put("build/tests/t280/proj/.gitignore", "*.log\nout/\n");
    p2.load("build/tests/t280/proj");
    p2.ignore = asys.strDup("build, *.tmp ; secret.txt");
    aproject.Ignore* ig = p2.makeIgnore();
    char* names[8];
    names[0] = "a.log"; names[1] = "a.tmp"; names[2] = "secret.txt"; names[3] = "main.a"; names[4] = ".git"; names[5] = ".aide"; names[6] = "build"; names[7] = "src";
    for (int i = 0; i < 8; i++) { printf("  %s: %s\n", names[i], ig->ignored(names[i], i >= 4) ? "ignored" : "shown"); }

    printf("== snippets\n");
    aidecore.SnippetSet sn();
    printf("built in: %d, main at %d, nothing at %d\n", sn.count, sn.find("main"), sn.find("zzz"));
    acode.Buffer buf();
    acode.Editor ed(&buf);
    buf.setText("void f() {\n    \n}\n", 17);
    ed.setCursor(13);
    printf("insert if in a block: %d\n", sn.insert(&buf, &ed, sn.find("if"), -1) ? 1 : 0);
    char* t1 = text(&buf);
    printf("  text: %s caret %d\n", t1, ed.caret());
    asys.free(t1);
    buf.setText("    ma", 6);
    ed.setCursor(6);
    printf("expand 'ma' (no snippet): %d\n", sn.expandWord(&buf, &ed) ? 1 : 0);
    buf.setText("    main", 8);
    ed.setCursor(8);
    printf("expand main: %d\n", sn.expandWord(&buf, &ed) ? 1 : 0);
    t1 = text(&buf);
    printf("  text: %s caret %d\n", t1, ed.caret());
    asys.free(t1);
    buf.setText("x = main", 8);
    ed.setCursor(8);
    printf("expand after code: %d\n", sn.expandWord(&buf, &ed) ? 1 : 0);
    buf.setText("", 0);
    ed.setCursor(0);
    ed.useTabs = true;
    sn.insert(&buf, &ed, sn.find("switch"), -1);
    ed.useTabs = false;
    t1 = text(&buf);
    printf("tabs: %s\n", t1);
    asys.free(t1);
    put("build/tests/t280/proj/snippets.ini", "; mine\nhi = println(\"hi\\n\");\\n$0\nclass = class mine {\\n\\t$0\\n}\nbad name with = x\n");
    int added = sn.load("build/tests/t280/proj");
    printf("user snippets: %d added, now %d; class replaced: %d\n", added, sn.count, strstrAt(sn.texts[sn.find("class")], "mine") ? 1 : 0);
    buf.setText("", 0);
    ed.setCursor(0);
    sn.insert(&buf, &ed, sn.find("hi"), -1);
    t1 = text(&buf);
    printf("hi: %s caret %d\n", t1, ed.caret());
    asys.free(t1);
    buf.readOnly = true;
    printf("read only: %d, bad index: %d\n", sn.insert(&buf, &ed, 0, -1) ? 1 : 0, sn.insert(&buf, &ed, 999, -1) ? 1 : 0);
    buf.readOnly = false;

    printf("== templates\n");
    for (int k = 0; k < aidecore.TPL_COUNT; k++) {
        char dir[100];
        format(&dir[0], 100, "build/tests/t280/tpl%d", k);
        char* mainPath = null;
        int nr = aidecore.newProject(k, &dir[0], "demo", &mainPath);
        char* src = asys.readFile(mainPath, null, 100000, null);
        aidecore.Project tp();
        tp.load(&dir[0]);
        printf("%d %s: %d, main %s, %d bytes, project name %s main %s, readme %d\n", k, aidecore.templateName(k), nr, mainPath, strlen(src), tp.name, tp.mainFile, asys.isFile("build/tests/t280/tpl0/README.md") ? 1 : 0);
        printf("   %s\n", aidecore.templateInfo(k));
        printf("   mentions the program name: %d\n", strstrAt(src, "demo") ? 1 : 0);
        tp.dispose();
        asys.free(src);
        asys.free(mainPath);
    }
    char* mp2 = null;
    printf("again in the same folder: %d\n", aidecore.newProject(0, "build/tests/t280/tpl0", "demo", &mp2));
    printf("bad kind: %d, bad names: %d %d %d %d\n", aidecore.newProject(9, "build/tests/t280/x", "demo", &mp2), aidecore.validProjectName("") ? 1 : 0, aidecore.validProjectName("a b") ? 1 : 0, aidecore.validProjectName(".hidden") ? 1 : 0, aidecore.validProjectName("ok-name_1.2") ? 1 : 0);
    printf("a file where the folder should be: %d\n", aidecore.newProject(0, "build/tests/t280/tpl0/main.a", "demo", &mp2) < 0 ? 1 : 0);
    char* ts = aidecore.templateSource(aidecore.TPL_CONSOLE, "tool");
    printf("console template mentions tool-1-debug.elf: %d\n", strstrAt(ts, "tool-1-debug.elf") ? 1 : 0);
    asys.free(ts);

    printf("== recovery\n");
    asys.mkdirs("build/tests/t280/cfg");
    aidecore.Recovery rec("build/tests/t280/cfg");
    printf("save: %d\n", rec.save(5, "/proj/main.a", "main.a", "hello\nworld\n", 12));
    printf("save new doc: %d\n", rec.save(6, "", "untitled-1", "x", 1));
    printf("save too long title: %d\n", rec.save(7, "", "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345", "x", 1));
    printf("scan sees none of this live instance: %d\n", rec.scan());
    // the record of a dead instance (a process number that does not exist)
    asys.writeFile("build/tests/t280/cfg/recovery/99999999-3.rec", "AIDE-RECOVERY 1\n/old/file.a\nfile.a\nint x;\nline two\n", 47);
    asys.writeFile("build/tests/t280/cfg/recovery/99999999-4.rec", "garbage", 7);
    printf("scan: %d\n", rec.scan());
    for (int i = 0; i < rec.count; i++) {
        aidecore.RecoveryItem* it = rec.items[i];
        char* tt = asys.strDupN(it->text, it->len);
        for (int k = 0; tt[k] != 0; k++) { if (tt[k] == 10) { tt[k] = '|'; } }
        printf("  path %s title %s len %d text %s\n", it->path, it->title, it->len, tt);
        asys.free(tt);
    }
    rec.release(0, true);
    printf("after discarding it: %d\n", rec.scan());
    rec.remove(5);
    rec.remove(6);
    printf("lock: touch, alive %d, dead process %d\n", (rec.touchLock(), rec.instanceAlive(aidecore.selfPid())) ? 1 : 0, rec.instanceAlive(99999999) ? 1 : 0);
    rec.removeLock();
    rec.dispose();

    printf("== session\n");
    aidecore.Session s("build/tests/t280/cfg", "/home/me/proj");
    printf("load without file: %d files %d\n", s.load() < 0 ? 1 : 0, s.count);
    s.add("/home/me/proj/a.a", 10, 4, 2, 0);
    s.add("/home/me/proj/b b.a", 0, 0, 0, 0);
    setSession(&s);
    printf("save: %d\n", s.save());
    aidecore.Session s2("build/tests/t280/cfg", "/home/me/proj");
    printf("same file for the same project: %d\n", streq(s.path, s2.path) ? 1 : 0);
    printf("load: %d files %d active %s wrap %d\n", s2.load(), s2.count, s2.active, s2.wrap ? 1 : 0);
    for (int i = 0; i < s2.count; i++) { printf("  %s at %d,%d scroll %d,%d\n", s2.files[i], s2.lines[i], s2.cols[i], s2.scrollLines[i], s2.scrollCols[i]); }
    printf("extras: run '%s' split %d side %d missing '%s' default %d\n", s2.extra("run"), s2.extraInt("split", -1), s2.extraInt("side", -1), s2.extra("nope"), s2.extraInt("nope", 77));
    aidecore.Session s3("build/tests/t280/cfg", "/home/me/other");
    printf("another project has another file: %d\n", streq(s.path, s3.path) ? 0 : 1);
    s3.dispose();
    s2.dispose();
    s.dispose();
    p.dispose();
    p2.dispose();
    b.dispose();
    return 0;
}

void setSession(aidecore.Session* s) {
    s->active = asys.strDup("/home/me/proj/b b.a");
    s->wrap = true;
    s->setExtra("run", "Fast");
    s->setExtraInt("split", 1);
    s->setExtraInt("side", 240);
    s->setExtra("run", "Fast run");
}

bool strstrAt(char* s, char* sub) {
    return contains(s, sub);
}
