int main() {
    // if / else if / else
    for (int i = 0; i < 5; i++) {
        if (i == 0) print("zero ");
        else if (i == 1) print("one ");
        else if (i < 4) print("few ");
        else print("many ");
    }
    println("");
    // while
    int n = 0;
    while (n < 5) { n++; }
    printlnInt(n);
    // do while
    int k = 10;
    do { k--; } while (k > 5);
    printlnInt(k);
    // for with break / continue
    int sum = 0;
    for (int i = 0; i < 100; i++) {
        if (i % 2 == 0) continue;
        if (i > 20) break;
        sum += i;
    }
    printlnInt(sum);
    // nested loops with break
    int c = 0;
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (j > i) break;
            c++;
        }
    }
    printlnInt(c);
    // infinite for with break
    int z = 0;
    for (;;) { z++; if (z == 7) break; }
    printlnInt(z);
    // while with continue
    int w = 0; int t = 0;
    while (w < 10) { w++; if (w % 3 != 0) continue; t += w; }
    printlnInt(t);
    // do-while with continue
    int d = 0; int e = 0;
    do { d++; if (d == 2) continue; e += d; } while (d < 4);
    printlnInt(e);
    return 0;
}
