char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";
char* STRANGER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPzCB5qADAgECAggQooP33JMRCDAKBggqhkjOPQQDAjATMREwDwYDVQQDDAhP\ndGhlciBDQTAgFw0yMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowFDESMBAG\nA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAESGzdSqEX\nfcdvOu7FW5LokaFUX6T3H+Uv6Phce9S06Dw9oh5p2phKAMqbGn8NL20emZetycF1\nyFTn/teSJ1Bt3aMhMB8wDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwR/AAABMAoG\nCCqGSM49BAMCA0gAMEUCIQDN+ASE1vNvveEm/4o9If40ZlMUQWP6kr0zrWnk1taQ\n9QIgYVrITfLWZqRs9cbjtTaEDcrOadDwvBx1R+R1f5qk01s=\n-----END CERTIFICATE-----\n";
char* STRANGER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2Hn4c01UmR2L+x+7\nDlLis81vDspgD6J4c2wPo8uS7W2hRANCAARIbN1KoRd9x2867sVbkuiRoVRfpPcf\n5S/o+Fx71LToPD2iHmnamEoAypsafw0vbR6Zl63JwXXIVOf+15InUG3d\n-----END PRIVATE KEY-----\n";

// MQTT over TLS (mqtts://): the broker listens on a plain and on a TLS port at the same time, clients verify the certificate against a CA,
// a certificate of an unknown CA is refused, verification can be switched off, plain and TLS clients talk to each other, large messages and QoS 2
// work through the TLS layer, reconnecting after a drop makes a new handshake, a client of the wrong kind on a port fails cleanly, and a TLS
// connection that never finishes its handshake is dropped.
import mqtt;
import mqttd;
import net;
import tls;
import x509;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

mqttd.Server* srv;

int hook() {
    srv->poll(0);
    return 0;
}

void settle(int rounds = 15) {
    for (int i = 0; i < rounds; i++) srv->poll(1);
}

bool online(mqtt.Client* c, int ms) {
    int t0 = millis();
    while (millis() - t0 < ms) {
        c->poll(5);
        srv->poll(0);
        if (c->state == mqtt.ST_ONLINE) return true;
    }
    return false;
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    tls.Config* stranger = tls.loadConfig(STRANGER_CERT, STRANGER_KEY);
    check("the test certificates load", good != null && stranger != null);
    srv = mqttd.newServer();
    srv->broker->sysIntervalMs = 0;
    check("the broker listens on a plain port", srv->listenOn("127.0.0.1", 0, null));
    check("... and on a TLS port", srv->listenOn("127.0.0.1", 0, good));
    int plainPort = srv->net->listenerPort(0);
    int tlsPort = srv->net->listenerPort(1);
    check("the two ports differ", plainPort > 0 && tlsPort > 0 && plainPort != tlsPort);
    net.setIdleHook(hook);
    char turl[100];
    char purl[100];
    format(&turl[0], 100, "mqtts://127.0.0.1:%d", tlsPort, 0, 0, 0);
    format(&purl[0], 100, "mqtt://127.0.0.1:%d", plainPort, 0, 0, 0);
    mqttd.Broker* b = srv->broker;

    // ---- verified TLS ----------------------------------------------------------------------------------------------------------------------------------
    mqtt.Client* a = mqtt.connect(&turl[0]);
    check("mqtts: connect, the certificate is verified against the CA", a != null && a->state == mqtt.ST_ONLINE);
    if (a == null) return 1;
    check("subscribe over TLS", a->subscribeWait("tls/#", 2, 3000) == 2);
    mqtt.Client* p = mqtt.connect(&purl[0]);
    check("a plain client on the plain port", p != null && p->state == mqtt.ST_ONLINE);
    check("plain -> TLS: QoS 1", p->publishWait("tls/one", "from plain", 10, 1, false, 3000));
    mqtt.Message* m = a->waitMessage(2000);
    check("... arrives", m != null && streq(m->payload, "from plain") && m->qos == 1);
    if (m != null) m->dispose();
    p->subscribeWait("plain/#", 1, 3000);
    check("TLS -> plain: QoS 2", a->publishWait("plain/two", "from tls", 8, 2, false, 3000));
    m = p->waitMessage(2000);
    check("... arrives", m != null && streq(m->payload, "from tls") && m->qos == 1);
    if (m != null) m->dispose();
    char* big = alloc(150000);
    for (int i = 0; i < 150000; i++) big[i] = i * 7;
    check("150000 bytes with QoS 2 over TLS", a->publishWait("tls/big", big, 150000, 2, false, 8000));
    m = a->waitMessage(3000);
    check("... come back intact", m != null && m->payloadLen == 150000 && memcmp(m->payload, big, 150000) == 0);
    if (m != null) m->dispose();
    for (int i = 0; i < 200; i++) a->publishText("tls/n", "burst", 1, false);
    check("200 messages with QoS 1 over TLS", a->flushAll(8000));
    int n = 0;
    m = a->waitMessage(500);
    while (m != null) { n++; m->dispose(); m = a->waitMessage(300); }
    check("... all come back", n == 200);
    check("the broker counts one TLS and one plain client", b->connected == 2);

    // ---- certificates that are not accepted ---------------------------------------------------------------------------------------------------------------
    x509.clearRoots();
    check("without a trusted CA the connection is refused", mqtt.connect(&turl[0]) == null && strlen(mqtt.error()) > 5);
    mqtt.Options v();
    v.verify = false;
    mqtt.Client* nv = mqtt.connectWith(&turl[0], &v);
    check("with verify off it works", nv != null && nv->state == mqtt.ST_ONLINE);
    if (nv != null) { nv->disconnect(); nv->dispose(); }
    x509.addRootPem(CA_PEM);
    srv->net->shutdown();
    srv->broker->dispose();
    srv = mqttd.newServer();
    srv->broker->sysIntervalMs = 0;
    srv->listenOn("127.0.0.1", 0, stranger);
    char surl[100];
    format(&surl[0], 100, "mqtts://127.0.0.1:%d", srv->port, 0, 0, 0);
    check("a certificate of an unknown CA is refused", mqtt.connect(&surl[0]) == null && strlen(mqtt.error()) > 5);
    nv = mqtt.connectWith(&surl[0], &v);
    check("... unless verification is off", nv != null);
    if (nv != null) { nv->disconnect(); nv->dispose(); }
    srv->net->shutdown();
    srv->broker->dispose();
    a->dispose();
    p->dispose();

    // ---- the wrong kind of client on a port ---------------------------------------------------------------------------------------------------------------
    srv = mqttd.newServer();
    srv->broker->sysIntervalMs = 0;
    srv->listenOn("127.0.0.1", 0, null);
    srv->listenOn("127.0.0.1", 0, good);
    plainPort = srv->net->listenerPort(0);
    tlsPort = srv->net->listenerPort(1);
    b = srv->broker;
    format(&turl[0], 100, "mqtts://127.0.0.1:%d", tlsPort, 0, 0, 0);
    format(&purl[0], 100, "mqtt://127.0.0.1:%d", plainPort, 0, 0, 0);
    char wrong[100];
    format(&wrong[0], 100, "mqtt://127.0.0.1:%d", tlsPort, 0, 0, 0);
    mqtt.Options quick();
    quick.connectTimeoutMs = 700;
    check("mqtt:// to the TLS port fails", mqtt.connectWith(&wrong[0], &quick) == null && strlen(mqtt.error()) > 3);
    format(&wrong[0], 100, "mqtts://127.0.0.1:%d", plainPort, 0, 0, 0);
    check("mqtts:// to the plain port fails", mqtt.connectWith(&wrong[0], &quick) == null && strlen(mqtt.error()) > 3);
    settle(30);
    check("both failures left nothing behind in the broker", b->connected == 0 && b->peerCount() == 0 && srv->net->count() == 0);

    // a TLS connection that never completes its handshake
    srv->net->handshakeTimeoutMs = 300;
    int h = net.connect("127.0.0.1", tlsPort);
    settle(5);
    check("a silent connection to the TLS port is counted", srv->net->count() == 1);
    int t0 = millis();
    while (srv->net->count() > 0 && millis() - t0 < 2000) srv->poll(5);
    check("... and dropped after the handshake time out", srv->net->count() == 0 && srv->net->stats->tlsFailures >= 1);
    net.close(h);
    // garbage instead of a ClientHello
    h = net.connect("127.0.0.1", tlsPort);
    net.send(h, "this is not a TLS handshake at all, just text\r\n", 47);
    t0 = millis();
    while (srv->net->count() > 0 && millis() - t0 < 2000) srv->poll(5);
    check("garbage instead of a ClientHello: dropped", srv->net->count() == 0);
    net.close(h);

    // ---- reconnect over TLS ---------------------------------------------------------------------------------------------------------------------------------
    mqtt.Options ro();
    ro.autoReconnect = true;
    ro.reconnectMinMs = 20;
    ro.reconnectMaxMs = 80;
    ro.clientId = "tlsrc";
    ro.cleanSession = false;
    mqtt.Client* r = mqtt.connectWith(&turl[0], &ro);
    check("a TLS client with autoReconnect", r != null);
    r->subscribeWait("rc/#", 1, 3000);
    srv->dropClients();
    settle();
    r->poll(100);
    check("after the broker drops it, it makes a new TLS handshake and is back", online(r, 5000) && r->sessionPresent);
    mqtt.Client* q = mqtt.connect(&purl[0]);
    q->publishWait("rc/x", "again", 5, 1, false, 3000);
    m = r->waitMessage(2000);
    check("... with its subscription", m != null && streq(m->payload, "again"));
    if (m != null) m->dispose();
    r->disconnect();
    q->disconnect();
    r->dispose();
    q->dispose();
    settle();
    check("everything is closed again", b->connected == 0 && srv->net->count() == 0);

    printf("%d checks, %d failed\n", checks, fails);
    srv->shutdown();
    return fails == 0 ? 0 : 1;
}
