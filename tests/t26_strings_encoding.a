import strings;
import encoding;
import hash;

int main() {
    strings.StringBuilder sb;
    sb.append("x = "); sb.appendInt(-42); sb.appendChar(';'); sb.append(" done");
    println(sb.view()); printlnInt(sb.length());
    for (int i = 0; i < 100; i++) sb.appendChar('a' + i % 26);
    printlnInt(sb.length()); char* copy = sb.toString(); sb.clear(); printlnInt(strlen(copy)); printlnInt(sb.length());

    println(strings.concat("foo", "bar")); println(strings.repeat("ab", 3)); println(strings.reverse("stressed"));
    printlnInt(strings.count("banana", "an")); printlnInt(strings.count("aaaa", "aa")); printlnInt(strings.lastIndexOf("a/b/c", '/'));
    println(strings.replace("one fish two fish", "fish", "cat")); println(strings.replace("aaa", "a", "bb")); println(strings.replace("abc", "x", "y"));
    println(strings.padLeft("7", 3, '0')); println(strings.padRight("ab", 5, '.')); println(strings.padLeft("toolong", 3, ' '));
    printBool(strings.isBlank("  \t ")); printBool(strings.isBlank(" x ")); println("");
    println(strings.capitalize("hello")); println(strings.upper("MiXed")); println(strings.lower("MiXed"));
    char* parts[8];
    int n = strings.split("a,b,,cd,e", ',', parts, 8);
    printlnInt(n);
    for (int i = 0; i < n; i++) { print("["); print(parts[i]); print("]"); }
    println("");
    println(strings.join(parts, n, "-"));
    printlnInt(strings.split("x", ',', parts, 8));
    printlnInt(strings.split("1 2 3 4", ' ', parts, 2));

    // base64 / hex / url
    println(encoding.base64Encode("", 0)); println(encoding.base64Encode("f", 1)); println(encoding.base64Encode("fo", 2));
    println(encoding.base64Encode("foo", 3)); println(encoding.base64Encode("foobar", 6));
    println(encoding.base64Encode("Hello, A language!", 18));
    char out[64];
    int len = encoding.base64Decode("SGVsbG8sIEEgbGFuZ3VhZ2Uh", out); out[len] = 0; println(out); printlnInt(len);
    printlnInt(encoding.base64Decode("@@@", out));
    println(encoding.hexEncode("A\xff\x00z", 4));
    len = encoding.hexDecode("48656c6C6f", out); out[len] = 0; println(out);
    printlnInt(encoding.hexDecode("abc", out)); printlnInt(encoding.hexDecode("zz", out));
    println(encoding.urlEncode("a b&c=d/é~_.-")); println(encoding.urlDecode("a%20b%26c+d%zz"));

    // hashes
    printHex(hash.fnv1a("hello", 5)); println(""); printHex(hash.djb2("hello", 5)); println("");
    printHex(hash.adler32("Wikipedia", 9)); println(""); printHex(hash.crc32("123456789", 9)); println("");
    printlnInt(hash.crc32("", 0));
    println(hash.sha256("", 0)); println(hash.sha256("abc", 3));
    println(hash.sha256("The quick brown fox jumps over the lazy dog", 43));
    char* big = alloc(1000);
    for (int i = 0; i < 1000; i++) big[i] = 'a' + i % 26;
    println(hash.sha256(big, 1000));
    println(hash.sha256(big, 55)); println(hash.sha256(big, 56)); println(hash.sha256(big, 64));
    return 0;
}
