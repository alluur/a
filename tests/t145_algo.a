// algo: sorting with comparators, searching, permutations, selection, sequences, strings, union-find, graphs
import cstdio;
import cstdlib;
import algo;

int byLast(int a, int b) { return (a % 10) <=> (b % 10); }

void show(int* a, int n) {
    for (int i = 0; i < n; i++) { printf("%d ", a[i]); }
    printf("\n");
}

int main() {
    int a[8] = { 31, 12, 53, 24, 41, 62, 13, 22 };
    algo.sortBy(a, 8, byLast);
    printf("stable by last digit: "); show(a, 8);
    algo.sortDesc(a, 8);
    printf("descending: "); show(a, 8);
    algo.reverse(a, 8);
    printf("reversed: "); show(a, 8);

    int s[7] = { 1, 3, 3, 3, 7, 9, 9 };
    printf("bounds: %d %d %d %d, count of 3: %d, count of 5: %d\n", algo.lowerBound(s, 7, 3), algo.upperBound(s, 7, 3), algo.lowerBound(s, 7, 8), algo.upperBound(s, 7, 100), algo.countEqual(s, 7, 3), algo.countEqual(s, 7, 5));
    int n = algo.unique(s, 7);
    printf("unique %d: ", n); show(s, n);

    int r[6] = { 1, 2, 3, 4, 5, 6 };
    algo.rotate(r, 6, 2);
    printf("rotate 2: "); show(r, 6);
    algo.rotate(r, 6, -2);
    printf("rotate -2: "); show(r, 6);

    int p[3] = { 1, 2, 3 };
    int count = 1;
    printf("permutations: "); show(p, 3);
    while (algo.nextPermutation(p, 3)) { count++; show(p, 3); }
    printf("%d permutations, back to ", count); show(p, 3);

    int k[9] = { 9, 4, 7, 1, 8, 2, 6, 3, 5 };
    printf("kth: %d %d %d\n", algo.kthSmallest(k, 9, 0), algo.kthSmallest(k, 9, 4), algo.kthSmallest(k, 9, 8));
    int q[6] = { 5, 1, 8, 2, 9, 3 };
    printf("partition: %d\n", algo.partition(q, 6, 5));

    int m[9] = { -2, 1, -3, 4, -1, 2, 1, -5, 4 };
    printf("max subarray %d, lis %d, max at %d, min at %d, sum %d\n", algo.maxSubarray(m, 9), algo.lis(m, 9), algo.indexOfMax(m, 9), algo.indexOfMin(m, 9), algo.sum(m, 9));

    printf("edit: %d %d %d\n", algo.editDistance("kitten", "sitting"), algo.editDistance("", "abc"), algo.editDistance("same", "same"));
    printf("lcs: %d %d\n", algo.lcsLength("ABCBDAB", "BDCABA"), algo.lcsLength("abc", "xyz"));
    printf("kmp: %d %d %d, occurrences %d\n", algo.kmpFind("hello world", "o w"), algo.kmpFind("aaaaab", "aab"), algo.kmpFind("abc", "d"), algo.countOccurrences("abababa", "aba"));
    printf("subsequence: %d %d\n", algo.isSubsequence("ace", "abcde"), algo.isSubsequence("aec", "abcde"));

    char* flags = malloc(101);
    printf("primes up to 100: %d, 97 prime %d, 91 prime %d\n", algo.sieve(100, flags), flags[97], flags[91]);
    int w[4] = { 1, 3, 4, 5 };
    int v[4] = { 1, 4, 5, 7 };
    printf("knapsack: %d\n", algo.knapsack(w, v, 4, 7));

    algo.UnionFind* u = new algo.UnionFind(6);
    u->unite(0, 1); u->unite(2, 3); u->unite(1, 3);
    printf("union-find: groups %d, same(0,2) %d, same(0,4) %d, repeat unite %d\n", u->groups, u->same(0, 2), u->same(0, 4), u->unite(0, 3));

    algo.Graph* g = new algo.Graph(6);
    g->edge(0, 1, 7); g->edge(0, 2, 9); g->edge(0, 5, 14);
    g->edge(1, 2, 10); g->edge(1, 3, 15);
    g->edge(2, 3, 11); g->edge(2, 5, 2);
    g->edge(3, 4, 6); g->edge(5, 4, 9);
    int order[6];
    int cnt = g->bfs(0, order);
    printf("bfs %d: ", cnt); show(order, cnt);
    cnt = g->dfs(0, order);
    printf("dfs %d: ", cnt); show(order, cnt);
    int dist[6];
    g->dijkstra(0, dist);
    printf("dijkstra: "); show(dist, 6);
    printf("topological: %d: ", g->topological(order)); show(order, 6);
    g->edge(4, 0, 1);
    printf("with a cycle: %d\n", g->topological(order));
    algo.Graph* h = new algo.Graph(5);
    h->undirected(0, 1, 1); h->undirected(3, 4, 1);
    printf("components %d, path 0-1 %d, path 0-3 %d\n", h->components(), h->hasPath(0, 1), h->hasPath(0, 3));
    return 0;
}
