// window list and minimize (taskbar protocol), icon buttons, toolbar, text block, calendar and date dialog, notifications,
// busy progress bar
import wsrv;
import gui;
import guix;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
int clicks = 0;
int dateGot = -1;
int listCalls = 0;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

void waitMs(int ms) {
    int t0 = millis();
    while (millis() - t0 < ms) {
        srv->step(0);
        d->pump(5);
    }
    settle();
}

int onClick(int self) { clicks++; return 0; }
int onList(int display) { listCalls++; return 0; }
int gotDate(int packed) { dateGot = packed; return 0; }

void showList() {
    d->requestWindowList();
    settle();
    for (int i = 0; i < d->nWinList; i++) {
        gui.WinInfo* wi = d->winList[i];
        print(wi->title);
        print(" ");
        printlnInt(wi->state);
    }
}

void clickAt(gui.Window* gw, gui.Widget* wd, int x, int y) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    hb->click(sw->x + wd->absX() + x, sw->y + wd->absY() + y);
    settle();
}

void tap(int k) {
    hb->tap(k, 0);
    settle();
}

int main() {
    hb = new wsrv.Headless(800, 600);
    srv = new wsrv.Server(hb, 7217);
    gui.idleHook = stepServer;
    d = gui.connectAs("7217", "extras");
    d->onWinList = onList;

    // ---- the window list and minimizing ---------------------------------------------------------------------------------------------------
    gui.Window* one = d->createWindow("One", 200, 100, 0);
    one->setRoot(new gui.Label("first"));
    gui.Window* two = d->createWindow("Two", 200, 100, 0);
    two->setRoot(new gui.Label("second"));
    gui.Window* panel = d->createWindowAt("panel", 0, 570, 800, 30, adp.F_NODECOR | adp.F_ABOVE | adp.F_NOFOCUS);
    panel->setRoot(new gui.Label("panel"));
    settle();
    showList();
    printlnInt(listCalls);
    gui.WinInfo* w1 = d->winList[0];
    gui.WinInfo* w2 = d->winList[1];
    // minimize "Two" with a command: the focus goes to "One"
    d->windowCommand(w2->gid, adp.WC_MINIMIZE);
    settle();
    showList();
    printlnInt(srv->focus != null && srv->focus->cid == one->id);
    // activate brings it back with the focus
    d->windowCommand(w2->gid, adp.WC_ACTIVATE);
    settle();
    showList();
    printlnInt(srv->focus != null && srv->focus->cid == two->id);
    // the minimize button in the title bar
    wsrv.Win* sw = srv->findWindow(d->clientNum, two->id);
    hb->click(sw->x + sw->w - 54, sw->y - 13);
    settle();
    showList();
    printlnInt(srv->focus != null && srv->focus->cid == one->id);
    // a minimized window gets no clicks: Alt+Tab skips it
    hb->keyDown(adp.KEY_ALT, 0);
    hb->tap(adp.KEY_TAB, 0);
    hb->keyUp(adp.KEY_ALT, 0);
    settle();
    printlnInt(srv->focus != null && srv->focus->cid == one->id);
    d->windowCommand(w2->gid, adp.WC_ACTIVATE);
    d->windowCommand(w1->gid, adp.WC_MAXIMIZE);
    settle();
    showList();
    d->windowCommand(w1->gid, adp.WC_MAXIMIZE);
    settle();
    // a command for the panel (not listed) does nothing
    two->close();
    one->close();
    panel->close();
    settle();
    showList();

    // ---- icon buttons and the toolbar -------------------------------------------------------------------------------------------------------
    gui.Window* w = d->createWindow("Tools", 360, 420, 0);
    gui.Box* col = gui.vbox(6, 0);
    guix.Toolbar* tb = new guix.Toolbar();
    guix.IconButton* save = tb->addButton(guix.ICON_SAVE, "Save", onClick);
    tb->addSeparator();
    guix.IconButton* star = tb->addButton(guix.ICON_STAR, "Favourite", onClick);
    star->toggle = true;
    guix.IconButton* off = tb->addButton(guix.ICON_TRASH, "Delete", onClick);
    off->enabled = false;
    col->add(tb);
    guix.TextBlock* text = new guix.TextBlock("The quick brown fox jumps over the lazy dog and keeps running through the forest until night.\nSecond paragraph.");
    text->wrapWidth = 200;
    col->add(text);
    guix.Calendar* cal = new guix.Calendar();
    cal->setDate(2024, 2, 28);
    col->add(cal);
    guix.StatusBar* status = new guix.StatusBar();
    status->addSection(0);
    status->addSection(80);
    status->setText(0, "ready");
    status->setText(1, "x");
    col->add(status);
    gui.ProgressBar* bar = new gui.ProgressBar();
    col->add(bar);
    w->setRoot(col);
    settle();
    clickAt(w, save, 14, 14);
    clickAt(w, star, 14, 14);
    printlnInt(clicks * 10 + (star->checked ? 1 : 0));
    clickAt(w, star, 14, 14);
    printlnInt(clicks * 10 + (star->checked ? 1 : 0));
    clickAt(w, off, 14, 14);
    printlnInt(clicks);
    println(star->tooltip);
    star->focusMe();
    tap(adp.KEY_SPACE);
    printlnInt(star->checked);
    printlnInt(tb->h);

    // ---- the text block --------------------------------------------------------------------------------------------------------------------------
    int narrow = text->prefH();
    text->wrapWidth = 600;
    int wide = text->prefH();
    printlnInt(narrow);
    printlnInt(wide);
    text->wrapWidth = 200;

    // ---- the calendar ------------------------------------------------------------------------------------------------------------------------------
    cal->focusMe();
    tap(adp.KEY_RIGHT);
    printlnInt(cal->packed());
    tap(adp.KEY_RIGHT);
    printlnInt(cal->packed());
    tap(adp.KEY_PGDN);
    printlnInt(cal->packed());
    tap(adp.KEY_UP);
    printlnInt(cal->packed());
    cal->setDate(2024, 2, 28);
    settle();
    clickAt(w, cal, 15, 30 + 22 + 2 * 24 + 12);          // row 2, column 0 of February 2024
    printlnInt(cal->packed());
    clickAt(w, cal, cal->w - 10, 15);                    // next month
    clickAt(w, cal, 30 + 15, 30 + 22 + 1 * 24 + 12);     // row 1, column 1 of March 2024
    printlnInt(cal->packed());
    hb->moveTo(500, 300);
    clickAt(w, cal, 10, 15);                             // previous month
    clickAt(w, cal, 15, 30 + 22 + 24 + 12);
    printlnInt(cal->packed());

    // ---- the busy progress bar ----------------------------------------------------------------------------------------------------------------
    int before = srv->screen->checksum();
    bar->start();
    waitMs(250);
    int during = srv->screen->checksum();
    printlnInt(before != during);
    bar->stop();
    settle();
    int after = srv->screen->checksum();
    waitMs(150);
    printlnInt(after == srv->screen->checksum());
    w->close();
    settle();

    // ---- the date dialog ---------------------------------------------------------------------------------------------------------------------
    int base = srv->windowCount();
    guix.chooseDate(d, "Date", 2030, 5, 17, gotDate);
    settle();
    printlnInt(srv->windowCount() - base);
    tap(adp.KEY_RIGHT);
    tap(adp.KEY_ENTER);
    printlnInt(dateGot);
    printlnInt(srv->windowCount() - base);
    guix.chooseDate(d, "Date", 2030, 5, 17, gotDate);
    settle();
    wsrv.Win* dw = srv->windowAt(srv->windowCount() - 1);
    hb->click(dw->x + dw->w + 2 - 12, dw->y - 26 + 13);
    settle();
    printlnInt(dateGot);

    // ---- notifications ---------------------------------------------------------------------------------------------------------------------------
    base = srv->windowCount();
    gui.Window* n1 = guix.notify(d, "Title", "A message that is long enough to need a second line in the card.", 0, 400);
    gui.Window* n2 = guix.notify(d, "Second", "Another one", 1, 5000);
    settle();
    printlnInt(srv->windowCount() - base);
    wsrv.Win* a = srv->findWindow(d->clientNum, n1->id);
    wsrv.Win* b = srv->findWindow(d->clientNum, n2->id);
    printlnInt(a->x * 1000 + a->y);
    printlnInt(b->x * 1000 + b->y);
    printlnInt(a->w * 1000 + a->h);
    printlnInt(srv->focus == null || (srv->focus != a && srv->focus != b));
    waitMs(600);
    printlnInt(srv->windowCount() - base);
    // a click dismisses the other one
    hb->click(b->x + 20, b->y + 20);
    settle();
    printlnInt(srv->windowCount() - base);
    // the slot of a card is free again
    gui.Window* n3 = guix.notify(d, "Third", "x", 2, 5000);
    settle();
    wsrv.Win* c = srv->findWindow(d->clientNum, n3->id);
    printlnInt(c->x * 1000 + c->y);
    d->disconnect();
    srv->close();
    return 0;
}
