struct Point { int x; int y; }
struct Box { Point lo; Point hi; int tag[3]; char* name; }

int area(Point p) { return p.x * p.y; }
int sum(int* v, int n) { int s = 0; for (int i = 0; i < n; i++) s += v[i]; return s; }

int findIdx(int* v, int n, int want) {
    int i = 0;
loop:
    if (i >= n) goto notfound;
    if (v[i] == want) goto found;
    i++;
    goto loop;
found:
    return i;
notfound:
    return -1;
}

int main() {
    int data[5] = {4, 8, 15, 16, 23};
    printlnInt(findIdx(data, 5, 15));
    printlnInt(findIdx(data, 5, 99));

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (i * 3 + j == 4) goto done;
            printInt(i * 3 + j);
        }
    }
done:
    println("");

    Point p = {.y = 5, .x = 3};
    printlnInt(p.x * 10 + p.y);
    Box b = {.hi = {7, 8}, .tag = {1, 2, 3}, .name = "box"};
    printlnInt(b.hi.x * 10 + b.hi.y);
    printlnInt(b.tag[0] + b.tag[1] + b.tag[2]);
    println(b.name);
    int sparse[6] = {[1] = 10, [4] = 40, 50};
    printlnInt(sparse[1] + sparse[4] + sparse[5] + sparse[0]);

    printlnInt(area((Point){6, 7}));
    printlnInt(area((Point){.y = 3, .x = 4}));
    printlnInt(sum((int[]){1, 2, 3, 4}, 4));
    printlnInt(sum((int[5]){9, 9}, 5));
    Point q;
    q = (Point){11, 22};
    printlnInt(q.x + q.y);
    Point* pp = &(Point){5, 6};
    printlnInt(pp->x * pp->y);
    for (int i = 0; i < 2; i++) printlnInt(area((Point){i + 1, 10}));
    return 0;
}
