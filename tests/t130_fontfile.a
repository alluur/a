// gfx.loadFont: reads the binary font files that AOS's fontgen writes; damaged and missing files give null
import gfx;

bool write(char* path, char* buf, int n) {
    int h = fileOpen(path, FILE_WRITE);
    if (h < 0) { return false; }
    fileWrite(h, buf, n);
    fileClose(h);
    return true;
}

int main() {
    char font[1300];
    font[0] = 10;                  // ascent
    font[1] = 14;                  // line height
    for (int i = 0; i < 224; i++) {
        int p = 2 + i * 5;
        font[p] = 6 + i % 3;       // advance
        font[p + 1] = 0;
        font[p + 2] = 0;
        font[p + 3] = 0;           // no pixels
        font[p + 4] = 0;
    }
    char* path = "build/tests/t130.afont";
    write(path, &font[0], 2 + 224 * 5);
    gfx.Font* f = gfx.loadFont(path);
    println(f != null ? "loaded" : "not loaded");
    printf("ascent %d height %d advance(A) %d advance(a) %d\n", f->ascent, f->height, f->advance('A'), f->advance('a'));
    printf("width %d\n", gfx.textWidth(f, "AaA"), 0, 0, 0);
    gfx.Surface* s = new gfx.Surface(40, 20);
    s->text(f, 2, 2, "AaA", gfx.WHITE);
    println("drawn");
    write(path, &font[0], 500);
    println(gfx.loadFont(path) == null ? "truncated file refused" : "truncated file accepted");
    font[2 + 3] = 40;              // a glyph that claims 40x0 pixels is fine, but 40x255 runs past the end
    font[2 + 4] = 255;
    write(path, &font[0], 2 + 224 * 5);
    println(gfx.loadFont(path) == null ? "overlong glyph refused" : "overlong glyph accepted");
    println(gfx.loadFont("build/tests/no-such-font.afont") == null ? "missing file gives null" : "missing file loaded");
    println(gfx.sans()->height > 0 ? "builtin font still works" : "broken");
    return 0;
}
