// static fields and static methods: Class.name, unqualified use inside the class and its subclasses, access control, instances share the fields
int count = 1000;                          // a global with the same name as a static field below
struct Point { int x; int y; }

class Counter {
public:
    static int count;                      // zero at the start
    static int step = 5;                   // constant initializer
    static int a, b;                       // several at once
    static int table[4];
    static Point origin;
    static char* label = "counter";
    int id;
    Counter() { count++; id = count; }     // count means Counter.count in here (not the global)
    static int next() { count += step; return count; }
    static int twice(int v) { return square(v) + square(v); }
    static int square(int v) { return v * v; }
    static void reset() { count = 0; a = b = 0; }
    int mine() { return id * 100 + count + step; }       // an instance method uses both kinds
    static int sum(int n = 3, int m = 4) { return n + m; }
protected:
    static int hidden = 77;
private:
    static int secret = 9;
public:
    static int peek() { return secret + hidden; }
}

class Derived : Counter {
public:
    static int extra = 3;
    static int viaBase() { return count + step + hidden; }       // protected members of the base class
    int inst() { return square(extra) + hidden; }
}

struct Tag {
    static int made;
    int n;
    static int make() { made++; return made; }
}

double half(double d) { return d / 2.0; }
class Calc {
public:
    static double scale = 2.5;
    static double apply(double d) { return d * scale + half(d); }
    static Point mk(int x, int y) { Point p; p.x = x; p.y = y; return p; }
    static int dist(Point p) { return p.x * p.x + p.y * p.y; }
    static Counter* make() { return new Counter(); }
    static int idOf(Counter* c) { return c->id; }
}

int main() {
    printlnInt(count);                     // the global
    printlnInt(Counter.count);
    Counter c1(); Counter c2(); Counter* c3 = new Counter();
    printlnInt(Counter.count); printlnInt(c1.id); printlnInt(c2.id); printlnInt(c3->id);
    printlnInt(c1.mine()); printlnInt(c3->mine());
    printlnInt(Counter.next()); printlnInt(Counter.next());
    printlnInt(Counter.twice(3)); printlnInt(Counter.square(7));
    printlnInt(Counter.step);
    Counter.step = 2;
    Counter.step += 3;
    Counter.step++;
    printlnInt(Counter.step);
    Counter.a = 4; Counter.b = Counter.a * 2;
    printlnInt(Counter.a + Counter.b);
    foreach (int i in 0..4) { Counter.table[i] = i * i; }
    int total = 0;
    foreach (int v in Counter.table) { total += v; }
    printlnInt(total); printlnInt(sizeof(Counter.table));
    Counter.origin.x = 3; Counter.origin.y = 4;
    printlnInt(Calc.dist(Counter.origin));
    println(Counter.label);
    Counter.reset();
    printlnInt(Counter.count); printlnInt(Counter.a);
    printlnInt(Counter.sum()); printlnInt(Counter.sum(10)); printlnInt(Counter.sum(10, 20));
    printlnInt(Counter.peek());
    // statements that start with a class name
    Counter.reset();
    Counter.next();
    Counter.count--;
    printlnInt(Counter.count);
    // subclasses see the static members of their base class, and add their own
    printlnInt(Derived.count); printlnInt(Derived.next()); printlnInt(Derived.step);
    printlnInt(Derived.extra); printlnInt(Derived.viaBase());
    Derived d();
    printlnInt(d.inst()); printlnInt(Counter.count);
    // structs too
    printlnInt(Tag.make()); printlnInt(Tag.make()); printlnInt(Tag.made);
    // doubles and structs as parameters and results
    printlnDouble(Calc.apply(4.0));
    Point p = Calc.mk(6, 8);
    printlnInt(Calc.dist(p));
    Counter* mk = Calc.make();
    printlnInt(Calc.idOf(mk)); printlnInt(Calc.idOf(Calc.make()));
    // the global is untouched
    printlnInt(count);
    return 0;
}
