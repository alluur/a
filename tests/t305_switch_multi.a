// switch on integers: several labels per case, ranges (both ends included), negative numbers, numbers beyond 32 bits, characters,
// enums, fall-through, default anywhere, nested switches, switches with few labels (compare chain) and with many (binary search)
enum Color { Red, Green = 5, Blue }

int small(int n) {
    switch (n) {
        case 1, 2, 3: return 10;
        case 10..20: return 20;
        case 100: return 30;
        case -5..-1: return 40;
        default: return 0;
    }
}

int kind(int c) {
    switch (c) {
        case 'a'..'z': return 1;
        case 'A'..'Z': return 2;
        case '0'..'9': return 3;
        case ' ', '\t', '\n': return 4;
        case '_': return 5;
    }
    return 0;
}

int bigvals(int n) {
    switch (n) {
        case 0x100000000: return 1;
        case -0x100000000: return 2;
        case 0x7FFFFFFF: return 3;
        case 0x80000000: return 4;
        case 0x7FFFFFFFFFFFFFFF: return 5;
        case -0x7FFFFFFFFFFFFFFF - 1: return 6;
        default: return 0;
    }
}

// 20 labels: the binary search; labels are not in order
int many(int n) {
    switch (n) {
        case 90: return 9;
        case 10: return 1;
        case 50: return 5;
        case 30: return 3;
        case 70: return 7;
        case 20: return 2;
        case 100..110: return 11;
        case 40: return 4;
        case 60: return 6;
        case 80: return 8;
        case 1, 2: return 12;
        case 200: return 13;
        case 300: return 14;
        case -1: return 15;
        case -100..-50: return 16;
        case 1000: return 17;
        case 5000: return 18;
        case 7: return 19;
        case 8: return 20;
        case 9: return 21;
        default: return 0;
    }
}

int colors(Color c) {
    int r = 0;
    switch (c) {
        case Color.Red: r = 1; break;
        case Color.Green, Color.Blue: r = 2; break;
        default: r = 3;
    }
    return r;
}

int fall(int n) {
    int r = 0;
    switch (n) {
        case 1: r += 1;
        case 2: r += 10;
        case 3, 4: r += 100; break;
        default: r += 1000;
        case 5: r += 10000;
    }
    return r;
}

int nested(int a, int b) {
    switch (a) {
        case 1..3:
            switch (b) {
                case 1, 2: return 100 + a;
                case 3..9: return 200 + a;
            }
            return 300 + a;
        case 4:
            return 400;
    }
    return 0;
}

int main() {
    int s = 0;
    foreach (int n in -7..22) { printInt(small(n)); print(","); }
    println("");
    printlnInt(small(100)); printlnInt(small(101)); printlnInt(small(99));
    foreach (int c in "aZ5 _\t!") { printInt(kind(c)); }
    println("");
    printlnInt(kind(96)); printlnInt(kind(123)); printlnInt(kind(64)); printlnInt(kind(91)); printlnInt(kind(47)); printlnInt(kind(58));
    printlnInt(bigvals(4294967296)); printlnInt(bigvals(-4294967296)); printlnInt(bigvals(2147483647)); printlnInt(bigvals(2147483648));
    printlnInt(bigvals(9223372036854775807)); printlnInt(bigvals(-9223372036854775807 - 1)); printlnInt(bigvals(4294967297)); printlnInt(bigvals(0));
    int probes[24] = {90, 10, 50, 30, 70, 20, 100, 105, 110, 111, 99, 40, 60, 80, 1, 2, 3, 200, -1, -75, -50, -49, -101, 5000};
    foreach (int p in probes) { printInt(many(p)); print(" "); }
    println("");
    foreach (int p in (int[]){0, 7, 8, 9, 10, 300, 1000, 1001, 4999, 5001}) { printInt(many(p)); print(" "); }
    println("");
    printlnInt(colors(Color.Red)); printlnInt(colors(Color.Green)); printlnInt(colors(Color.Blue)); printlnInt(colors((Color) 3));
    foreach (int n in 0..7) { printInt(fall(n)); print(" "); }
    println("");
    printlnInt(nested(1, 1)); printlnInt(nested(2, 5)); printlnInt(nested(3, 0)); printlnInt(nested(4, 1)); printlnInt(nested(5, 1)); printlnInt(nested(1, 9)); printlnInt(nested(1, 10));
    // side effects: the value is computed once
    int i = 0;
    switch (i++) { case 0: println("zero"); break; case 1: println("one"); break; }
    printlnInt(i);
    switch (i += 4) { case 1, 2, 3, 4: println("low"); break; case 5..9: println("mid"); break; default: println("high"); }
    printlnInt(i);
    // char and uint8 values
    uint8 b = 200;
    switch (b) { case 0..127: println("ascii"); break; case 128..255: println("high byte"); break; }
    int8 sb = -3;
    switch (sb) { case -128..-1: println("negative"); break; default: println("not negative"); }
    return 0;
}
