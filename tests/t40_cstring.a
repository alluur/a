import cctype;
import cstring;
import cerrno;

int main() {
    char buf[100];
    char b2[100];
    // ctype
    int total = 0;
    for (int c = 0; c < 256; c++) {
        int bits = 0;
        if (isalpha(c)) bits |= 1;
        if (isdigit(c)) bits |= 2;
        if (isalnum(c)) bits |= 4;
        if (isupper(c)) bits |= 8;
        if (islower(c)) bits |= 16;
        if (isspace(c)) bits |= 32;
        if (ispunct(c)) bits |= 64;
        if (isxdigit(c)) bits |= 128;
        if (isprint(c)) bits |= 256;
        if (isgraph(c)) bits |= 512;
        if (iscntrl(c)) bits |= 1024;
        if (isblank(c)) bits |= 2048;
        total = total * 31 + bits + toupper(c) * 3 + tolower(c) * 7;
        total = total & 0xFFFFFFFFFFF;
    }
    printf("ctype %d\n", total);
    // memory
    strcpy(buf, "abcdefghij");
    memmove(&buf[2], &buf[0], 6);
    println(buf);
    memmove(&buf[0], &buf[3], 5);
    println(buf);
    printf("%d %d %d\n", memcmp("abc", "abd", 3) < 0, memcmp("abc", "abc", 3), memcmp("b", "a", 1) > 0);
    printf("%s|%s\n", memchr("hello", 'l', 5), memchr("hello", 'z', 5) == null ? "none" : "?");
    printf("%s\n", memrchr("hello", 'l', 5));
    // copying
    strncpy(buf, "xy", 6);
    printf("%d %d %d %d\n", buf[0], buf[1], buf[2], buf[5]);
    strcpy(buf, "abc");
    strncat(buf, "defgh", 2);
    println(buf);
    println(&buf[0] + 0);
    strcpy(b2, "12345");
    char* e = stpcpy(b2, "zz");
    printf("%s %d\n", b2, (int)e - (int)b2);
    printf("%d\n", strlcpy(buf, "overlong-text", 5));
    println(buf);
    strcpy(buf, "ab");
    printf("%d %s\n", strlcat(buf, "cdefgh", 6), buf);
    char* d = strndup("abcdefgh", 3);
    println(d);
    // comparing
    printf("%d %d %d\n", strncmp("abcd", "abzz", 2), strncmp("abcd", "abzz", 3) < 0, strncmp("", "", 5));
    printf("%d %d %d\n", strcasecmp("HeLLo", "hello"), strcasecmp("a", "B") < 0, strncasecmp("HELP", "helium", 3));
    // searching
    printf("%d %d\n", strnlen("abcdef", 3), strnlen("ab", 10));
    printf("%s|%s|%d\n", strchr("a/b/c", '/'), strrchr("a/b/c", '/'), strchr("abc", 'z') == null);
    printf("%s\n", strchr("abc", 0) == null ? "null" : "end");
    printf("%s|%s\n", strstr("hello world", "o w"), strstr("hello", "") );
    printf("%d\n", strstr("hello", "xyz") == null);
    printf("%s\n", strcasestr("Hello World", "WORLD"));
    printf("%d %d\n", strspn("abcde1", "abcdef"), strcspn("abc1def", "0123456789"));
    printf("%s\n", strpbrk("hello, world", ",! "));
    // splitting
    strcpy(buf, ",,a,b;;c,,d,");
    char* t = strtok(buf, ",;");
    while (t != null) {
        printf("[%s]", t);
        t = strtok(null, ",;");
    }
    printf("\n");
    strcpy(buf, "k=v=w");
    char* save = null;
    char* k = strtok_r(buf, "=", &save);
    char* v = strtok_r(null, "=", &save);
    printf("%s %s %s\n", k, v, strtok_r(null, "=", &save) );
    strcpy(buf, "a,,b,c");
    char* sp = buf;
    char* part;
    while ((part = strsep(&sp, ",")) != null) {
        printf("<%s>", part);
    }
    printf("\n");
    // errors
    printf("%s | %s | %s\n", strerror(0), strerror(ENOENT), strerror(EACCES));
    printf("%s\n", strerror(9999));
    printf("%d %d %d\n", digitValue('7', 10), digitValue('f', 16), digitValue('g', 16));
    return 0;
}
