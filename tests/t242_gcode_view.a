// gcode.CodeEditor drawing: current line, selection, bracket match, word and find highlights, markers, squiggles, bookmarks, guides,
// white space marks, word wrap, and screenshots (checksums) in two themes
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import afind;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;
gcode.Look* look;

// the pixel in the top left corner of the character cell at byte offset off (the glyphs do not reach it)
int cellPixel(int off) {
    int px = 0;
    int py = 0;
    if (!e->pointOfOffset(off, &px, &py)) { return 0; }
    return w->surf->get(px - e->cellWidth() / 2, py - e->lineHeight() / 2);
}

void colorIs(char* label, int off, int col) {
    int p = cellPixel(off);
    printf("%s: %s\n", label, (p == col) ? "yes" : "NO");
}

// the byte offset of a line and display column
int at(int line, int col) { return e->buf->lineStart(line) + col; }

int main() {
    gcode.theLook()->autoComplete = false;      // no popup while typing: keys such as Enter keep their meaning
    startServer(7342, "t242");
    w = d->createWindow("Editor", 640, 360, 0);
    look = gcode.theLook();
    look->setThemeName("dark");
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    int bg = look->col(atheme.Col.Background);
    int cur = look->col(atheme.Col.CurrentLine);
    int sel = look->col(atheme.Col.Selection);
    int brk = look->col(atheme.Col.BracketMatch);
    int fnd = look->col(atheme.Col.FindMatch);
    int wrd = gfx.mix(bg, sel, 150);
    e->setText("int f(int count) {\n    return (count + 1) * count;\n}\n// count again\n");
    e->doc->setLanguage(asyntax.Lang.A);
    e->highlightWord = false;
    e->gotoLine(2, 0);
    settle();
    colorIs("background of an ordinary cell", 3, bg);
    e->gotoLine(1, 0);
    settle();
    colorIs("current line is highlighted", 24, cur);
    colorIs("another line is not", 3, bg);

    // selection
    e->select(5, 9);
    settle();
    colorIs("selected cell", 6, sel);
    colorIs("cell after the selection (the caret line is highlighted)", 10, cur);
    e->ed->setCursor(0);
    settle();

    // the matching bracket: the caret is next to ( on line 2; the ) after 1 is its partner
    int open = at(1, 11);
    e->ed->setCursor(open);
    e->touch();
    settle();
    colorIs("bracket at the caret", open, brk);
    colorIs("matching bracket", open + 10, brk);
    colorIs("a cell in between", open + 3, cur);

    // other uses of the word at the caret (needs 2 or more characters)
    e->highlightWord = true;
    e->ed->setCursor(at(0, 12));
    e->touch();
    settle();
    colorIs("the word under the caret", at(0, 12), wrd);
    colorIs("another use of the word", at(1, 13), wrd);
    colorIs("a use in a comment", at(3, 4), wrd);
    colorIs("a different word", at(1, 5), bg);
    e->ed->setCursor(0);
    e->touch();
    settle();

    // find matches
    e->highlightWord = false;
    e->setFindHighlight("count", afind.OPT_ICASE);
    settle();
    colorIs("find match", at(0, 11), fnd);
    colorIs("find match in the comment", at(3, 4), fnd);
    colorIs("no match here (the caret line is highlighted)", at(0, 2), cur);
    e->setFindHighlight("COUNT", 0);
    settle();
    colorIs("case sensitive: no match", at(0, 11), cur);
    e->setFindHighlight("(", afind.OPT_REGEX);
    settle();
    printf("an invalid regular expression shows nothing: %s\n", (cellPixel(at(0, 11)) == cur) ? "yes" : "NO");
    e->clearFindHighlight();
    settle();

    // markers in the gutter and squiggles under the text
    e->doc->addMark(1, 11, 5, gcode.SEV_ERROR, "bad name");
    e->doc->addMark(3, 0, 2, gcode.SEV_WARNING, "comment");
    e->doc->toggleBookmark(0);
    settle();
    int gx = 0; int gy = 0;
    e->gutterPoint(1, &gx, &gy);
    printf("error marker colour in the gutter: %s\n", (w->surf->get(gx - 24, gy) == look->col(atheme.Col.Error)) ? "yes" : "NO");
    e->gutterPoint(3, &gx, &gy);
    printf("warning marker colour in the gutter: %s\n", (w->surf->get(gx - 24, gy) == look->col(atheme.Col.Warning)) ? "yes" : "NO");
    e->gutterPoint(0, &gx, &gy);
    printf("bookmark colour in the gutter: %s\n", (w->surf->get(gx - 27, gy - 3) == look->col(atheme.Col.Info)) ? "yes" : "NO");
    int px = 0; int py = 0;
    e->pointOfOffset(at(1, 13), &px, &py);
    int squig = 0;
    for (int dy = 0; dy < 17; dy++) {
        if (w->surf->get(px, py - 8 + dy) == look->col(atheme.Col.Error)) { squig++; }
    }
    printf("a squiggle in the error colour under the word: %d pixels %s\n", squig, (squig >= 1) ? "found" : "NOT FOUND");
    e->doc->clearMarks();
    // marks follow the lines when text is inserted above them
    e->doc->addMark(3, 0, 2, gcode.SEV_ERROR, "x");
    e->doc->toggleBookmark(3);
    e->ed->setCursor(0);
    e->ed->insertString("new first line\n");
    printf("after an insert above: mark on line %d, bookmark on line %d\n", e->doc->marks[0].line, e->doc->books[1]);
    e->ed->undo();
    printf("after undo: mark on line %d\n", e->doc->marks[0].line);
    e->doc->clearMarks();
    e->doc->clearBookmarks();

    // indentation guides and white space
    e->setText("a\n        b\n\tc  \n");
    e->highlightLine = false;
    e->ed->setCursor(0);
    e->indentGuides = false;
    e->invalidate();
    settle();
    int noGuide = cellPixel(e->buf->lineStart(1) + 4);
    e->indentGuides = true;
    e->invalidate();
    settle();
    printf("indent guide drawn: %s\n", (cellPixel(e->buf->lineStart(1) + 4) == look->col(atheme.Col.Guide) && noGuide == bg) ? "yes" : "NO");
    e->showWhitespace = true;
    e->invalidate();
    settle();
    int ws = look->col(atheme.Col.Whitespace);
    int cx = 0; int cy = 0;
    e->pointOfOffset(e->buf->lineStart(1) + 2, &cx, &cy);
    int dots = 0;
    for (int dy = -3; dy <= 3; dy++) { for (int dx = -3; dx <= 3; dx++) { if (w->surf->get(cx + dx, cy + dy) == ws) { dots++; } } }
    printf("white space dot: %d pixels\n", dots);
    e->showWhitespace = false;
    e->highlightLine = true;

    // word wrap: one long line becomes several rows
    e->setText("0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij\nsecond\n");
    w->resize(320, 200);
    settle();
    e->setWordWrap(true);
    settle();
    printf("columns %d, rows of 100 characters: wrap on\n", e->columns());
    int c = e->columns();
    int x0 = 0; int y0 = 0; int x1 = 0; int y1 = 0;
    e->pointOfOffset(5, &x0, &y0);
    e->pointOfOffset(5 + c, &x1, &y1);
    printf("the same column one row lower: dx %d, dy %d\n", x1 - x0, y1 - y0);
    e->ed->setCursor(5);
    key(adp.KEY_DOWN, 0);
    printf("down moves one row: caret %d (expected %d)\n", e->ed->caret(), 5 + c);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    printf("two more rows (the 4th row of the long line): caret %d (expected %d)\n", e->ed->caret(), 5 + 3 * c);
    key(adp.KEY_DOWN, 0);
    printf("down from the last row goes to the next line: caret %d (line %d)\n", e->ed->caret(), e->ed->caretLine());
    key(adp.KEY_UP, 0);
    printf("up goes back to the last row: caret %d (line %d)\n", e->ed->caret(), e->ed->caretLine());
    e->setWordWrap(false);
    settle();
    e->ed->setCursor(60);
    e->touch();
    settle();
    printf("no wrap: the caret is scrolled into view, first column %d\n", e->firstCol());

    // screenshots in two themes
    w->resize(640, 360);
    e->setText("// checksums\nint main() {\n    char* s = \"text\";\n    return 42; /* done */\n}\n");
    e->doc->setLanguage(asyntax.Lang.A);
    e->doc->addMark(2, 4, 4, gcode.SEV_ERROR, "unknown type");
    e->doc->toggleBookmark(1);
    e->gotoLine(1, 3);
    settle();
    int darkShot = shot(w);
    printf("dark screenshot %u\n", darkShot);
    look->setThemeName("light");
    settle();
    int lightShot = shot(w);
    printf("light screenshot %u\n", lightShot);
    look->setThemeName("dark");
    settle();
    printf("dark again is identical: %d, light differs: %d\n", shot(w) == darkShot, lightShot != darkShot);
    return 0;
}
