// asyntax: the keyword var, interpolated strings $"..." (one string, also with quotes inside the braces), tuples, lambdas
import asyntax;

int fails;

void check(bool ok, char* what) {
    if (!ok) { fails++; printf("FAIL: %s\n", what); }
}

// the words of a line with their kinds: K keyword, S string, N number, T type, F function, C constant
void show(int lang, char* line) {
    asyntax.Token tk[64];
    int es = 0;
    int len = strlen(line);
    int n = asyntax.lexLine(lang, 0, line, len, &tk[0], 64, &es);
    int covered = 0;
    bool gapless = true;
    printf("%s:", line);
    for (int i = 0; i < n; i++) {
        if (tk[i].start != covered || tk[i].len <= 0) { gapless = false; }
        covered = tk[i].start + tk[i].len;
        int k = tk[i].kind;
        char ch = 0;
        if (k == asyntax.Tok.Keyword) { ch = 'K'; }
        else if (k == asyntax.Tok.String) { ch = 'S'; }
        else if (k == asyntax.Tok.Number) { ch = 'N'; }
        else if (k == asyntax.Tok.Type) { ch = 'T'; }
        else if (k == asyntax.Tok.Function) { ch = 'F'; }
        if (ch != 0) {
            printf(" %c[%d,%d]", ch, tk[i].start, tk[i].start + tk[i].len);
        }
    }
    println("");
    check(gapless && covered == len, "tokens cover the line without gaps");
}

int main() {
    show(asyntax.Lang.A, "var x = 5;");
    show(asyntax.Lang.A, "var (q, r) = divmod(7, 2);");
    show(asyntax.Lang.A, "(int q, int r) = divmod(7, 2);");
    show(asyntax.Lang.A, "println($\"x = {x}, pi = {pi:.3f}\");");
    show(asyntax.Lang.A, "println($\"a {f(\"q\")} b {{ }} c\") + 1;");
    show(asyntax.Lang.A, "char* s = $\"\\\"quoted\\\" {x}\"; int n = 3;");
    show(asyntax.Lang.A, "func f = (int a, int b) => a + b;");
    show(asyntax.Lang.A, "sortBy(a, n, (int p, int q) -> int => p - q);");
    show(asyntax.Lang.C, "char* s = $\"x\";");
    printf("%d failures\n", fails);
    return 0;
}
