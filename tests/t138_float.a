// float: a 4-byte binary32 in memory (globals, arrays, fields, locals, parameters), widened to double in expressions; checked against GCC
struct Vtx { char tag; float x; float y; float z; double w; };
float gscale = 0.1;
float gtab[4] = {1.5, -2.25, 0.1, 3};
int bitsf(float f) { double d = f; return __bits(d); }
float half(float v) { return v / 2; }
float addf(float a, float b) { return a + b; }
double widen(float v) { return v; }
void show(char* name, double d) { print(name); print(" "); printInt(__bits(d)); println(""); }
int main() {
    printInt(sizeof(float)); println("");
    printInt(sizeof(struct Vtx)); println("");
    struct Vtx v;
    printInt((int)&v.x - (int)&v); print(" "); printInt((int)&v.y - (int)&v); print(" "); printInt((int)&v.w - (int)&v); println("");
    float a = 0.1;
    float b = 0.2;
    float c = a + b;
    show("c", c);
    float d = a * b; show("d", d);
    float e = a / b; show("e", e);
    float f = a - b; show("f", f);
    show("gscale", gscale);
    show("gtab0", gtab[0]); show("gtab2", gtab[2]); show("gtab3", gtab[3]);
    float* p = gtab;
    p = p + 1; show("p1", *p);
    printInt((int)(p + 1) - (int)p); println("");
    float h = half(3.0); show("half", h);
    float s = addf(1.0 / 3, 2); show("addf", s);
    show("widen", widen(0.3));
    double dd = 1.0 / 3; float r = (float)dd; show("round", r);
    show("cast", (float)(1.0 / 7));
    v.x = 1.25; v.y = v.x * 3; v.z = 0.7; v.w = v.z;
    show("vx", v.x); show("vy", v.y); show("vz", v.z); show("vw", v.w);
    float k = 1.5; k++; show("kpp", k); k += 0.1; show("kadd", k); k *= 3; show("kmul", k); --k; show("kmm", k);
    gtab[1] += 1.0; show("gtab1", gtab[1]);
    float big = 1e40; show("big", big);
    float tiny = 1e-46; show("tiny", tiny);
    int i = (int)c; printInt(i); println("");
    int j = (int)(c * 100); printInt(j); println("");
    float t = 7; show("t", t);
    float q = c > 0.3 ? c : a; show("q", q);
    printInt(a < b); printInt(c == (float)(a + b)); println("");
    float arr[3];
    arr[0] = 0.5; arr[1] = arr[0] + 0.25; arr[2] = arr[1] * arr[1];
    show("arr2", arr[2]);
    return 0;
}
