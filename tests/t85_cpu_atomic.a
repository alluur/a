// cpu: atomic operations, barriers, spin lock, counters; the same program on every CPU
import cpu;

int main() {
    int n = 10;
    printlnInt(cpu.atomicAdd(&n, 5));              // old value 10
    printlnInt(n);                                  // 15
    printlnInt(cpu.atomicSub(&n, 3));               // old 15
    printlnInt(cpu.atomicInc(&n));                  // old 12
    printlnInt(cpu.atomicDec(&n));                  // old 13
    printlnInt(n);                                  // 12
    printlnInt(cpu.atomicSwap(&n, 99));             // old 12
    printlnInt(n);
    printlnInt(cpu.atomicCas(&n, 5, 7));            // wrong expectation: nothing happens, old value 99
    printlnInt(n);
    printlnInt(cpu.atomicCas(&n, 99, 7));           // success, old value 99
    printlnInt(n);
    cpu.atomicStore(&n, 1234567890123);
    printlnInt(cpu.atomicLoad(&n));
    printlnInt(cpu.atomicAdd(&n, -1234567890123));
    printlnInt(n);

    int flag = 0;
    printlnInt(cpu.tryLock(&flag));                 // 1: got it
    printlnInt(cpu.tryLock(&flag));                 // 0: already held
    cpu.unlock(&flag);
    cpu.lock(&flag);
    printlnInt(flag);
    cpu.unlock(&flag);
    printlnInt(flag);

    int a = cpu.cycles();
    cpu.pause();
    cpu.fence();
    int sum = 0;
    for (int i = 0; i < 200000; i++) sum = sum + i;
    int b = cpu.cycles();
    printlnInt(b >= a);
    printlnInt(sum);
    printlnInt(cpu.arch() == __ARCH);
    printlnInt(strlen(cpu.archName()) > 3);
    // x86-64: cpuid works, other CPUs return 0
    int maxleaf = cpu.cpuid(0, 0, 0);
    printlnInt(maxleaf > 0 || __ARCH != 0);
    printlnInt(strlen(cpu.vendor()) == 12 || __ARCH != 0);
    printlnInt(cpu.hwcap() >= 0);
    return 0;
}
