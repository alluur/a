// lambdas: anonymous functions that become hidden functions; no captures
import algo;
import ds;

int apply(func f, int x) { return f(x); }
int apply2(func f, int x, int y) { return f(x, y); }
int g = 100;

int main() {
    // expression bodies, parameters with and without types
    func twice = (int x) => x * 2;
    printf("%d\n", twice(21));
    func add = (a, b) => a + b;
    printf("%d\n", add(3, 4));
    func inc = x => x + 1;
    printf("%d\n", inc(9));
    func none = () => 77;
    printf("%d\n", none());
    func spaced = x   =>   x * 3;
    printf("%d\n", spaced(5));

    // block bodies
    func blk = (int a, int b) => { int s = 0; for (int i = a; i <= b; i++) s += i; return s; };
    printf("%d\n", blk(1, 10));
    func early = (int n) => { if (n < 0) { return -1; } if (n == 0) { return 0; } return 1; };
    printf("%d %d %d\n", early(-5), early(0), early(5));
    func noret = (int n) => { if (n > 100) { return 1; } };
    printf("%d %d\n", noret(1), noret(200));

    // as arguments of functions and of library functions that take callbacks
    printf("%d\n", apply(x => x * x, 12));
    printf("%d\n", apply2((a, b) => a - b, 10, 3));
    int arr[6] = {5, 2, 9, 1, 7, 3};
    algo.sortBy(arr, 6, (int a, int b) => a - b);
    for (var i = 0; i < 6; i++) printf("%d ", arr[i]);
    printf("\n");
    algo.sortBy(arr, 6, (a, b) => b - a);
    for (var i = 0; i < 6; i++) printf("%d ", arr[i]);
    printf("\n");
    ds.BinaryHeap* heap = new ds.BinaryHeap((a, b) => b - a);    // a max heap
    heap->push(3); heap->push(9); heap->push(1); heap->push(7);
    printf("%d ", heap->pop()); printf("%d ", heap->pop()); printf("%d\n", heap->pop());

    // they see globals, and their own variables shadow outer ones
    func gg = () => g + 1;
    printf("%d\n", gg());
    int outer = 7;
    func sh = (int x) => { int outer = x * 2; return outer + g; };
    printf("%d %d\n", sh(4), outer);

    // called where they are written, in conditions, in arithmetic
    printf("%d\n", ((int a) => a + 100)(5));
    if (((int a) => a > 3)(5)) { printf("yes\n"); }
    printf("%d\n", ((a) => a * 2)(3) + ((a) => a * 5)(3));

    // result types: the default is int; -> sets another one
    func odd = (int x) -> bool => x % 2 == 1;
    printf("%d %d\n", odd(3), odd(4));
    func byt = (int x) -> uint8 => x + 250;
    printf("%d\n", byt(10));
    func half = (double x) -> double => x * 0.5;
    printf("%d\n", (int)(__dbl(half(5.0)) * 10.0));
    func dsum = (double a, double b) -> double => a + b;
    printf("%d\n", (int)(__dbl(dsum(1.5, 2.25)) * 100.0));

    // lambdas are values: stored, passed on, returned, put in tuples
    func compose = (func f, int x) => f(f(x));
    printf("%d\n", compose((int v) => v + 5, 1));
    func mk = () => (int q) => q * 7;
    func m7 = mk();
    printf("%d\n", m7(6));
    var t = (1, (int z) => z + 1000);
    printf("%d\n", t.1(5));
    func table[3];
    table[0] = x => x + 1;
    table[1] = x => x * 10;
    table[2] = twice;
    for (var i = 0; i < 3; i++) printf("%d ", table[i](i + 4));
    printf("\n");
    return 0;
}
