// Exercises the optimiser's fused paths (locals, constants, compare-and-branch)
int side;
int bump() { side++; return side; }

int main() {
    // compound assignment on all local scalar kinds
    int i = 10;  i += 5;  i -= 3;  i *= 2;  i /= 4;  i %= 4;  i <<= 3;  i >>= 1;  i |= 1;  i &= 7;  i ^= 2;
    printlnInt(i);
    char c = 250;  c += 10;                 // wraps at 8 bits
    printlnInt(c);
    c = 'a';  c++;  c++;  c--;
    printChar(c); println("");
    bool b = false;  b = 5;  printlnInt(b);
    b = 0;  printlnInt(b);
    // post / pre increment results
    int a = 5;
    int x = a++;   int y = ++a;   int z = a--;   int w = --a;
    printlnInt(x); printlnInt(y); printlnInt(z); printlnInt(w); printlnInt(a);
    a++; a++; --a;                          // statements: old value discarded
    printlnInt(a);
    for (int k = 0; k < 3; k++) { a += k; }
    printlnInt(a);
    // right operands that are constants, locals, negatives and calls
    int p = 7;  int q = 3;  char ch = 'x';  int neg = -5;
    printlnInt(p + 1); printlnInt(p - q); printlnInt(p * q); printlnInt(p / q); printlnInt(p % q);
    printlnInt(p & q); printlnInt(p | 8); printlnInt(p ^ q); printlnInt(p << q); printlnInt(p >> 1);
    printlnInt(p + neg); printlnInt(p + -5); printlnInt(-(-p)); printlnInt(- -5);
    printlnInt(p + ch); printlnInt(ch - 'a'); printlnInt(ch + ch);
    printlnInt(p - bump()); printlnInt(side);
    printlnInt(1 - 2 - 3); printlnInt(2 * 3 + 4 * 5); printlnInt((1 + 2) * (3 + 4));
    printlnInt(1000000007 * 1000000007 % 998244353);
    // compare + branch in every position
    int n = 5;
    if (n < 6) print("a");  if (n > 6) print("X");  if (n <= 5) print("b");  if (n >= 6) print("X");
    if (n == 5) print("c"); if (n != 5) print("X");
    if (n < q || n == 5) print("d");  if (n < q && n > 0) print("X");  if (n > q && n < 9) print("e");
    if (!(n < 3)) print("f");
    println("");
    int cnt = 0;
    while (cnt < 10 && cnt != 7) cnt++;
    printlnInt(cnt);
    do { cnt--; } while (cnt > 2);
    printlnInt(cnt);
    printlnInt(n > 3 ? n < 9 ? 1 : 2 : 3);
    bool both = n > 1 && n < 10;  bool either = n > 100 || n == 5;
    printBool(both); printBool(either); println("");
    // pointer arithmetic with leaf operands
    int arr[5];
    for (int j = 0; j < 5; j++) arr[j] = j * 11;
    int* ptr = arr;  int off = 3;
    printlnInt(*(ptr + off)); printlnInt(*(ptr + 1)); printlnInt(*(arr + off - 1));
    int* e2 = ptr + 4;  printlnInt(e2 - ptr);
    ptr += 2;  printlnInt(*ptr);  ptr -= 1;  printlnInt(*ptr);  ptr++;  ptr++;  printlnInt(*ptr);
    // assignment chains and expression results
    int m1; int m2; int m3;
    m1 = m2 = m3 = 9;
    printlnInt(m1 + m2 + m3);
    int r = (m1 = 4) + (m2 = 5);
    printlnInt(r);
    return 0;
}
