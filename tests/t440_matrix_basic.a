// matrix: construction, arithmetic, norms, blocks, in place operations, error codes, memory. Expected output: tests/algo2_ref/gen_t440.py (exact integer arithmetic).
import cstdio;
import asys;
import matrix;

int seed = 4711;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

void dumpM(char* name, matrix.Matrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" %.10g", __bits(m->d[i])); }
    printf("\n");
}

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.10g", __bits(v[i])); }
    printf("\n");
}

void pv(char* name, double v) {
    printf("%s", name);
    printfd(" %.10g\n", __bits(v));
}

void fillRandom(matrix.Matrix* m) {
    for (int i = 0; i < m->rows * m->cols; i++) { m->d[i] = (double) (lcg() % 19 - 9); }
}

int main() {
    int base = asys.memInUse();
    matrix.Matrix a(3, 4);
    matrix.Matrix b(4, 2);
    matrix.Matrix c(3, 4);
    fillRandom(&a);
    fillRandom(&b);
    fillRandom(&c);
    dumpM("A", &a);
    dumpM("B", &b);
    dumpM("C", &c);
    matrix.Matrix s = a.add(&c);
    dumpM("A+C", &s);
    matrix.Matrix d = a.sub(&c);
    dumpM("A-C", &d);
    matrix.Matrix p = a.mul(&b);
    dumpM("A*B", &p);
    matrix.Matrix t = a.transpose();
    dumpM("A^T", &t);
    matrix.Matrix k = a.scaled(2.5);
    dumpM("2.5A", &k);
    matrix.Matrix h = a.hadamard(&c);
    dumpM("A.C", &h);
    matrix.Matrix op = a * &b;
    dumpM("A*B op", &op);
    matrix.Matrix op2 = a + c;
    dumpM("A+C op", &op2);
    matrix.Matrix op3 = a - c;
    dumpM("A-C op", &op3);
    pv("trace A", a.trace());
    pv("norm1 A", a.norm1());
    pv("normInf A", a.normInf());
    pv("normFro A", a.normFro());
    pv("normMax A", a.normMax());
    double x4[4] = {1, -2, 3, 0.5};
    double y3[3];
    a.mulVec(x4, y3);
    dumpV("A x", y3, 3);
    double x3[3] = {2, 0, -1};
    double y4[4];
    a.mulVecT(x3, y4);
    dumpV("A^T x", y4, 4);
    matrix.Matrix sub = a.submatrix(1, 1, 2, 3);
    dumpM("sub(1,1,2,3)", &sub);
    matrix.Matrix big(4, 5);
    big.setSubmatrix(1, 2, &sub);
    dumpM("setSubmatrix", &big);
    double row1[4];
    double col2[3];
    a.getRow(1, row1);
    a.getCol(2, col2);
    dumpV("row 1", row1, 4);
    dumpV("col 2", col2, 3);
    a.swapRows(0, 2);
    dumpM("swapRows(0,2)", &a);
    a.swapCols(1, 3);
    dumpM("swapCols(1,3)", &a);
    pv("get(2,3)", a.get(2, 3));
    printf("set out of range: %d %d\n", a.set(3, 0, 1.0), a.set(0, 4, 1.0));
    printf("get out of range is NaN: %d\n", a.get(-1, 0) != a.get(-1, 0));

    matrix.Matrix id = matrix.identity(3);
    dumpM("identity(3)", &id);
    double dg[3] = {2, 3, 5};
    matrix.Matrix dm = matrix.diagonal(dg, 3);
    dumpM("diagonal", &dm);
    double u[3] = {1, 2, 3};
    double v[2] = {4, 5};
    matrix.Matrix ou = matrix.outer(u, 3, v, 2);
    dumpM("outer", &ou);
    matrix.Matrix hb = matrix.hilbert(3);
    dumpM("hilbert(3)", &hb);
    matrix.Matrix on = matrix.ones(2, 3);
    dumpM("ones(2,3)", &on);
    matrix.Matrix zr = matrix.zeros(2, 2);
    dumpM("zeros(2,2)", &zr);
    double arr[6] = {1, 2, 3, 4, 5, 6};
    matrix.Matrix fa = matrix.fromArray(arr, 2, 3);
    dumpM("fromArray", &fa);

    // in place operations
    matrix.Matrix q = c.copy();
    q.addInPlace(&c);
    dumpM("C+=C", &q);
    q.subInPlace(&a);
    dumpM("-= A", &q);
    q.scaleInPlace(-0.5);
    dumpM("*= -0.5", &q);
    q.axpyInPlace(2.0, &c);
    dumpM("axpy 2C", &q);
    matrix.Matrix sq(3, 3);
    fillRandom(&sq);
    dumpM("sq", &sq);
    printf("transposeInPlace: %d\n", sq.transposeInPlace());
    dumpM("sq^T", &sq);
    printf("transposeInPlace of 3x4: %d (ERR_DIM = %d)\n", a.transposeInPlace(), matrix.ERR_DIM);
    matrix.Matrix into(3, 2);
    printf("mulInto: %d\n", a.mulInto(&b, &into));
    dumpM("A*B into", &into);
    printf("mulInto alias: %d (ERR_ARG = %d)\n", sq.mulInto(&id, &sq), matrix.ERR_ARG);
    matrix.Matrix wrong(2, 2);
    printf("mulInto wrong shape: %d\n", a.mulInto(&b, &wrong));
    int mid = asys.memInUse();

    // errors
    matrix.Matrix e1 = a.add(&b);
    printf("add 3x4 + 4x2: ok %d err %d (%s)\n", e1.ok(), e1.err, matrix.errorText(e1.err));
    matrix.Matrix e2 = b.mul(&b);
    printf("mul 4x2 * 4x2: ok %d err %d\n", e2.ok(), e2.err);
    matrix.Matrix e3(0, 5);
    printf("Matrix(0, 5): ok %d err %d\n", e3.ok(), e3.err);
    matrix.Matrix e4(-1, 2);
    printf("Matrix(-1, 2): ok %d err %d\n", e4.ok(), e4.err);
    matrix.Matrix e5(1000000000, 1000000000);
    printf("Matrix(1e9, 1e9): ok %d err %d\n", e5.ok(), e5.err);
    matrix.Matrix e6 = e3.transpose();
    printf("transpose of an empty matrix: ok %d err %d\n", e6.ok(), e6.err);
    matrix.Matrix e7 = a.add(null);
    printf("add(null): ok %d err %d\n", e7.ok(), e7.err);
    matrix.Matrix e8 = a.submatrix(2, 2, 2, 2);
    printf("submatrix out of range: ok %d err %d\n", e8.ok(), e8.err);
    printf("setRow bad index: %d\n", a.setRow(3, row1));
    matrix.Matrix zeroed;
    printf("zeroed matrix: ok %d rows %d trace is NaN %d det is NaN %d\n", zeroed.ok(), zeroed.rows, zeroed.trace() != zeroed.trace(), zeroed.det() != zeroed.det());
    zeroed.dispose();
    printf("errorText(0) %s | errorText(99) %s\n", matrix.errorText(0), matrix.errorText(99));

    // NaN and infinity follow IEEE rules in plain arithmetic
    matrix.Matrix nn(2, 2);
    nn.d[0] = 1.0;
    nn.d[1] = __dbl(0x7FF8000000000000);
    nn.d[2] = 3.0;
    nn.d[3] = 4.0;
    matrix.Matrix nn2 = nn.mul(&nn);
    printf("NaN spreads: %d %d %d %d, isFinite %d\n", nn2.d[0] != nn2.d[0], nn2.d[1] != nn2.d[1], nn2.d[2] != nn2.d[2], nn2.d[3] != nn2.d[3], nn.isFinite());
    printf("normMax with NaN is NaN: %d, normFro: %d\n", nn.normMax() != nn.normMax(), nn.normFro() != nn.normFro());

    // symmetry
    matrix.Matrix sy(2, 2);
    sy.d[0] = 1.0; sy.d[1] = 2.0; sy.d[2] = 2.0000001; sy.d[3] = 5.0;
    printf("isSymmetric exact %d, tol 1e-6 %d, non square %d\n", sy.isSymmetric(), sy.isSymmetric(1.0e-6), a.isSymmetric());

    // norms of huge and tiny entries do not overflow or underflow
    matrix.Matrix hg(2, 2);
    hg.d[0] = 3.0e200; hg.d[3] = 4.0e200;
    pv("normFro of 3e200, 4e200", hg.normFro() / 1.0e200);
    hg.d[0] = 3.0e-200; hg.d[3] = 4.0e-200;
    pv("normFro of 3e-200, 4e-200", hg.normFro() / 1.0e-200);

    // dispose frees everything
    matrix.Matrix* all[40] = {&a, &b, &c, &s, &d, &p, &t, &k, &h, &op, &op2, &op3, &sub, &big, &id, &dm, &ou, &hb, &on, &zr, &fa, &q, &sq, &into, &wrong, &nn, &nn2, &sy, &hg};
    for (int i = 0; i < 29; i++) { all[i]->dispose(); }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    printf("memory at the middle was above the base: %d\n", mid > base);
    return 0;
}
