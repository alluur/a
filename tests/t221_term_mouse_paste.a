// term: mouse reports (SGR and the old X10 form), bracketed paste, focus events, queue behaviour, key names and the key encoder
import term;

term.Decoder* dec;

void showBytes(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        int c = s[i] & 255;
        if (c == 27) print("\\e");
        else if (c == 13) print("\\r");
        else if (c == 10) print("\\n");
        else if (c < 32) { print("^"); printChar(c + 64); }
        else if (c >= 127) { print("\\x"); printHex(c); }
        else printChar(c);
    }
}

void drain() {
    term.Event e;
    char buf[200];
    while (dec->next(&e)) {
        term.describe(&e, &buf[0], 200);
        print(" ");
        print(&buf[0]);
    }
    println("");
}

void check(char* seq) {
    showBytes(seq);
    print(" ->");
    dec->feedText(seq);
    dec->flush();
    drain();
}

void title(char* t, int max) {
    char out[128];
    int n = term.cleanTitle(t, &out[0], max);
    out[n] = 0;
    print("[");
    showBytes(&out[0]);
    println("]");
}

int main() {
    dec = new term.Decoder();
    println("-- SGR mouse: press, release, drag, move, wheel, modifiers");
    check("\e[<0;1;1M");
    check("\e[<0;1;1m");
    check("\e[<1;10;5M");
    check("\e[<2;80;24M");
    check("\e[<32;11;6M");
    check("\e[<34;12;6M");
    check("\e[<35;13;7M");
    check("\e[<64;5;5M");
    check("\e[<65;5;5M");
    check("\e[<66;5;5M");
    check("\e[<67;5;5M");
    check("\e[<4;3;3M");
    check("\e[<8;3;3M");
    check("\e[<16;3;3M");
    check("\e[<20;3;3M\e[<20;3;3m");
    check("\e[<68;9;9M");
    check("\e[<0;300;250M");
    println("-- mouse events keep the order with keys");
    check("a\e[<0;2;2Mb\e[<0;2;2m");
    println("-- the old X10 form: ESC [ M and three bytes (button + 32, column + 33, row + 33)");
    check("\e[M !!");
    check("\e[M#!!");
    check("\e[M\"*)");
    check("\e[M`%%");
    println("-- bracketed paste");
    check("\e[200~hello world\e[201~");
    check("\e[200~line one\nline two\r\n\ttab\e[201~");
    check("\e[200~\e[201~");
    check("\e[200~has \e[31m escape and \e[ stuff \e[20 not the end\e[201~x");
    check("\e[200~caf\xc3\xa9 \xe4\xb8\x96\e[201~");
    println("-- a paste that ends in pieces");
    dec->feedText("\e[200~abc\e[2");
    println(dec->count() == 0 ? "waiting" : "event too early");
    println(dec->flushDelay() > 100 ? "a paste waits longer for more input" : "short wait");
    dec->feedText("01~");
    drain();
    println("-- an unfinished paste is delivered when the input stops");
    dec->feedText("\e[200~partial");
    dec->flush();
    drain();
    println("-- focus");
    check("\e[I");
    check("\e[O");
    println("-- replies: cursor position needs a request, otherwise it is a key");
    check("\e[1;5R");
    dec->expectCpr = true;
    check("\e[1;5R");
    dec->expectCpr = true;
    check("\e[24;80R");
    check("\e[8;50;132t");
    println("-- the queue grows: a burst of input loses nothing");
    for (int i = 0; i < 200; i++) { dec->push(term.EV_FD, i, 0, 0); }
    printlnInt(dec->count());
    term.Event e;
    dec->next(&e);
    printlnInt(e.key);
    dec->clearEvents();
    printlnInt(dec->count());
    char burst[1100];
    for (int i = 0; i < 1000; i++) { burst[i] = 'a' + (i % 26); }
    dec->feedBytes(&burst[0], 1000);
    printlnInt(dec->count());
    dec->next(&e);
    printf("first %c\n", e.key);
    int lost = 0;
    int seen = 1;
    while (dec->next(&e)) {
        if (e.key != 'a' + (seen % 26)) { lost++; }
        seen++;
    }
    printf("read %d, out of order %d\n", seen, lost);
    println("-- the queue still works as a ring after growing: take() and wrap-around");
    for (int round = 0; round < 5; round++) {
        for (int i = 0; i < 300; i++) { dec->push(term.EV_FD, round * 1000 + i, 0, 0); }
        for (int i = 0; i < 299; i++) { dec->next(&e); }
    }
    printlnInt(dec->count());
    dec->next(&e);
    printlnInt(e.key);
    dec->clearEvents();
    println("-- take(): removes one event of a kind and leaves the others");
    dec->feedText("a\e[8;24;80tb");
    bool got = dec->take(term.EV_REPLY, &e);
    printf("%d %d %d\n", got, e.y, e.x);
    drain();
    println("-- window titles: control characters and invalid UTF-8 are dropped");
    title("plain title", 100);
    title("evil\x07\e[31mINJECTED\e]0;second", 100);
    title("a\x0d\x0ab\x7fc", 100);
    title("caf\xc3\xa9 \xe2\x82\xac \xf0\x9f\x98\x80", 100);
    title("c1 \xc2\x9b[31m \xc2\x9d \xc2\xa0.", 100);
    title("stray \x9b and \xff and \x80 gone", 100);
    title("cut \xc3", 100);
    title("0123456789", 6);
    title("01234\xc3\xa9", 6);
    println("-- event helpers");
    dec->feedText("\r");
    dec->next(&e);
    printf("%d %d\n", e.isEnter(), e.isChar());
    dec->feedText("x");
    dec->next(&e);
    printf("%d %d\n", e.isEnter(), e.isChar());
    dec->feedText("\x03");
    dec->next(&e);
    printf("%d %d\n", e.isEnter(), e.isChar());
    return 0;
}
