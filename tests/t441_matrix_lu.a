// matrix: LU decomposition with partial pivoting: solve, determinant, inverse, rcond, singular matrices, ill conditioned and non finite input, memory.
// Expected output: tests/algo2_ref/gen_t441.py (exact rational arithmetic with fractions for the numbers, checks for the rest).
import cstdio;
import asys;
import matrix;
import dmath;

int seed = 20240229;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

double clean(double v) { return (v < 1.0e-11 && v > -1.0e-11) ? 0.0 : v; }

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.9g", __bits(clean(v[i]))); }
    printf("\n");
}

void dumpM(char* name, matrix.Matrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" %.9g", __bits(clean(m->d[i]))); }
    printf("\n");
}

void fillRandom(matrix.Matrix* m) {
    for (int i = 0; i < m->rows * m->cols; i++) { m->d[i] = (double) (lcg() % 19 - 9); }
}

double maxAbsDiff(double* a, double* b, int n) {
    double m = 0.0;
    for (int i = 0; i < n; i++) {
        double d = dmath.fabs(a[i] - b[i]);
        if (d > m) { m = d; }
    }
    return m;
}

int main() {
    int base = asys.memInUse();
    // 1. exact integer matrices: determinant, solution, inverse
    for (int round = 0; round < 3; round++) {
        int n = 3 + round * 2;                       // 3, 5, 7
        matrix.Matrix a(n, n);
        fillRandom(&a);
        double b[8];
        for (int i = 0; i < n; i++) { b[i] = (double) (lcg() % 19 - 9); }
        matrix.LU f(&a);
        printf("n=%d status %d\n", n, f.err);
        printf("det"); printfd(" %.9g\n", __bits(f.det()));
        double x[8];
        printf("solve status %d\n", f.solve(b, x));
        dumpV("x", x, n);
        matrix.Matrix inv = f.inverse();
        dumpM("inverse", &inv);
        // A * A^-1 = I
        matrix.Matrix prod = a * &inv;
        double worst = 0.0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                double want = (i == j) ? 1.0 : 0.0;
                double dd = dmath.fabs(prod.d[i * n + j] - want);
                if (dd > worst) { worst = dd; }
            }
        }
        printf("A * inverse is the identity (1e-12): %d\n", worst < 1.0e-12);
        // the estimate of rcond is a lower bound of 1 / cond (up to rounding) and within a factor 3 of it
        double exact = 1.0 / (a.norm1() * inv.norm1());
        double est = f.rcond();
        printf("rcond estimate: not below the exact value %d, within a factor 3 %d, cond1 = 1/rcond %d\n", est >= exact * (1.0 - 1.0e-9), est <= 3.0 * exact, dmath.fabs(f.cond1() * est - 1.0) < 1.0e-12);
        // P A = L U
        matrix.Matrix L = f.lower();
        matrix.Matrix U = f.upper();
        matrix.Matrix P = f.permutation();
        matrix.Matrix lu = L * &U;
        matrix.Matrix pa = P * &a;
        printf("P A = L U (1e-12): %d\n", maxAbsDiff(lu.d, pa.d, n * n) < 1.0e-12);
        // transposed system and matrix right hand sides
        double xt[8];
        f.solveTranspose(b, xt);
        matrix.Matrix at = a.transpose();
        double back[8];
        at.mulVec(xt, back);
        printf("solveTranspose residual small: %d\n", maxAbsDiff(back, b, n) < 1.0e-10);
        matrix.Matrix B(n, 2);
        fillRandom(&B);
        matrix.Matrix X = f.solveMatrix(&B);
        matrix.Matrix AX = a * &X;
        printf("solveMatrix: A X = B (1e-10): %d\n", maxAbsDiff(AX.d, B.d, n * 2) < 1.0e-10);
        int sg;
        double lg = f.logAbsDet(&sg);
        printf("logAbsDet matches det: %d, sign %d\n", dmath.fabs(dmath.exp(lg) * (double) sg - f.det()) < 1.0e-8 * dmath.fabs(f.det()), sg);
        matrix.Matrix ci = a.inverse();
        matrix.Matrix cs = a.solve(&B);
        printf("convenience det %d, inverse ok %d, solve ok %d\n", dmath.fabs(a.det() - f.det()) < 1.0e-9 * dmath.fabs(f.det()), ci.ok(), cs.ok());
        ci.dispose(); cs.dispose();
        f.dispose();
        a.dispose(); inv.dispose(); prod.dispose(); L.dispose(); U.dispose(); P.dispose(); lu.dispose(); pa.dispose(); at.dispose(); B.dispose(); X.dispose(); AX.dispose();
    }

    // 2. a 12 x 12 system with a known solution
    {
        int n = 12;
        matrix.Matrix a(n, n);
        fillRandom(&a);
        for (int i = 0; i < n; i++) { a.d[i * n + i] += 40.0; }        // diagonally dominant: well conditioned
        double xt[12];
        double b[12];
        for (int i = 0; i < n; i++) { xt[i] = (double) (i + 1) / 4.0; }
        a.mulVec(xt, b);
        matrix.LU f(&a);
        double x[12];
        printf("known solution: status %d, max error below 1e-12: %d, rcond above 0.01: %d\n", f.solve(b, x), maxAbsDiff(x, xt, n) < 1.0e-12, f.rcond() > 0.01);
        double xi[12];
        for (int i = 0; i < n; i++) { xi[i] = b[i]; }
        f.solve(xi, xi);                                            // in place
        printf("in place solve gives the same: %d\n", maxAbsDiff(x, xi, n) == 0.0);
        f.dispose();
        a.dispose();
    }

    // 3. singular matrices are refused with ERR_SINGULAR
    {
        double v[9] = {1, 2, 3, 4, 5, 6, 7, 8, 9};
        matrix.Matrix a = matrix.fromArray(v, 3, 3);
        matrix.LU f(&a);
        double b[3] = {1, 2, 3};
        double x[3];
        printf("1..9: status %d (%s), solve %d, rcond below 1e-16: %d, cond1 above 1e16: %d, det below 1e-12: %d\n", f.err, matrix.errorText(f.err), f.solve(b, x), f.rcond() < 1.0e-16, f.cond1() > 1.0e16, dmath.fabs(f.det()) < 1.0e-12);
        matrix.Matrix inv = f.inverse();
        printf("inverse: ok %d err %d\n", inv.ok(), inv.err);
        matrix.Matrix i2 = a.inverse();
        printf("Matrix.inverse: ok %d err %d\n", i2.ok(), i2.err);
        matrix.Matrix B = matrix.ones(3, 1);
        matrix.Matrix xs = a.solve(&B);
        printf("Matrix.solve: ok %d err %d\n", xs.ok(), xs.err);
        // with rcond check off the system can be solved: the answer is meaningless, but the call is allowed
        matrix.LU g(&a, 0.0);
        printf("rcond check off: status %d\n", g.err);
        f.dispose(); g.dispose(); a.dispose(); B.dispose();

        // an exactly singular matrix (two equal rows): a zero pivot, det exactly 0, zeroAt tells the column
        double w[9] = {2, 4, 6, 1, 2, 3, 5, 1, 0};
        matrix.Matrix c = matrix.fromArray(w, 3, 3);
        matrix.LU h(&c);
        printfd("equal rows: status %d, det %g, zeroAt %d, rcond %g\n", h.err, __bits(h.det()), h.zeroAt, __bits(h.rcond()));
        printfd("Matrix.det of it: %g\n", __bits(c.det()));
        h.dispose();
        matrix.LU h0(&c, 0.0);
        printf("with minRcond 0: status %d (still singular: exact zero pivot)\n", h0.err);
        h0.dispose();
        c.dispose();
        // zero matrix and 1 x 1
        matrix.Matrix z(2, 2);
        matrix.LU fz(&z);
        printfd("zero matrix: status %d det %g rcond %g\n", fz.err, __bits(fz.det()), __bits(fz.rcond()));
        fz.dispose();
        z.dispose();
        matrix.Matrix one(1, 1);
        one.d[0] = 4.0;
        matrix.LU f1(&one);
        double b1[1] = {10.0};
        double x1[1];
        int st1 = f1.solve(b1, x1);
        printfd("1x1: status %d, x %g, det %g, rcond %g\n", st1, __bits(x1[0]), __bits(f1.det()), __bits(f1.rcond()));
        f1.dispose();
        one.d[0] = 0.0;
        matrix.LU f2(&one);
        printfd("1x1 zero: status %d det %g\n", f2.err, __bits(f2.det()));
        f2.dispose();
        one.dispose();
    }

    // 4. ill conditioned: Hilbert matrices
    {
        matrix.Matrix h = matrix.hilbert(6);
        double ones[6] = {1, 1, 1, 1, 1, 1};
        double b[6];
        h.mulVec(ones, b);
        matrix.LU f(&h);
        double x[6];
        int st = f.solve(b, x);
        printf("hilbert(6): status %d, error below 1e-6: %d, error above 1e-14 (it is ill conditioned): %d, rcond between 1e-9 and 1e-6: %d\n", st, maxAbsDiff(x, ones, 6) < 1.0e-6, maxAbsDiff(x, ones, 6) > 1.0e-14, f.rcond() > 1.0e-9 && f.rcond() < 1.0e-6);
        // exact determinant of H6 = 1 / 186313420339200000
        printf("det relative error below 1e-8: %d\n", dmath.fabs(f.det() * 186313420339200000.0 - 1.0) < 1.0e-8);
        f.dispose();
        h.dispose();
        matrix.Matrix h12 = matrix.hilbert(12);
        matrix.LU g(&h12);
        printf("hilbert(12): status %d (singular to working precision), rcond below 1e-15: %d\n", g.err, g.rcond() < 1.0e-15);
        matrix.LU g0(&h12, 0.0);
        double ones12[12];
        double b12[12];
        double x12[12];
        for (int i = 0; i < 12; i++) { ones12[i] = 1.0; }
        h12.mulVec(ones12, b12);
        int s12 = g0.solve(b12, x12);
        printf("hilbert(12) with minRcond 0: status %d, the answer is wrong by more than 1e-4: %d\n", s12, maxAbsDiff(x12, ones12, 12) > 1.0e-4);
        g.dispose(); g0.dispose(); h12.dispose();
        // badly scaled but not singular: rows of different size solve fine when the scaling is a diagonal matrix applied after the fact
        double sc[4] = {1.0, 1.0e-3, 1.0e3, 1.0};
        matrix.Matrix a(4, 4);
        fillRandom(&a);
        for (int i = 0; i < 4; i++) { a.d[i * 4 + i] += 30.0; }
        for (int i = 0; i < 4; i++) { for (int j = 0; j < 4; j++) { a.d[i * 4 + j] *= sc[i]; } }
        double xt[4] = {1, 2, 3, 4};
        double bb[4];
        a.mulVec(xt, bb);
        matrix.LU fa(&a);
        double xs[4];
        printf("row scaled system: status %d, error below 1e-9: %d\n", fa.solve(bb, xs), maxAbsDiff(xs, xt, 4) < 1.0e-9);
        fa.dispose();
        a.dispose();
    }

    // 5. non finite input is refused (never silently turned into numbers)
    {
        matrix.Matrix a = matrix.identity(3);
        a.d[4] = __dbl(0x7FF8000000000000);
        matrix.LU f(&a);
        printf("NaN in the matrix: status %d (%s), det is NaN %d, solve %d\n", f.err, matrix.errorText(f.err), f.det() != f.det(), f.solve(a.d, a.d));
        f.dispose();
        a.d[4] = __dbl(0x7FF0000000000000);
        matrix.LU g(&a);
        printf("infinity in the matrix: status %d\n", g.err);
        g.dispose();
        matrix.Matrix b = matrix.identity(3);
        matrix.LU h(&b);
        double rhs[3] = {1.0, __dbl(0x7FF8000000000000), 3.0};
        double x[3];
        printf("NaN in the right hand side: status %d\n", h.solve(rhs, x));
        h.dispose();
        // overflow during the elimination is reported
        b.d[0] = 1.0e-300;
        b.d[1] = 1.0e300;
        b.d[3] = 1.0;
        b.d[4] = 1.0e300;
        matrix.LU k(&b);
        printf("overflow: status %d\n", (k.err == matrix.ERR_NOT_FINITE || k.err == matrix.ERR_SINGULAR) ? 1 : k.err);
        k.dispose();
        a.dispose();
        b.dispose();
        // not square, empty
        matrix.Matrix r(2, 3);
        matrix.LU f3(&r);
        printf("2x3: status %d (ERR_DIM = %d)\n", f3.err, matrix.ERR_DIM);
        f3.dispose();
        matrix.Matrix e;
        matrix.LU f4(&e);
        printf("empty: status %d\n", f4.err);
        f4.dispose();
        matrix.LU f5(null);
        printf("null: status %d\n", f5.err);
        double d[1] = {0.0};
        printf("solve after dispose: %d\n", f5.solve(d, d));
        r.dispose();
    }

    // 6. the plain function luFactor works in place on an array
    {
        double a[9] = {0, 2, 1, 1, 1, 1, 2, 1, 3};           // needs a row swap at once
        int piv[3];
        int sign;
        int zero;
        int st = matrix.luFactor(a, 3, piv, &sign, &zero);
        printf("luFactor: status %d, pivots %d %d %d, sign %d, zeroAt %d\n", st, piv[0], piv[1], piv[2], sign, zero);
        double det = (double) sign * a[0] * a[4] * a[8];
        printfd("det from the diagonal: %g\n", __bits(det));
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
