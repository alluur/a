// ds: Trie (prefix search, wildcard search, longest prefix, removal with pruning) against brute force
import cstdio;
import cstring;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 31337;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// brute force glob: ? one byte, * anything, \ escape
bool wild(char* p, char* s) {
    if (p[0] == 0) { return s[0] == 0; }
    if (p[0] == '*') {
        for (int i = 0; ; i++) {
            if (wild(&p[1], &s[i])) { return true; }
            if (s[i] == 0) { return false; }
        }
    }
    if (s[0] == 0) { return false; }
    if (p[0] == '?') { return wild(&p[1], &s[1]); }
    if (p[0] == '\\' && p[1] != 0) {
        if (p[1] != s[0]) { return false; }
        return wild(&p[2], &s[1]);
    }
    if (p[0] != s[0]) { return false; }
    return wild(&p[1], &s[1]);
}

const MAXK = 600;
char* keys[MAXK];
int vals[MAXK];
bool in[MAXK];
int own[MAXK];                                     // the first key with the same text

char* randomWord(int alpha, int maxLen) {          // words over a small alphabet: lots of shared prefixes
    int len = rnd(maxLen + 1);
    char* w = (char*) asys.alloc(len + 1);
    for (int i = 0; i < len; i++) { w[i] = 'a' + rnd(alpha); }
    return w;
}

int collectCount(char* key, int val, int ctx) {
    int* c = (int*) ctx;
    c[0]++;
    c[1] = c[1] + val;
    return 0;
}

int orderCb(char* key, int val, int ctx) {
    char* last = (char*) ctx;                      // the previous key
    if (last[0] != 0 && strcmp(last, key) >= 0 && !(last[0] == 1)) { return 99; }
    strcpy(last, key);
    return 0;
}

int main() {
    ds.Trie t();
    int bad = 0;
    // build the key list: the same word can come up twice
    for (int i = 0; i < MAXK; i++) {
        keys[i] = randomWord(3, 7);
        vals[i] = i + 1;
    }
    for (int i = 0; i < MAXK; i++) {
        own[i] = i;
        for (int j = 0; j < MAXK; j++) { if (strcmp(keys[j], keys[i]) == 0) { own[i] = j; break; } }
    }
    for (int round = 0; round < 3000; round++) {
        int i = rnd(MAXK);
        int what = rnd(10);
        int owner = own[i];                        // the key text decides identity
        if (what < 6) {
            int r = t.put(keys[i], vals[i]);
            bool was = in[owner];
            if ((r == 1) == was || r < 0) { bad++; }
            in[owner] = true;
            vals[owner] = vals[i];
        } else {
            bool r = t.remove(keys[i]);
            if (r != in[owner]) { bad++; }
            in[owner] = false;
        }
        if (round % 500 == 499 && !t.verify()) { bad++; }
    }
    check(bad == 0, "put / remove agree with the model");
    // compare size, get, has
    int live = 0;
    for (int i = 0; i < MAXK; i++) {
        if (own[i] != i) { continue; }
        if (in[i]) { live++; }
        if (t.has(keys[i]) != in[i]) { bad++; }
        if (t.get(keys[i], -1) != (in[i] ? vals[i] : -1)) { bad++; }
    }
    check(bad == 0 && t.size() == live && t.verify(), "size, has and get");
    // prefix counts against brute force
    for (int q = 0; q < 300; q++) {
        char* p = randomWord(3, 4);
        int want = 0;
        int sumv = 0;
        for (int i = 0; i < MAXK; i++) {
            if (own[i] == i && in[i] && strncmp(keys[i], p, strlen(p)) == 0) { want++; sumv = sumv + vals[i]; }
        }
        int c[2];
        c[0] = 0; c[1] = 0;
        t.walkPrefix(p, collectCount, (int) &c[0]);
        if (t.countPrefix(p) != want || c[0] != want || c[1] != sumv || t.hasPrefix(p) != (want > 0)) { bad++; }
        asys.free(p);
    }
    check(bad == 0, "prefix counts and prefix walks (300 random prefixes)");
    // wildcard against brute force
    char pat[16];
    for (int q = 0; q < 400; q++) {
        int len = rnd(6);
        for (int i = 0; i < len; i++) {
            int c = rnd(8);
            pat[i] = (c < 3) ? 'a' + c : (c < 5 ? '?' : (c < 7 ? '*' : 'b'));
        }
        pat[len] = 0;
        int want = 0;
        for (int i = 0; i < MAXK; i++) {
            if (own[i] == i && in[i] && wild(&pat[0], keys[i])) { want++; }
        }
        if (t.countWildcard(&pat[0]) != want) { bad++; printf("pattern %s: %d vs %d\n", &pat[0], t.countWildcard(&pat[0]), want); }
    }
    check(bad == 0, "wildcard counts (400 random patterns)");
    // keys come out in byte order
    char last[16];
    last[0] = 1;
    check(t.forEach(orderCb, (int) &last[0]) == 0, "keys come out in byte order");
    char* got[700];
    int n = t.collect("", &got[0], 700);
    bool sorted = n == live;
    for (int i = 1; i < n; i++) { if (strcmp(got[i - 1], got[i]) >= 0) { sorted = false; } }
    check(sorted, "collect gives every key, sorted");
    ds.freeTexts(&got[0], n);
    n = t.collect("ab", &got[0], 5);
    check(n <= 5, "collect respects max");
    ds.freeTexts(&got[0], n);
    // longest prefix
    t.put("/api", 1); t.put("/api/users", 2); t.put("/", 3);
    int v = 0;
    check(t.longestPrefixOf("/api/users/42", &v) == 10 && v == 2, "longest prefix");
    check(t.longestPrefixOf("/api/u", &v) == 4 && v == 1 && t.longestPrefixOf("/x", &v) == 1 && v == 3 && t.longestPrefixOf("nothing", &v) == -1, "longest prefix: shorter keys and none");
    t.dispose();
    check(t.size() == 0 && t.longestPrefixOf("/api", &v) == -1 && t.countPrefix("") == 0 && !t.has(""), "disposed trie is empty");
    ds.Trie e();
    check(e.size() == 0 && e.countPrefix("a") == 0 && e.countWildcard("*") == 0 && !e.remove("a") && e.verify(), "an empty trie");
    check(e.put("", 5) == 1 && e.has("") && e.get("", 0) == 5 && e.countWildcard("*") == 1 && e.countWildcard("") == 1 && e.countWildcard("?") == 0 && e.size() == 1, "the empty key");
    check(e.remove("") && e.size() == 0 && e.verify(), "remove the empty key");
    // escapes and long patterns
    e.put("a?b", 1); e.put("axb", 2); e.put("a*", 3);
    check(e.countWildcard("a\\?b") == 1 && e.countWildcard("a?b") == 2 && e.countWildcard("a\\*") == 1 && e.countWildcard("a*") == 3, "escaped wildcards");
    char longPat[100];
    memset(&longPat[0], '?', 70);
    longPat[70] = 0;
    check(e.countWildcard(&longPat[0]) == -1, "a pattern with more than 62 items is refused");
    memset(&longPat[0], '*', 99);
    longPat[99] = 0;
    check(e.countWildcard(&longPat[0]) == 3, "many stars are fine");
    // a very long key does not recurse
    char* big = (char*) asys.alloc(200001);
    memset(big, 'x', 200000);
    check(e.put(big, 9) == 1 && e.has(big) && e.countPrefix("xx") == 1 && e.nodeCount() > 200000, "a key of 200000 bytes");
    int c[2];
    c[0] = 0; c[1] = 0;
    e.walkPrefix("x", collectCount, (int) &c[0]);
    check(c[0] == 1 && c[1] == 9 && e.countWildcard("x*") == 1, "walks over a deep trie");
    check(e.remove(big) && e.nodeCount() <= 8 && e.verify(), "removing the long key prunes its nodes");
    asys.free(big);
    // all bytes
    char all[4];
    for (int b = 1; b < 256; b++) { all[0] = b; all[1] = 'z'; all[2] = 0; e.put(&all[0], b); }
    check(e.countWildcard("?z") == 255 && e.get("\xC3z", 0) == 195, "all byte values");
    e.dispose();
    int b0 = asys.memBlocks();
    ds.Trie f();
    for (int i = 0; i < 2000; i++) {
        char* w = randomWord(4, 10);
        f.put(w, i);
        asys.free(w);
    }
    check(f.verify(), "a trie of random words");
    f.dispose();
    f.dispose();
    check(asys.memBlocks() == b0, "dispose frees every block");
    printf("trie: %d checks, %d failures\n", checks, fails);
    return fails;
}
