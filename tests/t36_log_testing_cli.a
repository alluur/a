import log;
import testing;
import cli;

int main() {
    log.setFd(1); log.setTimestamps(false); log.setColors(false);
    log.debug("hidden"); log.info("started"); log.warn("careful"); log.error("broken");
    log.setLevel(log.WARN);
    log.info("now hidden"); log.warnf("%d files, %s", 3, (int)"ok", 0, 0); log.errorf("code %d", 7, 0, 0, 0);
    log.setLevel(log.DEBUG); log.debug("visible again");
    log.setLevel(log.OFF); log.error("silent");

    testing.assertEq(4, 2 + 2, "addition");
    testing.assertEq(5, 2 + 2, "wrong on purpose");
    testing.assertStrEq("abc", "abc", "strings");
    testing.assertStrEq("abc", "abd", "strings differ");
    testing.check(1 < 2, "check ok");
    testing.check(false, "check fails");
    printlnInt(testing.passedCount()); printlnInt(testing.failedCount());
    int failures = testing.summary();
    testing.reset();
    printlnInt(failures); printlnInt(testing.summary());

    cli.ArgParser p("mytool", "Does useful things");
    p.addFlag("-v,--verbose", "print more");
    p.addFlag("-q", "quiet");
    p.addOption("-o,--output", "output file", "out.txt");
    p.addOption("-n,--count", "how many", "3");
    char* args[12];
    args[0] = "mytool"; args[1] = "-v"; args[2] = "input1"; args[3] = "--output=res.bin"; args[4] = "-n"; args[5] = "42";
    args[6] = "input2"; args[7] = "--"; args[8] = "-q"; args[9] = "-";
    printBool(p.parse(10, args)); println("");
    printBool(p.flag("-v")); printBool(p.flag("--verbose")); printBool(p.flag("-q")); printBool(p.flag("--nope")); println("");
    println(p.option("-o")); println(p.option("--output")); printlnInt(p.optionInt("--count", 0)); printlnInt(p.optionInt("-o", 99));
    printlnInt(p.positionalCount());
    for (int i = 0; i < p.positionalCount(); i++) { print(p.positional(i)); print(" "); }
    println("");
    cli.ArgParser m("m", null);
    m.addFlag("-a", "a"); m.addFlag("-b", "b"); m.addFlag("-c", "c"); m.addOption("-o", "o", "x");
    args[1] = "-ac"; args[2] = "file";
    printBool(m.parse(3, args)); printBool(m.flag("-a")); printBool(m.flag("-b")); printBool(m.flag("-c")); printlnInt(m.positionalCount());
    cli.ArgParser m2("m2", null);
    m2.addFlag("-a", "a"); m2.addOption("-o", "o", "x");
    args[1] = "-ao";
    printBool(m2.parse(2, args)); println("");
    cli.ArgParser d("t", null);
    d.addOption("--mode", "mode", "fast");
    args[1] = "x";
    printBool(d.parse(2, args)); println(d.option("--mode"));
    p.printHelp();
    return 0;
}
