int main() {
    // file I/O round trip
    bool ok = writeFile("build/tests/io_tmp.txt", "line one\nline two\n");
    printBool(ok); println("");
    int h = fileOpen("build/tests/io_tmp.txt", FILE_APPEND);
    fileWrite(h, "line three\n", 11);
    fileClose(h);
    char* text = readFile("build/tests/io_tmp.txt");
    print(text);
    printlnInt(strlen(text));
    char* missing = readFile("build/tests/does_not_exist.txt");
    printBool(missing == null); println("");
    // strings
    char buf[64];
    strcpy(buf, "abc");
    strcat(buf, "def");
    println(buf);
    char* d = strdup(buf);
    d[0] = 'X';
    println(d); println(buf);
    printlnInt(indexOf("hello", 'l'));
    printlnInt(indexOf("hello", 'z'));
    printBool(startsWith("compiler", "comp")); println("");
    printBool(startsWith("comp", "compiler")); println("");
    println(intToStr(-90210, buf));
    printChar(toUpper('q')); printChar(toLower('Q')); println("");
    printBool(isDigit('7') && isAlpha('x') && isSpace(' ') && !isAlpha('1')); println("");
    printHex(255); print(" "); printHex(0xDEADBEEF); println("");
    // pseudo random numbers are deterministic for a seed
    srand(42);
    int a = rand(); int b = rand();
    srand(42);
    printBool(a == rand() && b == rand()); println("");
    printBool(a >= 0 && b >= 0); println("");
    printlnInt(abs(-5) + min(3, 4) + max(3, 4));
    return 0;
}
