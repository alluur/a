// gcode.Dock (sidebar | centre / bottom panel with dividers you drag, show and hide, limits, window resize) and gcode.PanelTabs (tabs over pages)
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.Dock* dock;
gcode.PanelTabs* side;
gcode.PanelTabs* bottom;
gcode.CodeEditor* e;
gcode.TabBar* tabs;
gui.Window* w;
int layouts = 0;
int tabChanges = 0;

int onLayout(int d) { layouts++; return 0; }
int onTab(int p) { tabChanges++; return 0; }

void geometry(char* label) {
    printf("%s: side %s %d wide, centre x %d w %d h %d", label, dock->sideVisible ? "shown" : "hidden", dock->sidebar->w, dock->center->x, dock->center->w, dock->center->h);
    printf(", bottom %s y %d h %d\n", dock->bottomVisible ? "shown" : "hidden", dock->bottom->y, dock->bottom->h);
}

int main() {
    gcode.theLook()->autoComplete = false;
    startServerSized(7355, "t255", 1000, 800);
    w = d->createWindow("Dock", 900, 600, 0);
    gcode.Look* look = gcode.theLook();
    look->setThemeName("dark");
    dock = new gcode.Dock();
    dock->onLayout = onLayout;
    // the sidebar: two pages
    side = new gcode.PanelTabs();
    side->onSelect = onTab;
    gcode.FileTree* files = new gcode.FileTree();
    e = new gcode.CodeEditor();
    e->blink = false;
    gcode.Outline* outline = new gcode.Outline(e);
    side->addPage("Files", files);
    side->addPage("Outline", outline);
    dock->setSidebar(side);
    // the centre: a tab bar over the editor
    gui.Box* centre = gui.vbox(0, 0);
    tabs = new gcode.TabBar();
    tabs->addTab("main.a", 1);
    centre->add(tabs);
    centre->add(e);
    dock->setCenter(centre);
    // the bottom: output, problems, terminal
    bottom = new gcode.PanelTabs();
    bottom->addPage("Output", new gcode.OutputPane());
    bottom->addPage("Terminal", new gcode.TerminalPane());
    dock->setBottom(bottom);
    w->setRoot(dock);
    e->setText("int main() {\n    return 0;\n}\n");
    e->doc->setLanguage(asyntax.Lang.A);
    settle();
    geometry("start");
    printf("the dock fills the window: %d x %d\n", dock->w, dock->h);
    printf("the sidebar page 1 is shown, page 2 hidden: %d %d\n", files->visible, !outline->visible);
    printf("the page fills the panel under the tab bar: %d x %d at y %d (panel %d x %d)\n", files->w, files->h, files->y, side->w, side->h);

    // the tabs of a panel
    gcode.TabBar* sbar = side->bar;
    clickWd(w, sbar, sbar->tabMiddleX(1), 14);
    printf("click on Outline: page %d shown %d, hidden %d, onSelect %d\n", side->selected(), outline->visible, !files->visible, tabChanges);
    side->select(0);
    printf("select(0): files shown %d, onSelect %d\n", files->visible, tabChanges);
    side->setTitle(0, "Explorer");
    printf("tab title: %s, pages %d\n", sbar->titleOf(0), side->pageCount());
    printf("the bottom panel shows its first page: %d\n", dock->bottom->visible);

    // dragging the sidebar divider
    int sw0 = dock->sideW;
    dragWd(w, dock, sw0 + 2, 100, sw0 + 102, 100);
    geometry("divider dragged 100 pixels right");
    printf("sideW %d (was %d), onLayout calls %d\n", dock->sideW, sw0, layouts);
    dragWd(w, dock, dock->sideW + 2, 100, 5, 100);
    printf("dragged far left: sideW %d (the minimum is %d)\n", dock->sideW, dock->minSide);
    dragWd(w, dock, dock->sideW + 2, 100, 880, 100);
    printf("dragged far right: sideW %d, centre width %d (the centre keeps at least %d)\n", dock->sideW, dock->center->w, dock->minCenter);
    dragWd(w, dock, dock->sideW + 2, 100, 300, 100);
    printf("back to %d\n", dock->sideW);

    // the bottom divider
    int by = dock->bottomY();
    dragWd(w, dock, dock->centerX() + 100, by - 3, dock->centerX() + 100, by - 103);
    geometry("bottom divider dragged 100 pixels up");
    dragWd(w, dock, dock->centerX() + 100, dock->bottomY() - 3, dock->centerX() + 100, 5);
    printf("dragged to the top: bottom height %d, centre height %d (minimum bottom %d)\n", dock->bottomH, dock->center->h, dock->minBottom);
    dragWd(w, dock, dock->centerX() + 100, dock->bottomY() - 3, dock->centerX() + 100, 590);
    printf("dragged to the bottom edge: bottom height %d\n", dock->bottomH);
    dock->bottomH = 200;
    dock->relayout();
    settle();

    // show and hide
    int l0 = layouts;
    dock->showBottom(false);
    settle();
    geometry("bottom hidden");
    printf("the centre uses the whole height: %d, onLayout %d\n", dock->center->h == dock->h, layouts - l0);
    dock->showSidebar(false);
    settle();
    geometry("sidebar hidden too");
    printf("the centre uses the whole width: %d\n", dock->center->w == dock->w && dock->center->x == 0);
    dock->toggleSidebar();
    dock->toggleBottom();
    settle();
    geometry("both back");

    // the window changes size
    w->resize(700, 500);
    settle();
    geometry("window 700 x 500");
    w->resize(300, 300);
    settle();
    geometry("window 300 x 300 (the limits keep every panel in the window)");
    printf("sizes stay positive: %d\n", dock->center->w > 0 && dock->center->h > 0 && dock->sidebar->w > 0);
    w->resize(900, 600);
    settle();

    // pictures
    dock->sideW = 240;
    dock->bottomH = 200;
    dock->relayout();
    settle();
    printf("dark screenshot %u\n", shot(w));
    look->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    look->setThemeName("dark");
    return 0;
}
