// regex: what the Python comparison does not cover: flags, POSIX classes, groups up to 32, named groups, limits, big inputs,
// compile errors, the simple functions, quote()
import regex;
import asys;

int checks;
int fails;

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

void checkEq(int got, int want, char* what) {
    checks++;
    if (got != want) {
        fails++;
        printf("FAIL: %s: got %d want %d\n", what, got, want);
    }
}

void checkStr(char* got, char* want, char* what) {
    checks++;
    if (got == null || !streq(got, want)) {
        fails++;
        printf("FAIL: %s: got '%s' want '%s'\n", what, got == null ? "(null)" : got, want);
    }
}

// first match: "start,end" or "-"
char buf[100];
char* m(char* pat, char* text, int flags) {
    regex.Regex* re = regex.compile(pat, flags);
    if (!re->ok) { return "ERR"; }
    int caps[66];
    int at = re->search(text, strlen(text), 0, &caps[0]);
    char* r;
    if (at < 0) { r = "-"; } else {
        format(&buf[0], 100, "%d,%d", caps[0], caps[1]);
        r = &buf[0];
    }
    re->dispose();
    return r;
}

int main() {
    // ---- flags
    checkStr(m("abc", "xABCx", 0), "-", "case matters by default");
    checkStr(m("abc", "xABCx", regex.F_ICASE), "1,4", "the case flag");
    checkStr(m("a.c", "a\nc", 0), "-", ". does not match a line break");
    checkStr(m("a.c", "a\nc", regex.F_DOTALL), "0,3", "the dotall flag");
    checkStr(m("^b", "a\nb", 0), "-", "^ at the text start only");
    checkStr(m("^b", "a\nb", regex.F_MULTILINE), "2,3", "^ after a line break with the multiline flag");
    checkStr(m("a$", "a\nb", regex.F_MULTILINE), "0,1", "$ before a line break with the multiline flag");
    checkStr(m("(?i)abc", "xABCx", 0), "1,4", "inline flags at the start");
    checkStr(m("a(?i)bc", "aBC", 0), "0,3", "inline flags in the middle apply to the rest");
    checkStr(m("a(?i:b)c", "aBc", 0), "0,3", "a scoped flag");
    checkStr(m("a(?i:b)c", "aBC", 0), "-", "which ends with its group");
    checkStr(m("(?s).", "\n", 0), "0,1", "(?s)");
    checkStr(m("(?-i)abc", "ABC", regex.F_ICASE), "-", "turning a flag off");
    checkStr(m("(?i)é", "É", 0), "-", "case folding is for ASCII only");

    // ---- classes
    checkStr(m("[[:alpha:]]+", "12ab3", 0), "2,4", "[:alpha:]");
    checkStr(m("[[:digit:]]+", "ab123", 0), "2,5", "[:digit:]");
    checkStr(m("[[:alnum:]_]+", "--ab_1--", 0), "2,6", "[:alnum:] and _");
    checkStr(m("[[:upper:]]+", "abCDe", 0), "2,4", "[:upper:]");
    checkStr(m("[[:space:]]+", "a \t b", 0), "1,4", "[:space:]");
    checkStr(m("[[:punct:]]+", "ab,.!cd", 0), "2,5", "[:punct:]");
    checkStr(m("[[:xdigit:]]+", "xyz1aFg", 0), "3,6", "[:xdigit:]");
    checkStr(m("[^[:digit:]]+", "12ab34", 0), "2,4", "a negated POSIX class");
    checkStr(m("[a-c[:digit:]]+", "xxa1cz", 0), "2,5", "mixed members");
    checkStr(m("[\\d\\s]+", "ab1 2c", 0), "2,5", "shorthand classes in a set");
    checkStr(m("[\\w.-]+", "  foo.bar-1  ", 0), "2,11", "word characters, dot and dash");
    checkStr(m("[a\\-z]+", "xa-zy", 0), "1,4", "an escaped dash");
    checkStr(m("[é€]+", "a€éb", 0), "1,6", "non-ASCII members of a set (the euro sign and e-acute are 3 and 2 bytes)");
    checkStr(m("[^a]+", "aéb", 0), "1,4", "a negated set takes whole characters");
    checkStr(m("\\w+", "naïve", 0), "0,6", "\\w includes non-ASCII letters");
    checkStr(m("[a-é]+", "abcé", 0), "0,5", "a range up to a non-ASCII character");

    // ---- repetition
    checkStr(m("a{3}", "aaaa", 0), "0,3", "{n}");
    checkStr(m("(ab){2,3}c", "ababababc", 0), "2,9", "a repeated group with bounds");
    checkStr(m("x{0,2}y", "xxxy", 0), "1,4", "{0,2}");
    checkStr(m("(a|b){1,3}", "abab", 0), "0,3", "an alternation repeated at most 3 times");
    checkStr(m("a{1000}", "a", 0), "-", "a big count that does not match");
    check(streq(m("(?:a{100}){100}", "a", 0), "-"), "100 x 100 copies is fine");
    checkStr(m("(?:(?:ab){1000}){1000}", "a", 0), "ERR", "a program that gets too large is a compile error");
    checkStr(m("a{2,1}", "a", 0), "ERR", "min greater than max");
    checkStr(m("a{x}", "a{x}", 0), "0,4", "an invalid brace is a literal");
    checkStr(m("a++", "aa", 0), "ERR", "possessive quantifiers are not supported (multiple repeat)");

    // ---- groups
    {
        char* pat = "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)(q)(r)(s)(t)(u)(v)(w)(x)(y)(z)(1)(2)(3)(4)(5)(6)";
        regex.Regex* re = regex.compile(pat, 0);
        check(re->ok && re->groups == 32, "32 groups are fine");
        int caps[70];
        int at = re->search("abcdefghijklmnopqrstuvwxyz123456", 32, 0, &caps[0]);
        check(at == 0 && caps[2] == 0 && caps[3] == 1 && caps[64] == 31 && caps[65] == 32, "all 32 captured");
        re->dispose();
        regex.Regex* re2 = regex.compile("(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)(q)(r)(s)(t)(u)(v)(w)(x)(y)(z)(1)(2)(3)(4)(5)(6)(7)", 0);
        check(!re2->ok, "33 groups are an error");
        checkStr(re2->error, "too many groups (at most 32)", "with a message");
        re2->dispose();
        regex.Regex* re3 = regex.compile("(a)\\1(?P<x>b)(?P=x)", 0);
        check(re3->ok && re3->groupIndex("x") == 2 && re3->groupIndex("none") == 0, "named groups and their numbers");
        check(re3->matchFull("aabb", 4, &caps[0]) && caps[4] == 2 && caps[5] == 3, "a named back reference");
        re3->dispose();
        regex.Regex* re4 = regex.compile("(?<year>\\d+)-(?<mon>\\d+)", 0);
        check(re4->ok && re4->groupIndex("mon") == 2, "the (?<name>...) form");
        re4->dispose();
        regex.Regex* re5 = regex.compile("(a)|(b)", 0);
        int c5[66];
        re5->search("b", 1, 0, &c5[0]);
        check(c5[2] == -1 && c5[3] == -1 && c5[4] == 0 && c5[5] == 1, "a group that did not take part is -1");
        re5->dispose();
    }
    // ---- compile errors
    {
        char* bad[18];
        bad[0] = "(a"; bad[1] = "a)"; bad[2] = "[a"; bad[3] = "[z-a]"; bad[4] = "*"; bad[5] = "a**"; bad[6] = "\\1"; bad[7] = "(a)\\2"; bad[8] = "(a\\1)";
        bad[9] = "\\"; bad[10] = "(?"; bad[11] = "(?P<n"; bad[12] = "\\q"; bad[13] = "(?<=a)b"; bad[14] = "\\x4"; bad[15] = "[\\"; bad[16] = "a|*"; bad[17] = "(?P<n>a)(?P<n>b)";
        bool all = true;
        for (int i = 0; i < 18; i++) {
            regex.Regex* re = regex.compile(bad[i], 0);
            if (re->ok) { all = false; printf("accepted: %s\n", bad[i]); }
            re->dispose();
        }
        check(all, "18 invalid patterns are all compile errors");
        // nesting too deep
        char* deep = asys.alloc(1000);
        for (int i = 0; i < 400; i++) { deep[i] = '('; }
        deep[400] = 'a';
        for (int i = 0; i < 400; i++) { deep[401 + i] = ')'; }
        deep[801] = 0;
        regex.Regex* rd = regex.compile(deep, 0);
        check(!rd->ok, "400 nested groups: an error, not a crash");
        rd->dispose();
        asys.free(deep);
        // errors do not leak
        int before = asys.memInUse();
        for (int i = 0; i < 50; i++) {
            regex.Regex* re = regex.compile("(a|b", 0);
            re->dispose();
            regex.Regex* ok = regex.compile("(a|b)+c", 0);
            ok->dispose();
        }
        check(asys.memInUse() - before < 4096, "dispose frees everything, also after errors");
    }
    // ---- limits and big inputs
    {
        regex.Regex* re = regex.compile("(a+)+b", 0);
        char* aaa = asys.alloc(60);
        for (int i = 0; i < 59; i++) { aaa[i] = 'a'; }
        int caps[66];
        check(re->search(aaa, 59, 0, &caps[0]) == -1 && re->exceeded, "a catastrophic pattern stops at the step limit and says so");
        re->stepLimit = 100000000;
        re->dispose();
        asys.free(aaa);
        // one million characters
        int n = 1000000;
        char* big = asys.alloc(n + 2);
        for (int i = 0; i < n; i++) { big[i] = 'a' + (i % 3); }
        big[n] = 'Z';
        regex.Regex* r2 = regex.compile(".*Z", 0);
        check(r2->search(big, n + 1, 0, &caps[0]) == 0 && caps[1] == n + 1, ".*Z over a million characters (no recursion per character)");
        r2->dispose();
        regex.Regex* r3 = regex.compile("[abc]+Z", 0);
        check(r3->search(big, n + 1, 0, &caps[0]) == 0 && caps[1] == n + 1, "[abc]+Z over a million characters");
        r3->dispose();
        regex.Regex* r4 = regex.compile("(?:a|b|c)*Z", 0);
        check(r4->search(big, 50000, 0, &caps[0]) == -1 || r4->exceeded, "an alternation loop over 50000 characters with no match ends");
        r4->dispose();
        regex.Regex* r5 = regex.compile("(?:ab|bc|ca)*Z", 0);
        big[40000] = 'Z';
        check(r5->search(big, 40001, 0, &caps[0]) == 0 && caps[1] == 40001, "a group loop of 13000 iterations with a deep backtrack stack");
        r5->dispose();
        asys.free(big);
    }
    // ---- the simple functions
    check(regex.matches("a(b|c)d", "acd") && !regex.matches("a(b|c)d", "aed") && regex.matches("[0-9]+", "123") && !regex.matches("[0-9]+", "123x"), "matches");
    check(regex.test("o+", "foo") && !regex.test("z", "foo"), "test");
    int len = 0;
    checkEq(regex.search("b+", "abbbc", &len), 1, "search: start");
    checkEq(len, 3, "search: length");
    checkStr(regex.replaceAll("o", "foo", "0"), "f00", "replaceAll");
    checkStr(regex.replaceGroups("(\\w+)=(\\w+)", "a=1 b=2", "$2=$1"), "1=a 2=b", "replaceGroups");
    checkStr(regex.replaceGroups("x", "axb", "[$0$$${0}]"), "a[x$x]b", "$0, $$ and ${0}");
    checkStr(regex.replaceGroups("x", "axb", "$9"), "ab", "a group that does not exist is empty");
    checkStr(regex.replaceAll("(", "abc", "x"), "abc", "a bad pattern replaces nothing");
    check(!regex.test("(", "(") && regex.search("(", "(", &len) == -1 && !regex.matches("(", "("), "a bad pattern never matches");
    char* q = regex.quote("a.b*c[d]\\e(f)|g^$+?{1}");
    checkStr(q, "a\\.b\\*c\\[d\\]\\\\e\\(f\\)\\|g\\^\\$\\+\\?\\{1\\}", "quote escapes everything special");
    check(regex.matches(q, "a.b*c[d]\\e(f)|g^$+?{1}"), "quote(s) matches exactly s");
    check(!regex.matches(q, "axb*c[d]\\e(f)|g^$+?{1}"), "and nothing else");
    checkStr(regex.quote("plain text 123"), "plain text 123", "plain text is unchanged");
    checkStr(regex.quote("tab\there"), "tab\there", "control characters are left alone");
    checkStr(regex.quote("line\nbreak"), "line\\nbreak", "a line break becomes \\n");
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
