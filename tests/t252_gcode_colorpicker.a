// gcode.ColorPicker: colour conversions, the square, the hue bar, the six sliders, the hex field, the swatches, the old / new preview,
// and the dialog (OK and Cancel)
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.ColorPicker* cp;
gui.Window* w;
int changes = 0;
int dialogResult = -1;
int dialogCalls = 0;

int onChange(int p) { changes++; return 0; }
int onDialog(int c) { dialogResult = c; dialogCalls++; return 0; }

void state(char* label) {
    printf("%s: %06X rgb %d,%d,%d", label, cp->color, cp->red(), cp->green(), cp->blue());
    printf(" hsv %d,%d,%d hex [%s] changes %d\n", cp->hue, cp->sat, cp->val, cp->hexBox->text(), changes);
}

int main() {
    // the conversions (integers only)
    printf("hsv -> rgb: red %06X, yellow %06X, green %06X", gcode.hsvToRgb(0, 100, 100), gcode.hsvToRgb(60, 100, 100), gcode.hsvToRgb(120, 100, 100));
    printf(", cyan %06X, blue %06X, magenta %06X\n", gcode.hsvToRgb(180, 100, 100), gcode.hsvToRgb(240, 100, 100), gcode.hsvToRgb(300, 100, 100));
    printf("white %06X, black %06X, grey %06X, dark red %06X", gcode.hsvToRgb(0, 0, 100), gcode.hsvToRgb(200, 50, 0), gcode.hsvToRgb(90, 0, 50), gcode.hsvToRgb(0, 100, 50));
    printf(", pastel %06X, hue 360 wraps %06X, negative hue %06X\n", gcode.hsvToRgb(30, 30, 100), gcode.hsvToRgb(360, 100, 100), gcode.hsvToRgb(-60, 100, 100));
    int h = 0; int s = 0; int v = 0;
    gcode.rgbToHsv(0x3C78D8, &h, &s, &v);
    printf("3C78D8 -> hsv %d,%d,%d\n", h, s, v);
    gcode.rgbToHsv(0xFF0000, &h, &s, &v);
    printf("FF0000 -> hsv %d,%d,%d, ", h, s, v);
    gcode.rgbToHsv(0x808080, &h, &s, &v);
    printf("grey -> %d,%d,%d, ", h, s, v);
    gcode.rgbToHsv(0x000000, &h, &s, &v);
    printf("black -> %d,%d,%d\n", h, s, v);
    // a round trip through hsv is close (within 3 per channel) for a grid of colours
    int worst = 0;
    for (int r = 0; r < 256; r = r + 17) {
        for (int g = 0; g < 256; g = g + 17) {
            for (int b = 0; b < 256; b = b + 17) {
                int c = (r << 16) | (g << 8) | b;
                gcode.rgbToHsv(c, &h, &s, &v);
                int back = gcode.hsvToRgb(h, s, v);
                for (int sh = 0; sh <= 16; sh = sh + 8) {
                    int diff = ((c >> sh) & 255) - ((back >> sh) & 255);
                    if (diff < 0) { diff = -diff; }
                    if (diff > worst) { worst = diff; }
                }
            }
        }
    }
    printf("round trip over 4096 colours: the worst channel error is at most 5: %d\n", worst <= 5);

    gcode.theLook()->autoComplete = false;
    startServer(7352, "t252");
    w = d->createWindow("Picker", 420, 440, 0);
    cp = new gcode.ColorPicker();
    cp->onChange = onChange;
    gui.Box* col = gui.vbox(0, 8);
    col->add(cp);
    w->setRoot(col);
    settle();
    state("initial");
    printf("the preview shows the old and the new colour: %06X %06X\n", cp->preview->oldColor, cp->preview->newColor);

    // setColor does not call onChange; the controls follow
    cp->setColor(0xE03030);
    settle();
    state("setColor(E03030)");
    printf("sliders: %d %d %d %d %d %d\n", cp->sliders[0]->value, cp->sliders[1]->value, cp->sliders[2]->value, cp->sliders[3]->value, cp->sliders[4]->value, cp->sliders[5]->value);
    cp->setOriginal(0xE03030);

    // the square: a click picks saturation and value; the hue bar picks the hue
    int pw = cp->plane->w;
    int ph = cp->plane->h;
    clickWd(w, cp->plane, pw - 1, 0);
    state("square, top right");
    clickWd(w, cp->plane, 0, ph - 1);
    state("square, bottom left");
    clickWd(w, cp->plane, pw / 2, ph / 2);
    state("square, middle");
    clickWd(w, cp->hueBar, 10, cp->hueBar->h - 1);
    state("hue bar, bottom");
    clickWd(w, cp->hueBar, 10, 0);
    state("hue bar, top");
    dragWd(w, cp->plane, 10, 10, pw - 10, ph - 10);
    state("drag in the square");
    printf("the cross hair is drawn where the colour is: %d\n", w->surf->get(cp->plane->absX() + cp->plane->sat * (pw - 1) / 100, cp->plane->absY() + (100 - cp->plane->val) * (ph - 1) / 100 - 5) == 0xFF000000);

    // the sliders: three for rgb, three for hsv; they change each other's values
    cp->setColor(0x000000);
    changes = 0;
    clickWd(w, cp->sliders[0], cp->sliders[0]->w - 8, 11);
    state("red slider to the end");
    clickWd(w, cp->sliders[4], 8, 11);
    state("saturation slider to 0 (grey)");
    clickWd(w, cp->sliders[3], cp->sliders[3]->w / 2, 11);
    state("hue slider to the middle (the colour is grey: nothing changes)");
    cp->sliders[1]->setValue(128);
    state("green slider by code");
    key(adp.KEY_TAB, 9);

    // the hex field: a valid colour is taken over while typing
    cp->hexBox->focusMe();
    cp->hexBox->setText("");
    typeStr("#00ff80");
    state("typed #00ff80");
    cp->hexBox->selectAll();
    typeStr("0x336699");
    state("typed 0x336699");
    cp->hexBox->selectAll();
    typeStr("nonsense");
    state("nonsense is ignored");
    cp->hexBox->selectAll();
    typeStr("red");
    state("a colour name");

    // the swatches
    int sx = cp->swatches->centerX(4);
    int sy = cp->swatches->centerY(4);
    clickWd(w, cp->swatches, sx, sy);
    state("swatch 5");
    clickWd(w, cp->swatches, cp->swatches->centerX(15), cp->swatches->centerY(15));
    state("swatch 16");
    int c0 = changes;
    clickWd(w, cp->swatches, cp->swatches->w - 1, cp->swatches->h - 1);
    printf("a click on the empty part of the swatch area does nothing: %d\n", changes == c0);

    // the original colour next to the new one
    printf("preview: old %06X new %06X, the pixels: %d %d\n", cp->preview->oldColor, cp->preview->newColor, w->surf->get(cp->preview->absX() + 5, cp->preview->absY() + 5) == (0xFF000000 | cp->preview->oldColor), w->surf->get(cp->preview->absX() + cp->preview->w - 5, cp->preview->absY() + 5) == (0xFF000000 | cp->preview->newColor));

    // pictures
    cp->setColor(0x3C78D8);
    settle();
    printf("screenshot %u\n", shot(w));
    cp->setColor(0xE0A030);
    settle();
    printf("another colour %u\n", shot(w));

    // the dialog: OK returns 0xFFRRGGBB, Cancel and closing return 0
    gui.Window* dlg = gcode.pickColor(d, "Pick", 0x336699, onDialog);
    settle();
    gui.Box* root = (gui.Box*) dlg->root;
    gcode.ColorPicker* dp = (gcode.ColorPicker*) root->kids[0];
    printf("the dialog starts with the colour: %06X\n", dp->color);
    clickWd(dlg, dp->swatches, dp->swatches->centerX(5), dp->swatches->centerY(5));
    printf("picked in the dialog: %06X\n", dp->color);
    key(adp.KEY_ENTER, 13);
    printf("Enter (OK): result %08X, calls %d, window closed %d\n", dialogResult, dialogCalls, dlg->closed);
    dlg = gcode.pickColor(d, "Pick", 0x336699, onDialog);
    settle();
    root = (gui.Box*) dlg->root;
    gui.Box* btnRow = (gui.Box*) root->kids[1];
    gui.Button* cancel = (gui.Button*) btnRow->kids[2];
    clickWd(dlg, cancel, cancel->w / 2, cancel->h / 2);
    printf("Cancel: result %d, calls %d, closed %d\n", dialogResult, dialogCalls, dlg->closed);
    dlg = gcode.pickColor(d, "Pick", 0x336699, onDialog);
    settle();
    wsrv.Win* pw = srv->findWindow(d->clientNum, dlg->id);
    hb->click(pw->x + pw->w + 2 - 12, pw->y - 26 + 13);
    settle();
    printf("the close button of the window gives the same as Cancel: result %d, calls %d\n", dialogResult, dialogCalls);
    return 0;
}
