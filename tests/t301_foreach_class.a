import collections;

class Bag {
    int items[5];
    int n;
    public int count() { return n; }
    public int get(int i) { return items[i] * 2; }
    public void add(int v) { items[n] = v; n++; }
}
struct Pair { int a; int b; }
class PairList {
    Pair ps[4];
    int n;
    public int len() { return n; }
    public Pair operator[](int i) { return ps[i]; }
    public void add(int a, int b) { ps[n].a = a; ps[n].b = b; n++; }
}
int calls;
Bag* mk() { calls++; Bag* b = new Bag(); b->add(1); b->add(2); b->add(3); return b; }

int sum(int* p, int n) {
    int t = 0;
    foreach (int v in p, n) t += v;
    return t;
}
int findIdx(int target) {
    int arr[6] = {5, 6, 7, 8, 9, 10};
    defer println("deferred");
    foreach (int i, int v in arr) {
        if (v == target) return i;
    }
    return -1;
}

class Grid {
public:
    int cells[6];
    int n;
    int size() { return n; }
    int operator[](int i) { return cells[i] + 1000; }
}
class Grower {
public:
    int n;
    int visits;
    int length() { return n; }
    int get(int i) { visits++; if (i == 1) { n = 10; } return i; }
}
int nullTest() {
    collections.IntList* none = null;
    int seen = 0;
    foreach (int x in none) { seen++; }
    foreach (int x in rev none) { seen++; }
    char* t = null;
    foreach (char c in t) { seen++; }
    foreach (char c in rev t) { seen++; }
    return seen;
}
int main() {
    Bag bag;
    bag.add(5); bag.add(6);
    foreach (int x in bag) { printInt(x); print(" "); }
    println("");
    foreach (int x in mk()) { printInt(x); print(" "); }
    printlnInt(calls);
    collections.IntList* l = new collections.IntList();
    l->push(4); l->push(5); l->push(6);
    foreach (int x in l) { printInt(x); print(" "); }
    println("");
    foreach (int i, int x in rev l) { printInt(i * 100 + x); print(" "); }
    println("");
    collections.StrList* sl = new collections.StrList();
    sl->push("one"); sl->push("two");
    foreach (char* s in sl) { print(s); print("/"); }
    println("");
    PairList pl;
    pl.add(1, 2); pl.add(3, 4);
    foreach (Pair p in pl) { printInt(p.a + p.b); print(" "); }
    println("");
    // nested, break, continue
    int arr[3] = {1, 2, 3};
    foreach (int x in arr) {
        foreach (int y in arr) {
            if (y == 2) continue;
            if (x == 3) break;
            printInt(x * 10 + y); print(" ");
        }
        if (x == 2) continue;
        print("| ");
    }
    println("");
    printlnInt(findIdx(8));
    printlnInt(findIdx(99));
    printlnInt(sum(arr, 3));
    // loop variable modification does not affect iteration
    foreach (int i in 0..4) { i = i + 10; printInt(i); print(" "); }
    println("");
    // double elements
    double d[3] = {1.5, 2.5, 3.5};
    double tot = 0.0;
    foreach (double v in d) { tot = tot + v; }
    printlnDouble(tot);
    foreach (int v in d) { printInt(v); print(" "); }
    println("");
    // switch inside foreach with continue
    foreach (int i in 0..6) {
        switch (i) {
            case 1: continue;
            case 3: break;
            default: printInt(i); print(" ");
        }
    }
    println("");
    // uint8 variable
    foreach (uint8 b in 250..260) { printInt(b); print(" "); }
    println("");
    Grid g;
    g.cells[0] = 1; g.cells[1] = 2; g.cells[2] = 3; g.n = 3;
    foreach (int v in g) { printInt(v); print(" "); }
    println("");
    Grower gr;
    gr.n = 3;
    foreach (int v in gr) { printInt(v); print(" "); }
    printlnInt(gr.visits);                 // the count is read once: 3 visits although n grew
    printlnInt(nullTest());
    return 0;
}
