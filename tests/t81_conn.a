// conn: buffered connections, a listener and a poller serving two clients in one thread
import conn;
import net;

int main() {
    conn.Listener* l = new conn.Listener(0);
    printlnInt(l->ok());
    int port = l->port();
    printlnInt(port > 0);
    printlnInt(l->accept(50) == null);                       // nobody is connecting

    conn.Connection* a = conn.open("127.0.0.1", port, 1000);
    conn.Connection* b = conn.open("127.0.0.1", port, 1000);
    printlnInt(a != null && b != null);
    conn.Connection* sa = l->accept(1000);
    conn.Connection* sb = l->accept(1000);
    printlnInt(sa != null && sb != null);
    int ip; int pt;
    printlnInt(sa->peer(&ip, &pt));
    printlnInt(ip == 0x7F000001);

    // buffered writes become one packet; lines and exact reads come out of the read buffer
    a->writeLine("first line");
    a->writeText("second ");
    a->writeLine("line");
    a->write("0123456789", 10);
    a->flush();
    char line[64];
    printlnInt(sa->readLine(line, 64)); println(line);
    printlnInt(sa->readLine(line, 64)); println(line);
    printlnInt(sa->buffered());
    char digits[16];
    printlnInt(sa->readExact(digits, 10));
    digits[10] = 0;
    println(digits);
    printlnInt(sa->readable(0));

    // a poller over the two server side connections
    conn.Poller* p = new conn.Poller();
    p->add(sa->handle(), 1);
    p->add(sb->handle(), 2);
    printlnInt(p->wait(50));                                 // nothing to read
    b->writeLine("hello from b");
    b->flush();
    printlnInt(p->wait(1000));
    printlnInt(p->readyTag(0));
    sb->readLine(line, 64);
    println(line);
    sb->writeLine("echo: hello from b");
    sb->flush();
    b->readLine(line, 64);
    println(line);

    // end of connection: readLine gives -1
    a->close();
    printlnInt(p->wait(1000));
    printlnInt(sa->readLine(line, 64));
    printlnInt(sa->bytesIn);
    p->remove(sa->handle());
    printlnInt(p->count());
    sa->close(); sb->close(); b->close(); l->close();
    printlnInt(conn.open("127.0.0.1", port, 300) == null);   // the listener is gone
    printlnInt(conn.openRetry("127.0.0.1", port, 100, 2, 10) == null);
    return 0;
}
