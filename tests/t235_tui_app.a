// tui: App - timers, idle callbacks, shortcuts and commands, key hooks, focus callbacks, paste routing, context menus, toasts, the clipboard
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
int ticks;
int oneShot;
int idles;
int hookCalls;
int shortcutCalls;
int resizes;
int focusChanges;
int contexts;
char lastSc[40];

int tick(int ud) { ticks += ud; return 0; }
int once(int ud) { oneShot++; return 0; }
int idle(int a) { idles++; return 0; }
int sc(int ud) { shortcutCalls++; format(&lastSc[0], 40, "shortcut %d", ud, 0, 0, 0); return 0; }
int onResizeHook(int a) { resizes++; return 0; }
int hook(int a, int ev) {
    term.Event* e = (term.Event*) ev;
    hookCalls++;
    return term.keyIs(e, "F6") ? 1 : 0;
}
int focusChanged(int w) { focusChanges++; return 0; }
int context(int w) { contexts++; return 0; }
int widgetKey(int w, int ev) {
    term.Event* e = (term.Event*) ev;
    return term.keyIs(e, "Ctrl+G") ? 1 : 0;
}
int clicked(int b) { return 0; }

int main() {
    app = new tui.App();
    app->initHeadless(40, 8);
    tui.Box* col = tui.vbox(0, 0);
    tui.TextInput* ti = new tui.TextInput("");
    tui.Button* bt = new tui.Button("Button");
    bt->onClick = clicked;
    bt->onFocusChange = focusChanged;
    ti->onFocusChange = focusChanged;
    ti->onKey = widgetKey;
    bt->onContext = context;
    col->add(ti);
    col->add(bt);
    col->add(new tui.Label("below"));
    app->setRoot(col);
    app->onIdle = idle;
    app->onResizeHook = onResizeHook;
    app->pump(0);

    println("-- timers use the clock of the app (here a fake one)");
    int t1 = app->addTimer(100, tick, 1, true);
    int t2 = app->addTimer(250, once, 0, false);
    app->pump(0);
    printf("at 0 ms: ticks %d, one shot %d\n", ticks, oneShot);
    app->advanceClock(100);
    app->pump(0);
    printf("at 100 ms: ticks %d\n", ticks);
    app->advanceClock(150);
    app->pump(0);
    printf("at 250 ms: ticks %d, one shot %d\n", ticks, oneShot);
    app->advanceClock(1000);
    app->pump(0);
    app->pump(0);
    printf("at 1250 ms: ticks %d (a repeating timer that is late runs once), one shot %d (only once)\n", ticks, oneShot);
    app->cancelTimer(t1);
    app->advanceClock(500);
    app->pump(0);
    printf("cancelled: ticks %d\n", ticks);
    int t3 = app->addTimer(10, tick, 100, false);
    app->cancelTimer(t3);
    app->advanceClock(50);
    app->pump(0);
    printf("a timer cancelled before it was due: %d\n", ticks);
    int cb = -1;
    int ids[70];
    for (int i = 0; i < 70; i++) { cb = app->addTimer(1000000, tick, 0, true); ids[i] = cb; }
    printf("more than 64 timers: the last id %d\n", cb);
    for (int i = 0; i < 70; i++) { if (ids[i] >= 0) { app->cancelTimer(ids[i]); } }

    println("-- the idle callback runs after events were handled");
    int before = idles;
    app->pump(0);
    app->type("a");
    printf("idle calls: %d\n", idles - before);

    println("-- focus callbacks");
    focusChanges = 0;
    app->press("Tab");
    printf("Tab: %d changes (lost + gained), focus on the button: %d\n", focusChanges, app->focus == bt);
    app->click(2, 0);
    printf("clicking the text field: %d changes, focus on it: %d\n", focusChanges, app->focus == ti);

    println("-- shortcuts: with a modifier they come first, plain keys only when the focus does not want text");
    app->addShortcut("Ctrl+K", sc, 1);
    app->addShortcut("F4", sc, 2);
    app->addShortcut("x", sc, 3);
    app->addShortcut("Alt+z", sc, 4);
    printf("a bad key name: %d\n", app->addShortcut("Hyper+Q", sc, 5));
    lastSc[0] = 0;
    app->press("Ctrl+K");
    printf("%s\n", &lastSc[0]);
    app->press("F4");
    printf("%s\n", &lastSc[0]);
    lastSc[0] = 0;
    app->type("x");
    printf("typing x in the text field inserts it: '%s', shortcut '%s'\n", ti->getText(), &lastSc[0]);
    app->press("Tab");
    app->type("x");
    printf("with the button focused the plain shortcut runs: %s\n", &lastSc[0]);
    app->press("Alt+z");
    printf("%s\n", &lastSc[0]);
    app->addShortcut("Ctrl+K", sc, 9);
    app->press("Ctrl+K");
    printf("registering a key again replaces the action: %s, %d registered\n", &lastSc[0], app->nsc);

    println("-- key hooks: the app hook sees every key first, a widget hook sees keys for that widget");
    app->onKeyHook = hook;
    hookCalls = 0;
    shortcutCalls = 0;
    app->addShortcut("F6", sc, 6);
    app->press("F6");
    printf("F6 was taken by the hook: hook calls %d, shortcut calls %d\n", hookCalls, shortcutCalls);
    app->press("F4");
    printf("F4 passes through: hook calls %d, shortcut calls %d\n", hookCalls, shortcutCalls);
    app->onKeyHook = null;
    ti->focusMe();
    app->addShortcut("Ctrl+G", sc, 7);
    lastSc[0] = 0;
    app->press("Ctrl+G");
    printf("the shortcut still wins over a widget hook (shortcuts come first): '%s'\n", &lastSc[0]);

    println("-- commands");
    tui.Command* c = app->addCommand("Do it", "Ctrl+J", sc, 8);
    printf("%d commands, name '%s', keys '%s'\n", app->ncommands, c->name.str(), c->keys.str());
    app->press("Ctrl+J");
    printf("%s\n", &lastSc[0]);

    println("-- paste goes to the focused widget");
    ti->setText("");
    ti->focusMe();
    app->paste("pasted\nline");
    printf("'%s'\n", ti->getText());
    bt->focusMe();
    app->paste("ignored by a button");
    printf("the button ignores it\n");

    println("-- resize");
    resizes = 0;
    app->resizeTo(60, 10);
    printf("size %dx%d, hook calls %d, root %dx%d\n", app->cols, app->rows, resizes, app->root->w, app->root->h);
    app->dec->push(term.EV_RESIZE, 0, 30, 5);
    app->pump(0);
    printf("a resize event: size %dx%d, hook calls %d\n", app->cols, app->rows, resizes);
    app->resizeTo(40, 8);

    println("-- right click: the context hook of the widget under the pointer or of a parent");
    app->click(1, 1, 3);
    printf("contexts %d\n", contexts);
    app->click(1, 0, 3);
    printf("on the text field there is no hook: contexts %d\n", contexts);

    println("-- toast: a message that disappears by itself");
    tui.Widget* focusBefore = app->focus;
    app->toast("saved!", 1000);
    println(app->text());
    printf("overlays %d\n", app->nov);
    printf("focus not stolen: %d\n", app->focus == focusBefore);
    app->advanceClock(1500);
    app->pump(0);
    printf("after the time: overlays %d\n", app->nov);

    println("-- the clipboard");
    app->setClipboard("copied text");
    printf("'%s'\n", app->clipboard.str());
    ti->setText("");
    ti->focusMe();
    app->press("Ctrl+V");
    printf("Ctrl+V in the text field: '%s'\n", ti->getText());

    println("-- the loop stops when quit() is called; the exit code is kept");
    app->quit(7);
    printf("running %d, exit code %d\n", app->running, app->exitCode);

    println("-- the output of the diff renderer");
    app = new tui.App();
    app->initHeadless(20, 3);
    app->setRoot(new tui.Label("hello"));
    app->pump(0);
    printf("the first frame is more than 20 bytes (it clears the screen): %d\n", app->lastOutBytes > 20);
    app->pump(0);
    ((tui.Label*) app->root)->setText("hellp");
    app->pump(0);
    printf("one changed character: %d bytes\n", app->lastOutBytes);
    app->pump(0);
    printf("nothing changed: frames %d\n", app->frames);
    return 0;
}
