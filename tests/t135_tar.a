import cstdio;
import cstdlib;
import cstring;
import tar;

int main() {
    tar.Writer* w = new tar.Writer();
    w->addDir("docs");
    w->add("docs/readme.txt", "hello tar\n", 10);
    w->add("empty.bin", "", 0);
    char* big = malloc(1500);
    for (int i = 0; i < 1500; i++) { big[i] = 'a' + i % 26; }
    w->add("docs/big.dat", big, 1500);
    // a name over 100 characters is split at a slash into prefix and name
    char longName[200];
    strcpy(longName, "very/long/directory/path/that/keeps/going/and/going/and/going/until/it/is/more/than/one/hundred/characters/file.txt");
    printf("long name added: %d\n", w->add(longName, "x", 1));
    int n;
    char* a = w->finish(&n);
    printf("archive size %d, multiple of 512: %d\n", n, n % 512 == 0);

    tar.Reader* r = new tar.Reader(a, n);
    int files = 0;
    while (r->next()) {
        printf("%s %d %s\n", r->name, r->size, r->isDir ? "dir" : "file");
        files++;
    }
    printf("entries %d, damaged %d\n", files, r->bad);

    tar.Reader* r2 = new tar.Reader(a, n);
    r2->next();
    r2->next();
    printf("content: %s", r2->data);

    FILE* f = fopen("/tmp/claude_t135.tar", "wb");
    if (f != null) { fwrite(a, 1, n, f); fclose(f); }

    // a flipped byte in a header is detected
    a[10] = a[10] ^ 1;
    tar.Reader* r3 = new tar.Reader(a, n);
    printf("damaged first: %d, bad %d\n", r3->next(), r3->bad);

    return 0;
}
