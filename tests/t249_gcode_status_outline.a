// gcode.StatusBar / EditorStatus (position, selection, indentation, encoding, line ends, language, clicks) and gcode.Outline (symbols
// of the document, jump, filter, follow the caret, refresh after edits, another language, another editor)
import wsrv;
import gui;
import guix;
import gcode;
import asyntax;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gcode.EditorStatus* es;
gcode.Outline* ol;
gui.Window* w;
int jumps = 0;
int sectionClicks = 0;

int onJump(int o) { jumps++; return 0; }

void status(char* label) {
    printf("%s:", label);
    for (int i = 0; i < es->bar->sectionCount(); i++) { printf(" |%s", es->bar->text(i)); }
    printf("\n");
}

void symbols(char* label) {
    printf("%s: %d rows", label, ol->rowCount());
    char t[200];
    for (int i = 0; i < ol->rowCount() && i < 20; i++) {
        printf(" %s(%s@%d)", ol->rowText(i, &t[0]), asyntax.symKindName(ol->rowKind(i)), ol->rowLine(i));
    }
    printf("\n");
}

// the centre of an outline row
int rowY(int i) { return ol->headerH + (i - ol->top) * ol->rowH + ol->rowH / 2; }

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;       // a click or a key then repaints one row, not the window: much faster under emulation
    gcode.theLook()->matchBrackets = false;
    rmtree("build/tests/t249_files");
    asys.mkdirs("build/tests/t249_files");
    startServer(7349, "t249");
    w = d->createWindow("Status", 700, 420, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    es = new gcode.EditorStatus(e);
    ol = new gcode.Outline(e);
    ol->onJump = onJump;
    gui.Box* row = gui.hbox(0, 0);
    row->flex = 1;
    ol->flex = 0;
    ol->w = 220;
    row->add(ol);
    row->add(e);
    gui.Box* col = gui.vbox(0, 0);
    col->add(row);
    col->add(es->bar);
    w->setRoot(col);
    w->setFocus(e);
    char* src = "module demo;\nconst LIMIT = 10;\npublic class Counter {\n    private int total;\n    public Counter() { total = 0; }\n    public void add(int n) { total = total + n; }\n    public int get() { return total; }\n}\nstruct Point { int x; int y; }\nenum Color { Red, Green }\nint helper(int a) { return a * 2; }\nint main() { return helper(3); }\n";
    e->setText(src);
    e->doc->setLanguage(asyntax.Lang.A);
    settle();

    // the status bar follows the editor
    status("a document of A code");
    e->gotoLine(4, 7);
    settle();
    status("caret at line 5 column 8");
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    status("a word selected");
    e->ed->addCursor(0, 0);
    e->touch();
    settle();
    status("two cursors");
    key(adp.KEY_ESCAPE, 27);
    e->setReadOnly(true);
    status("read only");
    e->setReadOnly(false);

    // files: line ends, byte order mark, tabs
    writeFile("build/tests/t249_files/crlf.txt", "one\r\ntwo\r\nthree\r\n");
    writeFile("build/tests/t249_files/mixed.txt", "one\r\ntwo\nthree\n");
    writeFile("build/tests/t249_files/bom.txt", "\xef\xbb\xbfhello\n");
    writeFile("build/tests/t249_files/tabs.py", "def f():\n\tif x:\n\t\treturn 1\n");
    printf("open crlf: %d\n", e->open("build/tests/t249_files/crlf.txt"));
    status("crlf.txt");
    e->open("build/tests/t249_files/mixed.txt");
    status("mixed.txt");
    e->open("build/tests/t249_files/bom.txt");
    status("bom.txt");
    e->open("build/tests/t249_files/tabs.py");
    status("tabs.py (indentation is detected, the language comes from the name)");
    printf("open of a missing file: %d\n", e->open("build/tests/t249_files/missing.txt") < 0);

    // clicking the sections: indentation toggles tabs and spaces, line ends cycle
    int before = e->ed->useTabs;
    clickWd(w, es->bar, es->bar->sectionX(gcode.ST_INDENT), 12);
    printf("click on the indentation: useTabs %d -> %d\n", before, e->ed->useTabs);
    status("after the click");
    clickWd(w, es->bar, es->bar->sectionX(gcode.ST_EOL), 12);
    status("click on the line ends");
    clickWd(w, es->bar, es->bar->sectionX(gcode.ST_EOL), 12);
    clickWd(w, es->bar, es->bar->sectionX(gcode.ST_EOL), 12);
    status("two more clicks (back to LF)");
    clickWd(w, es->bar, es->bar->sectionX(gcode.ST_POS), 12);
    printf("the position section is not a button: nothing changed\n");
    es->setMessage("Saved main.a");
    status("a message");

    // the outline
    e->setText(src);
    e->doc->setLanguage(asyntax.Lang.A);
    settle();
    symbols("outline of the A code");

    // a click jumps; the caret goes to the symbol and the focus to the editor
    clickWd(w, ol, 80, rowY(3));
    printf("click on row 4: caret line %d, jumps %d, focus in the editor %d\n", e->ed->caretLine(), jumps, w->focusWidget == e);
    clickWd(w, ol, 80, rowY(ol->rowCount() - 1));
    printf("click on the last row: caret line %d, jump target %d\n", e->ed->caretLine(), ol->jumpLine);

    // the symbol around the caret is selected while the caret moves
    e->gotoLine(5, 0);
    settle();
    printf("caret in line 6: selected row %d is %s\n", ol->selected, ol->rowText(ol->selected, (char*) asys.alloc(200)));
    e->gotoLine(10, 0);
    settle();
    char tmp[200];
    printf("caret in line 11: selected row %d is %s\n", ol->selected, ol->rowText(ol->selected, &tmp[0]));

    // the filter
    ol->filterBox->focusMe();
    typeStr("ad");
    symbols("filter ad");
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    printf("Down + Enter in the filter: caret line %d\n", e->ed->caretLine());
    ol->filterBox->setText("");
    ol->applyFilter();

    // after edits the outline reads the symbols again (a timer does this after a short pause; tick() is what the timer calls)
    e->gotoLine(11, 0);
    e->ed->moveEnd(false);
    e->ed->insertString("\nint added() { return 1; }\n");
    e->touch();
    ol->tick();
    printf("a function was added: %d symbols, last %s\n", ol->symbolCount(), ol->rowText(ol->rowCount() - 1, &tmp[0]));
    ctrl('z');
    ol->tick();
    printf("after undo: %d symbols\n", ol->symbolCount());

    // other languages
    e->setText("# Title\n\ntext\n\n## Section one\n\n### Deeper\n\n## Section two\n");
    e->doc->setLanguage(asyntax.Lang.Markdown);
    ol->tick();
    symbols("Markdown headings");
    e->setText("def top():\n    pass\n\nclass K:\n    def method(self):\n        pass\n");
    e->doc->setLanguage(asyntax.Lang.Python);
    ol->tick();
    symbols("Python");
    e->setText("just some text\n");
    e->doc->setLanguage(asyntax.Lang.Text);
    ol->tick();
    symbols("plain text");
    printf("empty text shown: %s\n", ol->emptyText);

    // another editor
    gcode.CodeEditor* e2 = new gcode.CodeEditor();
    e2->setText("int other() { return 1; }\n");
    e2->doc->setLanguage(asyntax.Lang.A);
    ol->setTarget(e2);
    symbols("outline of another editor");
    es->setEditor(e2);
    status("status of another editor");

    // pictures in two themes
    ol->setTarget(e);
    es->setEditor(e);
    e->setText(src);
    e->doc->setLanguage(asyntax.Lang.A);
    e->gotoLine(5, 8);
    ol->tick();
    settle();
    gcode.theLook()->setThemeName("dark");
    settle();
    printf("dark screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("dark");
    return 0;
}
