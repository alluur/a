// the extra widgets of guix with the display server in the same process: menus, accelerators, context menus, combo box,
// radio buttons, tabs, scrolling, spin box, splitter, tooltips and the dialogs
import wsrv;
import gui;
import guix;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;

int opened = 0;
int saved = 0;
int wrapOn = 1;
int subHit = 0;
int ctxHit = 0;
int comboChanges = 0;
int radioChanges = 0;
int spinChanges = 0;
int tabChanges = 0;
int confirmed = -1;
char* promptText = null;
char* fileResult = null;
int colorResult = -1;
int dialogCalls = 0;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

// the screen position of the middle of a widget
int screenX(gui.Window* gw, gui.Widget* wd) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    return sw->x + wd->absX() + wd->w / 2;
}

int screenY(gui.Window* gw, gui.Widget* wd) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    return sw->y + wd->absY() + wd->h / 2;
}

void clickAt(gui.Window* gw, gui.Widget* wd) {
    hb->click(screenX(gw, wd), screenY(gw, wd));
    settle();
}

// a position inside the window at (x, y) in window coordinates
void clickWin(gui.Window* gw, int x, int y) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    hb->click(sw->x + x, sw->y + y);
    settle();
}

void hoverWin(gui.Window* gw, int x, int y) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    hb->moveTo(sw->x + x, sw->y + y);
    settle();
}

void key(int k, int uni) {
    hb->tap(k, uni);
    settle();
}

void ctrl(int k) {
    hb->keyDown(adp.KEY_CTRL, 0);
    hb->tap(k, k);
    hb->keyUp(adp.KEY_CTRL, 0);
    settle();
}

int onOpen(int item) { opened++; return 0; }
int onSave(int item) { saved++; return 0; }
int onWrap(int item) { guix.MenuItem* m = (guix.MenuItem*) item; wrapOn = m->checked ? 1 : 0; return 0; }
int onSub(int item) { guix.MenuItem* m = (guix.MenuItem*) item; subHit = m->id; return 0; }
int onCtx(int item) { ctxHit++; return 0; }
int onComboChange(int self) { comboChanges++; return 0; }
int onRadio(int self) { radioChanges++; return 0; }
int onSpin(int self) { spinChanges++; return 0; }
int onTab(int self) { tabChanges++; return 0; }
int noop(int item) { return 0; }

guix.Menu* ctxMenu;
int showContext(int widget) {
    gui.Widget* wd = (gui.Widget*) widget;
    ctxMenu->popup(wd->win, wd->win->lastMouseX, wd->win->lastMouseY);
    return 0;
}

int gotConfirm(int yes) { confirmed = yes; dialogCalls++; return 0; }
int gotPrompt(int text) { promptText = (char*) text; dialogCalls++; return 0; }
int gotFile(int p) { fileResult = (char*) p; dialogCalls++; return 0; }
int gotColor(int c) { colorResult = c; dialogCalls++; return 0; }

int main() {
    hb = new wsrv.Headless(800, 600);
    srv = new wsrv.Server(hb, 7212);
    srv->allowScreenshots = true;
    gui.idleHook = stepServer;
    d = gui.connectAs("7212", "widgets");

    // ---- menu bar ---------------------------------------------------------------------------------------------------------------------------
    gui.Window* w = d->createWindow("Widgets", 460, 560, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Open...", onOpen)->accel("Ctrl+O");
    file->add("Save", onSave)->accel("Ctrl+S");
    file->addSeparator();
    file->add("Quit", noop)->accel("Alt+F4")->disable();
    guix.Menu* edit = bar->addMenu("&Edit");
    edit->addCheck("Word wrap", true, onWrap);
    guix.Menu* more = new guix.Menu();
    more->add("Alpha", onSub)->setId(1);
    more->add("Beta", onSub)->setId(2);
    edit->addSub("More", more);
    col->add(bar);
    gui.Box* body = gui.vbox(6, 10);
    body->flex = 1;
    col->add(body);

    gui.Label* hint = new gui.Label("Hover me");
    hint->tooltip = "A tooltip";
    body->add(hint);
    ctxMenu = new guix.Menu();
    ctxMenu->add("Copy", onCtx);
    ctxMenu->add("Paste", onCtx);
    hint->onContext = showContext;

    guix.ComboBox* combo = new guix.ComboBox();
    combo->addItem("Red");
    combo->addItem("Green");
    combo->addItem("Blue");
    combo->onChange = onComboChange;
    body->add(combo);

    guix.RadioGroup* group = new guix.RadioGroup();
    group->onChange = onRadio;
    guix.RadioButton* r1 = new guix.RadioButton("One", group);
    guix.RadioButton* r2 = new guix.RadioButton("Two", group);
    guix.RadioButton* r3 = new guix.RadioButton("Three", group);
    body->add(r1);
    body->add(r2);
    body->add(r3);
    group->select(r1);
    radioChanges = 0;

    guix.SpinBox* spin = new guix.SpinBox(0, 100);
    spin->onChange = onSpin;
    body->add(spin);

    guix.TabView* tabs = new guix.TabView();
    gui.Box* page1 = gui.vbox(4, 6);
    page1->add(new gui.Label("First page"));
    gui.Box* page2 = gui.vbox(4, 6);
    page2->add(new gui.Label("Second page"));
    tabs->addTab("One", page1);
    tabs->addTab("Two", page2);
    tabs->onChange = onTab;
    tabs->flex = 1;
    body->add(tabs);

    gui.Box* rows = gui.vbox(2, 4);
    for (int i = 0; i < 30; i++) {
        char buf[32];
        strcpy(&buf[0], "Row ");
        intToStr(i, &buf[4]);
        if (i == 29) {
            gui.Button* last = new gui.Button("Last row");
            rows->add(last);
        } else {
            rows->add(new gui.Label(&buf[0]));
        }
    }
    guix.ScrollView* sv = new guix.ScrollView();
    sv->setContent(rows);
    sv->fitWidth = true;
    sv->border = true;
    sv->flex = 1;
    body->add(sv);
    w->setRoot(col);
    settle();
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    printlnInt(sw != null);
    printlnInt(w->popup == null);

    // clicking a title opens its menu, a click on an item runs it and closes the menu
    clickWin(w, 20, 13);
    printlnInt(w->popup != null);
    clickWin(w, 40, 26 + 4 + 12);
    printlnInt(opened);
    printlnInt(w->popup == null);

    // accelerators
    ctrl('s');
    ctrl('s');
    printlnInt(saved);
    ctrl('o');
    printlnInt(opened);

    // a disabled item does nothing, the separator is not an item
    clickWin(w, 20, 13);
    clickWin(w, 40, 26 + 4 + 24 + 24 + 9 + 12);
    printlnInt(w->popup != null);
    key(adp.KEY_ESCAPE, 0);
    printlnInt(w->popup == null);

    // moving over the other title switches menus; the check item toggles
    clickWin(w, 20, 13);
    hoverWin(w, 70, 13);
    clickWin(w, 80, 26 + 4 + 12);
    printlnInt(wrapOn);
    clickWin(w, 70, 13);
    clickWin(w, 80, 26 + 4 + 12);
    printlnInt(wrapOn);

    // a submenu opens beside its item
    clickWin(w, 70, 13);
    hoverWin(w, 80, 26 + 4 + 24 + 12);
    clickWin(w, 80, 26 + 4 + 24 + 12);
    printlnInt(w->popup != null);
    hoverWin(w, 80 + 100, 26 + 4 + 24 + 12 + 24);
    printlnInt(w->popup != null);
    key(adp.KEY_ESCAPE, 0);
    key(adp.KEY_ESCAPE, 0);
    printlnInt(w->popup == null);

    // the keyboard: F10, Down, Enter
    key(adp.KEY_F1 + 9, 0);
    printlnInt(w->popup != null);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    printlnInt(w->popup == null);
    printlnInt(saved);

    // Alt+E opens the Edit menu, Right/Left move between menus
    hb->keyDown(adp.KEY_ALT, 0);
    hb->tap('e', 'e');
    hb->keyUp(adp.KEY_ALT, 0);
    settle();
    printlnInt(w->popup != null);
    key(adp.KEY_LEFT, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    printlnInt(opened);

    // the context menu on a right click
    hb->moveTo(sw->x + hint->absX() + 5, sw->y + hint->absY() + 5);
    hb->buttonDown(3);
    hb->buttonUp(3);
    settle();
    printlnInt(w->popup != null);
    clickWin(w, w->lastMouseX + 10, w->lastMouseY + 4 + 12);
    printlnInt(ctxHit);
    printlnInt(w->popup == null);

    // a click outside closes a menu and does not hit what is below it
    clickWin(w, 20, 13);
    clickWin(w, 300, 300);
    printlnInt(w->popup == null);

    // ---- tooltip ---------------------------------------------------------------------------------------------------------------------------
    hoverWin(w, hint->absX() + 4, hint->absY() + 4);
    printlnInt(w->tipVisible());
    int t0 = millis();
    while (millis() - t0 < 700) {
        hoverWin(w, hint->absX() + 4 + (millis() / 100) % 2, hint->absY() + 4);
        sleepMs(20);
    }
    printlnInt(w->tipVisible());
    hoverWin(w, 400, 300);
    printlnInt(w->tipVisible());

    // ---- combo box -------------------------------------------------------------------------------------------------------------------------
    clickAt(w, combo);
    printlnInt(w->popup != null);
    clickWin(w, combo->absX() + 20, combo->absY() + combo->h + 1 + 24 + 12);
    printlnInt(combo->selected);
    printlnInt(comboChanges);
    printlnInt(w->popup == null);
    combo->focusMe();
    key(adp.KEY_DOWN, 0);
    println(combo->text());
    key(adp.KEY_ENTER, 13);
    key(adp.KEY_UP, 0);
    key(adp.KEY_ENTER, 13);
    println(combo->text());
    printlnInt(comboChanges);

    // ---- radio buttons ---------------------------------------------------------------------------------------------------------------------
    clickAt(w, r3);
    printlnInt(group->selectedIndex());
    key(adp.KEY_UP, 0);
    printlnInt(group->selectedIndex());
    printlnInt(radioChanges);

    // ---- spin box --------------------------------------------------------------------------------------------------------------------------
    clickWin(w, spin->absX() + spin->w - 10, spin->absY() + 5);
    printlnInt(spin->value);
    clickWin(w, spin->absX() + spin->w - 10, spin->absY() + spin->h - 5);
    clickWin(w, spin->absX() + spin->w - 10, spin->absY() + spin->h - 5);
    printlnInt(spin->value);
    spin->focusMe();
    hb->typeText("42");
    key(adp.KEY_ENTER, 13);
    printlnInt(spin->value);
    hb->typeText("999");
    key(adp.KEY_ENTER, 13);
    printlnInt(spin->value);
    key(adp.KEY_PGDN, 0);
    printlnInt(spin->value);
    printlnInt(spinChanges);

    // ---- tabs ------------------------------------------------------------------------------------------------------------------------------
    printlnInt(page1->visible * 10 + page2->visible);
    clickWin(w, tabs->absX() + 70, tabs->absY() + 20);
    printlnInt(tabs->selected);
    printlnInt(page1->visible * 10 + page2->visible);
    tabs->focusMe();
    key(adp.KEY_LEFT, 0);
    printlnInt(tabs->selected);
    printlnInt(tabChanges);

    // ---- scrolling -------------------------------------------------------------------------------------------------------------------------
    printlnInt(sv->offY);
    hb->moveTo(sw->x + sv->absX() + 30, sw->y + sv->absY() + 30);
    hb->scroll(-1);
    settle();
    printlnInt(sv->offY);
    hb->scroll(1);
    settle();
    printlnInt(sv->offY);
    // the focus of a widget that is not in view scrolls it into view
    gui.Button* lastButton = (gui.Button*) rows->kids[29];
    lastButton->focusMe();
    settle();
    printlnInt(sv->offY > 0);
    printlnInt(lastButton->absY() + lastButton->h <= sv->absY() + sv->h);

    // ---- screenshot of the whole thing is stable ----------------------------------------------------------------------------------------
    printlnInt(srv->screen->checksum());

    // ---- splitter --------------------------------------------------------------------------------------------------------------------------
    gui.Window* w2 = d->createWindow("Split", 400, 200, 0);
    guix.Splitter* sp = new guix.Splitter(true, 120);
    gui.Label* left = new gui.Label("left");
    gui.Label* right = new gui.Label("right");
    sp->add(left);
    sp->add(right);
    w2->setRoot(sp);
    settle();
    printlnInt(left->w);
    printlnInt(right->w);
    wsrv.Win* sw3 = srv->findWindow(d->clientNum, w2->id);
    hb->moveTo(sw3->x + 122, sw3->y + 50);
    hb->buttonDown(1);
    hb->moveTo(sw3->x + 222, sw3->y + 50);
    hb->buttonUp(1);
    settle();
    printlnInt(sp->pos);
    printlnInt(left->w);
    printlnInt(right->w);
    w2->close();
    settle();

    // ---- dialogs ---------------------------------------------------------------------------------------------------------------------------
    int base = srv->windowCount();
    gui.Window* dlg = guix.confirm(d, "Sure?", "Do you want to continue?", gotConfirm);
    settle();
    printlnInt(srv->windowCount() - base);
    key(adp.KEY_ENTER, 13);
    printlnInt(confirmed);
    printlnInt(srv->windowCount() - base);
    dlg = guix.confirm(d, "Sure?", "Again?", gotConfirm);
    settle();
    key(adp.KEY_TAB, 0);
    key(adp.KEY_ENTER, 13);
    printlnInt(confirmed);
    printlnInt(dialogCalls);

    dlg = guix.prompt(d, "Name", "Your name:", "Aytict", gotPrompt);
    settle();
    hb->typeText("!");
    key(adp.KEY_ENTER, 13);
    println(promptText);
    dlg = guix.prompt(d, "Name", "Your name:", "x", gotPrompt);
    settle();
    wsrv.Win* pw = srv->findWindow(d->clientNum, dlg->id);
    hb->click(pw->x + pw->w + 2 - 12, pw->y - 26 + 13);
    settle();
    printlnInt((int) promptText);
    printlnInt(dialogCalls);

    // the file dialog on a directory we make
    makeDir("build/tests/t115_dir");
    makeDir("build/tests/t115_dir/sub");
    writeFile("build/tests/t115_dir/beta.txt", "b");
    writeFile("build/tests/t115_dir/Alpha.txt", "a");
    writeFile("build/tests/t115_dir/.hidden", "h");
    writeFile("build/tests/t115_dir/sub/inner.txt", "i");
    dlg = guix.openFile(d, "Open", "build/tests/t115_dir", gotFile);
    settle();
    gui.Box* froot = (gui.Box*) dlg->root;
    gui.ListBox* list = (gui.ListBox*) froot->kids[1];
    for (int i = 0; i < list->size(); i++) {
        println(list->item(i));
    }
    // enter the folder (double click on it), go back with .., pick a file with a double click
    int rowH = gfx.sans()->height + 6;
    wsrv.Win* fw = srv->findWindow(d->clientNum, dlg->id);
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH * 1 + rowH / 2);
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH * 1 + rowH / 2);
    settle();
    println(list->item(0));
    printlnInt(list->size());
    sleepMs(450);
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH / 2);
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH / 2);
    settle();
    printlnInt(list->size());
    sleepMs(450);
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH * 3 + rowH / 2);
    settle();
    hb->click(fw->x + list->absX() + 30, fw->y + list->absY() + 1 + rowH * 3 + rowH / 2);
    settle();
    println(fileResult);
    printlnInt(dialogCalls);

    // save: typing a name; the file exists, so we are asked first
    fileResult = null;
    dlg = guix.saveFile(d, "Save", "build/tests/t115_dir", "beta.txt", gotFile);
    settle();
    key(adp.KEY_ENTER, 13);
    printlnInt((int) fileResult);
    printlnInt(srv->windowCount() - base);
    key(adp.KEY_ENTER, 13);
    println(fileResult);
    printlnInt(srv->windowCount() - base);

    // colours
    dlg = guix.chooseColor(d, "Colour", 0xFF102030, gotColor);
    settle();
    gui.Box* croot = (gui.Box*) dlg->root;
    gui.Box* rrow = (gui.Box*) croot->kids[1];
    gui.Slider* sr = (gui.Slider*) rrow->kids[1];
    sr->focusMe();
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_TAB, 0);
    key(adp.KEY_TAB, 0);
    key(adp.KEY_TAB, 0);
    key(adp.KEY_ENTER, 13);
    printlnInt(colorResult);

    d->disconnect();
    srv->close();
    return 0;
}
