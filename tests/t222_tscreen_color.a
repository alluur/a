// tscreen: colour values, the 256 colour palette and the downgrade to 256 / 16 / 8 / no colours
import tscreen;
import term;

void hexOf(int c) { printf("%06x", c); }

int main() {
    println("-- values");
    printf("%x %x %x\n", tscreen.rgb(1, 2, 3), tscreen.hex(0xABCDEF), tscreen.idx(200));
    printf("%x %x\n", tscreen.RED, tscreen.BRIGHT_WHITE);
    int st = tscreen.style(tscreen.rgb(10, 20, 30), tscreen.idx(5), tscreen.A_BOLD | tscreen.A_UNDERLINE);
    printf("fg %x bg %x attr %d\n", tscreen.fgOf(st), tscreen.bgOf(st), tscreen.attrOf(st));
    st = tscreen.withFg(st, tscreen.GREEN);
    st = tscreen.withBg(st, tscreen.COL_KEEP);
    st = tscreen.addAttr(st, tscreen.A_REVERSE);
    st = tscreen.delAttr(st, tscreen.A_BOLD);
    printf("fg %x bg %x attr %d\n", tscreen.fgOf(st), tscreen.bgOf(st), tscreen.attrOf(st));
    printf("%d %d %d\n", tscreen.redOf(0x336699), tscreen.greenOf(0x336699), tscreen.blueOf(0x336699));

    println("-- the palette");
    int probe[12] = {0, 1, 7, 8, 15, 16, 21, 46, 196, 231, 232, 255};
    for (int i = 0; i < 12; i++) {
        printf("%d: ", probe[i]);
        hexOf(tscreen.paletteRgb(probe[i]));
        println("");
    }
    printf("rgbOf: %d %x %x\n", tscreen.rgbOf(0), tscreen.rgbOf(tscreen.idx(9)), tscreen.rgbOf(tscreen.rgb(1, 2, 3)));

    println("-- nearest of the 16 ANSI colours");
    int samples[10] = {0x000000, 0xFFFFFF, 0xFF0000, 0x00FF00, 0x0000FF, 0x808080, 0xFFA500, 0x800080, 0x204080, 0xC0C0C0};
    for (int i = 0; i < 10; i++) {
        hexOf(samples[i]);
        printf(" -> 16: %d  256: %d\n", tscreen.nearest16(samples[i]), tscreen.nearest256(samples[i]));
    }

    println("-- downgrade of one colour through the depths");
    int cols[4] = {tscreen.rgb(255, 128, 0), tscreen.idx(200), tscreen.idx(12), tscreen.COL_DEFAULT};
    for (int i = 0; i < 4; i++) {
        printf("%x:", cols[i]);
        printf(" true %x", tscreen.downgrade(cols[i], term.COLORS_TRUE));
        printf(" 256 %x", tscreen.downgrade(cols[i], term.COLORS_256));
        printf(" 16 %x", tscreen.downgrade(cols[i], term.COLORS_16));
        printf(" 8 %x", tscreen.downgrade(cols[i], term.COLORS_8));
        printf(" none %x\n", tscreen.downgrade(cols[i], term.COLORS_NONE));
    }

    println("-- the 256 conversion agrees with a search of the whole palette");
    int worse = 0;
    int checked = 0;
    for (int r = 0; r < 256; r = r + 17) {
        for (int g = 0; g < 256; g = g + 17) {
            for (int b = 0; b < 256; b = b + 17) {
                int c = (r << 16) | (g << 8) | b;
                int best = 16;
                int bd = 0x7FFFFFFF;
                for (int i = 16; i < 256; i++) {
                    int p = tscreen.paletteRgb(i);
                    int dr = r - ((p >> 16) & 255);
                    int dg = g - ((p >> 8) & 255);
                    int db = b - (p & 255);
                    int rm = (r + ((p >> 16) & 255)) / 2;
                    int d = (((512 + rm) * dr * dr) >> 8) + 4 * dg * dg + (((767 - rm) * db * db) >> 8);
                    if (d < bd) { bd = d; best = i; }
                }
                int got = tscreen.nearest256(c);
                int p2 = tscreen.paletteRgb(got);
                int dr2 = r - ((p2 >> 16) & 255);
                int dg2 = g - ((p2 >> 8) & 255);
                int db2 = b - (p2 & 255);
                int rm2 = (r + ((p2 >> 16) & 255)) / 2;
                int d2 = (((512 + rm2) * dr2 * dr2) >> 8) + 4 * dg2 * dg2 + (((767 - rm2) * db2 * db2) >> 8);
                checked++;
                if (d2 != bd) { worse++; }
            }
        }
    }
    printf("%d colours checked, %d worse than the best\n", checked, worse);

    println("-- capability detection");
    char* terms[14] = {"xterm-256color", "xterm", "linux", "vt100", "dumb", "screen", "tmux-256color", "alacritty", "xterm-kitty", "rxvt-unicode-256color", "st-256color", "ansi", "xterm-direct", "foot"};
    for (int i = 0; i < 14; i++) {
        term.Caps c();
        term.capsFor(&c, terms[i], null, true, false);
        printf("%-22s colors %d mouse %d alt %d paste %d italic %d title %d addr %d\n", terms[i], c.colors, c.mouse, c.altScreen, c.bracketedPaste, c.italic, c.title, c.cursorAddr);
    }
    term.Caps c();
    term.capsFor(&c, "xterm", "truecolor", true, false);
    printf("xterm + COLORTERM=truecolor: %d\n", c.colors);
    term.capsFor(&c, "linux", "truecolor", true, false);
    printf("linux + COLORTERM=truecolor: %d\n", c.colors);
    term.capsFor(&c, "xterm-256color", null, true, true);
    printf("NO_COLOR: %d\n", c.colors);
    term.capsFor(&c, null, null, false, false);
    printf("unset TERM: colors %d utf8 %d addr %d\n", c.colors, c.utf8, c.cursorAddr);
    return 0;
}
