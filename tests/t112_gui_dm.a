// the display manager: users, passwords, the login screen and a session
import wsrv;
import gui;
import dm;
import syscrypt;
import cunistd;

int main() {
    dm.Config* cfg = new dm.Config();
    cfg->displayPort = 7212;
    cfg->usersFile = "build/tests/t112_users.txt";
    cfg->allowRoot = true;
    cfg->minUid = 0;
    cfg->session = "echo SESSION-FOR-$USER-$ADISPLAY > build/tests/t112_session.txt; sleep 0.3";
    int me = getuid();
    int mygid = getgid();
    char* a = dm.makeUserLine("tester", "hunter2", "saltsalt", me, mygid, ".", "");
    char* b = dm.makeUserLine("locked", "x", "abcdefgh", me, mygid, ".", "");
    char* c = dm.makeUserLine("lowuid", "pw", "abcdefgh", 5, 5, ".", "");
    char all[1000];
    format(&all[0], 1000, "# users\n%s\n%s\nbroken:!:1000:1000:/tmp:\n%s\n", a, b, c);
    writeFile("build/tests/t112_users.txt", &all[0]);

    // the user database
    printlnInt(dm.authenticate(cfg, "tester", "hunter2") != null);
    printlnInt(dm.authenticate(cfg, "tester", "hunter3") != null);
    printlnInt(dm.authenticate(cfg, "nobody", "hunter2") != null);
    printlnInt(dm.authenticate(cfg, "broken", "") != null);
    dm.User* u = dm.lookup(cfg, "tester");
    printlnInt(u->uid == me);
    println(u->home);
    cfg->minUid = 1000;
    printlnInt(dm.authenticate(cfg, "lowuid", "pw") != null);
    cfg->minUid = 0;
    printlnInt(dm.authenticate(cfg, "lowuid", "pw") != null);
    char* f = dm.field("a:b::d", 2, ':');
    printlnInt(strlen(f));
    println(dm.field("a:b::d", 3, ':'));

    // the configuration file
    writeFile("build/tests/t112_adm.conf", "# comment\nport = 3\nVNC=5\nlayout = fi\nusers = system\nminuid = 500\nallowroot = 1\ngreeting = Hello there\n");
    dm.Config* c2 = new dm.Config();
    printlnInt(dm.loadConfig(c2, "build/tests/t112_adm.conf"));
    printlnInt(c2->displayPort * 100 + c2->vncPort);
    println(c2->layout);
    println(c2->usersFile);
    printlnInt(c2->minUid);
    printlnInt(c2->allowRoot);
    println(c2->greeting);
    printlnInt(dm.loadConfig(c2, "build/tests/does-not-exist.conf"));

    // the login screen
    wsrv.Headless* hb = new wsrv.Headless(800, 600);
    wsrv.Server* srv = new wsrv.Server(hb, 7212);
    dm.Manager* m = new dm.Manager(srv, cfg);
    for (int i = 0; i < 10; i++) m->step(0);
    printlnInt(srv->windowCount());
    wsrv.Win* w = srv->windowAt(0);
    printlnInt(w->x > 0 && w->y > 0 && w->x + w->w < 800);
    hb->click(w->x + m->userBox->absX() + 10, w->y + m->userBox->absY() + 10);
    hb->typeText("tester");
    hb->tap(13, 13);
    hb->typeText("wrong");
    hb->tap(13, 13);
    for (int i = 0; i < 20; i++) m->step(0);
    printlnInt(m->sessionRunning());
    printlnInt(m->failures);
    println(m->status->text);
    sleepMs(1100);
    hb->click(w->x + m->passBox->absX() + 10, w->y + m->passBox->absY() + 10);
    hb->typeText("hunter2");
    hb->tap(13, 13);
    for (int i = 0; i < 20; i++) m->step(0);
    printlnInt(m->sessions);
    printlnInt(m->sessionRunning());
    for (int i = 0; i < 150 && m->sessionRunning(); i++) {
        m->step(20);
    }
    for (int i = 0; i < 20; i++) m->step(0);
    printlnInt(m->sessionRunning());
    printlnInt(srv->windowCount());
    srv->close();
    return 0;
}
