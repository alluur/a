// compound assignments on doubles, pointers, bools, enums and classes with overloaded operators (the integer types are in t307)
struct Vec {
    int x; int y;
    Vec operator+(Vec o) { Vec r; r.x = x + o.x; r.y = y + o.y; return r; }
    Vec operator-(Vec o) { Vec r; r.x = x - o.x; r.y = y - o.y; return r; }
    Vec operator*(int k) { Vec r; r.x = x * k; r.y = y * k; return r; }
    Vec operator/(int k) { Vec r; r.x = x / k; r.y = y / k; return r; }
    Vec operator%(int k) { Vec r; r.x = x % k; r.y = y % k; return r; }
    Vec operator&(int m) { Vec r; r.x = x & m; r.y = y & m; return r; }
    Vec operator|(int m) { Vec r; r.x = x | m; r.y = y | m; return r; }
    Vec operator^(int m) { Vec r; r.x = x ^ m; r.y = y ^ m; return r; }
    Vec operator<<(int n) { Vec r; r.x = x << n; r.y = y << n; return r; }
    Vec operator>>(int n) { Vec r; r.x = x >> n; r.y = y >> n; return r; }
}
struct Pt { int a; int b; }
enum Flag { None = 0, A = 1, B = 2, C = 4 }
int idx;
int next() { idx++; return idx - 1; }
void show(Vec v) { printInt(v.x); print(","); printInt(v.y); print(" "); }

int main() {
    // doubles
    double d = 0.0;
    d += 1.5; printDouble(d); print(" ");
    d -= 0.5; printDouble(d); print(" ");
    d *= 3; printDouble(d); print(" ");
    d /= 2; printDouble(d); print(" ");
    d += 2; printDouble(d); print(" ");
    double arr[3] = {1.0, 2.0, 3.0};
    idx = 0;
    arr[next()] += 0.25; arr[next()] *= 2.5; arr[next()] -= 1;
    printDouble(arr[0]); print(" "); printDouble(arr[1]); print(" "); printDouble(arr[2]); print(" ");
    printlnInt(idx);

    // pointers move in steps of the size of what they point to
    int ia[6] = {10, 20, 30, 40, 50, 60};
    int* ip = ia;
    ip += 2; printlnInt(*ip);
    ip -= 1; printlnInt(*ip);
    ip += 4; printlnInt(*ip);
    char text[8] = "abcdefg";
    char* cp = text;
    cp += 3; printChar(*cp); cp -= 2; printChar(*cp); println("");
    Pt pts[3];
    pts[0].a = 1; pts[1].a = 2; pts[2].a = 3;
    Pt* pp = pts;
    pp += 2; printlnInt(pp->a); pp -= 1; printlnInt(pp->a);
    int16 sa[4] = {5, 6, 7, 8};
    int16* sp = sa;
    sp += 3; printlnInt(*sp); sp -= 3; printlnInt(*sp);
    ip = ia;
    int** pip = &ip;
    *pip += 2; printlnInt(*ip);                              // through a pointer to a pointer
    *pip -= 1; printlnInt(*ip);

    // bool targets keep 0 or 1
    bool b = false;
    b |= 6; printlnInt(b);
    b &= 2; printlnInt(b);
    b ^= 1; printlnInt(b);
    b ^= 1; printlnInt(b);
    b += 5; printlnInt(b);
    b -= 5; printlnInt(b);

    // enums are integers
    Flag f = Flag.A;
    f |= Flag.C; printlnInt(f);
    f &= 5; printlnInt(f);
    f ^= Flag.A; printlnInt(f);
    f <<= 1; printlnInt(f);
    f >>= 2; printlnInt(f);

    // classes with operators: a op= b is a = a op b, the target is evaluated once
    Vec v; v.x = 6; v.y = 10;
    Vec w; w.x = 1; w.y = 2;
    v += w; show(v);
    v -= w; show(v);
    v *= 3; show(v);
    v /= 2; show(v);
    v %= 5; show(v);
    v |= 8; show(v);
    v &= 12; show(v);
    v ^= 5; show(v);
    v <<= 2; show(v);
    v >>= 1; show(v);
    println("");
    Vec vs[2];
    vs[0].x = 1; vs[1].x = 2;
    idx = 0;
    vs[next()] += w; vs[next()] *= 10;
    show(vs[0]); show(vs[1]); printlnInt(idx);
    Vec* vp = &vs[1];
    *vp -= w; show(*vp);
    vp->x += 0;
    show(vs[1]);
    println("");
    return 0;
}
