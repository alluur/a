int countWords(char* s) {
    int n = 0; bool inWord = false;
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == ' ') inWord = false;
        else if (!inWord) { inWord = true; n++; }
    }
    return n;
}
void reverse(char* s) {
    int n = strlen(s);
    for (int i = 0; i < n / 2; i++) { char t = s[i]; s[i] = s[n - 1 - i]; s[n - 1 - i] = t; }
}
int main() {
    printlnInt(countWords("the quick brown fox"));
    char buf[32];
    memcpy(buf, "stressed", 9);
    reverse(buf);
    println(buf);
    printBool(streq("abc", "abc")); println("");
    printBool(streq("abc", "abd")); println("");
    printlnInt(strcmp("a", "b") < 0);
    printlnInt(atoi("-1234") + atoi("34"));
    println("tab\there \"quoted\" \\ backslash \x41\x42");
    char c = 'a';
    c = c - 32;
    printChar(c); println("");
    printlnInt('A' + 1);
    return 0;
}
