// Regression tests for the independent review of stage algo2 (matrix, stats). Every block below belongs to one finding of the review and failed before the fix:
//   1. matrix.lstsq, QR.solveLS and stats.olsFit returned "OK" with a solution of size 1e13 and more for matrices that are rank deficient only up to rounding (a
//      product u v^T computed in doubles): the diagonal of an unpivoted QR does not show the deficiency, the condition of the whole triangle does (QR.rcond()).
//   2. stats.tQuantile: Cauchy (df = 1) lost digits in the tails (tan of pi p), and for every df the quantile of a tail below about 1e-170 stopped after 400
//      Newton steps far from the answer; tSf / tCdf gave NaN for |t| above 1e154.
//   3. erfc (and with it the normal cdf) near 0: 1 - x instead of 1 - 2 x / sqrt(pi) below 2^-27.
//   4. stats.RollingStats: wrong mean and variance after a huge outlier had left the window (and large cost of every query).
//   5. Matrix.det() of an exactly singular matrix was -0.0.
// The expected values of the tables come from 70 digit decimal arithmetic (tests/algo2_ref/mk_t470.py); the other checks are planted solutions and exact identities.
// Self describing: a check that fails prints  FAIL label ...  and the program exits with 1; the .out file holds the summary lines only.
import cstdio;
import asys;
import matrix;
import stats;
import dmath;

int fails = 0;
int checks = 0;
int seed = 20240611;

double rnd() {                                               // [-1, 1)
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return (double) (seed >> 8) / 8388608.0 * 2.0 - 1.0;
}

double rnd01() { return 0.5 * rnd() + 0.5; }

void fail(char* label, char* what) {
    fails++;
    printf("FAIL %s: %s\n", label, what);
}

void expectInt(char* label, int got, int want) {
    checks++;
    if (got == want) { return; }
    fails++;
    printf("FAIL %s: got %d, want %d\n", label, got, want);
}

void expectTrue(char* label, bool cond) {
    checks++;
    if (cond) { return; }
    fail(label, "condition is false");
}

// |got - want| <= tol * |want| (a NaN never passes)
void expectRel(char* label, double got, double want, double tol) {
    checks++;
    double e = dmath.fabs(got - want);
    if (e <= tol * dmath.fabs(want)) { return; }
    fails++;
    printfd("FAIL %s: got %.17g, ", __bits(label), __bits(got));
    printfd("want %.17g\n", __bits(want));
}

double* newArr(int n) { return (double*) asys.alloc(n * 8); }

// ---- 1. rank deficient least squares -----------------------------------------------------------------------------------------------------------------
void lstsqRepro() {
    double u[3] = {1.3, 1.7, 0.1};
    double v[2] = {0.3, 1.9};
    matrix.Matrix a(3, 2);
    for (int i = 0; i < 3; i++) { for (int j = 0; j < 2; j++) { a.d[i * 2 + j] = u[i] * v[j]; } }
    double b[3] = {1.0, 1.0, 2.0};
    double x[2];
    int rank = -1;
    double resid = -1.0;
    int st = matrix.lstsq(&a, b, x, &resid, &rank);
    expectInt("repro status", st, matrix.OK);
    expectInt("repro rank", rank, 1);
    expectTrue("repro minimum norm", matrix.vecNorm2(x, 2) < 1.0);
    // the minimum norm solution is the pseudo inverse applied to b
    matrix.SVD s(&a);
    double x2[2];
    expectInt("repro svd rank", s.rank(), 1);
    expectInt("repro svd solve", s.solve(b, x2), matrix.OK);
    expectTrue("repro equals svd solution", dmath.fabs(x[0] - x2[0]) < 1.0e-9 && dmath.fabs(x[1] - x2[1]) < 1.0e-9);
    s.dispose();
    // the QR object itself refuses, and says why
    matrix.QR f(&a);
    expectTrue("repro QR rcond tiny", f.rcond() < 1.0e-15);
    expectInt("repro QR refuses", f.solveLS(b, x, null), matrix.ERR_RANK);
    f.dispose();
    expectTrue("disposed QR rcond is NaN", f.rcond() != f.rcond());
    a.dispose();
    printf("lstsq of u v^T: rank 1, minimum norm solution, QR refuses with ERR_RANK\n");
}

// A = U V (m x r times r x n, computed in doubles) has rank r < n on paper and only up to rounding in the doubles
int shapes[20] = {3, 2, 1, 10,  6, 3, 2, 10,  12, 4, 3, 8,  20, 5, 4, 8,  40, 6, 5, 6};

void genericRankDeficient() {
    int cases = 0;
    int bad = 0;
    int badQr = 0;
    int badRank = 0;
    int badNormal = 0;
    for (int s = 0; s < 5; s++) {
        int m = shapes[s * 4];
        int n = shapes[s * 4 + 1];
        int r = shapes[s * 4 + 2];
        int reps = shapes[s * 4 + 3];
        for (int rep = 0; rep < reps; rep++) {
            matrix.Matrix u(m, r);
            matrix.Matrix v(r, n);
            for (int i = 0; i < m * r; i++) { u.d[i] = rnd(); }
            for (int i = 0; i < r * n; i++) { v.d[i] = rnd(); }
            matrix.Matrix a = u.mul(&v);
            double* b = newArr(m);
            double* x = newArr(n);
            for (int i = 0; i < m; i++) { b[i] = rnd(); }
            int rank = -1;
            double resid = 0.0;
            int st = matrix.lstsq(&a, b, x, &resid, &rank);
            cases++;
            if (st != matrix.OK || rank >= n || matrix.vecNorm2(x, n) > 1.0e6) { bad++; }
            if (rank != r) { badRank++; }
            // normal equations: A^T (A x - b) = 0 for a least squares solution
            double* t = newArr(m);
            double* g = newArr(n);
            a.mulVec(x, t);
            for (int i = 0; i < m; i++) { t[i] -= b[i]; }
            a.mulVecT(t, g);
            if (matrix.vecNorm2(g, n) > 1.0e-9) { badNormal++; }
            matrix.QR f(&a);
            if (f.solveLS(b, x, &resid) == matrix.OK) { badQr++; }
            f.dispose();
            asys.free((char*) t);
            asys.free((char*) g);
            asys.free((char*) b);
            asys.free((char*) x);
            a.dispose();
            u.dispose();
            v.dispose();
        }
    }
    expectInt("generic rank deficient: silent garbage", bad, 0);
    expectInt("generic rank deficient: wrong rank", badRank, 0);
    expectInt("generic rank deficient: normal equations", badNormal, 0);
    expectInt("generic rank deficient: QR accepted", badQr, 0);
    printf("lstsq of %d generic rank deficient matrices: no garbage, rank found, normal equations hold, QR refuses\n", cases);
}

int olsShapes[16] = {10, 3, 2, 8,  20, 5, 4, 8,  50, 6, 5, 6,  100, 6, 5, 4};

void olsRankDeficient() {
    int cases = 0;
    int bad = 0;
    for (int s = 0; s < 4; s++) {
        int m = olsShapes[s * 4];
        int n = olsShapes[s * 4 + 1];
        int r = olsShapes[s * 4 + 2];
        int reps = olsShapes[s * 4 + 3];
        for (int rep = 0; rep < reps; rep++) {
            matrix.Matrix u(m, r);
            matrix.Matrix v(r, n);
            for (int i = 0; i < m * r; i++) { u.d[i] = rnd(); }
            for (int i = 0; i < r * n; i++) { v.d[i] = rnd(); }
            matrix.Matrix a = u.mul(&v);
            double* y = newArr(m);
            for (int i = 0; i < m; i++) { y[i] = rnd(); }
            for (int ic = 0; ic < 2; ic++) {
                stats.Regression rg = stats.olsFit(&a, y, ic == 1);
                cases++;
                if (rg.err != matrix.ERR_RANK) { bad++; }
                rg.dispose();
            }
            asys.free((char*) y);
            a.dispose();
            u.dispose();
            v.dispose();
        }
    }
    expectInt("olsFit rank deficient X", bad, 0);
    printf("olsFit of %d exactly rank deficient designs: ERR_RANK every time\n", cases);
}

// well posed problems must still go the QR way (and be accurate)
void fullRankStillWorks() {
    // Hilbert 8 x 8: cond about 1.5e10, rcond between 1e-12 and 1e-8, solvable
    int n = 8;
    matrix.Matrix h(n, n);
    for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { h.d[i * n + j] = 1.0 / (double) (i + j + 1); } }
    double ones[8];
    double b[8];
    double x[8];
    for (int i = 0; i < n; i++) { ones[i] = 1.0; }
    h.mulVec(ones, b);
    matrix.QR f(&h);
    double rc = f.rcond();
    expectTrue("hilbert 8 rcond", rc > 1.0e-12 && rc < 1.0e-8);
    expectInt("hilbert 8 solve", f.solveLS(b, x, null), matrix.OK);
    double worst = 0.0;
    for (int i = 0; i < n; i++) { if (dmath.fabs(x[i] - 1.0) > worst) { worst = dmath.fabs(x[i] - 1.0); } }
    expectTrue("hilbert 8 accuracy", worst < 1.0e-3);
    f.dispose();
    h.dispose();
    // the identity is perfectly conditioned
    matrix.Matrix id = matrix.identity(5);
    matrix.QR fi(&id);
    expectTrue("identity rcond", fi.rcond() > 0.2 && fi.rcond() <= 1.0);
    fi.dispose();
    id.dispose();
    // rcond does not depend on the units of the columns
    matrix.Matrix a(20, 4);
    for (int i = 0; i < 80; i++) { a.d[i] = rnd(); }
    matrix.Matrix a2 = a.copy();
    for (int i = 0; i < 20; i++) {
        a2.d[i * 4 + 1] *= 1.0e8;
        a2.d[i * 4 + 2] *= 1.0e-8;
        a2.d[i * 4 + 3] *= 1.0e12;
    }
    matrix.QR fa(&a);
    matrix.QR fa2(&a2);
    expectRel("rcond column scaling", fa2.rcond(), fa.rcond(), 1.0e-6);
    expectTrue("random 20 x 4 rcond", fa.rcond() > 0.01);
    fa.dispose();
    fa2.dispose();
    a2.dispose();
    a.dispose();
    // planted solution through lstsq (random full rank matrices of several shapes), QR path: rank = n
    int shp[8] = {30, 4, 12, 3, 8, 8, 100, 5};
    int badPlanted = 0;
    for (int s = 0; s < 4; s++) {
        int m = shp[s * 2];
        int nn = shp[s * 2 + 1];
        matrix.Matrix g(m, nn);
        for (int i = 0; i < m * nn; i++) { g.d[i] = rnd(); }
        double* xt = newArr(nn);
        double* y = newArr(m);
        double* xs = newArr(nn);
        for (int i = 0; i < nn; i++) { xt[i] = rnd() * 10.0; }
        g.mulVec(xt, y);
        int rank = -1;
        double resid = 1.0;
        int st = matrix.lstsq(&g, y, xs, &resid, &rank);
        if (st != matrix.OK || rank != nn || resid > 1.0e-12) { badPlanted++; }
        for (int i = 0; i < nn; i++) { if (dmath.fabs(xs[i] - xt[i]) > 1.0e-8) { badPlanted++; } }
        asys.free((char*) xt);
        asys.free((char*) y);
        asys.free((char*) xs);
        g.dispose();
    }
    expectInt("planted lstsq", badPlanted, 0);
    // a regression with a planted exact relation y = 2 + 3 x1 - 1.5 x2
    matrix.Matrix xm(40, 2);
    double* y = newArr(40);
    for (int i = 0; i < 40; i++) {
        xm.d[i * 2] = rnd() * 5.0;
        xm.d[i * 2 + 1] = rnd() * 3.0 + 1.0;
        y[i] = 2.0 + 3.0 * xm.d[i * 2] - 1.5 * xm.d[i * 2 + 1];
    }
    stats.Regression rg = stats.olsFit(&xm, y, true);
    expectInt("planted olsFit status", rg.err, 0);
    expectTrue("planted olsFit coefficients", dmath.fabs(rg.coef[0] - 2.0) < 1.0e-12 && dmath.fabs(rg.coef[1] - 3.0) < 1.0e-12 && dmath.fabs(rg.coef[2] + 1.5) < 1.0e-12);
    rg.dispose();
    asys.free((char*) y);
    xm.dispose();
    printf("full rank problems still use QR: rcond estimates, scale invariance, planted solutions\n");
}

// ---- 5. the determinant of a singular matrix is +0 -----------------------------------------------------------------------------------------------------
void detOfSingular() {
    matrix.Matrix s(2, 2);
    s.d[0] = 1.0;
    s.d[1] = 2.0;
    s.d[2] = 2.0;
    s.d[3] = 4.0;
    expectInt("det of [1 2; 2 4] is +0", __bits(s.det()) == 0 ? 1 : 0, 1);
    matrix.LU f(&s, 0.0);
    expectInt("LU.det of [1 2; 2 4] is +0", __bits(f.det()) == 0 ? 1 : 0, 1);
    f.dispose();
    // a zero column with row swaps: the sign of the swaps must not leave a -0
    matrix.Matrix z(3, 3);                                   // 1 2 3 / 2 4 6 / 1 0 1: rank 2, the elimination swaps rows and ends in an exactly zero pivot
    double zv[9] = {1.0, 2.0, 3.0, 2.0, 4.0, 6.0, 1.0, 0.0, 1.0};
    for (int i = 0; i < 9; i++) { z.d[i] = zv[i]; }
    expectInt("det of a singular 3 x 3 is +0", __bits(z.det()) == 0 ? 1 : 0, 1);
    // nonsingular determinants keep their sign
    matrix.Matrix p(2, 2);
    p.d[1] = 1.0;
    p.d[2] = 1.0;
    expectRel("det of a permutation", p.det(), -1.0, 1.0e-15);
    matrix.CMatrix c(2, 2);
    c.re[0] = 1.0;
    c.re[1] = 2.0;
    c.re[2] = 2.0;
    c.re[3] = 4.0;
    double dr = 1.0;
    double di = 1.0;
    expectInt("complex det status", c.det(&dr, &di), matrix.OK);
    expectInt("complex det re is +0", __bits(dr) == 0 ? 1 : 0, 1);
    expectInt("complex det im is +0", __bits(di) == 0 ? 1 : 0, 1);
    c.dispose();
    p.dispose();
    z.dispose();
    s.dispose();
    printf("determinants of singular matrices are +0\n");
}

// ---- 3. erfc and the normal cdf near 0 -------------------------------------------------------------------------------------------------------------------
// BEGIN TABLE T_ERFC
double T_ERFC[26] = {
    1.0000000000000001e-15, 0.99999999999999889,
    9.9999999999999998e-13, 0.99999999999887157,
    1e-10, 0.99999999988716204,
    1.0000000000000001e-09, 0.99999999887162083,
    5.0000000000000001e-09, 0.99999999435810416,
    7.4000000000000001e-09, 0.9999999916499942,
    7.4999999999999993e-09, 0.99999999153715624,
    1e-08, 0.99999998871620832,
    2.9999999999999997e-08, 0.99999996614862496,
    -1.0000000000000001e-09, 1.0000000011283792,
    -1e-10, 1.000000000112838,
    -2e-08, 1.0000000225675834,
    1.0000000000000001e-05, 0.99998871620832941,
};
// END TABLE T_ERFC
// BEGIN TABLE T_NCDF
double T_NCDF[18] = {
    9.9999999999999998e-13, 0.5000000000003989,
    1e-10, 0.5000000000398942,
    1.0000000000000001e-09, 0.50000000039894232,
    1e-08, 0.50000000398942279,
    2e-08, 0.50000000797884558,
    -1.0000000000000001e-09, 0.49999999960105773,
    -3e-09, 0.49999999880317314,
    5.0000000000000001e-09, 0.5000000019947114,
    -1e-08, 0.49999999601057721,
};
// END TABLE T_NCDF

void erfcNearZero() {
    int rows = sizeof(T_ERFC) / 16;
    for (int i = 0; i < rows; i++) {
        double x = T_ERFC[i * 2];
        expectRel("erfc tiny", stats.erfc(x), T_ERFC[i * 2 + 1], 3.0e-16);
        expectRel("C library erfc tiny", __dbl(::erfc(__bits(x))), T_ERFC[i * 2 + 1], 3.0e-16);
    }
    int rows2 = sizeof(T_NCDF) / 16;
    for (int i = 0; i < rows2; i++) {
        double z = T_NCDF[i * 2];
        expectRel("normal cdf tiny", stats.stdNormalCdf(z), T_NCDF[i * 2 + 1], 3.0e-16);
        expectRel("normal cdf tiny (mu, sigma)", stats.normalCdf(3.0 + 2.0 * z, 3.0, 2.0), T_NCDF[i * 2 + 1], 3.0e-16);
        expectRel("normal sf tiny", stats.stdNormalSf(-z), T_NCDF[i * 2 + 1], 3.0e-16);
    }
    expectRel("erfc(0)", stats.erfc(0.0), 1.0, 0.0);
    expectRel("erfc(1e-300)", stats.erfc(1.0e-300), 1.0, 0.0);
    expectRel("erfc(-1e-300)", stats.erfc(-1.0e-300), 1.0, 0.0);
    expectRel("erfc(0.5) unchanged", stats.erfc(0.5), 0.4795001221869535, 2.0e-16);
    expectTrue("erfc(NaN)", stats.erfc(dmath.nan()) != stats.erfc(dmath.nan()));
    printf("erfc and the normal cdf for |x| below 1e-7: %d + %d reference values to 3e-16\n", rows, rows2);
}

