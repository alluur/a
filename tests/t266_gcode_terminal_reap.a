// gcode.TerminalPane stop and exit leave no zombie children: the program is collected (waitpid has nothing left to say), also one that
// ignores SIGHUP (it gets SIGKILL after a short wait); starting and stopping many times does not collect anything (Linux and Android only)
import wsrv;
import gui;
import guix;
import gcode;
import gterm;
import asys;
import adp;
import gfx;
import cunistd;
#include "gcode_harness.inc"

int exited = 0;
int onExit(int p) { exited++; return 0; }

// true when the child is gone and was collected: waitpid reports "no such child" (-1); a zombie would be reported (its pid) or, when
// the program still ran, 0
bool collected(int pid) {
    int st = 0;
    int r = waitpid(pid, &st, 1);
    return r == -1;
}

int main() {
    startServer(7366, "t266");
    gui.Window* w = d->createWindow("Terminal", 600, 300, 0);
    gcode.TerminalPane* pane = new gcode.TerminalPane();
    pane->onExit = onExit;
    gui.Box* col = gui.vbox(0, 0);
    col->add(pane);
    w->setRoot(col);
    settle();
    bool ok = pane->start(d, "sleep 30");
    printf("a pseudo terminal can be started: %d\n", ok);
    if (!ok) { return 0; }
    settle();
    int pid = pane->term->pid;
    printf("running: %d\n", pane->running());
    pane->stop();
    printf("stop: running %d, the program is collected: %d\n", pane->running(), collected(pid));

    // a program that ends by itself
    exited = 0;
    ok = pane->start(d, "exit 3");
    pid = pane->term->pid;
    for (int i = 0; i < 400 && exited == 0; i++) { d->pump(25); }
    settle();
    printf("ended by itself: exited %d, status %d, collected %d\n", exited, pane->term->exitStatus, collected(pid));

    // a program that ignores the hang-up signal is killed
    exited = 0;
    ok = pane->start(d, "trap '' HUP; while :; do sleep 1; done");
    pid = pane->term->pid;
    for (int i = 0; i < 20; i++) { d->pump(25); }
    pane->stop();
    printf("a program that ignores SIGHUP: running %d, collected %d\n", pane->running(), collected(pid));

    // stopping twice is fine, and so is stopping what never ran
    pane->stop();
    pane->stop();
    gcode.TerminalPane* idle = new gcode.TerminalPane();
    idle->stop();
    printf("stopping twice and stopping an idle pane: fine\n");

    // many sessions
    int zombies = 0;
    for (int i = 0; i < 8; i++) {
        ok = pane->start(d, "sleep 30");
        pid = pane->term->pid;
        settle();
        pane->stop();
        if (!collected(pid)) { zombies++; }
    }
    printf("8 start / stop rounds: %d left behind\n", zombies);
    w->close();
    return 0;
}
