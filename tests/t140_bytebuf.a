// bytebuf: endian helpers, Buf, Reader, varints, sizes, hex
import cstdio;
import cstring;
import bytebuf;

int main() {
    char p[16];
    bytebuf.putU32be(p, 0xCAFEBABE);
    printf("be bytes: %d %d %d %d\n", p[0] & 255, p[1] & 255, p[2] & 255, p[3] & 255);
    printf("read back: %d %d %d %d\n", bytebuf.getU32be(p), bytebuf.getU32le(p), bytebuf.getU16be(p), bytebuf.getU16le(p));
    printf("signed: %d %d %d\n", bytebuf.getI8(p), bytebuf.getI16be(p), bytebuf.getI32be(p));
    bytebuf.putU64le(p, 0x0102030405060708);
    printf("u64: %d %d %d\n", p[0] & 255, p[7] & 255, bytebuf.getU64le(p) == 0x0102030405060708);
    bytebuf.putU64be(p, 0xFFEEDDCCBBAA9988);
    printf("u64be: %d %d\n", p[0] & 255, bytebuf.getU64be(p) > 0x7FFFFFFFFFFFFFFF);

    bytebuf.Buf* b = new bytebuf.Buf();
    b->u8(1);
    b->u16be(0x1234);
    b->u32le(7);
    int at = b->size();
    b->u32be(0);
    b->cstr("name");
    b->text("raw");
    b->varint(300);
    b->svarint(-3);
    b->svarint(1000);
    b->u64be(0x1122334455667788);
    b->align(8);
    b->patch32be(at, b->size());
    printf("size %d, hex %s\n", b->size(), bytebuf.hex(b->data, b->size()));

    bytebuf.Reader* r = new bytebuf.Reader(b->data, b->size());
    printf("read: %d %d %d %d\n", r->u8(), r->u16be(), r->u32le(), r->u32be());
    char* s = r->cstr();
    printf("cstr %s, take %d bytes: %s\n", s, 3, "xyz");
    char* t = r->take(3);
    printf("text %c%c%c\n", t[0], t[1], t[2]);
    printf("varint %d, svarint %d, svarint %d\n", r->varint(), r->svarint(), r->svarint());
    printf("u64 ok %d, remaining %d, bad %d\n", r->u64be() == 0x1122334455667788, r->remaining(), r->bad);
    r->u32le();
    r->u32le();
    printf("overrun: bad %d, eof %d\n", r->bad, r->eof());
    printf("short read: %d\n", r->u16be());

    printf("%s | %s | %s | %s\n", bytebuf.humanSize(0), bytebuf.humanSize(1023), bytebuf.humanSize(1536), bytebuf.humanSize(5 * 1024 * 1024 * 1024));
    printf("%s | %s | %s\n", bytebuf.humanSizeSI(999), bytebuf.humanSizeSI(1500), bytebuf.humanSizeSI(2500000));
    printf("parse: %d %d %d %d %d %d %d\n", bytebuf.parseSize("512"), bytebuf.parseSize("10K"), bytebuf.parseSize("10KB"), bytebuf.parseSize("1.5MiB"), bytebuf.parseSize("2 GB"), bytebuf.parseSize("3b"), bytebuf.parseSize("x"));
    printf("parse bad: %d %d\n", bytebuf.parseSize("10Q"), bytebuf.parseSize("10KBB"));

    int n;
    char* raw = bytebuf.fromHex("48 65 6c 6c 6f 21", &n);
    printf("fromHex: %d %s, odd: %d, bad: %d\n", n, raw, bytebuf.fromHex("abc", &n) == null, bytebuf.fromHex("zz", &n) == null);
    printf("%s", bytebuf.hexdump("Hello, hexdump! 0123456789\n\x01\xFF", 28));
    return 0;
}
