// gcode.FindBar follows the document that the editor shows (a tab switch or a closed tab): the count, Enter / Shift+Enter, Replace and
// Replace All work on the new document at once, without typing the pattern again; the old document can be disposed afterwards; the
// "in selection" range and the highlights do not leak from one document to the next
import wsrv;
import gui;
import guix;
import gcode;
import afind;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gcode.FindBar* fb;
gui.Window* w;

void state(char* label) {
    printf("%s: matches %d, index %d", label, fb->matchCount, fb->matchIndex);
    if (e->ed->anySelection()) {
        char* t = e->getSelectedText();
        printf(", selected %d-%d [%s]", e->ed->selStart(0), e->ed->selEnd(0), t);
        asys.free(t);
    } else {
        printf(", no selection");
    }
    printf("\n");
}

void text(char* label) {
    char* t = e->getText();
    printf("%s: [", label);
    for (int i = 0; t[i] != 0; i++) { printf("%c", (t[i] == 10) ? '|' : t[i]); }
    printf("]\n");
    asys.free(t);
}

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;
    startServer(7360, "t260");
    w = d->createWindow("Find tabs", 640, 400, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    fb = new gcode.FindBar(e);
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    col->add(fb);
    w->setRoot(col);
    w->setFocus(e);
    gcode.Doc* a = e->doc;
    a->setText("foo foo foo\nbar foo\n");
    gcode.Doc* b = new gcode.Doc();
    b->setText("xx foo yy\nfoo\n");
    gcode.Doc* c = new gcode.Doc();
    c->setText("nothing here\n");
    settle();

    // 1. the pattern is typed in document A, then the tab changes: the count belongs to the new text without any call to the bar
    fb->open(false);
    typeStr("foo");
    state("A");
    e->setDoc(b);
    settle();
    state("B shown");
    printf("highlight kept: %d\n", e->hasFindHighlight());
    e->setDoc(c);
    settle();
    state("C shown (no match)");
    e->setDoc(a);
    settle();
    state("A shown again");

    // 2. Enter / Shift+Enter / Down / Up in the find box walk through the matches of the document that is shown
    e->setDoc(b);
    settle();
    w->setFocus(fb->findBox);
    settle();
    key(adp.KEY_ENTER, 13);
    state("Enter in B");
    key(adp.KEY_ENTER, 13);
    state("Enter in B");
    key(adp.KEY_ENTER, 13);
    state("Enter in B (wraps)");
    keyMods(adp.KEY_ENTER, 13, adp.MOD_SHIFT);
    state("Shift+Enter in B");
    key(adp.KEY_DOWN, 0);
    state("Down in B");
    key(adp.KEY_UP, 0);
    state("Up in B");
    e->setDoc(c);
    settle();
    key(adp.KEY_ENTER, 13);
    state("Enter in C (nothing to find)");

    // 3. the document is closed: the editor shows another one first, then the old one is disposed; editing goes on
    int docs = gcode.docCount();
    e->setDoc(b);
    settle();
    a->dispose();
    settle();
    printf("documents %d -> %d\n", docs, gcode.docCount());
    e->setText("foo foo\nfoo foo foo foo\n");
    settle();
    state("after dispose(A) and an edit of B");
    printf("find next: %d\n", fb->findNext());
    state("after find next");

    // 4. Replace and Replace All after a switch (the replacement text stays)
    fb->showReplace(true);
    fb->setReplacement("BAR");
    gcode.Doc* d2 = new gcode.Doc();
    d2->setText("foo xx foo\nfoo\n");
    e->setDoc(d2);
    settle();
    text("D shown");
    printf("replace current: %d\n", fb->replaceCurrent());
    text("after replace (selected the first match)");
    printf("replace current: %d\n", fb->replaceCurrent());
    text("after replace (replaced it)");
    e->setDoc(b);
    settle();
    printf("replace all in B: %d\n", fb->replaceAll());
    text("B");
    state("B after replace all");
    e->ed->undo();
    text("one undo");
    e->setDoc(d2);
    settle();
    printf("replace all in D: %d\n", fb->replaceAll());
    text("D");

    // 5. "in selection" is forgotten on a switch: the new document is searched everywhere
    e->setText("foo 1\nfoo 2\nfoo 3\n");
    e->select(6, 11);
    fb->setInSelection(true);
    state("in selection");
    gcode.Doc* f2 = new gcode.Doc();
    f2->setText("foo a foo b foo c\n");
    e->setDoc(f2);
    settle();
    state("another document");
    fb->setInSelection(false);

    // 6. the bar is closed: a switch does not bring the highlights back; opening it again finds in the document that is shown
    fb->close();
    printf("closed: highlight %d\n", e->hasFindHighlight());
    e->setDoc(b);
    settle();
    printf("switched while closed: highlight %d\n", e->hasFindHighlight());
    b->setText("x foo y foo\n");
    e->setDoc(f2);
    settle();
    fb->open(false);
    settle();
    state("opened again in F");
    printf("highlight %d\n", e->hasFindHighlight());
    e->setDoc(b);
    settle();
    state("B shown");

    // 7. a second editor: the bar moves to it and the old editor loses the highlights
    gcode.CodeEditor* e2 = new gcode.CodeEditor();
    e2->blink = false;
    e2->setText("foo\nfoo\n");
    gui.Window* w2 = d->createWindow("Second", 300, 200, 0);
    gui.Box* c2 = gui.vbox(0, 0);
    c2->add(e2);
    w2->setRoot(c2);
    settle();
    fb->setTarget(e2);
    settle();
    printf("old editor highlight %d, new editor highlight %d, matches %d\n", e->hasFindHighlight(), e2->hasFindHighlight(), fb->matchCount);
    e->setDoc(c);
    settle();
    printf("the old editor changed its document: matches %d\n", fb->matchCount);

    // 8. many switches do not accumulate anything (documents and finders)
    int before = gcode.docCount();
    fb->setTarget(e);
    for (int i = 0; i < 100; i++) {
        e->setDoc((i % 2 == 0) ? b : f2);
    }
    settle();
    printf("after 100 switches: documents %d -> %d, matches %d\n", before, gcode.docCount(), fb->matchCount);
    w2->close();
    w->close();
    return 0;
}
