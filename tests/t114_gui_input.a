// input handling: Linux key codes and layouts, pixel formats, X11 keysyms, protocol helpers
import wsrv;
import wfb;
import wvnc;
import gfx;
import adp;

void show(wsrv.Backend* b) {
    wsrv.InputEvent ev;
    while (b->nextEvent(&ev) != 0) {
        printf("k%d x%d y%d b%d key%d uni%d\n", ev.kind, ev.x, ev.y, ev.button, ev.key, ev.uni);
    }
}

void showBytes(char* m, int n) {
    for (int i = 0; i < n; i++) {
        printInt(m[i]);
        print(" ");
    }
    println("");
}

int main() {
    // evdev events -> display events (no device needed: the port number of the framebuffer does not exist)
    wfb.Framebuffer* fb = new wfb.Framebuffer("/nonexistent", "fi");
    printlnInt(fb->ok());
    fb->w = 800;
    fb->h = 600;
    fb->handleEvent(2, 0, 10);
    fb->handleEvent(2, 1, -5);
    fb->handleEvent(2, 0, 5000);
    fb->handleEvent(2, 8, 1);
    fb->handleEvent(1, 0x110, 1);
    fb->handleEvent(1, 0x110, 0);
    fb->handleEvent(1, 0x111, 1);
    fb->handleEvent(1, 30, 1);
    fb->handleEvent(1, 42, 1);
    fb->handleEvent(1, 40, 1);
    fb->handleEvent(1, 42, 0);
    fb->handleEvent(1, 100, 1);
    fb->handleEvent(1, 3, 1);
    fb->handleEvent(1, 100, 0);
    fb->handleEvent(1, 105, 1);
    fb->handleEvent(1, 105, 0);
    show(fb);
    int uni = 0;
    wfb.useLayout("us");
    printlnInt(wfb.keyFor(16, false, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(16, true, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(3, true, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(53, false, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(57, false, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(1, false, false, &uni));
    printlnInt(wfb.keyFor(59, false, false, &uni));
    printlnInt(wfb.keyFor(88, false, false, &uni));
    printlnInt(wfb.keyFor(125, false, false, &uni));
    printlnInt(wfb.keyFor(200, false, false, &uni));
    wfb.useLayout("fi");
    printlnInt(wfb.keyFor(26, false, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(39, true, false, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(8, false, true, &uni)); printlnInt(uni);
    printlnInt(wfb.keyFor(53, true, false, &uni)); printlnInt(uni);

    // framebuffer pixel formats
    gfx.Surface* s = new gfx.Surface(4, 2);
    s->put(0, 0, gfx.rgb(255, 0, 0));
    s->put(1, 0, gfx.rgb(0, 255, 0));
    s->put(2, 0, gfx.rgb(0, 0, 255));
    s->put(3, 0, gfx.rgb(255, 255, 255));
    char mem[64];
    memset(&mem[0], 0, 64);
    wfb.writeRect(s, 0, 0, 4, 1, &mem[0], 32, 32, 16, 8, 8, 8, 0, 8);
    showBytes(&mem[0], 16);
    memset(&mem[0], 0, 64);
    wfb.writeRect(s, 0, 0, 4, 1, &mem[0], 32, 32, 0, 8, 8, 8, 16, 8);
    showBytes(&mem[0], 16);
    memset(&mem[0], 0, 64);
    wfb.writeRect(s, 0, 0, 4, 1, &mem[0], 16, 16, 11, 5, 5, 6, 0, 5);
    showBytes(&mem[0], 8);
    memset(&mem[0], 0, 64);
    wfb.writeRect(s, 2, 1, 5, 5, &mem[0], 16, 16, 11, 5, 5, 6, 0, 5);     // clipped to nothing visible but must not crash
    showBytes(&mem[0], 4);

    // X11 keysyms
    int syms[14] = {97, 65, 0xE4, 0x20AC + 0x01000000, 0xFF0D, 0xFF08, 0xFF51, 0xFFBE, 0xFFC9, 0xFFE1, 0xFFE3, 0xFFB5, 0xFF09, 0x12345};
    for (int i = 0; i < 14; i++) {
        int key = wvnc.keyOfKeysym(syms[i], &uni);
        printlnInt(key * 100000 + uni);
    }

    // protocol helpers
    printlnInt(adp.portOf(null));
    printlnInt(adp.portOf("3"));
    printlnInt(adp.portOf(":12"));
    printlnInt(adp.portOf("host:7010"));
    printlnInt(adp.portOf("1.2.3.4:9"));
    println(adp.hostOf("example.org:70"));
    println(adp.hostOf(":4"));
    println(adp.hostOf("7"));
    char b[8];
    adp.put32(&b[0], 0, -2);
    printlnInt(adp.get32(&b[0], 0));
    adp.put32(&b[0], 4, 0x12345678);
    printlnInt(adp.get32(&b[0], 4));
    adp.Bytes* m = new adp.Bytes();
    m->begin(adp.Q_PING);
    m->add32(77);
    m->finish();
    printlnInt(adp.messageSize(m));
    adp.Bytes* part = new adp.Bytes();
    part->addBytes(m->data, 10);
    printlnInt(adp.messageSize(part));
    part->addBytes(&m->data[10], 2);
    printlnInt(adp.messageSize(part));
    part->consume(12);
    printlnInt(part->len);
    return 0;
}
