// matrix: Cholesky, QR (Householder) and least squares. Expected output: tests/algo2_ref/gen_t442.py (exact fractions and 60 digit decimals).
import cstdio;
import asys;
import matrix;
import dmath;

int seed = 777;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

double clean(double v) { return (v < 1.0e-11 && v > -1.0e-11) ? 0.0 : v; }

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.9g", __bits(clean(v[i]))); }
    printf("\n");
}

void dumpM(char* name, matrix.Matrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" %.9g", __bits(clean(m->d[i]))); }
    printf("\n");
}

void pv(char* name, double v) {
    printf("%s", name);
    printfd(" %.9g\n", __bits(v));
}

void fillRandom(matrix.Matrix* m) {
    for (int i = 0; i < m->rows * m->cols; i++) { m->d[i] = (double) (lcg() % 19 - 9); }
}

double maxAbsDiff(double* a, double* b, int n) {
    double m = 0.0;
    for (int i = 0; i < n; i++) {
        double d = dmath.fabs(a[i] - b[i]);
        if (d > m) { m = d; }
    }
    return m;
}

double absOf(double v) { return v < 0.0 ? -v : v; }

int main() {
    int base = asys.memInUse();
    // ---- Cholesky: S = M M^T + I of a random integer matrix
    {
        int n = 5;
        matrix.Matrix m(n, n);
        fillRandom(&m);
        matrix.Matrix mt = m.transpose();
        matrix.Matrix s = m * &mt;
        for (int i = 0; i < n; i++) { s.d[i * n + i] += 1.0; }
        double b[5];
        for (int i = 0; i < n; i++) { b[i] = (double) (lcg() % 19 - 9); }
        matrix.Cholesky c(&s);
        printf("cholesky status %d\n", c.err);
        dumpM("L", &c.l);
        double x[5];
        printf("solve %d\n", c.solve(b, x));
        dumpV("x", x, n);
        pv("det", c.det());
        pv("logDet", c.logDet());
        matrix.Matrix inv = c.inverse();
        dumpM("inverse", &inv);
        matrix.Matrix lt = c.l.transpose();
        matrix.Matrix llt = c.l * &lt;
        printf("L L^T = S: %d\n", maxAbsDiff(llt.d, s.d, n * n) < 1.0e-10);
        lt.dispose();
        double xi[5];
        for (int i = 0; i < n; i++) { xi[i] = b[i]; }
        c.solve(xi, xi);
        printf("in place: %d\n", maxAbsDiff(xi, x, n) == 0.0);
        c.dispose();
        m.dispose(); mt.dispose(); s.dispose(); inv.dispose(); llt.dispose();
        // a matrix that is not positive definite
        double v1[4] = {1, 2, 2, 1};
        matrix.Matrix a1 = matrix.fromArray(v1, 2, 2);
        matrix.Cholesky c1(&a1);
        printf("[[1,2],[2,1]]: status %d (%s)\n", c1.err, matrix.errorText(c1.err));
        double v2[4] = {1, 1, 1, 1};
        matrix.Matrix a2 = matrix.fromArray(v2, 2, 2);
        matrix.Cholesky c2(&a2);
        printf("semi definite [[1,1],[1,1]]: status %d\n", c2.err);
        double v3[4] = {4, 1, 2, 3};
        matrix.Matrix a3 = matrix.fromArray(v3, 2, 2);
        matrix.Cholesky c3(&a3);
        printf("not symmetric: status %d (%s)\n", c3.err, matrix.errorText(c3.err));
        a3.d[1] = __dbl(0x7FF8000000000000);
        matrix.Cholesky c4(&a3);
        printf("NaN: status %d\n", c4.err);
        matrix.Matrix a5(2, 3);
        matrix.Cholesky c5(&a5);
        printf("2x3: status %d\n", c5.err);
        double nb[2] = {1, 1};
        printf("solve on a failed factorization: %d\n", c1.solve(nb, nb));
        c1.dispose(); c2.dispose(); c3.dispose(); c4.dispose(); c5.dispose();
        a1.dispose(); a2.dispose(); a3.dispose(); a5.dispose();
    }

    // ---- QR of a 7 x 4 matrix
    {
        matrix.Matrix a(7, 4);
        fillRandom(&a);
        double b[7];
        for (int i = 0; i < 7; i++) { b[i] = (double) (lcg() % 19 - 9); }
        matrix.QR f(&a);
        printf("qr status %d\n", f.err);
        matrix.Matrix q = f.q(false);
        matrix.Matrix r = f.r();
        printf("Q is %d x %d, R is %d x %d\n", q.rows, q.cols, r.rows, r.cols);
        matrix.Matrix qr = q * &r;
        printf("Q R = A (1e-12): %d\n", maxAbsDiff(qr.d, a.d, 28) < 1.0e-12);
        matrix.Matrix qt = q.transpose();
        matrix.Matrix qtq = qt * &q;
        double worst = 0.0;
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                double dd = absOf(qtq.d[i * 4 + j] - ((i == j) ? 1.0 : 0.0));
                if (dd > worst) { worst = dd; }
            }
        }
        printf("Q^T Q = I (1e-14): %d\n", worst < 1.0e-14);
        printf("R is upper triangular: %d\n", r.d[4] == 0.0 && r.d[8] == 0.0 && r.d[9] == 0.0 && r.d[12] == 0.0 && r.d[13] == 0.0 && r.d[14] == 0.0);
        double ad[4];
        for (int i = 0; i < 4; i++) { ad[i] = absOf(r.d[i * 4 + i]); }
        dumpV("|diag R|", ad, 4);
        matrix.Matrix qf = f.q(true);
        printf("full Q is %d x %d\n", qf.rows, qf.cols);
        matrix.Matrix qft = qf.transpose();
        matrix.Matrix qq = qft * &qf;
        worst = 0.0;
        for (int i = 0; i < 7; i++) {
            for (int j = 0; j < 7; j++) {
                double dd = absOf(qq.d[i * 7 + j] - ((i == j) ? 1.0 : 0.0));
                if (dd > worst) { worst = dd; }
            }
        }
        printf("full Q^T Q = I (1e-14): %d\n", worst < 1.0e-14);
        double x[4];
        double res;
        int st = f.solveLS(b, x, &res);
        printf("least squares status %d\n", st);
        dumpV("x", x, 4);
        pv("residual norm", res);
        double ax[7];
        a.mulVec(x, ax);
        for (int i = 0; i < 7; i++) { ax[i] -= b[i]; }
        pv("|A x - b| recomputed", matrix.vecNorm2(ax, 7));
        double xl[4];
        double rl;
        int rk;
        printf("lstsq: status %d, rank ", matrix.lstsq(&a, b, xl, &rl, &rk));
        printf("%d, same solution %d\n", rk, maxAbsDiff(xl, x, 4) < 1.0e-12);
        f.dispose();
        a.dispose(); q.dispose(); r.dispose(); qr.dispose(); qt.dispose(); qtq.dispose(); qf.dispose(); qft.dispose(); qq.dispose();
    }

    // ---- a polynomial fit through lstsq: y = 1 + 2 t + 3 t^2 on 6 points with noise that is exactly representable
    {
        matrix.Matrix a(6, 3);
        double y[6];
        double noise[6] = {0.5, -0.25, 0.125, -0.5, 0.25, -0.125};
        for (int i = 0; i < 6; i++) {
            double t = (double) i;
            a.d[i * 3] = 1.0;
            a.d[i * 3 + 1] = t;
            a.d[i * 3 + 2] = t * t;
            y[i] = 1.0 + 2.0 * t + 3.0 * t * t + noise[i];
        }
        double c[3];
        double res;
        int st = matrix.lstsq(&a, y, c, &res, null);
        printf("quadratic fit status %d\n", st);
        dumpV("coefficients", c, 3);
        pv("residual", res);
        a.dispose();
    }

    // ---- rank deficient and wide problems: the minimum norm solution
    {
        double av[6] = {1, 2, 2, 4, 3, 6};                     // rank 1 (the second column is twice the first)
        matrix.Matrix a = matrix.fromArray(av, 3, 2);
        double b[3] = {1, 0, 2};
        double x[2];
        double res;
        int rk;
        int st = matrix.lstsq(&a, b, x, &res, &rk);
        printf("rank deficient: status %d, rank %d\n", st, rk);
        dumpV("x", x, 2);
        pv("residual", res);
        matrix.QR f(&a);
        printf("QR of it: diagRatio below 1e-14 %d, solveLS status %d (ERR_RANK = %d)\n", f.diagRatio() < 1.0e-14, f.solveLS(b, x, null), matrix.ERR_RANK);
        f.dispose();
        a.dispose();
        double wv[8] = {1, 2, 0, 1, 0, 1, 3, 1};              // 2 equations, 4 unknowns
        matrix.Matrix w = matrix.fromArray(wv, 2, 4);
        double wb[2] = {3, 5};
        double wx[4];
        int st2 = matrix.lstsq(&w, wb, wx, &res, &rk);
        printf("wide 2x4: status %d, rank %d\n", st2, rk);
        dumpV("minimum norm x", wx, 4);
        pv("residual", clean(res));
        matrix.QR fw(&w);
        matrix.Matrix rw = fw.r();
        printf("QR of a wide matrix: status %d, R is %d x %d, solveLS status %d (ERR_DIM = %d)\n", fw.err, rw.rows, rw.cols, fw.solveLS(wb, wx, null), matrix.ERR_DIM);
        rw.dispose();
        fw.dispose();
        w.dispose();
        // a zero matrix: rank 0, solution 0
        matrix.Matrix z(3, 2);
        double zb[3] = {1, 2, 3};
        double zx[2] = {9, 9};
        int st3 = matrix.lstsq(&z, zb, zx, &res, &rk);
        printfd("zero matrix: status %d, rank %d, x %g %g, residual %g\n", st3, rk, __bits(zx[0]), __bits(zx[1]), __bits(res));
        z.dispose();
    }

    // ---- non finite input
    {
        matrix.Matrix a = matrix.identity(3);
        a.d[5] = __dbl(0x7FF0000000000000);
        matrix.QR f(&a);
        double b[3] = {1, 2, 3};
        double x[3];
        printf("QR with infinity: status %d, lstsq %d\n", f.err, matrix.lstsq(&a, b, x, null, null));
        f.dispose();
        a.d[5] = 0.0;
        b[1] = __dbl(0x7FF8000000000000);
        printf("lstsq with NaN in b: %d\n", matrix.lstsq(&a, b, x, null, null));
        printf("lstsq with null: %d\n", matrix.lstsq(null, b, x, null, null));
        a.dispose();
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
