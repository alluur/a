// default values for parameters
int add(int a, int b = 10, int c = 100) {
    return a + b + c;
}

int flag(int a, bool on = true, char* name = null, int k = -5) {
    if (on && name == null) {
        return a + k;
    }
    return 0;
}

const BASE = 7;
int withConst(int x, int y = BASE * 2) {
    return x * y;
}

char ch(char c = 'z') {
    return c;
}

class Acc {
    private int total;
    public Acc(int start = 1) {
        total = start;
    }
    public void add(int n = 1, int times = 1) {
        for (int i = 0; i < times; i++) {
            total += n;
        }
    }
    public int get() {
        return total;
    }
}

// a function used before its definition keeps its defaults
int main() {
    printlnInt(add(1));
    printlnInt(add(1, 2));
    printlnInt(add(1, 2, 3));
    printlnInt(flag(50));
    printlnInt(flag(50, false));
    printlnInt(flag(50, true, null, 1));
    printlnInt(withConst(3));
    printChar(ch()); printChar(ch('q')); printChar('\n');
    Acc a;
    a.add();
    a.add(5);
    a.add(2, 3);
    printlnInt(a.get());
    Acc b(100);
    b.add();
    printlnInt(b.get());
    Acc* p = new Acc();
    p->add(9);
    printlnInt(p->get());
    printf("%d %s %c\n", 42, "text", 'x');
    printf("only text\n");
    char buf[32];
    int n = format(buf, 32, "%d-%d", 3, 4);
    println(buf);
    printlnInt(n);
    return 0;
}
