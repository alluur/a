// optim: numerical integration: adaptive Gauss-Kronrod (finite and infinite ranges, endpoint singularities), Romberg, composite trapezoid and Simpson rules, Gauss-Legendre
// nodes and weights, rules for sampled data. The exact integrals are closed forms evaluated in 60 digit decimals (tests/algo2_ref/gen_t456.py).
import cstdio;
import asys;
import optim;
import dmath;

struct Wave { double freq; double scale; int calls; }

double fSin(double x, void* c) { return dmath.sin(x); }
double fPoly(double x, void* c) { return dmath.pow(x, 10.0); }
double fGauss(double x, void* c) { return dmath.exp(-x * x); }
double fLorentz(double x, void* c) { return 1.0 / (1.0 + x * x); }
double fLog(double x, void* c) { return dmath.log(x); }
double fInvSqrt(double x, void* c) { return 1.0 / dmath.sqrt(x); }
double fGamma4(double x, void* c) { return x * x * x * dmath.exp(-x); }
double fExp(double x, void* c) { return dmath.exp(x); }
double fCos100(double x, void* c) { return dmath.cos(100.0 * x); }
double fXexp(double x, void* c) { return x * dmath.exp(x); }
double fFour(double x, void* c) { return 4.0 / (1.0 + x * x); }
double fCircle(double x, void* c) { return dmath.sqrt(1.0 - x * x); }
double fRecip(double x, void* c) { return 1.0 / x; }
double fAbs(double x, void* c) { return dmath.fabs(x - 0.3); }
double fNan(double x, void* c) { return (x > 0.5) ? dmath.nan() : 1.0; }
double fWave(double x, void* c) { Wave* w = (Wave*) c; w->calls++; return w->scale * dmath.sin(w->freq * x); }
double fOne(double x, void* c) { return 1.0; }
double fCube(double x, void* c) { return x * x * x; }
double fX15(double x, void* c) { return dmath.pow(x, 15.0); }
double fX16(double x, void* c) { return dmath.pow(x, 16.0); }

void pi1(char* name, optim.Integral r, double tolLimit) {
    printf("%s: status %d", name, r.status);
    printfd(" value %.11g", __bits(r.value));
    printf(" error estimate below %s: %d\n", (tolLimit == 1.0e-9) ? "1e-9" : "1e-6", r.error <= tolLimit);
}

int main() {
    int base = asys.memInUse();
    double inf = dmath.INFINITY;
    optim.Integral r;
    // ---- adaptive Gauss-Kronrod
    pi1("sin on 0 .. pi", optim.gaussKronrod(fSin, null, 0.0, dmath.PI, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    pi1("x^10 on 0 .. 2", optim.gaussKronrod(fPoly, null, 0.0, 2.0, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    pi1("exp on 0 .. 1", optim.gaussKronrod(fExp, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    pi1("4 / (1 + x^2) on 0 .. 1 (pi)", optim.gaussKronrod(fFour, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    pi1("x exp(x) on 0 .. 1", optim.gaussKronrod(fXexp, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    pi1("exp(-x^2) on the whole line (sqrt pi)", optim.gaussKronrod(fGauss, null, -inf, inf, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("1 / (1 + x^2) on 0 .. infinity (pi / 2)", optim.gaussKronrod(fLorentz, null, 0.0, inf, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("x^3 exp(-x) on 0 .. infinity (6)", optim.gaussKronrod(fGamma4, null, 0.0, inf, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("exp(x) on -infinity .. 0 (1)", optim.gaussKronrod(fExp, null, -inf, 0.0, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("exp(x) on 0 .. -infinity (-inf reversed: the same with a minus)", optim.gaussKronrod(fExp, null, 0.0, -inf, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("ln(x) on 0 .. 1 (an integrable singularity at 0)", optim.gaussKronrod(fLog, null, 0.0, 1.0, 1.0e-10, 1.0e-10, 500), 1.0e-9);
    pi1("1 / sqrt(x) on 0 .. 1", optim.gaussKronrod(fInvSqrt, null, 0.0, 1.0, 1.0e-10, 1.0e-10, 500), 1.0e-9);
    pi1("sqrt(1 - x^2) on -1 .. 1 (pi / 2)", optim.gaussKronrod(fCircle, null, -1.0, 1.0, 1.0e-10, 1.0e-10, 500), 1.0e-9);
    pi1("cos(100 x) on 0 .. 1 (oscillating)", optim.gaussKronrod(fCos100, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("|x - 0.3| on 0 .. 1 (a kink)", optim.gaussKronrod(fAbs, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 200), 1.0e-9);
    pi1("sin on pi .. 0 (reversed limits)", optim.gaussKronrod(fSin, null, dmath.PI, 0.0, 1.0e-12, 1.0e-12, 100), 1.0e-9);
    r = optim.gaussKronrod(fSin, null, 1.5, 1.5, 1.0e-12, 1.0e-12, 100);
    printfd("empty range: status %d value %g evals %d\n", r.status, __bits(r.value), r.evals);
    // the number of evaluations stays small for smooth functions
    r = optim.gaussKronrod(fSin, null, 0.0, dmath.PI, 1.0e-12, 1.0e-12, 100);
    printf("smooth function: evaluations %d (one Kronrod rule of 15 points), intervals %d\n", r.evals, r.intervals);
    r = optim.gaussKronrod(fCos100, null, 0.0, 1.0, 1.0e-12, 1.0e-12, 200);
    printf("oscillating function: more evaluations (above 15 and below 2000): %d, intervals %d at most 40: %d\n", r.evals > 15 && r.evals < 2000, r.intervals, r.intervals <= 40);
    // a context carries parameters
    Wave w;
    w.freq = 3.0;
    w.scale = 2.0;
    w.calls = 0;
    r = optim.gaussKronrod(fWave, &w, 0.0, 2.0, 1.0e-12, 1.0e-12, 100);
    printfd("2 sin(3x) on 0 .. 2 with a context: status %d value %.11g calls equal evals %d\n", r.status, __bits(r.value), w.calls == r.evals);
    // failures
    r = optim.gaussKronrod(fRecip, null, 0.0, 1.0, 1.0e-10, 1.0e-10, 60);
    printf("1 / x on 0 .. 1 diverges: status %d (ERR_NO_CONVERGE = %d), the error estimate is large: %d\n", r.status, optim.ERR_NO_CONVERGE, r.error > 1.0);
    r = optim.gaussKronrod(fNan, null, 0.0, 1.0, 1.0e-10, 1.0e-10, 100);
    printf("NaN values: status %d (ERR_NAN = %d)\n", r.status, optim.ERR_NAN);
    r = optim.gaussKronrod(fSin, null, 0.0, 1000.0, 1.0e-14, 1.0e-14, 2);
    printf("too few subdivisions: status %d, still a finite estimate %d\n", r.status, r.value == r.value);
    printf("invalid arguments: NaN limit %d, negative tolerance %d, maxSub 0 %d, maxSub too large %d (ERR_ARG = %d)\n", optim.gaussKronrod(fSin, null, dmath.nan(), 1.0, 1.0e-9, 1.0e-9, 10).status,
           optim.gaussKronrod(fSin, null, 0.0, 1.0, -1.0, 1.0e-9, 10).status, optim.gaussKronrod(fSin, null, 0.0, 1.0, 1.0e-9, 1.0e-9, 0).status, optim.gaussKronrod(fSin, null, 0.0, 1.0, 1.0e-9, 1.0e-9, 100001).status, optim.ERR_ARG);
    printf("a loose tolerance needs only one rule: evaluations %d\n", optim.gaussKronrod(fExp, null, 0.0, 1.0, 1.0e-6, 1.0e-6, 100).evals);

    // ---- Romberg and the fixed rules
    pi1("Romberg sin on 0 .. pi", optim.romberg(fSin, null, 0.0, dmath.PI, 1.0e-12, 20), 1.0e-9);
    pi1("Romberg exp on 0 .. 1", optim.romberg(fExp, null, 0.0, 1.0, 1.0e-12, 20), 1.0e-9);
    pi1("Romberg x^10 on 0 .. 2", optim.romberg(fPoly, null, 0.0, 2.0, 1.0e-12, 20), 1.0e-9);
    r = optim.romberg(fSin, null, 0.0, dmath.PI, 1.0e-12, 20);
    printf("Romberg needs few levels (at most 8) for a smooth function: %d\n", r.intervals <= 8);
    r = optim.romberg(fInvSqrt, null, 0.0, 1.0, 1.0e-12, 12);
    printf("Romberg on 1 / sqrt(x) (not smooth at 0, 12 levels): status %d\n", r.status);
    printf("Romberg with 1 level: %d (ERR_ARG = %d), 31 levels: %d\n", optim.romberg(fSin, null, 0.0, 1.0, 1.0e-9, 1).status, optim.ERR_ARG, optim.romberg(fSin, null, 0.0, 1.0, 1.0e-9, 31).status);
    r = optim.trapezoid(fSin, null, 0.0, dmath.PI, 100);
    printfd("trapezoid sin, 100 panels: %.12g (evals %d)\n", __bits(r.value), r.evals);
    r = optim.simpson(fSin, null, 0.0, dmath.PI, 100);
    printfd("simpson sin, 100 panels: %.12g\n", __bits(r.value));
    r = optim.simpson(fSin, null, 0.0, dmath.PI, 7);
    printfd("simpson sin, 7 panels (rounded up to 8): %.12g evals %d\n", __bits(r.value), r.evals);
    printfd("simpson is exact for cubics: x^3 on 0 .. 1 with 2 panels %.12g\n", __bits(optim.simpson(fCube, null, 0.0, 1.0, 2).value));
    printfd("the trapezoid rule is not: x^3 on 0 .. 1 with 2 panels %.12g\n", __bits(optim.trapezoid(fCube, null, 0.0, 1.0, 2).value));
    printf("invalid: trapezoid n = 0: %d, simpson with NaN limit: %d, trapezoid of a NaN function: %d\n", optim.trapezoid(fSin, null, 0.0, 1.0, 0).status, optim.simpson(fSin, null, dmath.nan(), 1.0, 10).status, optim.trapezoid(fNan, null, 0.0, 1.0, 10).status);
    // the trapezoid rule has error O(h^2), Simpson O(h^4): halving h divides the errors by about 4 and 16
    {
        double ex = 2.0;
        double e1 = dmath.fabs(optim.trapezoid(fSin, null, 0.0, dmath.PI, 20).value - ex);
        double e2 = dmath.fabs(optim.trapezoid(fSin, null, 0.0, dmath.PI, 40).value - ex);
        double s1 = dmath.fabs(optim.simpson(fSin, null, 0.0, dmath.PI, 20).value - ex);
        double s2 = dmath.fabs(optim.simpson(fSin, null, 0.0, dmath.PI, 40).value - ex);
        printf("error ratios: trapezoid between 3.9 and 4.1: %d, Simpson between 15 and 17: %d\n", e1 / e2 > 3.9 && e1 / e2 < 4.1, s1 / s2 > 15.0 && s1 / s2 < 17.0);
    }

    // ---- Gauss-Legendre
    {
        double x[8];
        double wt[8];
        printf("gaussLegendre(8): %d\n", optim.gaussLegendre(8, x, wt));
        printf("nodes:");
        for (int i = 0; i < 8; i++) { printfd(" %.12g", __bits(x[i])); }
        printf("\nweights:");
        for (int i = 0; i < 8; i++) { printfd(" %.12g", __bits(wt[i])); }
        printf("\n");
        double x5[5];
        double w5[5];
        optim.gaussLegendre(5, x5, w5);
        printfd("n = 5: node 0 %.12g, middle node %g, weight sum %.12g\n", __bits(x5[0]), __bits(x5[2]), __bits(w5[0] + w5[1] + w5[2] + w5[3] + w5[4]));
        printf("invalid: n = 0 %d, n = 2001 %d, null %d\n", optim.gaussLegendre(0, x, wt), optim.gaussLegendre(2001, x, wt), optim.gaussLegendre(5, null, wt));
        // an n point rule is exact for polynomials of degree 2n - 1
        r = optim.integrateGL(fX15, null, 0.0, 1.0, 8);
        double e16 = dmath.fabs(optim.integrateGL(fX16, null, 0.0, 1.0, 8).value - 1.0 / 17.0);
        printfd("8 point rule on x^15 on 0 .. 1 (exact 1/16): %.12g, on x^16 (degree 16 is not exact): error between 1e-15 and 1e-9: %d\n", __bits(r.value), e16 > 1.0e-15 && e16 < 1.0e-9);
        pi1("20 point rule on exp, 0 .. 1", optim.integrateGL(fExp, null, 0.0, 1.0, 20), 1.0e-6);
        printf("integrateGL with n = 0: status %d\n", optim.integrateGL(fSin, null, 0.0, 1.0, 0).status);
    }

    // ---- sampled data
    {
        double xs[5] = {0.0, 0.5, 1.5, 3.0, 3.2};
        double ys[5] = {1.0, 2.0, 0.0, 4.0, -1.0};
        printfd("trapezoid for samples at uneven spacing: %.12g\n", __bits(optim.integrateSamples(xs, ys, 5)));
        double c7[7];
        double c6[6];
        for (int i = 0; i < 7; i++) { c7[i] = (double) i * 0.5 * (double) i * 0.5 * (double) i * 0.5; }
        for (int i = 0; i < 6; i++) { c6[i] = (double) i * 0.5 * (double) i * 0.5 * (double) i * 0.5; }
        printfd("Simpson for x^3 samples, 7 samples on 0 .. 3: %.12g (exact 20.25); 6 samples on 0 .. 2.5 (3/8 rule at the end): %.12g (exact 9.765625)\n", __bits(optim.simpsonSamples(c7, 7, 0.5)), __bits(optim.simpsonSamples(c6, 6, 0.5)));
        double two[2] = {3.0, 5.0};
        printfd("two samples: %.12g, three samples (one Simpson panel pair): %.12g\n", __bits(optim.simpsonSamples(two, 2, 0.5)), __bits(optim.simpsonSamples(c7, 3, 0.5)));
        printf("invalid: n = 1 is NaN %d, null is NaN %d\n", optim.integrateSamples(xs, ys, 1) != optim.integrateSamples(xs, ys, 1), optim.simpsonSamples(null, 4, 1.0) != optim.simpsonSamples(null, 4, 1.0));
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
