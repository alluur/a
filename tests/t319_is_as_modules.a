// is / as with classes that live in modules, also when two modules have a class of the same name
module app;

import langmods.alpha;
import langmods.beta;

int main() {
    alpha.Thing* a = new alpha.Thing();
    alpha.Thing* b = new beta.Thing();
    printlnInt(a is alpha.Thing ? 1 : 0);         // 1
    printlnInt(a is beta.Thing ? 1 : 0);          // 0: an alpha.Thing is no beta.Thing although both are called Thing
    printlnInt(b is alpha.Thing ? 1 : 0);         // 1
    printlnInt(b is beta.Thing ? 1 : 0);          // 1
    beta.Thing* c = b as beta.Thing;
    beta.Thing* d = a as beta.Thing;
    printlnInt(c != null ? c->v() : -1);          // 2
    printlnInt(d != null ? d->v() : -1);          // -1
    alpha.Thing* e = b as alpha.Thing;
    printlnInt(e != null ? e->v() : -1);          // 2
    return 0;
}
