// lambdas: classes, loops, goto, switch, defer, static locals, state of the enclosing function, deep nesting
int g = 100;
func fact;
int trace = 0;
int apply(func f, int x) { return f(x); }
int callTwice(func f) { return f(1) + f(2); }
void note(int v) { trace = trace * 10 + v; }

class Counter {
public:
    int base;
    static int shared = 5;
    Counter(int b) { base = b; }
    int run(int x) {
        var f = (int y) => y + Counter.shared;
        return f(x) + base;
    }
    static int sapply(int x) {
        return apply((int v) => v * 3, x);
    }
}

int outerWithDefer(int n) {
    defer note(9);
    for (int i = 0; i < 2; i++) {
        func f = (int k) => { defer note(k); note(5); return k * 2; };
        n += f(i + 1);
    }
    note(7);
    return n;
}

int labels(int n) {
    int r = 0;
    again:
    r++;
    func f = (int a) => { int s = 0; loop: s++; if (s < a) { goto loop; } return s; };
    r += f(2);
    if (r < n) { goto again; }
    return r;
}

int main() {
    // recursion through a global func variable
    fact = (int n) => n <= 1 ? 1 : n * fact(n - 1);
    printf("%d\n", fact(10));

    // in loops: the same code every time, a parameter instead of a capture
    int total = 0;
    for (int i = 0; i < 4; i++) {
        func sq = (int x) => x * x + 1;
        total += sq(i);
    }
    printf("%d\n", total);

    // break and continue belong to loops inside the lambda
    for (int i = 0; i < 3; i++) {
        func f = (int n) => { int s = 0; for (int k = 0; k < n; k++) { if (k == 2) { continue; } if (k == 4) { break; } s += k; } return s; };
        printf("%d ", f(i + 3));
    }
    printf("\n");

    // goto, labels, switch inside a lambda; the labels of the enclosing function are not disturbed
    func lbl = (int n) => {
        int r = 0;
        again:
        r++;
        if (r < n) { goto again; }
        switch (r) { case 3: r = r * 10; break; default: r = -r; }
        return r;
    };
    printf("%d %d\n", lbl(3), lbl(5));
    printf("%d\n", labels(10));

    // defer in the lambda runs when the lambda returns; the defers of the enclosing function are still its own
    printf("%d\n", outerWithDefer(0));
    printf("%d\n", trace);

    // static local in a lambda keeps its value
    func cnt = () => { static int c = 0; c++; return c; };
    cnt(); cnt();
    printf("%d\n", cnt());

    // classes
    Counter c(10);
    printf("%d %d\n", c.run(1), Counter.sapply(4));

    // many parameters, deep nesting
    func many = (a, b, c, d, e, f, g, h) => a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8;
    printf("%d\n", many(1, 1, 1, 1, 1, 1, 1, 1));
    func n1 = (int a) => ((int b) => ((int c) => c + 1)(b + 1))(a + 1);
    printf("%d\n", n1(1));
    printf("%d\n", callTwice(x => x * 100));

    // several lambdas in one expression and a lambda in a conditional
    int pick = 1;
    func pf = (pick == 1) ? ((int x) => x + 1) : ((int x) => x - 1);
    printf("%d\n", pf(10));
    printf("%d\n", ((a) => a + 1)(1) * ((a) => a + 2)(1));

    // the comma operator is gone inside parentheses, the lambda parameter list is not a tuple
    func pair = (a, b) => a * 100 + b;
    printf("%d\n", pair(1, 2));
    return 0;
}
