// strx: Levenshtein (full, banded), OSA, Damerau, Hamming, Jaro-Winkler and q-gram similarities against reference implementations
import cstdio;
import cstring;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 99;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void randText(char* buf, int len, int alpha) {
    for (int i = 0; i < len; i++) { buf[i] = 'a' + rnd(alpha); }
    buf[len] = 0;
}

int min3(int a, int b, int c) {
    int m = a;
    if (b < m) { m = b; }
    if (c < m) { m = c; }
    return m;
}

// reference: the whole matrix
int refLev(char* a, int na, char* b, int nb) {
    int d[1600];
    int w = nb + 1;
    for (int i = 0; i <= na; i++) { d[i * w] = i; }
    for (int j = 0; j <= nb; j++) { d[j] = j; }
    for (int i = 1; i <= na; i++) {
        for (int j = 1; j <= nb; j++) {
            d[i * w + j] = min3(d[(i - 1) * w + j] + 1, d[i * w + j - 1] + 1, d[(i - 1) * w + j - 1] + ((a[i - 1] == b[j - 1]) ? 0 : 1));
        }
    }
    return d[na * w + nb];
}

int refOsa(char* a, int na, char* b, int nb) {
    int d[1600];
    int w = nb + 1;
    for (int i = 0; i <= na; i++) { d[i * w] = i; }
    for (int j = 0; j <= nb; j++) { d[j] = j; }
    for (int i = 1; i <= na; i++) {
        for (int j = 1; j <= nb; j++) {
            int v = min3(d[(i - 1) * w + j] + 1, d[i * w + j - 1] + 1, d[(i - 1) * w + j - 1] + ((a[i - 1] == b[j - 1]) ? 0 : 1));
            if (i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && d[(i - 2) * w + j - 2] + 1 < v) { v = d[(i - 2) * w + j - 2] + 1; }
            d[i * w + j] = v;
        }
    }
    return d[na * w + nb];
}

// reference for the true Damerau-Levenshtein distance: breadth first search over all strings of a 3 letter alphabet up to length 7 with the operations
// insert, delete, replace and swap of two neighbours (each costs 1); a string is a base 4 number, the letters are the digits 1..3
int code(char* s, int n) {
    int c = 0;
    for (int i = n - 1; i >= 0; i--) { c = c * 4 + (s[i] - 'a' + 1); }
    return c;
}

int bfsDist(char* a, int na, char* b, int nb) {
    int dist[16384];
    int queue[16384];
    for (int i = 0; i < 16384; i++) { dist[i] = -1; }
    int start = code(a, na);
    int goal = code(b, nb);
    int head = 0;
    int tail = 0;
    queue[tail] = start; tail++;
    dist[start] = 0;
    while (head < tail) {
        int cur = queue[head];
        head++;
        if (cur == goal) { return dist[cur]; }
        // decode
        int digits[8];
        int n = 0;
        int t = cur;
        while (t > 0) { digits[n] = t % 4; t = t / 4; n++; }
        for (int pass = 0; pass < 4; pass++) {
            for (int i = 0; i <= n; i++) {
                for (int c = 1; c <= 3; c++) {
                    int next = -1;
                    int nd[9];
                    int m = 0;
                    if (pass == 0 && n < 7) {                  // insert c before position i
                        for (int k = 0; k < i; k++) { nd[m] = digits[k]; m++; }
                        nd[m] = c; m++;
                        for (int k = i; k < n; k++) { nd[m] = digits[k]; m++; }
                    } else if (pass == 1 && i < n && c == 1) { // delete position i
                        for (int k = 0; k < n; k++) { if (k != i) { nd[m] = digits[k]; m++; } }
                    } else if (pass == 2 && i < n && c != digits[i]) {   // replace
                        for (int k = 0; k < n; k++) { nd[m] = (k == i) ? c : digits[k]; m++; }
                    } else if (pass == 3 && i + 1 < n && c == 1) {       // swap i, i + 1
                        for (int k = 0; k < n; k++) { nd[m] = digits[k]; m++; }
                        nd[i] = digits[i + 1]; nd[i + 1] = digits[i];
                    } else {
                        continue;
                    }
                    int v = 0;
                    for (int k = m - 1; k >= 0; k--) { v = v * 4 + nd[k]; }
                    next = v;
                    if (dist[next] < 0) { dist[next] = dist[cur] + 1; queue[tail] = next; tail++; }
                }
            }
        }
    }
    return -1;
}

void editDistances() {
    char a[40];
    char b[40];
    int bad = 0;
    int badMax = 0;
    int badOsa = 0;
    for (int round = 0; round < 1500; round++) {
        int na = rnd(25);
        int nb = rnd(25);
        int alpha = 1 + rnd(4);
        randText(&a[0], na, alpha);
        if (rnd(3) == 0) {                                   // b is a damaged copy of a
            for (int i = 0; i < na; i++) { b[i] = a[i]; }
            nb = na;
            for (int e = rnd(4); e > 0 && nb > 0; e--) { b[rnd(nb)] = 'a' + rnd(alpha); }
            b[nb] = 0;
        } else {
            randText(&b[0], nb, alpha);
        }
        int want = refLev(&a[0], na, &b[0], nb);
        if (strx.levenshtein(&a[0], na, &b[0], nb) != want) { bad++; }
        if (strx.levenshtein(&a[0], -1, &b[0], -1) != want) { bad++; }
        for (int k = 0; k <= 8; k++) {
            int expect = (want > k) ? k + 1 : want;
            if (strx.levenshteinMax(&a[0], na, &b[0], nb, k) != expect) { badMax++; }
        }
        if (strx.levenshteinMax(&a[0], na, &b[0], nb, -1) != want) { badMax++; }
        if (strx.osa(&a[0], na, &b[0], nb) != refOsa(&a[0], na, &b[0], nb)) { badOsa++; }
    }
    check(bad == 0, "levenshtein agrees with the full matrix (1500 random pairs)");
    check(badMax == 0, "levenshteinMax(k) == min(distance, k + 1) for k = -1 and 0..8");
    check(badOsa == 0, "osa agrees with the full matrix with transpositions");
    check(strx.levenshtein("kitten", -1, "sitting", -1) == 3 && strx.levenshtein("", -1, "abc", -1) == 3 && strx.levenshtein("abc", -1, "", -1) == 3 && strx.levenshtein("", -1, "", -1) == 0, "textbook values");
    check(strx.levenshtein(null, -1, "abc", -1) == 3 && strx.levenshtein("flaw", -1, "lawn", -1) == 2 && strx.levenshtein("abc", 2, "abd", 2) == 0 && strx.levenshtein("abc", 3, "abd", 2) == 1, "null, explicit lengths");
    check(strx.levenshtein("saturday", -1, "sunday", -1) == 3 && strx.levenshtein("a", -1, "b", -1) == 1 && strx.levenshtein("intention", -1, "execution", -1) == 5, "more textbook values");
}

void damerauChecks() {
    char a[8];
    char b[8];
    int bad = 0;
    for (int round = 0; round < 250; round++) {
        int na = rnd(5);
        int nb = rnd(5);
        randText(&a[0], na, 3);
        randText(&b[0], nb, 3);
        int want = bfsDist(&a[0], na, &b[0], nb);
        if (strx.damerau(&a[0], na, &b[0], nb) != want) { bad++; }
        int o = strx.osa(&a[0], na, &b[0], nb);
        if (o < want) { bad++; }                            // OSA is never below the true distance
    }
    check(bad == 0, "damerau equals a breadth first search over edit operations (250 pairs of up to 4 letters)");
    check(strx.damerau("ca", -1, "abc", -1) == 2 && strx.osa("ca", -1, "abc", -1) == 3, "the classic case where OSA and Damerau differ");
    check(strx.damerau("ab", -1, "ba", -1) == 1 && strx.damerau("abcd", -1, "acbd", -1) == 1 && strx.damerau("", -1, "xyz", -1) == 3 && strx.damerau("xyz", -1, "", -1) == 3, "damerau basics");
    check(bfsDist("ca", 2, "abc", 3) == 2 && bfsDist("abc", 3, "ca", 2) == 2 && bfsDist("ab", 2, "ba", 2) == 1, "the reference itself on the classic pairs");
    char* big1 = alloc(4001);
    char* big2 = alloc(4001);
    memset(big1, 'a', 4000);
    memset(big2, 'b', 4000);
    check(strx.damerau(big1, 4000, big2, 4000) == -1, "damerau refuses a table of more than 2^23 cells");
}

void hammingChecks() {
    check(strx.hamming("karolin", -1, "kathrin", -1) == 3 && strx.hamming("1011101", -1, "1001001", -1) == 2 && strx.hamming("", -1, "", -1) == 0, "hamming");
    check(strx.hamming("abc", -1, "abcd", -1) == -1 && strx.hamming("abc", 2, "abd", 2) == 0, "hamming of different lengths is -1, explicit lengths");
    check(strx.hammingBits("a", -1, "b", -1) == 2 && strx.hammingBits("\xff\x00", 2, "\x00\xff", 2) == 16 && strx.hammingBits("ab", -1, "a", -1) == -1, "hamming bits");
    char x[4]; char y[4];
    x[0] = 0; x[1] = 7; y[0] = 255; y[1] = 7;
    check(strx.hammingBits(&x[0], 2, &y[0], 2) == 8 && strx.hamming(&x[0], 2, &y[0], 2) == 1, "hamming with 0 and 255 bytes");
    check(strx.commonPrefix("abcdef", -1, "abcxyz", -1) == 3 && strx.commonSuffix("xxabc", -1, "yyabc", -1) == 3 && strx.commonPrefix("", -1, "a", -1) == 0, "common prefix and suffix");
}

void utf8Checks() {
    // "cafe" with an accent: 5 bytes, 4 code points
    char* cafe = "caf\xc3\xa9";
    check(strx.levenshtein(cafe, -1, "cafe", -1) == 2, "bytes: the accent costs 2");
    check(strx.levenshtein(cafe, -1, "cafe", -1, true) == 1, "utf8: the accent costs 1");
    check(strx.levenshtein("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e", -1, "\xe6\x97\xa5\xe6\x9c\xac", -1, true) == 1, "utf8: one CJK letter missing");
    check(strx.levenshtein("\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e", -1, "\xe6\x97\xa5\xe6\x9c\xac", -1) == 3, "bytes: three bytes missing");
    // two emoji (4 byte sequences) that share the first 3 bytes differ in one symbol
    check(strx.levenshtein("\xf0\x9f\x98\x80", -1, "\xf0\x9f\x98\x81", -1, true) == 1 && strx.levenshtein("\xf0\x9f\x98\x80", -1, "\xf0\x9f\x98\x81", -1) == 1, "emoji");
    check(strx.hamming("\xc3\xa9\xc3\xa9", -1, "\xc3\xa9e", -1, true) == 1 && strx.hamming("\xc3\xa9\xc3\xa9", -1, "\xc3\xa9e", -1) == -1, "hamming counts symbols");
    // invalid bytes are symbols of their own: a lone 0xE9 (Latin-1) differs from the proper sequence
    check(strx.levenshtein("caf\xe9", -1, cafe, -1, true) == 1, "an invalid byte is one symbol");
    check(strx.levenshtein("\xc3", -1, "\xc3\xa9", -1, true) == 1 && strx.levenshtein("\xe2\x82", -1, "\xe2\x82\xac", -1, true) == 2, "truncated sequences");
    check(strx.osa("\xc3\xa9\xc3\xa8", -1, "\xc3\xa8\xc3\xa9", -1, true) == 1 && strx.osa("\xc3\xa9\xc3\xa8", -1, "\xc3\xa8\xc3\xa9", -1) == 2, "swap of two accented letters");
    check(strx.damerau("\xc3\xa9\xc3\xa8", -1, "\xc3\xa8\xc3\xa9", -1, true) == 1, "damerau on code points");
    check(strx.levenshteinMax(cafe, -1, "cafe", -1, 1, true) == 1 && strx.levenshteinMax(cafe, -1, "cafe", -1, 0, true) == 1, "banded utf8");
    // overlong and surrogate encodings are invalid, so each byte is a symbol
    check(strx.levenshtein("\xc0\x80", -1, "", -1, true) == 2 && strx.levenshtein("\xed\xa0\x80", -1, "", -1, true) == 3, "overlong and surrogate sequences are not decoded");
}

// formats a similarity with 6 decimals into the output
void showD(char* label, double v) {
    printf("%s %s\n", label, doubleToFixed(v, 6));
}

void similarity() {
    // known values from the literature and from the reference implementation
    showD("jaro MARTHA MARHTA", strx.jaro("MARTHA", -1, "MARHTA", -1));
    showD("jw   MARTHA MARHTA", strx.jaroWinkler("MARTHA", -1, "MARHTA", -1));
    showD("jaro DIXON DICKSONX", strx.jaro("DIXON", -1, "DICKSONX", -1));
    showD("jw   DIXON DICKSONX", strx.jaroWinkler("DIXON", -1, "DICKSONX", -1));
    showD("jaro dwayne duane", strx.jaro("dwayne", -1, "duane", -1));
    showD("jw   dwayne duane", strx.jaroWinkler("dwayne", -1, "duane", -1));
    showD("jaro JELLYFISH SMELLYFISH", strx.jaro("JELLYFISH", -1, "SMELLYFISH", -1));
    showD("jw   crate trace", strx.jaroWinkler("crate", -1, "trace", -1));
    showD("jw   abc abc", strx.jaroWinkler("abc", -1, "abc", -1));
    showD("jw   abc xyz", strx.jaroWinkler("abc", -1, "xyz", -1));
    showD("jw   empty empty", strx.jaroWinkler("", -1, "", -1));
    showD("jw   empty a", strx.jaroWinkler("", -1, "a", -1));
    showD("jw   a a", strx.jaroWinkler("a", -1, "a", -1));
    showD("jw   ab ba", strx.jaroWinkler("ab", -1, "ba", -1));
    showD("jwx  MARTHA MARHTA scale .2", strx.jaroWinklerEx("MARTHA", -1, "MARHTA", -1, false, 0.2, 4, 0.7));
    showD("jwx  no boost threshold .99", strx.jaroWinklerEx("MARTHA", -1, "MARHTA", -1, false, 0.1, 4, 0.99));
    showD("jaro utf8 cafe", strx.jaro("caf\xc3\xa9", -1, "cafe", -1, true));
    showD("jaro bytes cafe", strx.jaro("caf\xc3\xa9", -1, "cafe", -1));
    showD("dice night nacht", strx.diceBigrams("night", -1, "nacht", -1));
    showD("dice context contact", strx.diceBigrams("context", -1, "contact", -1));
    showD("dice trigram abcde abcxe", strx.diceQgrams("abcde", -1, "abcxe", -1, 3));
    showD("dice a a", strx.diceBigrams("a", -1, "a", -1));
    showD("dice a b", strx.diceBigrams("a", -1, "b", -1));
    showD("dice aaaa aa multiset", strx.diceBigrams("aaaa", -1, "aa", -1));
    showD("jaccard night nacht", strx.jaccardQgrams("night", -1, "nacht", -1));
    showD("jaccard aaaa aa sets", strx.jaccardQgrams("aaaa", -1, "aa", -1));
    showD("cosine aaaa aa", strx.cosineQgrams("aaaa", -1, "aa", -1));
    showD("cosine abab baba", strx.cosineQgrams("abab", -1, "baba", -1));
    showD("lev sim kitten sitting", strx.levenshteinSimilarity("kitten", -1, "sitting", -1));
    showD("lev sim empty", strx.levenshteinSimilarity("", -1, "", -1));
    showD("lev sim utf8", strx.levenshteinSimilarity("caf\xc3\xa9", -1, "cafe", -1, true));
}

void properties() {
    // jaro-winkler is symmetric in the Jaro part, within 0..1, equal strings give 1
    char a[24];
    char b[24];
    int bad = 0;
    for (int round = 0; round < 300; round++) {
        int na = rnd(14);
        int nb = rnd(14);
        randText(&a[0], na, 1 + rnd(5));
        randText(&b[0], nb, 1 + rnd(5));
        double j1 = strx.jaro(&a[0], na, &b[0], nb);
        double j2 = strx.jaro(&b[0], nb, &a[0], na);
        double w = strx.jaroWinkler(&a[0], na, &b[0], nb);
        if (j1 != j2 || j1 < 0.0 || j1 > 1.0 || w < j1 || w > 1.0) { bad++; }
        if (strx.jaro(&a[0], na, &a[0], na) != 1.0) { bad++; }
        double d1 = strx.diceBigrams(&a[0], na, &b[0], nb);
        double d2 = strx.diceBigrams(&b[0], nb, &a[0], na);
        if (d1 != d2 || d1 < 0.0 || d1 > 1.0) { bad++; }
        double l = strx.levenshteinSimilarity(&a[0], na, &b[0], nb);
        if (l < 0.0 || l > 1.0) { bad++; }
    }
    check(bad == 0, "similarities are symmetric and between 0 and 1 (300 random pairs)");
}

void bigBanded() {
    // two texts of 200000 letters that differ in 12 places: the banded distance stays fast
    int n = 200000;
    char* a = alloc(n + 1);
    char* b = alloc(n + 1);
    for (int i = 0; i < n; i++) { a[i] = 'a' + rnd(20); b[i] = a[i]; }
    for (int e = 0; e < 12; e++) { b[1000 + e * 15000] = 'z'; }
    b[n / 2 + 77] = 'y';
    int d = strx.levenshteinMax(a, n, b, n, 40);
    int ref = 0;
    for (int i = 0; i < n; i++) { if (a[i] != b[i]) { ref++; } }
    check(d <= ref && d >= 1 && d <= 13, "banded Levenshtein of two 200000 letter texts with 13 substitutions");
    check(strx.hamming(a, n, b, n) == ref && ref == 13, "hamming of the same texts");
    // a text against itself with one letter inserted
    char* c = alloc(n + 2);
    memcpy(c, a, n / 3);
    c[n / 3] = 'q';
    memcpy(&c[n / 3 + 1], &a[n / 3], n - n / 3);
    check(strx.levenshteinMax(a, n, c, n + 1, 5) == 1, "one inserted letter in a 200000 letter text");
    check(strx.levenshteinMax(a, n, c, n + 1, 0) == 1, "limit 0 and the lengths differ by one");
}

int main() {
    editDistances();
    damerauChecks();
    hammingChecks();
    utf8Checks();
    similarity();
    properties();
    bigBanded();
    printf("distance: %d checks, %d failures\n", checks, fails);
    return fails;
}
