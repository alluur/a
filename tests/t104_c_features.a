// comma operator, sizeof of expressions, C integer type words, adjacent strings,
// typedef enum / typedef struct, struct keyword in types, extern, function pointer declarators
typedef enum { RED, GREEN = 5, BLUE } Color;
typedef enum Mode { OFF, ON } Mode;
typedef struct { int x; int y; } Point;
typedef struct Node { int val; struct Node* next; } Node;
struct Rect { Point a; Point b; };
typedef struct Rect Rectangle;
typedef int (*BinOp)(int, int);

extern int counter;
int counter = 40;
int table[6];
struct Rect origin;

int add(int a, int b) { return a + b; }
int mul(int a, int b) { return a * b; }
int apply(int (*f)(int, int), int a, int b) { return f(a, b); }

struct Ops { int (*first)(int, int); BinOp second; };

int main() {
    int a = 0, b = 0;
    for (a = 0, b = 10; a < 3; a++, b--) { }
    printlnInt(a * 100 + b);
    int c = (a = 5, a + 1);
    printlnInt(c);

    int arr[7];
    char text[5];
    printlnInt(sizeof(arr));
    printlnInt(sizeof arr);
    printlnInt(sizeof(arr) / sizeof(arr[0]));
    printlnInt(sizeof(text));
    printlnInt(sizeof(table) / sizeof(table[0]));
    printlnInt(sizeof(Point));
    printlnInt(sizeof(struct Rect));
    printlnInt(sizeof(c + 1));
    printlnInt(sizeof(char*));

    long l = 5;
    short s = 2;
    unsigned u = 3;
    unsigned char uc = 200;
    long long ll = 4;
    unsigned long long int ull = 6;
    signed int si = 1;
    printlnInt(l + s + u + uc + ll + ull + si);
    printlnInt((unsigned)9);
    long double ld = 1.5;
    printlnDouble(ld * 2);

    char* msg = "Hello, "
                "adjacent "
                "strings";
    println(msg);

    Color col = BLUE;
    Mode m = ON;
    printlnInt(col + m + GREEN + RED);

    Point p;
    p.x = 3;
    p.y = 4;
    Node n1;
    Node n2;
    n1.val = 10;
    n2.val = 20;
    n1.next = &n2;
    struct Node* pn = &n1;
    printlnInt(p.x * p.y + pn->next->val);
    Rectangle r;
    r.a.x = 1;
    r.b.y = 2;
    origin.a.x = 7;
    printlnInt(r.a.x + r.b.y + origin.a.x);

    extern int counter;
    printlnInt(counter);

    int (*op)(int, int) = add;
    BinOp op2 = mul;
    printlnInt(op(2, 3));
    printlnInt(op2(4, 5));
    printlnInt(apply(add, 10, 20));
    printlnInt(apply(mul, 6, 7));
    struct Ops ops;
    ops.first = mul;
    ops.second = add;
    printlnInt(ops.first(3, 3) + ops.second(1, 1));
    return 0;
}
