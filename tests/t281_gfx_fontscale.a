// gfx font scaling: scaleFont makes a copy at another size, setFontScales / setUiFont change the shared fonts in place (every widget that holds
// gfx.sans() sees them), and the original size comes back exactly
import gfx;

int paintSum(gfx.Font* f, char* text) {
    gfx.Surface* s = new gfx.Surface(400, 80);
    s->clear(gfx.rgb(255, 255, 255));
    s->text(f, 4, 4, text, gfx.rgb(0, 0, 0));
    int c = s->checksum();
    s->release();
    return c;
}

int inkPixels(gfx.Font* f, char* text) {
    gfx.Surface* s = new gfx.Surface(400, 80);
    s->clear(gfx.rgb(255, 255, 255));
    s->text(f, 4, 4, text, gfx.rgb(0, 0, 0));
    int n = 0;
    for (int y = 0; y < 80; y++) {
        for (int x = 0; x < 400; x++) {
            if ((s->get(x, y) & 255) < 128) { n++; }
        }
    }
    s->release();
    return n;
}

void show(char* label, gfx.Font* f) {
    printf("%s: ascent %d height %d M %d i %d width %d ink %d sum %x\n", label, f->ascent, f->height, f->advance('M'), f->advance('i'), gfx.textWidth(f, "Hello, world"), inkPixels(f, "Hello, world"), paintSum(f, "Hello, world"));
}

int main() {
    gfx.Font* sans = gfx.sans();
    gfx.Font* mono = gfx.mono();
    show("sans", sans);
    show("mono", mono);
    int before = paintSum(sans, "Hello, world");
    int beforeBold = paintSum(gfx.sansBold(), "Hello, world");
    int beforeMono = paintSum(mono, "Hello, world");
    int h100 = sans->height;

    printf("== scaleFont\n");
    int pcts[7] = {50, 85, 100, 115, 130, 150, 200};
    for (int i = 0; i < 7; i++) {
        gfx.Font* g = gfx.scaleFont(sans, pcts[i]);
        char label[20];
        format(&label[0], 20, "sans %d%%", pcts[i]);
        show(&label[0], g);
    }
    show("mono 150%", gfx.scaleFont(mono, 150));
    printf("a copy at 100%% draws the same: %d\n", paintSum(gfx.scaleFont(sans, 100), "Hello, world") == before ? 1 : 0);
    printf("bad input: %d %d %d %d\n", gfx.scaleFont(null, 100) == null ? 1 : 0, gfx.scaleFont(sans, 10) == null ? 1 : 0, gfx.scaleFont(sans, 500) == null ? 1 : 0, gfx.scaleFont(new gfx.Font(""), 100) == null ? 1 : 0);
    gfx.Font* twice = gfx.scaleFont(gfx.scaleFont(sans, 200), 50);
    printf("200%% then 50%%: height %d (was %d), M %d (was %d)\n", twice->height, h100, twice->advance('M'), sans->advance('M'));
    // every code of the font can be drawn at every size (no glyph gets lost or broken)
    char all[256];
    int n = 0;
    for (int c = 33; c < 127; c++) { all[n] = c; n++; }
    all[n] = 0;
    printf("all printable characters at 130%%: ink %d, at 85%%: ink %d, at 100%%: ink %d\n", inkPixels(gfx.scaleFont(sans, 130), &all[0]), inkPixels(gfx.scaleFont(sans, 85), &all[0]), inkPixels(sans, &all[0]));

    printf("== setFontScales (in place)\n");
    gfx.setFontScales(130, 100);
    printf("same object: %d, scale %d / %d\n", gfx.sans() == sans ? 1 : 0, gfx.uiFontScale(), gfx.monoFontScale());
    show("sans", sans);
    show("bold", gfx.sansBold());
    show("mono (unchanged)", mono);
    gfx.setFontScales(85, 150);
    show("sans", sans);
    show("mono", mono);
    gfx.setFontScales(100, 100);
    printf("back at 100%%: sans %d, bold %d, mono %d\n", paintSum(sans, "Hello, world") == before ? 1 : 0, paintSum(gfx.sansBold(), "Hello, world") == beforeBold ? 1 : 0, paintSum(mono, "Hello, world") == beforeMono ? 1 : 0);
    gfx.setFontScales(5, 9000);
    printf("limits: %d / %d\n", gfx.uiFontScale(), gfx.monoFontScale());
    gfx.setFontScales(100, 100);

    printf("== setUiFont\n");
    printf("bad file: %d, missing: %d\n", gfx.setUiFont("build/tests/t281_nothing.afont") ? 1 : 0, gfx.setUiFont("/nonexistent/font") ? 1 : 0);
    printf("unchanged after a bad file: %d\n", paintSum(sans, "Hello, world") == before ? 1 : 0);
    printf("mono: %d\n", gfx.setUiFont("mono") ? 1 : 0);
    show("sans as mono", sans);
    printf("sans draws like mono: %d\n", paintSum(sans, "Hello, world") == beforeMono ? 1 : 0);
    gfx.setFontScales(115, 100);
    show("sans as mono at 115%", sans);
    printf("sans: %d\n", gfx.setUiFont("sans") ? 1 : 0);
    gfx.setFontScales(100, 100);
    printf("back to the configured sans: %d, bold: %d\n", paintSum(sans, "Hello, world") == before ? 1 : 0, paintSum(gfx.sansBold(), "Hello, world") == beforeBold ? 1 : 0);
    printf("empty name is sans: %d\n", gfx.setUiFont("") ? 1 : 0);
    printf("assign an invalid font: %d\n", sans->assign(new gfx.Font("")) ? 1 : 0);

    printf("== setFontScales keeps no glyph sets for good\n");
    // a program that zooms back and forth (a key press per step) used to compute and keep three new glyph sets for every call
    gfx.setFontScales(100, 100);
    int b0 = gfx.fontScaleBuilds();
    gfx.setFontScales(170, 175);                        // sizes that nothing above has used: sans and bold at 170, mono at 175
    int s170 = paintSum(sans, "Hello, world");
    int m175 = paintSum(mono, "Hello, world");
    gfx.setFontScales(175, 170);
    int s175 = paintSum(sans, "Hello, world");
    int b1 = gfx.fontScaleBuilds();
    printf("two new size pairs: %d glyph sets computed\n", b1 - b0);
    for (int i = 0; i < 100; i++) { gfx.setFontScales(175 - (i % 2) * 5, 170 + (i % 2) * 5); }
    printf("100 more calls between the same two pairs: %d glyph sets computed\n", gfx.fontScaleBuilds() - b1);
    gfx.setFontScales(170, 175);
    printf("a size that was used before looks exactly the same: sans %d, mono %d, back to 175: %d\n", paintSum(sans, "Hello, world") == s170 ? 1 : 0, paintSum(mono, "Hello, world") == m175 ? 1 : 0, (gfx.setFontScales(175, 170), paintSum(sans, "Hello, world") == s175) ? 1 : 0);
    // more different sizes than the cache holds: the oldest go, the ones in use stay, and every size still draws as it did the first time
    int sums[26];
    for (int k = 0; k < 26; k++) { gfx.setFontScales(50 + k * 10, 50 + k * 10); sums[k] = paintSum(sans, "Hello, world") ^ paintSum(mono, "Hello, world"); }
    int same = 0;
    for (int k = 0; k < 26; k++) { gfx.setFontScales(50 + k * 10, 50 + k * 10); if ((paintSum(sans, "Hello, world") ^ paintSum(mono, "Hello, world")) == sums[k]) { same++; } }
    printf("26 sizes twice (78 glyph sets wanted, the cache holds 48): %d of 26 look the same the second time\n", same);
    gfx.setFontScales(100, 100);
    printf("back at 100%%: sans %d, bold %d, mono %d\n", paintSum(sans, "Hello, world") == before ? 1 : 0, paintSum(gfx.sansBold(), "Hello, world") == beforeBold ? 1 : 0, paintSum(mono, "Hello, world") == beforeMono ? 1 : 0);
    return 0;
}
