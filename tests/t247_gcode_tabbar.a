// gcode.TabBar: selecting, modified markers, close buttons and middle click (with a veto), the neighbour that is selected after a
// close, dragging tabs to new places, many tabs (scroll arrows, the list of tabs), right click, two themes
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.TabBar* tabs;
gui.Window* w;
gcode.Look* look;
int selects = 0;
int closes = 0;
int veto = 0;
int contexts = 0;
int moves = 0;

int onSelect(int b) { selects++; return 0; }
int onClose(int b) { closes++; return veto; }
int onContext(int b) { contexts++; return 0; }
int onMove(int b) { moves++; return 0; }

void show(char* label) {
    printf("%s:", label);
    for (int i = 0; i < tabs->tabCount(); i++) {
        printf(" %s%s%s", (i == tabs->selected) ? "[" : "", tabs->titleOf(i), (i == tabs->selected) ? "]" : "");
        if (tabs->isModified(i)) { printf("*"); }
    }
    printf("\n");
}

int main() {
    startServer(7347, "t247");
    w = d->createWindow("Tabs", 520, 420, 0);
    look = gcode.theLook();
    look->setThemeName("dark");
    tabs = new gcode.TabBar();
    tabs->onSelect = onSelect;
    tabs->onClose = onClose;
    tabs->onTabContext = onContext;
    tabs->onMove = onMove;
    gui.Box* col = gui.vbox(0, 0);
    col->add(tabs);
    gui.Spacer* sp = new gui.Spacer(1);
    sp->flex = 1;
    col->add(sp);
    w->setRoot(col);
    settle();
    show("empty");
    tabs->addTab("main.a", 1);
    tabs->addTab("util.a", 2);
    tabs->addTab("README.md", 3);
    settle();
    show("three tabs (the first is selected by itself)");
    printf("select events so far %d, data of tab 2: %d, index of data 3: %d\n", selects, tabs->dataOf(2), tabs->indexOfData(3));

    // clicking selects; clicking the selected tab again does not tell anyone
    int y = 14;
    clickWd(w, tabs, tabs->tabMiddleX(1), y);
    show("click on tab 2");
    clickWd(w, tabs, tabs->tabMiddleX(1), y);
    printf("clicked again: select events %d\n", selects);
    tabs->select(2);
    printf("select(2): selected %d, events %d\n", tabs->selected, selects);

    // the modified marker replaces the close button until the pointer is over it
    tabs->setModified(0, true);
    settle();
    show("main.a modified");
    int fg = look->col(atheme.Col.TabBarText);
    int cx = tabs->closeButtonX(0);
    printf("a dot where the close button is: %d\n", w->surf->get(cx, 14 + 1) == fg);
    moveWd(w, tabs, cx, 15);
    printf("a lighter square behind the cross when the pointer is over it: %d\n", w->surf->get(cx - 6, 14 + 1) != look->col(atheme.Col.TabBar));
    moveWd(w, tabs, 300, 60);

    // the close button asks onClose; a veto keeps the tab
    veto = 1;
    clickWd(w, tabs, tabs->closeButtonX(1), 15);
    show("close vetoed");
    printf("closes asked %d, index %d\n", closes, tabs->closeIndex);
    veto = 0;
    clickWd(w, tabs, tabs->closeButtonX(1), 15);
    show("util.a closed with its button");
    // closing the selected tab selects the one that moved into its place; closing one before it keeps the selection
    tabs->select(1);
    middleClickWd(w, tabs, tabs->tabMiddleX(0), 14);
    show("middle click closes main.a (README.md stays selected)");
    middleClickWd(w, tabs, tabs->tabMiddleX(0), 14);
    show("middle click on the last tab");
    printf("no tab: selected %d\n", tabs->selected);
    middleClickWd(w, tabs, 200, 14);
    printf("middle click on empty space does nothing: closes %d\n", closes);

    // dragging a tab to another place
    tabs->addTab("a.a", 11);
    tabs->addTab("b.a", 12);
    tabs->addTab("c.a", 13);
    tabs->addTab("d.a", 14);
    tabs->select(0);
    settle();
    int mx0 = tabs->tabMiddleX(0);
    int mx2 = tabs->tabMiddleX(2);
    dragWd(w, tabs, mx0, 14, mx2, 14);
    show("a.a dragged over b.a and c.a");
    printf("moves %d, selection follows the dragged tab: %d, data order", moves, tabs->selected);
    for (int i = 0; i < 4; i++) { printf(" %d", tabs->dataOf(i)); }
    printf("\n");
    tabs->moveTab(2, 0);
    show("moveTab(2, 0)");

    // right click selects the tab and tells onTabContext
    rightClickWd(w, tabs, tabs->tabMiddleX(3), 14);
    printf("right click: contexts %d, index %d, selected %d\n", contexts, tabs->contextIndex, tabs->selected);

    // many tabs: the arrows and the list
    while (tabs->tabCount() > 0) { tabs->removeTab(0); }
    for (int i = 1; i <= 14; i++) {
        char name[32];
        format(&name[0], 32, "module%d.a", i);
        tabs->addTab(&name[0], i);
    }
    settle();
    printf("overflowing: %d, content %d wide in %d\n", tabs->overflowing(), tabs->contentWidth(), tabs->w);
    tabs->select(13);
    settle();
    printf("selecting the last tab scrolls: scroll %d\n", tabs->scrollX > 0);
    int left = tabs->arrowX(0);
    int right = tabs->arrowX(1);
    int s0 = tabs->scrollX;
    clickWd(w, tabs, left, 14);
    printf("left arrow scrolls back: %d\n", tabs->scrollX < s0);
    clickWd(w, tabs, right, 14);
    printf("right arrow scrolls forward: %d\n", tabs->scrollX >= s0 - 1);
    wheelWd(w, tabs, 100, 14, 5);
    printf("wheel up scrolls back: scroll %d\n", tabs->scrollX);
    // the list: Down moves to the first item, Enter picks it
    clickWd(w, tabs, tabs->arrowX(2), 14);
    printf("the list of tabs is open: %d\n", w->popup != null);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    show("third item of the list picked");
    printf("selected tab is in view: %d\n", tabs->tabLeft(tabs->selected) >= tabs->scrollX);

    // long titles are cut
    tabs->addTab("a_very_long_file_name_that_does_not_fit_in_a_tab.a", 99);
    printf("a long title takes 200 pixels: %d\n", tabs->tabWidth(tabs->tabCount() - 1));

    // pictures
    while (tabs->tabCount() > 0) { tabs->removeTab(0); }
    tabs->addTab("main.a", 1);
    tabs->addTab("util.a", 2);
    tabs->addTab("notes.md", 3);
    tabs->setModified(1, true);
    tabs->select(0);
    moveWd(w, tabs, 300, 60);
    printf("dark screenshot %u\n", shot(w));
    look->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    look->setThemeName("dark");
    return 0;
}
