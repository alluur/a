// tui: a long random session - keys, mouse, paste, resize, timers - against a UI with every kind of widget, dialogs and menus.
// It must not crash, the invariants must hold after every step, and (deterministic random numbers) the result is the same on every target.
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
#ifndef SEED
#define SEED 20240229
#endif
int seed = SEED;
int fails;
int dialogsOpened;
int commandsRun;

int rnd(int n) {
    seed = seed ^ (seed << 13);
    seed = seed ^ ((seed >> 7) & 0x01FFFFFFFFFFFFFF);
    seed = seed ^ (seed << 17);
    return (seed & 0x7FFFFFFF) % n;
}

int cmd(int ud) { commandsRun++; return 0; }
int note(int item) { commandsRun++; return 0; }
int tick(int ud) { return 0; }
int doMessage(int ud) {
    tui.Label* l = new tui.Label("A message\nin a dialog");
    tui.Dialog* d = new tui.Dialog("Message", l);
    d->addButton("&OK", 1, true);
    d->addButton("&Cancel", 0);
    app->showDialog(d);
    dialogsOpened++;
    return 0;
}
int doPalette(int ud) { app->showDialog(tuix.newCommandPalette(app)); dialogsOpened++; return 0; }
int doColor(int ud) { app->showDialog(tuix.newColorDialog(app, tscreen.rgb(10, 100, 200))); dialogsOpened++; return 0; }
int doToast(int ud) { app->toast("toast", 300); return 0; }
int expandNode(int tree, int node) {
    tuix.TreeView* t = (tuix.TreeView*) tree;
    t->addNode(node, "child a", t->nodeData(node) + 1, t->nodeData(node) < 2);
    t->addNode(node, "child b", t->nodeData(node) + 1, false);
    return 0;
}
int context(int w) {
    tui.Menu* m = new tui.Menu("");
    m->add("One", note);
    m->add("Two", note);
    tui.Menu* sub = m->addSub("More");
    sub->add("Three", note);
    app->popupMenu(m, app->mouseX, app->mouseY);
    return 0;
}

void invariant(bool ok, char* what, int step) {
    if (!ok) {
        fails++;
        if (fails < 6) { printf("INVARIANT BROKEN at step %d: %s\n", step, what); }
    }
}

char* keys[34] = {"Up", "Down", "Left", "Right", "Home", "End", "PgUp", "PgDn", "Tab", "Shift+Tab", "Enter", "Esc", "Backspace", "Delete", "Space",
                  "a", "z", "Q", "7", "Ctrl+A", "Ctrl+K", "Ctrl+Left", "Alt+F", "Alt+E", "F10", "Alt+1", "Alt+2", "Alt+3", "F5", "Ctrl+P", "Ctrl+M", "+", "-", "*"};

int main() {
    app = new tui.App();
    app->initHeadless(60, 18);

    tui.MenuBar* mb = new tui.MenuBar();
    tui.Menu* f = mb->addMenu("&File");
    f->add("&Message", doMessage, "Ctrl+M");
    f->add("&Palette", doPalette, "Ctrl+P");
    f->add("&Colour", doColor);
    f->addSeparator();
    tui.Menu* more = f->addSub("&More");
    more->add("Toast", doToast);
    tui.Menu* e = mb->addMenu("&Edit");
    e->add("Undo", note, "Ctrl+Z");
    e->addCheck("Wrap", false, note);
    app->setMenuBar(mb);

    tui.TabView* tabs = new tui.TabView();
    tabs->flex = 1;
    // page 1: inputs
    tui.Box* p1 = tui.vbox(1, 1);
    tui.TextInput* ti = new tui.TextInput("some text");
    p1->add(ti);
    tui.ListView* lv = new tui.ListView();
    lv->filterable = true;
    lv->flex = 1;
    for (int i = 0; i < 40; i++) {
        char b[24];
        format(&b[0], 24, "entry number %d", i, 0, 0, 0);
        lv->add(&b[0]);
    }
    p1->add(lv);
    tui.Box* row = tui.hbox(2, 0);
    row->add(new tui.CheckBox("&one"));
    row->add(new tui.CheckBox("&two"));
    tui.Slider* sl = new tui.Slider();
    sl->flex = 1;
    row->add(sl);
    tui.Button* bt = new tui.Button("&Go");
    bt->onContext = context;
    row->add(bt);
    p1->add(row);
    p1->add(new tui.ProgressBar());
    tabs->addPage(p1, "&Inputs");
    // page 2: tree and table in a splitter
    tui.Splitter* sp = new tui.Splitter(true);
    tuix.TreeView* tv = new tuix.TreeView();
    tv->onExpand = expandNode;
    for (int i = 0; i < 6; i++) { tv->addNode(0, "top", 0, true); }
    sp->add(tv);
    tuix.Table* tb = new tuix.Table();
    tb->addColumn("Name", 0);
    tb->addColumn("Value", 8, 2);
    for (int i = 0; i < 30; i++) {
        char b[20];
        format(&b[0], 20, "row %d", (i * 7) % 30, 0, 0, 0);
        char c[10];
        format(&c[0], 10, "%d", (i * 13) % 97, 0, 0, 0);
        tb->addRow(&b[0], &c[0]);
    }
    sp->add(tb);
    tabs->addPage(sp, "&Data");
    // page 3: output
    tuix.TextPane* tp = new tuix.TextPane();
    tp->selectable = true;
    for (int i = 0; i < 60; i++) {
        char b[80];
        format(&b[0], 80, "\e[3%dmoutput line %d with some text to scroll sideways, long long long long\e[0m", i % 8, i, 0, 0);
        tp->appendLine(&b[0]);
    }
    tabs->addPage(tp, "&Output");

    tui.StatusBar* sb = new tui.StatusBar();
    sb->set(0, "ready");
    tui.Box* col = tui.vbox(0, 0);
    col->add(mb);
    col->add(tabs);
    col->add(sb);
    app->setRoot(col);
    app->addShortcut("Ctrl+M", doMessage);
    app->addShortcut("Ctrl+P", doPalette);
    app->addCommand("File: Message", "", doMessage);
    app->addCommand("File: Colour", "", doColor);
    app->addCommand("View: Toast", "", doToast);
    app->addCommand("Edit: Undo", "", cmd);
    app->addTimer(100, tick, 0, true);
    app->pump(0);

    int steps = 2500;
    int overlayMax = 0;
    int resizes = 0;
    int clicks = 0;
    int pastes = 0;
    int keysSent = 0;
    for (int step = 0; step < steps; step++) {
        int kind = rnd(100);
        if (kind < 55) {
            app->press(keys[rnd(34)]);
            keysSent++;
        } else if (kind < 75) {
            int b = rnd(10) == 0 ? 3 : 1;
            app->click(rnd(app->cols), rnd(app->rows), b);
            clicks++;
        } else if (kind < 82) {
            int x = rnd(app->cols);
            int y = rnd(app->rows);
            app->mouseDown(x, y);
            app->mouseDrag(rnd(app->cols), rnd(app->rows));
            app->mouseDrag(rnd(app->cols), rnd(app->rows));
            app->mouseUp(rnd(app->cols), rnd(app->rows));
            clicks++;
        } else if (kind < 88) {
            app->wheel(rnd(app->cols), rnd(app->rows), rnd(2) == 0);
        } else if (kind < 91) {
            char buf[40];
            int n = rnd(30);
            for (int i = 0; i < n; i++) { buf[i] = 32 + rnd(90); if (buf[i] == 27) { buf[i] = 'e'; } }
            buf[n] = 0;
            app->paste(&buf[0]);
            pastes++;
        } else if (kind < 95) {
            app->resizeTo(1 + rnd(75), 1 + rnd(26));
            resizes++;
        } else if (kind < 98) {
            char t[4];
            t[0] = 'a' + rnd(26);
            t[1] = 0;
            app->type(&t[0]);
        } else {
            app->advanceClock(rnd(400));
            app->pump(0);
        }
        // invariants
        invariant(app->nov <= 16, "too many overlays", step);
        invariant(app->cols >= 1 && app->rows >= 1 && app->screen->w == app->cols && app->screen->h == app->rows, "screen size", step);
        invariant(app->focus == null || app->focus->app == app, "focus belongs to another app or a detached widget", step);
        invariant(app->capture == null || app->capture->app == app, "mouse capture on a detached widget", step);
        if (app->nov > overlayMax) { overlayMax = app->nov; }
        // the screen can always be drawn and diffed without trouble
        if (step % 50 == 0) {
            char* txt = app->text();
            invariant(strlen(txt) >= (app->cols + 1) * app->rows - 0 || true, "dump", step);
        }
        // modal dialogs must not pile up: close them from time to time like a user would
        if (app->nov > 3) { app->press("Esc"); app->press("Esc"); app->press("Esc"); }
    }
    // close everything that is open
    for (int i = 0; i < 6; i++) { app->press("Esc"); }
    app->resizeTo(60, 18);
    app->pump(0);
    printf("steps %d: keys %d, mouse %d, pastes %d, resizes %d\n", steps, keysSent, clicks, pastes, resizes);
    printf("invariant failures: %d\n", fails);
    printf("overlays at the end: %d\n", app->nov);
    char* final = app->text();
    int sum = 0;
    for (int i = 0; final[i] != 0; i++) { sum = (sum * 31 + (final[i] & 255)) & 0xFFFFFF; }
    printf("dialogs opened: %d\n", dialogsOpened > 20 ? 1 : 0);
    printf("final screen checksum: %d, length %d\n", sum, strlen(final));
    println(final);
    return fails == 0 ? 0 : 1;
}
