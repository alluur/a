// ds: DisjointSet (union-find) and BitSet against brute force models
import cstdio;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 2024;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// ---- DisjointSet against a label array ------------------------------------------------------------------------------------------------
const N = 400;
int label[N + 100];

void dsu() {
    ds.DisjointSet d(N);
    for (int i = 0; i < N; i++) { label[i] = i; }
    int groups = N;
    int bad = 0;
    for (int op = 0; op < 3000; op++) {
        int a = rnd(N);
        int b = rnd(N);
        int what = rnd(10);
        if (what < 4) {
            bool joined = d.unite(a, b);
            bool model = label[a] != label[b];
            if (model) {
                int from = label[b];
                int to = label[a];
                for (int i = 0; i < N; i++) { if (label[i] == from) { label[i] = to; } }
                groups--;
            }
            if (joined != model) { bad++; }
        } else if (what < 8) {
            if (d.same(a, b) != (label[a] == label[b])) { bad++; }
        } else {
            int want = 0;
            for (int i = 0; i < N; i++) { if (label[i] == label[a]) { want++; } }
            if (d.sizeOf(a) != want) { bad++; }
            if ((d.find(a) == d.find(b)) != (label[a] == label[b])) { bad++; }
        }
        if (d.groups != groups) { bad++; }
    }
    check(bad == 0, "random unions and queries agree with a label array");
    int out[N];
    int g = d.labels(&out[0]);
    bool ok = g == groups;
    for (int i = 0; i < N && ok; i++) {
        for (int j = i + 1; j < N; j += 37) { if ((out[i] == out[j]) != (label[i] == label[j])) { ok = false; } }
        if (out[i] < 0 || out[i] >= g) { ok = false; }
    }
    check(ok, "labels number the sets 0 ... groups - 1");
    // numbering by first appearance
    int firstSeen = -1;
    bool order = true;
    for (int i = 0; i < N; i++) {
        if (out[i] > firstSeen + 1) { order = false; }
        if (out[i] > firstSeen) { firstSeen = out[i]; }
    }
    check(order, "labels are numbered in order of the first element");
    // add elements
    int first = d.add();
    int second = d.add();
    check(first == N && second == N + 1 && d.count() == N + 2 && d.groups == groups + 2 && d.sizeOf(first) == 1, "add");
    int before3 = d.sizeOf(3);
    check(d.unite(first, 3) && d.same(first, 3) && d.sizeOf(3) == before3 + 1 && d.groups == groups + 1, "an added element joins a set");
    // bad numbers
    check(d.find(-1) == -1 && d.find(100000) == -1 && !d.unite(-1, 2) && !d.unite(2, 100000) && !d.same(-1, -1) && d.sizeOf(-5) == 0, "numbers out of range");
    // a long chain: no recursion, path compression keeps it fast
    ds.DisjointSet chain(300000);
    for (int i = 1; i < 300000; i++) { chain.unite(i - 1, i); }
    check(chain.groups == 1 && chain.sizeOf(0) == 300000 && chain.same(0, 299999), "a chain of 300000 unions");
    // growing from nothing
    ds.DisjointSet g0;
    for (int i = 0; i < 5000; i++) { g0.add(); }
    for (int i = 0; i < 5000; i += 2) { g0.unite(i, (i + 2) % 5000); }
    check(g0.count() == 5000 && g0.groups == 2501 && g0.sizeOf(0) == 2500, "a set grown with add()");
    d.dispose(); chain.dispose(); g0.dispose();
    check(d.count() == 0 && d.groups == 0 && d.find(0) == -1, "a disposed set is empty");
    ds.DisjointSet empty(0);
    check(empty.count() == 0 && empty.add() == 0 && empty.find(0) == 0, "an empty set that grows");
    empty.dispose();
}

// ---- BitSet against a bool array -----------------------------------------------------------------------------------------------------
const BITS = 333;
bool model[BITS + 10];

int modelCount(int lo, int hi) {
    int c = 0;
    for (int i = lo; i < hi && i < BITS; i++) { if (i >= 0 && model[i]) { c++; } }
    return c;
}

void bitset() {
    ds.BitSet b(BITS);
    int bad = 0;
    for (int op = 0; op < 20000; op++) {
        int what = rnd(100);
        int i = rnd(BITS + 4) - 2;               // includes out of range
        if (what < 25) {
            b.set(i);
            if (i >= 0 && i < BITS) { model[i] = true; }
        } else if (what < 40) {
            b.unset(i);
            if (i >= 0 && i < BITS) { model[i] = false; }
        } else if (what < 50) {
            b.flip(i);
            if (i >= 0 && i < BITS) { model[i] = !model[i]; }
        } else if (what < 58) {
            int lo = rnd(BITS + 20) - 10;
            int hi = lo + rnd(150);
            bool v = rnd(2) == 0;
            b.setRange(lo, hi, v);
            for (int k = lo; k < hi; k++) { if (k >= 0 && k < BITS) { model[k] = v; } }
        } else if (what < 70) {
            int lo = rnd(BITS + 20) - 10;
            int hi = lo + rnd(200) - 10;
            if (b.countRange(lo, hi) != modelCount(lo, hi)) { bad++; }
        } else if (what < 80) {
            int from = rnd(BITS + 6) - 3;
            int want = -1;
            for (int k = (from < 0 ? 0 : from); k < BITS; k++) { if (model[k]) { want = k; break; } }
            if (b.nextSet(from) != want) { bad++; }
            want = -1;
            for (int k = (from < 0 ? 0 : from); k < BITS; k++) { if (!model[k]) { want = k; break; } }
            if (b.nextClear(from) != want) { bad++; }
            want = -1;
            for (int k = (from >= BITS ? BITS - 1 : from); k >= 0; k--) { if (model[k]) { want = k; break; } }
            if (b.prevSet(from) != want) { bad++; }
        } else if (what < 90) {
            if (b.get(i) != (i >= 0 && i < BITS && model[i])) { bad++; }
        } else if (what < 93) {
            b.clearAll();
            for (int k = 0; k < BITS; k++) { model[k] = false; }
        } else if (what < 94) {
            b.setAll();
            for (int k = 0; k < BITS; k++) { model[k] = true; }
        } else {
            if (b.count() != modelCount(0, BITS) || b.isEmpty() != (modelCount(0, BITS) == 0)) { bad++; }
        }
    }
    check(bad == 0, "random operations agree with a bool array");
    int out[BITS];
    int n = b.toArray(&out[0], BITS);
    bool same = n == modelCount(0, BITS);
    int at = 0;
    for (int k = 0; k < BITS && same; k++) { if (model[k]) { if (out[at] != k) { same = false; } at++; } }
    check(same, "toArray");
    check(b.toArray(&out[0], 3) <= 3, "toArray respects max");
    b.dispose();
}

void setOps() {
    ds.BitSet a(130);
    ds.BitSet b(130);
    ds.BitSet c(70);
    for (int i = 0; i < 130; i += 2) { a.set(i); }
    for (int i = 0; i < 130; i += 3) { b.set(i); }
    for (int i = 0; i < 70; i++) { c.set(i); }
    ds.BitSet u(130);
    u.copyFrom(&a);
    check(u.equals(&a) && u.size() == 130, "copyFrom and equals");
    u.orWith(&b);
    int cnt = 0;
    for (int i = 0; i < 130; i++) { if (i % 2 == 0 || i % 3 == 0) { cnt++; } }
    check(u.count() == cnt, "or");
    u.copyFrom(&a);
    u.andWith(&b);
    cnt = 0;
    for (int i = 0; i < 130; i++) { if (i % 6 == 0) { cnt++; } }
    check(u.count() == cnt && u.isSubsetOf(&a) && u.isSubsetOf(&b) && !a.isSubsetOf(&u), "and and subset");
    u.copyFrom(&a);
    u.xorWith(&b);
    cnt = 0;
    for (int i = 0; i < 130; i++) { if ((i % 2 == 0) != (i % 3 == 0)) { cnt++; } }
    check(u.count() == cnt, "xor");
    u.copyFrom(&a);
    u.andNotWith(&b);
    cnt = 0;
    for (int i = 0; i < 130; i++) { if (i % 2 == 0 && i % 3 != 0) { cnt++; } }
    check(u.count() == cnt && cnt > 0 && !u.intersects(&b) && a.intersects(&b), "and not and intersects");
    // different sizes: the size of the left set stays
    u.copyFrom(&a);
    u.andWith(&c);
    check(u.size() == 130 && u.count() == 35 && u.nextSet(70) == -1, "and with a smaller set");
    u.copyFrom(&c);
    u.resize(130);
    u.orWith(&a);
    check(u.size() == 130 && u.count() == 70 + 30, "or with a bigger set on a resized copy");
    ds.BitSet small(5);
    small.setAll();
    small.orWith(&a);
    check(small.size() == 5 && small.count() == 5 && small.nextSet(5) == -1, "no bits beyond the size appear");
    small.xorWith(&b);
    check(small.count() == 3 && !small.get(0) && !small.get(3) && small.get(4) && small.nextSet(5) == -1, "xor on a short set stays inside");
    // resize keeps bits and zero fills
    ds.BitSet r(10);
    r.setAll();
    r.resize(200);
    check(r.count() == 10 && r.size() == 200 && !r.get(10) && !r.get(199), "growing adds zero bits");
    r.setAll();
    r.resize(70);
    check(r.count() == 70, "shrinking keeps the first bits");
    r.resize(200);
    check(r.count() == 70 && !r.get(100), "bits that were cut off do not come back");
    r.resize(0);
    check(r.size() == 0 && r.count() == 0 && r.isEmpty() && r.nextSet(0) == -1 && r.prevSet(5) == -1, "size 0");
    ds.BitSet z;
    check(z.size() == 0 && !z.get(0) && z.count() == 0 && z.resize(65) && z.size() == 65, "a zeroed BitSet grows");
    z.set(64);
    check(z.get(64) && z.prevSet(64) == 64 && z.nextClear(64) == -1, "bit 64");
    // the highest bit of a word
    ds.BitSet w(128);
    w.set(63); w.set(127);
    check(w.nextSet(0) == 63 && w.nextSet(64) == 127 && w.prevSet(126) == 63 && w.prevSet(127) == 127 && w.count() == 2, "bits 63 and 127");
    w.setRange(0, 128);
    check(w.count() == 128 && w.nextClear(0) == -1, "full set");
    w.clearRange(10, 120);
    check(w.count() == 18 && w.nextClear(0) == 10 && w.nextSet(10) == 120, "clearRange");
    a.dispose(); b.dispose(); c.dispose(); u.dispose(); small.dispose(); r.dispose(); z.dispose(); w.dispose();
}

void big() {
    // a sieve on a BitSet: no quadratic behaviour with 2 million bits
    int limit = 2000000;
    ds.BitSet s(limit + 1);
    s.setAll();
    s.unset(0); s.unset(1);
    for (int i = 2; i * i <= limit; i++) {
        if (s.get(i)) { for (int j = i * i; j <= limit; j = j + i) { s.unset(j); } }
    }
    check(s.count() == 148933, "primes below 2 million with a BitSet");
    int p = s.nextSet(1999000);
    check(p == 1999007 && s.prevSet(1999002) == 1998991, "next / previous prime");
    s.dispose();
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.DisjointSet d(100000);
    ds.BitSet b(100000);
    for (int i = 1; i < 100000; i++) { d.unite(i - 1, i); b.set(i); }
    d.dispose();
    b.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees everything");
}

int main() {
    dsu();
    bitset();
    setOps();
    big();
    memory();
    printf("disjoint set and bit set: %d checks, %d failures\n", checks, fails);
    return fails;
}
