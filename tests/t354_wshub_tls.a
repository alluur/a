import wshub;
import websocket;
import http;
import net;
import tls;
import x509;
import conn;

int fails = 0;

void check(char* name, bool ok) {
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

wshub.Hub* hub;

int onMessage(wshub.Hub* h, wshub.Client* c, char* data, int n, int isText) {
    if (isText != 0) {
        char* t = alloc(n + 8);
        format(t, n + 8, "tls %s", data);
        h->sendText(c, t);
    } else {
        h->sendBinary(c, data, n);
    }
    return 0;
}

int hook() {
    hub->poll(0);
    return 0;
}

void settle() {
    for (int i = 0; i < 20; i++) hub->poll(0);
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    tls.Config* stranger = tls.loadConfig(STRANGER_CERT, STRANGER_KEY);
    check("the test certificates load", good != null && stranger != null);
    hub = new wshub.Hub();
    hub->onMessage = onMessage;
    hub->staticDir = "build/tests";
    check("listen with TLS", hub->listenTls(0, good));
    net.setIdleHook(hook);
    int port = hub->port;
    char* u = alloc(100);
    format(u, 100, "wss://127.0.0.1:%d/secure", port);

    // --- wss with a certificate that a trusted CA signed
    websocket.setVerify(true);
    websocket.WebSocket* a = websocket.connect(u);
    check("wss connect: the certificate is verified against the CA", a != null);
    if (a == null) { println(websocket.error()); return 1; }
    a->sendText("hello");
    websocket.Message* m = a->receiveMessage();
    check("text over TLS", m != null && streq(m->data, "tls hello"));
    m->dispose();
    char* big = alloc(200000);
    for (int i = 0; i < 200000; i++) big[i] = i * 13;
    a->sendBinary(big, 200000);
    m = a->receiveMessage();
    check("200000 bytes over TLS and back", m != null && m->length == 200000 && memcmp(m->data, big, 200000) == 0);
    m->dispose();
    // the encrypted queue of a client works for broadcasts too
    hub->broadcastText("from the hub");
    m = a->receiveMessage();
    check("a broadcast reaches a TLS client", m != null && streq(m->data, "from the hub"));
    m->dispose();
    // two clients at once
    websocket.WebSocket* b = websocket.connect(u);
    check("a second TLS client", b != null && hub->count() == 2);
    b->sendText("two");
    m = b->receiveMessage();
    check("... works independently", m != null && streq(m->data, "tls two"));
    m->dispose();
    check("the first is unaffected", a->sendText("one") && streq(a->receiveMessage()->data, "tls one"));
    b->closeWith(1000, "bye");
    settle();
    check("close handshake over TLS", b->closed && b->closeCode == 1000);
    b->dispose();
    a->closeWith(1000, null);
    settle();
    a->dispose();
    check("both gone", hub->count() == 0);

    // --- the checks that must fail
    x509.clearRoots();
    websocket.WebSocket* c = websocket.connect(u);
    check("without a trusted CA the connection is refused", c == null && websocket.error() != null && strlen(websocket.error()) > 5);
    println(websocket.error());
    websocket.setVerify(false);
    c = websocket.connect(u);
    check("with verification off it works", c != null);
    c->closeWith(1000, null); settle(); c->dispose();
    websocket.Options* strict = new websocket.Options();
    strict->verify = true;
    check("Options.verify overrides the module setting", websocket.connectWith(u, strict) == null);
    x509.addRootPem(CA_PEM);
    websocket.setVerify(true);
    c = websocket.connect(u);
    check("after the CA is trusted again it works", c != null);
    c->closeWith(1000, null); settle(); c->dispose();
    hub->shutdown(100);

    // --- a server whose certificate comes from an unknown CA
    hub = new wshub.Hub();
    hub->onMessage = onMessage;
    hub->listenTls(0, stranger);
    format(u, 100, "wss://127.0.0.1:%d/", hub->port);
    websocket.WebSocket* refused = websocket.connect(u);
    char* err = websocket.error();
    check("a certificate of an unknown CA is refused", refused == null && (contains(err, "authority") || contains(err, "trusted") || contains(err, "self")));
    println(err);
    websocket.setVerify(false);
    c = websocket.connect(u);
    check("... unless verification is off", c != null);
    c->closeWith(1000, null); settle(); c->dispose();
    websocket.setVerify(true);
    hub->shutdown(100);

    // --- https through the same hub
    hub = new wshub.Hub();
    hub->onMessage = onMessage;
    hub->staticDir = "build/tests";
    hub->listenTls(0, good);
    port = hub->port;
    char* hu = alloc(100);
    format(hu, 100, "https://127.0.0.1:%d/healthz", port);
    http.setVerify(true);
    http.Response* r = http.get(hu);
    check("https GET /healthz", r != null && r->status == 200 && contains(r->body, "\"status\":\"ok\""));
    format(hu, 100, "https://127.0.0.1:%d/nothing", port);
    r = http.get(hu);
    check("https 404", r != null && r->status == 404);
    // several requests in a row, the sessions are reused by the hub
    int okCount = 0;
    format(hu, 100, "https://127.0.0.1:%d/healthz", port);
    for (int i = 0; i < 4; i++) {
        r = http.get(hu);
        if (r != null && r->status == 200) okCount++;
    }
    check("four more requests", okCount == 4);

    // --- clients that do not speak TLS
    conn.Connection* plain = conn.open("127.0.0.1", port, 1000);
    plain->writeText("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
    plain->flush();
    for (int i = 0; i < 20; i++) hub->poll(0);
    check("plain HTTP on the TLS port: the connection is dropped, counted as a TLS failure", hub->stats->tlsFailures >= 1);
    plain->close();
    hub->handshakeTimeoutMs = 100;
    conn.Connection* silent = conn.open("127.0.0.1", port, 1000);
    int t0 = millis();
    while (millis() - t0 < 300) hub->poll(10);
    check("a client that never starts the handshake is dropped", hub->stats->timeouts >= 1 && hub->count() == 0);
    silent->close();
    net.setIdleHook(null);
    hub->shutdown(100);
    printf("failures: %d\n", fails);
    return fails;
}
