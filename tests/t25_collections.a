import collections;
import sort;

int main() {
    collections.IntList* l = new collections.IntList();
    for (int i = 0; i < 100; i++) l->push(i * 3);
    printlnInt(l->size()); printlnInt(l->get(50)); printlnInt(l->get(500)); printlnInt(l->last());
    printlnInt(l->pop()); printlnInt(l->size());
    l->insert(0, -1); l->insert(5, 777);
    printlnInt(l->get(0)); printlnInt(l->get(5)); printlnInt(l->get(6));
    printlnInt(l->removeAt(5)); printlnInt(l->get(5));
    printlnInt(l->indexOf(30)); printBool(l->has(31)); println("");
    l->set(1, 1000); printlnInt(l->get(1));
    l->reverse(); printlnInt(l->get(0)); printlnInt(l->last());
    sort.sortInts(l->items(), l->size());
    printlnInt(l->get(0)); printlnInt(l->get(1));
    l->clear(); printBool(l->isEmpty()); println("");

    collections.StrList* sl = new collections.StrList();
    sl->push("one"); sl->push("two"); sl->push("three");
    printlnInt(sl->size()); println(sl->get(1)); printBool(sl->get(9) == null); println("");
    printlnInt(sl->indexOf("three")); println(sl->pop()); printlnInt(sl->size());

    collections.StrMap* m = new collections.StrMap();
    char key[32];
    for (int i = 0; i < 1000; i++) { format(&key[0], 32, "key%d", i, 0, 0, 0); m->put(key, i * 2); }
    printlnInt(m->size()); printlnInt(m->get("key0", -1)); printlnInt(m->get("key999", -1)); printlnInt(m->get("nope", -1));
    m->put("key5", 55); printlnInt(m->get("key5", -1)); printlnInt(m->size());
    printBool(m->has("key7")); printBool(m->remove("key7")); printBool(m->has("key7")); printBool(m->remove("key7")); println("");
    printlnInt(m->size());
    int removed = 0;
    for (int i = 0; i < 1000; i += 2) { format(&key[0], 32, "key%d", i, 0, 0, 0); if (m->remove(key)) removed++; }
    printlnInt(removed); printlnInt(m->size());
    bool ok = true;
    for (int i = 1; i < 1000; i += 2) {
        format(&key[0], 32, "key%d", i, 0, 0, 0);
        if (i == 7) { if (m->has(key)) ok = false; }
        else if (i == 5) { if (m->get(key, -1) != 55) ok = false; }
        else if (m->get(key, -1) != i * 2) ok = false;
    }
    printBool(ok); println("");
    int total = 0;
    for (int s = 0; s < m->capacity(); s++) { if (m->keyAt(s) != null) total = total + m->valueAt(s); }
    printlnInt(total);

    collections.IntMap* im = new collections.IntMap();
    for (int i = 0; i < 2000; i++) im->put(i * 7919 - 5000, i);
    printlnInt(im->size()); printlnInt(im->get(7919 * 100 - 5000, -1)); printlnInt(im->get(1, -1));
    for (int i = 0; i < 2000; i += 3) im->remove(i * 7919 - 5000);
    printlnInt(im->size());
    ok = true;
    for (int i = 0; i < 2000; i++) {
        bool expectPresent = i % 3 != 0;
        if (im->has(i * 7919 - 5000) != expectPresent) ok = false;
        if (expectPresent && im->get(i * 7919 - 5000, -1) != i) ok = false;
    }
    printBool(ok); println("");
    return 0;
}
