// Generated by tests/gen/gen_regex_test.py from Python's re module: every case is run by lib/regex.a and the
// result (search positions in bytes with groups, fullmatch, sub) must equal what Python printed. Do not edit by hand.
import regex;

void esc(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == 10) { print("\\n"); }
        else if (s[i] == 9) { print("\\t"); }
        else if (s[i] == 92) { print("\\\\"); }
        else { printChar(s[i]); }
    }
}

void runCase(int i, char* pat, char* text) {
    regex.Regex* re = regex.compile(pat, 0);
    if (!re->ok) { printf("%d ERR\n", i); return; }
    int n = strlen(text);
    int caps[66];
    int at = re->search(text, n, 0, &caps[0]);
    printf("%d ", i);
    if (at < 0) { print("-"); }
    else {
        for (int g = 0; g <= re->groups; g++) {
            if (g > 0) { print(";"); }
            if (caps[2 * g] < 0) { print("-"); } else { printf("%d,%d", caps[2 * g], caps[2 * g + 1]); }
        }
    }
    int caps2[66];
    printf(" F%d R<", re->matchFull(text, n, &caps2[0]) ? 1 : 0);
    char* r = regex.replaceGroups(pat, text, "[$0|$1]");
    esc(r);
    print(">\n");
    re->dispose();
}

