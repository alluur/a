// gcode.CodeEditor with big texts: 100 000 lines scroll, jump and take input while only the visible lines are drawn and lexed;
// one very long line; memory goes back after the document is replaced
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import afind;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;

int main() {
    gcode.theLook()->autoComplete = false;      // no popup while typing: keys such as Enter keep their meaning
    startServer(7343, "t243");
    w = d->createWindow("Editor", 480, 260, 0);
    gcode.Look* look = gcode.theLook();
    look->blink = false;
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    settle();

    // 100 000 lines of A code (a block of ten lines, 10 000 times)
    char* block = "int f(int a) {\n    // comment number\n    char* s = \"text\";\n    for (int i = 0; i < 10; i++) {\n        a = a + i;\n    }\n    /* a block\n       comment */\n    return a;\n}\n";
    int bl = strlen(block);
    char* big = (char*) asys.alloc(bl * 10000 + 16);
    for (int i = 0; i < 10000; i++) { memcpy(&big[i * bl], block, bl); }
    big[bl * 10000] = 0;
    e->setText(big);
    e->doc->setLanguage(asyntax.Lang.A);
    asys.free(big);
    settle();
    printf("lines %d, bytes %d\n", e->buf->lineCount(), e->buf->length());
    printf("gutter wide enough for six digits: %d\n", e->gutterWidth() >= 16 + 6 * e->cellWidth());
    int lexed0 = e->doc->hl->linesLexed;
    printf("lines lexed to draw the first screen: %d\n", lexed0 < 100);

    // jump to the end and to the middle: only the visible lines are drawn
    key(adp.KEY_END, 0);
    keyMods(adp.KEY_END, 0, adp.MOD_CTRL);
    printf("ctrl+end: caret line %d, first line %d, last line %d\n", e->ed->caretLine(), e->firstLine(), e->lastLine());
    int lexed1 = e->doc->hl->linesLexed;
    e->gotoLine(49999, 4);
    settle();
    printf("goto 50000: caret line %d, first line %d\n", e->ed->caretLine(), e->firstLine());
    int lexed2 = e->doc->hl->linesLexed;
    printf("lines lexed by the jump to the middle: %d\n", lexed2 - lexed1 < 100);

    // typing in the middle of the text: one line is lexed again, not the file
    int before = e->doc->hl->linesLexed;
    int paints0 = e->paints();
    typeStr("abc");
    key(adp.KEY_ENTER, 13);
    typeStr("xyz");
    printf("typed 7 keys: lines lexed %d, repaints %d\n", e->doc->hl->linesLexed - before < 200, e->paints() - paints0 >= 1);
    char* t = e->buf->getLine(50000);
    printf("line 50001 now [%s]\n", t);
    asys.free(t);
    printf("lines %d\n", e->buf->lineCount());

    // a block comment that is opened re-lexes the lines until the state is the same again
    e->gotoLine(10, 0);
    settle();
    int before2 = e->doc->hl->linesLexed;
    typeStr("/*");
    printf("opening a comment at line 11: lexed %d lines (a few), tokens of line 13 are a comment: ", e->doc->hl->linesLexed - before2 < 2000);
    asyntax.Token tk[8];
    int nt = e->doc->hl->tokens(12, &tk[0], 8);
    printf("%d\n", nt > 0 && tk[0].kind == asyntax.Tok.Comment);
    ctrl('z');
    nt = e->doc->hl->tokens(12, &tk[0], 8);
    printf("after undo line 13 is not: %d\n", nt > 0 && tk[0].kind != asyntax.Tok.Comment);

    // undo and redo over many edits
    e->gotoLine(70000, 0);
    for (int i = 0; i < 15; i++) {
        typeStr("w");
        key(adp.KEY_ENTER, 13);
    }
    printf("lines after 15 enters: %d\n", e->buf->lineCount());
    for (int i = 0; i < 30; i++) { ctrl('z'); }
    printf("lines after 30 undos: %d\n", e->buf->lineCount());
    for (int i = 0; i < 30; i++) { ctrl('y'); }
    printf("lines after 30 redos: %d\n", e->buf->lineCount());

    // find highlights and word highlights only look at the visible lines
    e->setFindHighlight("comment", afind.OPT_ICASE);
    e->gotoLine(30000, 0);
    settle();
    int px = 0; int py = 0;
    int off = e->buf->lineStart(30001) + 7;
    bool vis = e->pointOfOffset(off, &px, &py);
    int p = w->surf->get(px - 4, py - 8);
    printf("find match is drawn in the middle of the text: %d\n", vis && p == look->col(atheme.Col.FindMatch));
    e->clearFindHighlight();

    // the scroll bar thumb of a long text moves to the right place
    e->setFirstLine(0);
    settle();
    int barX = e->w - 7;
    dragWd(w, e, barX, 5, barX, 5 + (e->h - 14) * 3 / 4);
    printf("thumb dragged towards the bottom: first line %d (past 70000 of 100017)\n", e->firstLine() > 70000 && e->firstLine() < 100017);

    // one very long line
    char* longLine = (char*) asys.alloc(100001);
    for (int i = 0; i < 100000; i++) { longLine[i] = 'a' + (i % 26); }
    longLine[100000] = 0;
    e->setText(longLine);
    asys.free(longLine);
    settle();
    key(adp.KEY_END, 0);
    printf("long line: caret %d, first column %d\n", e->ed->caret(), e->firstCol() > 99000);
    typeStr("Q");
    printf("after typing at the end: length %d, caret %d\n", e->buf->length(), e->ed->caret());
    key(adp.KEY_HOME, 0);
    printf("home: first column %d\n", e->firstCol());
    e->setWordWrap(true);
    settle();
    key(adp.KEY_END, 0);
    printf("with word wrap the last row of the line shows: first row %d of %d\n", e->firstSubRow() + e->visibleRows(), 100001 / e->columns() + 1);

    // replacing the document frees the memory
    e->setWordWrap(false);
    e->setText("small");
    settle();
    int mem0 = asys.memInUse();
    for (int round = 0; round < 3; round++) {
        char* chunk = (char*) asys.alloc(1000001);
        for (int i = 0; i < 1000000; i++) { chunk[i] = (i % 80 == 79) ? 10 : 'x'; }
        chunk[1000000] = 0;
        e->setText(chunk);
        asys.free(chunk);
        settle();
        e->gotoLine(10000, 0);
        typeStr("a");
        settle();
        e->setText("small");
        settle();
    }
    int mem1 = asys.memInUse();
    printf("memory after three big documents came and went: grew by less than 1 MB: %d\n", mem1 - mem0 < 1048576);
    return 0;
}
