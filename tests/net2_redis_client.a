import redis;
import cstdio;
// The redis client module run against a Redis server and against redisd with the same program: tests/net2.sh compares the two outputs (when redis-server is installed).
int main(int argc, char** argv) {
    int port = atoi(argv[1]);
    redis.Client* c;
    char url[64];
    sprintf(url, "redis://127.0.0.1:%d", port);
    c = redis.connect(url);
    if (c == null) { println(redis.error()); return 1; }
    c->flushAll();
    printf("ping %d\n", c->ping() ? 1 : 0);
    printf("set %d\n", c->set("greet", "hello") ? 1 : 0);
    char* v = c->get("greet"); printf("get %s\n", v); 
    printf("get missing %s\n", c->get("nokey") == null ? "(nil)" : "?");
    printf("incr %d %d\n", c->incr("n"), c->incrBy("n", 10));
    printf("append %d strlen %d\n", c->append("greet", " world"), c->strLength("greet"));
    printf("lpush %d rpush %d llen %d\n", c->lpush("L", "a"), c->rpush("L", "b"), c->llen("L"));
    redis.Reply* r = c->lrange("L", 0, -1);
    printf("lrange type %d count %d [%s,%s]\n", r->type, r->count, r->elems[0]->str, r->elems[1]->str); r->dispose();
    printf("hset %d\n", c->hset("H", "f", "v"));
    r = c->hgetall("H"); printf("hgetall %d %s %s\n", r->count, r->elems[0]->str, r->elems[1]->str); r->dispose();
    printf("zadd %d %d\n", c->zadd("Z", "1.5", "a"), c->zadd("Z", "2", "b"));
    r = c->zrange("Z", 0, -1, true); printf("zrange %d %s %s %s %s\n", r->count, r->elems[0]->str, r->elems[1]->str, r->elems[2]->str, r->elems[3]->str); r->dispose();
    printf("zscore %s\n", c->zscore("Z", "a"));
    // binary
    char bin[8]; bin[0]=0; bin[1]=13; bin[2]=10; bin[3]=255; bin[4]=36; bin[5]=0; bin[6]=65; bin[7]=10;
    printf("setBin %d\n", c->setBin("bin", &bin[0], 8) ? 1 : 0);
    int len = 0; char* b = c->getBin("bin", &len);
    printf("getBin len %d bytes %d %d %d %d %d\n", len, b[0], b[1], b[2], b[3], b[5]);
    // errors
    r = c->call("INCR", "greet"); printf("err type %d %s\n", r->type, r->str); r->dispose();
    r = c->call("NOSUCH"); printf("err type %d %s\n", r->type, r->str); r->dispose();
    // multi
    printf("multi %d\n", c->multi() ? 1 : 0);
    r = c->call("SET", "m", "1"); printf(" queued %s\n", r->str); r->dispose();
    r = c->call("INCR", "m"); r->dispose();
    r = c->exec(); printf("exec type %d count %d: %s %lld\n", r->type, r->count, r->elems[0]->str, r->elems[1]->num); r->dispose();
    // pipeline
    redis.Pipeline* p = redis.pipeline(c);
    p->add("SET", "p1", "x"); p->add("INCR", "p2"); p->add("GET", "p1"); p->add("LPUSH", "p3", "a", "b", "c");
    printf("pipeline run %d\n", p->run() ? 1 : 0);
    printf(" replies %s %lld %s %lld\n", p->reply(0)->str, p->reply(1)->num, p->reply(2)->str, p->reply(3)->num); p->dispose();
    // large value
    char* big = (char*) malloc(3000000);
    for (int i = 0; i < 3000000; i++) big[i] = 'a' + (i % 26);
    printf("setBin big %d\n", c->setBin("big", big, 3000000) ? 1 : 0);
    int bl = 0; char* gb = c->getBin("big", &bl); printf("big len %d ok %d\n", bl, (bl == 3000000 && memcmp(big, gb, 3000000) == 0) ? 1 : 0);
    // pubsub
    redis.PubSub* s = redis.pubsub(c);
    s->subscribe("news"); s->psubscribe("log.*");
    redis.Client* c2 = redis.connect(url);
    printf("publish receivers %d\n", c2->publish("news", "hello"));
    printf("publish receivers %d\n", c2->publish("log.x", "line"));
    redis.PubMessage* m = s->next(2000); printf("msg %s %s\n", m == null ? "null" : m->channel, m == null ? "" : m->data);
    m = s->next(2000); printf("msg %s %s\n", m == null ? "null" : m->channel, m == null ? "" : m->data);
    m = s->next(300); printf("msg %s\n", m == null ? "null (timeout)" : "?");
    printf("dbsize %d ttl %d expire %d ttl %d\n", c2->dbsize(), c2->ttl("greet"), c2->expire("greet", 100) ? 1 : 0, c2->ttl("greet"));
    s->dispose(); c2->dispose(); c->dispose();
    return 0;
}
