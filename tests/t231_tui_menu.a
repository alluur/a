// tui: MenuBar and PopupMenu - opening, keyboard, mnemonics, accelerators, submenus, check marks, disabled items, mouse, context menus
import tui;
import term;
import tscreen;

tui.App* app;
char last[80];

int act(int item) {
    tui.MenuItem* it = (tui.MenuItem*) item;
    char* t = it->text.str();
    int o = 0;
    char plain[60];
    for (int i = 0; t[i] != 0 && o < 58; i++) { if (t[i] != '&') { plain[o] = t[i]; o++; } }
    plain[o] = 0;
    format(&last[0], 80, "ran: %s", &plain[0], 0, 0, 0);
    return 0;
}

void screen(char* what) {
    printf("-- %s (%s)\n", what, last);
    println(app->text());
}

int main() {
    app = new tui.App();
    app->initHeadless(40, 12);
    tui.Box* col = tui.vbox(0, 0);
    tui.MenuBar* mb = new tui.MenuBar();
    tui.Menu* file = mb->addMenu("&File");
    file->add("&New", act, "Ctrl+N");
    tui.MenuItem* open = file->add("&Open...", act, "Ctrl+O");
    file->addSeparator();
    tui.MenuItem* ro = file->addCheck("&Read only", false, act);
    tui.Menu* recent = file->addSub("Re&cent");
    recent->add("one.a", act);
    recent->add("two.a", act);
    tui.Menu* more = recent->addSub("&More");
    more->add("deep.a", act);
    file->addSeparator();
    file->add("&Quit", act, "Ctrl+Q");
    tui.Menu* edit = mb->addMenu("&Edit");
    tui.MenuItem* cut = edit->add("Cu&t", act, "Ctrl+X");
    edit->add("&Copy", act, "Ctrl+C");
    edit->add("&Paste", act, "Ctrl+V");
    tui.Menu* help = mb->addMenu("&Help");
    help->add("&About", act, "F1");
    col->add(mb);
    tui.Label* body = new tui.Label("body text of the program");
    body->flex = 1;
    col->add(body);
    app->setMenuBar(mb);
    app->setRoot(col);
    app->pump(0);
    last[0] = 0;
    screen("closed");

    println("-- Alt+F opens, the first item is selected; Down moves, separators are skipped");
    app->press("Alt+F");
    screen("File open");
    printf("open: %d, selected item %d\n", mb->openIdx, mb->popup->sel);
    app->press("Down"); app->press("Down");
    printf("after two Down: %d (the separator is skipped: Read only)\n", mb->popup->sel);
    app->press("Down");
    app->press("Down");
    printf("after two more Down: %d (Quit), ", mb->popup->sel);
    app->press("Down");
    printf("wraps to the first: %d\n", mb->popup->sel);
    app->press("Up");
    printf("Up wraps to the last: %d\n", mb->popup->sel);
    app->press("Home");
    app->press("End");
    printf("Home / End: %d\n", mb->popup->sel);
    app->press("Esc");
    screen("Esc closes");

    println("-- Enter runs the selected item and closes the menu");
    app->press("F10");
    printf("F10 opens the first menu: %d\n", mb->openIdx);
    app->press("Down");
    app->press("Enter");
    screen("Open ran");
    printf("overlays left: %d\n", app->nov);

    println("-- Right and Left switch between menus");
    app->press("Alt+F");
    app->press("Right");
    printf("Right: menu %d\n", mb->openIdx);
    screen("Edit open");
    app->press("Right");
    app->press("Right");
    printf("Right wraps: menu %d\n", mb->openIdx);
    app->press("Left");
    printf("Left: menu %d\n", mb->openIdx);
    app->press("Esc");

    println("-- mnemonics inside a menu");
    app->press("Alt+E");
    app->press("p");
    screen("p = Paste");
    app->press("Alt+F");
    app->press("Q");
    screen("Q = Quit (upper case works too)");

    println("-- accelerators work without opening the menu");
    app->press("Ctrl+N");
    screen("Ctrl+N");
    app->press("Ctrl+X");
    screen("Ctrl+X");
    cut->enabled = false;
    last[0] = 0;
    app->press("Ctrl+X");
    screen("Ctrl+X on a disabled item does nothing");
    cut->enabled = true;

    println("-- check marks, disabled items and submenus");
    ro->checked = true;
    open->enabled = false;
    app->press("Alt+F");
    app->press("Down");
    printf("Open is disabled and the separator is skipped: %d (Read only)\n", mb->popup->sel);
    app->press("Down");
    printf("the submenu item: %d\n", mb->popup->sel);
    screen("check mark and disabled item");
    app->press("Right");
    screen("the Recent submenu next to it");
    app->press("Down"); app->press("Down");
    app->press("Right");
    screen("a submenu of a submenu");
    app->press("Left");
    printf("Left closes one level: %d overlay(s)\n", app->nov);
    app->press("Left");
    printf("Left closes the next one: %d overlay(s)\n", app->nov);
    app->press("Right");
    app->press("Enter");
    screen("Enter in a submenu runs the item and closes everything");
    printf("overlays left: %d\n", app->nov);
    open->enabled = true;
    println("-- choosing a check item flips it");
    app->press("Alt+F");
    app->press("Down"); app->press("Down");
    app->press("Enter");
    printf("Read only is now %d\n", ro->checked);

    println("-- mouse: click a title, click an item");
    app->click(2, 0);
    screen("clicked File");
    app->click(5, 5);
    screen("clicked the Read only item");
    printf("Read only is now %d\n", ro->checked);
    app->click(8, 0);
    app->click(8, 0);
    printf("a second click on the same title closes: menu %d\n", mb->openIdx);
    app->click(2, 0);
    app->click(30, 8);
    printf("a click outside closes: menu %d, overlays %d\n", mb->openIdx, app->nov);
    println("-- pressing, dragging onto an item and releasing picks it");
    app->mouseDown(2, 0);
    app->mouseDrag(5, 1);
    app->mouseDrag(5, 2);
    app->mouseUp(5, 2);
    screen("drag and release");
    println("-- hovering switches menus while one is open");
    app->press("Alt+F");
    char mv[32];
    format(&mv[0], 32, "\e[<35;%d;%dM", 9, 1, 0, 0);
    app->feed(&mv[0]);
    printf("moved over Edit: menu %d\n", mb->openIdx);
    app->press("Esc");

    println("-- F10 closes an open menu; keys that no menu uses are swallowed");
    app->press("F10");
    app->press("F10");
    printf("menu %d\n", mb->openIdx);
    app->press("F10");
    app->press("x");
    printf("menu still open: %d\n", mb->openIdx);
    app->press("Esc");

    println("-- a context menu");
    tui.Menu* ctx = new tui.Menu("");
    ctx->add("Cut", act);
    ctx->add("Copy", act);
    ctx->add("Paste", act);
    app->popupMenu(ctx, 30, 9);
    screen("context menu near the bottom right corner is moved to fit");
    app->press("Down");
    app->press("Enter");
    screen("context menu item ran");
    app->popupMenu(ctx, 5, 4);
    app->click(30, 10);
    printf("click outside closes it: %d overlays\n", app->nov);
    return 0;
}
