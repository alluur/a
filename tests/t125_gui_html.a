// ghtml: parsing, entities, URLs, Markdown, layout, links, images and scrolling of the HTML view
import wsrv;
import gui;
import ghtml;
import gfx;
import adp;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
int linkClicks = 0;
int hovers = 0;
char* lastHover = null;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

int onLink(int self) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) self;
    linkClicks++;
    println(v->linkHref);
    return 0;
}

int onHover(int self) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) self;
    hovers++;
    lastHover = v->hoverHref;
    return 0;
}

int main() {
    // ---- text ----------------------------------------------------------------------------------------------------------------------
    println(ghtml.plainText("<html><head><title>T</title><style>p { color: red }</style><script>if (a < b) alert('x');</script></head><body><h1>Title</h1><p>Hello   <b>big</b>\n world &amp; <a href='x'>link</a>.</p><ul><li>one<li>two</ul><!-- hidden --><p>last</p></body></html>"));
    println(ghtml.decodeEntities("a &amp; b &lt;c&gt; &#65;&#x42; &eacute; &copy; &foo; & done"));
    println(ghtml.plainText("<pre>  keep\n    this  </pre><p>a<br>b</p>"));
    println(ghtml.plainText("<table><tr><td>x</td><td>y</td></tr><tr><td>z</td></tr></table>"));
    println(ghtml.parseHtml("<TITLE>My &amp; page</TITLE><p>x</p>", "")->title);

    // ---- URLs ----------------------------------------------------------------------------------------------------------------------
    char* base = "http://example.org:8080/docs/guide/page.html?q=1#top";
    println(ghtml.resolveUrl(base, "other.html"));
    println(ghtml.resolveUrl(base, "../img/a.png"));
    println(ghtml.resolveUrl(base, "../../../up.html"));
    println(ghtml.resolveUrl(base, "/root.html"));
    println(ghtml.resolveUrl(base, "//cdn.org/x.js"));
    println(ghtml.resolveUrl(base, "#section"));
    println(ghtml.resolveUrl(base, "https://secure.org/x"));
    println(ghtml.resolveUrl(base, ""));
    println(ghtml.resolveUrl("file:///home/u/docs/a.md", "b/c.md"));
    println(ghtml.resolveUrl("http://example.org", "x.html"));
    println(ghtml.resolveUrl(base, "./here/./there/../x.html?y=2"));

    // ---- Markdown ------------------------------------------------------------------------------------------------------------------
    println(ghtml.markdownToHtml("# Title\n\nA *line* with **bold**, `code <b>` and a [link](http://x.org/a_b).\nSecond line.\n\n- one\n- two\n  - nested\n1. first\n\n> quoted\n\n```\ncode & <tags>\n```\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\n---\n![pic](p.png)\n"));

    // ---- the view ------------------------------------------------------------------------------------------------------------------
    hb = new wsrv.Headless(640, 480);
    srv = new wsrv.Server(hb, 7280);
    gui.idleHook = stepServer;
    d = gui.connectAs("7280", "html");
    gui.Window* w = d->createWindow("View", 360, 260, 0);
    ghtml.HtmlView* v = new ghtml.HtmlView();
    v->onLink = onLink;
    v->onHover = onHover;
    gui.Box* col = gui.vbox(0, 0);
    col->add(v);
    w->setRoot(col);
    char* page = "<h1>Heading</h1><p>Some text with <a href='next.html'>a link</a> in it. More words follow so that the paragraph wraps onto several lines in this narrow window, and then <a href='/abs.html'>another one</a>.</p><p><img src='pic.png' width='40' height='30' alt='pic'> after the image</p><p>one</p><p>two</p><p>three</p><p>four</p><p>five</p><p>six</p><p>seven</p><p>eight</p><p>nine</p><p>ten</p><p>eleven</p><p>twelve</p>";
    v->setHtml(page, "http://site.org/dir/index.html");
    settle();
    printlnInt(v->contentHeight > v->h);
    printlnInt(v->imageCount());
    println(v->imageSource(0));
    printlnInt(v->hasImage("http://site.org/dir/pic.png"));
    // the layout does not depend on the image when width and height are given; without them it does
    v->setImage("http://site.org/dir/pic.png", new gfx.Surface(40, 30));
    printlnInt(v->hasImage("http://site.org/dir/pic.png"));
    // links: hover, click
    int lx;
    int ly;
    int lw;
    int lh;
    printlnInt(v->linkBox(0, &lx, &ly, &lw, &lh));
    printlnInt(v->linkBox(1, &lx, &ly, &lw, &lh));
    printlnInt(v->linkBox(7, &lx, &ly, &lw, &lh));
    v->linkBox(0, &lx, &ly, &lw, &lh);
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    hb->moveTo(sw->x + lx + lw / 2, sw->y + ly + lh / 2 - v->scrollY);
    settle();
    println(lastHover);
    hb->click(sw->x + lx + lw / 2, sw->y + ly + lh / 2 - v->scrollY);
    settle();
    printlnInt(linkClicks);
    hb->moveTo(sw->x + 5, sw->y + 5);
    settle();
    printlnInt(lastHover == null);
    // scrolling: the wheel, the keys, and the limits
    printlnInt(v->scrollY);
    hb->moveTo(sw->x + 100, sw->y + 100);
    hb->scroll(-1);
    settle();
    printlnInt(v->scrollY);
    hb->scroll(1);
    hb->scroll(1);
    settle();
    printlnInt(v->scrollY);
    v->focusMe();
    hb->tap(adp.KEY_END, 0);
    settle();
    printlnInt(v->scrollY == v->contentHeight - v->h);
    hb->tap(adp.KEY_HOME, 0);
    settle();
    printlnInt(v->scrollY);
    hb->tap(adp.KEY_PGDN, 0);
    settle();
    printlnInt(v->scrollY > 100);
    // other kinds of page
    v->setMarkdown("# Notes\n\nA [link](other.md) here.\n", "file:///home/u/notes.md");
    settle();
    printlnInt(v->linkBox(0, &lx, &ly, &lw, &lh));
    v->setPlain("line one\nline two\n\nline four", "x");
    settle();
    printlnInt(v->contentHeight > 80);
    // the picture alone
    v->setImagePage("file:///tmp/a.png", new gfx.Surface(100, 50));
    settle();
    printlnInt(v->hasImage("file:///tmp/a.png"));
    printlnInt(v->contentHeight >= 50);
    // a screenshot of the page is the same every time
    v->setHtml(page, "http://site.org/dir/index.html");
    v->setImage("http://site.org/dir/pic.png", new gfx.Surface(40, 30));
    settle();
    printlnInt(srv->screen->checksum());
    d->disconnect();
    srv->close();
    return 0;
}
