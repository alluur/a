// websocket: RFC 6455 examples, a handshake and messages between a client and a server in one process
import websocket;
import conn;
import hash;

int main() {
    // SHA-1 (used for the handshake)
    println(hash.sha1("abc", 3));
    println(hash.sha1("The quick brown fox jumps over the lazy dog", 43));
    // the example of RFC 6455 section 1.3
    println(websocket.acceptKey("dGhlIHNhbXBsZSBub25jZQ=="));

    // frames: "Hello" unmasked and masked (RFC 6455 section 5.7)
    char out[400];
    int n = websocket.buildFrame(websocket.OP_TEXT, true, false, 0, "Hello", 5, out);
    printlnInt(n);
    for (int i = 0; i < n; i++) { printInt(out[i]); print(" "); }
    println("");
    n = websocket.buildFrame(websocket.OP_TEXT, true, true, 0x37fa213d, "Hello", 5, out);
    for (int i = 0; i < n; i++) { printInt(out[i]); print(" "); }
    println("");
    websocket.Frame* f = new websocket.Frame();
    printlnInt(websocket.parseHeader(out, 3, f));            // incomplete
    printlnInt(websocket.parseHeader(out, n, f));
    printlnInt(f->opcode); printlnInt(f->masked); printlnInt(f->length); printlnInt(f->maskKey == 0x37fa213d);
    websocket.unmask(&out[f->headerLen], f->length, f->maskKey);
    out[f->headerLen + f->length] = 0;
    println(&out[f->headerLen]);
    // the longer length forms
    char* big = alloc(70000);
    for (int i = 0; i < 70000; i++) big[i] = 'x';
    char* frame = alloc(70100);
    printlnInt(websocket.buildFrame(websocket.OP_BINARY, true, false, 0, big, 300, frame));
    websocket.parseHeader(frame, 4, f); printlnInt(f->length); printlnInt(f->headerLen);
    printlnInt(websocket.buildFrame(websocket.OP_BINARY, true, false, 0, big, 70000, frame));
    websocket.parseHeader(frame, 10, f); printlnInt(f->length); printlnInt(f->headerLen);
    char bad[2]; bad[0] = 0xF1; bad[1] = 0;
    printlnInt(websocket.parseHeader(bad, 2, f));            // reserved bits set

    // a real handshake and conversation over the loopback interface
    conn.Listener* l = new conn.Listener(0);
    conn.Connection* cc = conn.open("127.0.0.1", l->port(), 1000);
    char key[40];
    printlnInt(websocket.clientSend(cc, "localhost", l->port(), "/chat", key));
    conn.Connection* sc = l->accept(1000);
    char path[64];
    websocket.WebSocket* server = websocket.accept(sc, path, 64);
    printlnInt(server != null);
    println(path);
    websocket.WebSocket* client = websocket.clientFinish(cc, key);
    printlnInt(client != null);

    char buf[100];
    int op;
    client->sendText("hello server");
    int len = server->receive(buf, 100, &op);
    printlnInt(len); printlnInt(op); println(buf);
    server->sendText("hello client");
    len = client->receive(buf, 100, &op);
    printlnInt(len); println(buf);
    // a ping is answered by the other side while it waits for a message
    client->ping();
    server->sendBinary("ab", 2);
    len = client->receive(buf, 100, &op);                    // gets the binary message
    printlnInt(len); printlnInt(op);
    client->sendText("after ping");
    len = server->receive(buf, 100, &op);                    // answers the ping first, then reads the message
    println(buf);
    // a large message
    client->sendBinary(big, 70000);
    char* bigIn = alloc(70100);
    len = server->receive(bigIn, 70100, &op);
    printlnInt(len);
    printlnInt(bigIn[0] == 'x' && bigIn[69999] == 'x');
    // fragmentation: a text message in two frames
    char f1[40]; char f2[40];
    int l1 = websocket.buildFrame(websocket.OP_TEXT, false, true, 0x01020304, "frag", 4, f1);
    int l2 = websocket.buildFrame(websocket.OP_CONT, true, true, 0x05060708, "ment", 4, f2);
    cc->write(f1, l1); cc->write(f2, l2); cc->flush();
    len = server->receive(buf, 100, &op);
    printlnInt(len); println(buf);
    // closing
    client->close(1000);
    len = server->receive(buf, 100, &op);
    printlnInt(len);
    printlnInt(server->closeCode);
    printlnInt(server->closed);
    l->close();

    // a plain HTTP request is refused
    conn.Listener* l2 = new conn.Listener(0);
    conn.Connection* c2 = conn.open("127.0.0.1", l2->port(), 1000);
    c2->writeLine("GET / HTTP/1.1"); c2->writeLine("Host: x"); c2->writeLine(""); c2->flush();
    printlnInt(websocket.accept(l2->accept(1000), null, 0) == null);
    char line[80];
    c2->readLine(line, 80);
    println(line);
    return 0;
}
