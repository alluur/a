// gterm: arrows and triangles are drawn as shapes (the fonts have no glyphs for them), other missing characters get plain ASCII stand-ins
// and everything else the font does not have is a question mark. Compared through the pixels of the window (checksums of the screen).
import wsrv;
import gui;
import gterm;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
gterm.Terminal* t;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

// the picture of the window with this one text at the top left corner
int shot(char* text) {
    t->feed("\x1b[2J\x1b[H");
    t->feed(text);
    settle();
    return srv->screen->checksum();
}

bool same(char* a, char* b) { return shot(a) == shot(b); }

int main() {
    hb = new wsrv.Headless(900, 640);
    srv = new wsrv.Server(hb, 7272);
    srv->allowScreenshots = true;
    gui.idleHook = stepServer;
    d = gui.connectAs("7272", "term");
    gui.Window* w = d->createWindow("Terminal", 100, 100, 0);
    t = new gterm.Terminal();
    gui.Box* col = gui.vbox(0, 0);
    col->add(t);
    w->setRoot(col);
    w->resize(t->cellW() * 20 + 6, t->cellH() * 4 + 6);
    settle();

    println("-- triangles and arrows are drawn");
    int right = shot("\xe2\x96\xb8");           // U+25B8
    int down = shot("\xe2\x96\xbe");            // U+25BE
    int left = shot("\xe2\x97\x82");            // U+25C2
    int up = shot("\xe2\x96\xb4");              // U+25B4
    int qm = shot("?");
    int blank = shot(" ");
    printf("each direction looks different: %d\n", right != down && right != left && right != up && down != left && down != up && left != up);
    printf("none of them is a question mark or empty: %d\n", right != qm && down != qm && left != qm && up != qm && right != blank && down != blank && left != blank && up != blank);
    printf("the other codes of a direction draw the same shape: right %d %d %d, down %d %d\n",
        same("\xe2\x96\xb6", "\xe2\x96\xb8"), same("\xe2\x86\x92", "\xe2\x96\xb8"), same("\xe2\x96\xba", "\xe2\x96\xb8"),
        same("\xe2\x96\xbc", "\xe2\x96\xbe"), same("\xe2\x86\x93", "\xe2\x96\xbe"));
    printf("left %d %d, up %d %d\n", same("\xe2\x97\x80", "\xe2\x97\x82"), same("\xe2\x86\x90", "\xe2\x97\x82"),
        same("\xe2\x96\xb2", "\xe2\x96\xb4"), same("\xe2\x86\x91", "\xe2\x96\xb4"));
    int square = shot("\xe2\x96\xa0");
    printf("a filled square is drawn: %d\n", square != qm && square != blank);

    println("-- plain ASCII stand-ins");
    printf("ellipsis is a dot: %d, quotes: %d %d, dashes: %d %d %d\n", same("\xe2\x80\xa6", "."), same("\xe2\x80\x98", "'"), same("\xe2\x80\x9c", "\""),
        same("\xe2\x80\x93", "-"), same("\xe2\x80\x94", "-"), same("\xe2\x88\x92", "-"));
    printf("check marks are a star: %d %d, crosses an x: %d %d, circles an o: %d\n", same("\xe2\x9c\x93", "*"), same("\xe2\x9c\x94", "*"), same("\xe2\x9c\x97", "x"), same("\xe2\x9c\x98", "x"), same("\xe2\x97\x8b", "o"));
    printf("angle quotes: %d %d\n", same("\xe2\x80\xb9", "<"), same("\xe2\x80\xba", ">"));

    println("-- anything else the font does not have is a question mark");
    printf("Greek capital delta: %d\n", same("\xce\x94", "?"));
    printf("a stand-in is not the question mark: %d\n", !same("\xe2\x80\xa6", "?"));
    return 0;
}
