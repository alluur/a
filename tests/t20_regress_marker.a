// Regression: a stale optimiser marker used to delete the statement after "c1++;"
// (found by the differential fuzzer on AArch64, where the rewritten increment is
// exactly as long as the following assignment).
int arr[8];
int main() {
    int v0 = 21;
    int v3 = 15;
    char c1 = 0;
    int w10 = 0;
    while (w10 < 1) {
        c1++;
        v3 = 43;
        w10++;
    }
    printlnInt(v3);
    printlnInt(c1);
    // the same shapes in several orders
    int a = 1; int b = 2;
    a++; b = 7; a--;
    b++; a = 9; b--;
    printlnInt(a); printlnInt(b);
    return 0;
}
