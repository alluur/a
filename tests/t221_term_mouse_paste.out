-- SGR mouse: press, release, drag, move, wheel, modifiers
\e[<0;1;1M -> Mouse press left (0,0)
\e[<0;1;1m -> Mouse release left (0,0)
\e[<1;10;5M -> Mouse press middle (9,4)
\e[<2;80;24M -> Mouse press right (79,23)
\e[<32;11;6M -> Mouse drag left (10,5)
\e[<34;12;6M -> Mouse drag right (11,5)
\e[<35;13;7M -> Mouse move none (12,6)
\e[<64;5;5M -> Mouse wheel up (4,4)
\e[<65;5;5M -> Mouse wheel down (4,4)
\e[<66;5;5M -> Mouse wheel left (4,4)
\e[<67;5;5M -> Mouse wheel right (4,4)
\e[<4;3;3M -> Mouse press left (2,2) +Shift
\e[<8;3;3M -> Mouse press left (2,2) +Alt
\e[<16;3;3M -> Mouse press left (2,2) +Ctrl
\e[<20;3;3M\e[<20;3;3m -> Mouse press left (2,2) +Shift +Ctrl Mouse release left (2,2) +Shift +Ctrl
\e[<68;9;9M -> Mouse wheel up (8,8) +Shift
\e[<0;300;250M -> Mouse press left (299,249)
-- mouse events keep the order with keys
a\e[<0;2;2Mb\e[<0;2;2m -> a Mouse press left (1,1) b Mouse release left (1,1)
-- the old X10 form: ESC [ M and three bytes (button + 32, column + 33, row + 33)
\e[M !! -> Mouse press left (0,0)
\e[M#!! -> Mouse release left (0,0)
\e[M"*) -> Mouse press right (9,8)
\e[M`%% -> Mouse wheel up (4,4)
-- bracketed paste
\e[200~hello world\e[201~ -> Paste 11 bytes
\e[200~line one\nline two\r\n^Itab\e[201~ -> Paste 23 bytes
\e[200~\e[201~ -> Paste 0 bytes
\e[200~has \e[31m escape and \e[ stuff \e[20 not the end\e[201~x -> Paste 46 bytes x
\e[200~caf\xc3\xa9 \xe4\xb8\x96\e[201~ -> Paste 9 bytes
-- a paste that ends in pieces
waiting
a paste waits longer for more input
 Paste 3 bytes
-- an unfinished paste is delivered when the input stops
 Paste 7 bytes
-- focus
\e[I -> Focus in
\e[O -> Focus out
-- replies: cursor position needs a request, otherwise it is a key
\e[1;5R -> Ctrl+F3
\e[1;5R -> Cursor position 1;5
\e[24;80R -> Cursor position 24;80
\e[8;50;132t -> Size report 50;132
-- the queue grows: a burst of input loses nothing
200
