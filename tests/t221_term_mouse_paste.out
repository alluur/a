[plain title]
[evil[31mINJECTED]0;second]
[abc]
[caf\xc3\xa9 \xe2\x82\xac \xf0\x9f\x98\x80]
[c1 [31m  \xc2\xa0.]
[stray  and  and  gone]
[cut ]
