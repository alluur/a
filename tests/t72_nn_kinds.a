// neural networks: Hopfield memory, self-organizing map, recurrent network, convolutional network, autoencoder
import nn;
import fixed;

int main() {
    int ONE = fixed.ONE;
    fixed.seed(42);

        // --- hopfield
    nn.Hopfield* hf = new nn.Hopfield(16);
    int a[16]; int b[16];
    for (int i = 0; i < 16; i++) { a[i] = (i % 2 == 0) ? 1 : -1; b[i] = (i < 8) ? 1 : -1; }
    hf->store(a); hf->store(b);
    int s[16];
    for (int i = 0; i < 16; i++) s[i] = a[i];
    s[0] = -s[0]; s[5] = -s[5];
    printlnInt(hf->recall(s, 10));
    int same = 1;
    for (int i = 0; i < 16; i++) if (s[i] != a[i]) same = 0;
    printlnInt(same);
    printlnInt(hf->energy(a));

    // --- SOM: two clusters
    nn.SOM* som = new nn.SOM(4, 1, 2);
    int data[40];
    for (int i = 0; i < 10; i++) {
        data[i*2] = fixed.fromText("0.1") + fixed.randRange(0, fixed.fromText("0.1"));
        data[i*2+1] = fixed.fromText("0.1") + fixed.randRange(0, fixed.fromText("0.1"));
        data[20+i*2] = fixed.fromText("0.8") + fixed.randRange(0, fixed.fromText("0.1"));
        data[20+i*2+1] = fixed.fromText("0.8") + fixed.randRange(0, fixed.fromText("0.1"));
    }
    som->fit(data, 20, 30, fixed.fromText("0.5"), fixed.fromText("2"));
    printlnInt(som->bmu(&data[0]) != som->bmu(&data[20]));
    fixed.putln(som->quantizationError(data, 20), 2);

    // --- Elman: predict the next element of the cycle 0 1 2 0 1 2
    nn.Elman* rnn = new nn.Elman(3, 8, 3);
    rnn->softmaxOut = true;
    int xs[18]; int ts[18];
    for (int k = 0; k < 6; k++) {
        for (int j = 0; j < 3; j++) { xs[k*3+j] = (j == k % 3) ? ONE : 0; ts[k*3+j] = (j == (k+1) % 3) ? ONE : 0; }
    }
    int lo = 0;
    for (int e = 0; e < 400; e++) lo = rnn->trainSequence(xs, ts, 6, fixed.fromText("0.3"));
    fixed.putln(lo, 3);
    int ys[18];
    rnn->run(xs, 6, ys);
    for (int k = 0; k < 6; k++) printInt(nn.argmax(&ys[k*3], 3));
    println("");

    fixed.seed(7);
    // --- conv net: horizontal (0) or vertical (1) bar on a 6x6 image
    int imgs[36 * 12]; int labels[12];
    for (int n = 0; n < 12; n++) {
        int pos = n % 6;
        labels[n] = n / 6;
        for (int y = 0; y < 6; y++) for (int x = 0; x < 6; x++) {
            int on = 0;
            if (labels[n] == 0 && y == pos) on = 1;
            if (labels[n] == 1 && x == pos) on = 1;
            imgs[n * 36 + y * 6 + x] = on * ONE;
        }
    }
    nn.ConvNet* cnn = new nn.ConvNet(6, 6, 2, 3, 2);
    int l = cnn->fit(imgs, labels, 12, 60, fixed.fromText("0.1"));
    fixed.putln(l, 2);
    printlnInt(cnn->accuracy(imgs, labels, 12));

    // --- autoencoder: 4 one-hot vectors through a 2 value code
    nn.Autoencoder* ae = new nn.Autoencoder(4, 0, 2);
    int d[16];
    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) d[i*4+j] = (i == j) ? ONE : 0;
    ae->fit(d, 4, 4000, fixed.fromText("0.5"));
    int ok = 0;
    for (int i = 0; i < 4; i++) { int* r = ae->reconstruct(&d[i*4]); if (nn.argmax(r, 4) == i) ok++; }
    printlnInt(ok);
    int* c = ae->encode(&d[4]);
    int* back = ae->decode(c);
    printlnInt(nn.argmax(back, 4));

    return 0;
}
