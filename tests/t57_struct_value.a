struct Point { int x; int y; }
struct Rect { Point a; Point b; char tag; }

Point make(int x, int y) {
    Point p;
    p.x = x;
    p.y = y;
    return p;
}

int dist2(Point p, Point q) {
    int dx = p.x - q.x;
    int dy = p.y - q.y;
    p.x = 999;                          // changes the copy only
    return dx * dx + dy * dy;
}

Point add(Point a, Point b) {
    Point r;
    r.x = a.x + b.x;
    r.y = a.y + b.y;
    return r;
}

Rect box(Point a, Point b) {
    Rect r;
    r.a = a;
    r.b = b;
    r.tag = 'R';
    return r;
}

class Counter {
    private int n;
    public Counter(int start) { n = start; }
    public Point asPoint(Point offset) {
        Point p;
        p.x = n + offset.x;
        p.y = n + offset.y;
        return p;
    }
}

int main() {
    Point a = make(1, 2);
    Point b = make(4, 6);
    printlnInt(dist2(a, b));
    printlnInt(a.x);                        // still 1
    Point c = add(a, b);
    printlnInt(c.x * 100 + c.y);
    printlnInt(add(add(a, b), make(10, 20)).y);
    Rect r = box(a, c);
    printlnInt(r.b.x + r.a.y);
    printChar(r.tag); printChar('\n');
    Point d;
    d = make(7, 8);
    printlnInt(d.x * 10 + d.y);
    Counter k(100);
    Point q = k.asPoint(make(1, 2));
    printlnInt(q.x + q.y);
    Point arr[3];
    arr[1] = make(5, 6);
    printlnInt(dist2(arr[1], arr[0]));
    return 0;
}
