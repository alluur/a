module app;

import modules.geometry;
import modules.util.math;

int square(int x) { return -1; }     // does not clash with math.square

int main() {
    printlnInt(math.square(7));
    printlnInt(math.cube(3));
    printlnInt(math.gcd(48, 18));
    printlnInt(square(7));
    geometry.Vec a;
    a.x = 1; a.y = 2;
    geometry.Vec b;
    b.x = 3; b.y = 4;
    printlnInt(geometry.dot(&a, &b));
    printlnInt(geometry.viaHelper(2));
    printlnInt(geometry.PI_TIMES_100);
    geometry.Box* box = new geometry.Box(3, 4);
    printlnInt(box->area());
    geometry.Shape s = geometry.Shape.Square;
    printlnInt(s);
    return 0;
}
