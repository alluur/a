// arith: overflow checks, saturation, rounding, number theory, fractions with operators
import cstdio;
import arith;

int main() {
    int big = 9223372036854775807;
    int small = -9223372036854775807 - 1;
    printf("overflow: %d %d %d %d %d %d\n", arith.addOverflows(big, 1), arith.addOverflows(1, 2), arith.subOverflows(small, 1), arith.mulOverflows(big, 2), arith.mulOverflows(3037000499, 3037000499), arith.mulOverflows(small, -1));
    int r = 7;
    printf("checked: %d %d (r = %d)\n", arith.checkedAdd(1, 2, &r), arith.checkedAdd(big, 1, &r), r);
    printf("saturate: %d %d %d %d\n", arith.satAdd(big, 5) == big, arith.satSub(small, 5) == small, arith.satMul(big, -2) == small, arith.satMul(6, 7));
    printf("clamp: %d %d %d %d\n", arith.clampBits(300, 8, false), arith.clampBits(-5, 8, false), arith.clampBits(200, 8, true), arith.clampBits(-200, 8, true));

    printf("division: %d %d %d %d | %d %d %d %d\n", arith.floorDiv(7, 2), arith.floorDiv(-7, 2), arith.ceilDiv(7, 2), arith.ceilDiv(-7, 2), arith.roundDiv(7, 2), arith.roundDiv(-7, 2), arith.roundDiv(5, 3), arith.roundDiv(-5, 3));
    printf("mod: %d %d %d, absDiff %d, avg %d %d\n", arith.floorMod(-1, 5), arith.floorMod(11, 5), arith.floorMod(-10, 5), arith.absDiff(3, 10), arith.avg(big, big - 2) == big - 1, arith.avg(-4, 10));
    printf("roots: %d %d %d %d %d, squares %d %d\n", arith.isqrt(0), arith.isqrt(99), arith.isqrt(100), arith.isqrt(big), arith.iroot(1000, 3), arith.isSquare(144), arith.isSquare(145));
    printf("iroot: %d %d %d\n", arith.iroot(1023, 5), arith.iroot(1024, 5), arith.iroot(big, 2));

    int x; int y;
    printf("gcd/lcm: %d %d %d %d\n", arith.gcd(48, -18), arith.lcm(4, 6), arith.lcm(0, 5), arith.gcd(0, 0));
    int g = arith.extGcd(240, 46, &x, &y);
    printf("extGcd: %d %d %d check %d\n", g, x, y, 240 * x + 46 * y);
    printf("inverse: %d %d %d\n", arith.modInverse(3, 11), arith.modInverse(10, 17), arith.modInverse(4, 8));
    printf("mulMod: %d, powMod: %d %d\n", arith.mulMod(big, big, 1000000007), arith.powMod(2, 100, 1000000007), arith.powMod(3, 200, 13));
    printf("primes: %d %d %d %d %d %d\n", arith.isPrime(2), arith.isPrime(97), arith.isPrime(1000000007), arith.isPrime(1000000007 * 3), arith.isPrime(9223372036854775783), arith.isPrime(561));
    printf("nextPrime: %d %d %d\n", arith.nextPrime(0), arith.nextPrime(100), arith.nextPrime(1000000));
    int f[16];
    int n = arith.factorize(360, f, 16);
    printf("factorize 360: %d factors:", n);
    for (int i = 0; i < n; i++) { printf(" %d", f[i]); }
    printf("\n");
    printf("totient %d %d %d, divisors %d %d\n", arith.totient(1), arith.totient(36), arith.totient(97), arith.divisorCount(360), arith.divisorCount(97));
    printf("sequences: fib %d %d, fact %d, binom %d %d, catalan %d, collatz %d\n", arith.fibonacci(10), arith.fibonacci(90), arith.factorial(20), arith.binomial(10, 3), arith.binomial(60, 30), arith.catalan(10), arith.collatzSteps(27));
    printf("digits: %d %d %d %d %d\n", arith.digitCount(12345), arith.digitSum(12345), arith.reverseDigits(-1230), arith.isPalindrome(12321), arith.isPalindrome(123));

    arith.Rational a = arith.rat(1, 3);
    arith.Rational b = arith.rat(1, 6);
    arith.Rational c = a + b;
    printf("rational: %s %s %s %s %s\n", c.str(), (a - b).str(), (a * b).str(), (a / b).str(), (-a).str());
    arith.Rational d = arith.rat(6, -8);
    printf("normalised: %s, whole %s, zero denominator %s\n", d.str(), arith.rat(10, 5).str(), arith.rat(5, 0).str());
    printf("compare: %d %d %d %d %d %d, ratCompare %d\n", a < b, a > b, a == arith.rat(2, 6), a != b, a <= a, b >= a, arith.ratCompare(b, a));
    arith.Rational sum = arith.rat(0);
    for (int i = 1; i <= 10; i++) { sum += arith.rat(1, i * (i + 1)); }
    printf("telescoping sum: %s, as double > 0.9: %d\n", sum.str(), sum.toDouble() > 0.9);
    arith.Rational h = arith.rat(-7, 2);
    printf("floor/ceil/round: %d %d %d\n", h.floor(), h.ceil(), h.round());
    return 0;
}
