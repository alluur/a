char* SERVER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPTCB5aADAgECAghotNTSsBOFvDAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAUMRIwEAYD\nVQQDDAkxMjcuMC4wLjEwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASQo30/KSJR\nbLR0qkuSKMRwxN2Xvd08KFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA\n0tODiEQ9MEeCoyEwHzAMBgNVHRMBAf8EAjAAMA8GA1UdEQQIMAaHBH8AAAEwCgYI\nKoZIzj0EAwIDRwAwRAIgU64nzo1fbN1Q020h4M68boDulT6ZPr2sHq2luv7FldQC\nIC+L4vvfr326IW2u5O57h04274NWnE7Q40w44uqIwI8m\n-----END CERTIFICATE-----\n";
char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";
char* STRANGER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPzCB5qADAgECAggQooP33JMRCDAKBggqhkjOPQQDAjATMREwDwYDVQQDDAhP\ndGhlciBDQTAgFw0yMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowFDESMBAG\nA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAESGzdSqEX\nfcdvOu7FW5LokaFUX6T3H+Uv6Phce9S06Dw9oh5p2phKAMqbGn8NL20emZetycF1\nyFTn/teSJ1Bt3aMhMB8wDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwR/AAABMAoG\nCCqGSM49BAMCA0gAMEUCIQDN+ASE1vNvveEm/4o9If40ZlMUQWP6kr0zrWnk1taQ\n9QIgYVrITfLWZqRs9cbjtTaEDcrOadDwvBx1R+R1f5qk01s=\n-----END CERTIFICATE-----\n";
char* STRANGER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2Hn4c01UmR2L+x+7\nDlLis81vDspgD6J4c2wPo8uS7W2hRANCAARIbN1KoRd9x2867sVbkuiRoVRfpPcf\n5S/o+Fx71LToPD2iHmnamEoAypsafw0vbR6Zl63JwXXIVOf+15InUG3d\n-----END PRIVATE KEY-----\n";

// Redis over TLS (rediss://): the server listens on a plain and on a TLS port, the client verifies the certificate, a certificate of an unknown CA is
// refused, verification can be switched off, large values and pipelines go through the TLS layer, pub/sub works over TLS, a dropped connection is
// made again with a new handshake (AUTH and SELECT are repeated), a client of the wrong kind on a port fails cleanly, a silent TLS connection and
// garbage instead of a ClientHello are dropped.
import redis;
import redisd;
import net;
import tls;
import x509;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

redisd.Server* srv;

int hook() {
    srv->poll(0);
    return 0;
}

// serves the sockets until `rounds` polls in a row had nothing to do (at most 2 s): no assumption about how fast the system delivers
void settle(int rounds = 15) {
    int quiet = 0;
    int t0 = millis();
    while (quiet < rounds && millis() - t0 < 2000) {
        if (srv->poll(1) == 0) quiet++; else quiet = 0;
    }
}

bool eq(char* got, char* want) {
    bool ok = got != null && streq(got, want);
    if (got != null) free(got);
    return ok;
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    tls.Config* stranger = tls.loadConfig(STRANGER_CERT, STRANGER_KEY);
    check("the test certificates load", good != null && stranger != null);
    srv = redisd.newServer();
    check("the server listens on a plain port", srv->listenOn("127.0.0.1", 0, null));
    check("... and on a TLS port", srv->listenOn("127.0.0.1", 0, good));
    int plainPort = srv->net->listenerPort(0);
    int tlsPort = srv->net->listenerPort(1);
    net.setIdleHook(hook);
    char turl[100];
    char purl[100];
    format(&turl[0], 100, "rediss://127.0.0.1:%d", tlsPort, 0, 0, 0);
    format(&purl[0], 100, "redis://127.0.0.1:%d", plainPort, 0, 0, 0);
    redisd.Store* st = srv->store;

    redis.Client* a = redis.connect(&turl[0]);
    check("rediss: connect, the certificate is verified against the CA", a != null && a->isConnected());
    if (a == null) return 1;
    redis.Client* p = redis.connect(&purl[0]);
    check("a plain client on the plain port", p != null && p->ping());
    check("SET over TLS, GET over plain", a->set("shared", "from tls") && eq(p->get("shared"), "from tls"));
    check("SET over plain, GET over TLS", p->set("shared2", "from plain") && eq(a->get("shared2"), "from plain"));
    char* big = alloc(300000);
    for (int i = 0; i < 300000; i++) big[i] = i * 13;
    check("300000 bytes over TLS", a->setBin("big", big, 300000));
    int len = 0;
    char* back = a->getBin("big", &len);
    check("... and back", back != null && len == 300000 && memcmp(back, big, 300000) == 0);
    if (back != null) free(back);
    redis.Pipeline* pl = redis.pipeline(a);
    for (int i = 0; i < 300; i++) pl->add("INCR", "counter");
    check("a pipeline of 300 commands over TLS", pl->run() && pl->got == 300 && pl->reply(299)->num == 300);
    pl->dispose();
    redis.PubSub* ps = redis.pubsub(a);
    check("pub/sub over TLS", ps->subscribe("tls-news") && ps->next(50) == null);
    check("... a plain client publishes", p->publish("tls-news", "hello tls") == 1);
    redis.PubMessage* m = ps->next(2000);
    check("... the TLS subscriber gets it", m != null && streq(m->data, "hello tls"));
    if (m != null) m->dispose();
    ps->dispose();
    check("two TLS connections at the same time", st->clients >= 2);

    // certificates that are not accepted
    x509.clearRoots();
    check("without a trusted CA the connection is refused", redis.connect(&turl[0]) == null && strlen(redis.error()) > 5);
    redis.Options v();
    v.verify = false;
    redis.Client* nv = redis.connectWith(&turl[0], &v);
    check("with verify off it works", nv != null && nv->ping());
    if (nv != null) nv->dispose();
    x509.addRootPem(CA_PEM);
    a->dispose();
    p->dispose();
    srv->shutdown();
    srv = redisd.newServer();
    srv->listenOn("127.0.0.1", 0, stranger);
    char surl[100];
    format(&surl[0], 100, "rediss://127.0.0.1:%d", srv->port, 0, 0, 0);
    check("a certificate of an unknown CA is refused", redis.connect(&surl[0]) == null && strlen(redis.error()) > 5);
    nv = redis.connectWith(&surl[0], &v);
    check("... unless verification is off", nv != null && nv->ping());
    if (nv != null) nv->dispose();
    srv->shutdown();

    // the wrong kind of client on a port
    srv = redisd.newServer();
    srv->listenOn("127.0.0.1", 0, null);
    srv->listenOn("127.0.0.1", 0, good);
    plainPort = srv->net->listenerPort(0);
    tlsPort = srv->net->listenerPort(1);
    st = srv->store;
    char wrong[100];
    format(&wrong[0], 100, "redis://127.0.0.1:%d", tlsPort, 0, 0, 0);
    redis.Options quick();
    quick.timeoutMs = 600;
    redis.Client* w = redis.connectWith(&wrong[0], &quick);
    check("redis:// to the TLS port: the first command fails", w != null && w->call("PING") == null);
    w->dispose();
    format(&wrong[0], 100, "rediss://127.0.0.1:%d", plainPort, 0, 0, 0);
    quick.connectTimeoutMs = 700;
    check("rediss:// to the plain port fails", redis.connectWith(&wrong[0], &quick) == null && strlen(redis.error()) > 3);
    settle(30);
    check("both failures left nothing behind in the server", st->clients == 0 && srv->net->count() == 0);
    srv->net->handshakeTimeoutMs = 300;
    int h = net.connect("127.0.0.1", tlsPort);
    settle(5);
    check("a silent connection to the TLS port is counted", srv->net->count() == 1);
    int t0 = millis();
    while (srv->net->count() > 0 && millis() - t0 < 2000) srv->poll(5);
    check("... and dropped after the handshake time out", srv->net->count() == 0 && srv->net->stats->tlsFailures >= 1);
    net.close(h);
    int cmds0 = st->stats->commands;                  // (a TLS ClientHello sent to the plain port was read as inline commands: unknown commands, as in Redis)
    h = net.connect("127.0.0.1", tlsPort);
    net.send(h, "PING\r\nthis is not a TLS handshake at all\r\n", 41);
    t0 = millis();
    while (srv->net->count() > 0 && millis() - t0 < 2000) srv->poll(5);
    check("garbage instead of a ClientHello: dropped (it is not taken for a command)", srv->net->count() == 0 && st->stats->commands == cmds0);
    net.close(h);

    // reconnect over TLS with AUTH and SELECT
    st->requirepass = "tls-secret";
    char ru[160];
    format(&ru[0], 160, "rediss://:tls-secret@127.0.0.1:%d/4", tlsPort, 0, 0, 0);
    redis.Client* r = redis.connect(&ru[0]);
    check("rediss with a password and a database", r != null && r->set("k", "v"));
    srv->dropClients();
    settle();
    check("the dropped connection: the next call fails", r->get("k") == null && !r->isConnected());
    check("the call after that makes a new TLS handshake, AUTH and SELECT 4 again", r->exists("k") == 1 && r->reconnects == 1);
    r->dispose();
    settle();
    check("everything is closed again", st->clients == 0 && srv->net->count() == 0);
    printf("%d checks, %d failed\n", checks, fails);
    srv->shutdown();
    return fails == 0 ? 0 : 1;
}
