// tui: TextInput - editing keys, selection, kill buffer, history, completion, password, paste, mouse, long and wide text
import tui;
import term;
import tscreen;

tui.App* app;
tui.TextInput* ti;
int changes;
int entered;

int onChange(int t) { changes++; return 0; }
int onEnter(int t) { entered++; return 0; }

// shows the field's text with the cursor as | and the selection in [ ]
void state(char* what) {
    char* t = ti->getText();
    int len = strlen(t);
    int a = ti->cur < ti->anchor ? ti->cur : ti->anchor;
    int b = ti->cur < ti->anchor ? ti->anchor : ti->cur;
    char out[300];
    int o = 0;
    for (int i = 0; i <= len; i++) {
        if (i == a && a != b) { out[o] = '['; o++; }
        if (i == b && a != b) { out[o] = ']'; o++; }
        if (i == ti->cur) { out[o] = '|'; o++; }
        if (i < len) { out[o] = t[i]; o++; }
    }
    out[o] = 0;
    printf("%-34s %s\n", what, &out[0]);
}

int completer(int input, char* word, char** out, int max) {
    char* all[4] = {"alpha", "alphabet", "beta", "alpine"};
    int n = 0;
    for (int i = 0; i < 4; i++) {
        if (startsWith(all[i], word)) { out[n] = all[i]; n++; }
    }
    return n;
}

int main() {
    app = new tui.App();
    app->initHeadless(30, 6);
    tui.Box* col = tui.vbox(0, 0);
    ti = new tui.TextInput("");
    ti->onChange = onChange;
    ti->onEnter = onEnter;
    col->add(ti);
    col->add(new tui.Spacer());
    app->setRoot(col);
    app->pump(0);
    printf("focus on the field: %d, cursor shown: %d at %d,%d\n", app->focus == ti, app->screen->curShow, app->screen->curX, app->screen->curY);

    println("-- typing and moving");
    app->type("hello world");
    state("typed");
    app->press("Left"); app->press("Left");
    state("two left");
    app->type("XY");
    state("insert");
    app->press("Backspace");
    state("backspace");
    app->press("Delete");
    state("delete");
    app->press("Home");
    state("Home");
    app->press("Delete");
    state("delete at the start");
    app->press("Backspace");
    state("backspace at the start (nothing)");
    app->press("End");
    state("End");
    app->press("Right");
    state("Right at the end (nothing)");
    printf("changes: %d\n", changes);

    println("-- words: Ctrl+Left / Right, Ctrl+Backspace, Ctrl+Delete, Ctrl+W");
    app->press("Ctrl+Left");
    state("word left");
    app->press("Ctrl+Left");
    state("word left");
    app->press("Ctrl+Right");
    state("word right");
    app->press("Ctrl+Backspace");
    state("delete word before");
    app->press("End");
    app->type(" more words");
    app->press("Ctrl+Left");
    app->press("Ctrl+Delete");
    state("delete word after");
    app->press("Ctrl+W");
    state("Ctrl+W");

    println("-- selection with Shift, replace, copy, cut, paste");
    ti->setText("one two three");
    app->press("Home");
    app->press("Shift+Right"); app->press("Shift+Right");
    state("two characters selected");
    app->press("Shift+Left");
    state("one back");
    app->press("Ctrl+Shift+Right");
    state("select to the end of the word");
    app->type("1");
    state("typing replaces the selection");
    app->press("Ctrl+A");
    state("Ctrl+A selects all");
    app->press("Ctrl+C");
    printf("clipboard: '%s'\n", app->clipboard.str());
    app->press("Right");
    state("Right collapses to the end");
    app->press("Ctrl+Left");
    app->press("Shift+End");
    state("Shift+End");
    app->press("Ctrl+X");
    state("cut");
    printf("clipboard: '%s'\n", app->clipboard.str());
    app->press("Home");
    app->press("Ctrl+V");
    state("pasted at the start");
    app->press("Shift+Home");
    app->press("Left");
    state("Left collapses to the start of the selection");

    println("-- kill buffer: Ctrl+K, Ctrl+U, Ctrl+Y");
    ti->setText("kill this part");
    app->press("Home");
    for (int i = 0; i < 5; i++) { app->press("Right"); }
    app->press("Ctrl+K");
    state("Ctrl+K");
    app->press("Ctrl+U");
    state("Ctrl+U");
    app->press("Ctrl+Y");
    state("Ctrl+Y");
    app->press("Ctrl+Y");
    state("Ctrl+Y again");

    println("-- multi byte characters");
    ti->setText("");
    app->type("h\xc3\xa9llo \xe4\xb8\x96\xe7\x95\x8c");
    state("typed");
    app->press("Left");
    state("one left (a wide character)");
    app->press("Backspace");
    state("backspace");
    printf("cursor cell column: %d\n", app->screen->curX);
    app->press("Home");
    app->press("Right"); app->press("Right");
    state("two right over a two byte character");
    app->press("Delete");
    state("delete of a two byte character... ");

    println("-- limits and paste");
    ti->setText("");
    ti->maxLen = 8;
    app->type("0123456789");
    state("maxLen 8");
    ti->maxLen = 0;
    ti->setText("");
    app->paste("line one\nline two\ttabbed");
    state("pasted text: newlines and tabs become blanks");
    ti->readOnly = true;
    app->type("x");
    app->press("Backspace");
    state("read only: nothing changes");
    ti->readOnly = false;

    println("-- Enter calls onEnter; without one it is left to the dialog");
    ti->setText("go");
    app->press("Enter");
    printf("entered: %d\n", entered);

    println("-- history: Up and Down");
    ti->setText("");
    ti->addHistory("first");
    ti->addHistory("second");
    ti->addHistory("second");
    ti->addHistory("third");
    printf("history size: %d\n", ti->histN);
    ti->setText("draft");
    app->press("Up");
    state("Up");
    app->press("Up");
    state("Up");
    app->press("Up");
    state("Up");
    app->press("Up");
    state("Up at the oldest");
    app->press("Down");
    state("Down");
    app->press("Down");
    app->press("Down");
    state("Down, Down");
    app->press("Down");
    state("Down back to the draft");

    println("-- completion: Tab with a hook");
    ti->useHistory = false;
    ti->completer = completer;
    ti->setText("say al");
    app->press("Tab");
    state("several candidates: the common prefix");
    app->press("Tab");
    printf("the candidates are offered as a menu: %d overlay(s)\n", app->nov);
    println(app->text());
    app->press("Down");
    app->press("Enter");
    state("picked from the menu");
    ti->setText("be");
    app->press("Tab");
    state("one candidate completes");
    ti->setText("zzz");
    app->press("Tab");
    state("no candidate: unchanged");

    println("-- password");
    ti->completer = null;
    ti->password = true;
    ti->setText("secret");
    println(app->text());
    ti->password = false;

    println("-- mouse: click, drag, double click");
    ti->setText("the quick brown fox");
    app->click(4, 0);
    state("click at column 4");
    app->advanceClock(1000);                    // the next press is not a double click
    app->mouseDown(4, 0);
    app->mouseDrag(9, 0);
    app->mouseUp(9, 0);
    state("drag from 4 to 9");
    app->advanceClock(1000);
    app->click(12, 0);
    app->click(12, 0);
    state("double click selects the word");
    app->advanceClock(1000);
    app->click(29, 0);
    state("click far right");

    println("-- text longer than the field scrolls");
    ti->setText("0123456789012345678901234567890123456789");
    println(app->text());
    printf("cursor column %d\n", app->screen->curX);
    app->press("Home");
    println(app->text());
    return 0;
}
