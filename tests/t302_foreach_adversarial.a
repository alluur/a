// foreach: nested loops with break / continue / defer / return, evaluation once, empty collections,
// loops that change what they iterate, recursion, many loops in one function

int calls;
int bumpCalls;
int arrCalls;
int g[4] = {1, 2, 3, 4};

int* arrPtr() { arrCalls++; return g; }
int bump() { bumpCalls++; return 3; }
int* nextBase() { calls++; return g; }

struct Item { int id; int tag[2]; }
struct Shelf { Item items[3]; int used; }

int deep(int level) {
    int a[3] = {level, level + 1, level + 2};
    int total = 0;
    foreach (int v in a) {
        if (level < 3) { total += deep(level + 1); }
        total += v;
    }
    return total;
}

int firstOver(int limit) {
    int vals[5] = {3, 9, 4, 12, 7};
    defer print("[cleanup] ");
    foreach (int i, int v in vals) {
        foreach (int j in 0..3) {
            if (v > limit && j == 1) { return i * 10 + j; }
        }
    }
    return -1;
}

int countBreaks() {
    int n = 0;
    foreach (int i in 0..10) {
        if (i == 7) break;
        if (i % 2 == 1) continue;
        n += i;
    }
    foreach (int i in rev 0..10) {
        if (i == 3) break;
        if (i % 2 == 0) continue;
        n += i * 100;
    }
    return n;
}

int main() {
    // the iterated expression is evaluated exactly once
    foreach (int x in nextBase(), 4) { printInt(x); }
    println("");
    printlnInt(calls);
    foreach (int i in 0..bump()) { printInt(i); }
    println("");
    printlnInt(bumpCalls);
    foreach (int i in rev 0..bump()) { printInt(i); }
    println("");
    printlnInt(bumpCalls);
    foreach (int x in arrPtr(), 4) { printInt(x); }
    println("");
    printlnInt(arrCalls);

    // empty things
    int none[1];
    int* p = g;
    foreach (int x in p, 0) { print("never"); }
    foreach (int i in 0..0) { print("never"); }
    foreach (int i in rev 7..7) { print("never"); }
    foreach (int i in 9..2) { print("never"); }
    foreach (char c in "") { print("never"); }
    foreach (char c in rev "") { print("never"); }
    println("empty ok");

    // the array is not copied: changes made by the body are seen by later iterations
    int a[4] = {1, 2, 3, 4};
    foreach (int x in a) {
        if (x == 1) { a[3] = 40; }
        printInt(x); print(" ");
    }
    println("");
    foreach (int x in rev a) {
        if (x == 40) { a[0] = 10; }
        printInt(x); print(" ");
    }
    println("");

    // an array of structs that contain arrays
    Shelf s;
    foreach (int i, Item* it in s.items) { it->id = i + 1; it->tag[0] = i; it->tag[1] = i * 2; }
    foreach (Item it in s.items) {
        printInt(it.id); print(":");
        foreach (int t in it.tag) { printInt(t); }
        print(" ");
    }
    println("");
    // a copy does not change the original
    foreach (Item it in s.items) { it.id = 99; }
    foreach (Item it in rev s.items) { printInt(it.id); }
    println("");

    printlnInt(deep(1));
    printlnInt(firstOver(8));
    println("");
    printlnInt(firstOver(100));
    println("");
    printlnInt(countBreaks());

    // three levels, break only leaves the innermost loop
    int hits = 0;
    foreach (int i in 0..4) {
        foreach (int j in 0..4) {
            foreach (int k in 0..4) {
                if (k > j) break;
                if (j > i) continue;
                hits++;
            }
        }
    }
    printlnInt(hits);

    // while / for / switch mixed with foreach
    int sum = 0;
    foreach (int x in a) {
        int y = 0;
        while (y < x) { y += 7; if (y > 20) break; }
        for (int q = 0; q < 3; q++) { if (q == 1) continue; sum += q; }
        switch (x) { case 2: sum += 1000; break; default: sum += y; }
    }
    printlnInt(sum);

    // twelve loops one after the other (each gets its own hidden variables)
    int acc = 0;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    foreach (i in 0..2) acc += i;
    printlnInt(acc);

    // the body can be a single statement, an empty statement or a nested foreach without braces
    foreach (int i in 0..3) foreach (int j in 0..2) printInt(i * 10 + j);
    println("");
    foreach (int i in 0..3) ;
    // a range with negative numbers and large values
    foreach (int i in -2..2) { printInt(i); print(" "); }
    println("");
    foreach (int i in rev -2..2) { printInt(i); print(" "); }
    println("");
    int big = 0;
    foreach (int i in 4611686018427387900..4611686018427387904) { big++; }
    printlnInt(big);
    // pointer and count over an array of texts (this is how argv is iterated: foreach (char* a in argv, argc))
    char* names[3] = {"x", "yy", "zzz"};
    char** np = names;
    foreach (char* n in np, 3) { print(n); print("|"); }
    println("");
    foreach (int i, char* n in rev np, 2) { printInt(i); print(n); }
    println("");
    // closed ranges
    foreach (int i in 1..=4) { printInt(i); }
    println("");
    foreach (int i in rev 1..=4) { printInt(i); }
    println("");
    foreach (int i in 3..=3) { printInt(i); }
    println("");
    foreach (int i in 4..=3) { print("never"); }
    foreach (char c in 'a'..='e') { printChar(c); }
    println("");
    return 0;
}
