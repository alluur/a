// closed ranges a..=b at the ends of the int range together with labeled continue / break, nesting, and a switch in the body
import cstdio;
int main() {
    int MAX = 9223372036854775807;
    int MIN = -9223372036854775807 - 1;
    int n = 0;
    outer: foreach (int i in MAX-2..=MAX) {
        foreach (int j in rev MIN..=MIN+2) {
            if (j == MIN + 1) continue outer;          // leaves the inner loop and steps the outer one
            n++;
            printf("i-MAX=%d j-MIN=%d\n", i - MAX, j - MIN);
        }
    }
    printf("n=%d\n", n);                               // 3
    n = 0;
    outer2: foreach (int i in MAX-2..=MAX) {
        foreach (int j in MIN..=MIN+5) {
            if (i == MAX && j == MIN + 1) break outer2;
            n++;
        }
    }
    printf("n=%d\n", n);                               // 6 + 6 + 1
    foreach (int i in MAX-1..=MAX) {
        switch (i - MAX) {
        case 0: printf("zero\n"); break;
        default: printf("other\n");
        }
    }
    int last = 0;
    foreach (int i in MAX..=MAX) { last = i; }         // a single value, the largest int
    printf("%d\n", last == MAX ? 1 : 0);
    foreach (int i in rev MIN..=MIN) { last = i; }     // a single value, the smallest int
    printf("%d\n", last == MIN ? 1 : 0);
    return 0;
}
