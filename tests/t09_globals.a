int counter;
int initial = 42;
char* greeting = "hello global";
int table[8];
bool flag = true;
char letter = 'Z';

void bump() { counter++; }
int main() {
    bump(); bump(); bump();
    printlnInt(counter);
    printlnInt(initial);
    println(greeting);
    for (int i = 0; i < 8; i++) table[i] = i * 2;
    printlnInt(table[7]);
    printBool(flag); println("");
    printChar(letter); println("");
    initial = initial + 1;
    printlnInt(initial);
    int* p = &counter;
    *p = 100;
    printlnInt(counter);
    return 0;
}
