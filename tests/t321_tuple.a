// tuples and multiple return values
(int, int) divmod(int a, int b) { return (a / b, a % b); }
(int, double) mix(int a) { return (a, a * 0.5); }
(char*, int) named() { return ("seven", 7); }
(int, int, int) triple(int x) { return (x, x * x, x * x * x); }

int main() {
    // declaring variables from a tuple, with types and with var
    (int q, int r) = divmod(7, 2);
    printf("%d %d\n", q, r);
    var (q2, r2) = divmod(100, 7);
    printf("%d %d\n", q2, r2);
    (char* s, int n) = named();
    printf("%s %d\n", s, n);
    (int a3, int b3, int c3) = triple(4);
    printf("%d %d %d\n", a3, b3, c3);

    // a tuple is a value: variables, copies, element access
    (int, int) t = divmod(9, 4);
    printf("%d %d\n", t.0, t.1);
    (int, int) u = t;
    u.0 = 100;
    printf("%d %d\n", t.0, u.0);
    var v = triple(3);
    printf("%d %d %d\n", v.0, v.1, v.2);
    v.1 = -1;
    printf("%d\n", v.1);

    // swap and assignment to existing variables: the right side is computed first
    int a = 1;
    int b = 2;
    (a, b) = (b, a);
    printf("%d %d\n", a, b);
    (a, b) = (a + b, a - b);
    printf("%d %d\n", a, b);
    (a, b) = divmod(17, 5);
    printf("%d %d\n", a, b);
    int arr[3] = {1, 2, 3};
    (arr[0], arr[2]) = (arr[2], arr[0]);
    printf("%d %d %d\n", arr[0], arr[1], arr[2]);
    int* p = &arr[1];
    (*p, a) = (50, 60);
    printf("%d %d\n", arr[1], a);
    (t.0, t.1) = (t.1, t.0);
    printf("%d %d\n", t.0, t.1);

    // _ throws an element away
    (int only, _) = divmod(17, 5);
    (_, int rest) = divmod(17, 5);
    printf("%d %d\n", only, rest);
    int s1;
    int s2;
    (s1, _) = divmod(9, 2);
    (_, s2) = divmod(9, 2);
    printf("%d %d\n", s1, s2);

    // a literal gets the type that is expected: int to double, int to a narrow type
    (int, double) lit = (1, 2);
    printf("%d %d\n", lit.0, (int)(lit.1 * 10.0));
    (double d1, int i1) = (3, 4.9);
    printf("%d %d\n", (int)(d1 * 10.0), i1);
    (uint8 by, int32 w32) = (300, 5000 * 1000000);
    printf("%d %d\n", by, w32);
    (int, double) m = mix(5);
    printf("%d %d\n", m.0, (int)(m.1 * 10.0));

    // the type of a literal without a context comes from its elements
    var lt = (1, "two", 3.5);
    printf("%d %s %d\n", lt.0, lt.1, (int)(lt.2 * 2.0));

    // used inside expressions
    printf("%d\n", divmod(20, 6).0 + divmod(20, 6).1);
    int x = (1, 2).1;
    printf("%d\n", x);
    printf("%d\n", sizeof((int, int)) + sizeof((int, int, int)));

    // in loops
    int sum = 0;
    for (var i = 0; i < 5; i++) {
        (int dq, int dr) = divmod(i * 7, 3);
        sum = sum + dq * 10 + dr;
    }
    printf("%d\n", sum);
    return 0;
}
