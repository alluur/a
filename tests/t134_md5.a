import cstdio;
import hash;
int main() {
    printf("%s\n", hash.md5("", 0));
    printf("%s\n", hash.md5("abc", 3));
    printf("%s\n", hash.md5("The quick brown fox jumps over the lazy dog", 43));
    char* big = "12345678901234567890123456789012345678901234567890123456789012345678901234567890";
    printf("%s\n", hash.md5(big, 80));
    char o[64];
    hash.hmac(128, "key", 3, "The quick brown fox jumps over the lazy dog", 43, o);
    for (int i = 0; i < 16; i++) { printf("%02x", o[i] & 255); }
    printf("\n");
    return 0;
}
