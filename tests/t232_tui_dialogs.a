// tuix: message boxes, questions, prompts, the colour dialog, the command palette, fuzzy matching and text wrapping
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
int ran;
char ranName[40];

int command(int ud) { ran++; format(&ranName[0], 40, "command %d", ud, 0, 0, 0); return 0; }

void fuzzy(char* pat, char* text) {
    int pos[16];
    int sc = tuix.fuzzyScore(pat, text, &pos[0], 16);
    printf("%-8s in %-24s ", pat, text);
    if (sc < 0) { println("no match"); return; }
    printf("score %d, at", sc);
    for (int i = 0; i < strlen(pat) && i < 16; i++) { printf(" %d", pos[i]); }
    println("");
}

int main() {
    println("-- fuzzy matching");
    fuzzy("", "anything");
    fuzzy("sf", "Save File");
    fuzzy("sf", "Show Foo");
    fuzzy("sav", "Save File");
    fuzzy("file", "Save File");
    fuzzy("xyz", "Save File");
    fuzzy("fs", "Save File");
    fuzzy("tt", "Toggle Tabs");
    fuzzy("op", "Open File");
    fuzzy("op", "Toggle Options");
    fuzzy("OPEN", "open");
    printf("shorter text wins: %d > %d\n", tuix.fuzzyScore("ab", "ab", null, 0), tuix.fuzzyScore("ab", "a long text with a b", null, 0));
    printf("word starts win: %d > %d\n", tuix.fuzzyScore("fb", "foo bar", null, 0), tuix.fuzzyScore("fb", "xfxbx", null, 0));

    println("-- word wrapping");
    println(tuix.wrapText("the quick brown fox jumps over the lazy dog", 16));
    println("--");
    println(tuix.wrapText("one\ntwo three four five six seven", 10));
    println("--");
    println(tuix.wrapText("averyveryverylongwordthatdoesnotfit and more", 12));
    println("--");
    println(tuix.wrapText("\xe4\xb8\x96\xe7\x95\x8c \xe4\xb8\x96\xe7\x95\x8c \xe4\xb8\x96\xe7\x95\x8c", 6));

    app = new tui.App();
    app->initHeadless(50, 18);
    tui.Label* back = new tui.Label("the program behind the dialogs");
    app->setRoot(back);
    app->pump(0);

    println("-- a message box (OK pressed with Enter)");
    app->inject("\r");
    int r = tuix.messageBox(app, "Notice", "The file could not be saved. Check the disk and try again later.");
    printf("result %d, overlays %d\n", r, app->nov);
    println("-- showing it without waiting, to look at it");
    tui.Label* l = new tui.Label(tuix.wrapText("The file could not be saved. Check the disk and try again later.", 30));
    tui.Dialog* d = new tui.Dialog("Notice", l);
    d->addButton("&OK", 1, true);
    d->addButton("&Cancel", 0);
    app->showDialog(d);
    println(app->text());
    printf("the dialog is modal: a click outside does nothing: ");
    app->click(2, 2);
    printf("%d overlays\n", app->nov);
    app->press("Tab");
    printf("focus on Cancel: %d\n", app->focus == d->buttons->kids[1]);
    app->press("Left");
    printf("Left moves back to OK: %d\n", app->focus == d->buttons->kids[0]);
    app->press("Esc");
    printf("Esc closes with the cancel result %d: open %d, overlays %d\n", d->result, d->open, app->nov);

    println("-- questions");
    app->inject("\x1b" "n");
    printf("No (Alt+N): %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));
    app->inject("\r");
    printf("Enter (Yes is the default): %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));
    app->inject("\x1b");
    printf("Esc: %d\n", tuix.askYesNo(app, "Question", "Delete the file?"));
    app->inject("\x1b" "c");
    printf("Cancel via Alt+C: %d\n", tuix.askYesNoCancel(app, "Question", "Save changes?"));
    app->inject("\x1b" "n");
    printf("No via Alt+N: %d\n", tuix.askYesNoCancel(app, "Question", "Save changes?"));
    app->inject("\r");
    printf("Yes: %d\n", tuix.askYesNoCancel(app, "Question", "Save changes?"));

    println("-- prompt");
    app->inject("Ada\r");
    char* name = tuix.prompt(app, "Name", "Your name:", "");
    printf("typed: %s\n", name);
    app->inject("\x1b[1;5D" "X\r");
    name = tuix.prompt(app, "Name", "Your name:", "initial text");
    printf("Ctrl+Left moved before the last word, X was inserted there: %s\n", name);
    app->inject("\x1b");
    name = tuix.prompt(app, "Name", "Your name:", "x");
    printf("cancelled: %s\n", name == null ? "null" : name);
    app->inject("\t\r");
    name = tuix.prompt(app, "Name", "Your name:", "keep");
    printf("Tab to Cancel and Enter: %s\n", name == null ? "null" : name);

    println("-- the colour dialog");
    app->inject("\r");
    int c = tuix.colorDialog(app, tscreen.rgb(200, 100, 50));
    printf("OK keeps the colour: %x\n", c);
    app->inject("\x1b");
    printf("Esc: %d\n", tuix.colorDialog(app, tscreen.rgb(200, 100, 50)));
    app->inject("\t\t\t\t\t\t\r");
    printf("the Default button: %d\n", tuix.colorDialog(app, tscreen.rgb(200, 100, 50)));
    // the palette grid has the focus first: arrows pick a palette colour
    app->inject("\x1b[C\x1b[C\x1b[B\r");
    c = tuix.colorDialog(app, tscreen.idx(10));
    printf("palette: moved from 10 right twice and down once: idx %d (%x)\n", c & 255, c);
    // sliders: Tab to the red slider, End = 255
    app->inject("\t\x1b[F\r");
    c = tuix.colorDialog(app, tscreen.rgb(10, 20, 30));
    printf("red slider to the end: %x\n", c);
    // the hex field: Tab x4, type
    app->inject("\t\t\t\t\x01#336699\r");
    c = tuix.colorDialog(app, tscreen.rgb(10, 20, 30));
    printf("hex field: %x\n", c);
    println("-- looking at the colour dialog");
    tui.Dialog* cd = tuix.newColorDialog(app, tscreen.rgb(200, 100, 50));
    app->showDialog(cd);
    println(app->text());
    app->press("Esc");
    printf("closed: result %d, overlays %d\n", cd->result, app->nov);

    println("-- the command palette");
    app->addCommand("File: Save", "Ctrl+S", command, 1);
    app->addCommand("File: Open", "Ctrl+O", command, 2);
    app->addCommand("Edit: Select all", "", command, 3);
    app->addCommand("View: Toggle sidebar", "Ctrl+B", command, 4);
    app->addCommand("Run: Build and run", "F5", command, 5);
    app->inject("\x1b");
    printf("Esc: %d\n", tuix.commandPalette(app));
    app->inject("sel\r");
    printf("typed 'sel' and Enter: %d, %s\n", tuix.commandPalette(app), &ranName[0]);
    app->inject("\x1b[B\r");
    printf("Down and Enter: %d, %s\n", tuix.commandPalette(app), &ranName[0]);
    app->inject("zzz\r");
    printf("nothing matches: %d (ran %d)\n", tuix.commandPalette(app), ran);
    app->press("Ctrl+S");
    printf("the shortcut of a command works too: %s\n", &ranName[0]);
    println("-- looking at the palette");
    tui.Dialog* pd = tuix.newCommandPalette(app);
    app->showDialog(pd);
    println(app->text());
    app->type("sv");
    println(app->text());
    app->press("Enter");
    printf("Enter ran it: %s, overlays %d\n", &ranName[0], app->nov);
    return 0;
}
