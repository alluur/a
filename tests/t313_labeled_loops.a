int main() {
    int hits = 0;
    outer: foreach (int i in 0..5) {
        foreach (int j in 0..5) {
            if (j == 3) continue outer;
            if (i == 3) break outer;
            hits += 1;
        }
    }
    printlnInt(hits);
    int n = 0;
    loop1: for (int i = 0; i < 4; i++) {
        int k = 0;
        while (true) {
            k++;
            if (k > 2) continue loop1;
            if (i == 2) break loop1;
            n += 10;
        }
    }
    printlnInt(n);
    int m = 0;
    done: while (m < 100) {
        do {
            m += 7;
            switch (m) {
                case 21: break done;
                case 14: continue done;
                default: break;
            }
        } while (m < 50);
    }
    printlnInt(m);
    sw: switch (m) {
        case 21:
            foreach (int q in 0..3) { if (q == 1) break sw; printInt(q); }
            print("not reached");
        default: print("d");
    }
    println("");
    // labels on while, do, for, foreach and switch; break and continue inside deeper statements
    int log = 0;
    a: foreach (int x in 0..3) {
        b: for (int y = 0; y < 3; y++) {
            c: while (true) {
                d: do {
                    if (y == 1) continue b;
                    if (x == 1) continue a;
                    if (x == 2) break a;
                    log += 1;
                    break c;
                } while (false);
            }
            log += 10;
        }
    }
    printlnInt(log);
    // a labeled statement that is not a loop does not capture the next loop
    int u = 0;
    here: u += 1;
    for (int i = 0; i < 3; i++) { u += 10; }
    printlnInt(u);
    // goto to a label that also names a loop still works
    int g = 0;
    again: g++;
    if (g < 3) goto again;
    printlnInt(g);
    // break out of nested foreach over text and arrays with defer in the function
    printlnInt(findPair());
    return 0;
}

int findPair() {
    int arr[4] = {3, 8, 5, 9};
    defer print("[done] ");
    found: foreach (int i, int a in arr) {
        foreach (int j, int b in arr) {
            if (j <= i) continue;
            if (a + b == 14) { return i * 10 + j; }
            if (a + b > 20) break found;
        }
    }
    return -1;
}
