// fmath (fast FPU mathematics) against dmath (correctly rounded, in software): the worst error in ulp of every function over
// a fixed set of arguments, then special values. The results are the same on every CPU and with --soft-float.
import fmath;
import dmath;
int seed = 2026;
double rnd() {
    seed = seed * 6364136223846793005 + 1442695040888963407;
    return ((seed >> 11) & 0x1FFFFFFFFFFFFF) * 1.1102230246251565e-16;
}
int ordered(double d) { int b = __bits(d); if (b < 0) return -(b & 0x7FFFFFFFFFFFFFFF); return b; }
int ulps(double a, double b) {
    if (a != a && b != b) return 0;
    int d = ordered(a) - ordered(b);
    return d < 0 ? -d : d;
}
int worst[24];
void track(int f, double a, double b) { int u = ulps(a, b); if (u > worst[f]) worst[f] = u; }
void bits(double d) { if (d != d) print("NAN"); else printInt(__bits(d)); print(" "); }
int main() {
    for (int i = 0; i < 150; i++) {
        double t = rnd();
        double a = (t - 0.5) * 20.0;
        double u = t * 2.0 - 1.0;
        double p = rnd() * 50.0 + 1e-3;
        double q = (rnd() - 0.5) * 6.0;
        track(0, fmath.sin(a), dmath.sin(a)); track(1, fmath.cos(a), dmath.cos(a)); track(2, fmath.tan(a), dmath.tan(a));
        track(3, fmath.asin(u), dmath.asin(u)); track(4, fmath.acos(u), dmath.acos(u)); track(5, fmath.atan(a), dmath.atan(a));
        track(6, fmath.atan2(q, a), dmath.atan2(q, a)); track(7, fmath.exp(a * 30.0), dmath.exp(a * 30.0));
        track(8, fmath.log(p), dmath.log(p)); track(9, fmath.log2(p), dmath.log2(p)); track(10, fmath.log10(p), dmath.log10(p));
        track(11, fmath.pow(p, q), dmath.pow(p, q)); track(12, fmath.sqrt(p), dmath.sqrt(p)); track(13, fmath.cbrt(a), dmath.cbrt(a));
        track(14, fmath.hypot(a, q), dmath.hypot(a, q)); track(15, fmath.sinh(a), dmath.sinh(a)); track(16, fmath.cosh(a), dmath.cosh(a));
        track(17, fmath.tanh(u), dmath.tanh(u)); track(18, fmath.fmod(a * 1000.0, q), dmath.fmod(a * 1000.0, q));
        track(19, fmath.floor(a), dmath.floor(a)); track(20, fmath.ceil(a), dmath.ceil(a)); track(21, fmath.round(a), dmath.round(a));
        track(22, fmath.trunc(a), dmath.trunc(a)); track(23, fmath.exp2(q * 10.0), dmath.exp2(q * 10.0));
    }
    char* names = "sin   cos   tan   asin  acos  atan  atan2 exp   log   log2  log10 pow   sqrt  cbrt  hypot sinh  cosh  tanh  fmod  floor ceil  round trunc exp2  ";
    for (int f = 0; f < 24; f++) {
        for (int c = 0; c < 6; c++) printChar(names[f * 6 + c]);
        printInt(worst[f]);
        println("");
    }
    double inf = 1.0 / 0.0;
    double nan = fmath.nan();
    bits(fmath.sin(inf)); bits(fmath.cos(-inf)); bits(fmath.tan(1e300)); bits(fmath.sin(-0.0)); bits(fmath.sin(3.5e6)); println("");
    bits(fmath.exp(710.0)); bits(fmath.exp(-746.0)); bits(fmath.exp(-740.0)); bits(fmath.exp(-inf)); bits(fmath.exp(nan)); println("");
    bits(fmath.log(0.0)); bits(fmath.log(-1.0)); bits(fmath.log(inf)); bits(fmath.log(5e-324)); bits(fmath.log(1.0)); println("");
    bits(fmath.pow(0.0, -1.0)); bits(fmath.pow(-0.0, -3.0)); bits(fmath.pow(-2.0, 0.5)); bits(fmath.pow(-2.0, 3.0)); bits(fmath.pow(-inf, -3.0));
    bits(fmath.pow(2.0, 1024.0)); bits(fmath.pow(0.5, inf)); bits(fmath.pow(-1.0, inf)); bits(fmath.pow(nan, 0.0)); println("");
    bits(fmath.atan2(0.0, -0.0)); bits(fmath.atan2(-0.0, -1.0)); bits(fmath.atan2(inf, -inf)); bits(fmath.atan2(1.0, 0.0)); println("");
    bits(fmath.fmod(5.5, 0.0)); bits(fmath.fmod(inf, 2.0)); bits(fmath.fmod(-7.25, 2.0)); bits(fmath.fmod(1e308, 3.0)); bits(fmath.fmod(5e-324, 3.0)); println("");
    bits(fmath.floor(-0.5)); bits(fmath.ceil(-0.5)); bits(fmath.round(-2.5)); bits(fmath.round(0.49999999999999994)); bits(fmath.trunc(-1e300)); println("");
    bits(fmath.sqrt(-1.0)); bits(fmath.sqrt(-0.0)); bits(fmath.cbrt(-27.0)); bits(fmath.cbrt(1e-310)); bits(fmath.hypot(3.0, 4.0)); println("");
    bits(fmath.sinh(710.0)); bits(fmath.cosh(-710.0)); bits(fmath.tanh(-30.0)); bits(fmath.asin(1.0)); bits(fmath.acos(-1.0)); bits(fmath.asin(1.5)); println("");
    printDouble(fmath.sin(fmath.radians(30.0))); print(" "); printDouble(fmath.degrees(fmath.atan2(1.0, 1.0))); print(" "); printDouble(fmath.clamp(7.0, 0.0, 5.0)); println("");
    return 0;
}
