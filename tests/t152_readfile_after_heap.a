// readFile must return the whole file even after the allocator has moved past the 64 MiB static heap
// (it used to truncate the text, because it assumed free room in the static heap)
int main() {
    char* big = alloc(64 * 1024 * 1024 - 100000);   // leaves about 100 KB of the static heap
    char* more = alloc(1024 * 1024);                  // goes to memory from the operating system
    more[0] = 1;
    big[0] = 1;
    int n = 300000;
    char* text = alloc(n + 1);
    for (int i = 0; i < n; i++) {
        text[i] = 'a' + (i % 26);
    }
    text[n] = 0;
    writeFile("/tmp/__a_readfile_after_heap.txt", text);
    char* back = readFile("/tmp/__a_readfile_after_heap.txt");
    printlnInt(strlen(back));
    printlnInt(streq(back, text));
    char* second = readFile("/tmp/__a_readfile_after_heap.txt");
    printlnInt(streq(second, text));
    return 0;
}
