// acode.Buffer.visualCol remembers the column of one offset (typing at the end of a long line asks for it after every key): the answers
// must always be those of a plain scan from the line start, whatever edits (insert, delete, newlines, tabs, wide and combining characters,
// undo, a reload with set text) happened in between, and typing into a long line must not be quadratic
import acode;
import asys;

int checks;
int fails;
int seed;

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

int rnd(int n) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return (seed >> 8) % n;
}

// the reference: the column by decoding the flattened text from the line start
int refCol(char* all, int total, int lineStartOff, int off, int tab) {
    int col = 0;
    int p = lineStartOff;
    while (p < off && p < total) {
        int b = all[p] & 255;
        int cp = b;
        int sz = 1;
        if (b >= 0xF0) { cp = ((b & 7) << 18) | ((all[p + 1] & 63) << 12) | ((all[p + 2] & 63) << 6) | (all[p + 3] & 63); sz = 4; }
        else if (b >= 0xE0) { cp = ((b & 15) << 12) | ((all[p + 1] & 63) << 6) | (all[p + 2] & 63); sz = 3; }
        else if (b >= 0xC0) { cp = ((b & 31) << 6) | (all[p + 1] & 63); sz = 2; }
        if (cp == 9) { col = col + tab - (col % tab); } else { col = col + acode.charWidth(cp); }
        p = p + sz;
    }
    return col;
}

// the pieces the random edits use
char* piece(int k) {
    if (k == 0) { return "a"; }
    if (k == 1) { return "hello world"; }
    if (k == 2) { return "\t"; }
    if (k == 3) { return "\xc3\xa4"; }                    // a with diaeresis: one column, two bytes
    if (k == 4) { return "\xe4\xb8\x96"; }                // a CJK character: two columns, three bytes
    if (k == 5) { return "e\xcc\x81"; }                   // e and a combining accent: one column
    if (k == 6) { return "\n"; }
    if (k == 7) { return "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"; }
    return "b";
}

int main() {
    seed = 4711;
    acode.Buffer b();
    acode.Editor ed(&b);
    // a few long lines to start with
    for (int i = 0; i < 6; i++) {
        for (int k = 0; k < 40; k++) { char* pc = piece(rnd(8)); b.edit(b.length(), 0, pc, strlen(pc)); }
        b.edit(b.length(), 0, "\n", 1);
    }
    int bad = 0;
    int asked = 0;
    for (int step = 0; step < 4000; step++) {
        // an edit somewhere (mostly near the places that were just asked about, so that the cache is hit and invalidated both)
        int len = b.length();
        int kind = rnd(10);
        if (kind < 6 || len == 0) {
            char* t = piece(rnd(8));
            int off = rnd(len + 1);
            // keep the offset at a character boundary
            while (off < len && (b.byteAt(off) & 0xC0) == 0x80) { off++; }
            b.edit(off, 0, t, strlen(t));
        } else if (kind < 9) {
            int off = rnd(len);
            while (off > 0 && off < len && (b.byteAt(off) & 0xC0) == 0x80) { off++; }
            int e = off + 1 + rnd(4);
            if (e > len) { e = len; }
            while (e < len && (b.byteAt(e) & 0xC0) == 0x80) { e++; }
            b.edit(off, e - off, "", 0);
        } else {
            if (b.undoDepth() > 0) { ed.undo(); }
        }
        // ask about several places: one line, increasing offsets (the typing pattern), then random ones
        char* all = b.flatten();
        int total = b.length();
        int tab = 1 + rnd(8);
        int line = rnd(b.lineCount());
        int ls = b.lineStart(line);
        int le = b.lineEnd(line);
        int off = ls;
        for (int q = 0; q < 6 && off <= le; q++) {
            while (off < le && (all[off] & 0xC0) == 0x80) { off++; }
            asked++;
            if (b.visualCol(line, off, tab) != refCol(all, total, ls, off, tab)) { bad++; }
            off = off + 1 + rnd(40);
        }
        for (int q = 0; q < 4; q++) {
            int o = ls + rnd(le - ls + 1);
            while (o < le && (all[o] & 0xC0) == 0x80) { o++; }
            asked++;
            if (b.visualCol(line, o, tab) != refCol(all, total, ls, o, tab)) { bad++; }
        }
    }
    check(bad == 0, "every answer equals the plain scan");
    printf("%d answers compared, %d wrong\n", asked, bad);
    b.dispose();

    // text replaced as a whole (set text, load) must not leave an old answer behind
    {
        acode.Buffer c();
        char* line = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
        c.setText(line, strlen(line));
        check(c.visualCol(0, 100, 4) == 100, "a long ASCII line");
        char* wide = "\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96\xe4\xb8\x96";
        c.setText(wide, strlen(wide));
        check(c.visualCol(0, 99, 4) == 66, "after setText the old cached answer is gone (33 wide characters are 66 columns)");
        check(c.visualCol(0, 3, 4) == 2, "and a smaller offset is scanned again");
        c.edit(0, 0, "ab", 2);
        check(c.visualCol(0, 101, 4) == 68, "after an insert at the start the answer follows");
        c.edit(0, 0, "\t", 1);
        check(c.visualCol(0, 102, 4) == 72, "after a tab at the start (tab width 4) as well");
        check(c.visualCol(0, 102, 8) == 76, "and with another tab width");
        c.dispose();
    }

    // typing 60000 characters at the end of one line: every key asks for the caret's column; this was quadratic (about 16 s for 60000)
    {
        acode.Buffer c();
        int t0 = asys.monoMs();
        int sum = 0;
        for (int i = 0; i < 60000; i++) {
            c.edit(c.length(), 0, "a", 1);
            sum = sum + c.visualCol(0, c.length(), 4);
        }
        int took = asys.monoMs() - t0;
        check(sum == 60000 * 60001 / 2, "the columns while typing");
        check(took < 5000, "typing 60000 characters with a column query after each key is not quadratic");
        c.dispose();
    }
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
