// rng: the ChaCha20 CSPRNG (explicit key: the exact sequence incl. the key erasure refills and mixIn; system seeded: properties that cannot fail by chance), seeds from the system
import cstdio;
import cstring;
import asys;
import rng;

int fails = 0;
void check(bool cond, char* what) {
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

// A long run with an explicit key: the XOR and the sum of 150000 words (about 1.2 MB, past the 1 MiB mark where a system seeded generator reseeds) and
// the last word; then mixIn. The expected text was produced by a Python implementation.
void fixedKey() {
    char key[32];
    for (int i = 0; i < 32; i++) { key[i] = 255 - i * 3; }
    rng.ChaCha20Rng c(&key[0]);
    uint64 x = 0;
    uint64 sum = 0;
    uint64 last = 0;
    for (int i = 0; i < 150000; i++) {
        uint64 v = c.nextU64();
        x = x ^ v;
        sum = sum + v;
        last = v;
    }
    printf("chacha20 150000 words: xor %u sum %u last %u\n", x, sum, last);
    // mixIn: three words, then the key is XORed with 32 bytes and the buffered output is dropped
    rng.ChaCha20Rng d(&key[0]);
    printf("chacha20 before mixIn: %u %u %u\n", d.nextU64(), d.nextU64(), d.nextU64());
    char data[40];
    for (int i = 0; i < 40; i++) { data[i] = i * 7; }
    d.mixIn(&data[0], 40);
    printf("chacha20 after mixIn: %u %u %u\n", d.nextU64(), d.nextU64(), d.nextU64());
    // the same with only 5 bytes of data: the rest of the key stays
    rng.ChaCha20Rng e(&key[0]);
    e.nextU64();
    e.mixIn(&data[0], 5);
    printf("chacha20 after mixIn of 5 bytes: %u\n", e.nextU64());
    c.dispose();
    d.dispose();
    e.dispose();
    // seedBytes replaces the key and restarts the sequence
    rng.ChaCha20Rng f(&key[0]);
    uint64 first = f.nextU64();
    f.nextU64();
    f.seedBytes(&key[0]);
    check(f.nextU64() == first, "seedBytes restarts the sequence");
    f.dispose();
}

// ---- system seeded: properties ---------------------------------------------------------------------------------------------------------
void systemChecks() {
    // two generators from the system: different streams
    rng.ChaCha20Rng a;
    rng.ChaCha20Rng b;
    check(a.nextU64() != b.nextU64() || a.nextU64() != b.nextU64(), "two system seeded generators differ");
    // a zeroed object works at once, and after dispose it reseeds
    rng.ChaCha20Rng z;
    uint64 v1 = z.nextU64();
    z.dispose();
    uint64 v2 = z.nextU64();
    check(v1 != v2, "after dispose() the generator reseeds from the system");
    // reseedFromSystem changes the stream
    rng.ChaCha20Rng r;
    char key[32];
    for (int i = 0; i < 32; i++) { key[i] = i; }
    rng.ChaCha20Rng k(&key[0]);
    uint64 w1 = k.nextU64();
    k.reseedFromSystem();
    uint64 w2 = k.nextU64();
    k.seedBytes(&key[0]);
    check(k.nextU64() == w1 && w2 != w1, "reseedFromSystem leaves the fixed sequence; seedBytes brings it back");
    // 1.3 MB from a system seeded generator: crosses the automatic reseed and stays random
    int ones = 0;
    int total = 0;
    int counts[256];
    for (int i = 0; i < 160000; i++) {
        uint64 v = a.nextU64();
        for (int s = 0; s < 64; s += 8) { counts[(v >> s) & 255]++; }
        if ((i % 4) == 0) {
            for (int s = 0; s < 64; s++) { if (((v >> s) & 1) != 0) { ones++; } total++; }
        }
    }
    // 160000 words * 64 / 4 = 2560000 bits: sigma about 800
    int dev = ones - total / 2;
    if (dev < 0) { dev = -dev; }
    check(dev < 6000, "monobit test over 2.5 million bits");
    // bytes: 1280000 values over 256 cells, expected 5000 each: chi-square with 255 degrees of freedom (mean 255, sigma 22.6)
    double stat = 0.0;
    for (int i = 0; i < 256; i++) {
        double d = (double) counts[i] - 5000.0;
        stat = stat + d * d / 5000.0;
    }
    check(stat < 450.0, "byte frequencies (chi-square)");
    // the shared generator
    rng.Rng* s1 = rng.system();
    rng.Rng* s2 = rng.system();
    check(s1 == s2 && s1 != null, "rng.system() is one shared generator");
    int below = s1->below(10);
    check(below >= 0 && below < 10, "rng.system()->below(10)");
    // a plain Rng uses it
    rng.Rng plain;
    check(plain.nextU64() != plain.nextU64() || plain.nextU64() != plain.nextU64(), "Rng without a generator uses the system generator");
    // seeds
    check(rng.systemSeed() != rng.systemSeed(), "two system seeds differ");
    check(rng.timeSeed() != rng.timeSeed(), "two time seeds differ (the call counter is mixed in)");
    // seeding another generator from the system gives different sequences
    rng.Xoshiro256 g1(rng.systemSeed());
    rng.Xoshiro256 g2(rng.systemSeed());
    check(g1.nextU64() != g2.nextU64(), "generators seeded from the system differ");
    rng.Pcg64 p1(rng.systemSeed(), rng.systemSeed());
    rng.Pcg64 p2(rng.systemSeed(), rng.systemSeed());
    check(p1.nextU64() != p2.nextU64(), "Pcg64 seeded from the system differs");
    // fillBytes on the system generator and uuids
    char buf[64];
    char zeros[64];
    memset(&buf[0], 0, 64);
    memset(&zeros[0], 0, 64);
    a.fillBytes(&buf[0], 64);
    check(memcmp(&buf[0], &zeros[0], 64) != 0, "64 system random bytes are not all zero");
    a.dispose();
    b.dispose();
    z.dispose();
    r.dispose();
    k.dispose();
}

int main() {
    fixedKey();
    systemChecks();
    check(asys.memBadFrees() == 0, "no bad free");
    printf(fails == 0 ? "OK\n" : "FAILED\n");
    return fails;
}
