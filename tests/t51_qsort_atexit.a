// qsort / bsearch / atexit (function pointers) and the exit-time work of exit
import cstdlib;
import cstring;

int cmpInt(char* a, char* b) {
    int x = ((int*) a)[0];
    int y = ((int*) b)[0];
    if (x < y) return -1;
    if (x > y) return 1;
    return 0;
}

int cmpStr(char* a, char* b) {
    return strcmp(((char**) a)[0], ((char**) b)[0]);
}

int cmpByte(char* a, char* b) {
    return a[0] - b[0];
}

void bye() { println("bye 1"); }
void bye2() { println("bye 2"); }

int main() {
    atexit(bye);
    atexit(bye2);
    int n = 2000;
    int* v = (int*) malloc(n * 8);
    srand(5);
    for (int i = 0; i < n; i++) v[i] = rand() % 1000 - 500;
    qsort((char*) v, n, 8, cmpInt);
    int ok = 1;
    for (int i = 1; i < n; i++) if (v[i - 1] > v[i]) ok = 0;
    printf("sorted ints: %d\n", ok);
    // already sorted / reversed / equal elements (worst cases for naive quicksort)
    for (int i = 0; i < n; i++) v[i] = i;
    qsort((char*) v, n, 8, cmpInt);
    for (int i = 0; i < n; i++) v[i] = n - i;
    qsort((char*) v, n, 8, cmpInt);
    ok = 1; for (int i = 1; i < n; i++) if (v[i - 1] > v[i]) ok = 0;
    for (int i = 0; i < n; i++) v[i] = 7;
    qsort((char*) v, n, 8, cmpInt);
    printf("worst cases: %d %d\n", ok, v[0] == 7);
    char* words[6];
    words[0] = "pear"; words[1] = "apple"; words[2] = "fig"; words[3] = "banana"; words[4] = "cherry"; words[5] = "date";
    qsort((char*) words, 6, 8, cmpStr);
    for (int i = 0; i < 6; i++) printf("%s ", words[i]);
    printf("\n");
    char* key = "fig";
    char* found = bsearch((char*) &key, (char*) words, 6, 8, cmpStr);
    printf("found %d\n", found != null);
    key = "zzz";
    printf("not found %d\n", bsearch((char*) &key, (char*) words, 6, 8, cmpStr) == null);
    char text[20];
    strcpy(text, "qsort with bytes");
    qsort(text, strlen(text), 1, cmpByte);
    printf("[%s]\n", text);
    int target = 42;
    for (int i = 0; i < n; i++) v[i] = i * 3;
    int k = 300;
    printf("%d\n", bsearch((char*) &k, (char*) v, n, 8, cmpInt) != null);
    k = 301;
    printf("%d\n", bsearch((char*) &k, (char*) v, n, 8, cmpInt) != null);
    return 0;
}
