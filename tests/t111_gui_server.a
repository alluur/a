// the display server and the gui toolkit working together in one process: windows, widgets, mouse, keyboard,
// title bar actions, clipboard, several clients
import wsrv;
import gui;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
int clicks = 0;
int checks = 0;
int closes = 0;
int selected = -1;
int sliderValue = -1;
int entered = 0;
int resizes = 0;

int stepServer(int unused) {
    srv->step(0);
    return 0;
}

void settle(gui.Display* a, gui.Display* b) {
    for (int i = 0; i < 12; i++) {
        srv->step(0);
        a->pump(0);
        if (b != null) {
            b->pump(0);
        }
    }
}

int onClick(int self) { clicks++; return 0; }
int onCheck(int self) { checks++; return 0; }
int onSelect(int self) { gui.ListBox* l = (gui.ListBox*) self; selected = l->selected; return 0; }
int onSlide(int self) { gui.Slider* s = (gui.Slider*) self; sliderValue = s->value; return 0; }
int onEnter(int self) { entered++; return 0; }
int onClose(int self) { closes++; return 0; }
int onResize(int self) { resizes++; return 0; }

int main() {
    hb = new wsrv.Headless(640, 480);
    srv = new wsrv.Server(hb, 7211);
    srv->allowScreenshots = true;
    gui.idleHook = stepServer;
    gui.Display* d = gui.connectAs("7211", "test");
    printlnInt(d->screenW * 1000 + d->screenH);
    printlnInt(d->clientNum);

    // a window with every widget
    gui.Window* w = d->createWindow("Widgets", 300, 340, 0);
    gui.Box* col = gui.vbox(6, 10);
    col->add(new gui.Label("A label"));
    gui.Button* button = new gui.Button("Press");
    button->onClick = onClick;
    col->add(button);
    gui.CheckBox* check = new gui.CheckBox("Option");
    check->onChange = onCheck;
    col->add(check);
    gui.Slider* slider = new gui.Slider(0, 100);
    slider->onChange = onSlide;
    col->add(slider);
    gui.ProgressBar* bar = new gui.ProgressBar();
    bar->setValue(40);
    col->add(bar);
    gui.ListBox* list = new gui.ListBox();
    list->onSelect = onSelect;
    list->addItem("one");
    list->addItem("two");
    list->addItem("three");
    list->addItem("four");
    col->add(list);
    col->add(new gui.Separator());
    gui.TextBox* tb = new gui.TextBox();
    tb->placeholder = "name";
    tb->onEnter = onEnter;
    col->add(tb);
    w->setRoot(col);
    w->onClose = onClose;
    w->onResize = onResize;
    settle(d, null);
    printlnInt(srv->windowCount());
    wsrv.Win* sw = srv->windowAt(0);
    printlnInt(sw->x * 1000 + sw->y);
    printlnInt(sw->w * 1000 + sw->h);
    printlnInt(srv->screen->checksum());

    // mouse: button, checkbox, slider, list
    int ox = sw->x;
    int oy = sw->y;
    hb->click(ox + button->absX() + 10, oy + button->absY() + 8);
    settle(d, null);
    printlnInt(clicks);
    hb->click(ox + check->absX() + 8, oy + check->absY() + 8);
    settle(d, null);
    printlnInt(checks * 10 + (check->checked ? 1 : 0));
    hb->moveTo(ox + slider->absX() + 8 + (slider->w - 16) / 2, oy + slider->absY() + 10);
    hb->buttonDown(1);
    hb->moveTo(ox + slider->absX() + 8 + (slider->w - 16) * 3 / 4, oy + slider->absY() + 10);
    hb->buttonUp(1);
    settle(d, null);
    printlnInt(sliderValue);
    hb->click(ox + list->absX() + 20, oy + list->absY() + 1 + 3 + 2 * (gfx.sans()->height + 6) - 10);
    settle(d, null);
    printlnInt(selected);
    hb->tap(adp.KEY_DOWN, 0);
    settle(d, null);
    printlnInt(selected);

    // keyboard: the text box
    hb->click(ox + tb->absX() + 10, oy + tb->absY() + 8);
    settle(d, null);
    hb->typeText("Hej Aytict");
    hb->tap(adp.KEY_BACKSPACE, 0);
    hb->tap(adp.KEY_LEFT, 0);
    hb->typeText("X");
    hb->tap(adp.KEY_ENTER, 13);
    settle(d, null);
    println(tb->text());
    printlnInt(entered);

    // clipboard: select all, copy, paste at the end
    hb->keyDown(adp.KEY_CTRL, 0);
    hb->tap('a', 'a');
    hb->tap('c', 'c');
    hb->keyUp(adp.KEY_CTRL, 0);
    hb->tap(adp.KEY_END, 0);
    hb->keyDown(adp.KEY_CTRL, 0);
    hb->tap('v', 'v');
    hb->keyUp(adp.KEY_CTRL, 0);
    settle(d, null);
    println(tb->text());

    // Tab moves the focus
    hb->tap(adp.KEY_TAB, 0);
    settle(d, null);
    printlnInt(w->focusWidget == tb);

    // the title bar: drag the window
    int tx = ox + 60;
    int ty = oy - 12;
    hb->moveTo(tx, ty);
    hb->buttonDown(1);
    hb->moveTo(tx + 100, ty + 50);
    hb->buttonUp(1);
    settle(d, null);
    printlnInt(sw->x * 1000 + sw->y);

    // resize with the grip at the bottom right of the client area
    int gx = sw->x + sw->w - 4;
    int gy = sw->y + sw->h - 4;
    hb->moveTo(gx, gy);
    hb->buttonDown(1);
    hb->moveTo(gx + 40, gy + 30);
    hb->buttonUp(1);
    settle(d, null);
    printlnInt(sw->w * 1000 + sw->h);
    printlnInt(w->w * 1000 + w->h);
    printlnInt(resizes > 0);

    // the close button asks the program, which allows it
    int cx = sw->x + sw->w + 2 - 12;
    int cy = sw->y - 26 + 13;
    hb->click(cx, cy);
    settle(d, null);
    printlnInt(closes);
    printlnInt(srv->windowCount());

    // two clients, two windows, Alt+Tab
    gui.Display* d2 = gui.connectAs("7211", "second");
    printlnInt(srv->clientCount());
    gui.Window* a = d->createWindow("First", 120, 80, 0);
    gui.Window* b = d2->createWindow("Second", 120, 80, 0);
    settle(d, d2);
    printlnInt(srv->windowCount());
    printlnInt(srv->focus != null && srv->focus->owner->num == d2->clientNum);
    hb->keyDown(adp.KEY_ALT, 0);
    hb->tap(adp.KEY_TAB, 0);
    hb->keyUp(adp.KEY_ALT, 0);
    settle(d, d2);
    printlnInt(srv->focus != null && srv->focus->owner->num == d->clientNum);
    printlnInt(a->focused);
    printlnInt(b->focused);

    // leaving: the windows of a client go with it
    d2->disconnect();
    settle(d, null);
    printlnInt(srv->clientCount());
    printlnInt(srv->windowCount());
    srv->close();
    return 0;
}
