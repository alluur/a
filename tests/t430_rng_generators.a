// rng: the exact sequences of SplitMix64, xoshiro256**, PCG32, PCG64, MT19937 (also Python's seeding) and the ChaCha20 CSPRNG. The expected output
// was produced by independent Python implementations (checked against NumPy, Python's random, the RFC 8439 vector and the PCG demo vector).
import cstdio;
import cstring;
import asys;
import rng;

int fails = 0;
void check(bool cond, char* what) {
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

void line64(char* label, rng.Rng* g, int n) {
    printf("%s:", label);
    for (int i = 0; i < n; i++) { printf(" %u", g->nextU64()); }
    printf("\n");
}

void main1() {
    rng.SplitMix64 a(1234567);
    line64("splitmix64 1234567", &a, 5);
    rng.SplitMix64 b(0);
    line64("splitmix64 0", &b, 3);
    rng.SplitMix64 c(18446744073709551615);
    line64("splitmix64 max", &c, 3);

    rng.Xoshiro256 x(1);
    line64("xoshiro256** 1", &x, 6);
    rng.Xoshiro256 y(18446744073709551615);
    line64("xoshiro256** max", &y, 3);
    rng.Xoshiro256 z(1);
    z.jump();
    line64("xoshiro256** 1 jump", &z, 3);
    rng.Xoshiro256 w(1);
    w.longJump();
    line64("xoshiro256** 1 longJump", &w, 3);
    rng.Xoshiro256 st(0);
    st.setState(1, 2, 3, 4);
    line64("xoshiro256** state 1 2 3 4", &st, 4);
    check(st.getState(0) != 1 || true, "getState");
}

void main2() {
    rng.Pcg32 p(42, 54);
    printf("pcg32 42 54:");
    for (int i = 0; i < 6; i++) { printf(" %x", p.nextU32()); }
    printf("\n");
    rng.Pcg32 q(7, 1);
    printf("pcg32 7 1:");
    for (int i = 0; i < 4; i++) { printf(" %x", q.nextU32()); }
    printf("\n");
    rng.Pcg32 r(42, 54);
    line64("pcg32 42 54 as u64", &r, 3);
    rng.Pcg32 d;                                   // the default pair (42, 54)
    printf("pcg32 default: %x\n", d.nextU32());

    rng.Pcg64 a(42, 54);
    line64("pcg64 42 54", &a, 5);
    rng.Pcg64 b(0, 0);
    line64("pcg64 0 0", &b, 3);
    rng.Pcg64 c(0, 0);
    c.seed128(1, 2, 3, 4);
    line64("pcg64 seed128 1 2 3 4", &c, 3);
    rng.Pcg64 e(0, 0);
    e.setState(0, 42, 0, 109);                  // the state of Pcg64(42, 54) is not this one: 109 = (54 << 1) | 1 is the increment
    line64("pcg64 setState 0 42 0 109", &e, 3);
    rng.Pcg64 u;                                   // zeroed object works: same as Pcg64(0, 0)
    line64("pcg64 default", &u, 2);
}

void main3() {
    rng.Mt19937 a(5489);
    printf("mt19937 5489:");
    for (int i = 0; i < 6; i++) { printf(" %u", a.nextU32()); }
    printf("\n");
    rng.Mt19937 b(5489);
    printf("mt19937 5489 res53:");
    for (int i = 0; i < 3; i++) { printf(" %d", (int) (b.nextDouble() * 9007199254740992.0)); }
    printf("\n");
    rng.Mt19937 c(0);
    int key[4] = { 0x123, 0x234, 0x345, 0x456 };
    c.seedArray(&key[0], 4);
    printf("mt19937 array:");
    for (int i = 0; i < 5; i++) { printf(" %u", c.nextU32()); }
    printf("\n");
    rng.Mt19937 d(0);
    d.seedPython(12345);
    printf("mt19937 python 12345:");
    for (int i = 0; i < 5; i++) { printf(" %u", d.nextU32()); }
    printf("\n");
    d.seedPython(12345);
    printf("mt19937 python 12345 res53:");
    for (int i = 0; i < 3; i++) { printf(" %d", (int) (d.nextDouble() * 9007199254740992.0)); }
    printf("\n");
    d.seedPython(-7);
    printf("mt19937 python -7:");
    for (int i = 0; i < 3; i++) { printf(" %u", d.nextU32()); }
    printf("\n");
    d.seedPython(7);
    printf("mt19937 python 7:");
    for (int i = 0; i < 3; i++) { printf(" %u", d.nextU32()); }
    printf("\n");
    d.seedPython(1099511627781);                  // 2^40 + 5: two 32 bit key words
    printf("mt19937 python 2^40+5:");
    for (int i = 0; i < 3; i++) { printf(" %u", d.nextU32()); }
    printf("\n");
    d.seedPython(0);
    printf("mt19937 python 0:");
    for (int i = 0; i < 3; i++) { printf(" %u", d.nextU32()); }
    printf("\n");
    rng.Mt19937 e(5489);
    line64("mt19937 5489 as u64", &e, 2);
    rng.Mt19937 f;                                 // zeroed object: seed 5489
    printf("mt19937 default: %u\n", f.nextU32());
    check(a.nextU32() >= 0, "mt");
    a.dispose();
    d.dispose();
    e.dispose();
    f.dispose();
    b.dispose();
    c.dispose();
}

void main4() {
    char key[32];
    for (int i = 0; i < 32; i++) { key[i] = i; }
    rng.ChaCha20Rng a(&key[0]);
    line64("chacha20 key 0..31", &a, 5);
    char zero[32];
    memset(&zero[0], 0, 32);
    rng.ChaCha20Rng b(&zero[0]);
    printf("chacha20 zero key words 0..2:");
    for (int i = 0; i < 3; i++) { printf(" %u", b.nextU64()); }
    printf("\n");
    // across the refill: a block holds 124 words
    printf("chacha20 zero key words 3..:");
    uint64 w[130];
    rng.ChaCha20Rng c(&zero[0]);
    for (int i = 0; i < 130; i++) { w[i] = c.nextU64(); }
    printf(" %u %u %u %u %u %u\n", w[122], w[123], w[124], w[125], w[126], w[129]);
    rng.ChaCha20Rng d(&zero[0]);
    d.seedUint64(1234567);
    line64("chacha20 seedUint64 1234567", &d, 3);
    a.dispose();
    b.dispose();
    c.dispose();
    d.dispose();
}

void properties() {
    // the same seed twice gives the same sequence; a different seed a different one
    rng.Xoshiro256 a(99);
    rng.Xoshiro256 b(99);
    rng.Xoshiro256 c(100);
    bool same = true;
    bool differ = false;
    for (int i = 0; i < 100; i++) {
        uint64 va = a.nextU64();
        if (va != b.nextU64()) { same = false; }
        if (va != c.nextU64()) { differ = true; }
    }
    check(same && differ, "xoshiro256**: same seed same sequence, different seed different sequence");
    // jump() produces a state far from the start but a deterministic one: two jumps from the same seed agree
    rng.Xoshiro256 j1(5);
    rng.Xoshiro256 j2(5);
    j1.jump();
    j2.jump();
    check(j1.nextU64() == j2.nextU64() && j1.getState(0) == j2.getState(0), "jump is deterministic");
    // an all zero state is refused
    rng.Xoshiro256 z(1);
    z.setState(0, 0, 0, 0);
    check(z.nextU64() != 0 || z.nextU64() != 0, "all zero state replaced");
    // Pcg32: different streams give different sequences
    rng.Pcg32 s1(5, 1);
    rng.Pcg32 s2(5, 2);
    check(s1.nextU32() != s2.nextU32() || s1.nextU32() != s2.nextU32(), "pcg32 streams differ");
    // the base class works without a generator (system CSPRNG) and two draws differ
    rng.Rng r;
    check(r.nextU64() != r.nextU64(), "Rng without a generator draws from the system");
    // fillBytes is little endian words of nextU64
    rng.SplitMix64 g1(1234567);
    rng.SplitMix64 g2(1234567);
    char buf[16];
    g1.fillBytes(&buf[0], 13);
    uint64 first = g2.nextU64();
    uint64 second = g2.nextU64();
    bool ok = true;
    for (int i = 0; i < 8; i++) { if (buf[i] != ((first >> (8 * i)) & 255)) { ok = false; } }
    for (int i = 0; i < 5; i++) { if (buf[8 + i] != ((second >> (8 * i)) & 255)) { ok = false; } }
    check(ok, "fillBytes: little endian words, the last word is cut");
    g1.fillBytes(&buf[0], 0);
    check(true, "fillBytes with n = 0");
}

int main() {
    main1();
    main2();
    main3();
    main4();
    properties();
    check(asys.memBadFrees() == 0, "no bad free");
    printf(fails == 0 ? "OK\n" : "FAILED\n");
    return fails;
}
