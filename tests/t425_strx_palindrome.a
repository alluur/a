// strx: Manacher palindromes (radii, longest, count, UTF-8) against brute force
import cstdio;
import cstring;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 123456789;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

bool isPal(char* s, int from, int len) {
    for (int i = 0; i < len / 2; i++) { if (s[from + i] != s[from + len - 1 - i]) { return false; } }
    return true;
}

void randomStrings() {
    char s[80];
    int d1[80];
    int d2[80];
    int bad = 0;
    int badLongest = 0;
    int badCount = 0;
    int badIs = 0;
    for (int round = 0; round < 800; round++) {
        int n = rnd(40);
        int alpha = 1 + rnd(3);
        for (int i = 0; i < n; i++) { s[i] = 'a' + rnd(alpha); }
        s[n] = 0;
        for (int i = 0; i < 80; i++) { d1[i] = -1; d2[i] = -1; }
        if (!strx.manacher(&s[0], n, &d1[0], &d2[0])) { bad++; continue; }
        int total = 0;
        int bestLen = 0;
        int bestAt = 0;
        for (int i = 0; i < n; i++) {
            int o = 0;
            while (i - o >= 0 && i + o < n && s[i - o] == s[i + o]) { o++; }
            int e = 0;
            while (i - e - 1 >= 0 && i + e < n && s[i - e - 1] == s[i + e]) { e++; }
            if (d1[i] != o || d2[i] != e) { bad++; }
            total = total + o + e;
        }
        for (int from = 0; from < n; from++) {
            for (int len = 1; from + len <= n; len++) {
                if (isPal(&s[0], from, len) && len > bestLen) { bestLen = len; bestAt = from; }
            }
        }
        int st = -9;
        int got = strx.longestPalindrome(&s[0], n, &st);
        if (got != bestLen || (n > 0 && st != bestAt)) { badLongest++; }
        if (strx.countPalindromes(&s[0], n) != total) { badCount++; }
        if (strx.isPalindrome(&s[0], n) != isPal(&s[0], 0, n)) { badIs++; }
    }
    check(bad == 0, "manacher radii agree with the definition (800 random strings)");
    check(badLongest == 0, "longestPalindrome: length and (leftmost) start");
    check(badCount == 0, "countPalindromes");
    check(badIs == 0, "isPalindrome");
}

void examples() {
    int st = 0;
    check(strx.longestPalindrome("forgeeksskeegfor", -1, &st) == 10 && st == 3, "geeksskeeg");
    check(strx.longestPalindrome("babad", -1, &st) == 3 && st == 0, "bab (the leftmost)");
    check(strx.longestPalindrome("", -1, &st) == 0 && st == 0, "empty");
    check(strx.longestPalindrome("x", -1, &st) == 1 && st == 0, "one letter");
    check(strx.longestPalindrome("abcd", -1, null) == 1, "no start pointer");
    check(strx.longestPalindrome("racecar and level", 7, &st) == 7 && st == 0, "explicit length");
    check(strx.countPalindromes("aaa", -1) == 6 && strx.countPalindromes("abc", -1) == 3 && strx.countPalindromes("", -1) == 0, "counts");
    check(strx.isPalindrome("", -1) && strx.isPalindrome("a", -1) && strx.isPalindrome("abba", -1) && !strx.isPalindrome("abca", -1) && strx.isPalindrome("abcba", 3) == false, "isPalindrome");
    // UTF-8: "a e-acute a" is a palindrome of 3 characters, 4 bytes; as bytes it is not
    char* s = "a\xc3\xa9" "a";
    check(strx.isPalindrome(s, -1, true) && !strx.isPalindrome(s, -1), "utf8 palindrome versus byte palindrome");
    check(strx.longestPalindrome(s, -1, &st, true) == 4 && st == 0, "utf8: the whole text");
    char* t = "\xc3\xa9\xc3\xa8" "z";
    check(strx.longestPalindrome(t, -1, &st, true) == 2 && st == 0, "utf8: single characters only");
    char* u = "q\xe6\x97\xa5\xe6\x9c\xac\xe6\x97\xa5" "w";        // q, nichi, hon, nichi, w
    check(strx.longestPalindrome(u, -1, &st, true) == 9 && st == 1, "utf8: a three character palindrome, byte start and length");
    check(strx.countPalindromes(u, -1, true) == 6, "utf8: count of palindromes of code points");
    // invalid bytes are symbols of their own
    check(strx.isPalindrome("\xff" "a\xff", -1, true) && !strx.isPalindrome("\xff" "a\xfe", -1, true), "invalid bytes");
    // bytes 0 and 255
    char b[8];
    b[0] = 0; b[1] = 255; b[2] = 0; b[3] = 7;
    check(strx.longestPalindrome(&b[0], 4, &st) == 3 && st == 0, "binary data");
}

void big() {
    int n = 1000000;
    char* t = alloc(n + 1);
    memset(t, 'a', n);
    int st = -1;
    check(strx.longestPalindrome(t, n, &st) == n && st == 0, "a^1000000: the whole text");
    check(strx.countPalindromes(t, n) == n * (n + 1) / 2, "a^1000000: n (n + 1) / 2 palindromes");
    // a long palindrome in the middle of noise
    for (int i = 0; i < n; i++) { t[i] = 'a' + rnd(3); }
    for (int i = 0; i < 20000; i++) { t[400000 + 20000 + i] = t[400000 + 19999 - i]; }
    int len = strx.longestPalindrome(t, n, &st);
    check(len >= 40000 && len <= 40010 && isPal(t, st, len), "a planted palindrome of 40000 letters");
}

int main() {
    randomStrings();
    examples();
    big();
    printf("palindrome: %d checks, %d failures\n", checks, fails);
    return fails;
}
