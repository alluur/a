// operator overloading: arithmetic, comparison, unary minus and chains on class values
import cstdio;


class Vec {
    public int x;
    public int y;
    Vec operator+(Vec o) { return mk(x + o.x, y + o.y); }
    Vec operator-(Vec o) { return mk(x - o.x, y - o.y); }
    Vec operator-() { return mk(-x, -y); }
    Vec operator*(int k) { return mk(x * k, y * k); }
    int operator^(Vec o) { return x * o.x + y * o.y; }
    bool operator==(Vec o) { return x == o.x && y == o.y; }
    bool operator<(Vec o) { return x * x + y * y < o.x * o.x + o.y * o.y; }
    int operator[](int i) { if (i == 0) { return x; } return y; }
}

Vec mk(int x, int y) {
    Vec r;
    r.x = x;
    r.y = y;
    return r;
}

struct Money {
    int cents;
    Money operator+(Money o) { Money r; r.cents = cents + o.cents; return r; }
    bool operator<=(Money o) { return cents <= o.cents; }
}

int main() {
    Vec a = mk(1, 2);
    Vec b = mk(10, 20);
    Vec c = a + b;
    printf("sum %d %d\n", c.x, c.y);
    Vec d = a + b + a;
    printf("chain %d %d\n", d.x, d.y);
    Vec e = b - a;
    printf("diff %d %d\n", e.x, e.y);
    Vec n = -a;
    printf("neg %d %d\n", n.x, n.y);
    Vec s = a * 3;
    printf("scaled %d %d\n", s.x, s.y);
    printf("dot %d\n", a ^ b);
    printf("eq %d %d, ne %d %d\n", a == a, a == b, a != b, a != a);
    printf("lt %d %d\n", a < b, b < a);
    printf("precedence %d\n", (a + b) ^ a);
    printf("with ints %d\n", (a + b).x + 1);
    printf("index %d %d\n", a[0], b[1]);
    Vec acc = mk(1, 1);
    acc += a;
    acc += b;
    acc = acc * 2;
    printf("compound %d %d\n", acc.x, acc.y);
    Money m1; m1.cents = 150;
    Money m2; m2.cents = 275;
    Money t = m1 + m2;
    printf("money %d %d\n", t.cents, m1 <= m2);
    return 0;
}
