// tui: Label, Button, CheckBox and radio buttons, ProgressBar, Slider, StatusBar, focus and mnemonics - driven without a terminal
import tui;
import term;
import tscreen;

tui.App* app;
int clicks;
int changes;

int onClick(int b) { clicks++; return 0; }
int onChange(int c) { changes++; return 0; }

// how many cells of row y have the progress bar's fill style
int filled(int y) {
    int n = 0;
    for (int x = 0; x < app->cols; x++) {
        if (app->screen->styleAt(x, y) == tui.theme->progressFill) { n++; }
    }
    return n;
}

void show(char* title) {
    println(title);
    println(app->text());
}

int main() {
    app = new tui.App();
    app->initHeadless(40, 11);
    tui.Box* col = tui.vbox(0, 0);

    tui.Label* l1 = new tui.Label("A label\nwith two lines");
    col->add(l1);
    tui.Label* l2 = new tui.Label("centred");
    l2->align = 1;
    col->add(l2);
    tui.Label* l3 = new tui.Label("right aligned");
    l3->align = 2;
    col->add(l3);
    tui.Button* b = new tui.Button("&Save");
    b->onClick = onClick;
    b->halign = 1;
    col->add(b);
    tui.CheckBox* c1 = new tui.CheckBox("&Wrap lines");
    c1->onChange = onChange;
    col->add(c1);
    tui.CheckBox* r1 = new tui.CheckBox("one");
    tui.CheckBox* r2 = new tui.CheckBox("two");
    r1->radio = true; r2->radio = true;
    r1->name = "g"; r2->name = "g";
    r1->checked = true;
    col->add(r1);
    col->add(r2);
    tui.ProgressBar* pb = new tui.ProgressBar();
    pb->setValue(40);
    col->add(pb);
    tui.Slider* sl = new tui.Slider();
    sl->max = 10;
    sl->value = 3;
    sl->onChange = onChange;
    col->add(sl);
    tui.StatusBar* sb = new tui.StatusBar();
    sb->set(0, "ready");
    sb->set(1, "line 3", 2);
    col->add(sb);
    app->setRoot(col);
    app->pump(0);
    show("-- the first frame");
    printf("focus: %s\n", app->focus == b ? "the button" : "something else");

    println("-- Tab walks over the widgets that can take the focus");
    app->press("Tab");
    printf("%d %d\n", app->focus == c1, app->focus == sl);
    app->press("Tab");
    printf("%d %d %d\n", app->focus == r1, app->focus == r2, app->focus == sl);
    app->press("Tab");
    app->press("Tab");
    printf("slider: %d, wraps to the button: ", app->focus == sl);
    app->press("Tab");
    printf("%d\n", app->focus == b);
    app->press("Shift+Tab");
    printf("Shift+Tab goes back to the slider: %d\n", app->focus == sl);

    println("-- the button: Enter, Space, mouse, mnemonic");
    app->press("Tab");
    app->press("Enter");
    app->press("Space");
    printf("clicks after Enter and Space: %d\n", clicks);
    app->click(2, 4);
    printf("after a mouse click: %d\n", clicks);
    app->mouseDown(2, 4);
    app->mouseUp(20, 9);                         // released somewhere else: no click
    printf("press here, release elsewhere: %d\n", clicks);
    app->press("Alt+S");
    printf("Alt+S: %d\n", clicks);
    b->setEnabled(false);
    app->press("Alt+S");
    app->click(2, 4);
    printf("disabled: %d\n", clicks);
    b->setEnabled(true);

    println("-- the check box");
    app->press("Alt+W");
    printf("checked %d, changes %d\n", c1->checked, changes);
    app->click(3, 5);
    printf("checked %d, changes %d\n", c1->checked, changes);
    show("-- the screen now");

    println("-- radio buttons: one at a time");
    app->click(2, 7);
    printf("one %d two %d\n", r1->checked, r2->checked);
    app->click(2, 6);
    printf("one %d two %d\n", r1->checked, r2->checked);
    app->press("Space");
    printf("Space on a radio button keeps it checked: one %d\n", r1->checked);

    println("-- the slider");
    sl->focusMe();
    changes = 0;
    app->press("Right");
    app->press("Right");
    printf("value %d, changes %d\n", sl->value, changes);
    app->press("Home");
    printf("Home %d, ", sl->value);
    app->press("End");
    printf("End %d, ", sl->value);
    app->press("Right");
    printf("stays at the end: %d\n", sl->value);
    app->click(0, 9);
    printf("click at the left end: %d\n", sl->value);
    app->click(39, 9);
    printf("click at the right end: %d\n", sl->value);
    app->mouseDown(19, 9);
    app->mouseDrag(10, 9);
    app->mouseUp(10, 9);
    printf("drag: %d\n", sl->value);

    println("-- progress bar: filled cells are counted by their style");
    pb->setValue(100);
    app->pump(0);
    printf("100%%: %d filled of 40\n", filled(8));
    pb->setValue(0);
    app->pump(0);
    printf("0%%: %d filled\n", filled(8));
    pb->setValue(50);
    app->pump(0);
    printf("50%%: %d filled, text %s\n", filled(8), "50%");
    pb->indeterminate = true;
    int blocks[3];
    for (int i = 0; i < 3; i++) {
        pb->step();
        app->pump(0);
        blocks[i] = filled(8);
    }
    printf("indeterminate: a block of %d cells, then %d, %d\n", blocks[0], blocks[1], blocks[2]);
    pb->setValue(250);
    printf("clamped: %d\n", pb->value);

    println("-- the status bar: a message replaces the segments until it expires");
    sb->message("saved!", 500);
    app->pump(0);
    println(app->text());
    app->advanceClock(600);
    app->pump(0);
    println(app->text());
    return 0;
}
