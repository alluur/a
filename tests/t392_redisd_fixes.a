// redisd against the review findings of stage net2: the replies of the new and the corrected commands (the reply bytes are those of Redis 7.0.15, which was
// run with the same commands), memory accounting that follows the real heap, APPEND and ZADD that do not slow down with the size of the value, backpressure
// (a client that pipelines commands with big replies is not cut off, the commands wait until it has read), and pause / resume over TLS.
import redis;
import redisd;
import netio;
import net;
import tls;
import x509;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

redisd.Store* st;
redisd.Rclient* cl;
int now = 1000000;

void show(char* d, int n) {
    for (int i = 0; i < n; i++) {
        int c = d[i] & 255;
        if (c == 13) print("\\r");
        else if (c == 10) print("\\n");
        else if (c < 32 || c > 126) printf("\\x%02x", c, 0, 0, 0);
        else printChar(c);
    }
}

bool same(netio.Queue* q, char* want) {
    int n = strlen(want);
    return q->pending() == n && memcmp(q->data(), want, n) == 0;
}

bool exOn(redisd.Rclient* c, char* line, char* want) {
    c->out->clear();
    char buf[2048];
    int n = format(&buf[0], 2048, "%s\r\n", line, 0, 0, 0);
    st->feedAt(c, &buf[0], n);
    bool ok = same(c->out, want);
    if (!ok) {
        print("     got:    ");
        show(c->out->data(), c->out->pending());
        print("\n     wanted: ");
        show(want, strlen(want));
        print("\n");
    }
    c->out->clear();
    return ok;
}

void ex(char* line, char* want) {
    check(line, exOn(cl, line, want));
}

// feeds a text (it may hold several commands in RESP or inline form) and returns the reply bytes as a string in a static buffer
char reply[70000];
char* feedText(redisd.Rclient* c, char* text, int n) {
    c->out->clear();
    st->feedAt(c, text, n);
    int m = c->out->pending();
    if (m > 69999) m = 69999;
    memcpy(&reply[0], c->out->data(), m);
    reply[m] = 0;
    c->out->clear();
    return &reply[0];
}

int rnd = 12345;
int rand31() {
    rnd = (rnd * 1103515245 + 12345) & 0x7FFFFFFF;
    return rnd >> 4;
}

// the bulk strings of an array reply: how many, and where they are (pointers into q)
int parseBulks(netio.Queue* q, char** at, int* lens, int max) {
    char* d = q->data();
    int n = q->pending();
    int pos = 0;
    if (n < 4 || d[0] != '*') return -1;
    int cnt = 0;
    pos = 1;
    while (pos < n && d[pos] != 13) { cnt = cnt * 10 + (d[pos] - '0'); pos++; }
    pos = pos + 2;
    for (int i = 0; i < cnt && i < max; i++) {
        if (pos >= n || d[pos] != '$') return -1;
        pos++;
        int len = 0;
        while (pos < n && d[pos] != 13) { len = len * 10 + (d[pos] - '0'); pos++; }
        pos = pos + 2;
        at[i] = &d[pos];
        lens[i] = len;
        pos = pos + len + 2;
    }
    return cnt;
}

// a compare of two members the way the sorted set orders them (bytes)
int cmpBytes(char* a, int la, char* b, int lb) {
    int n = la < lb ? la : lb;
    int r = memcmp(a, b, n);
    if (r != 0) return r;
    return la - lb;
}

redisd.Server* srv;
tls.Config* goodCfg;

int hook() {
    if (srv != null) srv->poll(0);
    return 0;
}

int main() {
    st = new redisd.Store();
    st->setClock(now);
    cl = st->open();
    check("a client", cl != null);

    // ---- the replies of corrected and new commands (Redis 7.0.15 gave these bytes) ----------------------------------------------------------------------------------------
    ex("FLUSHALL", "+OK\r\n");
    // integers are written the way Redis writes them: no leading zeros, no -0, no plus sign
    ex("SET n 10", "+OK\r\n");
    ex("INCRBY n 07", "-ERR value is not an integer or out of range\r\n");
    ex("INCRBY n -0", "-ERR value is not an integer or out of range\r\n");
    ex("INCRBY n +5", "-ERR value is not an integer or out of range\r\n");
    ex("DECRBY n 00", "-ERR value is not an integer or out of range\r\n");
    ex("EXPIRE n 07", "-ERR value is not an integer or out of range\r\n");
    ex("LRANGE n 07 1", "-ERR value is not an integer or out of range\r\n");
    ex("SET z 07", "+OK\r\n");
    ex("INCR z", "-ERR value is not an integer or out of range\r\n");
    ex("SET z -0", "+OK\r\n");
    ex("INCR z", "-ERR value is not an integer or out of range\r\n");
    ex("SET z 00", "+OK\r\n");
    ex("DECR z", "-ERR value is not an integer or out of range\r\n");
    ex("SET z -9223372036854775808", "+OK\r\n");
    ex("DECR z", "-ERR increment or decrement would overflow\r\n");
    ex("DECRBY n -9223372036854775808", "-ERR decrement would overflow\r\n");
    ex("INCRBY n -9223372036854775808", ":-9223372036854775798\r\n");
    ex("SET big 9223372036854775807", "+OK\r\n");
    ex("INCR big", "-ERR increment or decrement would overflow\r\n");
    // SET: EX and PX together or twice, GET, NX / XX with GET
    ex("SET k v EX 10 PX 10", "-ERR syntax error\r\n");
    ex("SET k v EX 10 KEEPTTL", "-ERR syntax error\r\n");
    ex("SET k v KEEPTTL EX 10", "-ERR syntax error\r\n");
    ex("SET k v NX XX", "-ERR syntax error\r\n");
    ex("SET k v XX NX", "-ERR syntax error\r\n");
    ex("SET k v EX 10 EX 20", "+OK\r\n");
    ex("SET k v PX 100000 PX 200000", "+OK\r\n");
    ex("SET k v GET", "$1\r\nv\r\n");
    ex("SET k v2 GET", "$1\r\nv\r\n");
    ex("SET k v3 NX GET", "$2\r\nv2\r\n");
    ex("SET k v4 XX GET", "$2\r\nv2\r\n");
    ex("GET k", "$2\r\nv4\r\n");
    ex("DEL k", ":1\r\n");
    ex("SET k v XX GET", "$-1\r\n");
    ex("SET k v NX GET", "$-1\r\n");
    ex("GET k", "$1\r\nv\r\n");
    ex("RPUSH lst a", ":1\r\n");
    ex("SET lst x GET", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("SET lst x NX GET", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("TYPE lst", "+list\r\n");
    ex("SET k v EX abc", "-ERR value is not an integer or out of range\r\n");
    ex("SET k v EX 0", "-ERR invalid expire time in 'set' command\r\n");
    ex("SET k v EX -5", "-ERR invalid expire time in 'set' command\r\n");
    ex("SET k v EX 9223372036854775807", "-ERR invalid expire time in 'set' command\r\n");
    ex("SET k v PX 9223372036854775807", "-ERR invalid expire time in 'set' command\r\n");
    ex("SET k v EX 10 GET", "$1\r\nv\r\n");
    // SETEX / PSETEX
    ex("SETEX k 0 v", "-ERR invalid expire time in 'setex' command\r\n");
    ex("SETEX k -1 v", "-ERR invalid expire time in 'setex' command\r\n");
    ex("PSETEX k 0 v", "-ERR invalid expire time in 'psetex' command\r\n");
    ex("PSETEX k -5 v", "-ERR invalid expire time in 'psetex' command\r\n");
    ex("SETEX k x v", "-ERR value is not an integer or out of range\r\n");
    ex("PSETEX k x v", "-ERR value is not an integer or out of range\r\n");
    ex("PSETEX k 9223372036854775807 v", "-ERR invalid expire time in 'psetex' command\r\n");
    ex("SETEX k 9223372036854775807 v", "-ERR invalid expire time in 'setex' command\r\n");
    // EXPIRE / PEXPIRE with NX XX GT LT
    ex("SET e v", "+OK\r\n");
    ex("EXPIRE e 100 NX", ":1\r\n");
    ex("EXPIRE e 200 NX", ":0\r\n");
    ex("EXPIRE e 200 XX", ":1\r\n");
    ex("EXPIRE e 100 GT", ":0\r\n");
    ex("EXPIRE e 300 GT", ":1\r\n");
    ex("EXPIRE e 100 LT", ":1\r\n");
    ex("EXPIRE e 400 LT", ":0\r\n");
    ex("EXPIRE e 100 NX XX", "-ERR NX and XX, GT or LT options at the same time are not compatible\r\n");
    ex("EXPIRE e 100 GT LT", "-ERR GT and LT options at the same time are not compatible\r\n");
    ex("EXPIRE e 100 NX GT", "-ERR NX and XX, GT or LT options at the same time are not compatible\r\n");
    ex("EXPIRE e 100 FOO", "-ERR Unsupported option FOO\r\n");
    ex("EXPIRE e 100 nx", ":0\r\n");
    ex("EXPIRE e abc", "-ERR value is not an integer or out of range\r\n");
    ex("EXPIRE e 100 xx", ":1\r\n");
    ex("SET f v", "+OK\r\n");
    ex("EXPIRE f 100 XX", ":0\r\n");
    ex("EXPIRE f 100 GT", ":0\r\n");
    ex("EXPIRE f 100 LT", ":1\r\n");
    ex("PEXPIRE f 5000 NX", ":0\r\n");
    ex("PEXPIRE f 9000 GT", ":0\r\n");
    ex("EXPIRE nokey 100 NX", ":0\r\n");
    ex("EXPIRE nokey 100 FOO", "-ERR Unsupported option FOO\r\n");
    ex("EXPIRE nokey abc", "-ERR value is not an integer or out of range\r\n");
    ex("EXPIRE nokey 9223372036854775807", "-ERR invalid expire time in 'expire' command\r\n");
    ex("PEXPIRE nokey 9223372036854775807", "-ERR invalid expire time in 'pexpire' command\r\n");
    ex("EXPIRE f 9223372036854775807", "-ERR invalid expire time in 'expire' command\r\n");
    ex("PEXPIRE f 9223372036854775807", "-ERR invalid expire time in 'pexpire' command\r\n");
    ex("EXPIRE f -9223372036854775807", "-ERR invalid expire time in 'expire' command\r\n");
    ex("EXPIRE f 0", ":1\r\n");
    ex("EXISTS f", ":0\r\n");
    // the arguments are checked before the type of the key
    ex("SET s str", "+OK\r\n");
    ex("ZADD s NX XX 1 a", "-ERR XX and NX options at the same time are not compatible\r\n");
    ex("ZADD s nan m", "-ERR value is not a valid float\r\n");
    ex("ZADD s 1 a x", "-ERR syntax error\r\n");
    ex("ZADD s abc m", "-ERR value is not a valid float\r\n");
    ex("ZADD s 1e400 m", "-ERR value is not a valid float\r\n");
    ex("ZADD s -1e400 m", "-ERR value is not a valid float\r\n");
    ex("ZADD s FOO 1 a", "-ERR syntax error\r\n");
    ex("ZADD s 1 a", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("LRANGE s 1.5 x", "-ERR value is not an integer or out of range\r\n");
    ex("LRANGE s a 1", "-ERR value is not an integer or out of range\r\n");
    ex("LRANGE s 0 -1", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("LINDEX s x", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("LINDEX s 0", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("LPOP s -1", "-ERR value is out of range, must be positive\r\n");
    ex("LPOP s x", "-ERR value is out of range, must be positive\r\n");
    ex("LPOP s 1", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("ZRANGE s a 1", "-ERR value is not an integer or out of range\r\n");
    ex("ZRANGE s 0 1 FOO", "-ERR syntax error\r\n");
    ex("ZRANGE s 0 1 WITHSCORES", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("ZRANK s a", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("HSET s a 1", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("SADD s a", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    ex("LPUSH s x", "-WRONGTYPE Operation against a key holding the wrong kind of value\r\n");
    // scores: infinity as a word, numbers that overflow or underflow are not valid floats
    ex("ZADD zz 1e400 x", "-ERR value is not a valid float\r\n");
    ex("ZADD zz inf x", ":1\r\n");
    ex("ZADD zz +inf y", ":1\r\n");
    ex("ZADD zz -inf z", ":1\r\n");
    ex("ZADD zz infinity w", ":1\r\n");
    ex("ZADD zz Inf v", ":1\r\n");
    ex("ZADD zz nan u", "-ERR value is not a valid float\r\n");
    ex("ZADD zz 1e308 t", ":1\r\n");
    ex("ZADD zz 1e309 s2", "-ERR value is not a valid float\r\n");
    ex("ZADD zz 0x10 h", ":1\r\n");
    ex("ZADD zz .5 dot", ":1\r\n");
    ex("ZADD zz 5. dot2", ":1\r\n");
    ex("ZADD zz 1e5 e", ":1\r\n");
    ex("ZADD zz 1e-400 under", "-ERR value is not a valid float\r\n");
    ex("ZADD zz 0e5 zero", ":1\r\n");
    ex("ZADD zz 0.0 zero2", ":1\r\n");
    ex("ZRANGE zz 0 -1", "*12\r\n$1\r\nz\r\n$4\r\nzero\r\n$5\r\nzero2\r\n$3\r\ndot\r\n$4\r\ndot2\r\n$1\r\nh\r\n$1\r\ne\r\n$1\r\nt\r\n$1\r\nv\r\n$1\r\nw\r\n$1\r\nx\r\n$1\r\ny\r\n");
    ex("FLUSHALL", "+OK\r\n");
    // HKEYS and HVALS returned the array header and no elements (t381 only looked at the header)
    ex("HSET hh f1 v1", ":1\r\n");
    ex("HKEYS hh", "*1\r\n$2\r\nf1\r\n");
    ex("HVALS hh", "*1\r\n$2\r\nv1\r\n");
    ex("HGETALL hh", "*2\r\n$2\r\nf1\r\n$2\r\nv1\r\n");
    ex("HSET hh f2 v2", ":1\r\n");
    check("HKEYS of two fields: both, whole", exOn(cl, "HKEYS hh", "*2\r\n$2\r\nf1\r\n$2\r\nf2\r\n") || exOn(cl, "HKEYS hh", "*2\r\n$2\r\nf2\r\n$2\r\nf1\r\n"));
    check("HVALS of two fields: both, whole", exOn(cl, "HVALS hh", "*2\r\n$2\r\nv1\r\n$2\r\nv2\r\n") || exOn(cl, "HVALS hh", "*2\r\n$2\r\nv2\r\n$2\r\nv1\r\n"));
    ex("FLUSHALL", "+OK\r\n");
    check("a score with leading white space is not a valid float", streq(feedText(cl, "*4\r\n$4\r\nZADD\r\n$2\r\nzz\r\n$2\r\n 1\r\n$2\r\nsp\r\n", 38), "-ERR value is not a valid float\r\n"));
    check("... nor one with trailing white space", streq(feedText(cl, "*4\r\n$4\r\nZADD\r\n$2\r\nzz\r\n$2\r\n1 \r\n$2\r\nsp\r\n", 38), "-ERR value is not a valid float\r\n"));
    redisd.Rclient* s1 = st->open();
    check("in subscribe mode other commands are refused with Redis' text", exOn(s1, "SUBSCRIBE c", "*3\r\n$9\r\nsubscribe\r\n$1\r\nc\r\n:1\r\n") && exOn(s1, "GET x", "-ERR Can't execute 'get': only (P|S)SUBSCRIBE / (P|S)UNSUBSCRIBE / PING / QUIT / RESET are allowed in this context\r\n"));
    // the times of EXPIRE with options follow the clock of the store
    ex("SET t v", "+OK\r\n");
    ex("EXPIRE t 100 NX", ":1\r\n");
    ex("TTL t", ":100\r\n");
    ex("EXPIRE t 200 GT", ":1\r\n");
    ex("EXPIRE t 50 GT", ":0\r\n");
    ex("EXPIRE t 50 LT", ":1\r\n");
    ex("TTL t", ":50\r\n");
    ex("PEXPIRE t 20000 GT", ":0\r\n");
    ex("PEXPIRE t 80000 GT", ":1\r\n");
    ex("PTTL t", ":80000\r\n");
    ex("EXPIRE t 100 XX", ":1\r\n");
    ex("EXPIRE t -1", ":1\r\n");
    ex("EXISTS t", ":0\r\n");
    ex("FLUSHALL", "+OK\r\n");
    check("every byte of the books is gone again", st->used == 0);

    // ---- memory accounting: what a key, a list element, a hash field costs on the real heap ------------------------------------------------------------------------------------
    // (the allocator rounds every block up to a power of two and adds 16 bytes; 3.2 times more heap than was counted was measured before)
    for (int i = 0; i < 1000; i++) {
        char line[40];
        format(&line[0], 40, "SET key%d x", i, 0, 0, 0);
        exOn(cl, &line[0], "+OK\r\n");
    }
    check("1000 small keys (key + 1 byte) are counted with at least 250 bytes each", st->used >= 250 * 1000);
    int usedKeys = st->used;
    ex("FLUSHALL", "+OK\r\n");
    check("... and all of it is given back", st->used == 0);
    char lbuf[40000];
    int p = 0;
    for (int i = 0; i < 1000; i++) { p = p + format(&lbuf[p], 40000 - p, "RPUSH biglist x\r\n", 0, 0, 0, 0); }
    st->feedAt(cl, &lbuf[0], p);
    cl->out->clear();
    check("1000 elements of 1 byte in a list are counted with at least 48 bytes each", st->used >= 48 * 1000);
    ex("DEL biglist", ":1\r\n");
    check("... and given back", st->used == 0);
    st->maxMemory = 200000;
    int pushed = 0;
    for (int i = 0; i < 100000; i++) {
        cl->out->clear();
        st->feedAt(cl, "RPUSH l x\r\n", 11);
        if (cl->out->data()[0] == '-') break;
        pushed++;
    }
    cl->out->clear();
    check("with maxMemory 200000 the list stops growing at no more than 200000 / 48 elements (-OOM)", pushed > 100 && pushed <= 200000 / 48 + 1);
    st->maxMemory = 67108864;
    ex("FLUSHALL", "+OK\r\n");
    check("(books balanced)", st->used == 0);

    // ---- APPEND does not copy the whole value every time ------------------------------------------------------------------------------------------------------------------------
    char* chunk = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
    // (times are compared with the time of the same number of plain SETs: a fixed limit would not hold on a slow emulator)
    int t0 = millis();
    for (int i = 0; i < 20000; i++) {
        char line[160];
        format(&line[0], 160, "SET plain %s\r\n", chunk, 0, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    int dtSet = millis() - t0;
    ex("DEL plain", ":1\r\n");
    t0 = millis();
    for (int i = 0; i < 20000; i++) {
        char line[160];
        format(&line[0], 160, "APPEND ap %s\r\n", chunk, 0, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    int dtAppend = millis() - t0;
    ex("STRLEN ap", ":2000000\r\n");
    check("20000 appends of 100 bytes to one key take about as long as 20000 SETs (copying the whole value each time made them 100 times slower)", dtAppend < 8 * dtSet + 300);
    cl->out->clear();
    st->feedAt(cl, "GET ap\r\n", 8);
    check("... the value is 2000000 bytes: $2000000 header, the data in order", cl->out->pending() == 2000000 + 10 + 2 && memcmp(&cl->out->data()[10 + 1900000], chunk, 100) == 0 && memcmp(&cl->out->data()[10], chunk, 100) == 0);
    cl->out->clear();
    ex("DEL ap", ":1\r\n");
    check("(books balanced)", st->used == 0);

    // ---- sorted sets: blocks ----------------------------------------------------------------------------------------------------------------------------------------------------------------
    int N = 40000;
    char** names = (char**) alloc(N * 8);
    int* scores = (int*) alloc(N * 8);
    t0 = millis();
    for (int i = 0; i < N; i++) {                                  // the same number of inserts at the end of the set: the baseline
        char line[64];
        format(&line[0], 64, "ZADD ascbase %d a%d\r\n", i, i, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    int dtBase = millis() - t0;
    ex("DEL ascbase", ":1\r\n");
    t0 = millis();
    for (int i = 0; i < N; i++) {
        int sc = rand31() % 1000000;
        scores[i] = sc;
        char line[64];
        format(&line[0], 64, "ZADD zs %d m%d\r\n", sc, i, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    int dtZadd = millis() - t0;
    ex("ZCARD zs", ":40000\r\n");
    check("40000 ZADDs with random scores take about as long as 40000 ZADDs at the end of the set (a sorted array was 10 times slower)", dtZadd < 6 * dtBase + 300);
    cl->out->clear();
    st->feedAt(cl, "ZRANGE zs 0 -1\r\n", 16);
    char** at = (char**) alloc(N * 8);
    int* lens = (int*) alloc(N * 8);
    int got = parseBulks(cl->out, at, lens, N);
    check("ZRANGE 0 -1 returns all 40000 members", got == N);
    // order: by score, then by member bytes. The scores come from the model
    bool sorted = true;
    for (int i = 1; i < N && sorted; i++) {
        // the member name m<i> carries its index
        int a = 0;
        int b = 0;
        for (int k = 1; k < lens[i - 1]; k++) a = a * 10 + (at[i - 1][k] - '0');
        for (int k = 1; k < lens[i]; k++) b = b * 10 + (at[i][k] - '0');
        if (scores[a] > scores[b]) sorted = false;
        else if (scores[a] == scores[b] && cmpBytes(at[i - 1], lens[i - 1], at[i], lens[i]) >= 0) sorted = false;
    }
    check("... in order: by score, then by member bytes", sorted);
    // ZRANK of members against their place in that list (asked on another client: the list stays in cl->out)
    bool ranks = true;
    redisd.Rclient* c2 = st->open();
    for (int s = 0; s < 400 && ranks; s++) {
        int idx = (s * 149) % N;
        char line[64];
        char mem[24];
        memcpy(&mem[0], at[idx], lens[idx]);
        mem[lens[idx]] = 0;
        format(&line[0], 64, "ZRANK zs %s\r\n", &mem[0], 0, 0, 0);
        char want[24];
        format(&want[0], 24, ":%d\r\n", idx, 0, 0, 0);
        if (!exOn(c2, &line[0], &want[0])) ranks = false;
    }
    check("ZRANK of 400 members is their position in the list", ranks);
    cl->out->clear();
    // ZRANGE of a part that crosses block borders
    st->feedAt(cl, "ZRANGE zs 255 258\r\n", 19);
    bool part = parseBulks(cl->out, at, lens, 4) == 4;
    cl->out->clear();
    check("ZRANGE across a block border returns 4 members", part);
    // removals: every member whose index is not a multiple of 4, then the rest
    for (int i = 0; i < N; i++) {
        if (i % 4 == 0) continue;
        char line[64];
        format(&line[0], 64, "ZREM zs m%d\r\n", i, 0, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    ex("ZCARD zs", ":10000\r\n");
    cl->out->clear();
    st->feedAt(cl, "ZRANGE zs 0 -1\r\n", 16);
    got = parseBulks(cl->out, at, lens, N);
    sorted = got == 10000;
    for (int i = 1; i < got && sorted; i++) {
        int a = 0;
        int b = 0;
        for (int k = 1; k < lens[i - 1]; k++) a = a * 10 + (at[i - 1][k] - '0');
        for (int k = 1; k < lens[i]; k++) b = b * 10 + (at[i][k] - '0');
        if (a % 4 != 0 || b % 4 != 0) sorted = false;
        else if (scores[a] > scores[b]) sorted = false;
        else if (scores[a] == scores[b] && cmpBytes(at[i - 1], lens[i - 1], at[i], lens[i]) >= 0) sorted = false;
    }
    cl->out->clear();
    check("after 30000 removals the 10000 left are the right ones and in order", sorted);
    // changing the scores of members moves them
    for (int i = 0; i < 4000; i = i + 4) {
        char line[64];
        format(&line[0], 64, "ZADD zs %d m%d\r\n", 2000000 + i, i, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    ex("ZRANK zs m0", ":9000\r\n");
    ex("ZRANK zs m3996", ":9999\r\n");
    ex("ZSCORE zs m4", "$7\r\n2000004\r\n");
    ex("ZADD zs CH 1 m0", ":1\r\n");
    ex("ZRANK zs m0", ":0\r\n");
    ex("ZRANGE zs 0 0", "*1\r\n$2\r\nm0\r\n");
    // ascending and descending runs (the end and the front of the blocks)
    ex("DEL zs", ":1\r\n");
    check("(books balanced after DEL: every block was given back)", st->used == 0);
    for (int i = 0; i < 3000; i++) {
        char line[64];
        format(&line[0], 64, "ZADD asc %d a%d\r\n", i, i, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
        format(&line[0], 64, "ZADD desc %d d%d\r\n", 100000 - i, i, 0, 0);
        cl->out->clear();
        st->feedAt(cl, &line[0], strlen(&line[0]));
    }
    ex("ZRANK asc a2999", ":2999\r\n");
    ex("ZRANK desc d2999", ":0\r\n");
    ex("ZRANK desc d0", ":2999\r\n");
    ex("ZRANGE asc 1000 1001", "*2\r\n$5\r\na1000\r\n$5\r\na1001\r\n");
    ex("ZRANGE desc -2 -1", "*2\r\n$2\r\nd1\r\n$2\r\nd0\r\n");
    ex("FLUSHALL", "+OK\r\n");
    check("(books balanced)", st->used == 0);

    // ---- backpressure in the core: with outHigh the next command waits until the replies have been taken -----------------------------------------------------------------------------
    st->outHigh = 100;
    ex("SET k60 vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv", "+OK\r\n");
    redisd.Rclient* pc = st->open();
    char* burst = "GET k60\r\nGET k60\r\nGET k60\r\nPING\r\n";
    pc->out->clear();
    st->feedAt(pc, burst, strlen(burst));
    check("outHigh 100: after two replies of 67 bytes the client is paused (134 bytes are queued)", pc->paused && pc->out->pending() == 134);
    pc->out->clear();                                           // the socket takes everything
    int r = st->resume(pc);
    check("resume: the third GET and the PING run, nothing is left waiting", r == 0 && !pc->paused && pc->out->pending() == 67 + 7);
    check("... and the bytes are those of a GET and of PONG", memcmp(&pc->out->data()[67], "+PONG\r\n", 7) == 0 && pc->out->data()[0] == '$');
    pc->out->clear();
    // bytes that come while paused wait in order
    st->feedAt(pc, "GET k60\r\nGET k60\r\nGET k60\r\n", 27);
    check("three more GETs: the third waits (paused, 134 bytes queued)", pc->paused && pc->out->pending() == 134);
    st->feedAt(pc, "PING\r\nQUIT\r\n", 12);
    check("bytes fed while paused only wait (nothing more is queued)", pc->out->pending() == 134);
    pc->out->clear();
    r = st->resume(pc);
    check("resume runs the third GET, the PING and the QUIT: the reply of QUIT is +OK and the connection is to be closed (-1)", r < 0 && pc->closing && pc->out->pending() == 67 + 7 + 5);
    st->close(pc);
    st->outHigh = 0;
    pc = st->open();
    pc->out->clear();
    st->feedAt(pc, burst, strlen(burst));
    check("outHigh 0: no backpressure, all four commands run", !pc->paused && pc->out->pending() == 3 * 67 + 7);
    st->close(pc);
    st->outHigh = 1048576;
    ex("FLUSHALL", "+OK\r\n");

    // ---- backpressure over sockets, plain and TLS ------------------------------------------------------------------------------------------------------------------------------------
    x509.addRootPem(CA_PEM);
    goodCfg = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    srv = redisd.newServer();
    srv->store->outHigh = 4096;
    net.setIdleHook(hook);
    check("a server with a plain and a TLS listener", srv->listenOn("127.0.0.1", 0, null) && srv->listenOn("127.0.0.1", 0, goodCfg));
    for (int round = 0; round < 2; round++) {
        int port = srv->net->listenerPort(round);
        netio.Link* l = netio.newLink();
        check(round == 0 ? "a plain connection" : "a TLS connection", l->open("127.0.0.1", port, 5000, round == 1, true));
        // set a value of 100 bytes through the wire, then pipeline 3000 GETs in one burst (36 KB: more than one read of the server)
        char setCmd[200];
        int sn = format(&setCmd[0], 200, "*3\r\n$3\r\nSET\r\n$4\r\nk100\r\n$100\r\n", 0, 0, 0, 0);
        memset(&setCmd[sn], 'x', 100);
        setCmd[sn + 100] = 13;
        setCmd[sn + 101] = 10;
        check("SET", l->sendAll(&setCmd[0], sn + 102, 5000));
        char rb[200];
        int rn = 0;
        int tt = millis();
        while (rn < 5 && millis() - tt < 5000) {
            srv->poll(1);
            if (!l->waitReadable(5)) continue;
            int x = l->recv(&rb[rn], 200 - rn);
            if (x <= 0) break;
            rn = rn + x;
        }
        check("... +OK", rn == 5 && memcmp(&rb[0], "+OK\r\n", 5) == 0);
        char* gets = alloc(10 * 3000);
        for (int i = 0; i < 3000; i++) memcpy(&gets[i * 10], "GET k100\r\n", 10);
        int cmds0 = srv->store->stats->commands;
        check("3000 pipelined GETs (30000 bytes) sent in one burst", l->sendAll(gets, 10 * 3000, 10000));
        int want = 3000 * 108;
        char* back = alloc(want + 100);
        int total = 0;
        tt = millis();
        while (total < want && millis() - tt < 20000) {
            srv->poll(0);
            if (!l->waitReadable(2)) continue;
            int x = l->recv(&back[total], want + 100 - total);
            if (x <= 0) break;
            total = total + x;
        }
        check("... 3000 replies of 108 bytes arrive (the server paused and resumed many times)", total == want);
        bool intact = true;
        for (int i = 0; i < 3000 && intact; i++) {
            if (memcmp(&back[i * 108], "$100\r\n", 6) != 0 || back[i * 108 + 6] != 'x' || back[i * 108 + 105] != 'x' || back[i * 108 + 106] != 13) intact = false;
        }
        check("... every reply is whole and in place", intact);
        check("... all 3000 commands ran, none twice", srv->store->stats->commands - cmds0 == 3000);
        l->dispose();
        for (int i = 0; i < 30; i++) srv->poll(1);
    }
    net.setIdleHook(null);
    check("no client is left", srv->net->count() == 0 && srv->store->clients == 0);
    srv->shutdown();

    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
