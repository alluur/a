// rng: shuffle, sample without replacement (Floyd), weighted choice, alias table, reservoir sampling and UUIDs. Exact sequences for fixed seeds were
// produced by Python mirrors of the documented algorithms; the statistical checks use fixed seeds.
import cstdio;
import cstring;
import asys;
import dmath;
import rng;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

double chiSquare(int* counts, int cells, int total) {
    double expected = (double) total / (double) cells;
    double s = 0.0;
    for (int i = 0; i < cells; i++) {
        double d = (double) counts[i] - expected;
        s = s + d * d / expected;
    }
    return s;
}

void showInts(char* label, int* a, int n) {
    printf("%s:", label);
    for (int i = 0; i < n; i++) { printf(" %d", a[i]); }
    printf("\n");
}

// ---- exact sequences ---------------------------------------------------------------------------------------------------------------------
void exact() {
    rng.Xoshiro256 g(1);
    int a[10];
    for (int i = 0; i < 10; i++) { a[i] = i; }
    g.shuffle(&a[0], 10);
    showInts("shuffle 0..9 seed 1", &a[0], 10);
    int out[16];
    rng.Xoshiro256 h(2);
    h.sample(100, 5, &out[0]);
    showInts("sample 100 5 seed 2 (Floyd)", &out[0], 5);
    rng.Xoshiro256 h2(3);
    h2.sample(10, 6, &out[0]);
    showInts("sample 10 6 seed 3 (dense)", &out[0], 6);
    rng.Xoshiro256 h3(4);
    h3.sampleSorted(1000000, 6, &out[0]);
    showInts("sampleSorted 1000000 6 seed 4", &out[0], 6);
    int w[5] = { 5, 0, 3, 1, 1 };
    rng.Xoshiro256 k(5);
    printf("weighted 5 0 3 1 1 seed 5:");
    for (int i = 0; i < 16; i++) { printf(" %d", k.weighted(&w[0], 5)); }
    printf("\n");
    double dw[4] = { 0.5, 0.25, 0.125, 0.125 };
    rng.AliasTable t(&dw[0], 4);
    rng.Xoshiro256 m(6);
    printf("alias 0.5 0.25 0.125 0.125 seed 6:");
    for (int i = 0; i < 16; i++) { printf(" %d", t.sample(&m)); }
    printf("\n");
    double dw2[5] = { 3.0, 1.0, 0.0, 2.0, 4.0 };
    rng.AliasTable t2(&dw2[0], 5);
    rng.Xoshiro256 m2(7);
    printf("alias 3 1 0 2 4 seed 7:");
    for (int i = 0; i < 16; i++) { printf(" %d", t2.sample(&m2)); }
    printf("\n");
    rng.Xoshiro256 rr(8);
    rng.ReservoirSampler rs(4);
    for (int i = 0; i < 30; i++) { rs.offer(&rr, i); }
    printf("reservoir 4 of 0..29 seed 8:");
    for (int i = 0; i < rs.size(); i++) { printf(" %d", rs.get(i)); }
    printf("\n");
    rs.dispose();
    t.dispose();
    t2.dispose();
    char id[40];
    rng.Xoshiro256 u(2024);
    for (int i = 0; i < 3; i++) { u.uuid4(&id[0]); printf("uuid4 seed 2024: %s\n", &id[0]); }
    // shuffleItems of 3 byte items
    char items[12];
    for (int i = 0; i < 4; i++) { items[3 * i] = 'a' + i; items[3 * i + 1] = 'A' + i; items[3 * i + 2] = '0' + i; }
    rng.Xoshiro256 s(9);
    s.shuffleItems(&items[0], 4, 3);
    char text[20];
    int k2 = 0;
    for (int i = 0; i < 12; i++) {
        if (i > 0 && i % 3 == 0) { text[k2] = ' '; k2++; }
        text[k2] = items[i];
        k2++;
    }
    text[k2] = 0;
    printf("shuffleItems of 3 byte items seed 9: %s\n", &text[0]);
}

// ---- shuffle ----------------------------------------------------------------------------------------------------------------------------
void shuffles() {
    rng.Xoshiro256 g(123);
    // always a permutation
    int a[40];
    bool perm = true;
    for (int round = 0; round < 500; round++) {
        int n = round % 33;
        for (int i = 0; i < n; i++) { a[i] = 10 + i; }
        g.shuffle(&a[0], n);
        int sum = 0;
        int seen = 0;
        for (int i = 0; i < n; i++) {
            if (a[i] < 10 || a[i] >= 10 + n) { perm = false; }
            sum = sum + a[i];
            seen = seen | (1 << (a[i] - 10));
        }
        if (n > 0 && (seen != (1 << n) - 1 || sum != 10 * n + n * (n - 1) / 2)) { perm = false; }
    }
    check(perm, "shuffle gives a permutation for n = 0 .. 32 (500 rounds)");
    // all 24 orders of 4 elements are equally likely
    int counts[24];
    int trials = 24000;
    for (int t = 0; t < trials; t++) {
        for (int i = 0; i < 4; i++) { a[i] = i; }
        g.shuffle(&a[0], 4);
        int code = a[0] * 64 + a[1] * 16 + a[2] * 4 + a[3];
        // rank of the permutation by its lexicographic position
        int rank = 0;
        int avail[4] = { 0, 1, 2, 3 };
        int left = 4;
        for (int i = 0; i < 4; i++) {
            int pos = 0;
            while (avail[pos] != a[i]) { pos++; }
            rank = rank * left + pos;
            for (int j = pos; j + 1 < left; j++) { avail[j] = avail[j + 1]; }
            left--;
        }
        counts[rank]++;
        code = code + 0;
    }
    check(chiSquare(&counts[0], 24, trials) < 60.0, "the 24 orders of 4 elements are equally likely (chi-square, 23 degrees of freedom)");
    // element 0 ends up at each of 6 positions equally often
    int pos[6];
    for (int t = 0; t < 12000; t++) {
        for (int i = 0; i < 6; i++) { a[i] = i; }
        g.shuffle(&a[0], 6);
        for (int i = 0; i < 6; i++) { if (a[i] == 0) { pos[i]++; } }
    }
    check(chiSquare(&pos[0], 6, 12000) < 25.0, "an element lands on every position equally often");
    // shuffleItems keeps the items whole
    char items[40];
    for (int i = 0; i < 10; i++) { items[3 * i] = 'a' + i; items[3 * i + 1] = 'a' + i; items[3 * i + 2] = 'a' + i; }
    g.shuffleItems(&items[0], 10, 3);
    bool whole = true;
    int mask = 0;
    for (int i = 0; i < 10; i++) {
        if (items[3 * i] != items[3 * i + 1] || items[3 * i] != items[3 * i + 2]) { whole = false; }
        mask = mask | (1 << (items[3 * i] - 'a'));
    }
    check(whole && mask == 1023, "shuffleItems: whole items, all present");
    g.shuffleItems(&items[0], 10, 0);
    g.shuffleItems(&items[0], 0, 3);
    g.shuffle(&a[0], 0);
    g.shuffle(&a[0], 1);
    check(true, "empty and one element shuffles do nothing");
}

// ---- sampling without replacement ------------------------------------------------------------------------------------------------------
void sampling() {
    rng.Xoshiro256 g(321);
    int out[2000];
    // distinct and in range, both algorithms
    bool ok = true;
    for (int round = 0; round < 400; round++) {
        int n = 1 + g.below(300);
        int k = g.below(n + 1);
        if (!g.sample(n, k, &out[0])) { ok = false; continue; }
        int seen[300];
        for (int i = 0; i < n; i++) { seen[i] = 0; }
        for (int i = 0; i < k; i++) {
            if (out[i] < 0 || out[i] >= n || seen[out[i]] != 0) { ok = false; }
            else { seen[out[i]] = 1; }
        }
    }
    check(ok, "sample: k distinct values in 0 .. n - 1 (400 random n and k)");
    // sorted
    ok = true;
    for (int round = 0; round < 200; round++) {
        int n = 1 + g.below(1000);
        int k = g.below(n + 1);
        if (k > 1000) { k = 1000; }
        g.sampleSorted(n, k, &out[0]);
        for (int i = 1; i < k; i++) { if (out[i] <= out[i - 1]) { ok = false; } }
    }
    check(ok, "sampleSorted: strictly increasing");
    check(!g.sample(5, 6, &out[0]) && !g.sample(5, -1, &out[0]) && !g.sample(-1, 0, &out[0]) && g.sample(0, 0, &out[0]) && g.sample(5, 0, &out[0]), "bad arguments: k > n, k < 0, n < 0; k = 0 is fine");
    ok = g.sample(7, 7, &out[0]);
    int mask = 0;
    for (int i = 0; i < 7; i++) { mask = mask | (1 << out[i]); }
    check(ok && mask == 127, "k = n: all values");
    // inclusion probabilities: n = 10, k = 3 (dense) and n = 100, k = 5 (Floyd): every value is in the sample with probability k / n
    int inc[10];
    for (int t = 0; t < 20000; t++) {
        g.sample(10, 3, &out[0]);
        for (int i = 0; i < 3; i++) { inc[out[i]]++; }
    }
    bool incOk = true;
    for (int i = 0; i < 10; i++) { if (inc[i] < 5700 || inc[i] > 6300) { incOk = false; } }
    check(incOk, "n = 10, k = 3: every value is included with probability 0.3");
    int inc2[100];
    for (int t = 0; t < 20000; t++) {
        g.sample(100, 5, &out[0]);
        for (int i = 0; i < 5; i++) { inc2[out[i]]++; }
    }
    int lowest = 100000;
    int highest = 0;
    for (int i = 0; i < 100; i++) { if (inc2[i] < lowest) { lowest = inc2[i]; } if (inc2[i] > highest) { highest = inc2[i]; } }
    check(lowest > 850 && highest < 1150, "n = 100, k = 5 (Floyd): every value is included with probability 0.05");
    // the order is random too: all 20 ordered pairs of 2 out of 5 are equally likely
    int pairs[25];
    for (int t = 0; t < 20000; t++) {
        g.sample(5, 2, &out[0]);
        pairs[out[0] * 5 + out[1]]++;
    }
    int cells[20];
    int c = 0;
    for (int i = 0; i < 25; i++) { if (i / 5 != i % 5) { cells[c] = pairs[i]; c++; } }
    check(chiSquare(&cells[0], 20, 20000) < 45.0, "ordered pairs (5 choose 2, in random order) are equally likely");
    // the same for the Floyd branch: n = 30, k = 2: 870 ordered pairs... check that the first element is uniform
    int first[30];
    for (int t = 0; t < 30000; t++) {
        g.sample(30, 2, &out[0]);
        first[out[0]]++;
    }
    check(chiSquare(&first[0], 30, 30000) < 65.0, "the first element of a Floyd sample is uniform");
    // a huge n with a small k works in O(k)
    int big[500];
    int memBefore = asys.memInUse();
    ok = g.sampleSorted(4000000000000, 500, &big[0]);
    bool distinct = true;
    for (int i = 1; i < 500; i++) { if (big[i] <= big[i - 1]) { distinct = false; } }
    check(ok && distinct && big[499] < 4000000000000 && big[0] >= 0 && asys.memInUse() == memBefore, "n = 4 * 10^12, k = 500: distinct, no leftover memory");
}

// ---- weighted choice and the alias table --------------------------------------------------------------------------------------------------
void weights() {
    rng.Xoshiro256 g(2468);
    int w[6] = { 5, 0, 3, 1, 0, 11 };
    int counts[6];
    for (int i = 0; i < 40000; i++) { counts[g.weighted(&w[0], 6)]++; }
    check(counts[1] == 0 && counts[4] == 0, "weighted: a weight of 0 is never chosen");
    int c4[4] = { counts[0], counts[2], counts[3], counts[5] };
    double stat = 0.0;
    int wt[4] = { 5, 3, 1, 11 };
    for (int i = 0; i < 4; i++) {
        double exp = 40000.0 * (double) wt[i] / 20.0;
        double d = (double) c4[i] - exp;
        stat = stat + d * d / exp;
    }
    check(stat < 20.0, "weighted: frequencies follow the weights (chi-square, 3 degrees of freedom)");
    int neg[2] = { 3, -1 };
    int zero[3] = { 0, 0, 0 };
    int huge[2] = { 0x4000000000000000, 0x4000000000000000 };
    int single[1] = { 9 };
    check(g.weighted(&neg[0], 2) == -1 && g.weighted(&zero[0], 3) == -1 && g.weighted(&huge[0], 2) == -1 && g.weighted(&w[0], 0) == -1 && g.weighted(&single[0], 1) == 0, "weighted: negative weight, all zero, sum overflow, n = 0 give -1; one weight gives 0");
    int big[2] = { 0x3FFFFFFFFFFFFFFF, 0x3FFFFFFFFFFFFFFF };
    int bw = g.weighted(&big[0], 2);
    check(bw == 0 || bw == 1, "weighted: weights near 2^62 work");

    // the alias table: the probability that the table gives to every index is exactly weight / total (up to rounding)
    bool exact = true;
    for (int round = 0; round < 60; round++) {
        int n = 1 + g.below(12);
        double dw[12];
        double total = 0.0;
        for (int i = 0; i < n; i++) {
            int r = g.below(4);
            dw[i] = (r == 0) ? 0.0 : (double) (1 + g.below(1000)) / 8.0;
            total = total + dw[i];
        }
        if (total == 0.0) { dw[0] = 1.0; total = 1.0; }
        rng.AliasTable t(&dw[0], n);
        if (!t.ok() || t.size() != n) { exact = false; continue; }
        double sum = 0.0;
        for (int i = 0; i < n; i++) {
            double p = t.probabilityOf(i);
            double want = dw[i] / total;
            double d = p - want;
            if (d < 0.0) { d = -d; }
            if (d > 1.0e-12) { exact = false; }
            sum = sum + p;
        }
        double ds = sum - 1.0;
        if (ds < 0.0) { ds = -ds; }
        if (ds > 1.0e-12) { exact = false; }
        t.dispose();
    }
    check(exact, "alias table: every index has probability weight / total (60 random weight sets with zeros)");
    double dw2[5] = { 3.0, 1.0, 0.0, 2.0, 4.0 };
    rng.AliasTable t2(&dw2[0], 5);
    int ac[5];
    for (int i = 0; i < 50000; i++) { ac[t2.sample(&g)]++; }
    double stat2 = 0.0;
    for (int i = 0; i < 5; i++) {
        if (dw2[i] == 0.0) { continue; }
        double exp = 50000.0 * dw2[i] / 10.0;
        double d = (double) ac[i] - exp;
        stat2 = stat2 + d * d / exp;
    }
    check(ac[2] == 0 && stat2 < 18.0, "alias table: sample frequencies follow the weights, a zero weight is never drawn");
    // one entry, equal weights, a huge ratio
    double one[1] = { 7.5 };
    rng.AliasTable t3(&one[0], 1);
    check(t3.ok() && t3.sample(&g) == 0 && t3.sample(&g) == 0, "alias table with one entry");
    double ratio[3] = { 1.0e12, 1.0, 1.0e-6 };
    rng.AliasTable t4(&ratio[0], 3);
    int hits[3];
    for (int i = 0; i < 20000; i++) { hits[t4.sample(&g)]++; }
    check(hits[0] > 19990 && hits[2] == 0, "alias table with weights 1e12 : 1 : 1e-6");
    // bad input: negative, NaN, infinite, all zero, empty
    double bad1[2] = { 1.0, -1.0 };
    double nan2[2] = { 1.0, dmath.nan() };
    double inf2[2] = { 1.0, 1.0e999 };
    double zeros[2] = { 0.0, 0.0 };
    rng.AliasTable b1(&bad1[0], 2);
    rng.AliasTable b2(&nan2[0], 2);
    rng.AliasTable b3(&inf2[0], 2);
    rng.AliasTable b4(&zeros[0], 2);
    rng.AliasTable b5(&zeros[0], 0);
    check(!b1.ok() && !b2.ok() && !b3.ok() && !b4.ok() && !b5.ok() && b1.sample(&g) == -1, "alias table: negative, NaN, infinite, all zero and empty weights are refused");
    // integer weights
    int iw[4] = { 1, 2, 3, 4 };
    rng.AliasTable t5(&one[0], 1);
    check(t5.buildInts(&iw[0], 4) && t5.size() == 4 && t5.probabilityOf(3) > 0.3999999 && t5.probabilityOf(3) < 0.4000001, "alias table from integer weights");
    int badw[2] = { 1, -5 };
    check(!t5.buildInts(&badw[0], 2) && !t5.ok(), "negative integer weight refused, the table is empty then");
    t2.dispose(); t3.dispose(); t4.dispose(); t5.dispose();
}

// ---- reservoir sampling -----------------------------------------------------------------------------------------------------------------
void reservoirs() {
    rng.Xoshiro256 g(1357);
    rng.ReservoirSampler rs(5);
    check(rs.ok() && rs.capacity() == 5 && rs.size() == 0 && rs.offered() == 0, "a new reservoir is empty");
    for (int i = 0; i < 3; i++) { rs.offer(&g, 100 + i); }
    check(rs.size() == 3 && rs.offered() == 3 && rs.get(0) == 100 && rs.get(1) == 101 && rs.get(2) == 102 && rs.get(3) == 0 && rs.get(-1) == 0, "fewer items than the capacity: all are kept, in order");
    for (int i = 3; i < 5; i++) { rs.offer(&g, 100 + i); }
    check(rs.size() == 5 && rs.get(4) == 104, "exactly the capacity");
    rs.dispose();
    // every item of a stream of 50 is in the reservoir of 5 with probability 0.1
    int in[50];
    int trials = 10000;
    for (int t = 0; t < trials; t++) {
        rng.ReservoirSampler r(5);
        for (int i = 0; i < 50; i++) { r.offer(&g, i); }
        for (int i = 0; i < r.size(); i++) { in[r.get(i)]++; }
        r.dispose();
    }
    int lo = 100000;
    int hi = 0;
    for (int i = 0; i < 50; i++) { if (in[i] < lo) { lo = in[i]; } if (in[i] > hi) { hi = in[i]; } }
    check(lo > 880 && hi < 1130, "reservoir: every item is kept with probability k / n (10000 streams)");
    rng.ReservoirSampler none(0);
    none.offer(&g, 1);
    check(!none.ok() && none.size() == 0 && none.get(0) == 0, "capacity 0");
    rng.ReservoirSampler big(-3);
    check(!big.ok(), "negative capacity");
    rng.ReservoirSampler c(2);
    for (int i = 0; i < 10; i++) { c.offer(&g, i); }
    c.clear();
    check(c.size() == 0 && c.offered() == 0, "clear");
    for (int i = 0; i < 4; i++) { c.offer(&g, 7); }
    check(c.size() == 2 && c.get(0) == 7 && c.get(1) == 7, "usable after clear");
    c.dispose();
    c.dispose();
}

// ---- UUIDs --------------------------------------------------------------------------------------------------------------------------------
bool isHex(int c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }

bool uuidFormat(char* s) {
    if (strlen(s) != 36) { return false; }
    for (int i = 0; i < 36; i++) {
        if (i == 8 || i == 13 || i == 18 || i == 23) { if (s[i] != '-') { return false; } }
        else if (!isHex(s[i])) { return false; }
    }
    if (s[14] != '4') { return false; }
    return s[19] == '8' || s[19] == '9' || s[19] == 'a' || s[19] == 'b';
}

void uuids() {
    char id[40];
    memset(&id[0], 'x', 40);
    rng.Rng r;
    r.uuid4(&id[0]);
    check(uuidFormat(&id[0]) && id[36] == 0, "uuid4: 8-4-4-4-12 lower case hex, version 4, variant 8..b, terminating 0");
    rng.uuid4(&id[0]);
    check(uuidFormat(&id[0]), "rng.uuid4()");
    // 600 UUIDs from the system generator: all valid, all different, every hex digit position varies
    char* all = alloc(600 * 37);
    bool formatOk = true;
    for (int i = 0; i < 600; i++) {
        rng.uuid4(&all[i * 37]);
        if (!uuidFormat(&all[i * 37])) { formatOk = false; }
    }
    bool distinct = true;
    for (int i = 0; i < 600 && distinct; i++) {
        for (int j = i + 1; j < 600; j++) { if (memcmp(&all[i * 37], &all[j * 37], 36) == 0) { distinct = false; break; } }
    }
    check(formatOk && distinct, "600 system UUIDs: valid and all different");
    // the 4 variant values all occur, and the digits are spread: count the digit a..f among the 122 random hex digits
    int var[4];
    for (int i = 0; i < 600; i++) {
        int c = all[i * 37 + 19];
        var[(c == '8') ? 0 : (c == '9') ? 1 : (c == 'a') ? 2 : 3]++;
    }
    check(var[0] > 90 && var[1] > 90 && var[2] > 90 && var[3] > 90, "variant nibble is 8, 9, a, b with equal frequency");
}

int main() {
    exact();
    shuffles();
    sampling();
    weights();
    reservoirs();
    uuids();
    check(asys.memBadFrees() == 0, "no bad free");
    printf(fails == 0 ? "OK\n" : "FAILED\n");
    return fails;
}
