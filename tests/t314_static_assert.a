// static_assert(condition) and static_assert(condition, "message"): checked while compiling, nothing is generated
struct Header { uint8 kind; uint16 length; uint32 id; }
enum Color { Red, Green, Blue }
const LIMIT = 16;
const char* NAME_UNUSED = "x";

static_assert(sizeof(Header) == 8);
static_assert(sizeof(int) == 8, "int is 64 bit");
static_assert(Color.count == 3, "three colours");
static_assert(LIMIT * 2 == 32 && LIMIT > 0, "LIMIT");
static_assert(__ARCH >= 0 && __ARCH <= 3 && __OS >= 0);
static_assert((1 << 10) == 1024);

class Packet {
    static_assert(sizeof(Header) == 8, "header size inside a class");
public:
    Header h;
    int payload;
}

struct Table {
    int cells[LIMIT];
}
static_assert(sizeof(Table) == LIMIT * 8, "table size");

int main() {
    static_assert(sizeof(Packet) == 16, "packet size");
    static_assert(Color.Blue == 2);
    println("static assertions hold");
    printlnInt(sizeof(Header));
    return 0;
}
