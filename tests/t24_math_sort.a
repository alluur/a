import math;
import sort;

int main() {
    printlnInt(math.gcd(48, -18)); printlnInt(math.lcm(4, 6)); printlnInt(math.lcm(0, 5));
    printlnInt(math.pow(3, 13)); printlnInt(math.pow(2, 62)); printlnInt(math.pow(7, 0));
    printlnInt(math.powMod(2, 1000, 1000007));
    printlnInt(math.isqrt(0)); printlnInt(math.isqrt(99)); printlnInt(math.isqrt(100)); printlnInt(math.isqrt(1000000007));
    printlnInt(math.isqrt(9223372036854775807));
    int primes = 0;
    for (int i = 0; i < 1000; i++) if (math.isPrime(i)) primes++;
    printlnInt(primes); printlnInt(math.nextPrime(1000)); printBool(math.isPrime(1000000007)); println("");
    printlnInt(math.factorial(20)); printlnInt(math.fibonacci(90)); printlnInt(math.binomial(40, 20));
    printlnInt(math.clamp(15, 0, 10)); printlnInt(math.clamp(-5, 0, 10)); printlnInt(math.sign(-9));
    printlnInt(math.mod(-7, 3)); printlnInt(-7 % 3); printlnInt(math.floorDiv(-7, 2)); printlnInt(math.floorDiv(7, -2));
    printlnInt(math.popcount(255)); printlnInt(math.ilog2(1024)); printlnInt(math.ilog2(1023)); printlnInt(math.digitSum(-98765));
    int a[7];
    a[0] = 5; a[1] = -3; a[2] = 9; a[3] = 0; a[4] = 12; a[5] = 7; a[6] = -8;
    printlnInt(math.sum(a, 7)); printlnInt(math.minOf(a, 7)); printlnInt(math.maxOf(a, 7));
    // sorting a big pseudo random array, checking against its own invariants
    int n = 5000;
    int* big = (int*) alloc(n * 8);
    srand(7);
    for (int i = 0; i < n; i++) big[i] = rand() % 1000 - 500;
    int before = math.sum(big, n);
    sort.sortInts(big, n);
    printBool(sort.isSorted(big, n)); println("");
    printBool(before == math.sum(big, n)); println("");
    printlnInt(big[0] <= big[n - 1]);
    sort.reverseInts(big, n);
    printBool(big[0] >= big[n - 1]); println("");
    sort.sortInts(big, n);
    printlnInt(sort.binarySearch(big, n, big[1234]) >= 0);
    printlnInt(sort.binarySearch(big, n, 100000));
    int small[5]; small[0] = 4; small[1] = 1; small[2] = 3; small[3] = 2; small[4] = 0;
    sort.sortInts(small, 5);
    for (int i = 0; i < 5; i++) printInt(small[i]);
    println("");
    char* names[4];
    names[0] = "pear"; names[1] = "apple"; names[2] = "fig"; names[3] = "banana";
    sort.sortStrings(names, 4);
    for (int i = 0; i < 4; i++) { print(names[i]); print(" "); }
    println("");
    int r = math.randRange(5, 8);
    printBool(r >= 5 && r <= 8); println("");
    int sh[6]; for (int i = 0; i < 6; i++) sh[i] = i;
    math.shuffle(sh, 6);
    printlnInt(math.sum(sh, 6));
    return 0;
}
