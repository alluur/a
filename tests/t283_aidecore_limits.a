// aidecore: limits that used to be silent or unsafe. Snippets expanded deep in a block with many short lines (the output buffer was too small),
// build plans with more than 78 words, run lines with quote-heavy environment values, project files with line breaks in values, run
// configuration names that the file cannot hold.
import asys;
import acode;
import aproject;
import aidecore;

void rmtree(char* path) {
    asys.Stat st;
    if (asys.lstat(path, &st) != 0) { return; }
    if (st.isDir()) {
        asys.DirList dl();
        if (asys.listDir(path, &dl) >= 0) {
            for (int i = 0; i < dl.count; i++) {
                char* child = asys.join(path, dl.name(i));
                rmtree(child);
                asys.free(child);
            }
            dl.dispose();
        }
        asys.rmdir(path);
    } else {
        asys.unlink(path);
    }
}

int main() {
    rmtree("build/tests/t283");                                 // every run starts from nothing (the project file of an earlier run would be loaded)
    printf("== snippets at a deep indentation\n");
    aidecore.SnippetSet sn();
    int depths[6] = {0, 5, 60, 100, 190, 400};
    char* blocks[12];
    for (int di = 0; di < 6; di++) {
        int indent = depths[di];
        char line[500];
        for (int i = 0; i < indent; i++) { line[i] = ' '; }
        line[indent] = 0;
        // many short lines
        char many[300];
        int m = 0;
        for (int i = 0; i < 40; i++) { many[m] = 'x'; m++; many[m] = '0' + (i % 10); m++; many[m] = ';'; m++; if (i < 39) { many[m] = 10; m++; } }
        many[m] = 0;
        sn.add("many", "x", &many[0]);
        acode.Buffer* b = new acode.Buffer();
        b->setText(&line[0], indent);
        acode.Editor* ed = new acode.Editor(b);
        ed->setCursor(indent);
        // blocks next to where the output was allocated: a write past its end shows here
        for (int i = 0; i < 12; i++) { blocks[i] = asys.alloc(40 * (4 + 2 * indent) + 400); for (int k = 0; k < 40 * (4 + 2 * indent) + 400; k++) { blocks[i][k] = 0x41; } }
        for (int i = 0; i < 12; i += 2) { asys.free(blocks[i]); }
        bool ok = sn.insert(b, ed, sn.find("many"), -1);
        int bad = 0;
        for (int i = 1; i < 12; i += 2) { for (int k = 0; k < 40 * (4 + 2 * indent) + 400; k++) { if (blocks[i][k] != 0x41) { bad++; break; } } }
        char* t = asys.strDup(b->flatten());
        printf("indent %d: ok %d, length %d, neighbouring blocks damaged %d\n", indent, ok ? 1 : 0, strlen(t), bad);
        // check the text line by line against what it must be
        int bl = 0;
        int ln = 0;
        int pos = 0;
        int tl = strlen(t);
        while (pos <= tl) {
            int e = pos;
            while (e < tl && t[e] != 10) { e++; }
            char want[12];
            format(&want[0], 12, "x%d;", ln % 10);
            int wl = strlen(&want[0]);
            int len = e - pos;
            bool good = len == indent + wl;
            for (int k = 0; good && k < indent; k++) { if (t[pos + k] != ' ') { good = false; } }
            for (int k = 0; good && k < wl; k++) { if (t[pos + indent + k] != want[k]) { good = false; } }
            if (!good) { bl++; }
            ln++;
            pos = e + 1;
            if (e >= tl) { break; }
        }
        printf("  lines %d, wrong lines %d, caret at end %d\n", ln, bl, ed->caret() == tl ? 1 : 0);
        asys.free(t);
        for (int i = 1; i < 12; i += 2) { asys.free(blocks[i]); }
    }
    // the built-in snippets at a deep indentation (class corrupted its neighbours at about 100 columns)
    for (int di = 0; di < 3; di++) {
        int indent = (di == 0) ? 102 : ((di == 1) ? 190 : 300);
        char line[400];
        for (int i = 0; i < indent; i++) { line[i] = ' '; }
        line[indent] = 0;
        int bad = 0;
        for (int s = 0; s < sn.count; s++) {
            acode.Buffer* b = new acode.Buffer();
            b->setText(&line[0], indent);
            acode.Editor* ed = new acode.Editor(b);
            ed->setCursor(indent);
            char* c1 = asys.alloc(2000);
            char* c2 = asys.alloc(2000);
            char* c3 = asys.alloc(2000);
            memset(c1, 0x41, 2000); memset(c2, 0x41, 2000); memset(c3, 0x41, 2000);
            asys.free(c1);
            sn.insert(b, ed, s, -1);
            for (int k = 0; k < 2000; k++) { if (c2[k] != 0x41) { bad++; break; } }
            asys.free(c2);
            asys.free(c3);
            // every line of the result that is not the first starts with the indentation
            char* t = asys.strDup(b->flatten());
            int n = strlen(t);
            int pos = 0;
            int bl = 0;
            while (pos < n) {
                int e = pos;
                while (e < n && t[e] != 10) { e++; }
                if (pos > 0) {
                    int k = 0;
                    while (k < indent && t[pos + k] == ' ') { k++; }
                    if (k < indent && e - pos > 0) { bl++; }
                }
                pos = e + 1;
            }
            if (bl > 0) { bad++; }
            asys.free(t);
        }
        printf("built-in snippets at %d columns: %d problems\n", indent, bad);
    }
    // a snippet that cannot be expanded within the limit is refused, not cut
    {
        int indent = 1000;
        char* line = asys.alloc(indent + 1);
        for (int i = 0; i < indent; i++) { line[i] = ' '; }
        line[indent] = 0;
        char* big = asys.alloc(40000 * 2 + 1);
        int m = 0;
        for (int i = 0; i < 40000; i++) { big[m] = 'a'; m++; big[m] = 10; m++; }
        big[m] = 0;
        sn.add("huge", "x", big);
        acode.Buffer* b = new acode.Buffer();
        b->setText(line, indent);
        acode.Editor* ed = new acode.Editor(b);
        ed->setCursor(indent);
        printf("40000 lines at 1000 columns (40 MB): inserted %d, text unchanged %d\n", sn.insert(b, ed, sn.find("huge"), -1) ? 1 : 0, b->length() == indent ? 1 : 0);
        asys.free(big);
        asys.free(line);
    }

    printf("== build plans with many flags\n");
    {
        aidecore.Project p();
        p.load("/proj");
        char* flags = asys.alloc(4000);
        int o = 0;
        for (int i = 0; i < 100; i++) { o = o + format(&flags[o], 4000 - o, "-D F%d ", i); }
        p.flags = flags;
        aidecore.BuildPlan* b = aidecore.makeBuildPlan(&p, "/proj/main.a", "/bin/ac", false, null);
        // ac main.a -r debug -v 1 (6 words) and 200 words of flags
        printf("argc %d (expected %d), last '%s', null terminated %d, display has the last flag %d\n", b->argc, 6 + 200, b->argv[b->argc - 1], b->argv[b->argc] == null ? 1 : 0, contains(b->display, "-D F99") ? 1 : 0);
        b->dispose();
        // Words used to stop at 255 words
        char* many = asys.alloc(4000);
        o = 0;
        for (int i = 0; i < 300; i++) { o = o + format(&many[o], 4000 - o, "w%d ", i); }
        p.flags = many;
        b = aidecore.makeBuildPlan(&p, "/proj/main.a", "/bin/ac", false, null);
        printf("300 flag words: argc %d (expected %d)\n", b->argc, 6 + 300);
        b->dispose();
        p.dispose();
    }

    printf("== run lines\n");
    {
        char* q = asys.alloc(3000);
        // an environment value that is mostly single quotes: every one becomes four characters when it is quoted
        int o = 0;
        q[o] = 'V'; o++; q[o] = '='; o++; q[o] = '"'; o++;
        for (int i = 0; i < 500; i++) { q[o] = '\''; o++; }
        q[o] = '"'; o++; q[o] = 0;
        char* r = aidecore.runShellLine("/w", q, "/p", "--a");
        int n = strlen(r);
        // cd '/w' && V= + 500 quotes as '\'' each (4 characters) between the outer quotes + ' '/p' --a
        printf("quote-heavy value: line length %d (expected %d), ends with '--a' %d\n", n, strlen("cd '/w' && V=''") + 500 * 4 + strlen(" '/p' --a"), r[n - 1] == 'a' && r[n - 2] == '-' ? 1 : 0);
        asys.free(r);
        asys.free(q);
        r = aidecore.runShellLine("/w", "A=1 B='x y'", "/p", "--a");
        printf("ordinary: %s\n", r);
        asys.free(r);
    }

    printf("== project text\n");
    {
        asys.mkdirs("build/tests/t283/proj");
        aidecore.Project p();
        p.load("build/tests/t283/proj");
        p.name = asys.strDup("Demo\n[evil]\nx = 1");
        p.flags = asys.strDup("-q\r\n[run Hijack]\nprogram = /bin/sh");
        aidecore.RunConfig* rc = p.addRun("Fast");
        rc->args = asys.strDup("a\nb");
        rc->env = asys.strDup("A=1\n[more]");
        printf("save: %d\n", p.save());
        char* saved = asys.readFile("build/tests/t283/proj/.aide", null, 100000, null);
        int lines = 0;
        int sections = 0;
        for (int i = 0; saved[i] != 0; i++) {
            if (saved[i] == 10) { lines++; }
            if (saved[i] == '[' && (i == 0 || saved[i - 1] == 10)) { sections++; }
        }
        printf("sections in the file: %d (project and Fast), lines %d, injected section present %d\n", sections, lines, contains(saved, "\n[evil]") ? 1 : 0);
        asys.free(saved);
        aidecore.Project p2();
        p2.load("build/tests/t283/proj");
        printf("reloaded: %d run configuration(s), name '%s', flags '%s', Fast args '%s', Hijack %d\n", p2.nruns, p2.name, p2.flags, p2.findRun("Fast") != null ? p2.findRun("Fast")->args : "?", p2.findRun("Hijack") != null ? 1 : 0);
        p2.dispose();
        p.dispose();
    }

    printf("== the marks of running instances are not project content\n");
    {
        aidecore.Project p();
        p.load("build/tests/t283/proj");
        aproject.Ignore* ig = p.makeIgnore();
        printf("aide-lock-1234 ignored %d, aide-lock ignored %d, main.a ignored %d\n", ig->ignored("aide-lock-1234", false) ? 1 : 0, ig->ignored("aide-lock", false) ? 1 : 0, ig->ignored("main.a", false) ? 1 : 0);
        p.dispose();
    }

    printf("== a change that is not in the text\n");
    {
        acode.Buffer* b = new acode.Buffer();
        b->setText("a\nb\n", 4);
        b->markSaved();
        printf("saved: modified %d\n", b->modified() ? 1 : 0);
        b->eol = acode.EOL_CRLF;
        b->markModified();
        printf("line ending changed and marked: modified %d, text the same %d\n", b->modified() ? 1 : 0, streq(b->flatten(), "a\nb\n") ? 1 : 0);
        b->markSaved();
        printf("after the save: modified %d\n", b->modified() ? 1 : 0);
    }

    printf("== run configuration names\n");
    {
        char* names[9];
        names[0] = "Fast";
        names[1] = "";
        names[2] = "a b c";
        names[3] = "1234567890123456789012345678901234567890123456789012345678901";
        names[4] = "123456789012345678901234567890123456789012345678901234567890";
        names[5] = "bad]name";
        names[6] = "bad[name";
        names[7] = " lead";
        names[8] = "trail ";
        for (int i = 0; i < 9; i++) {
            char* pr = aidecore.runNameProblem(names[i]);
            printf("  '%s' (%d characters): %s\n", strlen(names[i]) > 12 ? "long" : names[i], strlen(names[i]), pr != null ? pr : "fine");
        }
        // a name that passes the check survives a save and a load
        aidecore.Project p();
        p.load("build/tests/t283/proj");
        p.reset();
        p.addRun(names[4])->args = asys.strDup("x");
        p.addRun("Fast")->args = asys.strDup("y");
        p.save();
        aidecore.Project p2();
        p2.load("build/tests/t283/proj");
        printf("saved 2, loaded %d; the 60 character name is there: %d\n", p2.nruns, p2.findRun(names[4]) != null ? 1 : 0);
        p2.dispose();
        p.dispose();
    }
    return 0;
}
