// logical xor (^^ / xor), word operators (and / or / not), three way comparison (<=>), null coalescing (??)
import cstdio;

int evaluated = 0;
int side(int v) { evaluated++; return v; }
char* maybe(char* s) { return s; }

int main() {
    printf("xor: %d %d %d %d\n", 1 ^^ 0, 1 ^^ 1, 0 ^^ 0, 0 ^^ 5);
    printf("xor words: %d %d\n", true xor false, 3 xor 4);
    int a = 5; int b = 0;
    printf("xor vars: %d %d\n", a ^^ b, a ^^ a);
    printf("both sides run: ");
    int r = side(1) ^^ side(1);
    printf("%d after %d calls\n", r, evaluated);
    printf("precedence: %d\n", 1 || 0 ^^ 1 && 1);

    printf("and/or/not: %d %d %d %d\n", 1 and 1, 1 and 0, 0 or 1, not 0);
    if (a > 1 and not (b > 0) or false) { printf("word condition ok\n"); }

    printf("<=>: %d %d %d\n", 3 <=> 5, 5 <=> 5, 9 <=> 5);
    int neg = -7;
    printf("<=> negative: %d %d\n", neg <=> 3, 3 <=> neg);
    uint64 big = 0xFFFFFFFFFFFFFFFF;
    printf("<=> unsigned: %d %d\n", big <=> 1, 1 <=> big);
    printf("sorted by <=>: %d\n", (2 <=> 1) + (1 <=> 2) * 10);
    const C = 4 <=> 9;
    printf("const: %d\n", C);

    char* none = null;
    char* name = none ?? "default";
    printf("coalesce: %s %s\n", name, maybe("given") ?? "unused");
    int zero = 0;
    printf("int coalesce: %d %d\n", zero ?? 7, 3 ?? 7);
    evaluated = 0;
    int v = 1 ?? side(9);
    printf("right side skipped: %d (calls %d)\n", v, evaluated);
    printf("chain: %d\n", 0 ?? 0 ?? 8);
    return 0;
}
