class Node {
    public int value;
    public Node* next;
    public Node(int v) { value = v; next = null; }
}
class List {
    private Node* head;
    private int count;
    public void push(int v) {
        Node* n = new Node(v);
        n->next = head;
        head = n;
        count++;
    }
    public int size() { return count; }
    public int sum() {
        int s = 0;
        Node* cur = head;
        while (cur != null) { s += cur->value; cur = cur->next; }
        return s;
    }
    public void reverse() {
        Node* prev = null;
        Node* cur = head;
        while (cur != null) {
            Node* nx = cur->next;
            cur->next = prev;
            prev = cur;
            cur = nx;
        }
        head = prev;
    }
    public void dump() {
        Node* cur = head;
        while (cur != null) { printInt(cur->value); print(" "); cur = cur->next; }
        println("");
    }
}
int main() {
    List l;
    for (int i = 1; i <= 5; i++) l.push(i * i);
    l.dump();
    l.reverse();
    l.dump();
    printlnInt(l.size());
    printlnInt(l.sum());
    return 0;
}
