// ds: BinaryHeap / PriorityQueue with handles (decrease-key, remove, merge) checked against a brute force model
import cstdio;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 4242;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// the model: every element has an id (its value); key and handle by id
const MAXID = 20000;
int mkey[MAXID];
int mhandle[MAXID];
bool alive[MAXID];
int nextId = 0;
int liveCount = 0;

int modelBest(int dir) {                        // best key: smallest (dir 1) or largest (-1)
    int best = 0;
    bool have = false;
    for (int i = 0; i < nextId; i++) {
        if (!alive[i]) { continue; }
        if (!have || (dir > 0 && mkey[i] < best) || (dir < 0 && mkey[i] > best)) { best = mkey[i]; have = true; }
    }
    return best;
}

int randomLive() {                              // a random live id, -1 when none
    if (liveCount == 0) { return -1; }
    int k = rnd(liveCount);
    for (int i = 0; i < nextId; i++) {
        if (alive[i]) {
            if (k == 0) { return i; }
            k--;
        }
    }
    return -1;
}

void run(ds.BinaryHeap* h, int dir, int ops) {
    int bad = 0;
    nextId = 0;
    liveCount = 0;
    for (int op = 0; op < ops; op++) {
        int what = rnd(100);
        if (what < 40 && nextId < MAXID) {
            int k = rnd(2000) - 1000;
            int id = nextId;
            nextId++;
            int hd = h->push(k, id);
            if (hd < 0) { bad++; }
            mkey[id] = k; mhandle[id] = hd; alive[id] = true; liveCount++;
            if (!h->contains(hd) || h->keyOf(hd) != k || h->valueOf(hd) != id) { bad++; }
        } else if (what < 62) {
            if (liveCount == 0) {
                if (h->pop() != 0 || h->popValue() != 0 || h->peekHandle() != -1) { bad++; }
            } else {
                int wantKey = modelBest(dir);
                if (h->peek() != wantKey) { bad++; }
                int id = h->peekValue();
                int hd = h->peekHandle();
                if (id < 0 || id >= nextId || !alive[id] || mkey[id] != wantKey || mhandle[id] != hd) { bad++; }
                if (h->popValue() != id) { bad++; }
                if (id >= 0 && id < nextId) { alive[id] = false; liveCount--; }
                if (h->contains(hd)) { bad++; }
            }
        } else if (what < 82) {
            int id = randomLive();
            if (id >= 0) {
                int k = mkey[id] + rnd(400) - 200;
                if (!h->update(mhandle[id], k)) { bad++; }
                mkey[id] = k;
                if (h->keyOf(mhandle[id]) != k || h->valueOf(mhandle[id]) != id) { bad++; }
            }
        } else if (what < 92) {
            int id = randomLive();
            if (id >= 0) {
                if (!h->remove(mhandle[id])) { bad++; }
                alive[id] = false;
                liveCount--;
                if (h->contains(mhandle[id]) || h->remove(mhandle[id]) || h->update(mhandle[id], 5)) { bad++; }
            }
        } else if (what < 96) {
            int id = randomLive();
            if (id >= 0) {
                h->setValue(mhandle[id], id);
                if (h->valueOf(mhandle[id]) != id) { bad++; }
            }
        } else {
            if (h->size() != liveCount || h->isEmpty() != (liveCount == 0) || !h->verify()) { bad++; }
        }
    }
    check(bad == 0, "random operations agree with the model");
    check(h->size() == liveCount && h->verify(), "size and heap property at the end");
    // drain: keys come out in order
    int n = h->size();
    int* keys = (int*) asys.alloc(n * 8 + 8);
    int* vals = (int*) asys.alloc(n * 8 + 8);
    int got = h->drain(keys, vals);
    bool sorted = got == n;
    for (int i = 1; i < got; i++) {
        if ((dir > 0 && keys[i - 1] > keys[i]) || (dir < 0 && keys[i - 1] < keys[i])) { sorted = false; }
    }
    for (int i = 0; i < got; i++) { if (!alive[vals[i]] || mkey[vals[i]] != keys[i]) { sorted = false; } }
    check(sorted && h->isEmpty(), "drain gives every element in key order");
    asys.free((char*) keys);
    asys.free((char*) vals);
}

int byTens(int a, int b) { return (a / 10) <=> (b / 10); }       // only the tens count

void merging() {
    ds.BinaryHeap a;
    ds.BinaryHeap b;
    int total = 0;
    for (int i = 0; i < 500; i++) { a.push(rnd(10000), i); total++; }
    for (int i = 0; i < 700; i++) { b.push(rnd(10000), i + 1000); total++; }
    int hb = b.push(-5, 4242);
    total++;
    check(a.merge(&b), "merge");
    check(a.size() == total && b.size() == 0 && b.verify() && a.verify(), "merge moves everything");
    check(!b.contains(hb), "handles of the merged heap are invalid");
    check(a.peek() == -5 && a.peekValue() == 4242, "the merged minimum is on top");
    check(!a.merge(&a), "a heap cannot be merged into itself");
    ds.BinaryHeap e;
    check(a.merge(&e) && a.size() == total, "merging an empty heap");
    check(e.merge(&a) && e.size() == total && a.size() == 0, "merging into an empty heap");
    // a small heap merged into a big one (sift-up path) and the reverse
    ds.BinaryHeap big;
    for (int i = 0; i < 1000; i++) { big.push(i * 2, i); }
    ds.BinaryHeap small;
    small.push(-1, 0); small.push(1001, 1);
    big.merge(&small);
    check(big.verify() && big.peek() == -1 && big.size() == 1002, "small into big");
    int last = -2;
    bool ok = true;
    while (!big.isEmpty()) { int k = big.pop(); if (k < last) { ok = false; } last = k; }
    check(ok, "sorted after merging");
    a.dispose(); b.dispose(); e.dispose(); big.dispose(); small.dispose();
}

void handles() {
    ds.BinaryHeap h;
    int hs[10];
    for (int i = 0; i < 10; i++) { hs[i] = h.push(100 - i, i); }
    check(h.contains(hs[3]) && !h.contains(-1) && !h.contains(99) && !h.contains(10), "contains");
    h.pop();                                           // removes key 91 (value 9)
    check(!h.contains(hs[9]) && h.contains(hs[8]), "a popped handle is stale");
    int again = h.push(1, 55);                         // the freed handle may be reused: that is allowed, but then it is valid again
    check(h.contains(again) && h.valueOf(again) == 55, "a new element gets a valid handle");
    check(!h.update(-3, 1) && !h.remove(1000) && h.keyOf(1000) == 0 && h.valueOf(-1) == 0, "bad handles are refused");
    h.dispose();
    // equal keys and extreme keys
    ds.BinaryHeap x;
    for (int i = 0; i < 50; i++) { x.push(7, i); }
    x.push(-9223372036854775807 - 1, 100);
    x.push(9223372036854775807, 101);
    check(x.peek() == -9223372036854775807 - 1 && x.verify(), "extreme keys");
    int seen = 0;
    while (!x.isEmpty()) { x.pop(); seen++; }
    check(seen == 52, "equal keys all come out");
    x.dispose();
}

void priorityQueue() {
    ds.PriorityQueue q;
    q.enqueue(30, 300); q.enqueue(10, 100); q.enqueue(20, 200);
    check(q.peekPriority() == 10 && q.dequeue() == 100 && q.dequeue() == 200 && q.size() == 1, "PriorityQueue");
    // Dijkstra-style use: decrease-key through the handle
    int hs[5];
    ds.PriorityQueue d;
    for (int i = 0; i < 5; i++) { hs[i] = d.enqueue(1000, i); }
    d.update(hs[3], 4);
    d.update(hs[1], 2);
    d.update(hs[3], 1);
    check(d.dequeue() == 3 && d.dequeue() == 1 && d.size() == 3, "decrease-key");
    q.dispose(); d.dispose();
}

int main() {
    ds.BinaryHeap h;
    run(&h, 1, 20000);
    h.dispose();
    ds.BinaryHeap g(ds.cmpDesc);
    run(&g, -1, 20000);
    g.dispose();
    // a comparator that has ties
    ds.BinaryHeap t(byTens);
    int ks[40];
    for (int i = 0; i < 40; i++) { ks[i] = rnd(1000); t.push(ks[i], i); }
    int prev = -1;
    bool okT = true;
    while (!t.isEmpty()) { int k = t.pop(); if (k / 10 < prev) { okT = false; } prev = k / 10; }
    check(okT, "comparator with ties");
    t.dispose();
    merging();
    handles();
    priorityQueue();
    int b0 = asys.memBlocks();
    ds.BinaryHeap m;
    for (int i = 0; i < 5000; i++) { m.push(i, i); }
    m.dispose();
    check(asys.memBlocks() == b0 && m.size() == 0 && m.push(1, 1) >= 0, "dispose frees, the heap can be used again");
    m.dispose();
    check(asys.memBlocks() == b0, "dispose twice");
    printf("heap: %d checks, %d failures\n", checks, fails);
    return fails;
}
