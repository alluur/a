// optim: root finding (bisection, Brent, Newton, secant, bracket search, systems of equations) and numerical differentiation. The expected roots are computed in
// 60 digit decimals by tests/algo2_ref/gen_t454.py (Newton iteration in decimal arithmetic on the same functions); the iteration counts only have to stay below limits.
import cstdio;
import asys;
import optim;
import matrix;
import dmath;

struct Params {
    double k;
    double c;
    int calls;
}

double fCos(double x, void* ctx) { return dmath.cos(x) - x; }
double dCos(double x, void* ctx) { return -dmath.sin(x) - 1.0; }
double fCubic(double x, void* ctx) { return x * x * x - 2.0 * x - 5.0; }
double dCubic(double x, void* ctx) { return 3.0 * x * x - 2.0; }
double fExp(double x, void* ctx) {
    Params* p = (Params*) ctx;
    p->calls++;
    return dmath.exp(-p->k * x) - p->c;
}
double fTriple(double x, void* ctx) { return (x - 1.0) * (x - 1.0) * (x - 1.0); }
double fAtan(double x, void* ctx) { return dmath.atan(x); }
double fLog(double x, void* ctx) { return dmath.log(x) - 1.0; }
double fFlat(double x, void* ctx) { return 1.0; }
double fNan(double x, void* ctx) { return (x > 1.0) ? dmath.nan() : x - 2.0; }
double fInf(double x, void* ctx) { return 1.0 / (x - 1.5); }
double fSq(double x, void* ctx) { return x * x - 4.0; }
double fSteep(double x, void* ctx) { return dmath.pow(x, 9.0) - 1.0e-30; }
double fZeroAt0(double x, void* ctx) { return x; }
double fSin(double x, void* ctx) { return dmath.sin(x); }

void pr(char* name, optim.Result r) {
    printf("%s: status %d", name, r.status);
    printfd(" x %.11g\n", __bits(r.x));
}

// the two equations x^2 + y^2 = 4 and x y = 1
void sys1(double* x, int n, double* out, void* ctx) {
    out[0] = x[0] * x[0] + x[1] * x[1] - 4.0;
    out[1] = x[0] * x[1] - 1.0;
}

// three equations with the solution (1, 2, 3): x + y + z = 6, x y = 2, y z = 6 (a polynomial system)
void sys3(double* x, int n, double* out, void* ctx) {
    out[0] = x[0] + x[1] + x[2] - 6.0;
    out[1] = x[0] * x[1] - 2.0;
    out[2] = x[1] * x[2] - 6.0;
}

void sysSingular(double* x, int n, double* out, void* ctx) {
    out[0] = x[0] * x[0];
    out[1] = x[0] * x[0];
}

double fxy(double* x, int n, void* ctx) { return x[0] * x[0] * x[1] + dmath.sin(x[1]) * x[2]; }
void vecF(double* x, int n, double* out, void* ctx) {
    out[0] = x[0] * x[1];
    out[1] = dmath.exp(x[0]) + x[1] * x[1];
    out[2] = x[0] - x[1];
}

int main() {
    int base = asys.memInUse();
    Params p;
    p.k = 2.0;
    p.c = 0.5;
    // ---- the four scalar methods on cos(x) = x, x^3 - 2 x - 5 and exp(-2 x) = 0.5
    pr("bisection cos(x) - x", optim.bisection(fCos, null, 0.0, 1.0, 1.0e-13, 200));
    pr("brent cos(x) - x", optim.brent(fCos, null, 0.0, 1.0, 1.0e-13, 100));
    pr("newton cos(x) - x", optim.newton(fCos, dCos, null, 0.5, 1.0e-13, 50));
    pr("newton (numerical derivative) cos(x) - x", optim.newton(fCos, null, null, 0.5, 1.0e-11, 50));
    pr("secant cos(x) - x", optim.secant(fCos, null, 0.0, 1.0, 1.0e-13, 50));
    pr("bisection x^3 - 2x - 5", optim.bisection(fCubic, null, 2.0, 3.0, 1.0e-13, 200));
    pr("brent x^3 - 2x - 5", optim.brent(fCubic, null, 2.0, 3.0, 1.0e-13, 100));
    pr("newton x^3 - 2x - 5", optim.newton(fCubic, dCubic, null, 2.0, 1.0e-13, 50));
    pr("secant x^3 - 2x - 5", optim.secant(fCubic, null, 2.0, 2.2, 1.0e-13, 50));
    optim.Result r = optim.brent(fExp, &p, 0.0, 5.0, 1.0e-13, 100);
    pr("brent exp(-2x) = 0.5 with a context", r);
    printf("the callback was called %d times (evals %d), at most 15: %d\n", p.calls, r.evals, p.calls <= 15);
    p.k = 0.5;
    p.c = 0.001;
    pr("brent exp(-x/2) = 0.001 (the same function with other parameters)", optim.brent(fExp, &p, 0.0, 100.0, 1.0e-12, 100));
    // convergence speed: Brent and Newton need few iterations, bisection about one binary digit per step
    r = optim.bisection(fCos, null, 0.0, 1.0, 1.0e-13, 200);
    printf("bisection iterations: between 40 and 46: %d\n", r.iterations >= 40 && r.iterations <= 46);
    r = optim.brent(fCos, null, 0.0, 1.0, 1.0e-13, 100);
    printf("brent iterations below 12: %d, evals below 14: %d\n", r.iterations < 12, r.evals < 14);
    r = optim.newton(fCos, dCos, null, 0.5, 1.0e-13, 50);
    printf("newton iterations below 8: %d\n", r.iterations < 8);
    // a triple root: Newton converges linearly but gets there; Brent and bisection need a sign change (there is one)
    r = optim.newton(fTriple, null, null, 2.0, 1.0e-4, 500);
    printf("newton (x - 1)^3 from 2: status %d, within 1e-3 of the root %d\n", r.status, dmath.fabs(r.x - 1.0) < 1.0e-3);
    r = optim.brent(fTriple, null, 0.0, 3.0, 1.0e-13, 500);
    printf("brent (x - 1)^3 on [0, 3] (slow for a triple root: more than 100 iterations): status %d, within 1e-9 of the root %d, iterations above 50 %d\n", r.status, dmath.fabs(r.x - 1.0) < 1.0e-9, r.iterations > 50);
    pr("bisection (x - 1)^3 on [0, 3]", optim.bisection(fTriple, null, 0.0, 3.0, 1.0e-13, 200));
    pr("brent on a very steep function x^9 = 1e-30", optim.brent(fSteep, null, 0.0, 1.0, 1.0e-14, 200));
    r = optim.brent(fAtan, null, -1.0e10, 3.0e9, 1.0e-10, 200);
    printf("brent on arctan with a far away bracket: status %d, root within 1e-9 of 0: %d\n", r.status, dmath.fabs(r.x) < 1.0e-9);
    pr("brent log(x) = 1", optim.brent(fLog, null, 0.5, 10.0, 1.0e-14, 100));

    // ---- reversed bracket, roots at the end points, a root exactly at the start
    pr("bisection with a > b", optim.bisection(fCos, null, 1.0, 0.0, 1.0e-13, 200));
    pr("brent with a > b", optim.brent(fCos, null, 1.0, 0.0, 1.0e-13, 100));
    r = optim.brent(fSq, null, 2.0, 5.0, 1.0e-13, 100);
    printfd("root at the left end point: status %d, x %g, iterations %d\n", r.status, __bits(r.x), r.iterations);
    r = optim.bisection(fSq, null, -2.0, -1.0, 1.0e-13, 100);
    printfd("bisection root at the left end: status %d, x %g\n", r.status, __bits(r.x));
    r = optim.newton(fZeroAt0, null, null, 0.0, 1.0e-13, 10);
    printfd("newton starting at the root: status %d, x %g, iterations %d\n", r.status, __bits(r.x), r.iterations);

    // ---- failures are reported, not hidden
    r = optim.brent(fSq, null, 3.0, 5.0, 1.0e-13, 100);
    printf("no sign change: brent status %d (ERR_BRACKET = %d), bisection status %d\n", r.status, optim.ERR_BRACKET, optim.bisection(fSq, null, 3.0, 5.0, 1.0e-13, 100).status);
    printf("function returns NaN at the end point: %d\n", optim.brent(fNan, null, 0.0, 3.0, 1.0e-13, 100).status);
    r = optim.brent(fInf, null, 0.0, 3.0, 1.0e-12, 100);
    printf("a pole inside the interval (a sign change, but no root): status %d, x is the pole %d, |f| is huge %d\n", r.status, dmath.fabs(r.x - 1.5) < 1.0e-9, dmath.fabs(r.fx) > 1.0e6);
    printf("bisection with 5 iterations: status %d (ERR_NO_CONVERGE = %d)\n", optim.bisection(fCos, null, 0.0, 1.0, 1.0e-13, 5).status, optim.ERR_NO_CONVERGE);
    printf("brent with 3 iterations: status %d\n", optim.brent(fCos, null, 0.0, 1.0, 1.0e-13, 3).status);
    printf("newton with a zero derivative: status %d (ERR_SINGULAR = %d)\n", optim.newton(fFlat, null, null, 0.0, 1.0e-12, 10).status, optim.ERR_SINGULAR);
    printf("newton on x^2 - 4 from 0 (the numerical derivative is exactly 0 there): status %d\n", optim.newton(fSq, null, null, 0.0, 1.0e-12, 10).status);
    printf("newton on log(x) - 1 from 0.01 converges: status %d; from 10 it leaves the domain: status %d (ERR_NAN = %d)\n", optim.newton(fLog, null, null, 0.01, 1.0e-12, 50).status, optim.newton(fLog, null, null, 10.0, 1.0e-12, 30).status, optim.ERR_NAN);
    printf("secant with equal values: status %d\n", optim.secant(fFlat, null, 0.0, 1.0, 1.0e-12, 10).status);
    printf("secant that does not converge in 2 iterations: %d\n", optim.secant(fCos, null, 0.0, 1.0, 1.0e-13, 2).status);
    printf("tolerance below zero: %d, NaN start: %d, infinite bracket: %d\n", optim.brent(fCos, null, 0.0, 1.0, -1.0, 100).status, optim.newton(fCos, null, null, dmath.nan(), 1.0e-9, 10).status, optim.brent(fCos, null, 0.0, dmath.INFINITY, 1.0e-9, 100).status);
    printf("errorText: %s | %s | %s\n", optim.errorText(optim.OK), optim.errorText(optim.ERR_BRACKET), optim.errorText(99));

    // ---- finding a bracket
    {
        double a;
        double b;
        int st = optim.findBracket(fSq, null, 3.0, 0.5, &a, &b);
        printf("findBracket for x^2 - 4 from 3: status %d, sign change %d\n", st, fSq(a, null) * fSq(b, null) <= 0.0);
        optim.Result in = optim.brent(fSq, null, a, b, 1.0e-13, 100);
        pr("brent in that bracket", in);
        st = optim.findBracket(fCos, null, 5.0, 0.1, &a, &b);
        printf("findBracket for cos(x) - x from 5: status %d, sign change %d\n", st, fCos(a, null) * fCos(b, null) <= 0.0);
        st = optim.findBracket(fFlat, null, 0.0, 1.0, &a, &b);
        printf("findBracket for a constant function: status %d (ERR_BRACKET = %d)\n", st, optim.ERR_BRACKET);
        st = optim.findBracket(fSq, null, 0.0, 0.0, &a, &b);
        printf("findBracket with step 0: status %d (ERR_ARG = %d)\n", st, optim.ERR_ARG);
    }

    // ---- systems of equations
    {
        double x[2] = {2.0, 0.5};
        optim.Result s = optim.newtonSystem(sys1, null, x, 2, 1.0e-13, 50);
        printf("system x^2 + y^2 = 4, x y = 1: status %d", s.status);
        printfd(" x %.11g y %.11g\n", __bits(x[0]), __bits(x[1]));
        printf("  residual below 1e-12: %d, iterations below 12: %d\n", s.fx < 1.0e-12, s.iterations < 12);
        double x3[3] = {0.8, 1.5, 3.5};
        s = optim.newtonSystem(sys3, null, x3, 3, 1.0e-13, 50);
        printfd("three equations: status %d x %.11g y %.11g z %.11g\n", s.status, __bits(x3[0]), __bits(x3[1]), __bits(x3[2]));
        double x2[2] = {1.0, 1.0};
        s = optim.newtonSystem(sysSingular, null, x2, 2, 1.0e-13, 50);
        printf("a singular Jacobian: status %d (ERR_SINGULAR = %d)\n", s.status, optim.ERR_SINGULAR);
        double x4[2] = {50.0, 3.0};
        s = optim.newtonSystem(sys1, null, x4, 2, 1.0e-13, 60);
        printf("a far away start still finds a solution: status %d, residual below 1e-12 %d\n", s.status, s.fx < 1.0e-12);
        s = optim.newtonSystem(sys1, null, null, 2, 1.0e-13, 60);
        printf("null x: status %d (ERR_ARG = %d)\n", s.status, optim.ERR_ARG);
        double x5[2] = {2.0, 0.5};
        s = optim.newtonSystem(sys1, null, x5, 2, 1.0e-13, 1);
        printf("one iteration only: status %d (ERR_NO_CONVERGE = %d)\n", s.status, optim.ERR_NO_CONVERGE);
    }

    // ---- derivatives
    printf("derivative of sin at 1 within 1e-8 of cos(1): %d, five point formula within 1e-10: %d\n", dmath.fabs(optim.derivative(fSin, null, 1.0, 0.0) - dmath.cos(1.0)) < 1.0e-8, dmath.fabs(optim.derivative5(fSin, null, 1.0, 0.0) - dmath.cos(1.0)) < 1.0e-10);
    {
        double h = 1.0e-5;
        double d1 = optim.derivative(fCubic, null, 2.0, 0.0);
        double d5 = optim.derivative5(fCubic, null, 2.0, 0.0);
        printf("derivative of x^3 - 2x - 5 at 2 (exact 10): central within 1e-8 %d, five point within 1e-9 %d\n", dmath.fabs(d1 - 10.0) < 1.0e-8, dmath.fabs(d5 - 10.0) < 1.0e-9);
        double d3 = optim.derivative(fCubic, null, 2.0, h);
        printf("with an explicit step: within 1e-6 %d\n", dmath.fabs(d3 - 10.0) < 1.0e-6);
        double x[3] = {1.5, 0.7, 2.0};
        double g[3];
        optim.gradientNum(fxy, null, x, 3, g);
        // exact gradient: (2 x y, x^2 + z cos y, sin y)
        double ex0 = 2.0 * 1.5 * 0.7;
        double ex1 = 1.5 * 1.5 + 2.0 * dmath.cos(0.7);
        double ex2 = dmath.sin(0.7);
        printf("gradient of x^2 y + z sin y (1e-8): %d\n", dmath.fabs(g[0] - ex0) < 1.0e-8 && dmath.fabs(g[1] - ex1) < 1.0e-8 && dmath.fabs(g[2] - ex2) < 1.0e-8);
        printf("x unchanged by the numerical gradient: %d\n", x[0] == 1.5 && x[1] == 0.7 && x[2] == 2.0);
        double jac[9];
        optim.jacobianNum(vecF, null, x, 3, 3, jac);
        // exact Jacobian rows: (y, x, 0), (e^x, 2y, 0), (1, -1, 0)
        double ej[9] = {0.7, 1.5, 0.0, dmath.exp(1.5), 1.4, 0.0, 1.0, -1.0, 0.0};
        double worst = 0.0;
        for (int i = 0; i < 9; i++) { worst = dmath.fmax(worst, dmath.fabs(jac[i] - ej[i])); }
        printf("Jacobian by forward differences (1e-6): %d\n", worst < 1.0e-6);
        double hs[9];
        optim.hessianNum(fxy, null, x, 3, hs);
        // exact Hessian: [[2y, 2x, 0], [2x, -z sin y, cos y], [0, cos y, 0]]
        double eh[9] = {1.4, 3.0, 0.0, 3.0, -2.0 * dmath.sin(0.7), dmath.cos(0.7), 0.0, dmath.cos(0.7), 0.0};
        worst = 0.0;
        for (int i = 0; i < 9; i++) { worst = dmath.fmax(worst, dmath.fabs(hs[i] - eh[i])); }
        printf("Hessian by central differences (1e-5): %d, symmetric: %d\n", worst < 1.0e-5, hs[1] == hs[3] && hs[2] == hs[6] && hs[5] == hs[7]);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
