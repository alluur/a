// gterm: the history keeps its 2000 lines, and a line that scrolls out of it is used again as the new bottom line. Before, every line that
// scrolled out of the full history was lost (about 4 KB each: a terminal that printed 100 MB grew to 4 GB). The statistic gterm.linesMade
// counts the Line objects that were ever made: 2000 for the history to fill, and none afterwards.
import gterm;
import cstdio;
import cstring;

int bad = 0;

// the text of history line i must be "<prefix> <first + i>"
int checkHistory(gterm.Terminal* t, char* prefix, int first) {
    char want[64];
    int wrong = 0;
    for (int i = 0; i < t->historyCount(); i++) {
        sprintf(&want[0], "%s %d", prefix, first + i);
        if (strcmp(t->historyText(i), &want[0]) != 0) {
            wrong++;
        }
    }
    return wrong;
}

void feedLines(gterm.Terminal* t, char* prefix, int from, int to) {
    char buf[64];
    for (int i = from; i <= to; i++) {
        sprintf(&buf[0], "%s %d\r\n", prefix, i);
        t->feed(&buf[0]);
    }
}

int main() {
    gterm.Terminal* t = new gterm.Terminal();
    int made0 = gterm.linesMade;

    // a short run: the history is not full yet
    feedLines(t, "row", 1, 100);
    printf("after 100 lines: history %d, made %d\n", t->historyCount(), gterm.linesMade - made0);
    printf("oldest: %s, newest: %s\n", t->historyText(0), t->historyText(t->historyCount() - 1));
    printf("history text wrong: %d\n", checkHistory(t, "row", 1));

    // a long run: 6000 lines. The history is full after 2000 of them and no line is made after that.
    feedLines(t, "row", 101, 6000);
    printf("after 6000 lines: history %d, made %d\n", t->historyCount(), gterm.linesMade - made0);
    printf("oldest: %s, newest: %s\n", t->historyText(0), t->historyText(t->historyCount() - 1));
    printf("history text wrong: %d\n", checkHistory(t, "row", 3978));
    printf("screen: %s | %s | %s\n", t->lineText(0), t->lineText(22), t->lineText(23));

    // the width changes: the lines that leave the history are used again with the new width, the old ones keep their text
    int before = gterm.linesMade;
    t->resizeGrid(120, 30);
    printf("resize 120x30: made %d\n", gterm.linesMade - before);
    before = gterm.linesMade;
    feedLines(t, "wide", 1, 3000);
    printf("after 3000 wide lines: history %d, made %d\n", t->historyCount(), gterm.linesMade - before);
    printf("oldest: %s, newest: %s\n", t->historyText(0), t->historyText(t->historyCount() - 1));
    printf("history text wrong: %d\n", checkHistory(t, "wide", 972));
    printf("screen: %s | %s\n", t->lineText(0), t->lineText(28));

    // fewer rows: the lines that no longer fit go to the full history, and the oldest ones are given back
    before = gterm.linesMade;
    t->resizeGrid(100, 10);
    printf("resize 100x10: history %d, made %d\n", t->historyCount(), gterm.linesMade - before);
    printf("newest: %s\n", t->historyText(t->historyCount() - 1));
    feedLines(t, "narrow", 1, 500);
    printf("after 500 narrow lines: history %d\n", t->historyCount());
    printf("newest: %s\n", t->historyText(t->historyCount() - 1));
    printf("out of range: [%s] [%s]\n", t->historyText(-1), t->historyText(2000));
    return 0;
}
