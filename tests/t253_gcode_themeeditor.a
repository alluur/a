// gcode.ThemeEditor: every colour and token style in a list, the picker, the live preview and the effect on the editors that are open,
// contrast warnings, loading, saving, duplicating and deleting themes in a directory, reverting
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asyntax;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.ThemeEditor* te;
gcode.CodeEditor* other;
gui.Window* w;
gui.Window* mainWin;
gcode.Look* look;
int changes = 0;

int onChange(int t) { changes++; return 0; }

int rowY(int i) { return (i - te->list->top) * te->list->rowH + te->list->rowH / 2; }

// a pixel in the empty area of an editor
int emptyPixel(gcode.CodeEditor* e, gui.Window* win) {
    return win->surf->get(e->absX() + e->w - 40, e->absY() + e->h - 40);
}

void names() {
    char* list[96];
    int n = te->themeNames(&list[0], 96);
    printf("themes (%d):", n);
    for (int i = 0; i < n; i++) { printf(" %s", list[i]); asys.free(list[i]); }
    printf("\n");
}

int main() {
    gcode.theLook()->autoComplete = false;
    rmtree("build/tests/t253_themes");
    gcode.setThemeDirectory("build/tests/t253_themes");
    startServerSized(7353, "t253", 1000, 900);
    look = gcode.theLook();
    look->setThemeName("dark");

    // an editor window that shows the effect
    mainWin = d->createWindow("Main", 400, 200, 0);
    other = new gcode.CodeEditor();
    other->blink = false;
    gui.Box* mcol = gui.vbox(0, 0);
    mcol->add(other);
    mainWin->setRoot(mcol);
    other->setText("int main() { return 1; }\n");
    other->doc->setLanguage(asyntax.Lang.A);
    settle();

    te = new gcode.ThemeEditor();
    te->onChange = onChange;
    w = te->show(d);
    settle();
    printf("entries: %d, the list shows colours first: %s\n", te->list->rowCount(), "Background");
    char nm[60];
    te->list->entryName(0, &nm[0]);
    printf("entry 0 is %s, ", nm);
    te->list->entryName(24, &nm[0]);
    printf("entry 24 is %s, ", nm);
    te->list->entryName(47, &nm[0]);
    printf("entry 47 is %s\n", nm);
    printf("theme dir %s, current theme %s, live %d, dirty %d\n", te->themeDir, te->currentName, te->live, te->dirty);
    names();

    // select entries with the mouse: the picker shows the colour
    clickWd(w, te->list, 100, rowY(0));
    printf("Background selected: entry %d, picker %06X (theme %06X), style boxes enabled %d\n", te->entry, te->picker->color, look->theme->colors[atheme.Col.Background], te->cbBold->enabled);
    te->list->select(25);
    settle();
    printf("a syntax entry: entry %d, picker %06X, style boxes enabled %d\n", te->entry, te->picker->color, te->cbBold->enabled);
    te->selectEntry(atheme.Col.Background);

    // a change made with the picker: preview, the other editor and the title follow at once
    int oldBg = emptyPixel(other, mainWin);
    int previewBefore = emptyPixel(te->preview, w);
    changes = 0;
    te->picker->userRgb(0x102844);
    settle();
    printf("after the picker: background %06X in the work theme, in the shared look %06X, dirty %d, changes %d\n", te->entryColor(atheme.Col.Background), look->theme->colors[atheme.Col.Background], te->dirty, changes);
    printf("the other editor window is repainted: %d, the preview too: %d\n", emptyPixel(other, mainWin) == 0xFF102844 && oldBg != 0xFF102844, emptyPixel(te->preview, w) == 0xFF102844 && previewBefore != 0xFF102844);
    printf("the entry in the list shows it: %d\n", w->surf->get(te->list->absX() + 20, te->list->absY() + rowY(0)) == 0xFF102844);

    // contrast: a foreground that is too close to the background
    printf("warnings with the new background: %d\n", te->warningCount);
    te->selectEntry(atheme.Col.Foreground);
    te->picker->userRgb(0x182c4c);
    settle();
    printf("foreground 182C4C: warnings %d, label: %s\n", te->warningCount, "see below");
    printf("[%s]\n", te->contrast->text);
    printf("the list of warnings has %d lines, the title says: %s\n", te->warnings->size(), te->warnTitle->text);
    te->picker->userRgb(0xe0e8f0);
    settle();
    printf("foreground E0E8F0: warnings %d, [%s]\n", te->warningCount, te->contrast->text);

    // token styles
    te->selectEntry(24 + asyntax.Tok.Keyword);
    printf("keyword: colour %06X, bold %d italic %d underline %d\n", te->entryColor(te->entry), te->cbBold->checked, te->cbItalic->checked, te->cbUnderline->checked);
    clickWd(w, te->cbBold, 10, 10);
    clickWd(w, te->cbUnderline, 10, 10);
    printf("after clicking Bold and Underline: style %d (bold 1, underline 4), shared look %d\n", te->entryStyle(te->entry), look->tokStyle(asyntax.Tok.Keyword));
    te->picker->userRgb(0xff8800);
    settle();
    printf("keyword colour in the shared look: %06X\n", look->tokColor(asyntax.Tok.Keyword) & 0xFFFFFF);
    printf("in the list: styles shown, entry text colour swatch %d\n", w->surf->get(te->list->absX() + 20, te->list->absY() + rowY(24 + asyntax.Tok.Keyword)) == 0xFFFF8800);
    clickWd(w, te->cbBold, 10, 10);
    printf("Bold off: style %d\n", te->entryStyle(te->entry));
    te->selectEntry(atheme.Col.Border);
    printf("a colour entry: style boxes disabled %d\n", !te->cbBold->enabled);

    // saving: a user theme goes to the directory; built-in names are refused
    printf("save under a built-in name: %d (refused)\n", te->saveThemeAs("dark"));
    printf("save under a bad name: %d (refused)\n", te->saveThemeAs("../evil"));
    printf("save under a bad name: %d (refused)\n", te->saveThemeAs(""));
    printf("save as sky: %d, file exists %d, dirty %d, current %s\n", te->saveThemeAs("sky"), asys.isFile("build/tests/t253_themes/sky.ini"), te->dirty, te->currentName);
    names();
    // the saved file can be used by any program
    atheme.Warnings wr();
    atheme.Theme* t = atheme.loadTheme("build/tests/t253_themes/sky.ini", &wr);
    printf("the file holds the colours: background %06X, keyword %06X, name %s, warnings %d\n", t->colors[atheme.Col.Background], t->tokColor[asyntax.Tok.Keyword], t->name, wr.count);

    // loading another theme through the combo box; then a user theme
    te->combo->select(1);
    settle();
    printf("combo item 1 (%s): shared look uses it %d, dirty %d\n", te->combo->text(), look->theme->colors[atheme.Col.Background] == atheme.builtin("light")->colors[atheme.Col.Background], te->dirty);
    printf("the other window follows: %d\n", emptyPixel(other, mainWin) == look->col(atheme.Col.Background));
    printf("load sky: %d, background %06X\n", te->loadTheme("sky"), te->entryColor(atheme.Col.Background));
    printf("load a theme that is not there: %d\n", te->loadTheme("not there"));

    // duplicate and delete
    printf("duplicate as sky2: %d, again: %d, as dark: %d\n", te->duplicate("sky2"), te->duplicate("sky2"), te->duplicate("dark"));
    names();
    printf("delete sky2: %d, file gone %d, theme is now %s\n", te->deleteTheme(), !asys.exists("build/tests/t253_themes/sky2.ini"), te->currentName);
    printf("delete a built-in theme: %d (refused)\n", te->deleteTheme());
    names();

    // the buttons: Duplicate asks for a name, Delete asks a question
    te->loadTheme("sky");
    int base = srv->windowCount();
    gui.Box* root = (gui.Box*) w->root;
    gui.Box* top = (gui.Box*) root->kids[0];
    gui.Box* left = (gui.Box*) top->kids[0];
    gui.Box* btns = (gui.Box*) left->kids[1];
    clickWd(w, btns->kids[0], 20, 10);
    printf("Duplicate opens a window: +%d\n", srv->windowCount() - base);
    keyMods('a', 0, adp.MOD_CTRL);
    typeStr("river");
    key(adp.KEY_ENTER, 13);
    printf("river exists: %d, message: %s\n", asys.isFile("build/tests/t253_themes/river.ini"), te->message->text);
    clickWd(w, btns->kids[2], 20, 10);
    printf("Delete asks: +%d windows\n", srv->windowCount() - base);
    key(adp.KEY_TAB, 9);
    key(adp.KEY_ENTER, 13);
    printf("No: river still there %d\n", asys.isFile("build/tests/t253_themes/river.ini"));
    clickWd(w, btns->kids[2], 20, 10);
    key(adp.KEY_ENTER, 13);
    printf("Yes: river there %d, current %s\n", asys.isFile("build/tests/t253_themes/river.ini"), te->currentName);
    te->loadTheme("sky");
    clickWd(w, btns->kids[1], 20, 10);
    printf("Save button: message %s\n", te->message->text);
    te->loadTheme("light");
    clickWd(w, btns->kids[1], 20, 10);
    printf("Save on a built-in theme: message %s\n", te->message->text);

    // live off: the shared look keeps its theme
    te->loadTheme("dark");
    gui.Box* bottom = (gui.Box*) root->kids[root->nkids - 1];
    clickWd(w, te->cbLive, 10, 10);
    printf("live off: %d\n", te->live);
    te->selectEntry(atheme.Col.Background);
    te->picker->userRgb(0x331133);
    settle();
    printf("the editor window keeps the old colour: %d, the preview shows the new one: %d\n", emptyPixel(other, mainWin) == look->col(atheme.Col.Background) && look->theme->colors[atheme.Col.Background] != 0x331133, emptyPixel(te->preview, w) == 0xFF331133);
    clickWd(w, te->cbLive, 10, 10);
    printf("live on again: the editor window follows: %d\n", emptyPixel(other, mainWin) == 0xFF331133);

    // revert: back to the theme the editor was opened with
    gui.Button* revert = (gui.Button*) bottom->kids[2];
    clickWd(w, revert, 20, 10);
    printf("Revert: background %06X, shared look %06X, dirty %d\n", te->entryColor(atheme.Col.Background), look->theme->colors[atheme.Col.Background], te->dirty);

    // pictures
    te->selectEntry(24 + asyntax.Tok.String);
    settle();
    printf("screenshot of the editor %u\n", shot(w));
    te->close();
    printf("closed: %d\n", w->closed);
    gcode.setThemeDirectory(null);
    return 0;
}
