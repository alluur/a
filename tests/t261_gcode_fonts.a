// Fonts that cannot be used: the Look falls back to the mono font (and says so) and the editors never divide by zero. A font file with
// a line height of 0 (an all-zero file) is damaged; the odd but valid fonts (1 pixel high, very tall, glyphs without width) lay out
// and edit without a crash. The font name is a persisted setting: applySettings with a bad one starts a normal editor.
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;

// a font file in the binary form of gfx.loadFont: ascent, height, then 224 glyphs (advance, bearing, top, width, height)
void putFont(char* path, int ascent, int height, int advance) {
    int n = 2 + 224 * 5;
    char* b = (char*) asys.alloc(n);
    memset(b, 0, n);
    b[0] = ascent;
    b[1] = height;
    for (int i = 0; i < 224; i++) { b[2 + i * 5] = advance; }
    asys.writeFile(path, b, n);
    asys.free(b);
}

void putBytes(char* path, int fill, int n) {
    char* b = (char*) asys.alloc(n + 1);
    memset(b, fill, n);
    asys.writeFile(path, b, n);
    asys.free(b);
}

// uses the editor in every way that divides by the line height or the cell width
void exercise(char* label) {
    gcode.Look* look = gcode.theLook();
    settle();
    w->setFocus(e);
    keyMods(adp.KEY_END, 0, adp.MOD_CTRL);
    typeStr("x");
    for (int i = 0; i < 40; i++) { hb->tap(adp.KEY_ENTER, 13); }
    settle();
    key(adp.KEY_PGUP, 0);
    key(adp.KEY_PGDN, 0);
    wheelWd(w, e, 40, 40, -3);
    wheelWd(w, e, 40, 40, 5);
    clickWd(w, e, 60, 30);
    dragWd(w, e, 50, 20, 150, 400);
    dragWd(w, e, 50, 20, 150, -30);
    e->wordWrap = true;
    e->setText("one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen\nsecond line\n");
    settle();
    key(adp.KEY_PGDN, 0);
    clickWd(w, e, 100, 20);
    e->wordWrap = false;
    e->setText("hello world\nsecond\n");
    settle();
    printf("%s: font %d, cell %d x line %d, rows %d, columns %d, text %d bytes\n", label, look->fontIndex, look->cellW, look->lineH,
           e->visibleRows(), e->columns(), e->buf->length());
}

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;
    startServer(7361, "t261");
    w = d->createWindow("Fonts", 420, 260, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    e->setText("hello world\nsecond\n");
    settle();
    gcode.Look* look = gcode.theLook();
    asys.mkdirs("build/tests/t261_fonts");
    int monoLine = look->lineH;
    int monoCell = look->cellW;
    printf("mono: cell %d x line %d\n", monoCell, monoLine);

    // fonts that are damaged or missing: refused, the mono font stays (setFontFile) or comes back (setFontName)
    char* bad[6] = {"build/tests/t261_fonts/zero.font", "build/tests/t261_fonts/ff.font", "build/tests/t261_fonts/short.font",
                    "build/tests/t261_fonts/empty.font", "build/tests/t261_fonts/none.font", "build/tests/t261_fonts"};
    putBytes(bad[0], 0, 5000);
    putBytes(bad[1], 255, 5000);
    putBytes(bad[2], 7, 100);
    putBytes(bad[3], 0, 0);
    for (int i = 0; i < 6; i++) {
        look->setFontIndex(gcode.FONT_SANS);
        bool file = look->setFontFile(bad[i]);
        bool name = look->setFontName(bad[i]);
        printf("bad font %d: setFontFile %d, setFontName %d, now font %d (mono is 0), line height %d\n", i, file, name, look->fontIndex, look->lineH > 0);
    }
    exercise("after the bad fonts");

    // a font without height: gfx refuses it as damaged
    gfx.Font* z = gfx.loadFont(bad[0]);
    printf("gfx.loadFont of an all-zero file: %d\n", z == null);

    // names: the good ones are used and reported as used
    printf("setFontName sans %d, sansbold %d, mono %d, empty name %d\n", look->setFontName("sans"), look->setFontName("sansbold"), look->setFontName("mono"), look->setFontName(""));

    // the settings carry the font name: a bad one must not break the start
    atheme.Settings* st = new atheme.Settings();
    st->font = "build/tests/t261_fonts/zero.font";
    look->applySettings(st);
    printf("applySettings with the zero font: font %d, line %d, cell %d\n", look->fontIndex, look->lineH, look->cellW);
    exercise("settings with the zero font");

    // odd but valid fonts
    char* odd = "build/tests/t261_fonts/odd.font";
    putFont(odd, 1, 1, 6);
    printf("1 pixel high font accepted: %d\n", look->setFontName(odd));
    exercise("1 pixel high");
    look->setLineGap(0);
    printf("gap 0: line %d\n", look->lineH);
    putFont(odd, 255, 255, 255);
    printf("255 pixel font accepted: %d\n", look->setFontName(odd));
    exercise("255 pixels");
    putFont(odd, 8, 12, 0);
    printf("font whose glyphs have no width accepted: %d\n", look->setFontName(odd));
    exercise("no advance");
    look->setLineGap(12);
    exercise("gap 12");
    look->setLineGap(0);
    look->setFontName("mono");
    settle();
    printf("back to mono: cell %d x line %d (same as at the start %d)\n", look->cellW, look->lineH, look->cellW == monoCell && look->lineH == monoLine);
    w->close();
    return 0;
}
