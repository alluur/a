// is / as need an object that knows its class: objects made with new, locals and globals do; the elements of an array of objects do not
// (they have no vtable pointer, so they are "not a Dog" for every class: documented in docs/LANGUAGE.md, section is and as)
class Animal { public: virtual int legs() { return 4; } }
class Dog : Animal { public: override int legs() { return 5; } }

Dog globalDog;
Dog globalDogs[2];

int main() {
    Dog local;
    Dog locals[2];
    Animal* heap = new Dog();
    Animal* a1 = &globalDog;
    Animal* a2 = &local;
    Animal* a3 = &locals[1];
    Animal* a4 = &globalDogs[1];
    printlnInt(heap is Dog ? 1 : 0);       // 1
    printlnInt(a1 is Dog ? 1 : 0);         // 1
    printlnInt(a2 is Dog ? 1 : 0);         // 1
    printlnInt(a3 is Dog ? 1 : 0);         // 0: an element of an array of objects
    printlnInt(a4 is Dog ? 1 : 0);         // 0
    Animal* ptrs[2];                       // an array of pointers to objects made with new is the way
    ptrs[0] = new Dog(); ptrs[1] = new Animal();
    foreach (Animal* p in ptrs) { printlnInt(p is Dog ? 1 : 0); }   // 1, 0
    return 0;
}
