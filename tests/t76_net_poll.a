// net: poll, connect time limits, peer address, socket options
import net;
int main() {
    int server = net.listenOn("127.0.0.1", 47141, 4);
    printlnInt(net.waitReadable(server, 50));                // nobody connects yet
    int c = net.connectTimeout("127.0.0.1", 47141, 1000);
    printlnInt(c >= 0);
    printlnInt(net.waitReadable(server, 1000));             // a connection is waiting
    int conn = net.accept(server);
    int ip; int port;
    printlnInt(net.peer(conn, &ip, &port));
    printlnInt(ip == 0x7F000001);
    printlnInt(port == net.localPort(c));
    printlnInt(net.localIp(c) == 0x7F000001);
    printlnInt(net.setNoDelay(c, true));
    printlnInt(net.setKeepAlive(c, true));
    net.sendText(c, "hi");
    int hs[2]; int ev[2]; int re[2];
    hs[0] = conn; ev[0] = net.READABLE;
    hs[1] = server; ev[1] = net.READABLE;
    printlnInt(net.poll(hs, ev, re, 2, 1000));
    printlnInt(re[0]); printlnInt(re[1]);
    char buf[8];
    printlnInt(net.recv(conn, buf, 8));
    net.shutdown(c, 1);
    printlnInt(net.waitReadable(conn, 1000));
    printlnInt(net.recv(conn, buf, 8));                    // 0: the other side finished sending
    printlnInt(net.connectTimeout("127.0.0.1", 47142, 500));   // refused
    printlnInt(strlen(net.hostName()) > 0);
    int u = net.udpBind(0);
    printlnInt(net.setBroadcast(u, true));
    printlnInt(net.setReuse(u, true));
    return 0;
}
