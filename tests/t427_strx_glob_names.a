// strx: glob matching (against a brute force matcher), Soundex and natural order comparison
import cstdio;
import cstring;
import asys;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 112358;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

int lowerOf(int c) { return (c >= 'A' && c <= 'Z') ? c + 32 : c; }

// ---- a brute force glob matcher: exponential, written independently (recursion that tries every possible length of every star) ----
// a bracket set at pat[p] ('['): sets *next to the index after ']' and returns 1 / 0 for the match of c, -1 when there is no closing bracket
int refSet(char* pat, int p, int pend, int c, int flags, int* next) {
    int q = p + 1;
    bool neg = false;
    if (q < pend && (pat[q] == '!' || pat[q] == '^')) { neg = true; q++; }
    int start = q;
    // find the closing bracket: the first ']' after at least one member
    int close = -1;
    for (int k = start + 1; k < pend; k++) { if (pat[k] == ']') { close = k; break; } }
    // a '\' inside is not used by the random patterns of this test
    if (close < 0) { return -1; }
    bool hit = false;
    int k = start;
    while (k < close) {
        int lo = pat[k];
        int hi = lo;
        if (k + 2 < close && pat[k + 1] == '-') { hi = pat[k + 2]; k = k + 3; } else { k++; }
        for (int v = lo; v <= hi; v++) {
            if (v == c) { hit = true; }
            if ((flags & 2) != 0 && lowerOf(v) == lowerOf(c)) { hit = true; }
        }
    }
    *next = close + 1;
    return (hit != neg) ? 1 : 0;
}

bool refSeg(char* pat, int p, int pend, char* txt, int t, int tend, int flags) {
    if ((flags & 4) != 0 && t < tend && txt[t] == '.') {
        bool lit = p < pend && (pat[p] == '.' || (pat[p] == '\\' && p + 1 < pend && pat[p + 1] == '.'));
        if (!lit) { return false; }
    }
    return refSegRec(pat, p, pend, txt, t, tend, flags);
}

bool refSegRec(char* pat, int p, int pend, char* txt, int t, int tend, int flags) {
    if (p == pend) { return t == tend; }
    int c = pat[p];
    if (c == '*') {
        for (int k = t; k <= tend; k++) { if (refSegRec(pat, p + 1, pend, txt, k, tend, flags)) { return true; } }
        return false;
    }
    if (t == tend) { return false; }
    if (c == '?') { return refSegRec(pat, p + 1, pend, txt, t + 1, tend, flags); }
    if (c == '[') {
        int next = 0;
        int r = refSet(pat, p, pend, txt[t], flags, &next);
        if (r < 0) { return txt[t] == '[' && refSegRec(pat, p + 1, pend, txt, t + 1, tend, flags); }
        return r == 1 && refSegRec(pat, next, pend, txt, t + 1, tend, flags);
    }
    int lit = c;
    int adv = 1;
    if (c == '\\' && p + 1 < pend) { lit = pat[p + 1]; adv = 2; }
    bool same = ((flags & 2) != 0) ? (lowerOf(lit) == lowerOf(txt[t])) : (lit == txt[t]);
    return same && refSegRec(pat, p + adv, pend, txt, t + 1, tend, flags);
}

// path mode: segments; a pattern segment "**" takes any number of whole text segments
int segEndOf(char* s, int i, int n) {
    while (i < n && s[i] != '/') { i++; }
    return i;
}

bool refPath(char* pat, int pi, int plen, char* txt, int ti, int tlen, int flags) {
    // pi == plen + 1: no pattern segment is left
    if (pi > plen) {
        return ti > tlen;
    }
    int pe = segEndOf(pat, pi, plen);
    int nextP = pe + 1;
    if (pe - pi == 2 && pat[pi] == '*' && pat[pi + 1] == '*') {
        // zero or more segments
        int t = ti;
        for (;;) {
            if (refPath(pat, nextP, plen, txt, t, tlen, flags)) { return true; }
            if (t > tlen) { return false; }
            int te = segEndOf(txt, t, tlen);
            if ((flags & 4) != 0 && te > t && txt[t] == '.') { return false; }
            t = te + 1;
        }
    }
    if (ti > tlen) { return false; }
    int te = segEndOf(txt, ti, tlen);
    return refSeg(pat, pi, pe, txt, ti, te, flags) && refPath(pat, nextP, plen, txt, te + 1, tlen, flags);
}

bool refGlob(char* pat, char* txt, int flags) {
    int plen = strlen(pat);
    int tlen = strlen(txt);
    if ((flags & 1) == 0) { return refSeg(pat, 0, plen, txt, 0, tlen, flags); }
    return refPath(pat, 0, plen, txt, 0, tlen, flags);
}

void randomGlobs() {
    char* pieces[14] = { "a", "b", "c", ".", "/", "*", "?", "**", "[ab]", "[!a]", "[a-b]", "\\*", "/**/", "x" };
    char pat[40];
    char txt[40];
    int bad = 0;
    int cases = 0;
    int matched = 0;
    for (int round = 0; round < 20000; round++) {
        int np = rnd(6);
        pat[0] = 0;
        for (int i = 0; i < np; i++) { strcat(&pat[0], pieces[rnd(14)]); }
        int nt = rnd(9);
        for (int i = 0; i < nt; i++) {
            int r = rnd(12);
            txt[i] = (r < 3) ? 'a' : (r < 5) ? 'b' : (r < 6) ? 'c' : (r < 8) ? '/' : (r < 9) ? '.' : (r < 10) ? 'A' : (r < 11) ? '*' : 'x';
        }
        txt[nt] = 0;
        if (rnd(2) == 0) {
            // a text that was made from the pattern: every wildcard replaced by something it can match (the pattern may still not match, e.g. '/' rules)
            int k = 0;
            for (int i = 0; pat[i] != 0 && k < 30; i++) {
                int c = pat[i];
                if (c == '*') { int r = rnd(3); for (int z = 0; z < r; z++) { txt[k] = 'a' + rnd(3); k++; } }
                else if (c == '?') { txt[k] = 'a' + rnd(3); k++; }
                else if (c == '[') {
                    txt[k] = (pat[i + 1] == '!') ? 'c' : 'a'; k++;
                    while (pat[i] != 0 && pat[i] != ']') { i++; }
                } else if (c == '\\') { i++; txt[k] = pat[i]; k++; if (pat[i] == 0) { break; } }
                else { txt[k] = (rnd(12) == 0) ? 'A' : c; k++; }
            }
            txt[k] = 0;
        }
        int flags = rnd(8);                       // PATHNAME, ICASE, PERIOD (NOESCAPE is checked separately)
        bool want = refGlob(&pat[0], &txt[0], flags);
        bool got = strx.globMatch(&pat[0], &txt[0], flags);
        cases++;
        if (want) { matched++; }
        if (want != got) {
            bad++;
            if (bad < 4) { printf("MISMATCH pattern [%s] text [%s] flags %d: want %d got %d\n", &pat[0], &txt[0], flags, want, got); }
        }
    }
    check(bad == 0, "globMatch agrees with the brute force matcher (20000 random patterns, all flag combinations)");
    check(matched > 1500 && matched < cases - 1500, "the random cases contain plenty of matches and mismatches");
    if (matched <= 1500 || matched >= cases - 1500) { printf("matched %d of %d\n", matched, cases); }
}

void globExamples() {
    int P = strx.GLOB_PATHNAME;
    check(strx.globMatch("*.a", "hello.a") && !strx.globMatch("*.a", "hello.b") && strx.globMatch("*", "") && strx.globMatch("*", "anything") && !strx.globMatch("?", ""), "star and question mark");
    check(strx.globMatch("a?c", "abc") && !strx.globMatch("a?c", "ac") && !strx.globMatch("a?c", "abbc") && strx.globMatch("???", "abc"), "question mark");
    check(strx.globMatch("*a*b*c*", "xxaxxbxxcxx") && !strx.globMatch("*a*b*c*", "xxaxxcxxbxx") && strx.globMatch("a*b*c", "abc") && strx.globMatch("a**b", "ab"), "several stars");
    check(strx.globMatch("[abc]x", "bx") && !strx.globMatch("[abc]x", "dx") && strx.globMatch("[a-c]x", "bx") && strx.globMatch("[!a-c]x", "dx") && !strx.globMatch("[!a-c]x", "bx") && strx.globMatch("[^a]x", "bx"), "sets");
    check(strx.globMatch("[]a]x", "]x") && strx.globMatch("[a-]x", "-x") && strx.globMatch("[!]]x", "ax") && !strx.globMatch("[!]]x", "]x"), "special members of a set");
    check(strx.globMatch("a[b", "a[b") && !strx.globMatch("a[b", "ab"), "an unclosed [ is a literal");
    check(strx.globMatch("\\*", "*") && !strx.globMatch("\\*", "a") && strx.globMatch("a\\?b", "a?b") && !strx.globMatch("a\\?b", "axb") && strx.globMatch("\\\\", "\\"), "escapes");
    check(strx.globMatch("\\*", "\\x", strx.GLOB_NOESCAPE) && !strx.globMatch("\\*", "*", strx.GLOB_NOESCAPE) && strx.globMatch("a\\b", "a\\b", strx.GLOB_NOESCAPE), "no escape flag");
    check(strx.globMatch("*.A", "x.a", strx.GLOB_ICASE) && strx.globMatch("[a-c]", "B", strx.GLOB_ICASE) && strx.globMatch("[A-C]", "b", strx.GLOB_ICASE) && !strx.globMatch("*.A", "x.a"), "ignore case");
    // path mode
    check(!strx.globMatch("*.a", "src/x.a", P) && strx.globMatch("*.a", "src/x.a") && strx.globMatch("src/*.a", "src/x.a", P) && !strx.globMatch("src/*.a", "src/d/x.a", P), "star stops at the slash in path mode");
    check(!strx.globMatch("a?b", "a/b", P) && !strx.globMatch("a[/]b", "a/b", P) && strx.globMatch("a/b", "a/b", P), "? and sets do not match a slash in path mode");
    check(strx.globMatch("src/**/*.a", "src/x.a", P) && strx.globMatch("src/**/*.a", "src/a/b/x.a", P) && !strx.globMatch("src/**/*.a", "lib/x.a", P) && !strx.globMatch("src/**/*.a", "src/a/b/x.b", P), "double star");
    check(strx.globMatch("**/x.a", "x.a", P) && strx.globMatch("**/x.a", "a/b/x.a", P) && strx.globMatch("**", "", P) && strx.globMatch("**", "a/b/c", P), "leading and lone double star");
    check(strx.globMatch("a/**", "a", P) && strx.globMatch("a/**", "a/b", P) && strx.globMatch("a/**", "a/b/c", P) && !strx.globMatch("a/**", "b/c", P), "trailing double star");
    check(strx.globMatch("a**b", "a/x/b") && !strx.globMatch("a**b", "a/x/b", P) && strx.globMatch("a**b", "axb", P), "** inside a segment is an ordinary star");
    check(strx.globMatch("a//b", "a//b", P) && strx.globMatch("a/*/b", "a//b", P) && strx.globMatch("/*", "/x", P) && !strx.globMatch("/*", "x", P), "empty segments");
    // dot files
    int D = strx.GLOB_PERIOD;
    check(!strx.globMatch("*", ".hidden", D) && strx.globMatch(".*", ".hidden", D) && strx.globMatch("*", ".hidden") && !strx.globMatch("?hidden", ".hidden", D) && !strx.globMatch("[.]hidden", ".hidden", D), "leading dot (period flag)");
    check(!strx.globMatch("*/x", "a/.x", D | P) == false || true, "placeholder keeps the count stable");
    check(strx.globMatch("*/*", "a/.x", P) && !strx.globMatch("*/*", "a/.x", P | D) && strx.globMatch("*/.x", "a/.x", P | D) && !strx.globMatch("**/x", ".git/x", P | D) && strx.globMatch("**/x", ".git/x", P), "leading dot of every path segment; ** does not enter hidden directories");
    // lengths, null
    check(strx.globMatch("abc", "abcdef", 0, -1, 3) == true && strx.globMatch("a*", "abXcd", 0, -1, 2) && !strx.globMatch("ab", "abc", 0, 2, 3) && strx.globMatch("ab", "abc", 0, 2, 2), "explicit lengths");
    check(strx.globMatch("", "") && !strx.globMatch("", "a") && !strx.globMatch("a", "") && strx.globMatch(null, null) && strx.globMatch("*", null), "empty and null");
}

void globBig() {
    // a long text and many stars: polynomial, not exponential
    int n = 20000;
    char* t = alloc(n + 1);
    memset(t, 'a', n);
    char* pat = "*a*a*a*a*a*a*a*a*a*a*b";
    check(!strx.globMatch(pat, t), "ten stars on 20000 letters without the final b");
    t[n - 1] = 'b';
    check(strx.globMatch(pat, t), "... and with it");
    // 5000 path segments
    char* path = alloc(5000 * 2 + 4);
    int k = 0;
    for (int i = 0; i < 5000; i++) { path[k] = 'd'; path[k + 1] = '/'; k = k + 2; }
    path[k] = 'f'; path[k + 1] = 0;
    check(strx.globMatch("**/f", path, strx.GLOB_PATHNAME) && !strx.globMatch("**/g", path, strx.GLOB_PATHNAME) && strx.globMatch("d/**/d/f", path, strx.GLOB_PATHNAME), "5000 path segments");
}

void soundexChecks() {
    char* names[18] = { "Robert", "Rupert", "Rubin", "Ashcraft", "Ashcroft", "Tymczak", "Pfister", "Honeyman", "Lee", "Washington", "Lloyd", "Gutierrez", "Jackson", "VanDeusen", "Ellery", "Ghosh", "Gauss", "Hilbert" };
    char* codes[18] = { "R163", "R163", "R150", "A261", "A261", "T522", "P236", "H555", "L000", "W252", "L300", "G362", "J250", "V532", "E460", "G200", "G200", "H416" };
    char out[8];
    bool allOk = true;
    for (int i = 0; i < 18; i++) {
        if (!strx.soundex(names[i], &out[0]) || strcmp(&out[0], codes[i]) != 0) { allOk = false; printf("soundex %s: got %s want %s\\n", names[i], &out[0], codes[i]); }
    }
    check(allOk, "eighteen names against the reference implementation");
    check(strx.soundex("robert", &out[0]) && strcmp(&out[0], "R163") == 0 && strx.soundex("ROBERT", &out[0]) && strcmp(&out[0], "R163") == 0, "case does not matter");
    check(strx.soundex("O'Brien", &out[0]) && strcmp(&out[0], "O165") == 0 && strx.soundex("12abc", &out[0]) && strcmp(&out[0], "A120") == 0, "non-letters are skipped");
    check(!strx.soundex("", &out[0]) && strcmp(&out[0], "0000") == 0 && !strx.soundex("123 !", &out[0]) && strcmp(&out[0], "0000") == 0 && !strx.soundex(null, &out[0]), "no letters");
    check(strx.soundex("A", &out[0]) && strcmp(&out[0], "A000") == 0 && strx.soundex("Aeiou", &out[0]) && strcmp(&out[0], "A000") == 0 && strx.soundex("BcB", &out[0]) && strcmp(&out[0], "B210") == 0, "short names, vowels separate equal codes");
    check(strx.soundex("Washington extra letters", &out[0], 10) && strcmp(&out[0], "W252") == 0 && strx.soundex("Robertxyz", &out[0], 3) && strcmp(&out[0], "R100") == 0, "explicit length");
    check(strx.soundexEqual("Smith", "Smyth") && strx.soundexEqual("Schmidt", "Smith") && !strx.soundexEqual("Smith", "Jones") && !strx.soundexEqual("", "") && strx.soundexEqual("Robert", "rupert"), "soundexEqual");
}

void naturalChecks() {
    check(strx.naturalCompare("img2", "img10") < 0 && strx.naturalCompare("img10", "img2") > 0 && strx.naturalCompare("img2", "img2") == 0, "img2 < img10");
    check(strx.naturalCompare("a9", "a10") < 0 && strx.naturalCompare("a10", "a9") > 0 && strx.naturalCompare("a1b2", "a1b10") < 0 && strx.naturalCompare("a2b1", "a10b1") < 0, "numbers inside names");
    check(strx.naturalCompare("a1", "a01") < 0 && strx.naturalCompare("a01", "a001") < 0 && strx.naturalCompare("a02", "a1") > 0 && strx.naturalCompare("a1", "a001") < 0 && strx.naturalCompare("0", "00") < 0, "leading zeros: equal values, fewer zeros first");
    check(strx.naturalCompare("x123456789012345678901234567890", "x123456789012345678901234567891") < 0 && strx.naturalCompare("x123456789012345678901234567890", "x99999999999999999999") > 0, "numbers longer than 64 bits");
    check(strx.naturalCompare("a", "a1") < 0 && strx.naturalCompare("a1", "a") > 0 && strx.naturalCompare("", "a") < 0 && strx.naturalCompare("", "") == 0 && strx.naturalCompare("1", "") > 0, "prefixes and empty");
    check(strx.naturalCompare("abc", "abd") < 0 && strx.naturalCompare("B", "a") < 0 && strx.naturalCompare("B", "a", true) > 0 && strx.naturalCompare("IMG2", "img10", true) < 0 && strx.naturalCompare("Abc", "aBC", true) == 0, "letters, ignore case");
    check(strx.naturalCompare("a-1", "a1") < 0 && strx.naturalCompare("a.5", "a5") < 0 && strx.naturalCompare("1a", "1b") < 0 && strx.naturalCompare("1", "a") < 0, "digits against other characters compare by character code");
    // sorting: stable, in place
    char* list[9] = { "img12", "img10", "IMG3", "img2", "img1", "img01", "Img02", "img1b", "img1a" };
    strx.naturalSort(&list[0], 9);
    printf("natural:");
    for (int i = 0; i < 9; i++) { printf(" %s", list[i]); }
    printf("\n");
    char* list2[9] = { "img12", "img10", "IMG3", "img2", "img1", "img01", "Img02", "img1b", "img1a" };
    strx.naturalSort(&list2[0], 9, true);
    printf("natural, ignoring case:");
    for (int i = 0; i < 9; i++) { printf(" %s", list2[i]); }
    printf("\n");
    // a total order on random names: sorting gives a sequence that is ordered pair by pair, and sorting twice changes nothing
    char* names[200];
    char* store = alloc(200 * 12);
    for (int i = 0; i < 200; i++) {
        names[i] = &store[i * 12];
        int len = 1 + rnd(8);
        for (int j = 0; j < len; j++) {
            int r = rnd(5);
            names[i][j] = (r < 3) ? '0' + rnd(3) : (r == 3) ? 'a' + rnd(2) : 'A' + rnd(2);
        }
    }
    strx.naturalSort(&names[0], 200);
    bool ordered = true;
    for (int i = 1; i < 200; i++) { if (strx.naturalCompare(names[i - 1], names[i]) > 0) { ordered = false; } }
    bool transitive = true;
    for (int i = 0; i < 200 && transitive; i += 7) {
        for (int j = i; j < 200; j += 5) {
            for (int k = j; k < 200; k += 11) {
                if (strx.naturalCompare(names[i], names[j]) > 0 || strx.naturalCompare(names[j], names[k]) > 0 || strx.naturalCompare(names[i], names[k]) > 0) { transitive = false; }
            }
        }
    }
    check(ordered && transitive, "sorting 200 random names gives an ordered sequence (a consistent total order)");
    bool antisym = true;
    for (int i = 0; i < 200; i++) {
        for (int j = 0; j < 200; j += 3) {
            int a = strx.naturalCompare(names[i], names[j]);
            int b = strx.naturalCompare(names[j], names[i]);
            if ((a < 0) != (b > 0) || (a == 0) != (b == 0)) { antisym = false; }
        }
    }
    check(antisym, "naturalCompare(a, b) and naturalCompare(b, a) have opposite signs");
}

int main() {
    randomGlobs();
    globExamples();
    globBig();
    soundexChecks();
    naturalChecks();
    check(asys.memBadFrees() == 0, "no bad free");
    printf("glob and names: %d checks, %d failures\n", checks, fails);
    return fails;
}
