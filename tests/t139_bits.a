// bits: popcount, clz/ctz, rotations, byte swaps, bit fields, unsigned helpers
import cstdio;
import bits;

int main() {
    printf("popcount: %d %d %d %d\n", bits.popcount(0), bits.popcount(255), bits.popcount(-1), bits.popcount(0x8000000000000001));
    printf("parity: %d %d\n", bits.parity(7), bits.parity(3));
    printf("clz: %d %d %d %d\n", bits.clz(0), bits.clz(1), bits.clz(0x00FF000000000000), bits.clz(-1));
    printf("ctz: %d %d %d %d\n", bits.ctz(0), bits.ctz(1), bits.ctz(0x100), bits.ctz(-9223372036854775807 - 1));
    printf("clz32/ctz32: %d %d %d %d\n", bits.clz32(0), bits.clz32(1), bits.ctz32(0), bits.ctz32(0x80000000));
    printf("log2: %d %d %d %d\n", bits.log2(0), bits.log2(1), bits.log2(1000), bits.log2(1 << 40));
    printf("pow2: %d %d %d | %d %d %d %d\n", bits.isPow2(0), bits.isPow2(64), bits.isPow2(65), bits.nextPow2(0), bits.nextPow2(5), bits.nextPow2(64), bits.nextPow2(65));
    printf("mask: %d %d %d %d\n", bits.mask(0), bits.mask(1), bits.mask(12), bits.mask(64));
    printf("rotl32: %d %d %d\n", bits.rotl32(0x80000001, 1), bits.rotl32(0x12345678, 8), bits.rotl32(5, 0));
    printf("rotr32: %d %d\n", bits.rotr32(1, 1), bits.rotr32(0x12345678, 8));
    printf("rotl64: %d %d\n", bits.rotl64(0x8000000000000001, 1), bits.rotr64(1, 1) == 0x8000000000000000);
    printf("bswap: %d %d %d\n", bits.bswap16(0x1234), bits.bswap32(0x11223344), bits.bswap64(0x0102030405060708));
    printf("rev: %d %d %d %d\n", bits.rev8(1), bits.rev16(1), bits.rev32(1), bits.rev64(1) == 0x8000000000000000);
    printf("bit ops: %d %d %d %d %d\n", bits.get(5, 0), bits.get(5, 1), bits.set(0, 4), bits.clear(31, 0), bits.flip(5, 1));
    printf("fields: %d %d %d\n", bits.field(0xABCD, 4, 8), bits.insert(0xFF00, 4, 4, 0x5), bits.field(-1, 60, 4));
    printf("signExtend: %d %d %d %d\n", bits.signExtend(255, 8), bits.signExtend(127, 8), bits.signExtend(0x8000, 16), bits.signExtend(5, 64));
    printf("fits: %d %d %d %d %d %d\n", bits.fitsSigned(127, 8), bits.fitsSigned(128, 8), bits.fitsSigned(-128, 8), bits.fitsUnsigned(255, 8), bits.fitsUnsigned(256, 8), bits.fitsUnsigned(-1, 8));
    printf("unsigned: %d %d %d %d\n", bits.udiv(-1, 2), bits.umod(-1, 10), bits.ucmp(-1, 1), bits.ucmp(1, -1));
    return 0;
}
