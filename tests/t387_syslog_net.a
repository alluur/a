// generated by tests/gen/gen_https_test.py (test certificates, valid until 2100): do not edit
char* CA_PEM = "-----BEGIN CERTIFICATE-----\nMIIBLjCB1aADAgECAggQvbB9NiqTqjAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjASMRAwDgYD\nVQQDDAdUZXN0IENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEZoa0iPF3loM9\nqz2/ImJLRjibLJ9hd1WdtHD49KKzTbauTzUXNZX0JXbYVQF1P3l/QpVkXnf50+NE\n5T+hdgwFwaMTMBEwDwYDVR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDAgNIADBFAiAi\n2nMi9gLSWn22okG7qxH4QY8cymApI39Z6xKucwY6DQIhAJGEtUeEhQhgL/OMhpvm\ngSel0jdLf5pEleFCFoHzH7Hn\n-----END CERTIFICATE-----\n";
char* SERVER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPTCB5aADAgECAghotNTSsBOFvDAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAUMRIwEAYD\nVQQDDAkxMjcuMC4wLjEwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASQo30/KSJR\nbLR0qkuSKMRwxN2Xvd08KFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA\n0tODiEQ9MEeCoyEwHzAMBgNVHRMBAf8EAjAAMA8GA1UdEQQIMAaHBH8AAAEwCgYI\nKoZIzj0EAwIDRwAwRAIgU64nzo1fbN1Q020h4M68boDulT6ZPr2sHq2luv7FldQC\nIC+L4vvfr326IW2u5O57h04274NWnE7Q40w44uqIwI8m\n-----END CERTIFICATE-----\n";
char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";
char* STRANGER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPzCB5qADAgECAggQooP33JMRCDAKBggqhkjOPQQDAjATMREwDwYDVQQDDAhP\ndGhlciBDQTAgFw0yMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowFDESMBAG\nA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAESGzdSqEX\nfcdvOu7FW5LokaFUX6T3H+Uv6Phce9S06Dw9oh5p2phKAMqbGn8NL20emZetycF1\nyFTn/teSJ1Bt3aMhMB8wDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwR/AAABMAoG\nCCqGSM49BAMCA0gAMEUCIQDN+ASE1vNvveEm/4o9If40ZlMUQWP6kr0zrWnk1taQ\n9QIgYVrITfLWZqRs9cbjtTaEDcrOadDwvBx1R+R1f5qk01s=\n-----END CERTIFICATE-----\n";
char* STRANGER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2Hn4c01UmR2L+x+7\nDlLis81vDspgD6J4c2wPo8uS7W2hRANCAARIbN1KoRd9x2867sVbkuiRoVRfpPcf\n5S/o+Fx71LToPD2iHmnamEoAypsafw0vbR6Zl63JwXXIVOf+15InUG3d\n-----END PRIVATE KEY-----\n";

// The syslog sender against the collector over loopback (one thread: the collector runs from net.setIdleHook): UDP, TCP with octet counting and with newline
// framing, TLS with a verified certificate; messages in order, binary and multi-line texts, truncation at maxDatagram, the sender's queue limits and its
// behaviour towards a collector that is down (it does not block, it queues, it delivers when the collector is back), a connection that is cut off in the middle of a
// frame (the message is sent again completely, nothing is garbled), a collector that closes the connection; and the collector's reading of TCP frames from raw
// sockets (split anywhere, CR LF, mixed framings, bad counts, over-long frames), UDP datagrams (trailing newline, too big, malformed), many senders.
import syslog;
import syslogd;
import net;
import tls;
import x509;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

syslogd.Server* srv;
int TS = 1065910455;                     // 2003-10-11 22:14:15 UTC

int hook() {
    srv->poll(0);
    return 0;
}

void settle(int rounds = 20) {
    for (int i = 0; i < rounds; i++) srv->poll(1);
}

syslogd.Ring* ring() { return srv->collector->ring; }

bool lineIs(int i, char* want) {
    char* l = ring()->line(i);
    return l != null && streq(l, want);
}

// waits until the ring has n lines (or 2 s pass)
bool waitLines(int n) {
    int t0 = millis();
    while (ring()->count() < n && millis() - t0 < 2000) srv->poll(2);
    return ring()->count() == n;
}

syslog.Sender* sender(char* scheme, int port) {
    char url[100];
    format(&url[0], 100, "%s://127.0.0.1:%d", scheme, port, 0, 0);
    syslog.Sender* s = syslog.newSender(&url[0]);
    if (s == null) return null;
    s->setHostName("host1");
    s->setApp("myapp", "42");
    s->now = TS;
    return s;
}

int rawTcp(int port) {
    int h = net.connect("127.0.0.1", port);
    net.setTimeout(h, 2000);
    return h;
}

void sendText(int h, char* t) { net.send(h, t, strlen(t)); }

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    srv = syslogd.newServer();
    srv->collector->setClock(TS);
    check("the collector listens on UDP, TCP and TLS", srv->listenUdp(0) && srv->listenTcp(0) && srv->listenOn("127.0.0.1", 0, good));
    int udpPort = srv->udpPort;
    int tcpPort = srv->net->listenerPort(0);
    int tlsPort = srv->net->listenerPort(1);
    net.setIdleHook(hook);
    syslogd.Collector* col = srv->collector;

    // ---- UDP ------------------------------------------------------------------------------------------------------------------------------------------
    syslog.Sender* u = sender("udp", udpPort);
    check("a sender for udp://", u != null && u->transport == syslog.TRANSPORT_UDP);
    u->warning("a UDP message");
    settle();
    check("an RFC 5424 message over UDP", ring()->count() == 1 && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: a UDP message"));
    check("the facility and severity arrived", ring()->severityOf(0) == syslog.SEV_WARNING && col->stats->udp == 1 && col->stats->parsed == 1);
    u->format = syslog.FORMAT_3164;
    u->error("a 3164 message");
    settle();
    check("an RFC 3164 message over UDP", lineIs(1, "Oct 11 22:14:15 host1 myapp[42]: a 3164 message") && ring()->severityOf(1) == syslog.SEV_ERR);
    u->format = syslog.FORMAT_5424;
    u->sendFull(syslog.FAC_AUTH, syslog.SEV_CRIT, "ID47", "[meta@1 k=\"v\"]", "with msgid and structured data", 30);
    settle();
    col->lineFormat = syslogd.LINE_DETAIL;
    u->sendFull(syslog.FAC_LOCAL3, syslog.SEV_INFO, null, null, "detail", 6);
    settle();
    check("LINE_DETAIL shows the facility and severity names", lineIs(3, "2003-10-11T22:14:15Z host1 local3.info myapp[42]: detail"));
    col->lineFormat = syslogd.LINE_RAW;
    u->send(syslog.SEV_NOTICE, "raw");
    settle();
    char* rawLine = ring()->line(4);
    check("LINE_RAW keeps the message as it came", rawLine != null && startsWith(rawLine, "<13>1 2003-10-11T22:14:15.") && endsWith(rawLine, "Z host1 myapp 42 - - raw"));
    col->lineFormat = syslogd.LINE_TRADITIONAL;
    ring()->clear();
    char* big = alloc(6000);
    memset(big, 'b', 5999);
    big[5999] = 0;
    u->send(syslog.SEV_INFO, big);
    settle();
    check("a message over maxDatagram (2048) is cut", ring()->count() == 1 && ring()->lineLength(0) > 1900 && ring()->lineLength(0) < 2100);
    ring()->clear();
    u->dispose();

    // ---- TCP with octet counting ----------------------------------------------------------------------------------------------------------------------------------
    syslog.Sender* t = sender("tcp", tcpPort);
    check("a sender for tcp://", t != null && t->transport == syslog.TRANSPORT_TCP && t->framing == syslog.FRAMING_OCTET);
    for (int i = 0; i < 100; i++) {
        char text[40];
        format(&text[0], 40, "message number %d", i, 0, 0, 0);
        t->info(&text[0]);
    }
    check("100 messages are written completely", t->flush(2000) && t->queued() == 0 && t->sent == 100);
    check("... and arrive in order", waitLines(100) && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: message number 0") && lineIs(99, "Oct 11 22:14:15 host1 myapp[42]: message number 99") && col->stats->tcp == 100);
    ring()->clear();
    t->info("two\nlines\r\nand\x01a control character");
    t->flush(1000);
    check("a text with line feeds, CR LF and a control character arrives whole; the ring line shows them as #ooo", waitLines(1) && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: two#012lines#015#012and#001a control character"));
    ring()->clear();
    char binary[8];
    binary[0] = 'a'; binary[1] = 0; binary[2] = 255; binary[3] = 200; binary[4] = 'b';
    t->sendFull(syslog.FAC_USER, syslog.SEV_INFO, null, null, &binary[0], 5);
    t->flush(1000);
    check("a text with a 0 byte and bytes over 127 arrives (the NUL is shown as #000)", waitLines(1) && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: a#000\xFF\xC8b"));
    ring()->clear();
    t->dispose();

    // ---- TCP with newline framing ----------------------------------------------------------------------------------------------------------------------------------------
    t = sender("tcp", tcpPort);
    t->framing = syslog.FRAMING_NEWLINE;
    t->info("one line");
    t->info("a text with\nan embedded newline");
    t->flush(1000);
    check("newline framing: two messages, the embedded newline became a blank", waitLines(2) && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: one line") && lineIs(1, "Oct 11 22:14:15 host1 myapp[42]: a text with an embedded newline"));
    ring()->clear();
    t->dispose();

    // ---- TLS ----------------------------------------------------------------------------------------------------------------------------------------------------
    syslog.Sender* s = sender("tls", tlsPort);
    check("a sender for tls://", s != null && s->transport == syslog.TRANSPORT_TLS);
    s->info("over TLS");
    s->notice("and another");
    check("TLS: written completely", s->flush(3000));
    check("... both arrive (the certificate was verified against the CA)", waitLines(2) && lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: over TLS") && col->stats->tls == 2);
    s->dispose();
    ring()->clear();
    x509.clearRoots();
    s = sender("tls", tlsPort);
    s->connectTimeoutMs = 1000;
    s->info("must not arrive");
    check("without a trusted CA nothing is sent (the message waits, an error is counted)", !s->flush(300) && s->errors >= 1 && ring()->count() == 0 && s->queued() == 1);
    s->verify = false;
    s->retryIntervalMs = 0;
    check("with verify off the waiting message goes out", s->flush(3000) && waitLines(1));
    s->dispose();
    x509.addRootPem(CA_PEM);
    ring()->clear();

    // ---- a collector that is down, a connection that is cut --------------------------------------------------------------------------------------------------------------
    int fake = net.listen(0, 4);
    int fakePort = net.localPort(fake);
    net.close(fake);                                    // nothing listens there
    t = sender("tcp", fakePort);
    t->connectTimeoutMs = 300;
    t->retryIntervalMs = 100000;
    int t0 = millis();
    for (int i = 0; i < 3000; i++) t->info("nobody is listening");
    check("3000 messages for a collector that is down: no blocking (one connection attempt)", millis() - t0 < 1500 && t->errors == 1);
    check("... at most maxQueueMessages are kept, the rest is dropped and counted", t->queued() == 1000 && t->dropped == 2000 && t->sent == 0);
    t->dispose();
    t = sender("tcp", fakePort);
    t->maxQueueBytes = 1000;
    t->connectTimeoutMs = 300;
    char* text60 = "012345678901234567890123456789012345678901234567890123456789";
    for (int i = 0; i < 40; i++) t->info(text60);
    check("... and at most maxQueueBytes", t->queued() < 14 && t->dropped >= 26);
    t->dispose();

    // the collector comes back on the port the sender knows: the queue is delivered
    srv->shutdown();
    srv = syslogd.newServer();
    srv->collector->setClock(TS);
    srv->listenOn("127.0.0.1", 0, null);
    int p2 = srv->net->listenerPort(0);
    col = srv->collector;
    t = sender("tcp", p2 + 0);
    t->retryIntervalMs = 50;
    t->info("first");
    t->flush(2000);
    waitLines(1);
    srv->net->killAll();
    settle();
    t->info("second, the connection was cut");
    t->info("third");
    check("a collector that closed the connection: the sender notices, connects again and delivers", t->flush(3000) && waitLines(3) && t->reconnects >= 1);
    check("... in order, nothing lost and nothing twice", lineIs(0, "Oct 11 22:14:15 host1 myapp[42]: first") && lineIs(1, "Oct 11 22:14:15 host1 myapp[42]: second, the connection was cut") && lineIs(2, "Oct 11 22:14:15 host1 myapp[42]: third"));
    ring()->clear();
    t->dispose();

    // a connection that is cut in the middle of a frame: a fake collector that never reads, until the sender cannot write any more, then it vanishes
    int fl = net.listen(0, 4);
    int flPort = net.localPort(fl);
    syslog.Sender* cutting = sender("tcp", flPort);
    cutting->retryIntervalMs = 50;
    cutting->maxQueueBytes = 16777216;
    cutting->maxQueueMessages = 1000;
    cutting->maxMessage = 8192;
    char* body = alloc(8200);
    int sentCalls = 0;
    for (int i = 0; i < 1000 && cutting->queued() < 20; i++) {
        format(&body[0], 20, "msg%05d ", i, 0, 0, 0);
        memset(&body[9], 'x', 7900);
        body[7909] = 0;
        cutting->info(body);
        sentCalls++;
    }
    int writtenBefore = cutting->sent;
    check("the fake collector does not read: the socket buffers fill up and the frames queue (the sender never blocks)", cutting->queued() >= 20 && writtenBefore > 10);
    int c1 = net.accept(fl);
    net.close(c1);                                      // the connection is reset: some frame is cut in the middle
    net.close(fl);
    srv->shutdown();
    srv = syslogd.newServer();
    srv->collector->setClock(TS);
    srv->listenOn("127.0.0.1", flPort, null);
    col = srv->collector;
    syslogd.Ring* r2 = col->addRing(null, 2000, 1048576);
    r2->maxLine = 48;
    check("the sender goes on after the reset and delivers the rest", cutting->flush(8000) && cutting->queued() == 0 && cutting->reconnects >= 1);
    int t2 = millis();
    while (col->stats->received < sentCalls - writtenBefore && millis() - t2 < 3000) srv->poll(2);
    check("the collector got every frame from the first one that was not completely written, no more", col->stats->received == sentCalls - writtenBefore);
    check("... all of them whole: no malformed message, no framing error", col->stats->malformed == 0 && col->stats->framingErrors == 0);
    bool consecutive = r2->count() > 0;
    for (int i = 0; i < r2->count(); i++) {
        char want[24];
        format(&want[0], 24, "msg%05d x", writtenBefore + i, 0, 0, 0);
        if (strlen(r2->line(i)) < 33 + 9 || memcmp(&r2->line(i)[33], &want[0], 9) != 0) { consecutive = false; break; }
    }
    check("... in order, starting with the frame that was cut", consecutive && r2->count() == sentCalls - writtenBefore);
    cutting->dispose();
    srv->shutdown();
    srv = syslogd.newServer();
    srv->collector->setClock(TS);
    srv->listenUdp(0);
    srv->listenTcp(0);
    udpPort = srv->udpPort;
    tcpPort = srv->tcpPort;
    col = srv->collector;

    // ---- the collector reads TCP streams -------------------------------------------------------------------------------------------------------------------------------
    int h = rawTcp(tcpPort);
    char* frame = "38 <14>Oct 11 22:14:15 h app: octet frame";
    sendText(h, "38 <14>Oct 11 22:14:15 h app: octet frame");
    check("a frame with octet counting", waitLines(1) && lineIs(0, "Oct 11 22:14:15 h app: octet frame"));
    for (int i = 0; i < strlen(frame); i++) net.send(h, &frame[i], 1);
    check("the same frame one byte at a time", waitLines(2) && lineIs(1, "Oct 11 22:14:15 h app: octet frame"));
    sendText(h, "<14>Oct 11 22:14:15 h app: newline frame\n");
    check("a newline frame", waitLines(3) && lineIs(2, "Oct 11 22:14:15 h app: newline frame"));
    sendText(h, "<14>Oct 11 22:14:15 h app: crlf frame\r\n");
    check("a frame that ends in CR LF", waitLines(4) && lineIs(3, "Oct 11 22:14:15 h app: crlf frame"));
    sendText(h, "\r\n\n38 <14>Oct 11 22:14:15 h app: octet frame\n<14>Oct 11 22:14:15 h app: after octet\n");
    check("blank lines between frames, a LF behind an octet frame, mixed framings in one stream", waitLines(6) && lineIs(4, "Oct 11 22:14:15 h app: octet frame") && lineIs(5, "Oct 11 22:14:15 h app: after octet"));
    sendText(h, "2026-10-11 no priority, a line that starts with digits\n");
    check("a line that starts with digits (not an octet count) is a newline frame", waitLines(7) && startsWith(ring()->line(6), "Oct 11 22:14:15 127.0.0.1 2026-10-11 no priority"));
    sendText(h, "0 \n<14>Oct 11 22:14:15 h app: after zero\n");
    check("a frame that starts with 0 is a newline frame (an octet count has no leading zero)", waitLines(9) && startsWith(ring()->line(7), "Oct 11 22:14:15 127.0.0.1 0") && lineIs(8, "Oct 11 22:14:15 h app: after zero"));
    sendText(h, "<14>Oct 11 22:14:15 h app: split ");
    settle(10);
    check("a frame that is not finished yet is not delivered", ring()->count() == 9);
    sendText(h, "in two\n");
    check("... it is when the rest comes", waitLines(10) && lineIs(9, "Oct 11 22:14:15 h app: split in two"));
    net.close(h);
    ring()->clear();
    int fe0 = col->stats->framingErrors;
    h = rawTcp(tcpPort);
    sendText(h, "99999999 x");
    char tmp[16];
    int t1 = millis();
    while (millis() - t1 < 1500 && net.waitReadable(h, 10) == false) srv->poll(0);
    check("an octet count of 99999999 closes the connection", net.recv(h, &tmp[0], 16) <= 0 && col->stats->framingErrors == fe0 + 1);
    net.close(h);
    h = rawTcp(tcpPort);
    sendText(h, "16385 x");
    t1 = millis();
    while (millis() - t1 < 1500 && net.waitReadable(h, 10) == false) srv->poll(0);
    check("a count over maxMessage (16384) closes it", net.recv(h, &tmp[0], 16) <= 0 && col->stats->framingErrors == fe0 + 2);
    net.close(h);
    h = rawTcp(tcpPort);
    char* longLine = alloc(17000);
    memset(longLine, 'x', 16999);
    longLine[16999] = 0;
    net.send(h, longLine, 16999);
    t1 = millis();
    while (millis() - t1 < 1500 && net.waitReadable(h, 10) == false) srv->poll(0);
    check("a line without an end that grows past maxMessage closes it", net.recv(h, &tmp[0], 16) <= 0 && col->stats->framingErrors == fe0 + 3);
    net.close(h);
    h = rawTcp(tcpPort);
    sendText(h, "1234567 <14>x");
    t1 = millis();
    while (millis() - t1 < 1500 && net.waitReadable(h, 10) == false) srv->poll(0);
    check("seven digits of count close it", net.recv(h, &tmp[0], 16) <= 0 && col->stats->framingErrors == fe0 + 4);
    net.close(h);
    settle();
    check("the collector is fine: no connection is left", srv->net->count() == 0 && ring()->count() == 0);

    // ---- raw UDP -----------------------------------------------------------------------------------------------------------------------------------------------------
    int us = net.udpSocket();
    char* d1 = "<34>Oct 11 22:14:15 mymachine su: 'su root' failed\n";
    net.sendTo(us, 0x7F000001, udpPort, d1, strlen(d1));
    settle();
    check("a datagram with a newline at its end", ring()->count() == 1 && lineIs(0, "Oct 11 22:14:15 mymachine su: 'su root' failed"));
    char* d2 = "<13>hello without host or time";
    net.sendTo(us, 0x7F000001, udpPort, d2, strlen(d2));
    settle();
    check("a message without a time and a host: the time of reception and the address of the sender", lineIs(1, "Oct 11 22:14:15 127.0.0.1 hello without host or time"));
    int bad0 = col->stats->malformed;
    net.sendTo(us, 0x7F000001, udpPort, "<999>1 broken", 13);
    net.sendTo(us, 0x7F000001, udpPort, "<34>1 2003-13-11T22:14:15Z h a p m - x", 38);
    net.sendTo(us, 0x7F000001, udpPort, "\n", 1);
    settle();
    check("malformed datagrams are counted and dropped", col->stats->malformed == bad0 + 3 && ring()->count() == 2);
    col->maxMessage = 100;
    char* d3 = alloc(300);
    memset(d3, 'y', 299);
    memcpy(d3, "<13>", 4);
    net.sendTo(us, 0x7F000001, udpPort, d3, 299);
    settle();
    check("a datagram over maxMessage is dropped and counted", col->stats->oversize == 1 && ring()->count() == 2);
    col->maxMessage = 16384;
    col->keepMalformed = true;
    net.sendTo(us, 0x7F000001, udpPort, "<999>kept anyway", 16);
    settle();
    check("keepMalformed stores a message that cannot be parsed as user.notice", ring()->count() == 3 && endsWith(ring()->line(2), "<999>kept anyway"));
    col->keepMalformed = false;
    net.close(us);
    ring()->clear();

    // ---- many senders ---------------------------------------------------------------------------------------------------------------------------------------------------------
    syslog.Sender* many[10];
    for (int i = 0; i < 10; i++) {
        many[i] = sender(i % 2 == 0 ? "tcp" : "udp", i % 2 == 0 ? tcpPort : udpPort);
        char app[16];
        format(&app[0], 16, "app%d", i, 0, 0, 0);
        many[i]->setApp(&app[0], null);
    }
    for (int round = 0; round < 20; round++) {
        for (int i = 0; i < 10; i++) many[i]->info("hello");
        settle(2);
    }
    for (int i = 0; i < 10; i++) many[i]->flush(1000);
    settle(30);
    check("10 senders (5 TCP, 5 UDP) with 20 messages each: all 200 arrive", ring()->count() == 200 && col->stats->received >= 200);
    int perApp[10];
    for (int i = 0; i < 10; i++) perApp[i] = 0;
    for (int i = 0; i < ring()->count(); i++) {
        char* l = ring()->line(i);
        for (int a = 0; a < 10; a++) {
            char key[24];
            format(&key[0], 24, "host1 app%d:", a, 0, 0, 0);
            if (contains(l, &key[0])) perApp[a]++;
        }
    }
    bool all20 = true;
    for (int i = 0; i < 10; i++) { if (perApp[i] != 20) all20 = false; }
    check("... 20 from each", all20);
    for (int i = 0; i < 10; i++) many[i]->dispose();

    printf("%d checks, %d failed\n", checks, fails);
    srv->shutdown();
    return fails == 0 ? 0 : 1;
}
