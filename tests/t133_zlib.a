    char* g = malloc(1564);
    for (int i = 0; i < 1564; i++) { g[i] = ref[i]; }
    char* gd = zlib.gunzip(g, 1564, &rn);
    printf("foreign stream: %d bytes, crc %d\n", rn, gd != null && hash.crc32(gd, rn) == 497906190);
    return 0;
}
