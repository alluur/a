import cstdio;
import cstdlib;
import cstring;
import zlib;
import hash;

int main() {
    // text compresses, and comes back identical through every container
    char* text = malloc(40000);
    int n = 0;
    for (int i = 0; i < 1000; i++) {
        n = n + sprintf(&text[n], "line %d: the quick brown fox jumps over the lazy dog\n", i % 37);
    }
    int pn;
    char* p = zlib.gzip(text, n, &pn);
    printf("gzip: %s, smaller %d\n", (p[0] & 255) == 0x1F ? "magic ok" : "bad magic", pn * 4 < n);
    int rn;
    char* r = zlib.gunzip(p, pn, &rn);
    printf("gunzip: %d bytes, same %d\n", rn == n, r != null && memcmp(r, text, n) == 0);

    int zn;
    char* z = zlib.compress(text, n, &zn);
    int dn;
    char* d = zlib.decompress(z, zn, &dn);
    printf("zlib: header %d, same %d\n", z[0] == 0x78, d != null && dn == n && memcmp(d, text, n) == 0);

    int un;
    char* raw = zlib.deflate(text, n, &un);
    int bn;
    char* b = zlib.inflate(raw, un, &bn);
    printf("raw: same %d\n", b != null && bn == n && memcmp(b, text, n) == 0);

    // damaged data is refused
    p[pn / 2] = p[pn / 2] ^ 0x55;
    printf("damaged gzip refused: %d\n", zlib.gunzip(p, pn, &rn) == null);
    z[zn - 1] = z[zn - 1] ^ 1;
    printf("bad adler refused: %d\n", zlib.decompress(z, zn, &dn) == null);
    printf("garbage refused: %d\n", zlib.gunzip("not a gzip file at all", 22, &rn) == null);

    // random bytes do not grow much (stored blocks), empty and tiny inputs work
    char* rnd = malloc(100000);
    int seed = 12345;
    for (int i = 0; i < 100000; i++) {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        rnd[i] = (seed >> 16) & 255;
    }
    int cn;
    char* c = zlib.gzip(rnd, 100000, &cn);
    printf("random: overhead small %d\n", cn < 100000 + 100);
    char* c2 = zlib.gunzip(c, cn, &rn);
    printf("random: same %d\n", c2 != null && rn == 100000 && memcmp(c2, rnd, 100000) == 0);

    int en;
    char* e = zlib.gzip("", 0, &en);
    char* e2 = zlib.gunzip(e, en, &rn);
    printf("empty: %d\n", e2 != null && rn == 0);
    char* t = zlib.gzip("a", 1, &en);
    char* t2 = zlib.gunzip(t, en, &rn);
    printf("one byte: %d\n", t2 != null && rn == 1 && t2[0] == 'a');

    // a long run uses the longest matches and overlapping copies
    char* run = malloc(50000);
    memset(run, 'x', 50000);
    char* rc = zlib.gzip(run, 50000, &cn);
    char* rr = zlib.gunzip(rc, cn, &rn);
    printf("run: tiny %d, same %d\n", cn < 1000, rr != null && rn == 50000 && memcmp(rr, run, 50000) == 0);

    // a stream made by another program (dynamic Huffman blocks, file name in the header)
    int ref[1564] = { 31,139,8,8,0,0,0,0,0,3,110,97,109,101,46,116,120,116,0,117,154,77,142,156,55,12,68,247,57,197,28,65,162,126,72,5,240,97,140,100,86,9,96,160,61,54,224,219,199,64,208,42,14,250,113,45,180,248,169,84,34,249,164,126,188,255,245,237,241,247,91,251,243,237,231,215,127,127,188,127,105,111,223,63,190,126,252,248,254,229,241,254,241,248,245,199,227,255,225,254,28,238,207,225,111,255,60,199,236,57,54,95,199,198,115,236,224,180,243,78,187,95,127,187,158,131,182,94,7,247,115,112,108,156,217,239,71,157,215,31,199,115,112,195,39,159,231,96,116,150,226,74,213,91,123,253,121,151,84,6,98,245,171,86,159,147,231,31,18,5,190,189,75,179,3,162,117,169,38,217,62,207,191,165,43,77,112,149,179,160,240,87,187,97,197,247,31,109,13,185,229,202,55,73,62,187,242,205,201,250,155,252,22,176,125,118,229,91,6,223,111,87,190,229,236,28,187,10,110,50,158,93,249,182,131,124,118,229,115,99,207,219,85,208,241,251,229,191,9,242,141,43,223,105,124,84,199,85,240,144,254,67,6,164,209,171,94,161,206,144,253,230,128,223,203,126,221,96,88,222,139,193,243,95,253,6,185,115,92,241,230,160,207,191,226,173,22,156,113,174,126,43,252,117,130,121,197,219,59,96,248,138,231,139,221,57,175,128,49,224,251,231,149,239,24,200,55,151,114,139,244,251,28,96,203,0,48,193,149,175,7,205,127,229,51,47,244,209,233,117,112,255,210,233,117,48,239,234,58,93,156,125,150,233,248,128,192,75,254,163,239,95,87,190,56,236,254,117,21,60,7,142,255,146,122,176,251,75,185,175,23,211,167,244,71,242,28,101,47,176,255,150,249,54,219,103,203,127,65,19,92,245,162,81,81,84,185,29,252,253,123,234,3,225,247,178,159,131,250,91,69,183,113,238,223,42,187,3,244,221,33,123,208,234,174,122,222,56,119,122,83,114,4,247,184,82,31,213,46,79,169,175,152,255,10,104,212,26,184,212,163,228,233,75,219,203,242,251,85,208,113,130,43,95,96,120,245,45,60,251,81,231,0,219,23,77,222,5,245,67,149,183,200,205,161,179,59,33,183,133,82,31,45,46,148,250,138,220,19,178,223,128,229,71,178,31,152,63,228,189,106,126,233,183,72,31,85,222,1,169,245,228,190,143,23