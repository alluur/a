// matrix, stats, optim: bit exact results. Algorithms that use only + - * / and the square root must give exactly the bits of an IEEE 754 double computation on every target (the soft float of A is
// exact, and the library never fuses or reorders operations). The expected output of this test was produced by plain Python floats (hardware doubles) running the same algorithms in the same order
// (tests/algo2_ref/gen_t469.py), so it checks that the soft float arithmetic and the algorithms of the library agree with the hardware to the last bit: compensated summation, the mean and variance,
// the dot product, the Euclidean norm, matrix products, LU with partial pivoting (factors, determinant and solutions), Cholesky, the classical Runge-Kutta method, the trapezoid and Simpson rules
// and polynomial arithmetic. Every number is printed as the unsigned 64 bit pattern of the double.
import cstdio;
import asys;
import matrix;
import stats;
import optim;
import dmath;

int seed = 31415926;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}
double rnd() { return (double) (lcg() % 2001 - 1000) / 64.0; }                  // dyadic: exactly representable, the sums round

void showBits(char* label, double* v, int n) {
    printf("%s:", label);
    for (int i = 0; i < n; i++) { printf(" %u", (uint64) __bits(v[i])); }
    printf("\n");
}

void showBit(char* label, double v) {
    printf("%s: %u\n", label, (uint64) __bits(v));
}

double cubic(double x, void* c) { return x * x * x - 2.0 * x + 1.0; }
void damped(double t, double* y, double* dy, int n, void* c) { dy[0] = y[1]; dy[1] = -y[0] - 0.1 * y[1] + 0.25 * t; }

int main() {
    int base = asys.memInUse();
    // ---- sums and moments of 500 numbers
    double x[500];
    for (int i = 0; i < 500; i++) { x[i] = rnd() * 0.37; }
    showBit("sum", stats.sum(x, 500));
    showBit("mean", stats.mean(x, 500));
    showBit("variance", stats.variance(x, 500, 1));
    showBit("variance ddof 0", stats.variance(x, 500, 0));
    double y[500];
    for (int i = 0; i < 500; i++) { y[i] = rnd() * 0.11; }
    showBit("dot", matrix.vecDot(x, y, 500));
    showBit("norm2", matrix.vecNorm2(x, 500));
    showBit("norm1", matrix.vecNorm1(x, 500));
    showBit("normInf", matrix.vecNormInf(x, 500));
    double cs[40];
    stats.cumsum(x, 40, cs);
    showBits("cumsum (first 40)", cs, 40);

    // ---- a matrix product, 12 x 9 times 9 x 7
    matrix.Matrix a(12, 9);
    matrix.Matrix b(9, 7);
    for (int i = 0; i < 108; i++) { a.d[i] = rnd(); }
    for (int i = 0; i < 63; i++) { b.d[i] = rnd(); }
    matrix.Matrix c = a.mul(&b);
    showBits("product 12 x 7", c.d, 84);
    double v9[9];
    double w12[12];
    for (int i = 0; i < 9; i++) { v9[i] = rnd(); }
    a.mulVec(v9, w12);
    showBits("A v", w12, 12);
    c.dispose();
    a.dispose();
    b.dispose();

    // ---- LU with partial pivoting: 10 x 10 system
    matrix.Matrix m(10, 10);
    for (int i = 0; i < 100; i++) { m.d[i] = rnd(); }
    double rhs[10];
    for (int i = 0; i < 10; i++) { rhs[i] = rnd(); }
    matrix.LU f(&m, 0.0);
    double sol[10];
    f.solve(rhs, sol);
    showBits("LU solve", sol, 10);
    showBit("LU det", f.det());
    showBits("LU factors (row 0 and row 9)", f.lu.d, 10);
    showBits("LU row 9", &f.lu.d[90], 10);
    printf("LU pivots:");
    for (int i = 0; i < 10; i++) { printf(" %d", f.piv[i]); }
    printf("\n");
    double sol2[10];
    f.solveTranspose(rhs, sol2);
    showBits("LU solveTranspose", sol2, 10);
    f.dispose();
    m.dispose();

    // ---- Cholesky of B^T B + 8 I (8 x 8)
    matrix.Matrix bb(8, 8);
    for (int i = 0; i < 64; i++) { bb.d[i] = rnd() / 16.0; }
    matrix.Matrix bt = bb.transpose();
    matrix.Matrix spd = bt.mul(&bb);
    for (int i = 0; i < 8; i++) { spd.d[i * 8 + i] += 8.0; }
    matrix.Cholesky ch(&spd);
    showBits("Cholesky L (row 7)", &ch.l.d[56], 8);
    double r8[8];
    double s8[8];
    for (int i = 0; i < 8; i++) { r8[i] = rnd(); }
    ch.solve(r8, s8);
    showBits("Cholesky solve", s8, 8);
    ch.dispose();
    spd.dispose();
    bt.dispose();
    bb.dispose();

    // ---- Runge-Kutta 4 for a damped, forced oscillator; trapezoid and Simpson rules; polynomials
    double y0[2] = {1.0, 0.0};
    double yo[2];
    optim.rk4(damped, null, 2, 0.0, y0, 8.0, 200, yo, null);
    showBits("rk4 final state", yo, 2);
    optim.Integral tr = optim.trapezoid(cubic, null, 0.0, 3.0, 100);
    optim.Integral si = optim.simpson(cubic, null, 0.0, 3.0, 100);
    showBit("trapezoid", tr.value);
    showBit("simpson", si.value);
    double p[6];
    double q[4];
    for (int i = 0; i < 6; i++) { p[i] = rnd() / 8.0; }
    for (int i = 0; i < 4; i++) { q[i] = rnd() / 8.0; }
    double pq[9];
    optim.polyMul(p, 5, q, 3, pq);
    showBits("polyMul", pq, 9);
    showBit("polyEval at 0.7", optim.polyEval(pq, 8, 0.7));
    double dp[8];
    optim.polyDeriv(pq, 8, dp);
    showBits("polyDeriv", dp, 8);
    double ip[10];
    optim.polyIntegral(pq, 8, ip, 1.5);
    showBits("polyIntegral", ip, 10);
    double qt[6];
    double rm[3];
    optim.polyDivide(pq, 8, q, 3, qt, rm);
    showBits("polyDivide quotient", qt, 6);
    showBits("polyDivide remainder", rm, 3);
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
