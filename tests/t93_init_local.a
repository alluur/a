struct Point { int x; int y; }
struct Line { Point a; Point b; char tag[4]; }
int sum(int* p, int n) { int s = 0; for (int i = 0; i < n; i++) s += p[i]; return s; }
int main() {
    int a[5] = {1, 2, 3};
    printlnInt(sum(a, 5));
    Point p = {7, 8};
    printlnInt(p.x * 10 + p.y);
    Line l = {{1, 2}, {3, 4}, "ab"};
    printlnInt(l.a.x + l.a.y * 10 + l.b.x * 100 + l.b.y * 1000);
    println(l.tag);
    char s[8] = "hello";
    println(s);
    char* names[3] = {"x", "yy", "zzz"};
    println(names[2]);
    Point pts[2] = {{1, 2}, {3, 4},};
    printlnInt(pts[1].y);
    double d[2] = {1.5, 2};
    printlnDouble(d[0] + d[1]);
    bool f[2] = {true};
    printlnInt(f[0] + f[1]);
    return 0;
}
