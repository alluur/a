// gcode.TerminalPane: a gterm terminal in the colours of the theme; text fed without a program, then a real shell command on a
// pseudo terminal with typed input and its exit (Linux and Android only)
import wsrv;
import gui;
import guix;
import gcode;
import gterm;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.TerminalPane* pane;
gui.Window* w;
gcode.Look* look;
int exited = 0;

int onExit(int p) { exited++; return 0; }

// does any row of the terminal contain the text?
bool screenHas(char* needle) {
    for (int r = 0; r < pane->term->rows; r++) {
        char* line = pane->lineText(r);
        int n = strlen(line);
        int m = strlen(needle);
        for (int i = 0; i + m <= n; i++) {
            bool same = true;
            for (int k = 0; k < m; k++) { if (line[i + k] != needle[k]) { same = false; break; } }
            if (same) { return true; }
        }
    }
    return false;
}

void rows(int from, int to) {
    for (int r = from; r <= to; r++) { printf("|%s|\n", pane->lineText(r)); }
}

int main() {
    startServer(7351, "t251");
    w = d->createWindow("Terminal", 640, 360, 0);
    look = gcode.theLook();
    look->setThemeName("dark");
    pane = new gcode.TerminalPane();
    pane->onExit = onExit;
    gui.Box* col = gui.vbox(0, 0);
    col->add(pane);
    w->setRoot(col);
    w->setFocus(pane->term);
    settle();
    printf("the terminal fills the pane: %d x %d cells\n", pane->term->cols > 60, pane->term->rows > 10);

    // text without a program
    pane->feed("Hello from gcode\r\n\x1b[32mgreen\x1b[0m and plain\r\n");
    rows(0, 1);
    settle();
    int bg = look->col(atheme.Col.Background);
    int fg = look->col(atheme.Col.Foreground);
    printf("terminal background is the theme background: %d, foreground: %d\n", gterm.defaultBg == bg, gterm.defaultFg == fg);
    printf("the pixel at the right edge has the background colour: %d\n", w->surf->get(pane->term->absX() + pane->term->w - 20, pane->term->absY() + 100) == bg);
    look->setThemeName("light");
    settle();
    printf("after the theme change: background %d, pixel %d\n", gterm.defaultBg == look->col(atheme.Col.Background), w->surf->get(pane->term->absX() + pane->term->w - 20, pane->term->absY() + 100) == look->col(atheme.Col.Background));
    look->setThemeName("dark");
    settle();

    // typing without a program: the keys are collected
    typeStr("ls");
    key(adp.KEY_ENTER, 13);
    char* sent = pane->term->takeSent();
    printf("typed keys collected: %d bytes, starting with %c%c, ending with a carriage return %d\n", (int) strlen(sent), sent[0], sent[1], sent[strlen(sent) - 1] == 13);

    // a real command on a pseudo terminal
    bool started = pane->start(d, "echo hello-from-the-shell; exit 7");
    printf("a pseudo terminal can be started: %d\n", started);
    if (started) {
        for (int i = 0; i < 200 && !screenHas("hello-from-the-shell"); i++) { d->pump(25); }
        for (int i = 0; i < 200 && exited == 0; i++) { d->pump(25); }
        settle();
        printf("the output arrived: %d, exited %d, status %d\n", screenHas("hello-from-the-shell"), exited, pane->term->exitStatus);

        // input and output: cat echoes what is typed; Ctrl+D ends it
        exited = 0;
        pane->feed("\x1b[2J\x1b[H");
        started = pane->start(d, "cat");
        printf("cat started: %d, running %d\n", started, pane->running());
        w->setFocus(pane->term);
        settle();
        typeStr("ping");
        key(adp.KEY_ENTER, 13);
        for (int i = 0; i < 200 && !screenHas("ping"); i++) { d->pump(25); }
        int count = 0;
        for (int r = 0; r < pane->term->rows; r++) {
            if (strlen(pane->lineText(r)) >= 4 && pane->lineText(r)[0] == 'p') { count++; }
        }
        for (int i = 0; i < 40 && count < 2; i++) {
            d->pump(25);
            count = 0;
            for (int r = 0; r < pane->term->rows; r++) {
                if (strlen(pane->lineText(r)) >= 4 && pane->lineText(r)[0] == 'p') { count++; }
            }
        }
        printf("the typed word is on the screen twice (echo and cat): %d\n", count == 2);
        ctrl('d');
        for (int i = 0; i < 200 && exited == 0; i++) { d->pump(25); }
        printf("Ctrl+D ended cat: exited %d, running %d\n", exited, pane->running());

        // stop a running program
        started = pane->start(d, "sleep 30");
        settle();
        printf("sleep started: %d, running %d\n", started, pane->running());
        pane->stop();
        for (int i = 0; i < 200 && pane->running(); i++) { d->pump(25); }
        printf("stopped: running %d\n", pane->running());
    }

    // pictures in two themes (the same text on every target: the shell part is cleared first)
    pane->feed("\x1b[2J\x1b[H");
    pane->term->showCursor = false;
    pane->feed("$ build\r\n\x1b[31merror:\x1b[0m something \x1b[1;32mworked\x1b[0m\r\n\x1b[44m blue \x1b[0m\r\n");
    settle();
    printf("dark screenshot %u\n", shot(w));
    look->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    look->setThemeName("dark");
    return 0;
}
