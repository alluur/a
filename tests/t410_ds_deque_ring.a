// ds: Deque, RingBuffer and ByteRing checked against plain array models with random operations
import cstdio;
import cstring;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 777;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

int model[3000];
int mn = 0;

void deque() {
    ds.Deque d(2);
    int bad = 0;
    mn = 0;
    for (int op = 0; op < 60000; op++) {
        int what = rnd(100);
        int v = rnd(1000000);
        if (what < 22) {
            d.pushBack(v);
            model[mn] = v; mn++;
        } else if (what < 44) {
            d.pushFront(v);
            for (int i = mn; i > 0; i--) { model[i] = model[i - 1]; }
            model[0] = v; mn++;
        } else if (what < 56) {
            int got = d.popBack();
            int want = (mn > 0) ? model[mn - 1] : 0;
            if (mn > 0) { mn--; }
            if (got != want) { bad++; }
        } else if (what < 68) {
            int got = d.popFront();
            int want = (mn > 0) ? model[0] : 0;
            if (mn > 0) { for (int i = 1; i < mn; i++) { model[i - 1] = model[i]; } mn--; }
            if (got != want) { bad++; }
        } else if (what < 78) {
            int at = rnd(mn + 1);
            bool ok = d.insertAt(at, v);
            for (int i = mn; i > at; i--) { model[i] = model[i - 1]; }
            model[at] = v; mn++;
            if (!ok) { bad++; }
        } else if (what < 88) {
            int at = rnd(mn + 2) - 1;               // -1 and mn are out of range
            int got = d.removeAt(at);
            int want = 0;
            if (at >= 0 && at < mn) {
                want = model[at];
                for (int i = at + 1; i < mn; i++) { model[i - 1] = model[i]; }
                mn--;
            }
            if (got != want) { bad++; }
        } else if (what < 94) {
            if (mn > 0) {
                int at = rnd(mn);
                d.set(at, v);
                model[at] = v;
                if (d.get(at) != v) { bad++; }
            }
        } else {
            if (d.size() != mn || d.isEmpty() != (mn == 0)) { bad++; }
            if (mn > 0 && (d.front() != model[0] || d.back() != model[mn - 1])) { bad++; }
        }
        if (mn > 2500) {                         // keep the model small
            while (mn > 1500) { d.popFront(); for (int i = 1; i < mn; i++) { model[i - 1] = model[i]; } mn--; }
        }
    }
    check(bad == 0, "random operations agree with the array model");
    int out[3000];
    int n = d.copyTo(&out[0]);
    bool same = n == mn;
    for (int i = 0; i < n && same; i++) { if (out[i] != model[i]) { same = false; } }
    check(same, "copyTo gives the model");
    check(d.get(-1) == 0 && d.get(d.size()) == 0 && d.get(100000) == 0, "get out of range gives 0");
    check(!d.insertAt(-1, 5) && !d.insertAt(d.size() + 1, 5), "insertAt out of range is refused");
    int idx = d.indexOf(out[mn / 2]);
    check(idx >= 0 && d.get(idx) == out[mn / 2] && d.has(out[0]), "indexOf / has");
    d.clear();
    check(d.size() == 0 && d.popFront() == 0 && d.popBack() == 0 && d.front() == 0 && d.back() == 0, "clear and pop on an empty deque");
    // wrap around many times with a small size
    ds.Deque w(2);
    int sum = 0;
    for (int i = 0; i < 100000; i++) {
        w.pushBack(i);
        if (w.size() > 5) { sum = sum + w.popFront(); }
    }
    check(sum == (99994 * 99995) / 2 && w.size() == 5 && w.capacity() <= 16, "a queue that wraps around does not grow");
    w.dispose();
    // as a stack
    for (int i = 0; i < 1000; i++) { d.pushFront(i); }
    check(d.front() == 999 && d.size() == 1000 && d.back() == 0, "used as a stack");
    d.dispose();
    check(d.size() == 0 && d.pushBack(4) && d.get(0) == 4, "usable after dispose");
    d.dispose();
    // foreach uses size() and get()
    ds.Deque e(4);
    for (int i = 1; i <= 5; i++) { e.pushBack(i * i); }
    int total = 0;
    foreach (int x in e) { total = total + x; }
    check(total == 55, "foreach over a deque");
    e.dispose();
}

void ring() {
    ds.RingBuffer r(5);
    int win[5];
    int wn = 0;
    int bad = 0;
    for (int i = 1; i <= 1000; i++) {
        r.push(i);
        if (wn < 5) { win[wn] = i; wn++; } else { for (int k = 1; k < 5; k++) { win[k - 1] = win[k]; } win[4] = i; }
        for (int k = 0; k < wn; k++) { if (r.get(k) != win[k] || r.fromNewest(k) != win[wn - 1 - k]) { bad++; } }
        if (r.size() != wn || r.isFull() != (wn == 5)) { bad++; }
    }
    check(bad == 0 && r.overwritten == 995, "overwriting ring keeps the last 5");
    check(r.pop() == 996 && r.peek() == 997 && r.size() == 4 && r.get(4) == 0 && r.get(-1) == 0, "pop, peek, out of range");
    int out[5];
    check(r.copyTo(&out[0]) == 4 && out[0] == 997 && out[3] == 1000, "copyTo");
    r.clear();
    check(r.size() == 0 && r.pop() == 0 && r.peek() == 0, "clear");
    ds.RingBuffer q(3, false);
    check(q.push(1) && q.push(2) && q.push(3) && !q.push(4) && !q.push(5), "refusing ring");
    check(q.rejected == 2 && q.size() == 3 && q.pop() == 1 && q.push(6) && q.get(2) == 6, "refusing ring keeps the old elements");
    ds.RingBuffer z(0);
    check(!z.push(1) && z.size() == 0 && z.pop() == 0, "capacity 0 refuses everything");
    ds.RingBuffer neg(-5);
    check(!neg.push(1) && neg.capacity() == 0, "negative capacity");
    r.dispose(); q.dispose(); z.dispose(); neg.dispose();
    check(r.size() == 0 && !r.push(1), "a disposed ring has no capacity");
}

void byteRing() {
    ds.ByteRing b(8);
    check(b.write("abcdef", 6) == 6 && b.available() == 6 && b.space() == 2, "write");
    check(b.write("ghijk", 5) == 2 && b.dropped == 3, "write refuses what does not fit");
    char out[16];
    check(b.read(&out[0], 4) == 4 && memcmp(&out[0], "abcd", 4) == 0, "read");
    check(b.write("XYZ", 3) == 3 && b.available() == 7 && b.byteAt(0) == 'e' && b.byteAt(6) == 'Z' && b.byteAt(7) == -1, "write wraps around");
    check(b.peek(&out[0], 10) == 7 && memcmp(&out[0], "efghXYZ", 7) == 0 && b.available() == 7, "peek does not remove");
    check(b.skip(2) == 2 && b.read(&out[0], 100) == 5 && memcmp(&out[0], "ghXYZ", 5) == 0 && b.available() == 0, "skip and read all");
    check(b.read(&out[0], 3) == 0 && b.skip(3) == 0 && b.peek(&out[0], 3) == 0, "reading an empty ring");
    ds.ByteRing o(4, true);
    o.write("12", 2);
    o.write("3456", 4);
    check(o.available() == 4 && o.read(&out[0], 4) == 4 && memcmp(&out[0], "3456", 4) == 0 && o.dropped == 2, "overwriting byte ring");
    o.write("abcdefghij", 10);
    check(o.available() == 4 && o.read(&out[0], 4) == 4 && memcmp(&out[0], "ghij", 4) == 0 && o.dropped == 8, "a write bigger than the ring keeps the last bytes");
    // random: a model FIFO
    ds.ByteRing r(37);
    char model[200];
    int mn = 0;
    char data[64];
    int bad = 0;
    int counter = 0;
    for (int op = 0; op < 20000; op++) {
        if (rnd(2) == 0) {
            int n = rnd(30);
            for (int i = 0; i < n; i++) { data[i] = counter; counter++; }
            int took = r.write(&data[0], n);
            int want = (n < 37 - mn) ? n : 37 - mn;
            if (took != want) { bad++; }
            for (int i = 0; i < took; i++) { model[mn + i] = data[i]; }
            mn = mn + took;
        } else {
            int n = rnd(30);
            int got = r.read(&data[0], n);
            int want = (n < mn) ? n : mn;
            if (got != want) { bad++; }
            for (int i = 0; i < got; i++) { if (data[i] != model[i]) { bad++; } }
            for (int i = got; i < mn; i++) { model[i - got] = model[i]; }
            mn = mn - got;
        }
        if (r.available() != mn) { bad++; }
    }
    check(bad == 0, "random reads and writes agree with a FIFO model");
    b.dispose(); o.dispose(); r.dispose();
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.Deque d(1000);
    ds.RingBuffer r(1000);
    ds.ByteRing b(100000);
    for (int i = 0; i < 100000; i++) { d.pushBack(i); r.push(i); }
    check(asys.memBlocks() > b0, "memory is in use");
    d.dispose(); r.dispose(); b.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees everything");
}

int main() {
    deque();
    ring();
    byteRing();
    memory();
    printf("deque and rings: %d checks, %d failures\n", checks, fails);
    return fails;
}
