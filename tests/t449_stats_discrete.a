double worstOf(double got, double want) {
    double err = dmath.fabs(got - want);
    if (want != 0.0) { err = err / dmath.fabs(want); }
    return err;
}

void report(char* name, double worst, int fails, char* tolText) {
    if (PROBE) { printfd("  worst relative error of %s: %.2e\n", name, __bits(worst)); }
    printf("%s: all within %s: %d\n", name, tolText, fails == 0);
}

void show(char* label, double v) {
    print(label);
    if (v != v) { println(" nan"); }
    else if (v > 1.0e308 * 10.0) { println(" inf"); }
    else if (v < -1.0e308 * 10.0) { println(" -inf"); }
    else { printfd(" %.10g\n", __bits(v)); }
}

// NaN, infinity, invalid parameters and the boundaries of the support
void limits() {
    double inf = dmath.INFINITY;
    double nan = dmath.nan();
    show("binomPmf(3, 10, 0.5)", stats.binomPmf(3.0, 10.0, 0.5));
    show("binomPmf(3.5, 10, 0.5)", stats.binomPmf(3.5, 10.0, 0.5));
    show("binomPmf(-1, 10, 0.5)", stats.binomPmf(-1.0, 10.0, 0.5));
    show("binomPmf(11, 10, 0.5)", stats.binomPmf(11.0, 10.0, 0.5));
    show("binomPmf(0, 0, 0.5)", stats.binomPmf(0.0, 0.0, 0.5));
    show("binomPmf(0, 5, 0)", stats.binomPmf(0.0, 5.0, 0.0));
    show("binomPmf(5, 5, 1)", stats.binomPmf(5.0, 5.0, 1.0));
    show("binomPmf(4, 5, 1)", stats.binomPmf(4.0, 5.0, 1.0));
    show("binomPmf(1, 10.5, 0.5)", stats.binomPmf(1.0, 10.5, 0.5));
    show("binomPmf(1, -1, 0.5)", stats.binomPmf(1.0, -1.0, 0.5));
    show("binomPmf(1, 10, 1.5)", stats.binomPmf(1.0, 10.0, 1.5));
    show("binomPmf(1, 10, nan)", stats.binomPmf(1.0, 10.0, nan));
    show("binomPmf(nan, 10, 0.5)", stats.binomPmf(nan, 10.0, 0.5));
    show("binomCdf(-0.5, 10, 0.5)", stats.binomCdf(-0.5, 10.0, 0.5));
    show("binomCdf(10, 10, 0.5)", stats.binomCdf(10.0, 10.0, 0.5));
    show("binomCdf(99, 10, 0.5)", stats.binomCdf(99.0, 10.0, 0.5));
    show("binomCdf(3.9, 10, 0.5) = binomCdf(3)", stats.binomCdf(3.9, 10.0, 0.5) - stats.binomCdf(3.0, 10.0, 0.5));
    show("binomCdf(inf, 10, 0.5)", stats.binomCdf(inf, 10.0, 0.5));
    show("binomCdf(-inf, 10, 0.5)", stats.binomCdf(-inf, 10.0, 0.5));
    show("binomSf(-1, 10, 0.5)", stats.binomSf(-1.0, 10.0, 0.5));
    show("binomSf(10, 10, 0.5)", stats.binomSf(10.0, 10.0, 0.5));
    show("binomQuantile(0, 10, 0.5)", stats.binomQuantile(0.0, 10.0, 0.5));
    show("binomQuantile(1, 10, 0.5)", stats.binomQuantile(1.0, 10.0, 0.5));
    show("binomQuantile(0.5, 10, 0)", stats.binomQuantile(0.5, 10.0, 0.0));
    show("binomQuantile(0.5, 10, 1)", stats.binomQuantile(0.5, 10.0, 1.0));
    show("binomQuantile(1.5, 10, 0.5)", stats.binomQuantile(1.5, 10.0, 0.5));
    show("binomQuantile(0.5, 10, 2)", stats.binomQuantile(0.5, 10.0, 2.0));
    show("poissonPmf(0, 0)", stats.poissonPmf(0.0, 0.0));
    show("poissonPmf(1, 0)", stats.poissonPmf(1.0, 0.0));
    show("poissonPmf(2.5, 3)", stats.poissonPmf(2.5, 3.0));
    show("poissonPmf(-1, 3)", stats.poissonPmf(-1.0, 3.0));
    show("poissonPmf(2, -3)", stats.poissonPmf(2.0, -3.0));
    show("poissonPmf(2, inf)", stats.poissonPmf(2.0, inf));
    show("poissonPmf(2, nan)", stats.poissonPmf(2.0, nan));
    show("poissonCdf(-1, 3)", stats.poissonCdf(-1.0, 3.0));
    show("poissonCdf(5, 0)", stats.poissonCdf(5.0, 0.0));
    show("poissonCdf(inf, 3)", stats.poissonCdf(inf, 3.0));
    show("poissonSf(5, 0)", stats.poissonSf(5.0, 0.0));
    show("poissonSf(-1, 3)", stats.poissonSf(-1.0, 3.0));
    show("poissonQuantile(0, 3)", stats.poissonQuantile(0.0, 3.0));
    show("poissonQuantile(1, 3)", stats.poissonQuantile(1.0, 3.0));
    show("poissonQuantile(0.5, 0)", stats.poissonQuantile(0.5, 0.0));
    show("poissonQuantile(0.5, -1)", stats.poissonQuantile(0.5, -1.0));
    show("poissonQuantile(2, 3)", stats.poissonQuantile(2.0, 3.0));
}

int main() {
    // binomial rows: n, p, k, pmf, cdf, sf
    {
        int rows = sizeof(T_BINOM) / 8 / 6;
        double worst = 0.0;
        int fails = 0;
        for (int r = 0; r < rows; r++) {
            double* t = &T_BINOM[r * 6];
            double e1 = worstOf(stats.binomPmf(t[2], t[0], t[1]), t[3]);
            double e2 = worstOf(stats.binomCdf(t[2], t[0], t[1]), t[4]);
            double e3 = worstOf(stats.binomSf(t[2], t[0], t[1]), t[5]);
            double m = e1;
            if (e2 > m) { m = e2; }
            if (e3 > m) { m = e3; }
            if (!(m <= 1.0e-12)) {
                fails++;
                if (fails <= 3) { printfd("  FAIL binomial row %d: n %g p %g k %g errors %.2e %.2e %.2e\n", r, __bits(t[0]), __bits(t[1]), __bits(t[2]), __bits(e1), __bits(e2), __bits(e3)); }
            }
            if (m > worst) { worst = m; }
        }
        report("binomial pmf, cdf, sf", worst, fails, "1e-12");
    }
    // Poisson rows: lambda, k, pmf, cdf, sf
    {
        int rows = sizeof(T_POISSON) / 8 / 5;
        double worst = 0.0;
        int fails = 0;
        for (int r = 0; r < rows; r++) {
            double* t = &T_POISSON[r * 5];
            double e1 = worstOf(stats.poissonPmf(t[1], t[0]), t[2]);
            double e2 = worstOf(stats.poissonCdf(t[1], t[0]), t[3]);
            double e3 = worstOf(stats.poissonSf(t[1], t[0]), t[4]);
            double m = e1;
            if (e2 > m) { m = e2; }
            if (e3 > m) { m = e3; }
            if (!(m <= 1.0e-12)) {
                fails++;
                if (fails <= 3) { printfd("  FAIL Poisson row %d: lambda %g k %g errors %.2e %.2e %.2e\n", r, __bits(t[0]), __bits(t[1]), __bits(e1), __bits(e2), __bits(e3)); }
            }
            if (m > worst) { worst = m; }
        }
        report("Poisson pmf, cdf, sf", worst, fails, "1e-12");
    }
    // quantiles: exact integers
    {
        int rows = sizeof(Q_BINOM) / 8 / 4;
        int fails = 0;
        for (int r = 0; r < rows; r++) {
            double* t = &Q_BINOM[r * 4];
            double got = stats.binomQuantile(t[2], t[0], t[1]);
            if (got != t[3]) {
                fails++;
                if (fails <= 3) { printfd("  FAIL binomial quantile row %d: n %g p %g q %g got %g want %g\n", r, __bits(t[0]), __bits(t[1]), __bits(t[2]), __bits(got), __bits(t[3])); }
            }
        }
        report("binomial quantile", 0.0, fails, "exactly");
        rows = sizeof(Q_POISSON) / 8 / 3;
        fails = 0;
        for (int r = 0; r < rows; r++) {
            double* t = &Q_POISSON[r * 3];
            double got = stats.poissonQuantile(t[1], t[0]);
            if (got != t[2]) {
                fails++;
                if (fails <= 3) { printfd("  FAIL Poisson quantile row %d: lambda %g q %g got %g want %g\n", r, __bits(t[0]), __bits(t[1]), __bits(got), __bits(t[2])); }
            }
        }
        report("Poisson quantile", 0.0, fails, "exactly");
    }
    // quantile and cdf are consistent: cdf(quantile(q)) >= q > cdf(quantile(q) - 1)
    {
        int bad = 0;
        for (int i = 1; i < 40; i++) {
            double q = (double) i / 40.0;
            double k = stats.binomQuantile(q, 37.0, 0.4);
            if (stats.binomCdf(k, 37.0, 0.4) < q * (1.0 - 1.0e-12)) { bad++; }
            if (k > 0.0 && stats.binomCdf(k - 1.0, 37.0, 0.4) >= q * (1.0 + 1.0e-12)) { bad++; }
            double kp = stats.poissonQuantile(q, 6.5);
            if (stats.poissonCdf(kp, 6.5) < q * (1.0 - 1.0e-12)) { bad++; }
            if (kp > 0.0 && stats.poissonCdf(kp - 1.0, 6.5) >= q * (1.0 + 1.0e-12)) { bad++; }
        }
        printf("cdf(quantile(q)) >= q > cdf(quantile(q) - 1) for 39 levels: %d violations\n", bad);
        // pmf sums to one, cdf and sf add up to one
        double total = 0.0;
        for (int k = 0; k <= 37; k++) { total += stats.binomPmf((double) k, 37.0, 0.4); }
        printf("binomial pmf sums to 1 (1e-13): %d\n", dmath.fabs(total - 1.0) < 1.0e-13);
        total = 0.0;
        for (int k = 0; k <= 80; k++) { total += stats.poissonPmf((double) k, 6.5); }
        printf("Poisson pmf sums to 1 (1e-13): %d\n", dmath.fabs(total - 1.0) < 1.0e-13);
        bad = 0;
        for (int k = 0; k <= 37; k++) {
            if (dmath.fabs(stats.binomCdf((double) k, 37.0, 0.4) + stats.binomSf((double) k, 37.0, 0.4) - 1.0) > 2.0e-15) { bad++; }
            if (dmath.fabs(stats.poissonCdf((double) k, 6.5) + stats.poissonSf((double) k, 6.5) - 1.0) > 2.0e-15) { bad++; }
        }
        printf("cdf + sf = 1: %d violations\n", bad);
    }
    // large parameters stay finite and accurate to the digits that do not depend on cancellation
    {
        double inf = dmath.INFINITY;
        printfd("binomCdf(5e8, 1e9, 0.5) %.6g\n", __bits(stats.binomCdf(5.0e8, 1.0e9, 0.5)));
        printfd("binomPmf(5e8, 1e9, 0.5) * sqrt(pi n / 2) %.9g\n", __bits(stats.binomPmf(5.0e8, 1.0e9, 0.5) * dmath.sqrt(dmath.PI * 1.0e9 / 2.0)));
        printfd("poissonCdf(1e8, 1e8) %.6g\n", __bits(stats.poissonCdf(1.0e8, 1.0e8)));
        printfd("binomQuantile(0.5, 1e9, 0.5) %.10g\n", __bits(stats.binomQuantile(0.5, 1.0e9, 0.5)));
        printfd("poissonQuantile(0.5, 1e6) %.10g\n", __bits(stats.poissonQuantile(0.5, 1.0e6)));
        printfd("binomSf(10, 1e9, 1e-9) is the Poisson(1) tail: %.6g vs %.6g\n", __bits(stats.binomSf(10.0, 1.0e9, 1.0e-9)), __bits(stats.poissonSf(10.0, 1.0)));
    }
    limits();
    return 0;
}
