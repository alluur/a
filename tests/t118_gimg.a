// image decoding: PNG (all kinds), BMP and PPM/PGM made with another program, a round trip through savePng, scaling
import gimg;
import gfx;


char* img0 = "";
char* img1 = "";
char* img2 = "89504e470d0a1a0a0000000d4948445200000018000000140800000000b2dea25f0000001549444154789c6364e0c40e985871805189a12e0100f69009dfbc80f7fc0000000049454e44ae426082";
char* img3 = "89504e470d0a1a0a0000000d49484452000000180000001408040000003dbc35080000001c49444154789c636438c1c94c0a646265200d8e6a18d530aa819e1a0089740aecd81c01700000000049454e44ae426082";
char* img4 = "";
char* img5 = "89504e470d0a1a0a0000000d4948445200000018000000140103000000ad7b6fc000000006504c5445919191373737935902660000003849444154789c6dcbb11540401005c0b95f81fe23a55c09ca100a041ccf8a64269f560451628855cc3cee0c7b0e8b6e4ab7f9d1eabb9738bdd6e010bbc0ef003f0000000049454e44ae426082";
char* img6 = "";
char* img7 = "";
char* img8 = "";
char* img9 = "50360a2320630a3620340a3235350a000b16212c37424d58636e79848f9aa5b0bbc6d1dce7f2fd08131e29343f4a55606b76818c97a2adb8c3ced9e4effa05101b26313c47525d68737e89949faab5c0cbd6e1ecf7020d";
char* img10 = "50350a3520330a3235350a00112233445566778899aabbccddee";

int hexv(int c) {
    if (c >= 'a') { return c - 'a' + 10; }
    return c - '0';
}

// the pixel hash used by the reference program
int pixelHash(gfx.Surface* s) {
    int v = 0;
    for (int y = 0; y < s->h; y++) {
        for (int x = 0; x < s->w; x++) {
            v = (v * 31 + s->get(x, y)) & 0xFFFFFFFF;
        }
    }
    return v;
}

void check(char* name, char* hex, int want) {
    int n = strlen(hex) / 2;
    char* d = malloc(n);
    for (int i = 0; i < n; i++) {
        d[i] = hexv(hex[i * 2]) * 16 + hexv(hex[i * 2 + 1]);
    }
    gfx.Surface* s = gimg.decode(d, n);
    print(name);
    print(": ");
    if (s == null) {
        println("not decoded");
        return;
    }
    printInt(s->w);
    print("x");
    printInt(s->h);
    println(pixelHash(s) == want ? " ok" : " DIFFERENT");
}

int main() {
    check("png rgb", img0, 2154161848);
    check("png rgba", img1, 275113656);
    check("png gray", img2, 910306160);
    check("png gray+alpha", img3, 104999792);
    check("png palette", img4, 608687843);
    check("png 1bit", img5, 2198862608);
    check("png noise", img6, 339787029);
    check("bmp 24", img7, 2154161848);
    check("bmp 8", img8, 608687843);
    check("ppm", img9, 483611788);
    check("pgm", img10, 4009906775);

    // a round trip through savePng
    gfx.Surface* s = new gfx.Surface(70, 50);
    for (int y = 0; y < 50; y++) {
        for (int x = 0; x < 70; x++) {
            s->put(x, y, gfx.argb((x * 3 + y) & 255, (x * 7) & 255, (y * 5) & 255, (x * y) & 255));
        }
    }
    int n = 0;
    char* png = gimg.encodePng(s, &n);
    gfx.Surface* back = gimg.decode(png, n);
    println(back != null && back->w == 70 && back->h == 50 && pixelHash(back) == pixelHash(s) ? "round trip ok" : "round trip FAILED");
    println(gimg.savePng(s, "build/tests/t118.png") ? "saved" : "not saved");
    gfx.Surface* file = gimg.load("build/tests/t118.png");
    println(file != null && pixelHash(file) == pixelHash(s) ? "file ok" : "file FAILED");
    println(gimg.load("no/such/file.png") == null ? "missing file gives null" : "??");

    // scaling keeps a flat colour and the corners
    gfx.Surface* flat = new gfx.Surface(10, 10);
    flat->clear(0xFF336699);
    gfx.Surface* big = gimg.scale(flat, 37, 23);
    printlnInt(big->w * 100 + big->h);
    println(big->get(0, 0) == 0xFF336699 && big->get(36, 22) == 0xFF336699 && big->get(18, 11) == 0xFF336699 ? "flat ok" : "flat FAILED");
    gfx.Surface* f = gimg.fit(s, 35, 100);
    printlnInt(f->w * 1000 + f->h);
    return 0;
}
