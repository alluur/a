// inline assembly: operands in the registers A, B, D; a section for every CPU
int add2(int a, int b) {
    return asm(a, b) {
        x64: 0x48, 0x01, 0xC8;                 // add rax, rcx
        arm64: 0x8B010000;                     // add x0, x0, x1
        riscv64: 0x00B50533;                   // add a0, a0, a1
        loongarch64: 0x00109484;               // add.d a0, a0, a1
    };
}

int mul3(int a, int b, int c) {                 // a * b + c with three operands (A, B, D)
    return asm(a, b, c) {
        x64: 0x48, 0x0F, 0xAF, 0xC1, 0x48, 0x01, 0xD0;      // imul rax, rcx ; add rax, rdx
        arm64: 0x9B017C00, 0x8B020000;                      // mul x0, x0, x1 ; add x0, x0, x2
        riscv64: 0x02B50533, 0x00C50533;                    // mul a0, a0, a1 ; add a0, a0, a2
        loongarch64: 0x001D9484, 0x00109884;                // mul.d a0, a0, a1 ; add.d a0, a0, a2
    };
}

int main() {
    printlnInt(add2(40, 2));
    printlnInt(add2(-5, 3));
    printlnInt(mul3(6, 7, 100));
    int x = asm() { x64: 0x31, 0xC0, 0x48, 0xFF, 0xC0;   // xor eax,eax ; inc rax
                    arm64: 0xD2800020;                   // mov x0, #1
                    riscv64: 0x00100513;                 // li a0, 1
                    loongarch64: 0x02C00404; };          // li.d a0, 1
    printlnInt(x);
    asm() { x64: 0x90; arm64: 0xD503201F; riscv64: 0x00000013; loongarch64: 0x03400000; }     // nop as a statement
    int total = 0;
    for (int i = 1; i <= 100; i++) total = add2(total, i);
    printlnInt(total);
    return 0;
}
