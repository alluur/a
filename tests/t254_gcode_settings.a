// gcode.SettingsDialog: every control changes the shared Look and the open editors at once (tab width, spaces or tabs, line numbers, wrap,
// auto indent, trim, final newline, white space, guides, highlights, caret, completion, font, theme, line gap), the settings object
// follows, the settings file round trip, documents get the new indentation
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.SettingsDialog* sd;
gcode.CodeEditor* e;
gui.Window* w;
gui.Window* ew;
gcode.Look* look;
atheme.Settings* st;
int applied = 0;

int onApply(int d) { applied++; return 0; }

void flags(char* label) {
    printf("%s: tab %d spaces %d numbers %d wrap %d", label, look->tabWidth, look->insertSpaces, look->lineNumbers, look->wordWrap);
    printf(" autoindent %d trim %d finalnl %d", look->autoIndent, look->trimOnSave, look->finalNewline);
    printf(" ws %d guides %d hl %d hlw %d br %d blink %d", look->showWhitespace, look->indentGuides, look->highlightLine, look->highlightWord, look->matchBrackets, look->blink);
    printf(" complete %d font %d gap %d theme %s\n", look->autoComplete, look->fontIndex, look->lineGap, look->theme->name);
}

void clickBox(gui.CheckBox* c) { clickWd(w, c, 10, c->h / 2); }

int main() {
    gcode.theLook()->autoComplete = false;
    rmtree("build/tests/t254_files");
    asys.mkdirs("build/tests/t254_files");
    startServerSized(7354, "t254", 1000, 800);
    look = gcode.theLook();
    look->setThemeName("dark");
    ew = d->createWindow("Editor", 500, 240, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    ew->setRoot(col);
    ew->setFocus(e);
    e->setText("int main() {\n    if (x) {\n        return 1;\n    }\n}\n");
    e->doc->setLanguage(asyntax.Lang.A);
    gcode.Doc* second = new gcode.Doc();
    second->setText("second document\n");
    settle();

    st = new atheme.Settings();
    sd = new gcode.SettingsDialog(st);
    sd->onApply = onApply;
    w = sd->show(d);
    settle();
    flags("defaults");
    printf("the controls show the Look: tab %d, spaces %d, numbers %d, font %s, theme %s, gap %d\n", sd->tabSpin->value, sd->cbSpaces->checked, sd->cbNumbers->checked, sd->fontCombo->text(), sd->themeCombo->text(), sd->gapSpin->value);

    // check boxes
    clickBox(sd->cbWrap);
    flags("wrap on");
    printf("the open editor wraps: %d, applied %d, settings.wordWrap %d\n", e->wordWrap, applied, st->wordWrap);
    clickBox(sd->cbNumbers);
    printf("line numbers off: editor %d, gutter %d\n", e->lineNumbers, e->gutterWidth());
    clickBox(sd->cbNumbers);
    clickBox(sd->cbWrap);
    clickBox(sd->cbSpaces);
    flags("tabs instead of spaces");
    printf("the document uses tabs now: first doc %d, second doc %d\n", e->ed->useTabs, second->ed->useTabs);
    clickBox(sd->cbSpaces);
    clickBox(sd->cbAutoIndent);
    clickBox(sd->cbTrim);
    clickBox(sd->cbFinalNl);
    flags("autoindent off, trim and final newline on");
    clickBox(sd->cbAutoIndent);
    clickBox(sd->cbWhitespace);
    clickBox(sd->cbGuides);
    clickBox(sd->cbHlLine);
    clickBox(sd->cbHlWord);
    clickBox(sd->cbBrackets);
    clickBox(sd->cbBlink);
    clickBox(sd->cbComplete);
    flags("the display options flipped");
    printf("the editor took them: ws %d guides %d hl %d hlw %d br %d blink %d complete %d\n", e->showWhitespace, e->indentGuides, e->highlightLine, e->highlightWord, e->matchBrackets, e->blink, e->autoComplete);
    clickBox(sd->cbWhitespace);
    clickBox(sd->cbGuides);
    clickBox(sd->cbHlLine);
    clickBox(sd->cbHlWord);
    clickBox(sd->cbBrackets);
    clickBox(sd->cbBlink);
    clickBox(sd->cbComplete);

    // the spin box and the combo boxes
    sd->tabSpin->setValue(8);
    flags("tab width 8");
    printf("editors: tab width %d, indent width %d\n", e->ed->tabWidth, e->ed->indentWidth);
    sd->gapSpin->setValue(2);
    printf("line gap 2: line height %d\n", e->lineHeight());
    sd->gapSpin->setValue(0);
    sd->fontCombo->select(1);
    printf("font Sans: cell %d wide, font index %d, settings.font %s\n", e->cellWidth(), look->fontIndex, st->font);
    sd->fontCombo->select(0);
    printf("font Mono: cell %d wide\n", e->cellWidth());
    sd->themeCombo->select(1);
    settle();
    printf("theme %s: look %s, editor background %d, settings.theme %s\n", sd->themeCombo->text(), look->theme->name, ew->surf->get(e->absX() + e->w - 40, e->absY() + e->h - 40) == look->col(atheme.Col.Background), st->theme);
    sd->themeCombo->select(0);

    // trimming and the final newline happen when the document is saved
    sd->cbTrim->setChecked(true);
    sd->cbFinalNl->setChecked(true);
    e->setText("a   \nb\t\nc");
    printf("saving: %d, ", e->doc->save("build/tests/t254_files/out.txt"));
    char* t = e->getText();
    int n = 0;
    char* disk = asys.readFile("build/tests/t254_files/out.txt", &n, 1000, null);
    printf("the file has [%s] (%d bytes), the editor shows the same %d\n", disk, n, streq(t, disk));
    asys.free(t);
    asys.free(disk);
    sd->cbTrim->setChecked(false);
    sd->cbFinalNl->setChecked(false);

    // the settings object follows the Look: write it, read it back
    sd->tabSpin->setValue(3);
    sd->cbWrap->setChecked(true);
    sd->fontCombo->select(2);
    char* ini = st->toIni();
    atheme.Settings back();
    back.parse(ini, strlen(ini));
    asys.free(ini);
    printf("settings file: tab %d, wrap %d, font %s, theme %s, spaces %d\n", back.tabWidth, back.wordWrap, back.font, back.theme, back.insertSpaces);
    sd->cbWrap->setChecked(false);
    sd->fontCombo->select(0);
    sd->tabSpin->setValue(4);

    // something else changes the Look: reload() makes the controls show it
    look->tabWidth = 6;
    look->wordWrap = true;
    look->changed();
    sd->reload();
    settle();
    printf("after reload: spin %d, wrap box %d\n", sd->tabSpin->value, sd->cbWrap->checked);
    look->tabWidth = 4;
    look->wordWrap = false;
    look->changed();
    sd->reload();

    // applying the same settings to a new Look (the program starts with its settings file)
    atheme.Settings loaded();
    loaded.tabWidth = 2;
    loaded.insertSpaces = false;
    loaded.lineNumbers = false;
    loaded.font = asys.strDup("sans");
    loaded.theme = asys.strDup("nord");
    look->applySettings(&loaded);
    settle();
    flags("applySettings");
    printf("the open editor: no line numbers %d, narrow cell %d, nord background %d\n", !e->lineNumbers, e->cellWidth() > 8, ew->surf->get(e->absX() + e->w - 40, e->absY() + e->h - 40) == look->col(atheme.Col.Background));
    look->tabWidth = 4;
    look->insertSpaces = true;
    look->lineNumbers = true;
    look->setFontIndex(0);
    look->setThemeName("dark");
    look->changed();
    gcode.applyPrefsToDocs();
    settle();

    // pictures of the dialog in two themes
    sd->reload();
    settle();
    int shotDark = shot(w);
    printf("dark screenshot %u\n", shotDark);
    look->setThemeName("light");
    settle();
    printf("light theme: the dialog uses the standard look, so the picture is the same: %d\n", shot(w) == shotDark);
    look->setThemeName("dark");
    sd->close();
    printf("closed: %d\n", w->closed);
    return 0;
}
