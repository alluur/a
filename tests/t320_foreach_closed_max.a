// foreach over closed ranges a..=b whose upper (or lower, with rev) end is the largest or smallest int: nothing wraps, break/continue/nesting still work
import cstdio;
int main() {
    int n = 0;
    foreach (int i in 9223372036854775805..=9223372036854775807) { n++; printf("%d ", i); }
    printf("\n%d\n", n);
    n = 0;
    foreach (int i in rev 9223372036854775805..=9223372036854775807) { n++; printf("%d ", i); }
    printf("\n%d\n", n);
    foreach (int i in rev -9223372036854775807-1..=-9223372036854775807+1) { printf("%d ", i); }
    printf("\n");
    foreach (int i in -9223372036854775807-1..=-9223372036854775807+1) { printf("%d ", i); }
    printf("\n");
    foreach (int i in 3..=2) { printf("never %d\n", i); }
    foreach (int i in rev 3..=2) { printf("never %d\n", i); }
    foreach (int i in 3..=3) { printf("one %d\n", i); }
    foreach (int i in rev 3..=3) { printf("one %d\n", i); }
    foreach (int i in 1..=6) { if (i == 2) continue; if (i == 5) break; printf("%d ", i); }
    printf("\n");
    foreach (int i in rev 1..=6) { if (i == 5) continue; if (i == 2) break; printf("%d ", i); }
    printf("\n");
    foreach (int i in 1..=4) { foreach (int j in rev i..=3) { printf("%d%d ", i, j); } }
    printf("\n");
    return 0;
}
