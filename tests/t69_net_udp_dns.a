import net;

int main() {
    // UDP on the loopback interface, one process: datagrams wait in the socket buffer
    int a = net.udpBind(0);
    int b = net.udpBind(0);
    if (a < 0 || b < 0) { println("bind failed"); return 1; }
    int pa = net.localPort(a);
    printlnInt(pa > 0);
    net.setTimeout(b, 500);
    char msg[16];
    strcpy(msg, "ping");
    printlnInt(net.sendTo(b, net.parseIp("127.0.0.1"), pa, msg, 4));
    char buf[64];
    int ip; int port;
    int n = net.recvFrom(a, buf, 63, &ip, &port);
    buf[n] = 0;
    println(buf);
    printlnInt(ip == 0x7F000001);
    printlnInt(port == net.localPort(b));
    // answering the sender
    net.sendTo(a, ip, port, "pong", 4);
    n = net.recvFrom(b, buf, 63, null, null);
    buf[n] = 0;
    println(buf);
    // a receive that times out
    net.setTimeout(a, 100);
    printlnInt(net.recvFrom(a, buf, 63, null, null));
    net.close(a);
    net.close(b);

    // DNS packets
    char q[600];
    int len = net.dnsBuildQuery("www.example.org", 0x1234, q);
    printlnInt(len);                              // 12 + 1+3 + 1+7 + 1+3 + 1 + 4
    printlnInt(q[0] * 256 + q[1]);
    printlnInt(q[12]);
    printlnInt(net.dnsBuildQuery("bad..name", 1, q));
    // a reply: the question again and one answer with a compressed name (a pointer to offset 12)
    net.dnsBuildQuery("www.example.org", 0x1234, q);
    q[2] = 0x81; q[3] = 0x80; q[7] = 1;
    int p = len;
    q[p] = 0xC0; q[p+1] = 12; q[p+2] = 0; q[p+3] = 1; q[p+4] = 0; q[p+5] = 1;
    q[p+6] = 0; q[p+7] = 0; q[p+8] = 1; q[p+9] = 0; q[p+10] = 0; q[p+11] = 4;
    q[p+12] = 93; q[p+13] = 184; q[p+14] = 216; q[p+15] = 34;
    int ipr = net.dnsParseReply(q, p + 16, 0x1234);
    printlnInt(ipr == (93 << 24 | 184 << 16 | 216 << 8 | 34));
    printlnInt(net.dnsParseReply(q, p + 16, 0x1235));      // wrong id
    // names that need no network
    printlnInt(net.resolve("127.0.0.1") == 0x7F000001);
    printlnInt(net.resolve("localhost") == 0x7F000001);
    return 0;
}
