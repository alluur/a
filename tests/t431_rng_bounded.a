// rng: bounded integers without modulo bias (Lemire), doubles with 53 bits, booleans and bytes: scripted generators for the exact edge cases,
// statistical checks with fixed seeds for the rest (so the result never changes from run to run)
import cstdio;
import cstring;
import asys;
import rng;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

// a generator that returns the given words in turn (and counts them)
class Script : rng.Rng {
    public uint64* vals;
    public int n;
    public int used;

    public Script(uint64* v, int count) {
        vals = v;
        n = count;
    }

    public uint64 nextU64() {
        uint64 r = vals[used % n];
        used++;
        return r;
    }
}

// chi-square statistic of observed counts against the same expectation for every cell
double chiSquare(int* counts, int cells, int total) {
    double expected = (double) total / (double) cells;
    double s = 0.0;
    for (int i = 0; i < cells; i++) {
        double d = (double) counts[i] - expected;
        s = s + d * d / expected;
    }
    return s;
}

void doubles() {
    uint64 w[4];
    w[0] = 0;
    w[1] = 0xFFFFFFFFFFFFFFFF;
    w[2] = 0x8000000000000000;
    w[3] = 0x00000000000007FF;                 // the 11 low bits are discarded
    Script s(&w[0], 4);
    double a = s.nextDouble();
    double b = s.nextDouble();
    double c = s.nextDouble();
    double d = s.nextDouble();
    check(a == 0.0, "raw 0 gives 0.0");
    check(b < 1.0 && b == 1.0 - 1.1102230246251565e-16 && (int) (b * 9007199254740992.0) == 9007199254740991, "raw all ones gives 1 - 2^-53, never 1.0");
    check(c == 0.5, "raw 2^63 gives 0.5");
    check(d == 0.0, "the low 11 bits are ignored");
    s.used = 0;
    double o0 = s.nextDoubleOpen();
    double o1 = s.nextDoubleOpen();
    check(o0 == 1.1102230246251565e-16 && o1 == 1.0, "nextDoubleOpen: raw 0 gives 2^-53, raw all ones gives 1.0, never 0");
    // every double is a multiple of 2^-53: x * 2^53 is an integer
    rng.Xoshiro256 g(2024);
    bool exact = true;
    double sum = 0.0;
    double sum2 = 0.0;
    int n = 20000;
    for (int i = 0; i < n; i++) {
        double x = g.nextDouble();
        if (x < 0.0 || x >= 1.0) { exact = false; }
        double scaled = x * 9007199254740992.0;
        if (scaled != dmathFloor(scaled)) { exact = false; }
        sum = sum + x;
        sum2 = sum2 + x * x;
    }
    check(exact, "20000 doubles are in [0, 1) and multiples of 2^-53");
    double mean = sum / (double) n;
    double var = sum2 / (double) n - mean * mean;
    check(mean > 0.49 && mean < 0.51 && var > 0.0815 && var < 0.0852, "mean about 0.5, variance about 1/12");
    // ten equal bins
    int bins[10];
    rng.Xoshiro256 h(7);
    for (int i = 0; i < 50000; i++) { bins[(int) (h.nextDouble() * 10.0)]++; }
    check(chiSquare(&bins[0], 10, 50000) < 30.0, "ten bins are filled evenly (chi-square, 9 degrees of freedom)");
    double u = h.uniform(5.0, 7.0);
    check(u >= 5.0 && u < 7.0, "uniform(a, b)");
    check(h.uniform(3.0, 3.0) == 3.0, "uniform(a, a)");
}

double dmathFloor(double x) {
    // x is non-negative and below 2^53: truncate through int
    return (double) (int) x;
}

void booleans() {
    uint64 w[2];
    w[0] = 0x8000000000000000;
    w[1] = 0x7FFFFFFFFFFFFFFF;
    Script s(&w[0], 2);
    check(s.nextBool() && !s.nextBool(), "nextBool is the top bit");
    check(s.bernoulli(0.0) == false && s.bernoulli(1.0) == true && s.bernoulli(-3.0) == false && s.bernoulli(7.0) == true, "bernoulli(0), (1) and out of range");
    s.used = 0;
    check(s.used == 0 && s.bernoulli(0.0) == false && s.used == 0 && s.bernoulli(1.0) && s.used == 0, "bernoulli(0) and (1) consume nothing");
    rng.Xoshiro256 g(55);
    int ones = 0;
    int quarter = 0;
    for (int i = 0; i < 20000; i++) {
        if (g.nextBool()) { ones++; }
        if (g.bernoulli(0.25)) { quarter++; }
    }
    check(ones > 9600 && ones < 10400, "nextBool: about half true");
    check(quarter > 4700 && quarter < 5300, "bernoulli(0.25): about a quarter");
}

void bounded() {
    uint64 w[3];
    w[0] = 0xFFFFFFFFFFFFFFFF;
    w[1] = 0x8000000000000001;
    w[2] = 1;
    Script s(&w[0], 3);
    check(s.below(10) == 9, "below(10) of all ones is 9");
    check(s.below(10) == 5, "below(10) of 2^63 + 1 is 5 (2^63 itself has the low part 0 and would be rejected)");
    check(s.below(10) == 0 && s.used == 3, "below(10) of 1 is 0 (the word 0 itself would be rejected: its low part 0 is below the threshold 6)");
    check(s.below(1) == 0 && s.below(0) == 0 && s.below(-4) == 0 && s.used == 3, "below(n <= 1) is 0 and consumes nothing");
    check(s.belowU64(0) == 0 && s.belowU64(1) == 0 && s.used == 3, "belowU64(0) and (1)");
    // the rejection loop: n = 3: the word 0 gives low part 0 < threshold 1, so it is thrown away
    uint64 r3[2];
    r3[0] = 0;
    r3[1] = 5;
    Script t(&r3[0], 2);
    check(t.below(3) == 0 && t.used == 2, "n = 3: the word 0 is rejected (2 words used)");
    // n = 6: 2^63 times 6 is 3 * 2^64: low part 0, rejected; 2^62 times 6 has low part 2^63: accepted, result 1
    uint64 r6[2];
    r6[0] = 0x8000000000000000;
    r6[1] = 0x4000000000000000;
    Script u(&r6[0], 2);
    check(u.below(6) == 1 && u.used == 2, "n = 6: 2^63 rejected, 2^62 gives 1");
    // two rejections in a row, then success
    uint64 rr[3];
    rr[0] = 0;
    rr[1] = 0x8000000000000000;
    rr[2] = 0xC000000000000000;
    Script v(&rr[0], 3);
    check(v.below(6) == 4 && v.used == 3, "n = 6: two rejections, then 3 * 2^62 gives 4");
    // a power of two never rejects: n = 8 uses the top 3 bits
    uint64 p8[2];
    p8[0] = 0xE000000000000000;
    p8[1] = 0x2000000000000000;
    Script x(&p8[0], 2);
    check(x.below(8) == 7 && x.below(8) == 1 && x.used == 2, "n = 8: the top three bits");
    // no modulo bias: n = 3 * 2^62: a remainder based method would put 1/2 of the results below 2^62, the right answer is 1/3
    rng.Xoshiro256 g(31415);
    int low = 0;
    int draws = 30000;
    for (int i = 0; i < draws; i++) {
        uint64 r = g.belowU64(0xC000000000000000);
        if (r < 0x4000000000000000) { low++; }
    }
    check(low > 9600 && low < 10400, "no modulo bias: 1/3 of the draws below a third of the range (30000 draws)");
    // uniformity of below(7)
    int counts[7];
    for (int i = 0; i < 70000; i++) { counts[g.below(7)]++; }
    check(chiSquare(&counts[0], 7, 70000) < 30.0, "below(7): chi-square, 6 degrees of freedom");
    // below(n) is always in range, also for huge n
    bool inRange = true;
    for (int i = 0; i < 20000; i++) {
        int n = 1 + g.below(1000000007);
        int r = g.below(n);
        if (r < 0 || r >= n) { inRange = false; }
        uint64 big = g.belowU64(0xFFFFFFFFFFFFFFF1);
        if (big >= 0xFFFFFFFFFFFFFFF1) { inRange = false; }
    }
    check(inRange, "results are always below n (also near 2^64)");
}

void uniformInts() {
    rng.Xoshiro256 g(2718);
    int counts[7];
    bool inRange = true;
    for (int i = 0; i < 70000; i++) {
        int v = g.uniformInt(-3, 3);
        if (v < -3 || v > 3) { inRange = false; } else { counts[v + 3]++; }
    }
    check(inRange && chiSquare(&counts[0], 7, 70000) < 30.0, "uniformInt(-3, 3): in range and even");
    check(g.uniformInt(-5, -5) == -5 && g.uniformInt(0, 0) == 0, "a range with one value");
    bool swapped = true;
    for (int i = 0; i < 200; i++) { int v = g.uniformInt(10, 4); if (v < 4 || v > 10) { swapped = false; } }
    check(swapped, "lo > hi: the bounds are swapped");
    // the extremes
    int imin = -9223372036854775807 - 1;
    int imax = 9223372036854775807;
    bool ext = true;
    bool sawNeg = false;
    bool sawPos = false;
    for (int i = 0; i < 200; i++) {
        int v = g.uniformInt(imin, imax);                       // the full range: 2^64 values
        if (v < 0) { sawNeg = true; } else { sawPos = true; }
        int w = g.uniformInt(imin, imin + 1);
        if (w != imin && w != imin + 1) { ext = false; }
        int z = g.uniformInt(imax - 1, imax);
        if (z != imax - 1 && z != imax) { ext = false; }
        int y = g.uniformInt(-1, imax);
        if (y < -1) { ext = false; }
    }
    check(ext && sawNeg && sawPos, "uniformInt at the ends of the int range");
    // nextInt is never negative
    bool nonNeg = true;
    for (int i = 0; i < 5000; i++) { if (g.nextInt() < 0) { nonNeg = false; } }
    check(nonNeg, "nextInt >= 0");
    // nextU32 is the upper half
    uint64 w[1];
    w[0] = 0xABCDEF0123456789;
    Script s(&w[0], 1);
    check(s.nextU32() == 0xABCDEF01, "nextU32 is the upper half of nextU64");
    // fillBytes: about half of the bits are set
    char buf[4000];
    g.fillBytes(&buf[0], 4000);
    int bitsSet = 0;
    for (int i = 0; i < 4000; i++) { int b = buf[i]; for (int k = 0; k < 8; k++) { if (((b >> k) & 1) != 0) { bitsSet++; } } }
    check(bitsSet > 15600 && bitsSet < 16400, "fillBytes: 32000 bits, about half set");
}

int main() {
    doubles();
    booleans();
    bounded();
    uniformInts();
    check(asys.memBadFrees() == 0, "no bad free");
    printf("bounded: %d checks, %d failures\n", checks, fails);
    return fails;
}
