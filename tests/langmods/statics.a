module statics;

// a class with static members that lives in a module: used as statics.Reg.name from outside

public enum Level { Low, Mid, High }

public class Reg {
public:
    static int counter;
    static int limit = 10;
    static int table[3];
    static char* label = "reg";
    int id;
    static int bump() { counter++; return counter; }
    static int add(int n) { counter += n; return counter; }
    Reg() { id = bump(); }
}

public class Sub : Reg {
public:
    static int extra = 7;
    static int both() { return counter + extra; }
}
