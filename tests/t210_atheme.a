// atheme: colour conversions, contrast, built-in themes and their validation, theme files (round trips and corrupt input),
// settings (defaults, clamping, round trips, recents, key bindings, corrupt input)
import atheme;
import asyntax;
import asys;

int checks;
int fails;

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

void checkEq(int got, int want, char* what) {
    checks++;
    if (got != want) {
        fails++;
        printf("FAIL: %s: got %d want %d\n", what, got, want);
    }
}

void checkNear(int got, int want, int tol, char* what) {
    checks++;
    int d = got - want;
    if (d < 0) { d = -d; }
    if (d > tol) {
        fails++;
        printf("FAIL: %s: got %d want %d (+-%d)\n", what, got, want, tol);
    }
}

void checkStr(char* got, char* want, char* what) {
    checks++;
    if (got == null || !streq(got, want)) {
        fails++;
        printf("FAIL: %s: got '%s' want '%s'\n", what, got == null ? "(null)" : got, want);
    }
}

int pc(char* s) {
    int c = -1;
    if (!atheme.parseColor(s, &c)) { return -1; }
    return c;
}

int seed = 31337;
int rnd(int n) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return ((seed >> 8) & 0xFFFFFF) % n;
}

bool sameTheme(atheme.Theme* a, atheme.Theme* b) {
    for (int i = 0; i < atheme.Col.count; i++) {
        if (a->color(i) != b->color(i)) { return false; }
    }
    for (int i = 0; i < asyntax.Tok.count; i++) {
        if (a->tokenColor(i) != b->tokenColor(i) || a->tokenStyle(i) != b->tokenStyle(i)) { return false; }
    }
    return true;
}

int main() {
    // ---- parsing and formatting colours
    checkEq(pc("#ffffff"), 0xFFFFFF, "#ffffff");
    checkEq(pc("#fff"), 0xFFFFFF, "#fff");
    checkEq(pc("#0a5"), 0x00AA55, "#0a5 doubles every digit");
    checkEq(pc("ABCDEF"), 0xABCDEF, "no #, upper case");
    checkEq(pc("0xAbCdEf"), 0xABCDEF, "0x prefix");
    checkEq(pc("  #00ff00  "), 0x00FF00, "spaces around");
    checkEq(pc("red"), 0xFF0000, "a name");
    checkEq(pc("Gray"), 0x808080, "names ignore case");
    checkEq(pc("#abcd"), -1, "four digits");
    checkEq(pc("#gggggg"), -1, "not hex");
    checkEq(pc("zzz"), -1, "not a colour");
    checkEq(pc(""), -1, "empty");
    checkEq(pc("#1234567"), -1, "seven digits");
    checkEq(pc("123456789012345678901234567890"), -1, "too long");
    check(!atheme.parseColor(null, null), "null is not a colour");
    int keep = 77;
    atheme.parseColor("nonsense", &keep);
    checkEq(keep, 77, "a failed parse leaves the value alone");
    char hex[12];
    atheme.formatColor(0x0A5FF0, &hex[0]);
    checkStr(&hex[0], "#0a5ff0", "formatColor");
    atheme.formatColor(0, &hex[0]);
    checkStr(&hex[0], "#000000", "formatColor of black");
    bool rt = true;
    for (int i = 0; i < 200; i++) {
        int c = (rnd(256) << 16) | (rnd(256) << 8) | rnd(256);
        atheme.formatColor(c, &hex[0]);
        if (pc(&hex[0]) != c) { rt = false; }
    }
    check(rt, "format and parse round trip");
    checkEq(atheme.rgb(1, 2, 3), 0x010203, "rgb");
    checkEq(atheme.rgb(300, -5, 7), 0xFF0007, "rgb clamps");
    checkEq(atheme.red(0x123456), 0x12, "red");
    checkEq(atheme.green(0x123456), 0x34, "green");
    checkEq(atheme.blue(0x123456), 0x56, "blue");

    // ---- mixing
    checkEq(atheme.lighten(0x000000, 50), 0x808080, "lighten black by half");
    checkEq(atheme.darken(0xFFFFFF, 50), 0x808080, "darken white by half");
    checkEq(atheme.lighten(0x123456, 0), 0x123456, "lighten by 0");
    checkEq(atheme.lighten(0x123456, 100), 0xFFFFFF, "lighten by 100");
    checkEq(atheme.darken(0x123456, 100), 0x000000, "darken by 100");
    checkEq(atheme.mix(0xFF0000, 0x0000FF, 25), 0xBF0040, "mix a quarter of the way");
    checkEq(atheme.mix(0x102030, 0x405060, 0), 0x102030, "mix 0 gives the first colour");
    checkEq(atheme.mix(0x102030, 0x405060, 100), 0x405060, "mix 100 gives the second");
    checkEq(atheme.mix(0x102030, 0x405060, 500), 0x405060, "percentages are clamped");

    // ---- the terminal palettes
    checkEq(atheme.from256(16), 0x000000, "palette 16");
    checkEq(atheme.from256(21), 0x0000FF, "palette 21");
    checkEq(atheme.from256(196), 0xFF0000, "palette 196");
    checkEq(atheme.from256(231), 0xFFFFFF, "palette 231");
    checkEq(atheme.from256(232), 0x080808, "palette 232");
    checkEq(atheme.from256(255), 0xEEEEEE, "palette 255");
    checkEq(atheme.from256(67), 0x5F87AF, "palette 67");
    checkEq(atheme.from256(9), 0xFF0000, "palette 9 is ANSI bright red");
    checkEq(atheme.from256(300), 0xEEEEEE, "out of range is clamped");
    checkEq(atheme.to256(0xFF0000), 196, "red");
    checkEq(atheme.to256(0x00FF00), 46, "green");
    checkEq(atheme.to256(0x0000FF), 21, "blue");
    checkEq(atheme.to256(0xFFFFFF), 231, "white");
    checkEq(atheme.to256(0x000000), 16, "black");
    checkEq(atheme.to256(0x808080), 244, "mid gray goes to the gray ramp");
    checkEq(atheme.to256(0x5F87AF), 67, "an exact cube colour");
    bool near256 = true;
    for (int i = 16; i < 256; i++) {
        if (atheme.to256(atheme.from256(i)) != i) {
            // equal colours may have several indices only inside the gray / cube overlap: the colour must match
            if (atheme.from256(atheme.to256(atheme.from256(i))) != atheme.from256(i)) { near256 = false; }
        }
    }
    check(near256, "every palette colour maps back to itself (or an equal colour)");
    checkEq(atheme.to16(0xFF0000), 9, "ANSI red");
    checkEq(atheme.to16(0x000000), 0, "ANSI black");
    checkEq(atheme.to16(0xFFFFFF), 15, "ANSI white");
    checkEq(atheme.to16(0xCD0000), 1, "ANSI dark red");
    checkEq(atheme.to16(0x7F7F7F), 8, "ANSI dark gray");
    checkEq(atheme.to16(0x00FFFF), 14, "ANSI cyan");
    checkEq(atheme.from16(12), 0x5C5CFF, "from16");
    bool ansi = true;
    for (int i = 0; i < 16; i++) { if (atheme.to16(atheme.from16(i)) != i) { ansi = false; } }
    check(ansi, "the 16 ANSI colours map to themselves");

    // ---- luminance and contrast (WCAG)
    checkEq(atheme.luminance(0xFFFFFF), 1000000, "luminance of white");
    checkEq(atheme.luminance(0x000000), 0, "luminance of black");
    checkNear(atheme.luminance(0x808080), 215861, 2, "luminance of gray 128");
    checkNear(atheme.luminance(0xFF0000), 212600, 2, "luminance of red");
    checkEq(atheme.contrast(0xFFFFFF, 0x000000), 2100, "white on black is 21:1");
    checkEq(atheme.contrast(0x000000, 0xFFFFFF), 2100, "the ratio is symmetric");
    checkEq(atheme.contrast(0x123456, 0x123456), 100, "equal colours 1:1");
    checkNear(atheme.contrast(0x777777, 0xFFFFFF), 448, 1, "#777 on white is 4.48:1");
    checkNear(atheme.contrast(0x767676, 0xFFFFFF), 454, 1, "#767676 on white is 4.54:1");
    checkNear(atheme.contrast(0xFF0000, 0xFFFFFF), 400, 1, "red on white is 4.0:1");
    checkNear(atheme.contrast(0x0000FF, 0x000000), 244, 1, "blue on black is 2.44:1");
    check(atheme.readable(0x000000, 0xFFFFFF, 450), "black is readable on white");
    check(!atheme.readable(0x777777, 0xFFFFFF, 450), "#777 on white fails AA");
    check(atheme.readable(0x767676, 0xFFFFFF, 450), "#767676 on white passes AA");

    // ---- built-in themes
    char* names = atheme.builtinNames();
    int count = 0;
    int bgs[16];
    bool allOk = true;
    char* nm = asys.strDup(names);
    int nmLen = strlen(nm);
    int start = 0;
    for (int i = 0; i <= nmLen; i++) {
        if (nm[i] == ' ' || nm[i] == 0) {
            nm[i] = 0;
            atheme.Theme* t = atheme.builtin(&nm[start]);
            if (t == null || !streq(t->name, &nm[start])) { allOk = false; }
            else {
                bgs[count] = t->color(atheme.Col.Background);
                atheme.Warnings w();
                int n = t->validate(&w);
                if (n != 0) { allOk = false; printf("%s: %d contrast warnings, first: %s\n", &nm[start], n, w.items[0]); }
                w.dispose();
            }
            count++;
            start = i + 1;
        }
    }
    check(allOk && count == 9, "nine built-in themes, all constructible and without contrast warnings");
    bool distinct = true;
    for (int i = 0; i < count; i++) {
        for (int j = i + 1; j < count; j++) { if (bgs[i] == bgs[j]) { distinct = false; } }
    }
    check(distinct, "the nine themes have nine different backgrounds");
    check(atheme.builtin("nope") == null && atheme.builtin("") == null, "unknown names give null");
    atheme.Theme* up = atheme.builtin("DARK");
    check(up != null && streq(up->name, "dark"), "names ignore case");
    atheme.Theme* dark = atheme.builtin("dark");
    atheme.Theme* light = atheme.builtin("light");
    check(dark->color(atheme.Col.Background) < light->color(atheme.Col.Background), "dark is darker than light");
    check(atheme.luminance(dark->color(atheme.Col.Background)) < 100000 && atheme.luminance(light->color(atheme.Col.Background)) > 800000, "luminance of the two backgrounds");
    check(dark->tokenStyle(asyntax.Tok.Comment) == atheme.STYLE_ITALIC && dark->tokenStyle(asyntax.Tok.Heading) == atheme.STYLE_BOLD && dark->tokenStyle(asyntax.Tok.Link) == atheme.STYLE_UNDERLINE, "token styles");
    check(dark->tokenColor(asyntax.Tok.Keyword) == 0x569CD6 && dark->tokenColor(asyntax.Tok.String) == 0xCE9178, "token colours");
    check(dark->tokenColor(999) == dark->color(atheme.Col.Foreground), "an unknown token kind uses the foreground colour");
    check(dark->color(-1) == 0 && dark->color(99) == 0, "out of range colour slots are 0");
    atheme.Warnings hw();
    atheme.Theme* hc = atheme.builtin("high-contrast");
    checkEq(hc->validate(&hw), 0, "the high contrast theme has no contrast problems");
    check(atheme.contrast(hc->color(atheme.Col.Foreground), hc->color(atheme.Col.Background)) >= 1500, "its text contrast is at least 15:1");
    hw.dispose();
    atheme.Warnings dw();
    checkEq(dark->validate(&dw), 0, "the dark theme has no contrast problems");
    dw.dispose();

    // ---- a theme with unreadable colours is reported
    {
        atheme.Theme* bad = atheme.builtin("dark");
        bad->setColor(atheme.Col.Foreground, 0x303030);
        bad->setColor(atheme.Col.StatusBarText, 0x007bd0);
        bad->setToken(asyntax.Tok.Comment, 0x202020, 0);
        atheme.Warnings w();
        int n = bad->validate(&w);
        check(n >= 4, "an unreadable theme gets several warnings");
        check(w.has("foreground on background: contrast"), "foreground on background");
        check(w.has("status bar text on status bar"), "status bar text");
        check(w.has("comment on background"), "comment colour");
        check(w.has("foreground on selection") || w.has("foreground on current line"), "foreground on the selection or the current line");
        check(!w.has("keyword on background"), "readable slots are not mentioned");
        check(w.has(":1 (minimum 4.5:1)") && w.has(":1 (minimum 3.0:1)"), "the messages name the minimum");
        w.dispose();
    }

    // ---- saving and loading a theme
    asys.mkdirs("build/tests/t210_work");
    {
        atheme.Theme* t = atheme.builtin("gruvbox");
        t->setName("My Gruvbox");
        t->setColor(atheme.Col.Cursor, 0x123456);
        t->setToken(asyntax.Tok.Keyword, 0xAA5500, atheme.STYLE_BOLD | atheme.STYLE_ITALIC | atheme.STYLE_UNDERLINE);
        char* path = "build/tests/t210_work/my.theme";
        checkEq(t->save(path), 0, "save a theme");
        atheme.Warnings w();
        atheme.Theme* u = atheme.loadTheme(path, &w);
        checkEq(w.count, 0, "loading our own file gives no warnings");
        check(sameTheme(t, u), "every colour and style survives the round trip");
        checkStr(u->name, "My Gruvbox", "the name survives");
        check(u->tokenStyle(asyntax.Tok.Keyword) == 7 && u->color(atheme.Col.Cursor) == 0x123456, "the changed values survive");
        char* ini = t->toIni();
        check(contains(ini, "[theme]") && contains(ini, "name = My Gruvbox") && contains(ini, "[colors]") && contains(ini, "cursor = #123456") && contains(ini, "keyword = #aa5500 bold italic underline"), "the file text looks as documented");
        asys.free(ini);
        w.dispose();
        asys.unlink(path);
    }
    {
        // a file that changes only a few values of a base theme
        char* text = "; my theme\n[theme]\nname = Tweaked\nbase = nord\n[colors]\nbackground = #101010\n[tokens]\nkeyword = red bold\nstring = #00ff00\n";
        atheme.Warnings w();
        atheme.Theme* t = atheme.parseTheme(text, strlen(text), &w);
        atheme.Theme* nord = atheme.builtin("nord");
        checkEq(w.count, 0, "no warnings for a good file");
        checkStr(t->name, "Tweaked", "the name");
        checkEq(t->color(atheme.Col.Background), 0x101010, "background replaced");
        checkEq(t->color(atheme.Col.Foreground), nord->color(atheme.Col.Foreground), "everything else comes from the base theme");
        checkEq(t->tokenColor(asyntax.Tok.Keyword), 0xFF0000, "keyword colour by name");
        checkEq(t->tokenStyle(asyntax.Tok.Keyword), atheme.STYLE_BOLD, "keyword style");
        checkEq(t->tokenColor(asyntax.Tok.String), 0x00FF00, "string colour");
        checkEq(t->tokenStyle(asyntax.Tok.String), 0, "no style");
        checkEq(t->tokenColor(asyntax.Tok.Number), nord->tokenColor(asyntax.Tok.Number), "numbers stay as in nord");
        w.dispose();
    }
    // ---- corrupt theme files never crash and fall back to sane values
    {
        atheme.Theme* dark2 = atheme.builtin("dark");
        // random bytes
        char* junk = asys.alloc(5000);
        for (int i = 0; i < 5000; i++) { junk[i] = rnd(256); }
        atheme.Warnings w();
        atheme.Theme* t = atheme.parseTheme(junk, 5000, &w);
        check(t != null && w.count > 0, "random bytes: a theme and warnings");
        check(sameTheme(t, dark2) || w.count > 0, "random bytes: the base theme or warnings");
        w.dispose();
        // binary with NULs and CRLF
        char* mixed = "[colors]\r\nbackground = #112233\r\n\x00\x01\x02garbage\r\n[tokens]\r\nkeyword = #445566 bold\r\n";
        t = atheme.parseTheme(mixed, 66, &w);
        checkEq(t->color(atheme.Col.Background), 0x112233, "CRLF lines and NUL bytes are skipped");
        w.dispose();
        // empty
        t = atheme.parseTheme("", 0, &w);
        check(sameTheme(t, dark2), "an empty file gives the dark theme");
        check(w.has("no colours"), "and says so");
        w.dispose();
        // a UTF-8 byte order mark
        char* bom = "\xef\xbb\xbf[theme]\nname = Bom\n[colors]\nforeground = #010203\n";
        t = atheme.parseTheme(bom, strlen(bom), &w);
        check(streq(t->name, "Bom") && t->color(atheme.Col.Foreground) == 0x010203, "a byte order mark is skipped");
        w.dispose();
        // bad values and unknown things
        char* bad = "[colors]\nbackground = #xyz\nforeground =\nnosuchcolor = #fff\ncursor = #abc\n[tokens]\nnosuchkind = red\nkeyword = notacolor\ncomment = #00ff00 italic bold\n[weird]\na = b\n[theme]\nbase = nonexistent\nfoo = bar\n";
        t = atheme.parseTheme(bad, strlen(bad), &w);
        check(t->color(atheme.Col.Background) == dark2->color(atheme.Col.Background), "a bad colour value leaves the base value");
        check(t->color(atheme.Col.Foreground) == dark2->color(atheme.Col.Foreground), "an empty value too");
        checkEq(t->color(atheme.Col.Cursor), 0xAABBCC, "good entries are applied");
        check(t->tokenColor(asyntax.Tok.Keyword) == dark2->tokenColor(asyntax.Tok.Keyword), "a bad token colour is ignored");
        checkEq(t->tokenStyle(asyntax.Tok.Comment), atheme.STYLE_BOLD | atheme.STYLE_ITALIC, "styles in any order");
        check(w.has("bad colour value for background") && w.has("unknown colour: nosuchcolor") && w.has("unknown token kind: nosuchkind") && w.has("unknown section: weird") && w.has("unknown base theme: nonexistent") && w.has("unknown key in [theme]: foo"), "every problem is reported once");
        w.dispose();
        // a line of 10000 characters
        char* longLine = asys.alloc(10100);
        memcpy(longLine, "[colors]\nbackground = #", 23);
        for (int i = 0; i < 10000; i++) { longLine[23 + i] = 'f'; }
        longLine[10023] = 10;
        memcpy(&longLine[10024], "foreground = #0a0b0c\n", 21);
        t = atheme.parseTheme(longLine, 10045, &w);
        checkEq(t->color(atheme.Col.Foreground), 0x0A0B0C, "a 10000 byte line is cut, the next line still works");
        w.dispose();
        asys.free(longLine);
        // a file that is too big
        char* path = "build/tests/t210_work/huge.theme";
        asys.AtomicFile af();
        af.open(path, 420, asys.W_NOSYNC);
        char* chunk = asys.alloc(65536);
        for (int i = 0; i < 65536; i++) { chunk[i] = 'x'; }
        for (int i = 0; i < 17; i++) { af.write(chunk, 65536); }
        af.commit();
        t = atheme.loadTheme(path, &w);
        check(sameTheme(t, dark2) && w.has("cannot read"), "a file over 1 MB is refused with a warning (dark theme)");
        w.dispose();
        asys.unlink(path);
        asys.free(chunk);
        t = atheme.loadTheme("build/tests/t210_work/missing.theme", &w);
        check(sameTheme(t, dark2) && w.has("no such file"), "a missing file gives the dark theme and a warning");
        w.dispose();
        // a directory
        t = atheme.loadTheme("build/tests/t210_work", &w);
        check(t != null && w.count > 0, "a directory is refused");
        w.dispose();
    }

    // ---- settings
    {
        atheme.Settings s();
        checkEq(s.tabWidth, 4, "default tab width");
        check(s.insertSpaces && s.lineNumbers && !s.wordWrap && s.autoIndent && !s.trimOnSave, "default flags");
        checkEq(s.fontSize, 14, "default font size");
        checkStr(s.theme, "dark", "default theme");
        check(s.winW == 960 && s.winH == 640 && !s.winMaximized, "default window");
        s.tabWidth = 8; s.insertSpaces = false; s.wordWrap = true; s.fontSize = 18; s.trimOnSave = true; s.finalNewline = true;
        s.winX = 10; s.winY = -20; s.winW = 1200; s.winH = 800; s.winMaximized = true;
        asys.free(s.theme);
        s.theme = asys.strDup("nord");
        s.addRecentFile("/a/one.a");
        s.addRecentFile("/a/two.a");
        s.addRecentFile("/a/one.a");
        s.addRecentProject("/work/aos");
        s.setBinding("file.save", "ctrl+s");
        s.setBinding("edit.undo", "ctrl+z");
        s.setBinding("file.save", "ctrl+shift+s");
        char* path = "build/tests/t210_work/cfg/settings.ini";
        checkEq(s.save(path), 0, "save settings (creates the directory)");
        atheme.Settings r();
        checkEq(r.load(path), 0, "load them again");
        checkEq(r.unknown, 0, "nothing unknown");
        check(r.tabWidth == 8 && !r.insertSpaces && r.wordWrap && r.fontSize == 18 && r.trimOnSave && r.finalNewline, "editor settings round trip");
        check(r.winX == 10 && r.winY == -20 && r.winW == 1200 && r.winH == 800 && r.winMaximized, "window geometry round trips");
        checkStr(r.theme, "nord", "theme name round trips");
        checkEq(r.nFiles, 2, "two recent files");
        checkStr(r.recentFiles[0], "/a/one.a", "most recent first (a repeat moves to the front)");
        checkStr(r.recentFiles[1], "/a/two.a", "then the older one");
        checkEq(r.nProjects, 1, "one recent project");
        checkStr(r.binding("file.save"), "ctrl+shift+s", "the later binding replaced the earlier one");
        checkStr(r.binding("edit.undo"), "ctrl+z", "other binding");
        check(r.binding("nothing") == null, "unknown action");
        asys.unlink(path);
        asys.rmdir("build/tests/t210_work/cfg");
        checkEq(r.load("build/tests/t210_work/none.ini"), -asys.ENOENT, "a missing settings file: ENOENT, values kept");
        checkEq(r.tabWidth, 8, "and the values are kept");
        // recent list limit
        atheme.Settings m();
        for (int i = 0; i < 50; i++) {
            char p[40];
            format(&p[0], 40, "/f/%d", i);
            m.addRecentFile(&p[0]);
        }
        checkEq(m.nFiles, atheme.MAX_RECENT, "the recent list is capped");
        checkStr(m.recentFiles[0], "/f/49", "newest first");
        checkStr(m.recentFiles[29], "/f/20", "oldest kept");
        m.addRecentFile("/f/30");
        checkStr(m.recentFiles[0], "/f/30", "an existing entry moves to the front");
        checkEq(m.nFiles, atheme.MAX_RECENT, "without growing the list");
    }
    {
        // clamping and corrupt values
        atheme.Settings s();
        char* text = "[editor]\ntabWidth = 0\nfontSize = 9999\nwordWrap = maybe\ninsertSpaces = no\ntheme =\nlineNumbers=off\nautoIndent = 1\nunknownKey = 1\n[window]\nwidth = 5\nheight = -40\nx = abc\n[nonsense]\nq = 1\n[recent]\nfile = \nfile = /ok.a\nfile = /ok.a\n";
        int bad = s.parse(text, strlen(text));
        checkEq(s.tabWidth, 1, "tab width 0 becomes 1");
        checkEq(s.fontSize, 72, "a huge font size is capped");
        check(!s.wordWrap, "an unknown boolean keeps the old value");
        check(!s.insertSpaces && !s.lineNumbers && s.autoIndent, "booleans in several spellings");
        checkStr(s.theme, "dark", "an empty theme name keeps the old one");
        checkEq(s.winW, 200, "a tiny window width is raised to 200");
        checkEq(s.winH, 120, "a negative height is raised to 120");
        checkEq(s.winX, 80, "garbage keeps the default");
        checkEq(s.nFiles, 1, "empty and repeated recent entries are skipped");
        check(bad >= 3, "unknown entries are counted");
        s.parse("[editor]\ntabWidth = -7\n", 22);
        checkEq(s.tabWidth, 1, "a negative tab width becomes 1");
        s.parse("[editor]\ntabWidth = 99\n", 22);
        checkEq(s.tabWidth, 16, "a huge tab width is capped");
        // random garbage
        char* junk = asys.alloc(8000);
        for (int i = 0; i < 8000; i++) { junk[i] = rnd(256); }
        atheme.Settings g();
        g.parse(junk, 8000);
        check(g.tabWidth >= 1 && g.tabWidth <= 16 && g.fontSize >= 6 && g.fontSize <= 72, "random bytes leave sane values");
        char* path = "build/tests/t210_work/junk.ini";
        asys.writeFile(path, junk, 8000);
        atheme.Settings g2();
        checkEq(g2.load(path), 0, "loading a junk file does not fail");
        check(g2.theme != null && strlen(g2.theme) > 0, "and leaves a theme name");
        asys.unlink(path);
        asys.free(junk);
    }
    // ---- the configuration directory
    {
        char* d1 = atheme.configDirFrom("/custom/aide", "/home/u");
        char* d2 = atheme.configDirFrom(null, "/home/u");
        char* d3 = atheme.configDirFrom("", "/home/u");
        char* d4 = atheme.configDirFrom(null, null);
        char* d5 = atheme.configDirFrom("", "");
        checkStr(d1, "/custom/aide", "AIDE_HOME wins");
        checkStr(d2, "/home/u/.aide", "else HOME/.aide");
        checkStr(d3, "/home/u/.aide", "an empty AIDE_HOME does not count");
        checkStr(d4, ".aide", "else .aide in the current directory");
        checkStr(d5, ".aide", "empty values too");
        char* d6 = atheme.configDir();
        check(d6 != null && strlen(d6) > 0, "configDir of this process");
    }
    asys.rmdir("build/tests/t210_work");
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
