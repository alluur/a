// single inheritance, virtual methods, super, protected
class Animal {
    protected int legs;
    private int secret;
    public Animal(int l) { legs = l; secret = 42; }
    public virtual int speak() { return 1; }
    public virtual int kind() { return 100; }
    public int describe() { return speak() * 1000 + legs; }
    public int sec() { return secret; }
}

class Dog : Animal {
    public Dog() { super(4); }
    public int speak() { return 2; }
}

class Puppy : Dog {
    public int speak() { return super.speak() + 10; }
    public int twice() { return legs * 2; }
    public int kind() { return 7; }
}

class Plain {
    public int v;
    public int get() { return v; }
}
class PlainKid : Plain {
    public int w;
    public int sum() { return v + w; }
}

Dog gdog;
int total(Animal* a, Animal* b) { return a->describe() + b->describe(); }

int main() {
    Animal* a = new Animal(2);
    Animal* d = new Dog();
    Animal* p = new Puppy();
    printlnInt(a->describe());
    printlnInt(d->describe());
    printlnInt(p->describe());
    printlnInt(a->kind());
    printlnInt(d->kind());
    printlnInt(p->kind());
    printlnInt(p->sec());
    Puppy* pp = new Puppy();
    printlnInt(pp->twice());
    Dog loc;
    printlnInt(loc.speak());
    Animal* lp = &loc;
    printlnInt(lp->speak());
    Puppy pl;
    Animal* q = &pl;
    printlnInt(q->speak());
    gdog.speak();
    Animal* g = &gdog;
    printlnInt(g->speak());
    printlnInt(total(a, p));
    PlainKid* k = new PlainKid();
    k->v = 3; k->w = 4;
    printlnInt(k->sum());
    printlnInt(k->get());
    printlnInt(sizeof(Animal));
    printlnInt(sizeof(Dog));
    printlnInt(sizeof(PlainKid));
    return 0;
}
