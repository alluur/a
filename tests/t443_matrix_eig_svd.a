// matrix: symmetric eigenvalues (Jacobi) and the singular value decomposition (one sided Jacobi).
// Expected output: tests/algo2_ref/gen_t443.py (Jacobi iteration in 60 digit decimals, exact fractions for the pseudo inverse).
import cstdio;
import asys;
import matrix;
import dmath;

int seed = 31415;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

double clean(double v) { return (v < 1.0e-11 && v > -1.0e-11) ? 0.0 : v; }
double absOf(double v) { return v < 0.0 ? -v : v; }

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.9g", __bits(clean(v[i]))); }
    printf("\n");
}

// the absolute values of the entries (eigenvectors and singular vectors are only defined up to sign)
void dumpAbs(char* name, matrix.Matrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" %.9g", __bits(clean(absOf(m->d[i])))); }
    printf("\n");
}

void dumpM(char* name, matrix.Matrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" %.9g", __bits(clean(m->d[i]))); }
    printf("\n");
}

void fillRandom(matrix.Matrix* m) {
    for (int i = 0; i < m->rows * m->cols; i++) { m->d[i] = (double) (lcg() % 19 - 9); }
}

void symmetrize(matrix.Matrix* m) {
    int n = m->rows;
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) { m->d[j * n + i] = m->d[i * n + j]; }
    }
}

double maxAbsDiff(double* a, double* b, int n) {
    double m = 0.0;
    for (int i = 0; i < n; i++) {
        double d = absOf(a[i] - b[i]);
        if (d > m) { m = d; }
    }
    return m;
}

// the largest deviation of Q^T Q from the identity for a matrix with orthonormal columns
double orthoError(matrix.Matrix* q) {
    matrix.Matrix qt = q->transpose();
    matrix.Matrix g = qt * q;
    double worst = 0.0;
    for (int i = 0; i < g.rows; i++) {
        for (int j = 0; j < g.cols; j++) {
            double dd = absOf(g.d[i * g.cols + j] - ((i == j) ? 1.0 : 0.0));
            if (dd > worst) { worst = dd; }
        }
    }
    qt.dispose();
    g.dispose();
    return worst;
}

int main() {
    int base = asys.memInUse();
    // ---- symmetric eigenvalues
    {
        int n = 6;
        matrix.Matrix a(n, n);
        fillRandom(&a);
        symmetrize(&a);
        matrix.SymEigen e(&a);
        printf("6x6: status %d, sweeps below 15: %d\n", e.err, e.sweeps < 15);
        dumpV("values", e.values, n);
        dumpAbs("|vectors|", &e.vectors);
        printf("residual below 1e-12: %d, orthonormal: %d\n", e.maxResidual(&a) < 1.0e-12, orthoError(&e.vectors) < 1.0e-14);
        double tr = 0.0;
        double sum = 0.0;
        for (int i = 0; i < n; i++) { tr += a.d[i * n + i]; sum += e.values[i]; }
        printf("trace = sum of eigenvalues: %d\n", absOf(tr - sum) < 1.0e-12);
        double dt = 1.0;
        for (int i = 0; i < n; i++) { dt *= e.values[i]; }
        printf("det = product of eigenvalues (relative 1e-10): %d\n", absOf(dt - a.det()) < 1.0e-10 * absOf(dt));
        // A = V diag(w) V^T
        matrix.Matrix vd = e.vectors.copy();
        for (int i = 0; i < n; i++) { for (int j = 0; j < n; j++) { vd.d[i * n + j] *= e.values[j]; } }
        matrix.Matrix vt = e.vectors.transpose();
        matrix.Matrix rec = vd * &vt;
        printf("V diag(w) V^T = A (1e-12): %d\n", maxAbsDiff(rec.d, a.d, n * n) < 1.0e-12);
        e.dispose(); a.dispose(); vd.dispose(); vt.dispose(); rec.dispose();
        matrix.SymEigen ev(&a);
        printf("after dispose: status %d, ok %d\n", ev.err, ev.ok());
    }
    {
        // small known cases
        double v1[4] = {2, 1, 1, 2};
        matrix.Matrix a = matrix.fromArray(v1, 2, 2);
        matrix.SymEigen e(&a);
        dumpV("[[2,1],[1,2]] values", e.values, 2);
        dumpAbs("vectors", &e.vectors);
        e.dispose(); a.dispose();
        double v2[9] = {2, 0, 0, 0, 5, 0, 0, 0, 2};
        matrix.Matrix b = matrix.fromArray(v2, 3, 3);
        matrix.SymEigen e2(&b);
        dumpV("diag(2,5,2) values", e2.values, 3);
        printf("repeated eigenvalue: residual %d, orthonormal %d, sweeps %d\n", e2.maxResidual(&b) < 1.0e-14, orthoError(&e2.vectors) < 1.0e-14, e2.sweeps);
        e2.dispose(); b.dispose();
        double v3[9] = {2, 1, 1, 1, 2, 1, 1, 1, 2};          // eigenvalues 1, 1, 4
        matrix.Matrix c = matrix.fromArray(v3, 3, 3);
        matrix.SymEigen e3(&c);
        dumpV("[[2,1,1],[1,2,1],[1,1,2]] values", e3.values, 3);
        printf("residual %d, orthonormal %d\n", e3.maxResidual(&c) < 1.0e-13, orthoError(&e3.vectors) < 1.0e-14);
        e3.dispose(); c.dispose();
        double v4[4] = {1, 1, 1, 1};
        matrix.Matrix d = matrix.fromArray(v4, 2, 2);
        matrix.SymEigen e4(&d);
        dumpV("[[1,1],[1,1]] values (one is zero)", e4.values, 2);
        e4.dispose(); d.dispose();
        double v5[9] = {0, 1, 0, 1, 0, 1, 0, 1, 0};          // eigenvalues -sqrt2, 0, sqrt2
        matrix.Matrix f = matrix.fromArray(v5, 3, 3);
        matrix.SymEigen e5(&f);
        dumpV("path graph values", e5.values, 3);
        e5.dispose(); f.dispose();
        matrix.Matrix one(1, 1);
        one.d[0] = -7.5;
        matrix.SymEigen e6(&one);
        dumpV("1x1", e6.values, 1);
        e6.dispose(); one.dispose();
        matrix.Matrix z(3, 3);
        matrix.SymEigen e7(&z);
        dumpV("zero matrix", e7.values, 3);
        e7.dispose(); z.dispose();
    }
    {
        // a bigger one: 20 x 20
        int n = 20;
        matrix.Matrix a(n, n);
        fillRandom(&a);
        symmetrize(&a);
        matrix.SymEigen e(&a);
        printf("20x20: status %d, residual below 1e-11: %d, orthonormal %d, ascending %d\n", e.err, e.maxResidual(&a) < 1.0e-11, orthoError(&e.vectors) < 1.0e-13, e.values[0] <= e.values[1] && e.values[18] <= e.values[19]);
        bool sorted = true;
        for (int i = 1; i < n; i++) { if (e.values[i - 1] > e.values[i]) { sorted = false; } }
        printf("all ascending: %d\n", sorted);
        matrix.SymEigen ev(&a, false);
        printf("values only: status %d, same values %d, vectors empty %d\n", ev.err, maxAbsDiff(ev.values, e.values, n) < 1.0e-12, !ev.vectors.ok());
        ev.dispose(); e.dispose(); a.dispose();
    }
    {
        // refused input
        double v[4] = {1, 2, 3, 4};
        matrix.Matrix a = matrix.fromArray(v, 2, 2);
        matrix.SymEigen e(&a);
        printf("not symmetric: status %d (%s)\n", e.err, matrix.errorText(e.err));
        a.d[1] = a.d[2];
        a.d[0] = __dbl(0x7FF8000000000000);
        matrix.SymEigen e2(&a);
        printf("NaN: status %d\n", e2.err);
        matrix.Matrix r(2, 3);
        matrix.SymEigen e3(&r);
        printf("2x3: status %d\n", e3.err);
        matrix.SymEigen e4(null);
        printf("null: status %d\n", e4.err);
        a.dispose(); r.dispose();
    }

    // ---- SVD
    {
        matrix.Matrix a(5, 3);
        fillRandom(&a);
        matrix.SVD s(&a);
        printf("5x3: status %d, sweeps below 15: %d\n", s.err, s.sweeps < 15);
        dumpV("singular values", s.s, 3);
        dumpAbs("|U|", &s.u);
        dumpAbs("|V|", &s.v);
        matrix.Matrix rec = s.reconstruct();
        printf("U S V^T = A (1e-12): %d, U orthonormal %d, V orthonormal %d\n", maxAbsDiff(rec.d, a.d, 15) < 1.0e-12, orthoError(&s.u) < 1.0e-14, orthoError(&s.v) < 1.0e-14);
        printfd("rank %d, cond %.9g, norm2 %.9g\n", s.rank(), __bits(s.cond()), __bits(s.norm2()));
        matrix.Matrix pi = s.pinv();
        dumpM("pinv", &pi);
        double b[5];
        for (int i = 0; i < 5; i++) { b[i] = (double) (lcg() % 19 - 9); }
        double x[3];
        printf("solve %d\n", s.solve(b, x));
        dumpV("least squares x", x, 3);
        printfd("convenience: rank %d, cond %.9g\n", a.rank(0 * 1.0), __bits(a.cond()));
        s.dispose(); a.dispose(); rec.dispose(); pi.dispose();
        // the wide matrix has the same singular values
        matrix.Matrix w(3, 5);
        fillRandom(&w);
        matrix.SVD sw(&w);
        printf("3x5: status %d, U is %d x %d, V is %d x %d\n", sw.err, sw.u.rows, sw.u.cols, sw.v.rows, sw.v.cols);
        dumpV("singular values", sw.s, 3);
        matrix.Matrix recw = sw.reconstruct();
        printf("U S V^T = A (1e-12): %d, U orthonormal %d, V orthonormal %d\n", maxAbsDiff(recw.d, w.d, 15) < 1.0e-12, orthoError(&sw.u) < 1.0e-14, orthoError(&sw.v) < 1.0e-14);
        matrix.Matrix pw = sw.pinv();
        dumpM("pinv", &pw);
        sw.dispose(); w.dispose(); recw.dispose(); pw.dispose();
    }
    {
        // rank one, 3 x 4: u v^T
        double u[3] = {1, 2, 3};
        double vv[4] = {1, -1, 2, 0};
        matrix.Matrix a = matrix.outer(u, 3, vv, 4);
        matrix.SVD s(&a);
        dumpV("rank one values", s.s, 3);
        printfd("rank %d, cond is infinite %d, U orthonormal %d, V orthonormal %d\n", s.rank(), __bits(s.cond()) == 0x7FF0000000000000, orthoError(&s.u) < 1.0e-14, orthoError(&s.v) < 1.0e-14);
        matrix.Matrix rec = s.reconstruct();
        printf("U S V^T = A (1e-12): %d\n", maxAbsDiff(rec.d, a.d, 12) < 1.0e-12);
        matrix.Matrix pi = s.pinv();
        dumpM("pinv", &pi);
        double b[3] = {1, 0, 2};
        double x[4];
        printf("solve %d\n", s.solve(b, x));
        dumpV("minimum norm x", x, 4);
        s.dispose(); a.dispose(); rec.dispose(); pi.dispose();
        matrix.Matrix z(3, 2);
        matrix.SVD sz(&z);
        printfd("zero matrix: status %d, values %g %g, rank %d, cond is infinite %d, U orthonormal %d\n", sz.err, __bits(sz.s[0]), __bits(sz.s[1]), sz.rank(), __bits(sz.cond()) == 0x7FF0000000000000, orthoError(&sz.u) < 1.0e-14);
        sz.dispose(); z.dispose();
        matrix.Matrix col(4, 1);
        col.d[0] = 3.0; col.d[1] = 0.0; col.d[2] = 4.0; col.d[3] = 0.0;
        matrix.SVD sc(&col);
        dumpV("column (3, 0, 4, 0)", sc.s, 1);
        sc.dispose(); col.dispose();
        matrix.Matrix row(1, 3);
        row.d[0] = 2.0; row.d[1] = 3.0; row.d[2] = 6.0;
        matrix.SVD sr(&row);
        dumpV("row (2, 3, 6)", sr.s, 1);
        sr.dispose(); row.dispose();
    }
    {
        // the Hilbert matrix of order 8: the smallest singular value is tiny (about 1e-10) and Jacobi still finds it to 3 digits
        matrix.Matrix h = matrix.hilbert(8);
        matrix.SVD s(&h);
        printf("hilbert(8) singular values (3 digits):");
        for (int i = 0; i < 8; i++) { printfd(" %.3g", __bits(s.s[i])); }
        printf("\n");
        printfd("condition number %.3g, rank %d, rank with tolerance 1e-8 %d\n", __bits(s.cond()), s.rank(), s.rank(1.0e-8 * 1.0));
        s.dispose(); h.dispose();
        // a matrix with a huge dynamic range between its columns
        matrix.Matrix a(3, 2);
        a.d[0] = 1.0e150; a.d[1] = 1.0;
        a.d[2] = 1.0e150; a.d[3] = -1.0;
        a.d[4] = 0.0; a.d[5] = 1.0e-150;
        matrix.SVD sa(&a);
        printfd("1e150 / 1 columns: status %d, s0 %.9g, s1 relative to 1: %.3g\n", sa.err, __bits(sa.s[0] / 1.0e150), __bits(sa.s[1]));
        sa.dispose(); a.dispose();
        double v[4] = {1, 2, 3, 4};
        matrix.Matrix n = matrix.fromArray(v, 2, 2);
        n.d[3] = __dbl(0x7FF0000000000000);
        matrix.SVD sn(&n);
        printf("infinity: status %d, rank of it (convenience) %d\n", sn.err, n.rank());
        sn.dispose(); n.dispose();
        matrix.SVD sx(null);
        printf("null: status %d\n", sx.err);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
