// gcode.FindBar and gcode.GotoBar with a CodeEditor: incremental find, next / previous with wrap around, count ("3 of 12"), case / word /
// regular expression toggles, errors, replace, replace all (one undo step), search in the selection, keys, go to line texts
import wsrv;
import gui;
import guix;
import gcode;
import afind;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gcode.FindBar* fb;
gcode.GotoBar* gb;
gui.Window* w;
int closed = 0;

int onClosed(int b) { closed++; return 0; }

void state(char* label) {
    printf("%s: matches %d, index %d, caret %d", label, fb->matchCount, fb->matchIndex, e->ed->caret());
    if (e->ed->anySelection()) {
        char* t = e->getSelectedText();
        printf(", selected [%s]", t);
        asys.free(t);
    }
    printf("\n");
}

void text(char* label) {
    char* t = e->getText();
    printf("%s: [", label);
    for (int i = 0; t[i] != 0; i++) { printf("%c", (t[i] == 10) ? '|' : t[i]); }
    printf("]\n");
    asys.free(t);
}

int main() {
    gcode.theLook()->autoComplete = false;
    startServer(7348, "t248");
    w = d->createWindow("Find", 640, 400, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    fb = new gcode.FindBar(e);
    fb->onClose = onClosed;
    gb = new gcode.GotoBar(e);
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    col->add(fb);
    col->add(gb);
    w->setRoot(col);
    w->setFocus(e);
    e->setText("The cat sat. The Cat ran.\nconcatenate the cat\nCAT cat Cat\nno match here\n");
    e->doc->setLanguage(asyntax.Lang.Text);
    e->highlightWord = false;
    settle();
    printf("the bar starts hidden: %d, editor has the whole height: %d\n", !fb->isOpen(), e->h > 340);

    // opening: the find field has the focus; typing finds the first match after the caret (incremental) and counts
    fb->open(false);
    settle();
    printf("open: bar shown %d, find field focused %d, replace row %d\n", fb->isOpen(), w->focusWidget == fb->findBox, fb->replaceVisible);
    typeStr("cat");
    state("typed cat (case insensitive)");
    key(adp.KEY_ENTER, 13);
    state("Enter: next");
    key(adp.KEY_ENTER, 13);
    state("Enter: next");
    keyMods(adp.KEY_ENTER, 13, adp.MOD_SHIFT);
    state("Shift+Enter: previous");
    for (int i = 0; i < 9; i++) { key(adp.KEY_ENTER, 13); }
    state("nine more times: wrapped around");
    printf("the editor shows matches (highlight on): %d\n", e->hasFindHighlight());

    // the options: match case (Alt+C), whole word (Alt+W), regular expression (Alt+R)
    keyMods('c', 0, adp.MOD_ALT);
    state("match case");
    keyMods('c', 0, adp.MOD_ALT);
    keyMods('w', 0, adp.MOD_ALT);
    state("whole word");
    keyMods('w', 0, adp.MOD_ALT);
    fb->setPattern("c.t");
    state("c.t as plain text");
    keyMods('r', 0, adp.MOD_ALT);
    state("c.t as a regular expression");
    fb->setPattern("(");
    printf("an invalid expression: matches %d, nothing is highlighted\n", fb->matchCount);
    fb->setPattern("\\bcat\\b");
    state("\\bcat\\b");
    keyMods('r', 0, adp.MOD_ALT);
    fb->setPattern("zzz");
    state("no match");
    fb->setPattern("");
    state("empty pattern");

    // incremental search starts at the caret
    e->gotoLine(2, 0);
    settle();
    fb->open(false);
    typeStr("cat");
    state("opened with the caret in line 3");

    // an editor selection of one line becomes the pattern
    e->select(4, 7);
    fb->open(false);
    printf("pattern from the selection: [%s]\n", fb->pattern());

    // replace
    fb->open(true);
    fb->setPattern("cat");
    fb->setReplacement("dog");
    printf("replace row shown: %d\n", fb->replaceVisible);
    e->ed->setCursor(0);
    fb->setPattern("cat");
    state("pattern cat from the start");
    fb->replaceCurrent();
    text("Replace (the first match was selected)");
    fb->replaceCurrent();
    text("Replace again (the next match was selected)");
    state("after Replace");
    e->cmdUndo();
    text("undo of one replace");
    char* before = e->getText();
    int n = fb->replaceAll();
    text("Replace All");
    printf("replaced %d, one undo step brings all back: ", n);
    e->cmdUndo();
    char* t0 = e->getText();
    printf("%d\n", streq(t0, before));
    asys.free(t0);
    asys.free(before);

    // regular expression replacement with groups, and a case change of the text
    fb->setOptions(true, false, true);
    fb->setPattern("(\\w+) (\\w+)\\.");
    fb->setReplacement("$2 $1.");
    n = fb->replaceAll();
    text("regex with groups");
    e->cmdUndo();
    fb->setOptions(false, false, false);

    // replace in the selection only
    fb->setPattern("cat");
    fb->setReplacement("X");
    e->select(e->buf->lineStart(1), e->buf->lineEnd(1));
    fb->setInSelection(true);
    n = fb->replaceAll();
    text("only in the selection (line 2)");
    printf("replaced %d\n", n);
    fb->setInSelection(false);
    e->cmdUndo();

    // the count follows the text
    fb->setPattern("cat");
    int c0 = fb->matchCount;
    e->ed->setCursor(0);
    e->ed->insertString("cat ");
    e->touch();
    settle();
    printf("typing a match raises the count: %d -> %d\n", c0, fb->matchCount);

    // read only: no replacing
    e->setReadOnly(true);
    printf("replace all in a read only editor: %d\n", fb->replaceAll());
    e->setReadOnly(false);

    // Esc closes the bar, clears the highlights and gives the focus back
    fb->findBox->focusMe();
    key(adp.KEY_ESCAPE, 27);
    printf("Esc: bar shown %d, highlights %d, focus in the editor %d, onClose %d\n", fb->isOpen(), e->hasFindHighlight(), w->focusWidget == e, closed);
    printf("the editor has the whole height again: %d\n", e->h > 340);

    // the go to line bar
    e->setText("l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n");
    e->gotoLine(0, 0);
    settle();
    gb->open();
    printf("goto: shown %d, focus in its field %d\n", gb->visible, w->focusWidget == gb->box);
    typeStr("5");
    key(adp.KEY_ENTER, 13);
    printf("5: caret line %d (0 based), bar closed %d, focus in the editor %d\n", e->ed->caretLine(), !gb->visible, w->focusWidget == e);
    gb->open();
    typeStr("3:2");
    key(adp.KEY_ENTER, 13);
    printf("3:2: line %d column %d\n", e->ed->caretLine(), e->ed->caretCol());
    gb->open();
    typeStr("+4");
    key(adp.KEY_ENTER, 13);
    printf("+4: line %d\n", e->ed->caretLine());
    gb->open();
    typeStr("-1");
    key(adp.KEY_ENTER, 13);
    printf("-1: line %d\n", e->ed->caretLine());
    gb->open();
    typeStr("999");
    key(adp.KEY_ENTER, 13);
    printf("999 goes to the last line: line %d of %d\n", e->ed->caretLine(), e->buf->lineCount());
    gb->open();
    typeStr("abc");
    key(adp.KEY_ENTER, 13);
    printf("abc: the bar stays open %d, caret line unchanged %d\n", gb->visible, e->ed->caretLine());
    key(adp.KEY_ESCAPE, 27);
    printf("Esc closes it: %d\n", !gb->visible);
    int l = 0; int c = 0;
    printf("parseGoto: 12 %d, 0 %d, 12:3 %d, ' 7 ' %d, '3:' %d, '' %d\n", gcode.parseGoto("12", 0, 50, &l, &c), gcode.parseGoto("0", 0, 50, &l, &c), gcode.parseGoto("12:3", 0, 50, &l, &c), gcode.parseGoto(" 7 ", 0, 50, &l, &c), gcode.parseGoto("3:", 0, 50, &l, &c), gcode.parseGoto("", 0, 50, &l, &c));
    gcode.parseGoto("12:3", 0, 50, &l, &c);
    printf("12:3 -> line %d column %d\n", l, c);

    // the picture of the bar in two themes
    fb->open(true);
    fb->setPattern("l1");
    fb->setReplacement("x");
    settle();
    gcode.theLook()->setThemeName("dark");
    settle();
    printf("dark screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("dark");
    return 0;
}
