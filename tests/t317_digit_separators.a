// digit separators: underscores are ignored inside number literals (decimal, hex, binary, fractions and exponents)
int main() {
    printlnInt(1_000_000);
    printlnInt(0xFF_FF);
    printlnInt(0xDEAD_BEEF);
    printlnInt(0b1010_1010);
    printlnInt(1_0);
    printlnInt(12_34_56);
    printlnInt(0x_F);                       // also directly after the prefix
    printlnInt(1__2);                       // and several in a row
    printlnInt(9_223_372_036_854_775_807);
    printlnDouble(1_000.25);
    printlnDouble(3.141_592);
    printlnDouble(1_0e1_0 / 1_0e9);         // in the exponent too
    printlnDouble(2.5e-0_1);
    int _1 = 5;                             // an underscore first is a name
    printlnInt(_1);
    int a_1 = 7;
    printlnInt(a_1 + 1_0);
    uint64 big = 1_000_000_000_000;
    printlnInt(big / 1_000);
    const LIMIT = 64_000;
    printlnInt(LIMIT * 2);
    static_assert(1_024 == 1024 && 0x1_0000 == 65536 && 0b1_0000 == 16);
    int arr[1_0];
    printlnInt(sizeof(arr) / sizeof(arr[0]));
    return 0;
}
