// Random input on the gcode widgets (a fixed pseudo random sequence): keys with every modifier, clicks, drags, wheel, right clicks, window
// sizes, options; after every step the editor must be in a sane state (caret and cursors inside the text, a valid view, valid UTF-8),
// and undo must bring the text back to what it was when the editing started
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gcode.TabBar* tabs;
gcode.FindBar* fb;
gui.Window* w;
int seed = 12345;
int bad = 0;

int rnd(int n) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return (seed >> 8) % n;
}

bool validUtf8(char* t, int n) {
    int i = 0;
    while (i < n) {
        int c = t[i] & 255;
        int need = 0;
        if (c < 0x80) { need = 0; }
        else if (c >= 0xC2 && c < 0xE0) { need = 1; }
        else if (c >= 0xE0 && c < 0xF0) { need = 2; }
        else if (c >= 0xF0 && c < 0xF5) { need = 3; }
        else { return false; }
        for (int k = 1; k <= need; k++) {
            if (i + k >= n || (t[i + k] & 0xC0) != 0x80) { return false; }
        }
        i = i + need + 1;
    }
    return true;
}

// every invariant of the editor
void check(int step) {
    int len = e->buf->length();
    bool ok = true;
    int prevEnd = -1;
    for (int i = 0; i < e->ed->ncur; i++) {
        int a = e->ed->cur[i].anchor;
        int p = e->ed->cur[i].pos;
        if (a < 0 || a > len || p < 0 || p > len) { ok = false; }
        if (e->ed->selStart(i) < prevEnd) { ok = false; }
        prevEnd = e->ed->selEnd(i);
        // the caret is on a character boundary
        if (p > 0 && p < len && (e->buf->byteAt(p) & 0xC0) == 0x80) { ok = false; }
    }
    if (e->firstLine() < 0 || e->firstLine() >= e->buf->lineCount()) { ok = false; }
    if (e->firstCol() < 0) { ok = false; }
    if (e->ed->primary < 0 || e->ed->primary >= e->ed->ncur) { ok = false; }
    if (!ok) { bad++; printf("step %d: invalid state\n", step); }
}

void randomKey() {
    int mods = 0;
    int r = rnd(10);
    if (r == 0) { mods = adp.MOD_CTRL; }
    else if (r == 1) { mods = adp.MOD_SHIFT; }
    else if (r == 2) { mods = adp.MOD_ALT; }
    else if (r == 3) { mods = adp.MOD_CTRL | adp.MOD_SHIFT; }
    else if (r == 4) { mods = adp.MOD_ALT | adp.MOD_SHIFT; }
    else if (r == 5) { mods = adp.MOD_CTRL | adp.MOD_ALT; }
    int kinds = rnd(40);
    int key = 0;
    int uni = 0;
    if (kinds < 12) {
        // text: letters, digits, punctuation, brackets, space
        char* pool = "abcdefghijklmnopqrstuvwxyz0123456789 (){}[];=+-*/\"'_.,";
        key = pool[rnd(strlen(pool))];
        uni = key;
    } else if (kinds < 14) {
        int cps[8] = { 0xE4, 0x20AC, 0x1F600, 0x3042, 0x301, 0xA0, 0x7FF, 0xFFFD };
        uni = cps[rnd(8)];
    } else {
        int specials[22] = { adp.KEY_ENTER, adp.KEY_TAB, adp.KEY_BACKSPACE, adp.KEY_DELETE, adp.KEY_LEFT, adp.KEY_RIGHT, adp.KEY_UP, adp.KEY_DOWN, adp.KEY_HOME, adp.KEY_END, adp.KEY_PGUP, adp.KEY_PGDN, adp.KEY_ESCAPE, adp.KEY_F1 + 1,
                             'z', 'y', 'a', 'c', 'x', 'v', 'd', 'l' };
        key = specials[rnd(22)];
        if (key == adp.KEY_ENTER) { uni = 13; }
        if (key == adp.KEY_TAB) { uni = 9; }
        if (key == adp.KEY_BACKSPACE) { uni = 8; }
        if (key == adp.KEY_DELETE) { uni = 127; }
    }
    // the keys that the application keeps for itself are not sent (Ctrl+S, Ctrl+F ...): the editor does not use them either
    keyMods(key, uni, mods);
}

int wx = 0;
int wy = 0;

void randomMouse() {
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    wx = sw->x;
    wy = sw->y;
    int x = rnd(w->w);
    int y = rnd(w->h - 40) + 36;
    int r = rnd(10);
    if (r < 4) {
        hb->moveTo(wx + x, wy + y);
        hb->buttonDown(1);
        hb->buttonUp(1);
    } else if (r < 6) {
        int x2 = rnd(w->w);
        int y2 = rnd(w->h - 40) + 36;
        hb->moveTo(wx + x, wy + y);
        hb->buttonDown(1);
        hb->moveTo(wx + x2, wy + y2);
        hb->buttonUp(1);
    } else if (r < 7) {
        hb->keyDown(adp.KEY_ALT, 0);
        int x2 = rnd(w->w);
        int y2 = rnd(w->h - 40) + 36;
        hb->moveTo(wx + x, wy + y);
        hb->buttonDown(1);
        hb->moveTo(wx + x2, wy + y2);
        hb->buttonUp(1);
        hb->keyUp(adp.KEY_ALT, 0);
    } else if (r < 8) {
        hb->keyDown(adp.KEY_CTRL, 0);
        hb->moveTo(wx + x, wy + y);
        hb->buttonDown(1);
        hb->buttonUp(1);
        hb->keyUp(adp.KEY_CTRL, 0);
    } else if (r < 9) {
        hb->moveTo(wx + x, wy + y);
        hb->scroll(rnd(11) - 5);
    } else {
        hb->moveTo(wx + x, wy + y);
        hb->buttonDown(3);
        hb->buttonUp(3);
        hb->tap(adp.KEY_ESCAPE, 27);
    }
    settle();
}

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;       // a click or a key then repaints one row, not the window: much faster under emulation
    gcode.theLook()->matchBrackets = false;
    startServerSized(7358, "t258", 700, 520);
    w = d->createWindow("Fuzz", 520, 360, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    tabs = new gcode.TabBar();
    tabs->addTab("one.a", 1);
    tabs->addTab("two.a", 2);
    fb = new gcode.FindBar(e);
    gui.Box* col = gui.vbox(0, 0);
    col->add(tabs);
    col->add(e);
    col->add(fb);
    w->setRoot(col);
    w->setFocus(e);
    e->doubleClickMs = 100000;
    char* start = "int main() {\n    char* s = \"text\";\n    for (int i = 0; i < 10; i++) {\n        print(s);\n    }\n\treturn 0; // \xc3\xa4\xe2\x82\xac done\n}\n\n// the end\n";
    e->setText(start);
    e->doc->setLanguage(asyntax.Lang.A);
    settle();
    char* original = e->getText();
    int originalLines = e->buf->lineCount();

    // 1. random keys and mouse input, in a window that is resized now and then
    for (int step = 1; step <= 300; step++) {
        int kind = rnd(100);
        if (kind < 60) { randomKey(); }
        else if (kind < 85) { randomMouse(); }
        else if (kind < 88) { w->resize(260 + rnd(300), 200 + rnd(200)); settle(); }
        else if (kind < 90) { e->setWordWrap(!e->wordWrap); settle(); }
        else if (kind < 92) { e->showWhitespace = !e->showWhitespace; e->invalidate(); settle(); }
        else if (kind < 94) {
            char* names = "dark light monokai nord high-contrast";
            int s0 = 0;
            int pick = rnd(5);
            int k = 0;
            int n = strlen(names);
            for (int i = 0; i <= n; i++) {
                if (i == n || names[i] == ' ') {
                    if (k == pick) {
                        char nm[30];
                        memcpy(&nm[0], &names[s0], i - s0);
                        nm[i - s0] = 0;
                        gcode.theLook()->setThemeName(&nm[0]);
                    }
                    k++;
                    s0 = i + 1;
                }
            }
            settle();
        }
        else if (kind < 96) { gcode.theLook()->setFontIndex(rnd(3)); settle(); }
        else if (kind < 98) { fb->open(rnd(2) == 0); fb->setPattern("a"); e->focusMe(); settle(); }
        else { tabs->select(rnd(2)); e->focusMe(); settle(); }
        check(step);
    }
    printf("300 random steps: invalid states %d\n", bad);
    char* t = e->getText();
    printf("the text is valid UTF-8: %d\n", validUtf8(t, e->buf->length()));
    asys.free(t);

    // 2. undo brings everything back (the font, theme, wrap and window changes are not edits)
    e->setWordWrap(false);
    e->ed->clearExtraCursors();
    gcode.theLook()->setFontIndex(0);
    int undos = 0;
    while (e->buf->canUndo() && undos < 5000) {
        e->cmdUndo();
        undos++;
    }
    printf("the random input made at least 20 undo steps: %d\n", undos >= 20);
    char* back = e->getText();
    printf("undone: the text is the original again: %d (%d lines, was %d)\n", streq(back, original), e->buf->lineCount(), originalLines);
    asys.free(back);
    int redos = 0;
    while (e->buf->canRedo() && redos < 5000) {
        e->cmdRedo();
        redos++;
    }
    printf("redo all: steps equal to the undo steps: %d\n", redos == undos);
    check(999);
    printf("final invalid states %d\n", bad);
    return 0;
}
