// ds: IntervalSet (merged integer intervals) and LruCache / TextLruCache against brute force models
import cstdio;
import cstring;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 8086;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// ---- IntervalSet against a bool array over -20 ... 219 -----------------------------------------------------------------------------------
const OFF = 20;
const SPAN = 240;
bool bm[SPAN];

bool inModel(int x) { return x >= -OFF && x < SPAN - OFF && bm[x + OFF]; }

void intervals() {
    ds.IntervalSet s();
    int bad = 0;
    for (int op = 0; op < 20000; op++) {
        int what = rnd(100);
        int lo = rnd(SPAN) - OFF;
        int hi = lo + rnd(30) - 3;
        if (hi > SPAN - OFF - 1) { hi = SPAN - OFF - 1; }          // the model covers -20 ... 219
        if (what < 30) {
            bool ok = s.add(lo, hi);
            if (ok != (lo <= hi)) { bad++; }
            for (int x = lo; x <= hi; x++) { if (x >= -OFF && x < SPAN - OFF) { bm[x + OFF] = true; } }
        } else if (what < 60) {
            bool ok = s.remove(lo, hi);
            if (ok != (lo <= hi)) { bad++; }
            for (int x = lo; x <= hi; x++) { if (x >= -OFF && x < SPAN - OFF) { bm[x + OFF] = false; } }
        } else if (what < 70) {
            if (s.contains(lo) != inModel(lo)) { bad++; }
        } else if (what < 80) {
            bool all = lo <= hi;
            bool any = false;
            for (int x = lo; x <= hi; x++) { if (!inModel(x)) { all = false; } else { any = true; } }
            if (s.covers(lo, hi) != all || s.overlaps(lo, hi) != any) { bad++; }
        } else if (what < 90) {
            int x = lo;
            int want = x;
            while (inModel(want)) { want++; }
            int got = -999999;
            if (!s.nextFree(x, &got) || got != want) { bad++; }
            int want2 = x;
            bool found = false;
            while (want2 < SPAN - OFF) { if (inModel(want2)) { found = true; break; } want2++; }
            int got2 = -999999;
            bool r2 = s.nextMember(x, &got2);
            if (r2 != found || (found && got2 != want2)) { bad++; }
        } else {
            // the whole structure against the model
            int count = 0;
            int len = 0;
            int idx = -1;
            for (int x = -OFF; x < SPAN - OFF; x++) {
                if (inModel(x)) {
                    len++;
                    if (!inModel(x - 1)) { count++; }
                }
            }
            if (s.count() != count || s.length() != len || !s.verify()) { bad++; }
            // list the intervals
            int k = 0;
            int x = -OFF;
            while (x < SPAN - OFF && bad == 0) {
                if (inModel(x) && !inModel(x - 1)) {
                    int e = x;
                    while (inModel(e + 1)) { e++; }
                    if (s.lowAt(k) != x || s.highAt(k) != e || s.indexOf(x) != k || s.indexOf(e) != k) { bad++; }
                    k++;
                    x = e + 1;
                } else {
                    if (!inModel(x) && s.indexOf(x) != -1) { bad++; }
                    x++;
                }
            }
        }
    }
    check(bad == 0, "random add / remove / queries agree with a bool array");
    check(s.verify(), "intervals are sorted, disjoint and not touching");
    s.dispose();
}

void intervalEdges() {
    ds.IntervalSet s();
    check(s.isEmpty() && s.count() == 0 && s.length() == 0 && !s.contains(0) && !s.covers(0, 0) && !s.overlaps(0, 5), "empty set");
    check(!s.add(5, 4) && !s.remove(5, 4), "lo > hi is refused");
    check(s.add(1, 3) && s.add(5, 7) && s.count() == 2 && s.length() == 6, "two intervals");
    check(s.add(4, 4) && s.count() == 1 && s.length() == 7 && s.lowAt(0) == 1 && s.highAt(0) == 7, "an interval that closes the gap merges both");
    check(s.add(8, 8) && s.count() == 1 && s.highAt(0) == 8, "touching intervals merge");
    check(s.add(10, 20) && s.count() == 2, "a gap of one number keeps them apart");
    check(s.remove(9, 9) && s.count() == 2 && s.length() == 8 + 11, "removing a number that is not there");
    check(s.remove(4, 4) && s.count() == 3 && s.length() == 18 && s.contains(3) && !s.contains(4) && s.contains(5), "removing from the middle splits");
    check(s.remove(-100, 100) && s.count() == 0 && s.length() == 0, "removing everything");
    s.add(0, 100);
    s.remove(0, 0);
    check(s.lowAt(0) == 1 && s.length() == 100, "cutting off the front");
    s.remove(100, 100);
    check(s.highAt(0) == 99 && s.length() == 99, "cutting off the end");
    s.add(200, 300); s.add(400, 500);
    s.remove(50, 450);
    check(s.count() == 2 && s.lowAt(0) == 1 && s.highAt(0) == 49 && s.lowAt(1) == 451 && s.highAt(1) == 500 && s.length() == 49 + 50, "a removal that spans intervals");
    s.clear();
    check(s.count() == 0 && s.length() == 0 && s.add(1, 1) && s.length() == 1, "clear");
    // the extremes of the int range
    s.clear();
    int top = 9223372036854775807;
    int bottom = -9223372036854775807 - 1;
    check(s.add(top - 2, top) && s.add(bottom, bottom + 2) && s.count() == 2 && s.length() == 6, "intervals at both ends of the int range");
    check(s.add(top - 5, top - 4) && s.count() == 3 && s.add(top - 3, top - 3) && s.count() == 2 && s.highAt(1) == top && s.lowAt(1) == top - 5, "touching close to the largest int");
    int out = 0;
    check(!s.nextFree(top - 1, &out) && s.nextFree(bottom + 3, &out) && out == bottom + 3 && s.nextFree(bottom, &out) && out == bottom + 3, "nextFree at the ends");
    check(s.contains(top) && s.contains(bottom) && !s.contains(0) && s.covers(top - 5, top) && s.overlaps(bottom + 2, 0), "contains at the ends");
    check(s.remove(bottom, top) && s.count() == 0 && s.length() == 0, "removing the whole int range");
    check(s.add(bottom, top) && s.count() == 1 && s.contains(0) && s.covers(bottom, top), "adding the whole int range");
    s.dispose();
    check(s.count() == 0 && s.add(3, 4) && s.length() == 2, "usable after dispose");
    s.dispose();
}

void intervalBig() {
    // 100000 separate intervals, then merge them with one add: linear, not quadratic
    ds.IntervalSet s();
    for (int i = 0; i < 100000; i++) { s.add(i * 3, i * 3 + 1); }
    check(s.count() == 100000 && s.length() == 200000 && s.verify(), "100000 intervals");
    check(s.add(0, 300000) && s.count() == 1 && s.length() == 300001, "one add merges them all");
    for (int i = 0; i < 100000; i++) { s.remove(i * 3 + 1, i * 3 + 1); }
    check(s.count() == 100001 && s.length() == 200001 && s.verify(), "and a hundred thousand single removals split it again");
    s.dispose();
}

// ---- LruCache against a recency list ------------------------------------------------------------------------------------------------------
int mk[64];
int mv[64];
int mn = 0;                 // index 0 = newest
int evicted[100000];
int evictedVal[100000];
int ne = 0;

int mfind(int key) { for (int i = 0; i < mn; i++) { if (mk[i] == key) { return i; } } return -1; }
void mtouch(int i) {
    int k = mk[i]; int v = mv[i];
    for (int j = i; j > 0; j--) { mk[j] = mk[j - 1]; mv[j] = mv[j - 1]; }
    mk[0] = k; mv[0] = v;
}
void mdropOldest() {
    evicted[ne] = mk[mn - 1]; evictedVal[ne] = mv[mn - 1]; ne++;
    mn--;
}

int handler(int key, int val, int ctx) {
    int* log = (int*) ctx;
    log[0]++;
    log[1] = log[1] * 31 + key;
    log[2] = log[2] * 31 + val;
    return 0;
}

void lru() {
    int cap = 10;
    ds.LruCache c(cap);
    int log[3];
    log[0] = 0; log[1] = 0; log[2] = 0;
    c.setEvictHandler(handler, (int) &log[0]);
    int bad = 0;
    int hits = 0;
    int misses = 0;
    int evictions = 0;
    int mlog1 = 0;
    int mlog2 = 0;
    int mcount = 0;
    for (int op = 0; op < 30000; op++) {
        int what = rnd(100);
        int k = rnd(25);
        if (what < 40) {
            int v = rnd(1000);
            int i = mfind(k);
            if (i >= 0) { mv[i] = v; mtouch(i); }
            else {
                if (mn == cap) {
                    mlog1 = mlog1 * 31 + mk[mn - 1]; mlog2 = mlog2 * 31 + mv[mn - 1]; mcount++;
                    mn--;
                    evictions++;
                }
                for (int j = mn; j > 0; j--) { mk[j] = mk[j - 1]; mv[j] = mv[j - 1]; }
                mk[0] = k; mv[0] = v; mn++;
            }
            if (!c.put(k, v)) { bad++; }
        } else if (what < 75) {
            int i = mfind(k);
            int got = c.get(k, -1);
            if (i >= 0) { hits++; if (got != mv[i]) { bad++; } mtouch(i); } else { misses++; if (got != -1) { bad++; } }
        } else if (what < 85) {
            int i = mfind(k);
            int before = c.hits + c.misses;
            if (c.peek(k, -1) != ((i >= 0) ? mv[i] : -1) || c.has(k) != (i >= 0) || c.hits + c.misses != before) { bad++; }
        } else if (what < 93) {
            int i = mfind(k);
            bool r = c.remove(k);
            if (r != (i >= 0)) { bad++; }
            if (i >= 0) {
                mlog1 = mlog1 * 31 + mk[i]; mlog2 = mlog2 * 31 + mv[i]; mcount++;
                for (int j = i; j < mn - 1; j++) { mk[j] = mk[j + 1]; mv[j] = mv[j + 1]; }
                mn--;
            }
        } else {
            if (c.size() != mn || !c.verify()) { bad++; }
            // order from the newest
            int t = c.newest();
            for (int i = 0; i < mn; i++) {
                if (t < 0 || c.keyAt(t) != mk[i] || c.valueAt(t) != mv[i]) { bad++; break; }
                t = c.olderThan(t);
            }
            if (t != -1) { bad++; }
            if (mn > 0 && (c.keyAt(c.oldest()) != mk[mn - 1])) { bad++; }
        }
    }
    check(bad == 0, "random operations agree with a recency list");
    check(c.hits == hits && c.misses == misses && c.evictions == evictions, "statistics");
    check(log[0] == mcount && log[1] == mlog1 && log[2] == mlog2, "the evict handler saw every leaving entry in order");
    // shrinking evicts the oldest entries
    int sizeBefore = c.size();
    int oldestKey = c.keyAt(c.oldest());
    c.setCapacity(3);
    check(c.size() == 3 && c.capacity() == 3 && (sizeBefore <= 3 || !c.has(oldestKey)) && c.verify(), "setCapacity evicts the oldest entries");
    c.setCapacity(50);
    for (int i = 0; i < 60; i++) { c.put(1000 + i, i); }
    check(c.size() == 50 && c.verify() && c.has(1059) && !c.has(1009) && c.has(1010), "growing the capacity again");
    int leaving = log[0];
    c.clear();
    check(c.size() == 0 && c.newest() == -1 && c.oldest() == -1 && log[0] == leaving + 50, "clear calls the handler for every entry");
    c.dispose();
}

void lruEdges() {
    ds.LruCache c(0);
    check(!c.put(1, 2) && c.size() == 0 && c.get(1, 9) == 9, "capacity 0 stores nothing");
    ds.LruCache one(1);
    one.put(1, 10); one.put(2, 20);
    check(one.size() == 1 && !one.has(1) && one.get(2, 0) == 20 && one.evictions == 1, "capacity 1");
    one.put(2, 21);
    check(one.get(2, 0) == 21 && one.evictions == 1, "replacing a value is not an eviction");
    // get refreshes: the entry that was just read survives
    ds.LruCache three(3);
    three.put(1, 1); three.put(2, 2); three.put(3, 3);
    three.get(1, 0);
    three.put(4, 4);
    check(three.has(1) && !three.has(2) && three.has(3) && three.has(4), "get makes an entry the newest");
    ds.LruCache p(2);
    p.put(1, 1); p.put(2, 2);
    p.peek(1, 0);
    p.put(3, 3);
    check(!p.has(1) && p.has(2) && p.has(3), "peek leaves the order alone");
    // a big cache: growth is lazy
    ds.LruCache big(1000000);
    for (int i = 0; i < 50000; i++) { big.put(i, i); }
    check(big.size() == 50000 && big.get(49999, -1) == 49999 && big.verify(), "a cache with a huge capacity grows only as needed");
    // eviction in a loop: constant memory
    ds.LruCache loop(100);
    int mem0 = asys.memInUse();
    for (int i = 0; i < 200000; i++) { loop.put(i, i); }
    check(loop.size() == 100 && loop.evictions == 199900 && loop.has(199999) && !loop.has(199899), "200000 puts into a cache of 100");
    int mem1 = asys.memInUse();
    for (int i = 0; i < 200000; i++) { loop.put(i + 500000, i); }
    check(asys.memInUse() == mem1 && mem1 > mem0 - 1, "eviction in a loop runs in constant memory");
    c.dispose(); one.dispose(); three.dispose(); p.dispose(); big.dispose(); loop.dispose();
}

int gcount = 0;
int textHandler(int key, int val, int ctx) {
    char* k = (char*) key;
    if (streq(k, "a")) { gcount = gcount + val; }
    return 0;
}

void textLru() {
    ds.TextLruCache t(3);
    t.setEvictHandler(textHandler, 0);
    char key[16];
    strcpy(&key[0], "a");
    t.put(&key[0], 100);
    strcpy(&key[0], "b");
    t.put(&key[0], 2);
    t.put("c", 3);
    strcpy(&key[0], "zz");
    check(t.get("a", 0) == 100 && t.has("b") && !t.has("zz"), "keys are copied");
    t.put("d", 4);                                        // b is the oldest: a was just read
    check(!t.has("b") && t.has("a") && t.has("c") && t.has("d") && t.evictions() == 1 && gcount == 0, "text eviction");
    t.put("e", 5); t.put("f", 6); t.put("g", 7);          // a leaves
    check(!t.has("a") && gcount == 100 && t.size() == 3 && t.verify(), "the handler gets the text key");
    check(streq(t.keyAt(t.newest()), "g") && streq(t.keyAt(t.oldest()), "e") && t.valueAt(t.newest()) == 7, "iteration with texts");
    check(t.remove("e") && !t.remove("e") && t.size() == 2, "remove");
    check(t.hits() >= 1 && t.misses() == 0, "statistics");
    t.dispose();
    check(t.size() == 0, "disposed");
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.IntervalSet s();
    ds.LruCache c(1000);
    ds.TextLruCache t(500);
    char key[16];
    for (int i = 0; i < 5000; i++) {
        s.add(i * 5, i * 5 + 1);
        c.put(i, i);
        format(&key[0], 16, "key%d", i);
        t.put(&key[0], i);
    }
    s.dispose(); c.dispose(); t.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees everything, text keys included");
}

int main() {
    intervals();
    intervalEdges();
    intervalBig();
    lru();
    lruEdges();
    textLru();
    memory();
    printf("intervals and lru: %d checks, %d failures\n", checks, fails);
    return fails;
}
