// optim: interpolation: piecewise linear, cubic splines (natural and clamped, with derivatives and exact integrals), barycentric Lagrange interpolation and Chebyshev
// approximation. Expected output: tests/algo2_ref/gen_t458.py (splines and Lagrange polynomials solved exactly with fractions, Chebyshev against the function in 60 digit decimals).
import cstdio;
import asys;
import optim;
import dmath;

double fExpCos(double x, void* c) { return dmath.exp(x) * dmath.cos(3.0 * x); }
double fPoly(double x, void* c) { return 3.0 * x * x * x * x * x - 2.0 * x * x + 1.0; }
double fNan(double x, void* c) { return (x > 0.5) ? dmath.nan() : x; }
double fAbs(double x, void* c) { return dmath.fabs(x); }

bool isNan(double v) { return v != v; }

void pv(char* name, double v) {
    printf("%s", name);
    printfd(" %.12g\n", __bits(v));
}

int main() {
    int base = asys.memInUse();
    double xs[6] = {0.0, 1.0, 2.5, 3.0, 4.5, 6.0};
    double ys[6] = {1.0, 3.0, 2.0, 5.0, 4.0, 0.5};
    double qs[9] = {-1.0, 0.0, 0.4, 1.0, 1.7, 2.75, 4.5, 5.9, 7.0};

    // ---- linear
    printf("linear interpolation:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(optim.interpLinear(xs, ys, 6, qs[i]))); }
    printf("\n");
    printfd("one point: %g, ", __bits(optim.interpLinear(xs, ys, 1, 100.0)));
    printf("empty: %d, NaN query: %d\n", optim.interpLinear(xs, ys, 0, 1.0) != optim.interpLinear(xs, ys, 0, 1.0), isNan(optim.interpLinear(xs, ys, 6, dmath.nan())));

    // ---- natural spline
    optim.Spline nat(xs, ys, 6, optim.SPLINE_NATURAL, 0.0, 0.0);
    printf("natural spline: ok %d, n %d\n", nat.ok(), nat.n);
    printf("values:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(nat.value(qs[i]))); }
    printf("\nfirst derivatives:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(nat.derivative(qs[i], 1))); }
    printf("\nsecond derivatives:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(nat.derivative(qs[i], 2))); }
    printf("\nthird derivatives:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(nat.derivative(qs[i], 3))); }
    printf("\n");
    printf("passes through the data: ");
    bool through = true;
    for (int i = 0; i < 6; i++) { if (dmath.fabs(nat.value(xs[i]) - ys[i]) > 1.0e-13) { through = false; } }
    printf("%d, natural ends (second derivative 0): %d\n", through, dmath.fabs(nat.derivative(0.0, 2)) < 1.0e-13 && dmath.fabs(nat.derivative(6.0, 2)) < 1.0e-13);
    // continuity of the first and second derivative at the inner knots
    bool smooth = true;
    for (int i = 1; i < 5; i++) {
        double h = 1.0e-9;
        if (dmath.fabs(nat.derivative(xs[i] - h, 1) - nat.derivative(xs[i] + h, 1)) > 1.0e-6) { smooth = false; }
        if (dmath.fabs(nat.derivative(xs[i] - h, 2) - nat.derivative(xs[i] + h, 2)) > 1.0e-6) { smooth = false; }
    }
    printf("first and second derivative are continuous at the knots: %d\n", smooth);
    pv("integral 0 .. 6", nat.integral(0.0, 6.0));
    pv("integral 1.2 .. 4", nat.integral(1.2, 4.0));
    pv("integral 4 .. 1.2 (reversed)", nat.integral(4.0, 1.2));
    pv("integral -1 .. 7 (with extrapolation)", nat.integral(-1.0, 7.0));
    printf("additivity: %d\n", dmath.fabs(nat.integral(0.5, 2.0) + nat.integral(2.0, 5.5) - nat.integral(0.5, 5.5)) < 1.0e-12);
    printf("derivative order 0 and 4 are NaN: %d %d\n", isNan(nat.derivative(1.0, 0)), isNan(nat.derivative(1.0, 4)));
    nat.dispose();
    printf("after dispose: ok %d, value is NaN %d\n", nat.ok(), isNan(nat.value(1.0)));

    // ---- clamped spline
    optim.Spline cl(xs, ys, 6, optim.SPLINE_CLAMPED, 1.5, -2.0);
    printf("clamped spline values:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(cl.value(qs[i]))); }
    printfd("\nend slopes: %g %g\n", __bits(cl.derivative(0.0, 1)), __bits(cl.derivative(6.0, 1)));
    pv("clamped integral 0 .. 6", cl.integral(0.0, 6.0));
    cl.dispose();
    // two points: natural is a line, clamped is a cubic Hermite interpolant
    double x2[2] = {1.0, 3.0};
    double y2[2] = {2.0, 8.0};
    optim.Spline l2(x2, y2, 2, optim.SPLINE_NATURAL, 0.0, 0.0);
    printfd("natural spline through 2 points is the line: %.12g %.12g %.12g\n", __bits(l2.value(1.0)), __bits(l2.value(2.0)), __bits(l2.value(5.0)));
    optim.Spline h2(x2, y2, 2, optim.SPLINE_CLAMPED, 0.0, 0.0);
    printfd("clamped spline through 2 points with zero slopes: %.12g %.12g %.12g\n", __bits(h2.value(1.0)), __bits(h2.value(2.0)), __bits(h2.value(3.0)));
    pv("  and its integral", h2.integral(1.0, 3.0));
    l2.dispose();
    h2.dispose();
    // a spline reproduces a cubic exactly when it is clamped with the exact end slopes
    {
        double cx[7];
        double cy[7];
        for (int i = 0; i < 7; i++) {
            cx[i] = (double) i * 0.5;
            cy[i] = cx[i] * cx[i] * cx[i] - 2.0 * cx[i] + 1.0;
        }
        optim.Spline c(cx, cy, 7, optim.SPLINE_CLAMPED, -2.0, 25.0);
        double worst = 0.0;
        for (int i = 0; i < 60; i++) {
            double x = (double) i * 0.05;
            worst = dmath.fmax(worst, dmath.fabs(c.value(x) - (x * x * x - 2.0 * x + 1.0)));
        }
        printf("clamped spline with the exact end slopes reproduces a cubic (1e-13): %d\n", worst < 1.0e-13);
        c.dispose();
    }
    // invalid input
    {
        double ux[4] = {0.0, 2.0, 1.0, 3.0};
        double uy[4] = {1.0, 2.0, 3.0, 4.0};
        double dx[4] = {0.0, 1.0, 1.0, 3.0};
        double ny[4] = {1.0, dmath.nan(), 3.0, 4.0};
        optim.Spline e1(ux, uy, 4, optim.SPLINE_NATURAL, 0.0, 0.0);
        optim.Spline e2(dx, uy, 4, optim.SPLINE_NATURAL, 0.0, 0.0);
        optim.Spline e3(xs, ys, 1, optim.SPLINE_NATURAL, 0.0, 0.0);
        optim.Spline e4(xs, ny, 4, optim.SPLINE_NATURAL, 0.0, 0.0);
        optim.Spline e5(null, ys, 4, optim.SPLINE_NATURAL, 0.0, 0.0);
        optim.Spline e6(xs, ys, 6, 7, 0.0, 0.0);
        printf("not increasing: %d, duplicate x: %d, one point: %d, NaN y: %d, null: %d, unknown boundary: %d (ERR_ARG = %d)\n", e1.err, e2.err, e3.err, e4.err, e5.err, e6.err, optim.ERR_ARG);
    }

    // ---- barycentric Lagrange
    optim.Barycentric b(xs, ys, 6);
    printf("lagrange:");
    for (int i = 0; i < 9; i++) { printfd(" %.12g", __bits(b.value(qs[i]))); }
    printf("\n");
    printf("exact at the nodes: %d\n", b.value(0.0) == 1.0 && b.value(2.5) == 2.0 && b.value(6.0) == 0.5);
    b.dispose();
    {
        // Runge's function with equispaced and Chebyshev nodes: the equispaced polynomial of degree 20 is far worse
        double ex[21];
        double ey[21];
        double cx[21];
        double cy[21];
        optim.chebyshevNodes(21, -1.0, 1.0, cx);
        for (int i = 0; i < 21; i++) {
            ex[i] = -1.0 + 0.1 * (double) i;
            ey[i] = 1.0 / (1.0 + 25.0 * ex[i] * ex[i]);
            cy[i] = 1.0 / (1.0 + 25.0 * cx[i] * cx[i]);
        }
        optim.Barycentric eq(ex, ey, 21);
        optim.Barycentric ch(cx, cy, 21);
        double worstEq = 0.0;
        double worstCh = 0.0;
        for (int i = 0; i <= 200; i++) {
            double x = -1.0 + 0.01 * (double) i;
            double f = 1.0 / (1.0 + 25.0 * x * x);
            worstEq = dmath.fmax(worstEq, dmath.fabs(eq.value(x) - f));
            worstCh = dmath.fmax(worstCh, dmath.fabs(ch.value(x) - f));
        }
        printf("Runge's function, degree 20: equispaced error above 1 %d, Chebyshev nodes error below 0.1 %d\n", worstEq > 1.0, worstCh < 0.1);
        eq.dispose();
        ch.dispose();
        double dup[3] = {1.0, 2.0, 1.0};
        double dy[3] = {1.0, 2.0, 3.0};
        optim.Barycentric e1(dup, dy, 3);
        double nx[3] = {1.0, dmath.nan(), 3.0};
        optim.Barycentric e2(nx, dy, 3);
        optim.Barycentric e3(null, dy, 3);
        optim.Barycentric e4(xs, ys, 0);
        optim.Barycentric one(xs, ys, 1);
        printf("duplicate nodes: %d, NaN node: %d, null: %d, n = 0: %d (ERR_ARG = %d); a single node is constant: %d\n", e1.err, e2.err, e3.err, e4.err, optim.ERR_ARG, one.value(5.0) == 1.0);
        printf("NaN query: %d\n", isNan(one.value(dmath.nan())));
        one.dispose();
    }

    // ---- Chebyshev approximation
    {
        double nodes[5];
        optim.chebyshevNodes(5, -1.0, 1.0, nodes);
        printf("chebyshevNodes(5) on -1 .. 1:");
        for (int i = 0; i < 5; i++) { printfd(" %.12g", __bits(nodes[i])); }
        printf("\n");
        double n3[3];
        optim.chebyshevNodes(3, 2.0, 10.0, n3);
        printf("three nodes on 2 .. 10:");
        for (int i = 0; i < 3; i++) { printfd(" %.12g", __bits(n3[i])); }
        printf("\n");
        printf("invalid: n = 0 %d, null %d, a >= b is not tested here\n", optim.chebyshevNodes(0, 0.0, 1.0, nodes), optim.chebyshevNodes(3, 0.0, 1.0, null));
        optim.Chebyshev c(fExpCos, null, 0.0, 2.0, 24);
        printf("e^x cos(3x) on 0 .. 2 with 24 terms: ok %d\n", c.ok());
        double pts[6] = {0.0, 0.1, 0.7, 1.3, 1.9, 2.0};
        printf("values:");
        for (int i = 0; i < 6; i++) { printfd(" %.12g", __bits(c.value(pts[i]))); }
        printf("\nderivatives:");
        for (int i = 0; i < 6; i++) { printfd(" %.10g", __bits(c.derivative(pts[i]))); }
        printf("\n");
        pv("integral over 0 .. 2", c.integral());
        printf("outside the interval the polynomial continues: value at 2.1 is finite %d, at 2.1 within 1e-3 of the function: %d\n", !isNan(c.value(2.1)), dmath.fabs(c.value(2.1) - fExpCos(2.1, null)) < 1.0e-3);
        pv("coefficient 0", c.coefficient(0));
        printf("coefficient 30 is NaN: %d\n", isNan(c.coefficient(30)));
        c.dispose();
        // a polynomial of degree 5 is represented exactly by 6 terms
        optim.Chebyshev p(fPoly, null, -1.0, 1.0, 6);
        printf("3x^5 - 2x^2 + 1 with 6 terms:");
        for (int j = 0; j < 6; j++) { printfd(" %.9g", __bits((dmath.fabs(p.coefficient(j)) < 1.0e-12) ? 0.0 : p.coefficient(j))); }
        printf("\n");
        pv("  integral over -1 .. 1", p.integral());
        printf("  value at 0.37 within 1e-14 of the polynomial: %d\n", dmath.fabs(p.value(0.37) - fPoly(0.37, null)) < 1.0e-14);
        printfd("  derivative at 0.37 (exact 15 x^4 - 4 x): %.10g\n", __bits(p.derivative(0.37)));
        p.dispose();
        // one term is a constant, and the approximation of |x| converges slowly but converges
        optim.Chebyshev one(fPoly, null, -1.0, 1.0, 1);
        printfd("one term: derivative %g, value %.12g, half of coefficient 0 is %.12g\n", __bits(one.derivative(0.3)), __bits(one.value(0.5)), __bits(0.5 * one.coefficient(0)));
        one.dispose();
        optim.Chebyshev a(fAbs, null, -1.0, 1.0, 40);
        printf("|x| with 40 terms: error at 0.5 below 1e-3 %d, error at 0 above 1e-3 (kink): %d\n", dmath.fabs(a.value(0.5) - 0.5) < 1.0e-3, dmath.fabs(a.value(0.0)) > 1.0e-3);
        a.dispose();
        optim.Chebyshev e1(fNan, null, 0.0, 1.0, 10);
        optim.Chebyshev e2(fPoly, null, 1.0, 0.0, 10);
        optim.Chebyshev e3(fPoly, null, 0.0, 1.0, 0);
        optim.Chebyshev e4(fPoly, null, 0.0, dmath.INFINITY, 10);
        printf("NaN function: %d (ERR_NAN = %d), a > b: %d, zero terms: %d, infinite interval: %d (ERR_ARG = %d)\n", e1.err, optim.ERR_NAN, e2.err, e3.err, e4.err, optim.ERR_ARG);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
