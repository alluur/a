// thread: real threads on Linux / Android (the same results from the sequential fallback on Windows)
import thread;
import cpu;

int counter;
int locked;
int guard;
int squares[100];
int results[8];

int worker(int n) {
    for (int i = 0; i < 2000; i++) {
        cpu.atomicAdd(&counter, 1);
    }
    return n * 10;
}

int lockedWorker(int n) {
    for (int i = 0; i < 500; i++) {
        cpu.lock(&guard);
        locked = locked + 1;                  // not atomic by itself: the lock protects it
        cpu.unlock(&guard);
    }
    return 0;
}

int square(int i) {
    squares[i] = i * i;
    return 0;
}

int sleeper(int ms) {
    sleepMs(ms);
    return ms;
}

int main() {
    thread.Thread* ts[6];
    for (int i = 0; i < 6; i++) ts[i] = thread.spawn(worker, i);
    int sum = 0;
    for (int i = 0; i < 6; i++) sum = sum + thread.join(ts[i]);
    printlnInt(sum);                          // 0 + 10 + ... + 50
    printlnInt(counter);                      // 6 * 2000, no update lost

    for (int i = 0; i < 4; i++) ts[i] = thread.spawn(lockedWorker, i);
    for (int i = 0; i < 4; i++) thread.join(ts[i]);
    printlnInt(locked);                       // 2000

    thread.parallelFor(100, square, 4);
    int total = 0;
    for (int i = 0; i < 100; i++) total = total + squares[i];
    printlnInt(total);                        // 328350
    printlnInt(squares[99]);

    thread.Thread* s = thread.spawn(sleeper, 50);
    printlnInt(thread.join(s));
    printlnInt(thread.finished(s));
    printlnInt(thread.join(s));               // joining twice gives the same result
    printlnInt(thread.cpuCount() >= 1);
    printlnInt(thread.currentId() >= 0);
    printlnInt(thread.supported() || __OS == 1);
    return 0;
}
