// Dialogs that are opened and closed again leave nothing behind: the theme editor's preview document is disposed (it was registered in
// the shared completer and offered its sample words to every editor), the widgets of a closed window are forgotten by the Look, a dialog
// can be shown again, gui.Window.onClosed runs once, CodeEditor.setLook / dispose move and release the registrations.
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

int closedCount = 0;
int onClosedCb(int w) { closedCount++; return 0; }

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;
    startServerSized(7363, "t263", 1600, 1000);
    gcode.Look* look = gcode.theLook();
    gui.Window* w = d->createWindow("Editor", 520, 260, 0);
    gcode.CodeEditor* e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    settle();
    int docs0 = gcode.docCount();
    int users0 = look->userCount();
    printf("start: documents %d, look users %d\n", docs0, users0);

    // the theme editor: 4 times; the preview editor, its document and the extra Looks go away with the window
    gcode.ThemeEditor* te = new gcode.ThemeEditor();
    for (int i = 0; i < 4; i++) {
        gui.Window* tw = te->show(d);
        settle();
        if (i == 0) { printf("theme editor open: documents %d (one more for the preview)\n", gcode.docCount() - docs0); }
        if (i % 2 == 0) { te->close(); } else { tw->close(); }     // both ways of closing
        settle();
    }
    printf("after 4 theme editors: documents %d -> %d\n", docs0, gcode.docCount());
    look->setThemeName("light");
    look->setThemeName("dark");
    settle();
    printf("after a theme change: look users grew by at most 2: %d\n", look->userCount() <= users0 + 2);

    // the completer knows only the words of the open documents: the sample code of the preview is gone
    w->setFocus(e);
    e->setText("Coun");
    e->ed->setCursor(4);
    settle();
    ctrl(' ');
    printf("completion for Coun after the theme editor: %d candidates (the sample code has Counter)\n", e->completionCount());
    key(adp.KEY_ESCAPE, 27);

    // a new theme editor object works too, and the shared theme still follows it
    gcode.ThemeEditor* te2 = new gcode.ThemeEditor();
    te2->show(d);
    settle();
    te2->loadTheme("light");
    settle();
    printf("second editor object: theme %s, editor draws with %s\n", te2->currentName, look->theme->name);
    te2->close();
    settle();
    look->setThemeName("dark");
    te2->setEntry(0, 0xFF102030, 0);          // the dialog is closed: a call that still comes (a callback) is harmless
    printf("after close: documents %d, setEntry did not crash\n", gcode.docCount());

    // the settings dialog
    for (int i = 0; i < 3; i++) {
        atheme.Settings* st = new atheme.Settings();
        gcode.SettingsDialog* sd = new gcode.SettingsDialog(st);
        sd->show(d);
        settle();
        sd->close();
        settle();
    }
    look->setThemeName("light");
    look->setThemeName("dark");
    printf("after 3 settings dialogs: documents %d, look users at most %d: %d\n", gcode.docCount(), users0 + 3, look->userCount() <= users0 + 3);

    // gui.Window.onClosed: once, whichever way the window is closed
    gui.Window* w2 = d->createWindow("Second", 200, 100, 0);
    w2->onClosed = onClosedCb;
    w2->close();
    w2->close();
    settle();
    printf("onClosed ran %d time\n", closedCount);

    // an editor that moves to another Look and is disposed
    gcode.Look* other = new gcode.Look();
    other->setThemeName("light");
    gui.Window* w3 = d->createWindow("Third", 300, 120, 0);
    gcode.CodeEditor* e3 = new gcode.CodeEditor();
    gui.Box* c3 = gui.vbox(0, 0);
    c3->add(e3);
    w3->setRoot(c3);
    settle();
    int shared = look->userCount();
    e3->setLook(other);
    printf("setLook: users of the shared look %d -> %d, of the other look %d\n", shared, look->userCount(), other->userCount());
    e3->setLook(other);
    printf("the same look again changes nothing: %d\n", other->userCount());
    gcode.Doc* dd = e3->doc;
    e3->setFindHighlight("x", 0);
    e3->dispose();
    printf("dispose: users of the other look %d, find highlight %d\n", other->userCount(), e3->hasFindHighlight());
    int docs1 = gcode.docCount();
    dd->dispose();
    printf("the document is disposed by its owner: %d -> %d\n", docs1, gcode.docCount());
    e3->dispose();                              // twice is fine
    other->setThemeName("dark");
    settle();
    w3->close();
    w->close();
    return 0;
}
