// http: gzip and deflate response bodies are unpacked, the client can ask for them, the server can send them
import http;
import net;
import zlib;
import cstring;

int main() {
    char* text = "compress me, compress me, compress me, compress me, compress me, compress me!";
    int n = strlen(text);
    int server = net.listenOn("127.0.0.1", 0, 8);          // a free port: no other process can be in the way
    if (server < 0) {
        println("listen failed");
        return 1;
    }
    int port = net.localPort(server);
    for (int mode = 0; mode < 3; mode++) {
        http.setCompression(mode != 0);
        int client = net.connect("127.0.0.1", port);
        http.sendRequest(client, "GET", "localhost", "/", "", null, 0);
        int conn = net.accept(server);
        http.Request* q = new http.Request();
        http.readRequest(conn, q);
        char* ae = q->header("Accept-Encoding");
        printf("mode %d: client asked for gzip: %d\n", mode, ae != null);
        if (mode == 2) {
            int zn;
            char* z = zlib.compress(text, n, &zn);
            char head[200];
            format(&head[0], 200, "HTTP/1.1 200 OK\r\nContent-Encoding: deflate\r\nContent-Length: %d\r\nConnection: close\r\n\r\n", zn);
            net.sendText(conn, &head[0]);
            net.send(conn, z, zn);
        } else {
            http.respondGzip(conn, 200, "text/plain", text, n);
        }
        net.close(conn);
        http.Response* r = http.readResponse(client);
        printf("status %d, body %d bytes, same %d, header %s\n", r->status, r->bodyLen, r->bodyLen == n && strcmp(r->body, text) == 0, r->header("Content-Encoding"));
        net.close(client);
    }
    net.close(server);
    return 0;
}
