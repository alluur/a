// tuix: TextPane - appending (partial lines, \r\n), colours, following the end, scrolling, clicks, the line limit
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
tuix.TextPane* tp;
int clicks;
int activates;

int onClick(int p) { clicks++; return 0; }
int onActivate(int p) { activates++; return 0; }

void state(char* what) {
    char* screen = app->text();
    printf("-- %s (lines %d, top %d, follow %d)\n", what, tp->lineCount(), tp->top, tp->follow);
    println(screen);
}

int main() {
    app = new tui.App();
    app->initHeadless(24, 6);
    tui.Box* col = tui.vbox(0, 0);
    tp = new tuix.TextPane();
    tp->flex = 1;
    tp->onLineClick = onClick;
    tp->onLineActivate = onActivate;
    col->add(tp);
    app->setRoot(col);
    app->pump(0);
    app->press("Tab");

    println("-- partial lines are shown until the newline arrives");
    tp->append("hello ");
    state("partial");
    tp->append("world\nsecond line\r\nthird");
    state("two complete lines and a partial one");
    tp->append(" line\n");
    state("completed");
    printf("line 1: '%s'\n", tp->lineText(1));

    println("-- colours: ANSI sequences set styles, the text stays plain");
    tp->clear();
    tp->append("plain \e[31mred\e[0m \e[1;32mgreen\e[22m\e[39m \e[44mblue\e[0m end\n");
    state("coloured line");
    int base = tui.theme->text;
    printf("'red' is red: %d, plain stays plain: %d\n", tscreen.fgOf(app->screen->styleAt(6, 0)) == tscreen.RED, app->screen->styleAt(0, 0) == base);
    printf("'green' is green and bold: %d %d\n", tscreen.fgOf(app->screen->styleAt(10, 0)) == tscreen.GREEN, (tscreen.attrOf(app->screen->styleAt(10, 0)) & tscreen.A_BOLD) != 0);
    printf("'blue' has a blue background: %d, the space after 'green' is plain again: %d\n", tscreen.bgOf(app->screen->styleAt(16, 0)) == tscreen.BLUE, app->screen->styleAt(15, 0) == base);
    printf("'end' is back to normal: %d\n", app->screen->styleAt(21, 0) == base);
    tp->append("\e[38;5;208morange\e[0m \e[38;2;1;2;3mtruecolor\e[0m \e[2Jjunk \e[?25l\e[Kmore\n");
    println(app->text());
    printf("256: %x, truecolor: %x\n", tscreen.fgOf(app->screen->styleAt(0, 1)), tscreen.fgOf(app->screen->styleAt(10, 1)));
    tp->ansi = false;
    println("-- with ansi off the escape characters are skipped but colours are not applied");
    tp->append("\e[31mnot red\e[0m\n");
    println(app->text());
    tp->ansi = true;

    println("-- tabs and wide characters");
    tp->clear();
    tp->append("a\tb\tc\n\xe4\xb8\x96\xe7\x95\x8c" "x\ncaf\xc3\xa9\n");
    state("tabs expand to 8 columns");

    println("-- following the end, scrolling away, coming back");
    tp->clear();
    for (int i = 1; i <= 20; i++) {
        char buf[20];
        format(&buf[0], 20, "line %d", i, 0, 0, 0);
        tp->appendLine(&buf[0]);
    }
    state("20 lines, the end is shown");
    app->press("Up");
    app->press("Up");
    state("scrolled up two lines: follow is off");
    tp->appendLine("line 21");
    printf("new text does not move the view: top %d\n", tp->top);
    app->press("End");
    state("End jumps to the end and follows again");
    app->press("PgUp");
    printf("PgUp: top %d\n", tp->top);
    app->press("Home");
    printf("Home: top %d\n", tp->top);
    app->press("PgDn");
    printf("PgDn: top %d\n", tp->top);
    app->wheel(5, 2, false);
    printf("wheel down 3: top %d\n", tp->top);
    app->wheel(5, 2, true);
    app->wheel(5, 2, true);
    printf("wheel up 6: top %d\n", tp->top);
    app->press("End");

    println("-- clicks and activation");
    app->click(2, 1);
    printf("clicked line %d, callbacks %d\n", tp->clickedLine, clicks);
    printf("text of the line: %s\n", tp->lineText(tp->clickedLine));
    app->advanceClock(1000);
    app->click(2, 3);
    app->click(2, 3);
    printf("double click: line %d, activates %d\n", tp->clickedLine, activates);
    tp->selectable = true;
    app->advanceClock(1000);
    app->click(2, 2);
    printf("selectable: selected line %d\n", tp->selLine);
    app->press("Down");
    printf("Down moves the selection: %d\n", tp->selLine);
    app->press("Enter");
    printf("Enter activates: %d\n", activates);
    for (int i = 0; i < 8; i++) { app->press("Down"); }
    printf("the view followed the selection: top %d, selected %d\n", tp->top, tp->selLine);
    tp->selectable = false;

    println("-- sideways scrolling");
    tp->clear();
    tp->append("0123456789012345678901234567890123456789\n");
    app->press("Right");
    println(app->text());
    app->press("Left");
    app->press("Left");
    printf("hscroll %d\n", tp->hscroll);

    println("-- scroll bar: drag");
    tp->clear();
    for (int i = 1; i <= 30; i++) {
        char buf[20];
        format(&buf[0], 20, "row %d", i, 0, 0, 0);
        tp->appendLine(&buf[0]);
    }
    app->advanceClock(1000);
    app->mouseDown(23, 3);
    app->mouseDrag(23, 0);
    app->mouseUp(23, 0);
    printf("dragged to the top: top %d, follow %d\n", tp->top, tp->follow);

    println("-- the line limit: the oldest lines are dropped");
    tp->clear();
    tp->maxLines = 100;
    for (int i = 1; i <= 250; i++) {
        char buf[20];
        format(&buf[0], 20, "n%d", i, 0, 0, 0);
        tp->appendLine(&buf[0]);
    }
    printf("lines kept: %d (at most 100), the newest: %s, the oldest kept: %s\n", tp->lineCount(), tp->lineText(tp->lineCount() - 1), tp->lineText(0));
    println(app->text());
    println("-- a long stream in small pieces");
    tp->clear();
    tp->maxLines = 5000;
    for (int i = 0; i < 2000; i++) {
        tp->append("ab");
        tp->append("cd\nxyz");
        tp->append("\n");
    }
    printf("lines: %d, first '%s', last '%s'\n", tp->lineCount(), tp->lineText(0), tp->lineText(tp->lineCount() - 1));
    return 0;
}
