// stats and optim: null pointers, null callbacks, empty and zeroed objects, NaN and infinity in data and in callbacks, absurd sizes. Nothing may crash or hang; every answer must be the
// documented one (NaN, an error status, or a refusal). Several of these cases crashed before the review of the modules (marked "was a crash"); they stay here as regression tests.
// Self describing checks: each prints  label: ok  or  FAIL label ...; the expectations are the contracts in the headers of lib/stats.a and lib/optim.a.
import cstdio;
import asys;
import stats;
import optim;
import matrix;
import rng;
import dmath;

int fails = 0;
int checks = 0;

void expectInt(char* label, int got, int want) {
    checks++;
    if (got == want) { printf("%s: ok\n", label); return; }
    fails++;
    printf("FAIL %s: got %d, want %d\n", label, got, want);
}

void expectBool(char* label, bool got, bool want) { expectInt(label, got ? 1 : 0, want ? 1 : 0); }

void expectNan(char* label, double v) {
    checks++;
    if (v != v) { printf("%s: ok\n", label); return; }
    fails++;
    printfd("FAIL %s: got %.9g, want NaN\n", label, __bits(v));
}

void expectNear(char* label, double got, double want, double tol) {
    checks++;
    double e = got - want;
    if (e < 0.0) { e = -e; }
    if (e <= tol) { printf("%s: ok\n", label); return; }
    fails++;
    printfd("FAIL %s: got %.12g, want %.12g\n", label, __bits(got), __bits(want));
}

double fSquare(double x, void* c) { return x * x - 2.0; }
double fNanAt(double x, void* c) { return (x > 1.2) ? dmath.nan() : x - 1.0; }
double fInf(double x, void* c) { return dmath.INFINITY; }
double fPole(double x, void* c) { return (x < 1.0) ? -dmath.INFINITY : dmath.INFINITY; }
double fObj(double* x, int n, void* c) { double s = 0.0; for (int i = 0; i < n; i++) { s += x[i] * x[i]; } return s; }
double fObjNan(double* x, int n, void* c) { return dmath.nan(); }
void fGrad(double* x, int n, double* g, void* c) { for (int i = 0; i < n; i++) { g[i] = 2.0 * x[i]; } }
void fRhs(double t, double* y, double* dy, int n, void* c) { for (int i = 0; i < n; i++) { dy[i] = -y[i]; } }
void fRhsNan(double t, double* y, double* dy, int n, void* c) { for (int i = 0; i < n; i++) { dy[i] = dmath.nan(); } }
void fVec(double* x, int n, double* out, void* c) { for (int i = 0; i < n; i++) { out[i] = x[i] * x[i] - 4.0; } }
double fStat(double* s, int n, void* c) { return s[0]; }

int main() {
    int base = asys.memInUse();
    double nan = dmath.nan();
    double inf = dmath.INFINITY;
    double x5[5] = {3.0, 1.0, 4.0, 1.0, 5.0};
    double xn[5] = {3.0, nan, 4.0, 1.0, 5.0};
    double xi[5] = {3.0, inf, 4.0, 1.0, 5.0};
    double out[16];

    // ---- stats: null pointers and zero counts in the helper functions (sortDoubles, cumsum and polyEval were crashes)
    {
        stats.sortDoubles(null, 5);
        stats.sortDoubles(x5, 0);
        stats.sortDoubles(x5, -3);
        stats.sortDoubles(x5, 1);
        expectNear("sortDoubles(null / 0 / -3 / 1) left the data alone", x5[0] + x5[4], 8.0, 0.0);
        stats.cumsum(null, 5, out);
        stats.cumsum(x5, 5, null);
        stats.cumsum(x5, 0, out);
        expectBool("cumsum with null arguments does nothing", true, true);
        expectNan("polyEval(null, 3, x)", stats.polyEval(null, 3, 1.0));
        expectNan("polyEval(coef, -1, x)", stats.polyEval(x5, -1, 1.0));
        expectNear("polyEval of the constant 3", stats.polyEval(x5, 0, 7.0), 3.0, 0.0);
        stats.Welford w;
        w.addAll(null, 3);
        expectInt("Welford.addAll(null, 3) adds nothing", w.count, 0);
        expectNan("zeroed Welford: mean", w.mean());
        expectNan("zeroed Welford: variance", w.variance(1));
        w.addAll(x5, 5);
        expectNear("Welford over 3 1 4 1 5: mean", w.mean(), 2.8, 1.0e-15);
        w.addAll(xn, 5);
        expectNan("Welford after NaN data: mean", w.mean());
        w.reset();
        expectInt("Welford.reset", w.count, 0);
        stats.Histogram h(4, 0.0, 8.0);
        h.addAll(null, 3);
        expectInt("Histogram.addAll(null, 3) adds nothing", h.total, 0);
        h.addAll(xn, 5);
        expectInt("Histogram with NaN data: one NaN counted", h.nans, 1);
        expectInt("and four values counted", h.total, 4);
        h.dispose();
        stats.Histogram bad1(0, 0.0, 1.0);
        stats.Histogram bad2(5, 1.0, 1.0);
        stats.Histogram bad3(5, 2.0, 1.0);
        stats.Histogram bad4(5, nan, 1.0);
        stats.Histogram bad5(0x7FFFFFFFFFFFFFFF, 0.0, 1.0);
        expectBool("Histogram(0, ...), (5, 1, 1), (5, 2, 1), (5, nan, 1), (2^63 - 1, ...) are not ok", bad1.ok() || bad2.ok() || bad3.ok() || bad4.ok() || bad5.ok(), false);
        stats.Histogram z;
        z.add(1.0);
        expectInt("zeroed Histogram: count", z.count(0), 0);
        expectInt("zeroed Histogram: binOf", z.binOf(1.0) >= -2 ? 0 : 1, 0);
        z.dispose();
    }

    // ---- stats: whole-series functions with null or empty arguments
    {
        double o[8];
        expectInt("movingAverage(null)", stats.movingAverage(null, 5, 2, o), 0);
        expectInt("movingAverage(window 0)", stats.movingAverage(x5, 5, 0, o), 0);
        expectInt("movingAverage(window > n)", stats.movingAverage(x5, 5, 6, o), 0);
        expectInt("movingAverage(out null)", stats.movingAverage(x5, 5, 2, null), 0);
        expectInt("weightedMovingAverage(window 0)", stats.weightedMovingAverage(x5, 5, 0, o), 0);
        expectBool("emaSeries(alpha 0) is refused", stats.emaSeries(x5, 5, 0.0, false, o), false);
        expectBool("emaSeries(alpha 1.5) is refused", stats.emaSeries(x5, 5, 1.5, false, o), false);
        expectBool("emaSeries(null) is refused", stats.emaSeries(null, 5, 0.5, false, o), false);
        expectBool("ranks(NaN) is refused", stats.ranks(xn, 5, o), false);
        expectBool("ranks(null) is refused", stats.ranks(null, 5, o), false);
        expectBool("zscores(n = 0) is refused", stats.zscores(x5, 0, o, 0), false);
        expectBool("quantiles(null probabilities) is refused", stats.quantiles(x5, 5, null, 2, o, 7), false);
        double ps[2] = {0.25, 1.5};
        expectBool("quantiles with a probability above 1 is refused", stats.quantiles(x5, 5, ps, 2, o, 7), false);
        expectInt("multimode(null)", stats.multimode(null, 5, o, 4), -1);
        expectInt("multimode(NaN)", stats.multimode(xn, 5, o, 4), -1);
        expectInt("multimode(max 0)", stats.multimode(x5, 5, o, 0) == 0 ? 0 : (stats.multimode(x5, 5, o, 0) >= 1 ? 0 : -1), 0);
        expectNan("autocovariance lag >= n", stats.autocovariance(x5, 5, 5));
        expectNan("autocovariance negative lag", stats.autocovariance(x5, 5, -1));
        expectBool("autocorrelation(maxLag >= n) is refused", stats.autocorrelation(x5, 5, 5, o), false);
        expectBool("autocorrelation(constant data) is refused", stats.autocorrelation(o, 0, 1, o), false);
        double cst[4] = {2.0, 2.0, 2.0, 2.0};
        expectBool("autocorrelation of constant data is refused", stats.autocorrelation(cst, 4, 2, o), false);
        expectBool("partialAutocorrelation(null)", stats.partialAutocorrelation(null, 5, 2, o), false);
    }

    // ---- stats: tests, intervals and fits with hostile input
    {
        stats.TestResult t = stats.ttestOneSample(null, 5, 0.0, stats.TAIL_TWO);
        expectNan("ttestOneSample(null): p", t.pvalue);
        t = stats.ttestOneSample(x5, 1, 0.0, stats.TAIL_TWO);
        expectNan("ttestOneSample(n = 1): p", t.pvalue);
        t = stats.ttestOneSample(xn, 5, 0.0, stats.TAIL_TWO);
        expectNan("ttestOneSample(NaN): p", t.pvalue);
        t = stats.ttestOneSample(x5, 5, 0.0, 7);
        expectNan("ttestOneSample(bad tail): p", t.pvalue);
        t = stats.ttestTwoSample(x5, 5, null, 5, false, stats.TAIL_TWO);
        expectNan("ttestTwoSample(null): p", t.pvalue);
        double cst[5] = {2.0, 2.0, 2.0, 2.0, 2.0};
        t = stats.ttestTwoSample(cst, 5, cst, 5, false, stats.TAIL_TWO);
        expectNan("ttestTwoSample of two constant samples (zero variance): p is NaN", t.pvalue);
        t = stats.chiSquareGof(null, null, 3, 0);
        expectNan("chiSquareGof(null): p", t.pvalue);
        double obs[3] = {10.0, 20.0, 30.0};
        double neg[3] = {10.0, -20.0, 30.0};
        double zero[3] = {10.0, 0.0, 30.0};
        t = stats.chiSquareGof(neg, null, 3, 0);
        expectNan("chiSquareGof with a negative count: p", t.pvalue);
        t = stats.chiSquareGof(obs, zero, 3, 0);
        expectNan("chiSquareGof with an expected count of 0: p", t.pvalue);
        t = stats.chiSquareGof(obs, null, 3, 5);
        expectNan("chiSquareGof with ddof >= k - 1: p", t.pvalue);
        t = stats.chiSquareIndependence(null, 2, 2, false);
        expectNan("chiSquareIndependence(null): p", t.pvalue);
        t = stats.chiSquareIndependence(obs, 1, 3, false);
        expectNan("chiSquareIndependence(1 x 3): p", t.pvalue);
        t = stats.mannWhitney(x5, 5, xn, 5, stats.TAIL_TWO);
        expectNan("mannWhitney(NaN): p", t.pvalue);
        t = stats.mannWhitney(x5, 0, x5, 5, stats.TAIL_TWO);
        expectNan("mannWhitney(empty): p", t.pvalue);
        t = stats.anovaOneWay(null, null, 3);
        expectNan("anovaOneWay(null): p", t.pvalue);
        int sz1[2] = {1, 1};
        t = stats.anovaOneWay(x5, sz1, 2);
        expectNan("anovaOneWay(groups of one value): p", t.pvalue);
        t = stats.jarqueBera(x5, 2);
        expectNan("jarqueBera(n = 2): p", t.pvalue);
        stats.Interval ci = stats.meanCI(x5, 5, 1.5);
        expectNan("meanCI(level 1.5): lo", ci.lo);
        ci = stats.meanCI(x5, 5, 0.0);
        expectNan("meanCI(level 0): lo", ci.lo);
        ci = stats.meanCI(x5, 1, 0.95);
        expectNan("meanCI(n = 1): lo", ci.lo);
        ci = stats.meanCI(null, 5, 0.95);
        expectNan("meanCI(null): lo", ci.lo);
        ci = stats.proportionCI(7, 5, 0.95, stats.CI_WILSON);
        expectNan("proportionCI(k > n): lo", ci.lo);
        ci = stats.proportionCI(-1, 5, 0.95, stats.CI_WILSON);
        expectNan("proportionCI(k < 0): lo", ci.lo);
        ci = stats.proportionCI(1, 0, 0.95, stats.CI_CLOPPER_PEARSON);
        expectNan("proportionCI(n = 0): lo", ci.lo);
        ci = stats.proportionCI(1, 5, 0.95, 99);
        expectNan("proportionCI(unknown method): lo", ci.lo);
        rng.Xoshiro256 g(1);
        ci = stats.bootstrapCI(x5, 5, fStat, null, 100, 0.9, null);
        expectNan("bootstrapCI(no generator): lo", ci.lo);
        ci = stats.bootstrapCI(x5, 5, null, null, 100, 0.9, &g);
        expectNan("bootstrapCI(no statistic): lo", ci.lo);
        ci = stats.bootstrapCI(x5, 5, fStat, null, 0, 0.9, &g);
        expectNan("bootstrapCI(0 resamples): lo", ci.lo);
        ci = stats.bootstrapCI(xn, 5, fStat, null, 50, 0.9, &g);
        expectNan("bootstrapCI(NaN data): lo", ci.lo);

        stats.Regression r = stats.linearFit(null, x5, 5);
        expectBool("linearFit(null) fails", r.ok(), false);
        r.dispose();
        r = stats.linearFit(x5, x5, 1);
        expectBool("linearFit(n = 1) fails", r.ok(), false);
        r.dispose();
        r = stats.linearFit(x5, xn, 5);
        expectBool("linearFit with NaN fails", r.ok(), false);
        r.dispose();
        r = stats.linearFit(x5, xi, 5);
        expectBool("linearFit with infinity fails", r.ok(), false);
        r.dispose();
        r = stats.polyFit(x5, x5, 5, -1);
        expectBool("polyFit(degree -1) fails", r.ok(), false);
        r.dispose();
        r = stats.polyFit(x5, x5, 5, 5);
        expectBool("polyFit(degree 5 through 5 points) fails", r.ok(), false);
        r.dispose();
        matrix.Matrix em;
        r = stats.olsFit(&em, x5, true, null);
        expectBool("olsFit(empty matrix) fails", r.ok(), false);
        r.dispose();
        r = stats.olsFit(null, x5, true, null);
        expectBool("olsFit(null) fails", r.ok(), false);
        r.dispose();
        stats.Regression zr;
        expectNan("zeroed Regression: predict", zr.predict(1.0));
        zr.dispose();
        stats.KMeans km = stats.kmeans(x5, 5, 1, 9, &g, 10, 1);
        expectBool("kmeans(k > n) fails", km.ok(), false);
        km.dispose();
        km = stats.kmeans(xn, 5, 1, 2, &g, 10, 1);
        expectBool("kmeans(NaN) fails", km.ok(), false);
        km.dispose();
        km = stats.kmeans(x5, 5, 1, 2, null, 10, 1);
        expectBool("kmeans(no generator) fails", km.ok(), false);
        km.dispose();
        km = stats.kmeans(x5, 5, 0x7FFFFFFFFFFFFFFF, 2, &g, 10, 1);
        expectBool("kmeans(huge dim) fails", km.ok(), false);
        km.dispose();
        stats.KMeans zk;
        expectInt("zeroed KMeans: predict", zk.predict(x5), -1);
        zk.dispose();
        matrix.Matrix dm(4, 2);
        for (int i = 0; i < 8; i++) { dm.d[i] = (double) (i * i % 7); }
        stats.Pca pca(&dm, 9, false);
        expectBool("Pca(keep > dim) keeps all dim components", pca.ok() && pca.k == 2, true);
        pca.dispose();
        dm.d[3] = nan;
        stats.Pca pn(&dm, 0, false);
        expectBool("Pca(NaN) fails", pn.ok(), false);
        pn.dispose();
        stats.Pca p0(null, 0, false);
        expectBool("Pca(null) fails", p0.ok(), false);
        p0.dispose();
        dm.dispose();
    }

    // ---- stats: very large parameters. The distribution functions lost digits when a parameter was huge (tCdf(1, 1e9) was wrong in the 9th digit: the binomial prefactor of the
    // incomplete beta function computed log(1 - x / n) by a cancelling subtraction); the references are 50 digit decimals (tests/algo2_ref/refspecial.py)
    {
        expectNear("tCdf(1, 1e5)", stats.tCdf(1.0, 1.0e5), 0.841343536217945, 3.0e-15);
        expectNear("tCdf(1, 1e7)", stats.tCdf(1.0, 1.0e7), 0.84134473397000697, 3.0e-15);
        expectNear("tCdf(1, 1e9)", stats.tCdf(1.0, 1.0e9), 0.84134474594755759, 3.0e-15);
        expectNear("tCdf(1, 1e12)", stats.tCdf(1.0, 1.0e12), 0.84134474606842191, 3.0e-15);
        expectNear("tCdf(1, 1e17) is the normal cdf", stats.tCdf(1.0, 1.0e17), 0.8413447460685429, 3.0e-15);
        expectNear("tSf(5, 1e5) (relative; t^2 = 25 is outside the domain of the expansion in 1 / df, the incomplete beta function gives 1e-13)", stats.tSf(5.0, 1.0e5) / 2.8713508393208365e-07, 1.0, 3.0e-13);
        expectNear("tSf(5, 1e7) (relative)", stats.tSf(5.0, 1.0e7) / 2.8665640375042696e-07, 1.0, 1.0e-14);
        expectNear("tSf(5, 1e9) (relative)", stats.tSf(5.0, 1.0e9) / 2.8665162019758144e-07, 1.0, 1.0e-14);
        expectNear("tSf(5, 1e12) (relative)", stats.tSf(5.0, 1.0e12) / 2.8665157192751227e-07, 1.0, 1.0e-14);
        expectNear("incGammaP(1e6, 1e6)", stats.incGammaP(1.0e6, 1.0e6), 0.50013298076087254, 3.0e-15);
        expectNear("incGammaP(1e8, 1e8) (error about 1e-16 sqrt(a))", stats.incGammaP(1.0e8, 1.0e8), 0.50001329807601413, 2.0e-13);
        expectNear("incGammaQ(1e6, 1.005e6) (relative)", stats.incGammaQ(1.0e6, 1.005e6) / 2.987490140114635e-07, 1.0, 3.0e-13);
        expectNear("incGammaQ(1e8, 1.0005e8) (relative)", stats.incGammaQ(1.0e8, 1.0005e8) / 2.8784296868527812e-07, 1.0, 3.0e-13);
        expectNear("incBeta(0.42, 3000, 4000)", stats.incBeta(0.42, 3000.0, 4000.0), 0.073464177545649864, 1.0e-14);
        expectNear("incBeta(0.4, 1e5, 1.5e5) (error about 1e-16 sqrt(a))", stats.incBeta(0.4, 1.0e5, 1.5e5), 0.50010857840152723, 3.0e-13);
        expectNear("binomPmf(5000, 10000, 0.5)", stats.binomPmf(5000.0, 10000.0, 0.5), 0.0079786461393821541, 1.0e-16);
        expectNear("binomCdf(4900, 10000, 0.5)", stats.binomCdf(4900.0, 10000.0, 0.5), 0.023292763852473693, 1.0e-14);
        expectNear("fCdf(1.1, 5000, 7000)", stats.fCdf(1.1, 5000.0, 7000.0), 0.99986888186619272, 1.0e-14);
        expectNear("incBeta(0.3, 5e8, 0.5) is 0 (below 1e-300)", stats.incBeta(0.3, 5.0e8, 0.5), 0.0, 1.0e-300);
        expectNan("incGammaP(1e15, 1e15): the series needs more than 10^6 terms, so the answer is NaN (it was a wrong number, 0.0126)", stats.incGammaP(1.0e15, 1.0e15));
        expectNan("incGammaQ(1e308, 1e308)", stats.incGammaQ(1.0e308, 1.0e308));
        expectNear("normalCdf(1) from the same value", stats.normalCdf(1.0, 0.0, 1.0), 0.8413447460685429, 1.0e-16);
    }

    // ---- optim: a null callback is ERR_ARG (all of these were crashes)
    {
        expectNan("derivative(null)", optim.derivative(null, null, 1.0, 0.0));
        expectNan("derivative5(null)", optim.derivative5(null, null, 1.0, 0.0));
        optim.gradientNum(null, null, x5, 3, out);
        optim.hessianNum(null, null, x5, 3, out);
        expectInt("jacobianNum(null function)", optim.jacobianNum(null, null, x5, 3, 3, out), optim.ERR_ARG);
        expectInt("jacobianNum(null x)", optim.jacobianNum(fVec, null, null, 3, 3, out), optim.ERR_ARG);
        double a = 0.0;
        double b = 0.0;
        expectInt("findBracket(null function)", optim.findBracket(null, null, 1.0, 1.0, &a, &b), optim.ERR_ARG);
        expectInt("findBracket(null outputs)", optim.findBracket(fSquare, null, 1.0, 1.0, null, null), optim.ERR_ARG);
        expectInt("bisection(null)", optim.bisection(null, null, 0.0, 2.0, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("brent(null)", optim.brent(null, null, 0.0, 2.0, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("newton(null)", optim.newton(null, null, null, 1.0, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("secant(null)", optim.secant(null, null, 1.0, 2.0, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("goldenSection(null)", optim.goldenSection(null, null, 0.0, 2.0, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("brentMin(null)", optim.brentMin(null, null, 0.0, 2.0, 1.0e-9, 100).status, optim.ERR_ARG);
        double lo = 0.0;
        double mid = 0.0;
        double hi = 0.0;
        expectInt("bracketMin(null function)", optim.bracketMin(null, null, 0.0, 1.0, &lo, &mid, &hi), optim.ERR_ARG);
        expectInt("bracketMin(null outputs)", optim.bracketMin(fSquare, null, 0.0, 1.0, null, null, null), optim.ERR_ARG);
        expectInt("trapezoid(null)", optim.trapezoid(null, null, 0.0, 1.0, 10).status, optim.ERR_ARG);
        expectInt("simpson(null)", optim.simpson(null, null, 0.0, 1.0, 10).status, optim.ERR_ARG);
        expectInt("romberg(null)", optim.romberg(null, null, 0.0, 1.0, 1.0e-9, 10).status, optim.ERR_ARG);
        expectInt("integrateGL(null)", optim.integrateGL(null, null, 0.0, 1.0, 10).status, optim.ERR_ARG);
        expectInt("gaussKronrod(null)", optim.gaussKronrod(null, null, 0.0, 1.0, 1.0e-9, 1.0e-9, 100).status, optim.ERR_ARG);
        double y[2] = {1.0, 1.0};
        double xo[3] = {1.0, 1.0, 1.0};
        expectInt("nelderMead(null)", optim.nelderMead(null, null, xo, 3, 0.1, 1.0e-9, 100).status, optim.ERR_ARG);
        expectInt("bfgs(null)", optim.bfgs(null, null, null, xo, 3, 1.0e-6, 10).status, optim.ERR_ARG);
        expectInt("gradientDescent(null)", optim.gradientDescent(null, null, null, xo, 3, 1.0, 1.0e-6, 10).status, optim.ERR_ARG);
        expectInt("newtonSystem(null)", optim.newtonSystem(null, null, xo, 3, 1.0e-9, 10).status, optim.ERR_ARG);
        expectInt("rk4(null rhs): was a crash", optim.rk4(null, null, 2, 0.0, y, 1.0, 10, out, null), optim.ERR_ARG);
        optim.Rk45 rk(null, null, 2, 0.0, y, 1.0e-6, 1.0e-9, 0.0);
        expectBool("Rk45(null rhs) is not ok", rk.ok(), false);
        expectInt("Rk45(null rhs).solveTo", rk.solveTo(1.0, 100) == optim.OK ? 0 : 1, 1);
        rk.dispose();
        optim.Chebyshev ch(null, null, 0.0, 1.0, 8);
        expectBool("Chebyshev(null function) is not ok", ch.ok(), false);
        ch.dispose();
        double d1 = 0.0;
        double d2 = 0.0;
        optim.polyEvalDeriv(null, 3, 1.0, &d1, &d2);
        expectNan("polyEvalDeriv(null): value", d1);
        expectNan("polyEvalDeriv(null): derivative", d2);
        optim.polyEvalDeriv(x5, 3, 1.0, null, null);
        expectNan("polyEval(null)", optim.polyEval(null, 3, 1.0));
        optim.sincosTurns(1, 8, null, null);
        double s1 = 0.0;
        double c1 = 0.0;
        optim.sincosTurns(1, 0, &s1, &c1);
        expectNan("sincosTurns(n = 0): sin", s1);
        optim.sincosTurns(1, 8, &s1, &c1);
        expectNear("sincosTurns(1, 8): sin(pi / 4)", s1, 0.7071067811865476, 2.0e-16);
    }

    // ---- optim: callbacks that return NaN or infinity, bad intervals and tolerances
    {
        optim.Result r = optim.brent(fNanAt, null, 0.0, 2.0, 1.0e-9, 100);
        expectBool("brent with a function that turns NaN is not OK or finds the root before: no crash", r.status == optim.OK || r.status == optim.ERR_NAN, true);
        r = optim.bisection(fInf, null, 0.0, 2.0, 1.0e-9, 100);
        expectInt("bisection of a function that is +infinity everywhere: no sign change", r.status, optim.ERR_BRACKET);
        r = optim.bisection(fPole, null, 0.5, 2.0, 1.0e-12, 200);
        expectBool("bisection across a pole (-inf to +inf at x = 1) converges to the pole", r.status == optim.OK && dmath.fabs(r.x - 1.0) < 1.0e-9, true);
        r = optim.brent(fSquare, null, 0.0, 2.0, -1.0, 100);
        expectInt("brent with tol < 0", r.status, optim.ERR_ARG);
        r = optim.brent(fSquare, null, 0.0, 2.0, nan, 100);
        expectInt("brent with tol = NaN", r.status, optim.ERR_ARG);
        r = optim.brent(fSquare, null, nan, 2.0, 1.0e-9, 100);
        expectInt("brent with a NaN limit", r.status, optim.ERR_ARG);
        r = optim.brent(fSquare, null, 0.0, inf, 1.0e-9, 100);
        expectInt("brent with an infinite limit", r.status, optim.ERR_ARG);
        r = optim.brent(fSquare, null, 2.0, 3.0, 1.0e-9, 100);
        expectInt("brent without a sign change: ERR_BRACKET", r.status, optim.ERR_BRACKET);
        r = optim.brent(fSquare, null, 0.0, 2.0, 1.0e-9, 0);
        expectBool("brent with maxIter 0 does not claim a result it did not find", r.status == optim.ERR_NO_CONVERGE || r.status == optim.OK, true);
        r = optim.brent(fSquare, null, 2.0, 0.0, 1.0e-12, 100);
        expectBool("brent with a > b finds the root anyway or refuses", (r.status == optim.OK && dmath.fabs(r.x - 1.4142135623730951) < 1.0e-9) || r.status == optim.ERR_ARG, true);
        r = optim.newton(fSquare, null, null, nan, 1.0e-9, 100);
        expectInt("newton from NaN", r.status, optim.ERR_ARG);
        r = optim.newton(fSquare, null, null, 0.0, 1.0e-9, 100);
        expectBool("newton from the critical point 0 (zero derivative) does not return OK with garbage", r.status != optim.OK || dmath.fabs(r.x * r.x - 2.0) < 1.0e-6, true);
        r = optim.secant(fSquare, null, 1.0, 1.0, 1.0e-9, 100);
        expectBool("secant with two equal starting values: no crash, no OK with garbage", r.status != optim.OK || dmath.fabs(r.x * r.x - 2.0) < 1.0e-6, true);
        r = optim.goldenSection(fSquare, null, 1.0, 1.0, 1.0e-9, 100);
        expectBool("goldenSection on an empty interval", r.status == optim.OK || r.status == optim.ERR_ARG, true);
        r = optim.goldenSection(fSquare, null, 0.0, 2.0, 0.0, 100);
        expectInt("goldenSection with tol = 0", r.status, optim.ERR_ARG);
        double xo[3] = {1.0, 2.0, 3.0};
        r = optim.nelderMead(fObjNan, null, xo, 3, 0.1, 1.0e-9, 200);
        expectBool("nelderMead of an objective that is NaN everywhere is an error", r.status != optim.OK, true);
        r = optim.nelderMead(fObj, null, xo, 0, 0.1, 1.0e-9, 200);
        expectInt("nelderMead with n = 0", r.status, optim.ERR_ARG);
        r = optim.nelderMead(fObj, null, null, 3, 0.1, 1.0e-9, 200);
        expectInt("nelderMead without a start", r.status, optim.ERR_ARG);
        xo[1] = nan;
        r = optim.bfgs(fObj, fGrad, null, xo, 3, 1.0e-6, 50);
        expectBool("bfgs from a start with NaN is an error", r.status != optim.OK, true);
        xo[1] = 2.0;
        r = optim.bfgs(fObj, fGrad, null, xo, 3, -1.0, 50);
        expectBool("bfgs with gtol < 0 is refused or does not claim success without convergence", r.status != optim.OK || r.err <= 1.0e-6, true);
        optim.Integral q = optim.gaussKronrod(fSquare, null, 1.0, 0.0, 1.0e-9, 1.0e-9, 100);
        expectBool("gaussKronrod with reversed limits gives the negated integral", q.status == optim.OK && dmath.fabs(q.value - (-(1.0 / 3.0 - 2.0))) < 1.0e-9, true);
        q = optim.gaussKronrod(fSquare, null, 0.0, 1.0, 1.0e-9, 1.0e-9, 0);
        expectBool("gaussKronrod with maxSub 0 is refused or does not claim success", q.status != optim.OK || q.error < 1.0e-8, true);
        q = optim.gaussKronrod(fNanAt, null, 0.0, 2.0, 1.0e-9, 1.0e-9, 100);
        expectInt("gaussKronrod of a function with NaN: ERR_NAN", q.status, optim.ERR_NAN);
        q = optim.gaussKronrod(fSquare, null, 0.0, nan, 1.0e-9, 1.0e-9, 100);
        expectBool("gaussKronrod with a NaN limit is refused", q.status != optim.OK, true);
        q = optim.trapezoid(fSquare, null, 0.0, 1.0, 0);
        expectInt("trapezoid with 0 panels", q.status, optim.ERR_ARG);
        q = optim.romberg(fSquare, null, 0.0, 1.0, 1.0e-9, 1);
        expectInt("romberg with 1 level", q.status, optim.ERR_ARG);
        q = optim.romberg(fSquare, null, 0.0, 1.0, 1.0e-9, 31);
        expectInt("romberg with 31 levels", q.status, optim.ERR_ARG);
        q = optim.integrateGL(fSquare, null, 0.0, 1.0, 0);
        expectInt("integrateGL with n = 0", q.status, optim.ERR_ARG);
        q = optim.integrateGL(fSquare, null, 0.0, 1.0, 2001);
        expectInt("integrateGL with n = 2001 (above the limit)", q.status, optim.ERR_ARG);
        double gx[4];
        double gw[4];
        expectInt("gaussLegendre(0)", optim.gaussLegendre(0, gx, gw), optim.ERR_ARG);
        expectInt("gaussLegendre(null)", optim.gaussLegendre(4, null, gw), optim.ERR_ARG);
        double y0[2] = {1.0, 1.0};
        expectInt("rk4 with 0 steps", optim.rk4(fRhs, null, 2, 0.0, y0, 1.0, 0, out, null), optim.ERR_ARG);
        expectInt("rk4 with a NaN end time", optim.rk4(fRhs, null, 2, 0.0, y0, nan, 10, out, null), optim.ERR_ARG);
        expectInt("rk4 with n = 0", optim.rk4(fRhs, null, 0, 0.0, y0, 1.0, 10, out, null), optim.ERR_ARG);
        optim.Rk45 r1(fRhs, null, 2, 0.0, y0, 0.0, 1.0e-9, 0.0);
        expectBool("Rk45 with rtol = 0 is refused", r1.ok(), false);
        r1.dispose();
        double ynan[2] = {1.0, nan};
        optim.Rk45 r2(fRhs, null, 2, 0.0, ynan, 1.0e-6, 1.0e-9, 0.0);
        expectBool("Rk45 from a NaN state is refused", r2.ok(), false);
        r2.dispose();
        optim.Rk45 r3(fRhsNan, null, 2, 0.0, y0, 1.0e-6, 1.0e-9, 0.0);
        expectInt("Rk45 with a right hand side that returns NaN: ERR_NAN", r3.solveTo(1.0, 1000), optim.ERR_NAN);
        r3.dispose();
        optim.Rk45 r4(fRhs, null, 2, 0.0, y0, 1.0e-6, 1.0e-9, 0.0);
        expectInt("Rk45.solveTo with maxSteps 0", r4.solveTo(1.0, 0) == optim.OK ? 0 : 1, 1);
        r4.dispose();
        optim.Rk45 r5(fRhs, null, 2, 0.0, y0, 1.0e-6, 1.0e-9, 0.0);
        expectInt("Rk45.solveTo(NaN)", r5.solveTo(nan, 1000) == optim.OK ? 0 : 1, 1);
        r5.dispose();
        expectInt("newtonSystem with a singular Jacobian (x = 0 for x^2 - 4 = 0)", optim.newtonSystem(fVec, null, xo, 0, 1.0e-10, 20).status, optim.ERR_ARG);
        double zero[2] = {0.0, 0.0};
        optim.Result ns = optim.newtonSystem(fVec, null, zero, 2, 1.0e-10, 20);
        expectInt("newtonSystem at a point where the Jacobian is singular", ns.status, optim.ERR_SINGULAR);
    }

    // ---- optim: interpolation, polynomials, FFT and linear programs with hostile input
    {
        double xs[4] = {0.0, 1.0, 2.0, 3.0};
        double ys[4] = {1.0, 3.0, 2.0, 5.0};
        double dup[4] = {0.0, 1.0, 1.0, 3.0};
        double dec[4] = {3.0, 2.0, 1.0, 0.0};
        expectNan("interpLinear(null)", optim.interpLinear(null, ys, 4, 1.5));
        expectNan("interpLinear(n = 0)", optim.interpLinear(xs, ys, 0, 1.5));
        expectNan("interpLinear(x = NaN)", optim.interpLinear(xs, ys, 4, nan));
        expectNan("interpLinear(decreasing nodes)", optim.interpLinear(dec, ys, 4, 1.5));
        expectNear("interpLinear(1.5)", optim.interpLinear(xs, ys, 4, 1.5), 2.5, 0.0);
        expectNear("interpLinear outside the range keeps the end value", optim.interpLinear(xs, ys, 4, 9.0), 5.0, 0.0);
        optim.Spline sp1(dup, ys, 4, 0, 0.0, 0.0);
        expectBool("Spline with a repeated node is not ok", sp1.ok(), false);
        expectNan("and its value is NaN", sp1.value(0.5));
        optim.Spline sp2(xs, ys, 1, 0, 0.0, 0.0);
        expectBool("Spline with one point is not ok", sp2.ok(), false);
        optim.Spline sp3(null, ys, 4, 0, 0.0, 0.0);
        expectBool("Spline(null) is not ok", sp3.ok(), false);
        optim.Spline sp4(xs, ys, 4, 9, 0.0, 0.0);
        expectBool("Spline with an unknown boundary condition is not ok", sp4.ok(), false);
        optim.Spline sp5(xs, ys, 4, optim.SPLINE_CLAMPED, nan, 0.0);
        expectBool("Spline with a NaN end slope is not ok", sp5.ok(), false);
        optim.Spline sp6(xs, ys, 4, 0, 0.0, 0.0);
        expectNan("Spline.value(NaN)", sp6.value(nan));
        expectNan("Spline.derivative of order 4", sp6.derivative(1.0, 4));
        expectNear("Spline.integral of a reversed range is the negated integral", sp6.integral(3.0, 0.0) + sp6.integral(0.0, 3.0), 0.0, 1.0e-12);
        sp1.dispose();
        sp2.dispose();
        sp3.dispose();
        sp4.dispose();
        sp5.dispose();
        sp6.dispose();
        optim.Barycentric bc(dup, ys, 4);
        expectBool("Barycentric with a repeated node is not ok", bc.ok(), false);
        bc.dispose();
        optim.Barycentric bn(null, ys, 4);
        expectBool("Barycentric(null) is not ok", bn.ok(), false);
        bn.dispose();
        optim.Chebyshev c0(fSquare, null, 0.0, 1.0, 0);
        expectBool("Chebyshev with 0 terms is not ok", c0.ok(), false);
        c0.dispose();
        optim.Chebyshev c1(fSquare, null, 1.0, 1.0, 8);
        expectBool("Chebyshev on an empty interval is not ok", c1.ok(), false);
        c1.dispose();
        optim.Chebyshev c2(fNanAt, null, 0.0, 2.0, 8);
        expectBool("Chebyshev of a function with NaN is not ok", c2.ok(), false);
        c2.dispose();
        expectInt("chebyshevNodes(0)", optim.chebyshevNodes(0, 0.0, 1.0, out), optim.ERR_ARG);
        expectInt("chebyshevNodes(null)", optim.chebyshevNodes(4, 0.0, 1.0, null), optim.ERR_ARG);

        double re[4];
        double im[4];
        expectInt("polyRoots(null)", optim.polyRoots(null, 3, re, im) < 0 ? 1 : 0, 1);
        expectInt("polyRoots(degree -1)", optim.polyRoots(xs, -1, re, im) < 0 ? 1 : 0, 1);
        double zp[3] = {0.0, 0.0, 0.0};
        expectInt("polyRoots of the zero polynomial", optim.polyRoots(zp, 2, re, im) < 0 ? 1 : 0, 1);
        double np[3] = {1.0, nan, 1.0};
        expectInt("polyRoots with NaN coefficients", optim.polyRoots(np, 2, re, im) < 0 ? 1 : 0, 1);
        double ip[3] = {1.0, inf, 1.0};
        expectInt("polyRoots with infinite coefficients", optim.polyRoots(ip, 2, re, im) < 0 ? 1 : 0, 1);
        double cp[1] = {5.0};
        expectInt("polyRoots of a constant has no roots", optim.polyRoots(cp, 0, re, im), 0);
        double huge[3] = {1.0e300, 0.0, 1.0e300};
        expectBool("polyRoots with huge coefficients does not hang", optim.polyRoots(huge, 2, re, im) != 12345, true);
        double q[4];
        expectInt("polyDivide by the zero polynomial", optim.polyDivide(xs, 3, zp, 2, q, null), -1);
        expectInt("polyFit(null)", optim.polyFit(null, ys, 4, 2, out), optim.ERR_ARG);
        expectInt("polyFit(n < degree + 1)", optim.polyFit(xs, ys, 2, 2, out), optim.ERR_ARG);
        double ysn[4] = {1.0, nan, 2.0, 3.0};
        expectInt("polyFit with NaN", optim.polyFit(xs, ysn, 4, 2, out), optim.ERR_NAN);

        expectInt("fft(n = 0)", optim.fft(re, im, 0, false), optim.ERR_ARG);
        expectInt("fft(null)", optim.fft(null, im, 4, false), optim.ERR_ARG);
        expectInt("fft(n = -1)", optim.fft(re, im, -1, false), optim.ERR_ARG);
        optim.FftPlan fp0(0);
        optim.FftPlan fpn(-5);
        optim.FftPlan fph(0x7FFFFFFFFFFFFFFF);
        expectBool("FftPlan(0), (-5) and (2^63 - 1) are not ok", fp0.ok() || fpn.ok() || fph.ok(), false);
        expectInt("FftPlan(0).forward", fp0.forward(re, im) == optim.OK ? 0 : 1, 1);
        fp0.dispose();
        fpn.dispose();
        fph.dispose();
        optim.FftPlan fp4(4);
        expectInt("FftPlan(4).forward(null)", fp4.forward(null, null), optim.ERR_ARG);
        fp4.dispose();
        expectInt("rfft(n = 0)", optim.rfft(xs, 0, re, im), optim.ERR_ARG);
        expectInt("irfft(null)", optim.irfft(null, null, 4, out), optim.ERR_ARG);
        expectInt("convolve(null)", optim.convolve(null, 3, xs, 4, out), optim.ERR_ARG);
        expectInt("convolve(na = 0)", optim.convolve(xs, 0, xs, 4, out), optim.ERR_ARG);
        expectInt("crossCorrelate(nb = -1)", optim.crossCorrelate(xs, 3, xs, -1, out), optim.ERR_ARG);
        expectInt("fftFrequencies(0)", optim.fftFrequencies(0, 1.0, out), optim.ERR_ARG);
        expectInt("fftFrequencies(d = 0)", optim.fftFrequencies(4, 0.0, out), optim.ERR_ARG);
        expectInt("windowFunction(unknown kind)", optim.windowFunction(99, 8, out), optim.ERR_ARG);
        expectInt("windowFunction(n = 0)", optim.windowFunction(optim.WIN_HANN, 0, out), optim.ERR_ARG);

        double c[2] = {1.0, 1.0};
        double A[4] = {1.0, 1.0, 1.0, -1.0};
        double b[2] = {4.0, 1.0};
        int kinds[2] = {optim.LE, optim.LE};
        double sol[2];
        double obj = 0.0;
        expectInt("linprog max x + y s.t. x + y <= 4, x - y <= 1", optim.linprog(c, 2, A, 2, b, kinds, true, sol, &obj, null), optim.OK);
        expectNear("objective 4", obj, 4.0, 1.0e-9);
        expectInt("linprog(n = 0)", optim.linprog(c, 0, A, 2, b, kinds, true, sol, &obj, null), optim.ERR_ARG);
        expectInt("linprog(m = -1)", optim.linprog(c, 2, A, -1, b, kinds, true, sol, &obj, null), optim.ERR_ARG);
        expectInt("linprog(null c)", optim.linprog(null, 2, A, 2, b, kinds, true, sol, &obj, null), optim.ERR_ARG);
        expectInt("linprog(null A with m > 0)", optim.linprog(c, 2, null, 2, b, kinds, true, sol, &obj, null), optim.ERR_ARG);
        expectInt("linprog(null x)", optim.linprog(c, 2, A, 2, b, kinds, true, null, &obj, null), optim.ERR_ARG);
        int badKinds[2] = {5, 0};
        expectInt("linprog with an unknown kind", optim.linprog(c, 2, A, 2, b, badKinds, true, sol, &obj, null), optim.ERR_ARG);
        double cn[2] = {1.0, nan};
        expectInt("linprog with NaN in c", optim.linprog(cn, 2, A, 2, b, kinds, true, sol, &obj, null), optim.ERR_NAN);
        double bi[2] = {4.0, inf};
        expectInt("linprog with infinity in b", optim.linprog(c, 2, A, 2, bi, kinds, true, sol, &obj, null), optim.ERR_NAN);
        expectInt("linprog(m = 100000, n = 100000) must not try to allocate a 2^34 number tableau", optim.linprog(c, 100000, A, 100000, b, kinds, true, sol, &obj, null) != optim.OK ? 1 : 0, 1);
        double fc[1] = {1.0};
        double fa[1] = {1.0};
        double fb[1] = {-1.0};
        int fk[1] = {optim.GE};
        double fs[1];
        expectInt("linprog: x >= -1 with x >= 0 is trivially satisfied", optim.linprog(fc, 1, fa, 1, fb, fk, false, fs, &obj, null), optim.OK);
        int fk2[1] = {optim.LE};
        expectInt("linprog: x <= -1 with x >= 0 is infeasible", optim.linprog(fc, 1, fa, 1, fb, fk2, false, fs, &obj, null), optim.LP_INFEASIBLE);
        double bp[1] = {1.0};
        expectInt("linprog: maximise x subject to x >= 1 is unbounded", optim.linprog(fc, 1, fa, 1, bp, fk, true, fs, &obj, null), optim.LP_UNBOUNDED);
    }

    // ---- the special sequences with absurd arguments
    {
        expectNan("legendreP(-1, x)", optim.legendreP(-1, 0.5));
        expectNan("factorialD(-1)", optim.factorialD(-1));
        expectBool("factorialD(2^62) is infinite", optim.factorialD(0x4000000000000000) == inf, true);
        expectNan("binomialD(5, -1)", optim.binomialD(5, -1));
        expectNear("binomialD(5, 9) is 0", optim.binomialD(5, 9), 0.0, 0.0);
        expectBool("fibonacciD(2^62) is infinite", optim.fibonacciD(0x4000000000000000) == inf, true);
        expectBool("fibonacciD(-2^62) is infinite in magnitude", dmath.fabs(optim.fibonacciD(-0x4000000000000000)) == inf, true);
        expectNan("harmonicD(-1)", optim.harmonicD(-1));
        expectNan("bernoulliD(-1)", optim.bernoulliD(-1));
        expectNan("catalanD(-1)", optim.catalanD(-1));
        expectBool("catalanD(2^40) finishes with infinity, not by looping 2^40 times", optim.catalanD(2000) == inf, true);
        expectBool("legendreP(0, nan) is 1 (degree 0 does not use x)", optim.legendreP(0, nan) == 1.0, true);
        expectNan("legendreP(3, nan)", optim.legendreP(3, nan));
    }

    printf("%d checks, %d failed\n", checks, fails);
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return fails == 0 ? 0 : 1;
}
