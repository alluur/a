// SHA-512 and the $6$ password hashes (values from Python hashlib and openssl passwd -6)
import hash;
import syscrypt;

char buf[1100];

int main() {
    for (int i = 0; i < 1100; i++) buf[i] = 'a' + (i % 26);
    println(hash.sha512("abc", 3));
    println(hash.sha512("", 0));
    println(hash.sha512(&buf[0], 111));
    println(hash.sha512(&buf[0], 112));
    println(hash.sha512(&buf[0], 113));
    println(hash.sha512(&buf[0], 127));
    println(hash.sha512(&buf[0], 128));
    println(hash.sha512(&buf[0], 129));
    println(hash.sha512(&buf[0], 1000));
    printlnInt(strlen(hash.sha512("x", 1)));
    println(syscrypt.sha512crypt("secret", "$6$abcdefgh"));
    printlnInt(syscrypt.verify("secret", "$6$abcdefgh$ltjgWl6579NluT/Vi1nwEvcil.G5Nbc4NiXZaNGStk8PSwGfQv72N2CKPPrVACtLtip/cZ/1GM/O6IND4WQhG."));
    println(syscrypt.sha512crypt("pässword", "$6$rounds=1000$xyz"));
    printlnInt(syscrypt.verify("pässword", "$6$rounds=1000$xyz$xlCATYnREtSUFA2KEAzucMsmhbtHd6VXDxd24J/BV0oF2a9OtX8Sn4SxR6syFVRWzN6PLgupt1qp3QKlkfHNJ."));
    println(syscrypt.sha512crypt("a long password with spaces and 1234567890!", "$6$0123456789abcdef"));
    printlnInt(syscrypt.verify("a long password with spaces and 1234567890!", "$6$0123456789abcdef$VqisBzcfOpBv3jDDX3ScSZEitgMoJUILP7AXSx4WKSZwqInU0WKFBz5dRf7JbyvIyECOui/5lF6hHSrB4O3ZE/"));
    println(syscrypt.sha512crypt("x", "$6$rounds=10000$salt$ignored"));
    printlnInt(syscrypt.verify("x", "$6$rounds=10000$salt$GkTdLe25dDZSkQkHzEE/ws3.6rd0zcv/WQ1ivwy28BzzjrSqliZn2PKecEzaV307o6SuQ6ZxlpE0LA8RgSbC.1"));
    printlnInt(syscrypt.verify("wrong", "$6$abcdefgh$ltjgWl6579NluT/Vi1nwEvcil.G5Nbc4NiXZaNGStk8PSwGfQv72N2CKPPrVACtLtip/cZ/1GM/O6IND4WQhG."));
    printlnInt(syscrypt.verify("secret", "$1$abc$def"));
    printlnInt(syscrypt.verify("secret", "*"));
    return 0;
}
