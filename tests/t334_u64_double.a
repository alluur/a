// a uint64 of 2^63 or more converted to double stays positive (it used to become negative)
double half(double x) {
    return x / 2.0;
}

int main() {
    uint64 q = 18446744073709551615;
    uint64 h = 9223372036854775808;
    uint64 small = 12345;
    double dq = q;
    double dh = h;
    double ds = small;
    println($"{dq:.0f} {dq:e} {dh:.0f} {ds:.0f}");
    println($"{dq + 1.0:.0f} {dq / 2.0:.0f} {q * 1.0:.0f} {1.0 * q:.0f} {half(q):.0f} {half(h):.0f}");
    if (q > 1.0e19) { println("q > 1e19"); }
    if (1.0e19 < q) { println("1e19 < q"); }
    if (dq > dh) { println("dq > dh"); }
    if (h >= 9.0e18) { println("h >= 9e18"); }
    if (small < 1.0e5) { println("small < 1e5"); }
    uint64 odd = 9223372036854777857;
    double dodd = odd;
    println($"{dodd:.0f} {odd:.0f} {odd:.17g}");
    size_t sz = 18446744073709551615;
    double dz = sz;
    println($"{dz:.0f}");
    int neg = -5;
    double dn = neg;
    println($"{dn:.1f} {neg:.1f}");
    return 0;
}
