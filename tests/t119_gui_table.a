// window maximize, TableView (sorting, selection, keyboard) and TreeView (expanding, lazy children, keyboard)
import wsrv;
import gui;
import guix;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
int selects = 0;
int activates = 0;
int expands = 0;
int resizes = 0;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

int onSelect(int self) { selects++; return 0; }
int onActivate(int self) { activates++; return 0; }
int onResize(int self) { resizes++; return 0; }

guix.TreeView* tree;
int onExpand(int self) {
    expands++;
    guix.TreeNode* n = tree->expandedNode;
    if (n->lazy && n->count == 0) {
        n->add("loaded 1");
        n->add("loaded 2");
    }
    return 0;
}

void key(int k) {
    hb->tap(k, 0);
    settle();
}

void clickIn(gui.Window* gw, gui.Widget* wd, int x, int y) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, gw->id);
    hb->click(sw->x + wd->absX() + x, sw->y + wd->absY() + y);
    settle();
}

void column(guix.TableView* t, int c) {
    for (int r = 0; r < t->rowCount(); r++) {
        print(t->cell(r, c));
        print(" ");
    }
    println("");
}

int main() {
    hb = new wsrv.Headless(800, 600);
    srv = new wsrv.Server(hb, 7216);
    gui.idleHook = stepServer;
    d = gui.connectAs("7216", "table");

    // ---- maximize -----------------------------------------------------------------------------------------------------------------------
    gui.Window* w = d->createWindow("Max", 300, 200, 0);
    w->onResize = onResize;
    gui.Box* col = gui.vbox(0, 0);
    guix.TableView* table = new guix.TableView();
    table->addColumn("Name", 120);
    table->addColumn("Size", 70);
    table->addColumn("Kind", 80);
    table->setAlign(1, 1);
    table->onSelect = onSelect;
    table->onActivate = onActivate;
    table->addRow("pear\t10\tfruit");
    table->addRow("Apple\t9\tfruit");
    table->addRow("carrot\t100\troot");
    table->addRow("banana\t-3\tfruit");
    table->addRow("date\t25\tfruit");
    col->add(table);
    w->setRoot(col);
    settle();
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    int ox = sw->x;
    int oy = sw->y;
    printlnInt(sw->w * 1000 + sw->h);
    // a double click on the title bar maximizes
    hb->click(sw->x + 60, sw->y - 13);
    hb->click(sw->x + 60, sw->y - 13);
    settle();
    printlnInt(sw->maximized);
    printlnInt(sw->x * 1000 + sw->y);
    printlnInt(sw->w * 1000 + sw->h);
    printlnInt(w->w * 1000 + w->h);
    printlnInt(resizes > 0);
    // it cannot be dragged or resized while maximized; the button on the title bar puts it back
    hb->click(sw->x + sw->w - 34, sw->y - 13);
    settle();
    printlnInt(sw->maximized);
    printlnInt(sw->x == ox && sw->y == oy);
    printlnInt(sw->w * 1000 + sw->h);
    printlnInt(w->w * 1000 + w->h);
    hb->click(sw->x + sw->w - 34, sw->y - 13);
    settle();
    printlnInt(sw->maximized);
    hb->click(sw->x + sw->w - 34, sw->y - 13);
    settle();
    printlnInt(sw->maximized);
    // a window that cannot be resized has no such button
    gui.Window* fixed = d->createWindow("Fixed", 200, 100, adp.F_FIXED);
    fixed->setRoot(new gui.Label("fixed"));
    settle();
    wsrv.Win* fw = srv->findWindow(d->clientNum, fixed->id);
    hb->click(fw->x + fw->w - 34, fw->y - 13);
    hb->click(fw->x + fw->w - 34, fw->y - 13);
    settle();
    printlnInt(fw->maximized);
    fixed->close();
    settle();

    // ---- the table ---------------------------------------------------------------------------------------------------------------------
    printlnInt(table->rowCount() * 10 + table->columnCount());
    table->focusMe();
    clickIn(w, table, 40, 26 + 1 + 24 * 2 + 12);
    printlnInt(table->selected);
    println(table->cell(table->selected, 0));
    key(adp.KEY_DOWN);
    println(table->cell(table->selected, 0));
    key(adp.KEY_END);
    printlnInt(table->selected);
    key(adp.KEY_HOME);
    printlnInt(table->selected);
    key(adp.KEY_ENTER);
    printlnInt(activates);
    printlnInt(selects);
    // sort by the name column (case-insensitive), then again for the other direction
    clickIn(w, table, 30, 10);
    column(table, 0);
    println(table->cell(table->selected, 0));
    clickIn(w, table, 30, 10);
    column(table, 0);
    // numbers sort by value
    clickIn(w, table, 150, 10);
    column(table, 1);
    clickIn(w, table, 150, 10);
    column(table, 1);
    // dragging the edge of a column header changes its width
    int before = table->prefW();
    wsrv.Win* sw2 = srv->findWindow(d->clientNum, w->id);
    int ey = sw2->y + table->absY() + 10;
    int ex = sw2->x + table->absX() + 1 + 120;
    hb->moveTo(ex, ey);
    hb->buttonDown(1);
    hb->moveTo(ex + 30, ey);
    hb->buttonUp(1);
    settle();
    printlnInt(table->prefW() - before);
    // the wheel scrolls (the window is big enough to show everything, so nothing moves) and clearing empties the table
    table->clear();
    printlnInt(table->rowCount());

    // ---- the tree ----------------------------------------------------------------------------------------------------------------------
    gui.Window* w2 = d->createWindow("Tree", 260, 300, 0);
    tree = new guix.TreeView();
    tree->onSelect = onSelect;
    tree->onExpand = onExpand;
    guix.TreeNode* a = tree->addRoot("A");
    a->add("A1");
    guix.TreeNode* a2 = a->add("A2");
    a2->lazy = true;
    guix.TreeNode* b = tree->addRoot("B");
    gui.Box* col2 = gui.vbox(0, 0);
    col2->add(tree);
    w2->setRoot(col2);
    settle();
    tree->focusMe();
    settle();
    key(adp.KEY_DOWN);
    println(tree->selected->text);
    key(adp.KEY_RIGHT);
    key(adp.KEY_DOWN);
    println(tree->selected->text);
    key(adp.KEY_DOWN);
    println(tree->selected->text);
    key(adp.KEY_RIGHT);
    printlnInt(expands);
    key(adp.KEY_DOWN);
    println(tree->selected->text);
    key(adp.KEY_LEFT);
    println(tree->selected->text);
    key(adp.KEY_LEFT);
    printlnInt(a2->expanded);
    key(adp.KEY_LEFT);
    println(tree->selected->text);
    key(adp.KEY_LEFT);
    printlnInt(a->expanded);
    key(adp.KEY_DOWN);
    println(tree->selected->text);
    // the mouse: the arrow of A opens it, a click on a row selects it, a double click on B toggles it
    clickIn(w2, tree, 4 + 6, 1 + 11);
    printlnInt(a->expanded);
    clickIn(w2, tree, 60, 1 + 22 * 1 + 11);
    println(tree->selected->text);
    printlnInt(selects > 0);
    d->disconnect();
    srv->close();
    return 0;
}
