// matrix: complex matrices (parallel real / imaginary arrays): arithmetic, conjugate transpose, determinant and linear systems, errors.
// Expected output: tests/algo2_ref/gen_t445.py (exact Gaussian rational arithmetic).
import cstdio;
import asys;
import matrix;
import dmath;

int seed = 2718;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

double clean(double v) { return (v < 1.0e-11 && v > -1.0e-11) ? 0.0 : v; }

void dumpC(char* name, matrix.CMatrix* m) {
    printf("%s %d %d:", name, m->rows, m->cols);
    for (int i = 0; i < m->rows * m->cols; i++) { printfd(" (%.9g, %.9g)", __bits(clean(m->re[i])), __bits(clean(m->im[i]))); }
    printf("\n");
}

void fillRandom(matrix.CMatrix* m) {
    for (int i = 0; i < m->rows * m->cols; i++) {
        m->re[i] = (double) (lcg() % 11 - 5);
        m->im[i] = (double) (lcg() % 11 - 5);
    }
}

int main() {
    int base = asys.memInUse();
    matrix.CMatrix a(3, 3);
    matrix.CMatrix b(3, 3);
    fillRandom(&a);
    fillRandom(&b);
    dumpC("A", &a);
    dumpC("B", &b);
    matrix.CMatrix s = a.add(&b);
    dumpC("A+B", &s);
    matrix.CMatrix d = a.sub(&b);
    dumpC("A-B", &d);
    matrix.CMatrix p = a.mul(&b);
    dumpC("A*B", &p);
    matrix.CMatrix h = a.conjTranspose();
    dumpC("A^H", &h);
    matrix.CMatrix k = a.scaled(0.0, 1.0);                 // times i
    dumpC("i A", &k);
    double tr;
    double ti;
    a.trace(&tr, &ti);
    printfd("trace (%g, %g)\n", __bits(tr), __bits(ti));
    printfd("normFro %.9g\n", __bits(a.normFro()));
    double xr[3] = {1, -1, 2};
    double xi[3] = {0.5, 2, -1};
    double yr[3];
    double yi[3];
    printf("mulVec %d\n", a.mulVec(xr, xi, yr, yi));
    printfd("A x = (%g, %g) (%g, %g) (%g, %g)\n", __bits(yr[0]), __bits(yi[0]), __bits(yr[1]), __bits(yi[1]), __bits(yr[2]), __bits(yi[2]));
    double dr;
    double di;
    printf("det status %d\n", a.det(&dr, &di));
    printfd("det (%.9g, %.9g)\n", __bits(dr), __bits(di));
    double br[3] = {3, -2, 1};
    double bi[3] = {1, 4, -2};
    double sr[3];
    double si[3];
    printf("solve status %d\n", a.solve(br, bi, sr, si));
    printfd("x = (%.9g, %.9g) (%.9g, %.9g) (%.9g, %.9g)\n", __bits(sr[0]), __bits(si[0]), __bits(sr[1]), __bits(si[1]), __bits(sr[2]), __bits(si[2]));
    // A x = b?
    a.mulVec(sr, si, yr, yi);
    double worst = 0.0;
    for (int i = 0; i < 3; i++) {
        worst = dmath.fmax(worst, dmath.fabs(yr[i] - br[i]));
        worst = dmath.fmax(worst, dmath.fabs(yi[i] - bi[i]));
    }
    printf("A x = b (1e-12): %d\n", worst < 1.0e-12);
    // in place
    double ar[3] = {3, -2, 1};
    double ai2[3] = {1, 4, -2};
    a.solve(ar, ai2, ar, ai2);
    printf("in place gives the same: %d\n", ar[0] == sr[0] && ai2[2] == si[2]);
    printf("mulVec aliasing: %d\n", a.mulVec(xr, xi, xr, yi));
    matrix.CMatrix n1 = a.add(null);
    matrix.CMatrix n2 = a.mul(null);
    matrix.CMatrix w(2, 2);
    matrix.CMatrix n3 = a.add(&w);
    printf("errors: add(null) %d, mul(null) %d, add of other shape %d (ERR_ARG = %d, ERR_DIM = %d)\n", n1.err, n2.err, n3.err, matrix.ERR_ARG, matrix.ERR_DIM);
    w.dispose();

    // the identity and a singular matrix
    matrix.CMatrix id(3, 3);
    id.setIdentity();
    printf("det of the identity: ");
    id.det(&dr, &di);
    printfd("(%g, %g)\n", __bits(dr), __bits(di));
    matrix.CMatrix sg(2, 2);
    sg.set(0, 0, 1.0, 1.0);
    sg.set(0, 1, 2.0, 0.0);
    sg.set(1, 0, 2.0, 2.0);
    sg.set(1, 1, 4.0, 0.0);                                  // the second row is twice the first times (1 + i)... exactly singular
    double r2[2] = {1, 1};
    double i2[2] = {0, 0};
    double x2[2];
    double y2[2];
    printf("singular solve: %d (ERR_SINGULAR = %d)\n", sg.solve(r2, i2, x2, y2), matrix.ERR_SINGULAR);
    sg.det(&dr, &di);
    printfd("singular det (%g, %g)\n", __bits(dr), __bits(di));
    // not finite
    a.re[4] = __dbl(0x7FF8000000000000);
    printf("NaN: solve %d, det %d\n", a.solve(br, bi, sr, si), a.det(&dr, &di));
    a.re[4] = 1.0;
    matrix.CMatrix r(2, 3);
    printf("2x3: det %d, solve %d (ERR_DIM = %d)\n", r.det(&dr, &di), r.solve(r2, i2, x2, y2), matrix.ERR_DIM);
    matrix.CMatrix e(0, 4);
    printf("empty: ok %d err %d\n", e.ok(), e.err);
    printf("set out of range %d, getRe NaN %d\n", a.set(3, 0, 1.0, 1.0), a.getRe(0, 9) != a.getRe(0, 9));
    matrix.CMatrix c = a.copy();
    printf("copy: %d\n", c.getRe(2, 1) == a.getRe(2, 1) && c.getIm(2, 1) == a.getIm(2, 1) && c.re != a.re);
    c.dispose(); r.dispose(); id.dispose(); sg.dispose(); a.dispose(); b.dispose(); s.dispose(); d.dispose(); p.dispose(); h.dispose(); k.dispose();
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
