// codec + nn: converters feeding neural networks
import codec;
import nn;
import fixed;

nn.Network* ocr;
char* alphabet = "ABCDEFGHIJ0123456789";

// the recogniser used by codec.imageToTextWith: a trained network
int recognise(int* glyph) {
    int cls = ocr->predict(glyph);
    return alphabet[cls];
}

int main() {
    int ONE = fixed.ONE;
    fixed.seed(11);

    // --- vectors from text and back
    int v[64];
    codec.textToVector("Hi", v, 4, false);
    printlnInt(v[1] == ONE);          // 'H' = 01001000
    printlnInt(v[0]);
    char buf[8];
    println(codec.vectorToText(v, 4, buf, false));
    codec.textToVector("Hi", v, 4, true);
    printlnInt(v[0] == -ONE);
    println(codec.vectorToText(v, 4, buf, true));
    int oh[10];
    codec.oneHot(3, oh, 10);
    printlnInt(codec.fromOneHot(oh, 10));

    // --- a Hopfield memory holds two pictures; a damaged picture is repaired
    codec.Image* a = codec.textToImage("A", 1);
    codec.Image* b = codec.textToImage("B", 1);
    int n = a->w * a->h;
    char bitsA[128]; char bitsB[128];
    int sa[128]; int sb[128];
    codec.imageToBits(a, 128, bitsA); codec.bitsToSigns(bitsA, n, sa);
    codec.imageToBits(b, 128, bitsB); codec.bitsToSigns(bitsB, n, sb);
    nn.Hopfield* hf = new nn.Hopfield(n);
    hf->store(sa);
    hf->store(sb);
    int probe[128];
    for (int i = 0; i < n; i++) probe[i] = sa[i];
    for (int k = 0; k < 5; k++) probe[(k * 7) % n] = -probe[(k * 7) % n];       // damage 5 pixels
    printlnInt(hf->recall(probe, 20) > 0);
    char fixedBits[128];
    codec.signsToBits(probe, n, fixedBits);
    codec.Image* repaired = codec.bitsToImage(fixedBits, a->w, a->h);
    println(codec.imageToText(repaired, 1));

    // --- a network learns to read the characters of the font, then reads an image
    int cls = strlen(alphabet);
    int* x = nn.vec(cls * 40);
    int* t = nn.vec(cls * cls);
    codec.fontSet(alphabet, x, t);
    int sz[3]; sz[0] = 40; sz[1] = 24; sz[2] = cls;
    ocr = new nn.Network(3, sz, nn.ACT_TANH, nn.ACT_SOFTMAX);
    ocr->fit(x, t, cls, 300, fixed.fromText("0.2"), 0);
    printlnInt(ocr->accuracy(x, t, cls));
    codec.Image* page = codec.textToImage("CAFE 2024\n1J B0A", 3);
    println(codec.imageToTextWith(page, 3, recognise));
    println(codec.imageToText(page, 3));

    // the nearest glyph also repairs a noisy vector
    int g[40];
    codec.glyphVector('G', g);
    g[3] = ONE - g[3];
    g[17] = ONE - g[17];
    printlnInt(codec.glyphChar(g));

    // --- pixels as network input and back
    codec.Image* small = codec.textToImage("X", 1);
    int* pv = nn.vec(small->w * small->h);
    codec.imageToVector(small, pv, true);
    codec.Image* round = codec.vectorToImage(pv, small->w, small->h, true);
    printlnInt(round->px[10] == small->px[10] && round->px[8 * small->w + 1] == small->px[8 * small->w + 1]);
    return 0;
}
