// generated by tests/gen/gen_https_test.py (test certificates, valid until 2100): do not edit
char* CA_PEM = "-----BEGIN CERTIFICATE-----\nMIIBLjCB1aADAgECAggQvbB9NiqTqjAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjASMRAwDgYD\nVQQDDAdUZXN0IENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEZoa0iPF3loM9\nqz2/ImJLRjibLJ9hd1WdtHD49KKzTbauTzUXNZX0JXbYVQF1P3l/QpVkXnf50+NE\n5T+hdgwFwaMTMBEwDwYDVR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDAgNIADBFAiAi\n2nMi9gLSWn22okG7qxH4QY8cymApI39Z6xKucwY6DQIhAJGEtUeEhQhgL/OMhpvm\ngSel0jdLf5pEleFCFoHzH7Hn\n-----END CERTIFICATE-----\n";
char* SERVER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPTCB5aADAgECAghotNTSsBOFvDAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAUMRIwEAYD\nVQQDDAkxMjcuMC4wLjEwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASQo30/KSJR\nbLR0qkuSKMRwxN2Xvd08KFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA\n0tODiEQ9MEeCoyEwHzAMBgNVHRMBAf8EAjAAMA8GA1UdEQQIMAaHBH8AAAEwCgYI\nKoZIzj0EAwIDRwAwRAIgU64nzo1fbN1Q020h4M68boDulT6ZPr2sHq2luv7FldQC\nIC+L4vvfr326IW2u5O57h04274NWnE7Q40w44uqIwI8m\n-----END CERTIFICATE-----\n";
char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";

// netio.Link and net.waitWritable run net.setIdleHook while they wait for a socket that is full: one thread plays both ends of a connection.
// The sink server is polled only from the hook and does not read at first: the socket is filled until it takes no more bytes, and only then
// can a Link.sendAll finish, namely when the wait runs the hook (it used to stall: sendAll waited with a plain poll, which broke every
// netio user on AOS with its 64 KiB socket buffers). Also: a time limit still ends the wait, waitWritable(h, 0) never runs the hook, and a
// large send over TLS. (How many bytes the socket buffers take differs from system to system: the test fills them instead of guessing.)
import net;
import netio;
import netsrv;
import tls;
import x509;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

netsrv.Server* srv;
int hookCalls = 0;
int sinkBytes = 0;
int sinkHash = 0;

bool drain = true;                  // false: the hook does not serve the sink (its socket buffers fill up)

int hook() {
    hookCalls++;
    if (srv != null && drain) srv->poll(0);
    return 0;
}

int hashOf(int h, char* d, int n) {
    for (int i = 0; i < n; i++) h = (h * 31 + (d[i] & 255)) & 0xFFFFFFF;
    return h;
}

int onOpen(netsrv.Server* s, netsrv.Conn* c) { return 0; }
int onData(netsrv.Server* s, netsrv.Conn* c, char* d, int n) {
    sinkBytes = sinkBytes + n;
    sinkHash = hashOf(sinkHash, d, n);
    return 0;
}
int onClose(netsrv.Server* s, netsrv.Conn* c) { return 0; }

char* makeData(int n) {
    char* d = alloc(n);
    for (int i = 0; i < n; i++) d[i] = i * 7 + i / 251;
    return d;
}

// waits (serving the sink) until `want` bytes have arrived, at most 5 s
bool arrived(int want) {
    int t0 = millis();
    while (sinkBytes < want && millis() - t0 < 5000) srv->poll(2);
    return sinkBytes == want;
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    srv = new netsrv.Server();
    srv->onOpen = onOpen;
    srv->onData = onData;
    srv->onClose = onClose;
    check("the sink server listens (plain and TLS)", srv->listenOn("127.0.0.1", 0, null) && srv->listenOn("127.0.0.1", 0, good));
    int plainPort = srv->listenerPort(0);
    int tlsPort = srv->listenerPort(1);
    net.setIdleHook(hook);

    // ---- a plain Link: the sink does not read until the socket is full --------------------------------------------------------------------------------------------------
    int n = 1000000;
    char* data = makeData(n);
    netio.Link* l = netio.newLink();
    check("a Link connects", l->open("127.0.0.1", plainPort, 3000, false, false));
    drain = false;
    int want = 0;
    int filled = 0;
    int calls = 0;
    for (; calls < 4000; calls++) {
        int r = l->send(data, 16384);
        if (r <= 0) break;
        want = hashOf(want, data, r);
        filled = filled + r;
    }
    check("the Link is filled until send says 0 (the socket takes no more)", calls < 4000 && filled > 0);
    drain = true;
    int h0 = hookCalls;
    check("sendAll of 1000000 more bytes returns true (its wait runs the hook, the sink drains the socket)", l->sendAll(data, n, 20000));
    check("... the hook ran while it waited", hookCalls > h0);
    want = hashOf(want, data, n);
    check("... every byte arrived", arrived(filled + n));
    check("... unchanged, in order", sinkHash == want);

    // ---- the time limit of sendAll still counts when nobody drains the socket --------------------------------------------------------------------------------------------
    int fl = net.listen(0, 4);
    int flPort = net.localPort(fl);
    netio.Link* stuck = netio.newLink();
    check("a Link to a listener that never reads", stuck->open("127.0.0.1", flPort, 3000, false, false));
    int t0 = millis();
    check("sendAll of 20 MB with a limit of 300 ms gives up (false)", !stuck->sendAll(alloc(20000000), 20000000, 300));
    int dt = millis() - t0;
    check("... after about the limit, not after seconds", dt >= 250 && dt < 4000);
    check("... the link is still open (only a failed connection closes it)", stuck->isOpen());

    // ---- net.waitWritable ---------------------------------------------------------------------------------------------------------------------------------------------------
    int c0 = net.accept(fl);                    // the connection of `stuck`
    int fh = net.connectTimeout("127.0.0.1", flPort, 3000);
    check("a plain socket to the same listener", fh >= 0);
    int c = net.accept(fl);
    check("the listener has both connections", c0 >= 0 && c >= 0);
    net.setNonBlocking(fh, true);
    int total = 0;
    int guard = 0;
    for (; guard < 2000; guard++) {
        int r = net.sendSome(fh, data, 65536);
        if (r <= 0) break;
        total = total + r;
    }
    check("it is filled until sendSome says 0 (the buffers are full)", guard < 2000 && total > 0);
    h0 = hookCalls;
    t0 = millis();
    check("waitWritable(h, 60) on the full socket: false after the time", !net.waitWritable(fh, 60) && millis() - t0 >= 50);
    check("... and the idle hook ran meanwhile", hookCalls > h0);
    h0 = hookCalls;
    check("waitWritable(h, 0) is a plain test: false, the hook does not run", !net.waitWritable(fh, 0) && hookCalls == h0);
    // the other end reads everything: the socket is writable again
    char* sink = alloc(65536);
    int got = 0;
    int t1 = millis();
    while (got < total && millis() - t1 < 5000) {
        if (!net.waitReadable(c, 50)) continue;
        int r = net.recv(c, sink, 65536);
        if (r <= 0) break;
        got = got + r;
    }
    check("the other end reads what was sent", got == total);
    check("waitWritable(h, 2000) is true again", net.waitWritable(fh, 2000));
    net.close(fh);
    net.close(c);
    net.close(c0);
    stuck->dispose();
    net.close(fl);

    // ---- over TLS (the sink is served from the hook; whether the hook is needed depends on the size of the socket buffers) -------------------------------------------------------
    sinkBytes = 0;
    sinkHash = 0;
    int tn = 600000;
    int twant = hashOf(0, data, tn);
    netio.Link* t = netio.newLink();
    check("a TLS Link connects (certificate verified)", t->open("127.0.0.1", tlsPort, 5000, true, true));
    check("sendAll of 600000 bytes over TLS", t->sendAll(data, tn, 20000));
    check("... every byte arrived, unchanged", arrived(tn) && sinkHash == twant);
    t->dispose();
    l->dispose();

    net.setIdleHook(null);
    for (int i = 0; i < 20; i++) srv->poll(1);
    check("the server has no connection left", srv->count() == 0);
    srv->shutdown();
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
