// sized and unsigned integers: int8_t ... uint64_t, short / unsigned, C struct layout; checked against GCC
typedef unsigned char uint8_t;          // C headers may say this: the built-in type stays

struct Mix { char a; int16_t b; int32_t c; uint8_t d; }
struct Vec3 { float x; float y; float z; }
struct Pair { int8_t a; int b; }
struct Inner { int8_t x; int8_t y; }
struct Outer { int16_t a; Inner s; int8_t c; }
struct Px { uint8_t r; uint8_t g; uint8_t b; uint8_t a; }

int16_t g16 = -2;
uint8_t gtab[4] = {1, 255, 256, -1};
uint32_t gu32 = 0xFFFFFFFF;
int32_t garr[3] = {-1, 2147483647, -2147483648};

int8_t inc8(int8_t x) { return x + 1; }
uint16_t to16(int x) { return x; }
int sum16(int16_t a, uint16_t b) { return a + b; }
uint64_t umax() { return -1; }

void p(int v) { printInt(v); print(" "); }
void nl() { println(""); }

int main() {
    p(sizeof(int8_t)); p(sizeof(int16_t)); p(sizeof(int32_t)); p(sizeof(int64_t));
    p(sizeof(uint8_t)); p(sizeof(uint16_t)); p(sizeof(uint32_t)); p(sizeof(uint64_t));
    p(sizeof(short)); p(sizeof(unsigned short)); p(sizeof(unsigned)); p(sizeof(unsigned long)); p(sizeof(long)); nl();
    p(sizeof(Mix)); p(sizeof(Vec3)); p(sizeof(Pair)); p(sizeof(Inner)); p(sizeof(Outer)); p(sizeof(Px)); nl();
    Mix m;
    p((int)&m.b - (int)&m); p((int)&m.c - (int)&m); p((int)&m.d - (int)&m);
    Outer o;
    p((int)&o.s - (int)&o); p((int)&o.c - (int)&o); nl();

    int8_t a = 200; uint8_t b = 300; int16_t c = 40000; uint16_t d = -1; int32_t e = 3000000000; uint32_t f = -1;
    p(a); p(b); p(c); p(d); p(e); p(f); nl();
    int big = 1000000;
    a = big; b = big; c = big; d = big; e = big * big; f = big * big;
    p(a); p(b); p(c); p(d); p(e); p(f); nl();
    p(b = 513); p(a = 129); p(c = -32769); nl();
    uint8_t x = 255; p(++x); p(x++); p(x);
    int8_t y = 127; y++; p(y); y--; p(y); --y; p(y); nl();
    p((int8_t)255); p((uint16_t)-2); p((uint32_t)(int32_t)-5); p((int16_t)70000); p((int8_t)big); p((uint8_t)200.7); p((int16_t)-300.9); nl();

    int16_t arr[5];
    p(sizeof(arr));
    for (int i = 0; i < 5; i++) arr[i] = i * 10000;
    for (int i = 0; i < 5; i++) p(arr[i]);
    int32_t a32[3] = {1, 2, 3};
    int32_t* q = a32;
    p((int)(q + 1) - (int)q); p(*(q + 2)); nl();

    p(inc8(127)); p(to16(70000)); p(sum16(-1, 65535)); p(sum16(70000, 70000)); nl();

    uint64_t u = 0xFFFFFFFFFFFFFFFF;
    p(u / 3); p(u % 7); p(u >> 60); p(u > 1); p(u < 1); p(u >= 0); p(u > -1); p(u == -1);
    uint64_t h = (uint64_t)1 << 63;
    p(h > 5); p(h / 2); p(h % 1000); p(h >> 62); p(umax() / 10); nl();
    int s = -9;
    p(s / 2); p(s % 4); p(s >> 1); p((uint64_t)s / 2); p((uint64_t)s >> 1); p((uint64_t)s % 4); nl();
    if (u > 100) p(1); else p(0);
    if ((uint64_t)s < 5) p(1); else p(0);
    int cnt = 0;
    for (uint64_t k = 0xFFFFFFFFFFFFFFF0; k > 10; k++) cnt++;
    p(cnt); nl();

    double dd = u;
    p(__bits(dd)); p(__bits((double)h)); p(__bits((double)(uint64_t)12345)); p(__bits(u * 1.0));
    uint64_t back = 1e19; p(back); p((uint64_t)1.8e19); p((uint64_t)3.9); nl();

    Mix mm;
    mm.a = 300; mm.b = 70000; mm.c = -1; mm.d = 256;
    p(mm.a); p(mm.b); p(mm.c); p(mm.d); mm.b += 30000; p(mm.b); mm.d -= 1; p(mm.d); nl();
    p(g16); p(gtab[0]); p(gtab[1]); p(gtab[2]); p(gtab[3]); p(gu32); p(garr[0]); p(garr[1]); p(garr[2]); nl();

    unsigned short us = 70000; short sh = 40000; unsigned un = -1; unsigned long ul = -1; signed char sc = 200;
    long lg = (long)1 << 40; unsigned int ui = 4294967296 + 7; long long ll = -3; unsigned long long ull = 5;
    p(us); p(sh); p(un); p(ul > 0); p(sc); p(lg); p(ui); p(ll); p(ull); nl();

    uint8_t cc = 250; cc += 10; p(cc); cc *= 3; p(cc);
    uint64_t cu = 100; cu /= 3; p(cu); cu = -1; cu >>= 1; p(cu); cu = -1; cu %= 10; p(cu);
    int16_t sm = 32767; sm += 1; p(sm); sm <<= 1; p(sm); nl();

    uint32_t mk = 0xF0F0F0F0; p(~mk); uint32_t nm = ~mk; p(nm); p(mk >> 4); p(-mk);
    int8_t n1 = -1; uint8_t n2 = 255; p(n1 == n2); p(n1 < n2); nl();

    Px pix[3];
    p(sizeof(pix)); p((int)&pix[2] - (int)&pix[0]);
    pix[1].g = 511; p(pix[1].g); nl();
    Vec3 vv[2]; p((int)&vv[1].y - (int)&vv[0].x); vv[1].y = 2.5; p(__bits((double)vv[1].y)); nl();
    return 0;
}
