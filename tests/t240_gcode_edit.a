// gcode.CodeEditor: typing, selecting, undo and redo, auto indent, UTF-8 input, clipboard, line commands, several cursors, read-only
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;
int changes = 0;
int cursors = 0;
int onChanged(int ed) { changes++; return 0; }
int onCursorMoved(int ed) { cursors++; return 0; }

// the text with line breaks shown as |, then the caret and the selection
void show(char* label) {
    char* t = e->getText();
    char out[400];
    int n = 0;
    for (int i = 0; t[i] != 0 && n < 380; i++) {
        out[n] = (t[i] == 10) ? '|' : (t[i] == 9) ? '>' : t[i];
        n++;
    }
    out[n] = 0;
    asys.free(t);
    printf("%s: [%s] caret %d", label, &out[0], e->ed->caret());
    if (e->ed->anySelection()) { printf(" sel %d-%d", e->ed->selStart(e->ed->primary), e->ed->selEnd(e->ed->primary)); }
    if (e->ed->ncur > 1) { printf(" cursors %d", e->ed->ncur); }
    printf("\n");
}

void gcodeGoto(int line, int col) { e->gotoLine(line, col); settle(); }

void shift(int k) { keyMods(k, 0, adp.MOD_SHIFT); }

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;       // a click or a key then repaints one row, not the window: much faster under emulation
    gcode.theLook()->matchBrackets = false;      // no popup while typing: keys such as Enter keep their meaning
    startServer(7340, "t240");
    w = d->createWindow("Editor", 640, 400, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    e->onChange = onChanged;
    e->onCursor = onCursorMoved;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    settle();

    // typing, Enter, Home / End, selecting with Shift, typing over a selection
    typeStr("Hello");
    show("typed");
    key(adp.KEY_ENTER, 13);
    typeStr("World");
    show("two lines");
    key(adp.KEY_HOME, 0);
    show("home");
    key(adp.KEY_END, 0);
    shift(adp.KEY_LEFT);
    shift(adp.KEY_LEFT);
    shift(adp.KEY_LEFT);
    show("shift left x3");
    typeStr("x");
    show("replaced");
    printf("changes %d cursor events %d\n", changes, cursors);

    // select all, collapse, word motions
    ctrl('a');
    show("select all");
    key(adp.KEY_LEFT, 0);
    show("collapsed");
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_CTRL);
    show("ctrl+right");
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    show("ctrl+shift+right");
    keyMods(adp.KEY_END, 0, adp.MOD_CTRL);
    show("ctrl+end");
    keyMods(adp.KEY_HOME, 0, adp.MOD_CTRL);
    show("ctrl+home");

    // undo and redo
    keyMods(adp.KEY_END, 0, adp.MOD_CTRL);
    typeStr(" ab");
    show("typed ab");
    ctrl('z');
    show("undo");
    ctrl('z');
    show("undo again");
    keyMods('z', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    show("redo (ctrl+shift+z)");
    ctrl('y');
    show("redo (ctrl+y)");

    // auto indent and electric }
    e->setText("");
    typeStr("int main() {");
    key(adp.KEY_ENTER, 13);
    typeStr("return 0;");
    key(adp.KEY_ENTER, 13);
    typeStr("}");
    show("auto indent");

    // Tab, Shift+Tab, tabs instead of spaces, smart backspace
    e->setText("x");
    key(adp.KEY_HOME, 0);
    key(adp.KEY_TAB, 9);
    show("tab");
    keyMods(adp.KEY_TAB, 9, adp.MOD_SHIFT);
    show("shift+tab");
    e->ed->useTabs = true;
    key(adp.KEY_TAB, 9);
    show("tab with useTabs");
    e->ed->useTabs = false;
    e->setText("        y");
    key(adp.KEY_HOME, 0);
    key(adp.KEY_HOME, 0);
    show("smart home toggles");
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_RIGHT, 0);
    key(adp.KEY_BACKSPACE, 8);
    show("smart backspace");
    key(adp.KEY_DELETE, 127);
    show("delete");
    e->setText("one two three");
    key(adp.KEY_END, 0);
    keyMods(adp.KEY_BACKSPACE, 8, adp.MOD_CTRL);
    show("ctrl+backspace");
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_DELETE, 127, adp.MOD_CTRL);
    show("ctrl+delete");

    // UTF-8 text input: 2, 3 and 4 byte characters
    e->setText("");
    hb->tap(0, 0xE4);
    hb->tap(0, 0x20AC);
    hb->tap(0, 0x1F600);
    settle();
    printf("utf8 bytes %d chars %d caret %d\n", e->buf->length(), e->buf->countChars(0, e->buf->length()), e->ed->caret());
    key(adp.KEY_LEFT, 0);
    key(adp.KEY_BACKSPACE, 8);
    show("one character left of the emoji removed (bytes now)");
    printf("bytes %d\n", e->buf->length());

    // the clipboard of the display server: copy, paste, cut, whole lines
    e->setText("alpha beta gamma");
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    ctrl('c');
    printf("clipboard [%s]\n", d->clipText);
    key(adp.KEY_END, 0);
    ctrl('v');
    show("pasted");
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    ctrl('x');
    printf("clipboard [%s]\n", d->clipText);
    show("cut");
    e->setText("one\ntwo\nthree");
    gcodeGoto(1, 1);
    ctrl('c');
    printf("clipboard has %d bytes, a line\n", (int) strlen(d->clipText));
    gcodeGoto(2, 2);
    ctrl('v');
    show("whole line pasted above");

    // line commands
    e->setText("a\nb\nc");
    gcodeGoto(1, 0);
    keyMods(adp.KEY_UP, 0, adp.MOD_ALT);
    show("alt+up");
    keyMods(adp.KEY_DOWN, 0, adp.MOD_ALT);
    keyMods(adp.KEY_DOWN, 0, adp.MOD_ALT);
    show("alt+down x2");
    keyMods('k', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    show("ctrl+shift+k");
    keyMods('d', 0, adp.MOD_CTRL | adp.MOD_SHIFT);
    show("ctrl+shift+d duplicate");
    e->setText("one\ntwo");
    gcodeGoto(0, 0);
    keyMods('j', 0, adp.MOD_CTRL);
    show("ctrl+j join");
    e->setText("code();");
    e->doc->setLanguage(asyntax.Lang.A);
    keyMods('/', 0, adp.MOD_CTRL);
    show("ctrl+/ comment");
    keyMods('/', 0, adp.MOD_CTRL);
    show("ctrl+/ uncomment");
    keyMods(']', 0, adp.MOD_CTRL);
    show("ctrl+] indent");
    keyMods('[', 0, adp.MOD_CTRL);
    show("ctrl+[ outdent");

    // several cursors: Ctrl+D selects the next occurrence, typing changes all
    e->setText("a b a b a");
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_RIGHT, 0, adp.MOD_SHIFT);
    ctrl('d');
    ctrl('d');
    show("ctrl+d x2");
    typeStr("X");
    show("typed over three cursors");
    key(adp.KEY_ESCAPE, 27);
    show("escape");
    e->setText("abc\ndef\nghi");
    gcodeGoto(0, 1);
    keyMods(adp.KEY_DOWN, 0, adp.MOD_CTRL | adp.MOD_ALT);
    keyMods(adp.KEY_DOWN, 0, adp.MOD_CTRL | adp.MOD_ALT);
    show("ctrl+alt+down x2");
    typeStr("-");
    show("typed in a column");
    key(adp.KEY_ESCAPE, 27);
    show("escape");

    // read only: movements work, copying works, nothing changes
    e->setText("fixed text");
    e->setReadOnly(true);
    key(adp.KEY_END, 0);
    typeStr("zz");
    key(adp.KEY_BACKSPACE, 8);
    key(adp.KEY_ENTER, 13);
    show("read only typed");
    ctrl('a');
    ctrl('x');
    show("read only cut");
    printf("clipboard [%s]\n", d->clipText);
    ctrl('v');
    show("read only paste");
    e->setReadOnly(false);
    typeStr("!");
    show("writable again");
    return 0;
}
