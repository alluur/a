#define N 5
#define SQUARE(x) ((x) * (x))
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define STR(x) #x
#define CAT(a, b) a##b
#define LOG(...) println(__VA_ARGS__)
#define TWICE(f, x) f(f(x))
#define SELF SELF + 1
#define DEBUG 1

#ifdef DEBUG
int mode() { return 1; }
#else
int mode() { return 2; }
#endif

#if N > 3 && defined(DEBUG)
#define BIG 1
#elif N > 1
#define BIG 2
#else
#define BIG 3
#endif

#if defined(VERSION) && VERSION >= 40 && !defined(NOPE)
int newer = 1;
#endif

#if 0
this is not compiled { { (
#error this must not fire
#endif

int CAT(my, Func)(int v) { return v + 1; }  /* block
   comment */ // line comment

int main() {
    printlnInt(N);
    printlnInt(SQUARE(N + 1));
    printlnInt(MAX(3, SQUARE(2)));
    println(STR(hello world));
    printlnInt(myFunc(4));
    printlnInt(mode() + BIG + guarded);
    printlnInt(VERSION);
    printlnInt(ADD(1, 2) * 3);
    printlnInt(helper(VERSION));
    printlnInt(newer);
    printlnInt(SQUARE(MAX(1, 2)));
    println("N is not replaced in strings: N");
    LOG("variadic");
    printlnInt(TWICE(helper, 3));
    int SELF_ = 1;
    printlnInt(__ARCH__ == __ARCH);
    printlnInt(__OS__ == __OS);
    printlnInt(__A__);
#undef N
#define N 10
