// A UDP syslog Sender whose host name cannot be resolved looks it up once per retryIntervalMs, not once per message (run by tests/net2.sh: it needs a name
// that does not resolve, and how that fails depends on the machine's resolver).
import syslog;
import cstdio;

int main(int argc, char** argv) {
    syslog.Sender* s = syslog.newSender(argc > 1 ? argv[1] : "udp://no-such-host.invalid:514");
    s->retryIntervalMs = 300;
    for (int i = 0; i < 5; i++) s->info("hello");
    printf("5 calls: errors=%d dropped=%d sent=%d\n", s->errors, s->dropped, s->sent);
    int ok = s->errors == 1 && s->dropped == 5 && s->sent == 0;
    int t0 = millis();
    while (millis() - t0 < 350) sleepMs(10);
    s->info("hello again");
    printf("after the retry interval: errors=%d dropped=%d\n", s->errors, s->dropped);
    ok = ok && s->errors == 2 && s->dropped == 6;
    println(ok != 0 ? "ok" : "FAIL");
    return ok != 0 ? 0 : 1;
}
