// ds: large inputs (tens to hundreds of thousands of elements, up to 1.6 million bits) must not be quadratic, and must stay correct
// (sized so that the run takes about 1 second natively and stays well under the 60 second limit on riscv64 under qemu-user)
import cstdio;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

// a permutation of 0 ... n-1 style key: the multiplicative hash of i, cut to 40 bits (distinct for i below 2^40 / 1)
int scatter(int i) { return ((i + 1) * 0x9E3779B97F4A7C15) >> 24; }

void ordered() {
    int n = 150000;
    ds.OrderedMap m;
    for (int i = 0; i < n; i++) { m.put(scatter(i), i); }
    check(m.size() == n && m.height() <= 28, "150000 scattered keys, balanced");
    bool ok = true;
    for (int i = 0; i < n; i += 97) { if (m.get(scatter(i), -1) != i) { ok = false; } }
    check(ok, "lookups");
    // rank and select are inverse to each other
    for (int k = 0; k < n; k += 1999) {
        int t = m.select(k);
        if (t < 0 || m.rank(m.keyAt(t)) != k) { ok = false; }
    }
    check(ok, "rank(select(k)) == k");
    // a full ordered walk is linear
    int* keys = (int*) asys.alloc(n * 8);
    int got = m.toArrays(keys, null);
    for (int i = 1; i < got; i++) { if (keys[i - 1] >= keys[i]) { ok = false; } }
    check(got == n && ok, "toArrays is sorted");
    asys.free((char*) keys);
    // remove most keys, then everything
    for (int i = 0; i < n; i++) { if (i % 4 != 0) { m.remove(scatter(i)); } }
    check(m.size() == n / 4 && m.verify(), "after removing three quarters");
    for (int i = 0; i < n; i += 4) { m.remove(scatter(i)); }
    check(m.size() == 0 && m.verify(), "everything removed");
    // sorted insertion
    for (int i = 0; i < n; i++) { m.put(i, i); }
    check(m.height() <= 20 && m.firstKey() == 0 && m.lastKey() == n - 1 && m.countRange(1000, 1999) == 1000, "ascending keys");
    m.dispose();
}

void hash() {
    int n = 400000;
    ds.HashMap m;
    for (int i = 0; i < n; i++) { m.put(i * 7, i); }
    check(m.size() == n, "400000 keys");
    bool ok = true;
    for (int i = 0; i < n; i += 13) { if (m.get(i * 7, -1) != i) { ok = false; } }
    check(ok && !m.has(3), "lookups");
    for (int i = 0; i < n; i += 2) { m.remove(i * 7); }
    check(m.size() == n / 2 && m.verify(), "half removed");
    for (int i = 0; i < n; i += 2) { m.put(i * 7, -i); }
    check(m.size() == n && m.get(14, 0) == -2 && m.get(7, 0) == 1, "and put again");
    m.dispose();
    // keys that are all multiples of a power of two (bad for a plain modulo table)
    ds.HashMap p;
    for (int i = 0; i < 80000; i++) { p.put(i * 65536, i); }
    ok = true;
    for (int i = 0; i < 80000; i += 7) { if (p.get(i * 65536, -1) != i) { ok = false; } }
    check(ok && p.size() == 80000, "keys that are multiples of 65536");
    p.dispose();
    ds.TextHashMap t;
    char key[24];
    for (int i = 0; i < 80000; i++) {
        format(&key[0], 24, "key-%d", i);
        t.put(&key[0], i);
    }
    ok = true;
    for (int i = 0; i < 80000; i += 11) {
        format(&key[0], 24, "key-%d", i);
        if (t.get(&key[0], -1) != i) { ok = false; }
    }
    check(ok && t.size() == 80000, "80000 text keys");
    t.dispose();
}

void heap() {
    int n = 120000;
    ds.BinaryHeap h;
    for (int i = 0; i < n; i++) { h.push(scatter(i), i); }
    int last = -9223372036854775807 - 1;
    bool ok = true;
    int popped = 0;
    while (!h.isEmpty()) {
        int k = h.pop();
        if (k < last) { ok = false; }
        last = k;
        popped++;
    }
    check(ok && popped == n, "heap sort of 120000 keys");
    // decrease-key on many elements
    int* hs = (int*) asys.alloc(50000 * 8);
    for (int i = 0; i < 50000; i++) { hs[i] = h.push(1000000 + i, i); }
    for (int i = 0; i < 50000; i++) { h.update(hs[i], 49999 - i); }
    ok = h.verify() && h.peek() == 0 && h.peekValue() == 49999;
    check(ok, "50000 decrease-key operations");
    asys.free((char*) hs);
    h.dispose();
}

void sequences() {
    int n = 400000;
    ds.Deque d;
    for (int i = 0; i < n; i++) { d.pushBack(i); d.pushFront(-i); }
    int sum = 0;
    int firstOut = d.front();
    int lastOut = d.back();
    while (d.size() > 0) { sum = sum + d.popFront() + d.popBack(); }
    check(firstOut == 1 - n && lastOut == n - 1 && sum == 0 && d.size() == 0, "800000 pushes and pops");
    d.dispose();
    ds.Fenwick f(n);
    for (int i = 0; i < n; i++) { f.add(i, 1); }
    check(f.prefix(n - 1) == n && f.lowerBound(200000) == 199999, "Fenwick tree with 400000 elements");
    f.dispose();
    ds.SegTree s(n, ds.SEG_MAX);
    for (int i = 0; i < 8000; i++) { s.assign(i * 50, i * 50 + 49, i); }
    check(s.total() == 7999 && s.query(0, 49) == 0 && s.query(250000, 250049) == 5000, "segment tree with 400000 elements");
    s.dispose();
    ds.BitSet b(n * 4);
    for (int i = 0; i < n * 4; i = i + 3) { b.set(i); }
    check(b.count() == (n * 4 + 2) / 3 && b.nextSet(1599998) == 1599999, "bit set with 1.6 million bits");
    b.dispose();
}

void trie() {
    ds.Trie t;
    char key[24];
    for (int i = 0; i < 50000; i++) {
        format(&key[0], 24, "w%d", scatter(i) % 1000000);
        t.put(&key[0], i);
    }
    check(t.countPrefix("w1") > 0 && t.countPrefix("") == t.size() && t.verify(), "a trie of 50000 words");
    check(t.countWildcard("w12*") == t.countPrefix("w12") && t.countWildcard("w?????") <= t.size(), "wildcards on a big trie");
    t.dispose();
}

void sets() {
    ds.IntervalSet s();
    for (int i = 0; i < 80000; i++) { s.add(scatter(i) % 4000000, scatter(i) % 4000000 + 3); }
    check(s.verify() && s.length() <= 320000, "intervals added in random order");
    s.dispose();
    ds.LruCache c(5000);
    int hits = 0;
    for (int i = 0; i < 120000; i++) {
        int k = scatter(i) % 8000;
        if (c.get(k, -1) >= 0) { hits++; } else { c.put(k, 1); }
    }
    check(c.size() == 5000 && c.verify() && hits > 0 && hits < 120000, "an LRU cache under load");
    c.dispose();
}

int main() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ordered();
    hash();
    heap();
    sequences();
    trie();
    sets();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "all memory given back");
    printf("big inputs: %d checks, %d failures\n", checks, fails);
    return fails;
}
