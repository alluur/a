// the fast memcpy / memset / strlen against plain loops: every size, every alignment, and strlen next to an unmapped page
import cstdlib;
int refLen(char* s) { int n = 0; while (s[n] != 0) { n++; } return n; }

int main() {
    char* base = malloc(2000);
    char* src = malloc(600);
    char* dst = malloc(600);
    char* ref = malloc(600);
    for (int i = 0; i < 600; i++) { src[i] = (i * 7 + 3) & 255; }
    int bad = 0;
    // memcpy: sizes 0..200 at the source and destination offsets 0..17
    for (int n = 0; n <= 200; n++) {
        for (int so = 0; so < 18; so = so + 5) {
            for (int dof = 0; dof < 18; dof = dof + 3) {
                for (int i = 0; i < 600; i++) { dst[i] = 0x55; ref[i] = 0x55; }
                memcpy(&dst[dof], &src[so], n);
                for (int i = 0; i < n; i++) { ref[dof + i] = src[so + i]; }
                for (int i = 0; i < 600; i++) { if (dst[i] != ref[i]) { bad++; } }
            }
        }
    }
    println(bad == 0 ? "memcpy ok" : "memcpy WRONG");
    // memset: sizes 0..200, offsets 0..17, values 0, 1, 200, 255; a negative size does nothing
    bad = 0;
    for (int n = -2; n <= 200; n++) {
        for (int off = 0; off < 18; off = off + 3) {
            for (int v = 0; v < 4; v++) {
                int val = (v == 0) ? 0 : ((v == 1) ? 1 : ((v == 2) ? 200 : 255));
                for (int i = 0; i < 600; i++) { dst[i] = 0x55; ref[i] = 0x55; }
                memset(&dst[off], val, n);
                for (int i = 0; i < n; i++) { ref[off + i] = val; }
                for (int i = 0; i < 600; i++) { if (dst[i] != ref[i]) { bad++; } }
            }
        }
    }
    println(bad == 0 ? "memset ok" : "memset WRONG");
    // strlen: lengths 0..100 at the offsets 0..33 of a buffer full of non-zero bytes
    bad = 0;
    for (int off = 0; off < 34; off++) {
        for (int len = 0; len <= 100; len++) {
            for (int i = 0; i < 300; i++) { base[i] = 'x'; }
            base[off + len] = 0;
            if (strlen(&base[off]) != len) { bad++; }
            // a zero byte before the string start (in the same 16 byte block) must not count
            if (off > 0) { base[off - 1] = 0; if (strlen(&base[off]) != len) { bad++; } }
        }
    }
    println(bad == 0 ? "strlen ok" : "strlen WRONG");
    // a big copy and fill
    char* big = malloc(5000000);
    char* big2 = malloc(5000000);
    memset(big, 0x5A, 5000000);
    memcpy(big2, big, 5000000);
    bad = 0;
    for (int i = 0; i < 5000000; i = i + 997) { if (big2[i] != 0x5A) { bad++; } }
    println(bad == 0 ? "big copy ok" : "big copy WRONG");
    bad = 0;
    static if (__ARCH == 0) {
        // strlen with the terminating zero as the last byte of a page, the next page unmapped: must not fault
        if (__OS == 0) {
            int pages = __syscall(9, 0, 8192, 3, 0x22, -1, 0);                // mmap 2 pages (PROT_READ|WRITE, MAP_PRIVATE|ANON)
            char* p = (char*) pages;
            __syscall(11, (int) &p[4096], 4096, 0, 0, 0, 0);                  // munmap the second page
            for (int len = 0; len < 40; len++) {
                for (int i = 0; i < 4096; i++) { p[i] = 'y'; }
                p[4095] = 0;
                if (strlen(&p[4095 - len]) != len) { bad++; }
            }
        }
    }
    println(bad == 0 ? "strlen at a page end ok" : "strlen at a page end WRONG");     // only x86-64 Linux runs this check
    return 0;
}
