import clib;

int hits;
int last;

void onUsr(int sig) {
    hits++;
    last = sig;
}

void onAlarm(int sig) {
    hits = hits + 100;
}

int main() {
    // signals (Linux and Android; on Windows the checks count as passed)
    bool sigOk = true;
    if (__OS != 1) {
        func prev = signal(SIGUSR1, onUsr);
        sigOk = sigOk && (int) prev == SIG_DFL;
        raise(SIGUSR1);
        raise(SIGUSR1);
        sigOk = sigOk && hits == 2 && last == SIGUSR1;
        signal(SIGUSR2, SIG_IGN);
        raise(SIGUSR2);
        func old = signal(SIGUSR1, SIG_DFL);
        sigOk = sigOk && old == onUsr;
        signal(SIGALRM, onAlarm);
        alarm(1);
        pause();
        sigOk = sigOk && hits == 102;
        sigOk = sigOk && (int) signal(99, SIG_IGN) == SIG_ERR;
    }
    printf("signals %d\n", sigOk);
    // fnmatch
    char* pats[14];
    char* names[14];
    int expect[14];
    pats[0] = "*.txt"; names[0] = "file.txt"; expect[0] = 0;
    pats[1] = "*.txt"; names[1] = "file.doc"; expect[1] = 1;
    pats[2] = "f?le.*"; names[2] = "file.c"; expect[2] = 0;
    pats[3] = "[a-c]x*"; names[3] = "bxyz"; expect[3] = 0;
    pats[4] = "[!a-c]x*"; names[4] = "bxyz"; expect[4] = 1;
    pats[5] = "a\\*b"; names[5] = "a*b"; expect[5] = 0;
    pats[6] = "a\\*b"; names[6] = "axb"; expect[6] = 1;
    pats[7] = "*"; names[7] = ""; expect[7] = 0;
    pats[8] = "?"; names[8] = ""; expect[8] = 1;
    pats[9] = "**x*y**"; names[9] = "aaxbbyccc"; expect[9] = 0;
    pats[10] = "[]]x"; names[10] = "]x"; expect[10] = 0;
    pats[11] = "[a-"; names[11] = "[a-"; expect[11] = 0;
    pats[12] = "abc"; names[12] = "abcd"; expect[12] = 1;
    pats[13] = "*a*b*c*"; names[13] = "xxaxxbxxcxx"; expect[13] = 0;
    int fnOk = 1;
    for (int i = 0; i < 14; i++) {
        if (fnmatch(pats[i], names[i]) != expect[i]) {
            printf("fnmatch %d wrong\n", i);
            fnOk = 0;
        }
    }
    fnOk = fnOk && fnmatch("*.c", "dir/file.c", FNM_PATHNAME) == 1;
    fnOk = fnOk && fnmatch("*/*.c", "dir/file.c", FNM_PATHNAME) == 0;
    fnOk = fnOk && fnmatch("*", ".hidden", FNM_PERIOD) == 1;
    fnOk = fnOk && fnmatch(".*", ".hidden", FNM_PERIOD) == 0;
    fnOk = fnOk && fnmatch("FILE.*", "file.TXT", FNM_CASEFOLD) == 0;
    printf("fnmatch %d\n", fnOk);
    // temporary files
    char tmpl[40];
    strcpy(tmpl, "build/tests/t52XXXXXX");
    int fd = mkstemp(tmpl);
    printf("mkstemp %d %d\n", fd >= 0, strlen(tmpl) == 21 && strncmp(tmpl, "build/tests/t52", 15) == 0);
    write(fd, "temp", 4);
    close(fd);
    Stat st;
    stat(tmpl, &st);
    printf("size %d\n", st.st_size);
    unlink(tmpl);
    char dtmpl[40];
    strcpy(dtmpl, "build/tests/d52XXXXXX");
    char* made = mkdtemp(dtmpl);
    printf("mkdtemp %d\n", made != null);
    stat(dtmpl, &st);
    printf("is dir %d\n", S_ISDIR(st.st_mode));
    rmdir(dtmpl);
    strcpy(tmpl, "bad");
    printf("bad template %d %d\n", mkstemp(tmpl), errno);
    // sleeping
    timespec ts;
    ts.tv_sec = 0;
    ts.tv_nsec = 60000000;
    int t0 = millis();
    nanosleep(&ts);
    int t1 = millis();
    printf("nanosleep %d\n", t1 - t0 >= 30);
    // the 48-bit random generators
    srand48(12345);
    printf("%d %d %d\n", lrand48(), lrand48(), mrand48());
    printfd("%.17g %.17g\n", drand48(), drand48());
    int xs[3];
    xs[0] = 0x330E; xs[1] = 0x1234; xs[2] = 0xABCD;
    printfd("%.17g %d\n", erand48(&xs[0]), xs[0]);
    srand48(1);
    int v = 0;
    for (int i = 0; i < 1000; i++) v = v ^ lrand48();
    printf("%d\n", v);
    return 0;
}
