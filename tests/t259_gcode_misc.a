// gcode: columns of wide, combining, tab, control and invalid characters agree with acode, two editors on one document, per document view
// state, the gutter grows, saving errors keep the changes, CRLF files stay CRLF, the find bar follows the document, the Look registry,
// LineEdit keys, buttons
import wsrv;
import gui;
import guix;
import gcode;
import afind;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;
int clicks = 0;
int specials = 0;

int onButton(int b) { clicks++; return 0; }
int onSpecial(int b) { specials++; return 0; }

void text(char* label) {
    char* t = e->getText();
    printf("%s: [", label);
    for (int i = 0; t[i] != 0 && i < 100; i++) { printf("%c", (t[i] == 10) ? '|' : (t[i] == 13) ? '~' : (t[i] == 9) ? '>' : t[i]); }
    printf("]\n");
    asys.free(t);
}

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;       // a click or a key then repaints one row, not the window: much faster under emulation
    gcode.theLook()->matchBrackets = false;
    rmtree("build/tests/t259_files");
    asys.mkdirs("build/tests/t259_files");
    startServer(7359, "t259");
    w = d->createWindow("Misc", 640, 360, 0);
    gcode.Look* look = gcode.theLook();
    look->setThemeName("dark");
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    settle();

    // 1. the columns the editor draws are the columns acode reports, for every kind of character; a click at a position finds the offset again
    e->setText("ab\xe3\x81\x82" "c\td\xcc\x81" "e\x01" "f\xff" "g\xf0\x9f\x98\x80h\t\ti");
    settle();
    int len = e->buf->length();
    int mismatches = 0;
    int roundTrips = 0;
    int tried = 0;
    int cw = e->cellWidth();
    int gx = e->gutterWidth() + 4;
    e->doubleClickMs = 0;                  // clicks on the same place are no double clicks
    for (int off = 0; off <= len; off++) {
        if (e->buf->charStart(off) != off) { continue; }
        int px = 0;
        int py = 0;
        if (!e->pointOfOffset(off, &px, &py)) { mismatches++; continue; }
        int col2 = e->buf->visualCol(0, off, e->ed->tabWidth);
        if (px != gx + col2 * cw + cw / 2) { mismatches++; }
        // a click in the left part of the cell of this offset puts the caret there, unless a zero width character shares the column
        clickWd(w, e, px - 3, py);
        tried++;
        int got = e->ed->caret();
        if (got == off || e->buf->visualCol(0, got, e->ed->tabWidth) == col2) { roundTrips++; }
    }
    printf("columns: %d offsets, mismatches with acode %d, clicks that found their column %d of %d\n", len + 1, mismatches, roundTrips, tried);
    printf("the width of the line in columns: %d\n", e->buf->visualCol(0, len, e->ed->tabWidth));

    // 2. two editors on one document: typing in one shows in the other (text, cursors, repaint)
    gcode.CodeEditor* e2 = new gcode.CodeEditor();
    e2->blink = false;
    e->setText("first\nsecond\n");
    e2->setDoc(e->doc);
    gui.Window* w2 = d->createWindow("Second", 400, 200, 0);
    gui.Box* c2 = gui.vbox(0, 0);
    c2->add(e2);
    w2->setRoot(c2);
    settle();
    int before = shot(w2);
    w->focusWindow();
    w->setFocus(e);
    settle();
    e->ed->setCursor(0);
    typeStr("X");
    settle();
    printf("both show the same text: %d, the second window repainted: %d, both have the caret at %d %d\n", e2->buf->length() == e->buf->length(), shot(w2) != before, e->ed->caret(), e2->ed->caret());
    e2->setDoc(new gcode.Doc());
    printf("the second editor can show its own document: %d\n", e2->buf != e->buf);
    w2->close();

    // 3. every document keeps its own caret and scroll position
    gcode.Doc* a = new gcode.Doc();
    gcode.Doc* b = new gcode.Doc();
    char* many = (char*) asys.alloc(20000);
    int n = 0;
    for (int i = 0; i < 200; i++) { n = n + format(&many[n], 40, "line %d of the document\n", i); }
    a->setText(many);
    b->setText("short\ntext\n");
    asys.free(many);
    e->setDoc(a);
    e->gotoLine(150, 3);
    settle();
    int aTop = e->firstLine();
    int aCaret = e->ed->caret();
    e->setDoc(b);
    settle();
    printf("document b: first line %d, caret %d\n", e->firstLine(), e->ed->caret());
    e->setDoc(a);
    settle();
    printf("back in a: first line %d (was %d), caret %d (was %d)\n", e->firstLine(), aTop, e->ed->caret(), aCaret);

    // 4. the gutter grows with the number of lines
    char* big = (char*) asys.alloc(60000);
    n = 0;
    for (int i = 0; i < 1500; i++) { n = n + format(&big[n], 20, "%d\n", i); }
    e->setText("x\n");
    settle();
    int g1 = e->gutterWidth();
    e->setText(big);
    settle();
    int g2 = e->gutterWidth();
    asys.free(big);
    printf("gutter for 2 lines %d, for 1501 lines %d (one digit more: %d)\n", g1, g2, g2 - g1 == e->cellWidth());

    // 5. saving: a path that cannot be written is an error and the document stays changed; CRLF stays CRLF
    e->setText("changed\n");
    e->ed->setCursor(0);
    typeStr("a");
    printf("save to a missing folder: %d, still modified: %d\n", e->doc->save("build/tests/t259_files/no/such/dir/x.txt") < 0, e->doc->isModified());
    asys.writeFile("build/tests/t259_files/win.txt", "one\r\ntwo\r\n", 10);
    e->open("build/tests/t259_files/win.txt");
    e->ed->setCursor(e->buf->length());
    typeStr("three");
    key(adp.KEY_ENTER, 13);
    typeStr("four");
    printf("save: %d, ", e->doc->save(null));
    int sz = 0;
    char* disk = asys.readFile("build/tests/t259_files/win.txt", &sz, 1000, null);
    int crlf = 0;
    int lone = 0;
    for (int i = 0; i < sz; i++) {
        if (disk[i] == 13 && disk[i + 1] == 10) { crlf++; }
        if (disk[i] == 10 && (i == 0 || disk[i - 1] != 13)) { lone++; }
    }
    printf("the file has %d bytes, %d CRLF, %d lone LF\n", sz, crlf, lone);
    asys.free(disk);

    // 6. the find bar follows the document that the editor shows
    gcode.FindBar* fb = new gcode.FindBar(e);
    gcode.Doc* d1 = new gcode.Doc();
    gcode.Doc* d2 = new gcode.Doc();
    d1->setText("cat cat cat\n");
    d2->setText("cat\n");
    e->setDoc(d1);
    fb->setPattern("cat");
    printf("document 1: %d matches, ", fb->matchCount);
    e->setDoc(d2);
    fb->refresh(false);
    printf("document 2: %d match\n", fb->matchCount);

    // 7. the Look registry: a widget that is not registered any more is not repainted
    int users = look->userCount();
    look->unuse(e);
    printf("unuse: %d -> %d users\n", users, look->userCount());
    look->use(e, null);
    printf("registered again: %d\n", look->userCount());

    // 8. LineEdit: Esc, Up, Down and Alt+letter reach onSpecial; typing and Backspace do not
    gcode.LineEdit* le = new gcode.LineEdit();
    le->onSpecial = onSpecial;
    gui.Window* w3 = d->createWindow("Edit", 300, 60, 0);
    gui.Box* c3 = gui.vbox(0, 8);
    c3->add(le);
    w3->setRoot(c3);
    w3->setFocus(le);
    settle();
    typeStr("abc");
    key(adp.KEY_BACKSPACE, 8);
    printf("typing: [%s], specials %d\n", le->text(), specials);
    key(adp.KEY_UP, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ESCAPE, 27);
    keyMods('c', 0, adp.MOD_ALT);
    key(adp.KEY_ENTER, 13);
    keyMods(adp.KEY_ENTER, 13, adp.MOD_SHIFT);
    printf("Up, Down, Esc, Alt+C and Shift+Enter are specials: %d (and the last key was %d)\n", specials, le->special);
    // the full range of code points can be typed
    le->setText("");
    hb->tap(0, 0x20AC);
    hb->tap(0, 0x1F600);
    settle();
    printf("a Euro sign and an emoji: %d bytes\n", (int) strlen(le->text()));
    w3->close();

    // 9. buttons
    gcode.FlatButton* fbn = new gcode.FlatButton("Go");
    fbn->onClick = onButton;
    gcode.FlatButton* tg = new gcode.FlatButton("Toggle");
    tg->toggle = true;
    tg->onClick = onButton;
    gui.Window* w4 = d->createWindow("Buttons", 300, 60, 0);
    gui.Box* c4 = gui.hbox(8, 8);
    c4->add(fbn);
    c4->add(tg);
    w4->setRoot(c4);
    settle();
    clickWd(w4, fbn, 10, 10);
    clickWd(w4, tg, 10, 10);
    clickWd(w4, tg, 10, 10);
    printf("clicks %d, toggle state %d\n", clicks, tg->checked);
    fbn->enabled = false;
    clickWd(w4, fbn, 10, 10);
    printf("a disabled button does not click: %d\n", clicks);
    w4->close();

    // 10. text that is not text: control characters and invalid bytes are drawn and the view stays consistent
    e->setDoc(a);
    char binary[40];
    for (int i = 0; i < 30; i++) { binary[i] = (i * 7) % 256; }
    binary[30] = 0;
    for (int i = 0; i < 30; i++) { if (binary[i] == 0) { binary[i] = 1; } }
    e->setText(&binary[0]);
    settle();

    printf("weird bytes: lines %d, drawn without trouble %d\n", e->buf->lineCount(), e->paints() > 0);
    e->ed->selectAll();
    ctrl('c');
    key(adp.KEY_END, 0);
    printf("copy of everything: %d bytes\n", (int) strlen(d->clipText));

    // 11. a big document: the match count of the find bar follows the text after a short pause, not on every key
    w->close();
    gui.Window* w5 = d->createWindow("Big find", 520, 260, 0);
    gcode.CodeEditor* e5 = new gcode.CodeEditor();
    e5->blink = false;
    gcode.FindBar* fb5 = new gcode.FindBar(e5);
    gui.Box* c5 = gui.vbox(0, 0);
    c5->add(fb5);
    c5->add(e5);
    w5->setRoot(c5);
    w5->setFocus(e5);
    int cap = 330000;
    char* bigText = (char*) asys.alloc(cap);
    int bn = 0;
    for (int i = 0; i < 14000; i++) {
        bn = bn + format(&bigText[bn], 40, "%s\n", (i % 5000 == 77) ? "a needle in the haystack" : "plain filler text line");
    }
    e5->setText(bigText);
    asys.free(bigText);
    fb5->open(false);
    fb5->setPattern("needle");
    settle();
    printf("big document: %d bytes, matches %d\n", e5->buf->length(), fb5->matchCount);
    w5->setFocus(e5);
    key(adp.KEY_HOME, 0);
    keyMods(adp.KEY_HOME, 0, adp.MOD_CTRL);
    typeStr("needle");
    int t0 = asys.monoMs();
    while (fb5->matchCount != 4 && asys.monoMs() - t0 < 20000) { srv->step(0); d->pump(0); }
    printf("after typing a fourth needle the bar says: %d matches\n", fb5->matchCount);
    w5->close();
    return 0;
}
