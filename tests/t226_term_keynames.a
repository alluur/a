// term: key names (keyName, parseKey, keyIs), the key encoder, and that decoding what the encoder wrote gives the key back
import term;

void parse(char* spec) {
    int mods = 0;
    int k = term.parseKey(spec, &mods);
    char name[64];
    printf("%-14s -> ", spec);
    if (k < 0) { println("not a key"); return; }
    term.keyName(k, mods, &name[0], 64);
    printf("%s  (key %x, mods %d)\n", &name[0], k, mods, 0);
}

int main() {
    println("-- parseKey and keyName");
    parse("a"); parse("A"); parse("Ctrl+S"); parse("ctrl-s"); parse("C-s"); parse("Alt+F"); parse("Shift+Tab"); parse("Ctrl+Alt+Delete");
    parse("F1"); parse("f10"); parse("F24"); parse("F25"); parse("F0"); parse("Enter"); parse("Return"); parse("Esc"); parse("Escape");
    parse("Backspace"); parse("Up"); parse("PgDn"); parse("PageUp"); parse("Home"); parse("End"); parse("Insert"); parse("Space");
    parse("Ctrl+Space"); parse("Plus"); parse("Ctrl+Plus"); parse("Minus"); parse("+"); parse("-"); parse("Ctrl+/"); parse("\xc3\xa9"); parse("Alt+\xe4\xb8\x96");
    parse("Meta+X"); parse("Super+X"); parse("Hyper+X"); parse(""); parse("Ctrl+"); parse("Ctrl+Shift+Alt+Meta+F5");
    println("-- keyIs and shortcut matching");
    term.Decoder* d = new term.Decoder();
    term.Event e;
    d->feedText("\x13");
    d->next(&e);
    printf("%d %d %d\n", term.keyIs(&e, "Ctrl+S"), term.keyIs(&e, "ctrl-s"), term.keyIs(&e, "S"));
    d->feedText("\eF");
    d->next(&e);
    printf("Alt+F typed as ESC F (upper case): %d %d %d\n", term.keyIs(&e, "Alt+F"), term.keyIs(&e, "Alt+Shift+F"), term.keyIs(&e, "Alt+Ctrl+F"));
    d->feedText("?");
    d->next(&e);
    printf("a '?' typed: %d %d\n", term.keyIs(&e, "?"), term.keyIs(&e, "Shift+?"));
    d->feedText("\e[1;2P");
    d->next(&e);
    printf("Shift+F1: %d %d\n", term.keyIs(&e, "Shift+F1"), term.keyIs(&e, "F1"));
    printf("%d\n", term.keyMatches('A', 0, 'a', term.MOD_SHIFT));
    printf("%d\n", term.keyMatches('a', 0, 'a', 0));
    println("-- encodeKey, and the decoder reads it back");
    int keys[22] = {'a', 'z', ' ', '5', '/', 0xE9, 0x4E16, 0x1F600, term.KEY_ENTER, term.KEY_TAB, term.KEY_BACKSPACE, term.KEY_ESC, term.KEY_UP, term.KEY_DOWN,
                    term.KEY_LEFT, term.KEY_RIGHT, term.KEY_HOME, term.KEY_END, term.KEY_PGUP, term.KEY_PGDN, term.KEY_INSERT, term.KEY_DELETE};
    int bad = 0;
    int total = 0;
    for (int ki = 0; ki < 22; ki++) {
        for (int m = 0; m < 16; m++) {
            int key = keys[ki];
            // combinations a classic terminal cannot tell apart are skipped
            bool plain = key < term.KEY_BASE;
            if (plain && key >= 'a' && key <= 'z' && (m & term.MOD_SHIFT) != 0) { continue; }
            if (plain && (m & (term.MOD_SHIFT | term.MOD_META)) != 0) { continue; }
            if (plain && (m & term.MOD_CTRL) != 0 && !((key >= 'a' && key <= 'z') || key == ' ' || key == '/')) { continue; }
            if (key == term.KEY_ENTER && (m & (term.MOD_SHIFT | term.MOD_META)) != 0) { continue; }
            if (key == term.KEY_ENTER && (m & term.MOD_CTRL) != 0 && (m & term.MOD_ALT) != 0) { continue; }
            if (key == term.KEY_TAB && m != 0 && m != term.MOD_SHIFT && m != term.MOD_ALT) { continue; }
            if (key == term.KEY_BACKSPACE && (m & (term.MOD_SHIFT | term.MOD_META)) != 0) { continue; }
            if (key == term.KEY_BACKSPACE && (m & term.MOD_CTRL) != 0) { continue; }
            if (key == term.KEY_ESC && m != 0 && m != term.MOD_ALT) { continue; }
            char buf[24];
            int n = term.encodeKey(key, m, &buf[0]);
            buf[n] = 0;
            d->feedBytes(&buf[0], n);
            d->flush();
            total++;
            if (!d->next(&e) || e.key != key || e.mods != m || d->count() != 0) {
                bad++;
                if (bad < 6) {
                    char nm[40];
                    term.keyName(key, m, &nm[0], 40);
                    printf("MISMATCH for %s: got key %x mods %d\n", &nm[0], e.key, e.mods);
                }
                d->clearEvents();
            }
        }
    }
    int fkeys = 0;
    for (int f = 1; f <= 20; f++) {
        for (int m = 0; m < 16; m++) {
            char buf[24];
            int n = term.encodeKey(term.fkey(f), m, &buf[0]);
            buf[n] = 0;
            d->feedBytes(&buf[0], n);
            d->flush();
            total++;
            fkeys++;
            if (!d->next(&e) || e.key != term.fkey(f) || e.mods != m) { bad++; if (bad < 6) { printf("MISMATCH F%d mods %d\n", f, m); } d->clearEvents(); }
        }
    }
    printf("%d key combinations checked, %d did not come back\n", total, bad);
    println("-- some encodings");
    int samples[6] = {term.KEY_UP, term.KEY_F1, term.fkey(5), term.KEY_DELETE, 'x', term.KEY_TAB};
    int sm[6] = {term.MOD_CTRL, 0, term.MOD_SHIFT | term.MOD_ALT, term.MOD_CTRL, term.MOD_ALT, term.MOD_SHIFT};
    for (int i = 0; i < 6; i++) {
        char buf[24];
        int n = term.encodeKey(samples[i], sm[i], &buf[0]);
        for (int k = 0; k < n; k++) {
            int c = buf[k] & 255;
            if (c == 27) print("\\e"); else printChar(c);
        }
        println("");
    }
    return 0;
}
