// SHA-256, SHA-384, SHA-512 and CRC-32 over many lengths (the expected output comes from Python's hashlib and zlib)
import hash;
import cstdlib;

int main() {
    char* buf = malloc(3000);
    for (int i = 0; i < 3000; i++) { buf[i] = (i * 31 + 7) & 255; }
    int lens[24];
    lens[0] = 0; lens[1] = 1; lens[2] = 3; lens[3] = 55; lens[4] = 56; lens[5] = 57; lens[6] = 63; lens[7] = 64;
    lens[8] = 65; lens[9] = 111; lens[10] = 112; lens[11] = 113; lens[12] = 119; lens[13] = 120; lens[14] = 127; lens[15] = 128;
    lens[16] = 129; lens[17] = 200; lens[18] = 255; lens[19] = 256; lens[20] = 1000; lens[21] = 2047; lens[22] = 2999; lens[23] = 3000;
    char raw[64];
    for (int i = 0; i < 24; i++) {
        int n = lens[i];
        printf("%d sha256 %s\n", n, (int) hash.sha256(buf, n), 0, 0);
        hash.sha512Raw(buf, n, &raw[0]);
        print("  sha512 ");
        for (int k = 0; k < 64; k++) { printf("%02x", raw[k] & 255, 0, 0, 0); }
        println("");
        hash.sha384Raw(buf, n, &raw[0]);
        print("  sha384 ");
        for (int k = 0; k < 48; k++) { printf("%02x", raw[k] & 255, 0, 0, 0); }
        println("");
        printf("  crc32 %08x\n", hash.crc32(buf, n), 0, 0, 0);
    }
    // the CRC continued over two parts equals the CRC of the whole
    int whole = hash.crc32(buf, 1234);
    int parts = hash.crc32Update(hash.crc32(buf, 500), &buf[500], 734);
    println(whole == parts ? "crc32Update ok" : "crc32Update WRONG");
    // an incremental SHA-512 fed in odd pieces equals the one-shot digest
    hash.Sha512 s();
    int pos = 0;
    int step = 1;
    while (pos < 3000) {
        int take = step;
        if (pos + take > 3000) { take = 3000 - pos; }
        s.update(&buf[pos], take);
        pos = pos + take;
        step = step * 2 + 1;
        if (step > 400) { step = 3; }
    }
    char a[64];
    char b[64];
    s.final(&a[0]);
    hash.sha512Raw(buf, 3000, &b[0]);
    println(hash.equalConstantTime(&a[0], &b[0], 64) ? "incremental sha512 ok" : "incremental sha512 WRONG");
    // HMAC-SHA256 test vector (RFC 4231 case 2)
    char mac[32];
    hash.hmacSha256("Jefe", 4, "what do ya want for nothing?", 28, &mac[0]);
    for (int k = 0; k < 32; k++) { printf("%02x", mac[k] & 255, 0, 0, 0); }
    println("");
    return 0;
}
