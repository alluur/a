// probe - a small tui program for the pty tests (tests/tui/*.py): it shows what it received, so that a test can check it on the screen.
//   F9  run `stty` in a shell (suspend / resume)     F11  exit(3) from inside     F12  crash (null pointer)     Ctrl+Q  quit
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
tui.Label* sizeLabel;
tui.Label* lastLabel;
tui.Label* countLabel;
tui.Label* clickLabel;
tui.Label* pasteLabel;
tui.TextInput* field;
tui.ListView* list;
tui.Splitter* split;
tuix.TextPane* pane;
int events;
int clicks;

int doQuit(int x) { app->quit(0); return 0; }
int doNew(int x) { lastLabel->setText("menu: New"); return 0; }
int doOpen(int x) { lastLabel->setText("menu: Open"); return 0; }
int doCopy(int x) { lastLabel->setText("menu: Copy"); return 0; }

int doShell(int x) {
    int st = app->runShell("echo child-start; stty -a | tr ' ;' '\\n\\n' | grep -E '^-?(icanon|echo|isig)$'; echo child-end");
    char buf[64];
    format(&buf[0], 64, "shell status %d", st, 0, 0, 0);
    lastLabel->setText(&buf[0]);
    return 0;
}

int doExit(int x) { exit(3); return 0; }
int doCrash(int x) { int* p = (int*) 0; p[0] = 1; return 0; }

int btnClick(int b) {
    clicks++;
    char buf[48];
    format(&buf[0], 48, "clicked: %d", clicks, 0, 0, 0);
    clickLabel->setText(&buf[0]);
    return 0;
}

int resized(int a) {
    char buf[48];
    format(&buf[0], 48, "size: %dx%d", app->cols, app->rows, 0, 0);
    sizeLabel->setText(&buf[0]);
    return 0;
}

int onEnter(int t) {
    char buf[200];
    format(&buf[0], 200, "entered: %s", field->getText(), 0, 0, 0);
    lastLabel->setText(&buf[0]);
    return 0;
}

int keyHook(int a, int ev) {
    term.Event* e = (term.Event*) ev;
    events++;
    char d[80];
    term.describe(e, &d[0], 80);
    char buf[120];
    format(&buf[0], 120, "last: %s", &d[0], 0, 0, 0);
    lastLabel->setText(&buf[0]);
    format(&buf[0], 120, "events: %d", events, 0, 0, 0);
    countLabel->setText(&buf[0]);
    return 0;
}

int listSel(int l) {
    char buf[80];
    format(&buf[0], 80, "selected: %s", list->selectedText(), 0, 0, 0);
    pane->appendLine(&buf[0]);
    return 0;
}

int main(int argc, char** argv) {
    app = new tui.App();
    if (!app->start()) {
        println("probe needs a terminal");
        return 1;
    }
    tui.MenuBar* mb = new tui.MenuBar();
    tui.Menu* f = mb->addMenu("&File");
    f->add("&New", doNew, "Ctrl+N");
    f->add("&Open", doOpen, "Ctrl+O");
    f->addSeparator();
    f->add("&Quit", doQuit, "Ctrl+Q");
    tui.Menu* ed = mb->addMenu("&Edit");
    ed->add("&Copy", doCopy, "Ctrl+Y");
    tui.Box* col = tui.vbox(0, 0);
    col->add(mb);
    sizeLabel = new tui.Label("size: ?");
    lastLabel = new tui.Label("last: -");
    countLabel = new tui.Label("events: 0");
    clickLabel = new tui.Label("clicked: 0");
    pasteLabel = new tui.Label("paste: -");
    col->add(sizeLabel);
    col->add(lastLabel);
    col->add(countLabel);
    tui.Box* row = tui.hbox(1, 0);
    tui.Button* b = new tui.Button("&Go");
    b->onClick = btnClick;
    row->add(b);
    row->add(clickLabel);
    col->add(row);
    field = new tui.TextInput("");
    field->onEnter = onEnter;
    col->add(field);
    col->add(pasteLabel);
    split = new tui.Splitter(true);
    split->flex = 1;
    list = new tui.ListView();
    list->filterable = true;
    list->onSelect = listSel;
    for (int i = 1; i <= 20; i++) {
        char buf[32];
        format(&buf[0], 32, "item %d", i, 0, 0, 0);
        list->add(&buf[0]);
    }
    pane = new tuix.TextPane();
    split->add(list);
    split->add(pane);
    col->add(split);
    app->setMenuBar(mb);
    app->setRoot(col);
    app->addShortcut("Ctrl+Q", doQuit);
    app->addShortcut("F9", doShell);
    app->addShortcut("F11", doExit);
    app->addShortcut("F12", doCrash);
    app->onKeyHook = keyHook;
    app->onResizeHook = resized;
    resized(0);
    return app->run();
}
