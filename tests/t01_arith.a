int main() {
    printlnInt(1 + 2 * 3);
    printlnInt((1 + 2) * 3);
    printlnInt(100 / 7);
    printlnInt(100 % 7);
    printlnInt(-5 + 2);
    printlnInt(1 << 10);
    printlnInt(1024 >> 3);
    printlnInt(0xFF & 0x0F);
    printlnInt(0xF0 | 0x0F);
    printlnInt(6 ^ 3);
    printlnInt(~0);
    printlnInt(-7 / 2);
    printlnInt(-7 % 3);
    int a = 5;
    int b = 3;
    a += b; printlnInt(a);
    a -= 1; printlnInt(a);
    a *= 2; printlnInt(a);
    a /= 3; printlnInt(a);
    a %= 3; printlnInt(a);
    a <<= 4; printlnInt(a);
    a >>= 2; printlnInt(a);
    a |= 1; printlnInt(a);
    a &= 6; printlnInt(a);
    a ^= 7; printlnInt(a);
    printlnInt(1234567890123);
    printlnInt(0 - 9223372036854775807);
    return 0;
}
