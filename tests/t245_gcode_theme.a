// the Look of gcode: one theme for every widget, switched live (all nine built-in themes, a theme file, a changed colour), fonts,
// line spacing, preferences and the settings round trip
import wsrv;
import gui;
import guix;
import gcode;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e1;
gcode.CodeEditor* e2;
gui.Window* w;
gcode.Look* look;

// a pixel in the empty area below the text of an editor
int emptyPixel(gcode.CodeEditor* e) {
    return w->surf->get(e->absX() + e->w - 40, e->absY() + 9 * e->lineHeight() + 5);
}

int main() {
    gcode.theLook()->autoComplete = false;
    startServer(7345, "t245");
    w = d->createWindow("Themes", 640, 400, 0);
    look = gcode.theLook();
    look->setThemeName("dark");
    e1 = new gcode.CodeEditor();
    e2 = new gcode.CodeEditor();
    e1->blink = false;
    e2->blink = false;
    gui.Box* col = gui.vbox(2, 0);
    col->add(e1);
    col->add(e2);
    w->setRoot(col);
    w->setFocus(e1);
    char* code = "// theme test\nint main() {\n    char* s = \"text\";\n    return 42; /* done */\n}\n";
    e1->setText(code);
    e2->setText(code);
    e1->doc->setLanguage(asyntax.Lang.A);
    e2->doc->setLanguage(asyntax.Lang.A);
    e1->highlightWord = false;
    e2->highlightWord = false;
    settle();
    printf("widgets that follow the look: at least 2: %d\n", look->userCount() >= 2);

    // every built-in theme: both editors show its background colour at once
    char* names = atheme.builtinNames();
    int n = strlen(names);
    int s0 = 0;
    int allSame = 1;
    int shots[9];
    int k = 0;
    for (int i = 0; i <= n; i++) {
        if (i == n || names[i] == ' ') {
            char name[40];
            memcpy(&name[0], &names[s0], i - s0);
            name[i - s0] = 0;
            s0 = i + 1;
            bool ok = look->setThemeName(&name[0]);
            settle();
            int bg = look->col(atheme.Col.Background);
            bool a = emptyPixel(e1) == bg;
            bool b = emptyPixel(e2) == bg;
            shots[k] = shot(w);
            printf("%s: set %d, editors use its colours %d %d, screenshot %u\n", &name[0], ok, a, b, shots[k]);
            k++;
        }
    }
    int distinct = 1;
    for (int i = 0; i < k; i++) { for (int j = i + 1; j < k; j++) { if (shots[i] == shots[j]) { distinct = 0; } } }
    printf("nine different screenshots: %d\n", distinct);
    printf("an unknown theme name changes nothing: %d, theme is still %s\n", !look->setThemeName("no-such-theme"), look->theme->name);

    // a theme file in the user's theme directory
    rmtree("build/tests/t245_themes");
    makeDir("build/tests/t245_themes");
    char* ini = "[theme]\nname = ocean\nbase = dark\n[colors]\nbackground = #003366\nforeground = #ffffff\n[tokens]\nkeyword = #ffcc00 bold\n";
    writeFile("build/tests/t245_themes/ocean.ini", ini);
    gcode.setThemeDirectory("build/tests/t245_themes");
    printf("theme file found: %d\n", look->setThemeName("ocean"));
    settle();
    printf("background 003366: %d, keyword colour ffcc00: %d, keyword bold: %d\n", look->col(atheme.Col.Background) == 0xFF003366, look->tokColor(asyntax.Tok.Keyword) == 0xFFFFCC00, look->tokStyle(asyntax.Tok.Keyword));
    printf("both editors got it: %d\n", emptyPixel(e2) == 0xFF003366);
    gcode.setThemeDirectory(null);

    // a colour changed in place and announced with refresh()
    look->theme->setColor(atheme.Col.Background, 0x224422);
    look->refresh();
    settle();
    printf("an edited colour reaches both editors: %d %d\n", emptyPixel(e2) == 0xFF224422, emptyPixel(e1) == 0xFF224422);
    look->setThemeName("dark");

    // fonts: the cell size follows the font and the editors lay out again
    int cw0 = e1->cellWidth();
    int cols0 = e1->columns();
    look->setFontIndex(gcode.FONT_SANS);
    settle();
    printf("sans: cell %d wide (mono %d), columns %d (mono %d), fixed pitch %d\n", e1->cellWidth(), cw0, e1->columns(), cols0, look->monoFont);
    int sansShot = shot(w);
    look->setFontIndex(gcode.FONT_SANS_BOLD);
    settle();
    printf("sans bold: cell %d wide\n", e1->cellWidth());
    look->setFontName("mono");
    settle();
    printf("mono again: cell %d wide, same screenshot as the dark theme had %d, sans looked different %d\n", e1->cellWidth(), shot(w) == shots[0], sansShot != shot(w));
    printf("a font file that does not exist keeps a font: %d\n", !look->setFontFile("build/tests/no-such.afont"));
    look->setLineGap(3);
    settle();
    printf("line gap 3: line height %d\n", e1->lineHeight());
    look->setLineGap(0);
    settle();
    printf("line gap 0: line height %d\n", e1->lineHeight());

    // preferences: options of the editors follow the Look when it announces a change
    look->wordWrap = true;
    look->lineNumbers = false;
    look->changed();
    settle();
    printf("after changed(): wrap %d, line numbers %d, gutter %d\n", e1->wordWrap, e1->lineNumbers, e1->gutterWidth());
    look->wordWrap = false;
    look->lineNumbers = true;
    look->changed();
    settle();
    // an option set on one editor stays when only the colours change
    e2->showWhitespace = true;
    look->setThemeName("nord");
    printf("an option of one editor survives a theme change: %d\n", e2->showWhitespace);
    look->setThemeName("dark");

    // settings round trip: Look -> atheme.Settings -> text -> Settings -> Look
    look->tabWidth = 8;
    look->insertSpaces = false;
    look->trimOnSave = true;
    look->setFontIndex(gcode.FONT_SANS);
    look->setThemeName("gruvbox");
    atheme.Settings st();
    look->storeSettings(&st);
    char* text = st.toIni();
    atheme.Settings st2();
    st2.parse(text, strlen(text));
    asys.free(text);
    printf("settings: tab %d, spaces %d, trim %d, font %s, theme %s\n", st2.tabWidth, st2.insertSpaces, st2.trimOnSave, st2.font, st2.theme);
    look->tabWidth = 4;
    look->insertSpaces = true;
    look->trimOnSave = false;
    look->setFontIndex(gcode.FONT_MONO);
    look->setThemeName("dark");
    look->applySettings(&st2);
    printf("applied: tab %d, spaces %d, trim %d, font index %d, theme %s\n", look->tabWidth, look->insertSpaces, look->trimOnSave, look->fontIndex, look->theme->name);
    return 0;
}
