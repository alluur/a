int add(int a, int b) { return a + b; }
int fact(int n) { if (n <= 1) return 1; return n * fact(n - 1); }
int fib(int n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); }
int later(int x) { return helper(x) + 1; }   // used before definition
int helper(int x) { return x * 2; }
void hello(char* who) { print("hi "); println(who); }
int six(int a, int b, int c, int d, int e, int f) { return a + 2*b + 3*c + 4*d + 5*e + 6*f; }
bool isEven(int n) { if (n == 0) return true; return isOdd(n - 1); }
bool isOdd(int n) { if (n == 0) return false; return isEven(n - 1); }
int main() {
    printlnInt(add(2, 3));
    printlnInt(fact(10));
    printlnInt(fib(20));
    printlnInt(later(5));
    hello("world");
    printlnInt(six(1, 2, 3, 4, 5, 6));
    printBool(isEven(10)); println("");
    printBool(isOdd(10)); println("");
    printlnInt(add(add(1, 2), add(3, 4)));
    return 7;
}
