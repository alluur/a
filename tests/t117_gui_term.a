// the terminal emulator: escape sequences on a screen without a program, keys, selection, history, and a real shell on a
// pseudo terminal (Linux and Android only)
import wsrv;
import gui;
import gterm;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
gterm.Terminal* t;
int exited = 0;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

int onExit(int self) { exited++; return 0; }

// a text with the control characters shown as hex
void show(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        int c = s[i] & 255;
        if (c < 32 || c > 126) {
            print("<");
            printInt(c);
            print(">");
        } else {
            char one[2];
            one[0] = c;
            one[1] = 0;
            print(&one[0]);
        }
    }
    println("");
}

void rows(int from, int to) {
    for (int r = from; r <= to; r++) {
        print("|");
        print(t->lineText(r));
        println("|");
    }
}

void key(int k, int uni, int mods) {
    if (mods != 0) {
        if ((mods & adp.MOD_CTRL) != 0) { hb->keyDown(adp.KEY_CTRL, 0); }
        if ((mods & adp.MOD_SHIFT) != 0) { hb->keyDown(adp.KEY_SHIFT, 0); }
        if ((mods & adp.MOD_ALT) != 0) { hb->keyDown(adp.KEY_ALT, 0); }
    }
    hb->tap(k, uni);
    if (mods != 0) {
        if ((mods & adp.MOD_ALT) != 0) { hb->keyUp(adp.KEY_ALT, 0); }
        if ((mods & adp.MOD_SHIFT) != 0) { hb->keyUp(adp.KEY_SHIFT, 0); }
        if ((mods & adp.MOD_CTRL) != 0) { hb->keyUp(adp.KEY_CTRL, 0); }
    }
    settle();
}

int main() {
    hb = new wsrv.Headless(900, 640);
    srv = new wsrv.Server(hb, 7215);
    srv->allowScreenshots = true;
    gui.idleHook = stepServer;
    d = gui.connectAs("7215", "term");
    gui.Window* w = d->createWindow("Terminal", 100, 100, 0);
    t = new gterm.Terminal();
    t->onExit = onExit;
    gui.Box* col = gui.vbox(0, 0);
    col->add(t);
    w->setRoot(col);
    int pw = t->cellW() * 40 + 6;
    int ph = t->cellH() * 10 + 6;
    w->resize(pw, ph);
    settle();
    printlnInt(t->cols);
    printlnInt(t->rows);

    // text, line breaks, wrapping at the right edge
    t->feed("Hello, world\r\nSecond line");
    t->feed("\r\n0123456789012345678901234567890123456789ABCD");
    rows(0, 3);
    printlnInt(t->cursorRow * 100 + t->cursorCol);

    // cursor movement and erasing
    t->feed("\x1b[2J\x1b[H");
    t->feed("one\r\ntwo\r\nthree");
    t->feed("\x1b[1;4H<A>");
    t->feed("\x1b[3;1H\x1b[2K-gone-");
    t->feed("\x1b[2;2H\x1b[K");
    rows(0, 2);
    t->feed("\x1b[5;5Hxy\x1b[2D\x1b[1A@");
    printlnInt(t->cursorRow * 100 + t->cursorCol);
    rows(3, 4);

    // delete and insert
    t->feed("\x1b[2J\x1b[Habcdef\x1b[1;3H\x1b[2P");
    rows(0, 0);
    t->feed("\x1b[1;3H\x1b[2@XY");
    rows(0, 0);

    // colours and attributes are in the cells, a screenshot shows them
    t->feed("\x1b[2J\x1b[H\x1b[31mred \x1b[1;32mbold green\x1b[0m \x1b[44mblue bg\x1b[0m \x1b[38;5;208morange\x1b[0m \x1b[38;2;10;200;250mtrue\x1b[0m\r\n");
    t->feed("\x1b[7mreverse\x1b[0m \x1b[4munder\x1b[0m \x1b[2mdim\x1b[0m");
    rows(0, 1);
    settle();
    printlnInt(srv->screen->checksum());

    // the scroll region and scrolling
    t->feed("\x1b[2J\x1b[H");
    for (int i = 1; i <= 14; i++) {
        char buf[16];
        format(&buf[0], 16, "line %d\r\n", i);
        t->feed(&buf[0]);
    }
    rows(0, 9);
    t->feed("\x1b[2J\x1b[1;3r\x1b[3;1Hx\n\ny");
    rows(0, 3);
    t->feed("\x1b[r\x1b[2J");

    // the alternate screen keeps the main screen
    t->feed("\x1b[H\x1b[2Jmain screen");
    t->feed("\x1b[?1049h\x1b[2J\x1b[Halternate");
    rows(0, 0);
    t->feed("\x1b[?1049l");
    rows(0, 0);

    // UTF-8 and box drawing
    t->feed("\x1b[2J\x1b[H\xc3\xa4\xc3\xb6\xc3\xa5 \xe2\x82\xac\r\n\xe2\x94\x8c\xe2\x94\x80\xe2\x94\x90\r\n\xe2\x94\x82 \xe2\x94\x82\r\n\xe2\x94\x94\xe2\x94\x80\xe2\x94\x98");
    rows(0, 3);
    settle();
    printlnInt(srv->screen->checksum());

    // answers: cursor position report and device attributes (what the program would receive)
    t->feed("\x1b[2J\x1b[3;7H\x1b[6n\x1b[c");
    show(t->takeSent());

    // the title
    t->feed("\x1b]0;My title\x07");
    println(t->title);
    println("");
    t->feed("\x1b]2;Other\x1b\\");
    println(t->title);

    // keys: what a program receives
    t->feed("\x1b[2J\x1b[H");
    t->focusMe();
    settle();
    hb->moveTo(300, 500);
    key('a', 'a', 0);
    key('Z', 'Z', 0);
    key(adp.KEY_ENTER, 13, 0);
    key(adp.KEY_BACKSPACE, 8, 0);
    key(adp.KEY_TAB, 9, 0);
    key(adp.KEY_TAB, 9, adp.MOD_SHIFT);
    key(adp.KEY_ESCAPE, 27, 0);
    show(t->takeSent());
    key(adp.KEY_UP, 0, 0);
    key(adp.KEY_DOWN, 0, 0);
    key(adp.KEY_RIGHT, 0, 0);
    key(adp.KEY_LEFT, 0, 0);
    key(adp.KEY_HOME, 0, 0);
    key(adp.KEY_END, 0, 0);
    key(adp.KEY_PGUP, 0, 0);
    key(adp.KEY_PGDN, 0, 0);
    key(adp.KEY_DELETE, 0, 0);
    key(adp.KEY_INSERT, 0, 0);
    show(t->takeSent());
    key(adp.KEY_F1, 0, 0);
    key(adp.KEY_F1 + 4, 0, 0);
    key(adp.KEY_F1 + 11, 0, 0);
    key(adp.KEY_LEFT, 0, adp.MOD_CTRL);
    key(adp.KEY_UP, 0, adp.MOD_SHIFT);
    show(t->takeSent());
    key('c', 'c', adp.MOD_CTRL);
    key('d', 'd', adp.MOD_CTRL);
    key('x', 'x', adp.MOD_ALT);
    key(0xE4, 0xE4, 0);
    key(0x20AC, 0x20AC, 0);
    show(t->takeSent());
    t->feed("\x1b[?1h");
    key(adp.KEY_UP, 0, 0);
    show(t->takeSent());

    // history: lines that scroll off are kept; Shift+PageUp shows them
    t->feed("\x1b[?1l\x1b[2J\x1b[H");
    for (int i = 1; i <= 40; i++) {
        char buf[16];
        format(&buf[0], 16, "row %d\r\n", i);
        t->feed(&buf[0]);
    }
    println(t->lineText(0));
    key(adp.KEY_PGUP, 0, adp.MOD_SHIFT);
    settle();
    int a = srv->screen->checksum();
    key(adp.KEY_PGDN, 0, adp.MOD_SHIFT);
    settle();
    printlnInt(a != srv->screen->checksum());

    // selection with the mouse and the clipboard
    t->feed("\x1b[2J\x1b[H");
    t->feed("select this text\r\nand this line");
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    int cw = t->cellW();
    int ch = t->cellH();
    hb->moveTo(sw->x + 3 + cw * 7 + 2, sw->y + 3 + 2);
    hb->buttonDown(1);
    hb->moveTo(sw->x + 3 + cw * 5 + 2, sw->y + 3 + ch + 2);
    hb->buttonUp(1);
    settle();
    println(t->selectedText());
    printlnInt(srv->clientCount());
    println(d->clipText);

    // resize: the grid follows the widget
    w->resize(t->cellW() * 50 + 6, t->cellH() * 12 + 6);
    settle();
    printlnInt(t->cols);
    printlnInt(t->rows);
    println(t->lineText(0));

    // a real shell on a pseudo terminal
    gterm.Terminal* t2 = new gterm.Terminal();
    t2->onExit = onExit;
    gui.Window* w2 = d->createWindow("Shell", 100, 100, 0);
    gui.Box* col2 = gui.vbox(0, 0);
    col2->add(t2);
    w2->setRoot(col2);
    w2->resize(t2->cellW() * 60 + 6, t2->cellH() * 12 + 6);
    settle();
    bool ok = t2->start(d, "printf 'A\\033[31mB\\033[0m\\n'; stty size; echo done; exit 3");
    if (!ok) {
        println("no pty");
    } else {
        int t0 = millis();
        while (t2->running && millis() - t0 < 8000) {
            srv->step(0);
            d->pump(10);
        }
        settle();
        printlnInt(exited);
        printlnInt(t2->exitStatus);
        for (int r = 0; r < 3; r++) {
            println(t2->lineText(r));
        }
        // typing into an interactive shell
        gterm.Terminal* t3 = new gterm.Terminal();
        gui.Window* w3 = d->createWindow("Shell 2", 100, 100, 0);
        gui.Box* col3 = gui.vbox(0, 0);
        col3->add(t3);
        w3->setRoot(col3);
        w3->resize(t3->cellW() * 60 + 6, t3->cellH() * 12 + 6);
        settle();
        t3->start(d, "/bin/sh");
        t3->focusMe();
        settle();
        t0 = millis();
        while (millis() - t0 < 600) {
            srv->step(0);
            d->pump(10);
        }
        hb->typeText("echo hello-$((6*7))");
        hb->tap(adp.KEY_ENTER, 13);
        t0 = millis();
        bool found = false;
        while (!found && millis() - t0 < 5000) {
            srv->step(0);
            d->pump(10);
            for (int r = 0; r < t3->rows; r++) {
                if (streq(t3->lineText(r), "hello-42")) {
                    found = true;
                }
            }
        }
        printlnInt(found);
        t3->stop();
        printlnInt(t3->running);
    }
    d->disconnect();
    srv->close();
    return 0;
}
