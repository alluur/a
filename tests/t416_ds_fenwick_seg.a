// ds: Fenwick, RangeFenwick and SegTree (sum / min / max with lazy add and assign) against brute force
import cstdio;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 555;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

const N = 300;
int model[N];

int msum(int l, int r) {
    int s = 0;
    for (int i = (l < 0 ? 0 : l); i <= r && i < N; i++) { s = s + model[i]; }
    return s;
}

void fenwick() {
    ds.Fenwick f(N);
    int bad = 0;
    for (int i = 0; i < N; i++) { model[i] = 0; }
    for (int op = 0; op < 20000; op++) {
        int what = rnd(100);
        int i = rnd(N + 6) - 3;
        if (what < 35) {
            int d = rnd(2001) - 1000;
            f.add(i, d);
            if (i >= 0 && i < N) { model[i] = model[i] + d; }
        } else if (what < 45) {
            int v = rnd(1000);
            f.set(i, v);
            if (i >= 0 && i < N) { model[i] = v; }
        } else if (what < 70) {
            int j = i + rnd(120) - 10;
            if (f.sum(i, j) != msum(i, j)) { bad++; }
        } else if (what < 85) {
            if (f.prefix(i) != msum(0, i)) { bad++; }
        } else if (what < 95) {
            if (i >= 0 && i < N && f.get(i) != model[i]) { bad++; }
        } else {
            if (f.total() != msum(0, N - 1)) { bad++; }
        }
    }
    check(bad == 0, "random updates and sums agree with brute force");
    check(f.size() == N && f.sum(5, 4) == 0 && f.sum(-10, -1) == 0 && f.sum(N, N + 5) == 0, "empty and out of range sums");
    f.dispose();
    // lowerBound on non-negative values
    ds.Fenwick g(N);
    int vals[N];
    for (int i = 0; i < N; i++) { vals[i] = rnd(5); }
    g.build(&vals[0], N);
    bool ok = true;
    for (int i = 0; i < N; i++) {
        int s = 0;
        for (int k = 0; k <= i; k++) { s = s + vals[k]; }
        if (g.prefix(i) != s) { ok = false; }
    }
    check(ok, "build in O(n) gives the same sums");
    int total = g.total();
    for (int target = -2; target <= total + 3; target++) {
        int want = N;
        int s = 0;
        if (target <= 0) { want = 0; } else {
            for (int i = 0; i < N; i++) { s = s + vals[i]; if (s >= target) { want = i; break; } }
        }
        if (g.lowerBound(target) != want) { ok = false; }
    }
    check(ok, "lowerBound (find by prefix sum) for every target");
    g.clear();
    check(g.total() == 0, "clear");
    g.dispose();
    ds.Fenwick one(1);
    one.add(0, 5);
    check(one.total() == 5 && one.lowerBound(5) == 0 && one.lowerBound(6) == 1, "a tree of one element");
    one.dispose();
    ds.Fenwick none(0);
    none.add(0, 1);
    check(none.total() == 0 && none.lowerBound(1) == 0, "a tree of no elements");
    none.dispose();
}

void rangeFenwick() {
    ds.RangeFenwick f(N);
    int bad = 0;
    for (int i = 0; i < N; i++) { model[i] = 0; }
    for (int op = 0; op < 20000; op++) {
        int l = rnd(N + 6) - 3;
        int r = l + rnd(150) - 10;
        if (rnd(2) == 0) {
            int v = rnd(201) - 100;
            f.add(l, r, v);
            for (int i = (l < 0 ? 0 : l); i <= r && i < N; i++) { model[i] = model[i] + v; }
        } else {
            if (f.sum(l, r) != msum(l, r)) { bad++; }
            int p = rnd(N);
            if (f.get(p) != model[p] || f.prefix(p) != msum(0, p)) { bad++; }
        }
    }
    check(bad == 0, "range add and range sum agree with brute force");
    f.dispose();
}

// ---- segment tree -------------------------------------------------------------------------------------------------------------------------------
int mq(int op, int l, int r) {
    if (l < 0) { l = 0; }
    if (r >= N) { r = N - 1; }
    if (l > r) { return (op == 0) ? 0 : (op == 1 ? 0x7FFFFFFFFFFFFFFF : -0x7FFFFFFFFFFFFFFF - 1); }
    int best = model[l];
    for (int i = l; i <= r; i++) {
        if (op == 0) { best = (i == l) ? model[i] : best + model[i]; }
        else if (op == 1) { if (model[i] < best) { best = model[i]; } }
        else { if (model[i] > best) { best = model[i]; } }
    }
    return best;
}

void segtree(int op, int n, int ops, char* label) {
    ds.SegTree t(n, op);
    int bad = 0;
    for (int i = 0; i < N; i++) { model[i] = 0; }
    for (int o = 0; o < ops; o++) {
        int what = rnd(100);
        int l = rnd(n + 6) - 3;
        int r = l + rnd(n / 2 + 5) - 5;
        if (what < 25) {
            int v = rnd(201) - 100;
            t.add(l, r, v);
            for (int i = (l < 0 ? 0 : l); i <= r && i < n; i++) { model[i] = model[i] + v; }
        } else if (what < 45) {
            int v = rnd(201) - 100;
            t.assign(l, r, v);
            for (int i = (l < 0 ? 0 : l); i <= r && i < n; i++) { model[i] = v; }
        } else if (what < 50) {
            int v = rnd(1000);
            int p = rnd(n);
            t.set(p, v);
            model[p] = v;
        } else if (what < 85) {
            if (t.query(l, r) != mq(op, l, (r >= n) ? n - 1 : r)) { bad++; }
        } else if (what < 95) {
            int p = rnd(n);
            if (t.get(p) != model[p]) { bad++; }
        } else {
            if (t.total() != mq(op, 0, n - 1)) { bad++; }
        }
    }
    printf("%s\n", label);
    check(bad == 0, "random range updates and queries agree with brute force");
    t.dispose();
}

void segtreeEdges() {
    ds.SegTree s(10, ds.SEG_SUM);
    check(s.size() == 10 && s.total() == 0 && s.query(5, 4) == 0 && s.query(-5, -1) == 0, "empty ranges");
    s.assign(0, 9, 3);
    s.add(2, 4, 10);
    check(s.total() == 30 + 30 && s.query(2, 2) == 13 && s.get(5) == 3, "assign then add");
    s.assign(3, 3, 0);
    check(s.query(2, 4) == 13 + 0 + 13, "assign after add");
    ds.SegTree m(10, ds.SEG_MIN);
    check(m.total() == 0, "min of zeros");
    int v[10] = { 5, 3, 8, 1, 9, 2, 7, 4, 6, 0 };
    m.build(&v[0], 10);
    check(m.query(0, 9) == 0 && m.query(0, 8) == 1 && m.query(4, 7) == 2 && m.query(11, 20) == 0x7FFFFFFFFFFFFFFF, "min queries after build");
    m.add(0, 9, 100);
    m.assign(9, 9, 500);
    check(m.query(0, 9) == 101 && m.query(9, 9) == 500, "min with lazy updates");
    ds.SegTree x(7, ds.SEG_MAX);
    x.build(&v[0], 7);
    check(x.query(0, 6) == 9 && x.query(5, 6) == 7 && x.query(6, 100) == 7, "max queries, ranges are clipped");
    x.assign(0, 6, -50);
    check(x.total() == -50 && x.get(3) == -50, "assign negative");
    ds.SegTree one(1, ds.SEG_MAX);
    one.set(0, 77);
    check(one.total() == 77 && one.query(0, 0) == 77, "a tree of one element");
    ds.SegTree none(0, ds.SEG_MAX);
    check(none.size() == 0 && none.total() == -0x7FFFFFFFFFFFFFFF - 1 && none.get(0) == 0, "a tree of no elements");
    // non power of two sizes: the padding does not leak into min / max
    ds.SegTree p(5, ds.SEG_MIN);
    int w[5] = { 4, 5, 6, 7, 8 };
    p.build(&w[0], 5);
    check(p.total() == 4 && p.query(2, 4) == 6, "min with padding");
    ds.SegTree q(5, ds.SEG_MAX);
    int neg[5] = { -4, -5, -6, -7, -8 };
    q.build(&neg[0], 5);
    check(q.total() == -4 && q.query(1, 4) == -5, "max of negative numbers with padding");
    s.dispose(); m.dispose(); x.dispose(); one.dispose(); none.dispose(); p.dispose(); q.dispose();
}

void big() {
    int n = 200000;
    ds.SegTree t(n, ds.SEG_SUM);
    ds.Fenwick f(n);
    for (int i = 0; i < n; i++) { f.add(i, i % 7); }
    int total = 0;
    for (int i = 0; i < n; i++) { total = total + i % 7; }
    check(f.total() == total && f.sum(1000, 1999) == f.prefix(1999) - f.prefix(999), "a Fenwick tree of 200000 elements");
    for (int i = 0; i < n; i += 1000) { t.add(i, i + 999, 1); }
    t.add(0, n - 1, 2);
    check(t.total() == 3 * n && t.query(5000, 5999) == 3000, "segment tree range updates over 200000 elements");
    t.dispose();
    f.dispose();
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.Fenwick f(10000);
    ds.RangeFenwick r(10000);
    ds.SegTree s(10000, ds.SEG_MAX);
    f.dispose(); r.dispose(); s.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees everything");
    check(f.total() == 0 && r.sum(0, 5) == 0 && s.query(0, 5) == -0x7FFFFFFFFFFFFFFF - 1, "disposed trees are empty");
}

int main() {
    fenwick();
    rangeFenwick();
    segtree(0, 300, 20000, "sum");
    segtree(1, 300, 20000, "min");
    segtree(2, 300, 20000, "max");
    segtree(0, 37, 8000, "sum, 37 elements");
    segtree(1, 37, 8000, "min, 37 elements");
    segtree(2, 1, 500, "max, 1 element");
    segtreeEdges();
    big();
    memory();
    printf("fenwick and segment tree: %d checks, %d failures\n", checks, fails);
    return fails;
}
