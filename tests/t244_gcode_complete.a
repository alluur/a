// gcode.CodeEditor completion popup: Ctrl+Space, candidates from keywords, symbols and the words of every open document, keys
// and mouse, filtering while typing, undo, opening by itself after a pause
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;

void list(char* label) {
    printf("%s: %d candidates", label, e->completionCount());
    for (int i = 0; i < e->completionCount() && i < 6; i++) { printf(" %s", e->completionText(i)); }
    printf(" (selected %d)\n", e->completionSelected());
}

void text(char* label) {
    char* t = e->getText();
    printf("%s: [", label);
    for (int i = 0; t[i] != 0; i++) { printf("%c", (t[i] == 10) ? '|' : t[i]); }
    printf("] caret %d\n", e->ed->caret());
    asys.free(t);
}

int main() {
    gcode.theLook()->autoComplete = false;
    startServer(7344, "t244");
    w = d->createWindow("Editor", 640, 300, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    e->setText("int counter = 0;\nint count2 = 1;\nvoid counted() { }\nret\n");
    e->doc->setLanguage(asyntax.Lang.A);
    settle();

    // Ctrl+Space after a prefix: symbols first, then keywords, then words; shorter names before longer ones
    e->gotoLine(3, 3);
    settle();
    ctrl(' ');
    list("ret");
    key(adp.KEY_ESCAPE, 27);
    printf("Esc closes it: %d\n", e->completionOpen());
    e->ed->setCursor(e->buf->length() - 1);
    e->setText("int counter = 0;\nint count2 = 1;\nvoid counted() { }\ncou");
    e->gotoLine(3, 3);
    settle();
    ctrl(' ');
    list("cou");
    int px = 0; int py = 0;
    e->completionPoint(0, &px, &py);
    int py2 = 0;
    e->completionPoint(1, &px, &py2);
    printf("rows are %d pixels apart, the popup is below the caret line: %d\n", py2 - py, py > 3 * e->lineHeight());

    // keys: Down and Up (they wrap), Tab accepts, one undo step takes the whole word back
    key(adp.KEY_DOWN, 0);
    printf("down: selected %d\n", e->completionSelected());
    key(adp.KEY_UP, 0);
    key(adp.KEY_UP, 0);
    printf("up twice (wraps): selected %d\n", e->completionSelected());
    key(adp.KEY_TAB, 9);
    text("Tab accepts");
    printf("popup closed: %d\n", !e->completionOpen());
    ctrl('z');
    text("undo (the prefix is selected again, as it was before)");

    // Enter accepts too, and the mouse: a click on a row
    key(adp.KEY_END, 0);
    ctrl(' ');
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    text("Enter accepts the second one");
    e->setText("int counter = 0;\nint count2 = 1;\nvoid counted() { }\ncou");
    e->gotoLine(3, 3);
    settle();
    ctrl(' ');
    e->completionPoint(1, &px, &py);
    clickWd(w, e, px, py);
    text("a click on the second row");
    printf("closed: %d\n", !e->completionOpen());

    // a click somewhere else only closes it; other keys close it; typing a non word character closes it
    e->setText("int counter = 0;\ncou");
    e->gotoLine(1, 3);
    settle();
    ctrl(' ');
    clickWd(w, e, 300, 100);
    printf("click elsewhere closes: %d\n", !e->completionOpen());
    ctrl(' ');
    key(adp.KEY_LEFT, 0);
    printf("a movement key closes: %d\n", !e->completionOpen());
    key(adp.KEY_END, 0);
    ctrl(' ');
    typeStr(" ");
    printf("a space closes: %d\n", !e->completionOpen());

    // while the popup is open, typing narrows the list (the list is filtered by the longer prefix); Backspace asks again
    e->completeDelayMs = 0;
    e->setText("alpha alphabet alphanumeric beta\n");
    e->gotoLine(1, 0);
    settle();
    ctrl(' ');
    typeStr("al");
    list("al");
    typeStr("pha");
    list("alpha");
    typeStr("n");
    list("alphan");
    key(adp.KEY_BACKSPACE, 8);
    list("after Backspace");
    typeStr("x");
    printf("no candidates for alphax: popup open %d\n", e->completionOpen());
    key(adp.KEY_ESCAPE, 27);

    // it opens by itself while typing (two letters are enough); with a pause of 0 at once
    e->autoComplete = true;
    e->setText("alpha alphabet beta\n");
    e->gotoLine(1, 0);
    settle();
    typeStr("a");
    printf("one letter: popup open %d\n", e->completionOpen());
    typeStr("l");
    list("two letters");
    key(adp.KEY_ENTER, 13);
    text("Enter takes the first");
    key(adp.KEY_ENTER, 13);
    text("a second Enter is a new line");

    // with a pause the popup opens when the typing stops (a timer): wait for it
    e->completeDelayMs = 250;
    e->setText("gamma gammaray delta\n");
    e->gotoLine(1, 0);
    settle();
    typeStr("ga");
    printf("right after typing the popup is not open yet: %d\n", !e->completionOpen());
    for (int i = 0; i < 40 && !e->completionOpen(); i++) { d->pump(25); }
    list("after the pause");
    key(adp.KEY_ESCAPE, 27);

    // words of other documents are offered too, and keywords of the language of this one
    e->autoComplete = false;
    gcode.Doc* other = new gcode.Doc();
    other->setText("zebrafish quokka\n");
    e->setText("zeb\n");
    e->doc->setLanguage(asyntax.Lang.Text);
    e->gotoLine(0, 3);
    settle();
    ctrl(' ');
    list("zeb (the word is in another document)");
    key(adp.KEY_ESCAPE, 27);
    other->dispose();

    // the popup moves above the line near the bottom of the view
    char* many = (char*) asys.alloc(2000);
    int n = 0;
    for (int i = 0; i < 40; i++) { n = n + format(&many[n], 40, "value%d\n", i); }
    e->setText(many);
    asys.free(many);
    e->gotoLine(15, 0);
    e->ed->setCursor(e->buf->lineStart(15) + 5);
    e->gotoLine(15, 5);
    settle();
    e->setFirstLine(0);
    e->gotoLine(e->visibleRows() - 1, 5);
    settle();
    ctrl(' ');
    e->completionPoint(0, &px, &py);
    int cx = 0; int cy = 0;
    e->pointOfOffset(e->ed->caret(), &cx, &cy);
    printf("near the bottom the popup is above the caret: %d\n", py < cy);
    key(adp.KEY_ESCAPE, 27);

    // read only: nothing is inserted
    e->setText("value1\nva");
    e->gotoLine(1, 2);
    e->setReadOnly(true);
    settle();
    ctrl(' ');
    key(adp.KEY_TAB, 9);
    text("read only");
    return 0;
}
