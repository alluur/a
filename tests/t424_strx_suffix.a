// strx: suffix array (SA-IS), LCP, pattern queries, longest repeat, distinct substrings against naive computations, and a million letters
import cstdio;
import cstring;
import asys;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 8675309;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// compares suffix i and suffix j of s (length n)
int cmpSuffix(char* s, int n, int i, int j) {
    while (i < n && j < n) {
        if (s[i] != s[j]) { return (s[i] < s[j]) ? -1 : 1; }
        i++; j++;
    }
    if (i == n && j == n) { return 0; }
    return (i == n) ? -1 : 1;
}

int naiveLcp(char* s, int n, int i, int j) {
    int k = 0;
    while (i + k < n && j + k < n && s[i + k] == s[j + k]) { k++; }
    return k;
}

int naiveSa[400];

void naiveSuffixArray(char* s, int n) {
    for (int i = 0; i < n; i++) { naiveSa[i] = i; }
    for (int i = 1; i < n; i++) {
        int v = naiveSa[i];
        int j = i - 1;
        while (j >= 0 && cmpSuffix(s, n, naiveSa[j], v) > 0) { naiveSa[j + 1] = naiveSa[j]; j--; }
        naiveSa[j + 1] = v;
    }
}

int naiveCount(char* s, int n, char* p, int m) {
    int c = 0;
    for (int i = 0; i + m <= n; i++) { if (memcmp(&s[i], p, m) == 0) { c++; } }
    return c;
}

// number of different non empty substrings by brute force
int naiveDistinct(char* s, int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        for (int len = 1; i + len <= n; len++) {
            bool seen = false;
            for (int j = 0; j < i && !seen; j++) {
                if (j + len <= n && memcmp(&s[j], &s[i], len) == 0) { seen = true; }
            }
            if (!seen) { total++; }
        }
    }
    return total;
}

void randomStrings() {
    char s[300];
    int bad = 0;
    int badLcp = 0;
    int badQuery = 0;
    int badLcpOf = 0;
    int badRep = 0;
    int badDistinct = 0;
    for (int round = 0; round < 500; round++) {
        int n = rnd(round < 300 ? 40 : 250);
        int alpha = 1 + rnd(4);
        for (int i = 0; i < n; i++) { s[i] = 'a' + rnd(alpha); }
        s[n] = 0;
        strx.SuffixArray sa(&s[0], n);
        if (!sa.ok() || sa.size() != n) { bad++; continue; }
        naiveSuffixArray(&s[0], n);
        for (int i = 0; i < n; i++) {
            if (sa.at(i) != naiveSa[i]) { bad++; break; }
            if (sa.rank(naiveSa[i]) != i) { bad++; break; }
            int want = (i == 0) ? 0 : naiveLcp(&s[0], n, naiveSa[i - 1], naiveSa[i]);
            if (sa.lcp(i) != want) { badLcp++; break; }
        }
        // pattern queries
        for (int q = 0; q < 12; q++) {
            char p[8];
            int m = rnd(6);
            if (n > 0 && rnd(2) == 0 && m <= n) {                  // a substring of s: always present
                int at = rnd(n - m + 1);
                for (int i = 0; i < m; i++) { p[i] = s[at + i]; }
            } else {
                for (int i = 0; i < m; i++) { p[i] = 'a' + rnd(alpha + 1); }
            }
            int want = (m == 0) ? n + 1 : naiveCount(&s[0], n, &p[0], m);
            if (sa.count(&p[0], m) != want) { badQuery++; }
            int pos = sa.find(&p[0], m);
            if (m > 0 && ((want == 0) != (pos == -1) || (pos >= 0 && memcmp(&s[pos], &p[0], m) != 0))) { badQuery++; }
            if (m > 0) {
                int out[300];
                int got = sa.findAll(&p[0], m, &out[0], 300);
                if (got != want) { badQuery++; }
                else {
                    // the positions must be exactly the occurrences: mark them
                    char mark[300];
                    for (int i = 0; i < 300; i++) { mark[i] = 0; }
                    for (int i = 0; i < got; i++) { if (out[i] < 0 || out[i] + m > n || memcmp(&s[out[i]], &p[0], m) != 0 || mark[out[i]] != 0) { badQuery++; break; } mark[out[i]] = 1; }
                }
            }
        }
        // lcpOf on random pairs
        for (int q = 0; q < 10 && n > 0; q++) {
            int i = rnd(n + 1);
            int j = rnd(n + 1);
            int want = (i == n || j == n) ? 0 : naiveLcp(&s[0], n, i, j);
            if (sa.lcpOf(i, j) != want) { badLcpOf++; }
        }
        // longest repeat and distinct substrings
        int bestLen = 0;
        for (int i = 0; i < n; i++) { for (int j = i + 1; j < n; j++) { int l = naiveLcp(&s[0], n, i, j); if (l > bestLen) { bestLen = l; } } }
        int pos = -5;
        int len = sa.longestRepeat(&pos);
        if (len != bestLen || (len > 0 && (pos < 0 || pos + len > n || (naiveCount(&s[0], n, &s[pos], len) < 2)))) { badRep++; }
        if (round < 150 && n <= 22) {
            if (sa.distinctSubstrings() != naiveDistinct(&s[0], n)) { badDistinct++; }
        }
        sa.dispose();
    }
    check(bad == 0, "suffix array and rank agree with sorting all suffixes (500 random strings, up to 250 letters)");
    check(badLcp == 0, "LCP array agrees with the definition");
    check(badQuery == 0, "count, find and findAll agree with a naive scan");
    check(badLcpOf == 0, "lcpOf agrees with the definition");
    check(badRep == 0, "longestRepeat");
    check(badDistinct == 0, "distinctSubstrings against brute force");
}

void smallCases() {
    strx.SuffixArray s("banana");
    check(s.size() == 6 && s.at(0) == 5 && s.at(1) == 3 && s.at(2) == 1 && s.at(3) == 0 && s.at(4) == 4 && s.at(5) == 2, "banana: 5 3 1 0 4 2");
    check(s.lcp(0) == 0 && s.lcp(1) == 1 && s.lcp(2) == 3 && s.lcp(3) == 0 && s.lcp(4) == 0 && s.lcp(5) == 2, "banana: lcp 0 1 3 0 0 2");
    check(s.count("ana") == 2 && s.count("a") == 3 && s.count("banana") == 1 && s.count("bananas") == 0 && s.count("x") == 0 && s.count("") == 7, "banana: counts");
    check(s.find("nan") == 2 && s.find("zz") == -1, "banana: find");
    check(s.lcpOf(1, 3) == 3 && s.lcpOf(0, 2) == 0 && s.lcpOf(2, 2) == 4 && s.lcpOf(6, 1) == 0 && s.lcpOf(-1, 1) == -1 && s.lcpOf(1, 9) == -1, "banana: lcpOf");
    int pos = 0;
    check(s.longestRepeat(&pos) == 3 && pos == 1, "banana: the longest repeat is ana");
    check(s.distinctSubstrings() == 15, "banana: 15 distinct substrings");
    check(s.at(-1) == -1 && s.at(6) == -1 && s.rank(6) == -1 && s.lcp(6) == -1, "banana: bad indexes");
    s.dispose();
    check(s.size() == 0 && s.count("a") == 0 && s.find("a") == -1, "empty after dispose");
    strx.SuffixArray e("");
    check(e.size() == 0 && e.ok() && e.count("a") == 0 && e.longestRepeat(null) == 0 && e.distinctSubstrings() == 0, "empty text");
    e.dispose();
    strx.SuffixArray one("x");
    check(one.size() == 1 && one.at(0) == 0 && one.count("x") == 1 && one.lcpOf(0, 0) == 1, "one letter");
    one.dispose();
    // explicit length: the text is cut
    strx.SuffixArray cut("banana", 3);
    check(cut.size() == 3 && cut.count("an") == 1 && cut.count("na") == 0 && cut.count("ana") == 0, "length 3: ban");
    cut.dispose();
    // 0 and 255 bytes
    char b[8];
    b[0] = 255; b[1] = 0; b[2] = 255; b[3] = 0; b[4] = 1;
    strx.SuffixArray bin(&b[0], 5);
    char p[3]; p[0] = 255; p[1] = 0;
    check(bin.count(&p[0], 2) == 2 && bin.at(0) == 3 && bin.at(1) == 1 && bin.at(2) == 4 && bin.at(3) == 2 && bin.at(4) == 0, "binary data");
    bin.dispose();
    // the class works again after dispose when it is rebuilt
}

void big() {
    int n = 1000000;
    char* t = alloc(n + 1);
    for (int i = 0; i < n; i++) { t[i] = 'a' + rnd(4); }
    strx.SuffixArray sa(t, n);
    check(sa.ok() && sa.size() == n, "a million random letters");
    // the array must be a permutation in which neighbours are in order, using the LCP values
    char* seen = alloc(n + 1);
    int bad = 0;
    for (int i = 0; i < n; i++) {
        int p = sa.at(i);
        if (p < 0 || p >= n || seen[p] != 0) { bad++; continue; }
        seen[p] = 1;
        if (i > 0) {
            int q = sa.at(i - 1);
            int l = sa.lcp(i);
            if (l > 0 && memcmp(&t[p], &t[q], l) != 0) { bad++; }
            // the next letters decide: q's suffix is smaller
            bool qEnds = (q + l >= n);
            bool pEnds = (p + l >= n);
            if (pEnds) { bad++; }
            else if (!qEnds && t[q + l] >= t[p + l]) { bad++; }
            if (sa.rank(p) != i) { bad++; }
        }
    }
    check(bad == 0, "a million letters: permutation, ordered neighbours, rank is the inverse, lcp is a real common prefix");
    // pattern counts of a few short patterns against a scan
    char* pats[3] = { "abc", "dddd", "badcab" };
    int badCount = 0;
    for (int k = 0; k < 3; k++) {
        int m = strlen(pats[k]);
        int want = 0;
        for (int i = 0; i + m <= n; i++) { if (memcmp(&t[i], pats[k], m) == 0) { want++; } }
        if (sa.count(pats[k]) != want || want == 0) { badCount++; }
    }
    check(badCount == 0, "counts of three patterns in a million letters");
    sa.dispose();
    // worst cases for naive constructions: one letter, and a short period
    for (int i = 0; i < n; i++) { t[i] = 'a'; }
    strx.SuffixArray za(t, n);
    int badA = 0;
    for (int i = 0; i < n; i += 997) { if (za.at(i) != n - 1 - i || za.lcp(i) != i) { badA++; } }
    check(badA == 0 && za.at(n - 1) == 0 && za.lcpOf(0, 1) == n - 1, "a^1000000: suffixes in order of length");
    za.dispose();
    int k = n / 2;
    for (int i = 0; i < k; i++) { t[2 * i] = 'a'; t[2 * i + 1] = 'b'; }
    strx.SuffixArray ab(t, n);
    int badB = 0;
    for (int i = 0; i < k; i += 313) { if (ab.at(i) != 2 * (k - 1 - i)) { badB++; } }
    for (int i = 0; i < k; i += 313) { if (ab.at(k + i) != 2 * (k - 1 - i) + 1) { badB++; } }
    check(badB == 0 && ab.longestRepeat(null) == n - 2 && ab.count("abab") == k - 1, "(ab)^500000: the order of the suffixes and the longest repeat");
    ab.dispose();
}

int main() {
    smallCases();
    randomStrings();
    big();
    check(asys.memBadFrees() == 0, "no bad free");
    printf("suffix: %d checks, %d failures\n", checks, fails);
    return fails;
}
