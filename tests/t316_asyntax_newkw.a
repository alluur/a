// asyntax: the keywords of the second tier of the language (foreach in rev, abstract override final, is as, static_assert) are keywords in A
// source, are not keywords in other languages' lexers where they are ordinary words, and A code with the new syntax is covered without gaps
import asyntax;

int fails;

void check(bool ok, char* what) {
    if (!ok) { fails++; printf("FAIL: %s\n", what); }
}

// the kinds of the words of a line that are keywords, as a text
void keywords(int lang, char* line) {
    asyntax.Token tk[64];
    int es = 0;
    int len = strlen(line);
    int n = asyntax.lexLine(lang, 0, line, len, &tk[0], 64, &es);
    int covered = 0;
    bool gapless = true;
    printf("%s:", line);
    for (int i = 0; i < n; i++) {
        if (tk[i].start != covered || tk[i].len <= 0) { gapless = false; }
        covered = tk[i].start + tk[i].len;
        if (tk[i].kind == asyntax.Tok.Keyword) {
            char buf[40];
            int l = tk[i].len;
            if (l > 38) { l = 38; }
            memcpy(&buf[0], &line[tk[i].start], l);
            buf[l] = 0;
            printf(" %s", &buf[0]);
        }
    }
    println("");
    check(gapless && covered == len, "tokens cover the line without gaps");
}

int main() {
    keywords(asyntax.Lang.A, "foreach (int x in values) { }");
    keywords(asyntax.Lang.A, "foreach (int i, Item* it in rev items) {");
    keywords(asyntax.Lang.A, "abstract class Shape { abstract int area(); }");
    keywords(asyntax.Lang.A, "class Dog : Animal { override final int speak() { return 1; } }");
    keywords(asyntax.Lang.A, "if (a is Dog && (a as Dog)->bark() > 0) {");
    keywords(asyntax.Lang.A, "static_assert(sizeof(int) == 8, \"int\");");
    keywords(asyntax.Lang.A, "switch (s) { case \"a\", \"b\": break; case 1..5: break; }");
    keywords(asyntax.Lang.A, "outer: for (;;) { break outer; }");
    keywords(asyntax.Lang.A, "a ||= b; c ??= d; e &&= f; // foreach in comments are not keywords");
    keywords(asyntax.Lang.C, "int in = 0; int is = 1; int as = 2;");
    keywords(asyntax.Lang.Python, "for x in items: print(x is None)");
    printf("%d failures\n", fails);
    return 0;
}
