// cookie authentication of the display protocol, HMAC-SHA256, DES (VNC passwords), secure bytes and hex
import wsrv;
import gui;
import hash;
import des;
import secure;
import adp;

wsrv.Server* srv;

int stepServer(int unused) { srv->step(0); return 0; }

void hexLine(char* data, int n) {
    println(secure.toHex(data, n));
}

int main() {
    // HMAC-SHA256 test vectors (RFC 4231 cases 1 and 2, and a long key)
    char out[32];
    char key1[20];
    for (int i = 0; i < 20; i++) { key1[i] = 0x0b; }
    hash.hmacSha256(&key1[0], 20, "Hi There", 8, &out[0]);
    hexLine(&out[0], 32);
    hash.hmacSha256("Jefe", 4, "what do ya want for nothing?", 28, &out[0]);
    hexLine(&out[0], 32);
    char key131[131];
    for (int i = 0; i < 131; i++) { key131[i] = 0xaa; }
    hash.hmacSha256(&key131[0], 131, "Test Using Larger Than Block-Size Key - Hash Key First", 54, &out[0]);
    hexLine(&out[0], 32);
    printlnInt(hash.equalConstantTime("abcd", "abcd", 4));
    printlnInt(hash.equalConstantTime("abcd", "abce", 4));

    // DES: the textbook vector, a round trip, and the VNC response for a password
    char k[8];
    char p[8];
    char c[8];
    char b[8];
    secure.fromHex("133457799bbcdff1", &k[0], 8);
    secure.fromHex("0123456789abcdef", &p[0], 8);
    des.encryptBlock(&k[0], &p[0], &c[0]);
    hexLine(&c[0], 8);
    des.decryptBlock(&k[0], &c[0], &b[0]);
    hexLine(&b[0], 8);
    char ch[16];
    char resp[16];
    secure.fromHex("000102030405060708090a0b0c0d0e0f", &ch[0], 16);
    des.vncResponse("secret", &ch[0], &resp[0]);
    hexLine(&resp[0], 16);
    des.vncResponse("secretXXextra", &ch[0], &resp[0]);
    hexLine(&resp[0], 16);

    // hex and secure bytes
    printlnInt(secure.fromHex("00ff10", &c[0], 8));
    printlnInt(secure.fromHex("0g", &c[0], 8));
    printlnInt(secure.fromHex("abc", &c[0], 8));
    char r1[16];
    char r2[16];
    secure.unique(&r1[0]);
    secure.unique(&r2[0]);
    printlnInt(hash.equalConstantTime(&r1[0], &r2[0], 16));
    char rnd[32];
    int have = secure.bytes(&rnd[0], 32);
    printlnInt(have == 1 || have == 0);

    // a server with a cookie
    wsrv.Headless* hb = new wsrv.Headless(320, 200);
    srv = new wsrv.Server(hb, 7218);
    gui.idleHook = stepServer;
    printlnInt(srv->setCookie("1234"));
    printlnInt(srv->setCookie("zz112233445566778899aabbccddeeff"));
    printlnInt(srv->setCookie("00112233445566778899aabbccddeeff"));
    printlnInt(srv->hasCookie());
    printlnInt(srv->listenOn("0.0.0.0", 7219));
    gui.Display* none = gui.connectWith("7219", "nocookie", "");
    printlnInt(none == null);
    gui.Display* wrong = gui.connectWith("7219", "wrong", "ffeeddccbbaa99887766554433221100");
    printlnInt(wrong == null);
    gui.Display* ok = gui.connectWith("7219", "right", "00112233445566778899AABBCCDDEEFF");
    printlnInt(ok != null);
    if (ok != null) {
        printlnInt(ok->screenW * 1000 + ok->screenH);
        gui.Window* w = ok->createWindow("Authed", 100, 60, 0);
        w->setRoot(new gui.Label("hi"));
        for (int i = 0; i < 30; i++) {
            srv->step(0);
            ok->pump(0);
        }
        printlnInt(srv->windowCount());
    }
    // a server without a cookie accepts anyone, and a client that sends requests before answering gets nothing
    srv->close();
    wsrv.Headless* hb2 = new wsrv.Headless(320, 200);
    srv = new wsrv.Server(hb2, 7220);
    printlnInt(srv->hasCookie());
    printlnInt(srv->listenOn("127.0.0.1", 7221));
    gui.Display* open = gui.connectWith("7221", "open", "ffeeddccbbaa99887766554433221100");
    printlnInt(open != null);
    srv->close();
    return 0;
}
