// forms in the HTML view (controls, GET and POST data, URL encoding), page anchors, and gnet: POST, cookies, redirect after POST
import wsrv;
import gui;
import ghtml;
import gnet;
import net;
import http;
import adp;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
int web = -1;

int stepWeb(int unused) {
    srv->step(0);
    if (web >= 0 && net.waitReadable(web, 0)) {
        int c = net.accept(web);
        if (c >= 0) {
            http.Request* q = new http.Request();
            if (http.readRequest(c, q)) {
                char* path = &q->path[0];
                char* cookie = q->header("Cookie");
                char buf[600];
                if (streq(path, "/post")) {
                    format(&buf[0], 600, "method=%s len=%d type=%s body=%s cookie=%s", &q->method[0], q->bodyLen, q->header("Content-Type"), q->body, cookie == null ? "none" : cookie);
                    http.respond(c, 200, "text/plain", &buf[0]);
                } else if (streq(path, "/login")) {
                    net.sendText(c, "HTTP/1.1 303 See Other\r\nLocation: /home\r\nSet-Cookie: sid=abc123; Path=/; HttpOnly\r\nSet-Cookie: theme=dark\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
                } else if (streq(path, "/home")) {
                    format(&buf[0], 600, "home method=%s cookie=%s", &q->method[0], cookie == null ? "none" : cookie);
                    http.respond(c, 200, "text/plain", &buf[0]);
                } else if (streq(path, "/logout")) {
                    net.sendText(c, "HTTP/1.1 200 OK\r\nSet-Cookie: sid=; Max-Age=0\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
                } else {
                    http.respond(c, 404, "text/plain", "no");
                }
            }
            net.close(c);
        }
    }
    return 0;
}

void wait(gnet.Fetch* f) {
    int t0 = millis();
    while (!f->done && millis() - t0 < 6000) {
        stepWeb(0);
        d->pump(5);
    }
}

gnet.Fetch* run(char* path, char* body) {
    gnet.Fetch* f = new gnet.Fetch();
    char url[100];
    format(&url[0], 100, "http://127.0.0.1:7290%s", path);
    if (body != null) { f->post(body, null); }
    f->start(d, &url[0], null);
    wait(f);
    return f;
}

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        stepWeb(0);
        d->pump(0);
    }
}

int submits = 0;
int onSubmit(int self) {
    ghtml.HtmlView* v = (ghtml.HtmlView*) self;
    submits++;
    println(v->submitMethod);
    println(v->submitUrl);
    println(v->submitBody);
    return 0;
}

void clickWidget(gui.Window* w, gui.Widget* wd, int dx, int dy) {
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    hb->click(sw->x + wd->absX() + dx, sw->y + wd->absY() + dy);
    settle();
}

int main() {
    // ---- the cookie jar ----------------------------------------------------------------------------------------------------------------
    gnet.CookieJar* j = new gnet.CookieJar();
    j->store("a.org", "sid=1; Path=/; HttpOnly");
    j->store("a.org", "theme=dark");
    j->store("b.org", "sid=2");
    println(j->header("a.org"));
    println(j->header("b.org"));
    printlnInt(j->header("c.org") == null);
    j->store("a.org", "sid=3");
    println(j->get("a.org", "sid"));
    j->store("a.org", "theme=; Max-Age=0");
    j->store("a.org", "sid=9; max-age=0");
    printlnInt(j->size());
    j->store("a.org", "novalue");
    j->store("a.org", "=x");
    printlnInt(j->size());

    // ---- the URL encoding and a page with forms --------------------------------------------------------------------------------------
    println(ghtml.urlEncode("Grace Hopper & co: 100% (é)"));
    hb = new wsrv.Headless(800, 600);
    srv = new wsrv.Server(hb, 7289);
    gui.idleHook = stepWeb;
    d = gui.connectAs("7289", "forms");
    web = net.listen(7290, 8);

    // ---- fetch: POST, cookies, redirect after POST --------------------------------------------------------------------------------------
    gnet.Fetch* f = run("/post", "a=1&b=two+words");
    println(f->body);
    f = run("/home", null);
    println(f->body);
    f = run("/login", "user=x");
    println(f->body);
    printlnInt(f->status);
    println(gnet.cookies()->header("127.0.0.1"));
    f = run("/home", null);
    println(f->body);
    f = run("/logout", null);
    println(gnet.cookies()->header("127.0.0.1"));
    gnet.cookies()->clear();
    f = run("/home", null);
    println(f->body);

    // ---- the forms ----------------------------------------------------------------------------------------------------------------------
    gui.Window* w = d->createWindow("Forms", 640, 520, 0);
    ghtml.HtmlView* v = new ghtml.HtmlView();
    v->onSubmit = onSubmit;
    gui.Box* col = gui.vbox(0, 0);
    col->add(v);
    w->setRoot(col);
    char* page = "<h1 id=top>Form</h1><form action='/post' method='POST'><p>Name <input name=name value='Ada'> Pass <input type=password name=pw size=8>"
                 "<input type=hidden name=secret value='a b'></p>"
                 "<p><input type=checkbox name=news value=yes checked> news <input type=checkbox name=spam> spam"
                 " <input type=radio name=size value=s> s <input type=radio name=size value=m checked> m <input type=radio name=size value=l> l</p>"
                 "<p><select name=colour><option value=r>Red<option value=g selected>Green<option>Blue</select></p>"
                 "<textarea name=note rows=2 cols=20>one\ntwo</textarea>"
                 "<p><input type=submit name=go value='Send it'> <button name=alt value=1>Other</button> <input type=button value=Nothing></p></form>"
                 "<form action='http://other.org/search?x=1#frag' method=get><input name=q> <input type=submit value=Go></form>";
    v->setHtml(page, "http://site.org/dir/page.html");
    settle();
    printlnInt(v->controlCount());
    // the controls in order: name pw secret news spam s m l colour note go alt nothing q go2
    gui.TextBox* name = (gui.TextBox*) v->controlWidget(0);
    println(name->text());
    printlnInt(v->controlWidget(2) == null);
    // type into the name field, tick the other boxes, choose a size, a colour
    name->focusMe();
    hb->tap(adp.KEY_END, 0);
    hb->typeText("!&");
    settle();
    println(name->text());
    gui.TextBox* pw = (gui.TextBox*) v->controlWidget(1);
    clickWidget(w, pw, 10, 10);
    hb->typeText("s3cret");
    settle();
    clickWidget(w, v->controlWidget(3), 8, 8);               // news off
    clickWidget(w, v->controlWidget(4), 8, 8);               // spam on
    clickWidget(w, v->controlWidget(7), 8, 8);               // size l
    guix.ComboBox* colour = (guix.ComboBox*) v->controlWidget(8);
    colour->focusMe();
    hb->tap(adp.KEY_DOWN, 0);
    settle();
    gui.TextArea* note = (gui.TextArea*) v->controlWidget(9);
    println(note->text());
    clickWidget(w, v->controlWidget(10), 20, 10);            // the submit button
    printlnInt(submits);
    // the other button: its name and value are sent instead
    clickWidget(w, v->controlWidget(11), 10, 10);
    printlnInt(submits);
    // a button of type button does nothing
    clickWidget(w, v->controlWidget(12), 10, 10);
    printlnInt(submits);
    // a GET form: the query goes on the address (the old query stays, the fragment goes), Enter in the field sends it
    gui.TextBox* q = (gui.TextBox*) v->controlWidget(13);
    q->focusMe();
    hb->typeText("cats and dogs");
    hb->tap(adp.KEY_ENTER, 13);
    settle();
    printlnInt(submits);

    // ---- anchors -------------------------------------------------------------------------------------------------------------------------
    v->setHtml("<h1 id=top>Top</h1><p>text</p><p><a name=middle></a>Middle</p><p>1</p><p>2</p><p>3</p><p>4</p><p>5</p><p>6</p><p>7</p><p>8</p><p>9</p><p>10</p><p>11</p><p>12</p><p>13</p><p>14</p><p>15</p><p>16</p><p>17</p><p>18</p><p>19</p><p>20</p><h2 id=end>The end</h2><p>last</p>", "http://x/");
    settle();
    printlnInt(v->scrollY);
    printlnInt(v->scrollToAnchor("end"));
    printlnInt(v->scrollY > 100);
    printlnInt(v->scrollToAnchor("top"));
    printlnInt(v->scrollY);
    printlnInt(v->scrollToAnchor("nothing"));
    printlnInt(v->anchorY("middle") > 0 && v->anchorY("middle") < v->anchorY("end"));
    d->disconnect();
    srv->close();
    return 0;
}
