struct Point {
    int x;
    int y;
}
struct Rect {
    Point a;
    Point b;
    char tag;
    int vals[3];
}
int area(Rect* r) { return (r.b.x - r.a.x) * (r.b.y - r.a.y); }
void move(Point* p, int dx, int dy) { p->x += dx; p->y += dy; }
int main() {
    Point p;
    p.x = 3; p.y = 4;
    printlnInt(p.x * p.x + p.y * p.y);
    move(&p, 10, 20);
    printlnInt(p.x); printlnInt(p.y);
    Rect r;
    r.a.x = 1; r.a.y = 1; r.b.x = 5; r.b.y = 4;
    r.tag = 'R';
    r.vals[0] = 7; r.vals[2] = 9;
    printlnInt(area(&r));
    printChar(r.tag); println("");
    printlnInt(r.vals[0] + r.vals[1] + r.vals[2]);
    Point q = p;          // copy
    q.x = 0;
    printlnInt(p.x); printlnInt(q.x);
    Point pts[3];
    pts[1].x = 99;
    printlnInt(pts[1].x);
    Point* hp = new Point;
    hp->x = 5; hp->y = 6;
    printlnInt(hp->x + hp->y);
    printlnInt(sizeof(Point)); printlnInt(sizeof(Rect));
    r.a = p;              // struct assignment
    printlnInt(r.a.x);
    return 0;
}
