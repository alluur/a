// the web backend: construction rules (token, host) and the page; the protocol itself is tested with real processes in tests/gui.sh
import wweb;
import wwebpage;

int main() {
    wweb.Web* a = new wweb.Web(320, 200, 7270, "127.0.0.1", null);
    printlnInt(a->ok());
    println(a->url());
    a->shutdown();
    wweb.Web* b = new wweb.Web(320, 200, 7271, "127.0.0.1", "abcd1234");
    printlnInt(b->ok());
    println(b->url());
    b->shutdown();
    // a token needs 8 letters or digits; any other host needs one
    wweb.Web* c = new wweb.Web(320, 200, 7272, "127.0.0.1", "short");
    printlnInt(c->ok());
    wweb.Web* d = new wweb.Web(320, 200, 7273, "127.0.0.1", "has space or-dash");
    printlnInt(d->ok());
    wweb.Web* e = new wweb.Web(320, 200, 7274, "0.0.0.0", null);
    printlnInt(e->ok());
    wweb.Web* f = new wweb.Web(320, 200, 7275, "0.0.0.0", "token0123");
    printlnInt(f->ok());
    f->shutdown();
    // the page
    char* page = wwebpage.html();
    printlnInt(strlen(page) > 3000);
    printlnInt(indexOf(page, '@') >= 0);
    char* withTok = wwebpage.withToken(page, "TOK12345");
    printlnInt(strlen(withTok) == strlen(page) + 1);
    int at = indexOf(withTok, 10);
    printlnInt(at > 0);
    printlnInt(indexOf(withTok, '@') < 0 || withTok[indexOf(withTok, '@') + 1] != 'T');
    return 0;
}
