// Review fixes of the algo1 stage: every ds class zeroed (no constructor), with size 0, 1, 2 and after dispose() answers like an empty container and never crashes
// (Fenwick.clear() on an empty Fenwick used to crash); naturalCompare / naturalSort with null; SuffixArray with an empty pattern; BloomFilter and CountMinSketch
// tell when they cannot store; the examples of the module headers and of docs/ALGO.md are run here exactly as printed there (two of them did not compile).
import cstdio;
import cstring;
import asys;
import algo;
import ds;
import strx;
import rng;

int fails = 0;

void check(bool ok, char* what) {
    if (!ok) {
        printf("FAIL: %s\n", what);
        fails++;
    }
}

// ---- zeroed objects: the classes without a size grow on first use -----------------------------------------------------------------------
void zeroedGrowing() {
    { ds.Deque d; check(d.pushBack(1) && d.pushFront(0) && d.size() == 2 && d.popBack() == 1, "zeroed Deque grows"); d.dispose(); d.clear(); check(d.pushBack(7) && d.popFront() == 7, "Deque after dispose"); d.dispose(); }
    { ds.BinaryHeap h; h.push(3, 30); h.push(1, 10); check(h.popValue() == 10 && h.size() == 1 && h.verify(), "zeroed BinaryHeap"); h.dispose(); h.clear(); check(h.size() == 0 && h.pop() == 0, "BinaryHeap after dispose"); }
    { ds.PriorityQueue q; q.enqueue(5, 50); q.enqueue(2, 20); check(q.dequeue() == 20, "zeroed PriorityQueue"); q.dispose(); check(q.dequeue() == 0, "PriorityQueue after dispose"); }
    { ds.OrderedMap m; m.put(3, 4); check(m.get(3, -1) == 4 && m.verify(), "zeroed OrderedMap"); m.dispose(); m.clear(); check(m.size() == 0 && m.get(3, -1) == -1 && m.firstNode() == -1, "OrderedMap after dispose"); m.put(5, 6); check(m.get(5, -1) == 6, "OrderedMap reused"); m.dispose(); }
    { ds.OrderedSet m; m.add(3); check(m.has(3) && m.verify(), "zeroed OrderedSet"); m.dispose(); m.clear(); check(!m.has(3) && m.first(-1) == -1, "OrderedSet after dispose"); }
    { ds.OrderedTextMap m; m.put("a", 4); check(m.get("a", -1) == 4 && m.verify(), "zeroed OrderedTextMap"); m.dispose(); m.clear(); check(!m.has("a") && m.first() == null, "OrderedTextMap after dispose"); }
    { ds.OrderedTextSet m; m.add("a"); check(m.has("a") && m.verify(), "zeroed OrderedTextSet"); m.dispose(); m.clear(); check(!m.has("a") && m.first() == null, "OrderedTextSet after dispose"); }
    { ds.HashMap m; m.put(3, 4); check(m.get(3, -1) == 4 && m.verify(), "zeroed HashMap"); m.dispose(); m.clear(); check(m.get(3, -1) == -1 && m.first() == -1, "HashMap after dispose"); }
    { ds.HashSet m; m.add(3); check(m.has(3), "zeroed HashSet"); m.dispose(); m.clear(); check(!m.has(3) && m.first() == -1, "HashSet after dispose"); }
    { ds.TextHashMap m; m.put("a", 4); check(m.get("a", -1) == 4, "zeroed TextHashMap"); m.dispose(); m.clear(); check(m.get("a", -1) == -1, "TextHashMap after dispose"); }
    { ds.TextHashSet m; m.add("a"); check(m.has("a"), "zeroed TextHashSet"); m.dispose(); m.clear(); check(!m.has("a"), "TextHashSet after dispose"); }
    { ds.Trie m; m.put("a", 4); check(m.get("a", -1) == 4 && m.verify(), "zeroed Trie"); m.dispose(); m.clear(); check(!m.has("a") && m.countPrefix("") == 0 && m.countWildcard("*") == 0, "Trie after dispose"); }
    { ds.IntervalSet m; m.add(1, 5); check(m.contains(3) && m.verify(), "zeroed IntervalSet"); m.dispose(); m.clear(); check(!m.contains(3) && m.count() == 0, "IntervalSet after dispose"); }
    { ds.DisjointSet m; int a = m.add(); int b = m.add(); m.unite(a, b); check(m.same(a, b) && m.count() == 2 && m.groups == 1, "zeroed DisjointSet"); m.dispose(); check(m.count() == 0 && m.find(0) == -1, "DisjointSet after dispose"); }
    { ds.BitSet m; check(m.resize(10) && m.size() == 10, "zeroed BitSet resizes"); m.setAll(); check(m.count() == 10, "BitSet setAll"); m.dispose(); m.clearAll(); m.setAll(); check(m.count() == 0 && m.size() == 0 && !m.get(0), "BitSet after dispose"); }
}

// ---- classes with a size or capacity: zeroed they store nothing, say so, and never crash --------------------------------------------------
void zeroedSized() {
    { ds.RingBuffer r; check(!r.push(1) && r.size() == 0 && r.pop() == 0 && r.capacity() == 0, "zeroed RingBuffer stores nothing"); r.clear(); r.dispose(); r.clear(); int o[2]; check(r.copyTo(&o[0]) == 0 && r.get(0) == 0, "RingBuffer after dispose"); }
    { ds.ByteRing r; char o[4]; check(r.write("abc", 3) == 0 && r.read(&o[0], 3) == 0 && r.peek(&o[0], 3) == 0 && r.skip(2) == 0, "zeroed ByteRing stores nothing"); r.clear(); r.dispose(); r.clear(); check(r.available() == 0 && r.byteAt(0) == -1, "ByteRing after dispose"); }
    { ds.Fenwick f; check(f.size() == 0, "zeroed Fenwick is empty"); f.add(0, 1); f.set(0, 1); f.clear(); check(f.total() == 0 && f.prefix(5) == 0 && f.sum(0, 3) == 0 && f.lowerBound(3) == 0 && f.get(0) == 0, "zeroed Fenwick answers 0"); f.build(null, 0); f.dispose(); f.clear(); }
    { ds.Fenwick f(0); f.clear(); f.add(0, 1); check(f.total() == 0, "Fenwick(0).clear()"); f.dispose(); f.clear(); }
    { ds.Fenwick f(5); f.add(2, 9); f.dispose(); f.clear(); f.add(2, 9); check(f.size() == 0 && f.total() == 0 && f.prefix(3) == 0, "Fenwick after dispose().clear()"); }
    { ds.RangeFenwick f; f.add(0, 1, 1); f.dispose(); check(f.size() == 0 && f.sum(0, 3) == 0 && f.get(0) == 0, "zeroed RangeFenwick"); }
    { ds.SegTree t; t.add(0, 1, 1); t.assign(0, 0, 1); t.set(0, 5); check(t.size() == 0 && t.query(0, 3) == 0 && t.get(0) == 0, "zeroed SegTree"); t.build(null, 0); t.dispose(); check(t.total() == 0, "SegTree after dispose"); }
    { ds.LruCache c; check(!c.put(3, 4) && c.capacity() == 0 && c.get(3, -1) == -1 && c.size() == 0, "zeroed LruCache has capacity 0, not 16"); c.clear(); c.dispose(); c.clear(); }
    { ds.TextLruCache c; check(!c.put("a", 4) && c.capacity() == 0 && c.get("a", -1) == -1, "zeroed TextLruCache has capacity 0"); c.clear(); c.dispose(); c.clear(); }
    { ds.BloomFilter b; check(!b.add(1) && !b.addText("a") && !b.addBytes("ab", 2) && !b.mightContain(1) && b.bitCount() == 0, "zeroed BloomFilter has no bits and says so"); b.clear(); b.dispose(); b.clear(); }
    { ds.CountMinSketch c; check(!c.add(1, 5) && !c.addText("a", 1) && !c.addBytes("ab", 2, 1) && c.estimate(1) == 0 && c.widthOf() == 0 && c.total() == 0, "zeroed CountMinSketch has no table and says so"); c.clear(); c.dispose(); c.clear(); }
    { ds.BloomFilter b(100, 100); check(b.add(1) && b.addText("x") && b.addBytes("xy", 2) && b.mightContain(1) && b.bitCount() > 0, "a real BloomFilter: add returns true"); b.dispose(); check(!b.add(1) && !b.mightContain(1), "BloomFilter after dispose cannot store"); }
    { ds.CountMinSketch c(100, 5); check(c.add(1, 3) && !c.add(1, 0) && !c.add(1, -2) && c.estimate(1) >= 3 && c.total() == 3, "a real CountMinSketch: add returns true, an amount <= 0 false"); c.dispose(); check(!c.add(1, 3), "CountMinSketch after dispose cannot store"); }
    { ds.BloomFilter b(0x7FFFFFFFFFFFFFFF, 100); check(b.bitCount() == 0 && !b.add(1), "an absurd BloomFilter size is refused, add says false"); }
}

// ---- sizes 0, 1 and 2 with every method, also with indexes around the ends (only "no crash" and the checks matter, the sums are thrown away) ----
int sink = 0;

void smallSizes() {
    for (int s = 0; s <= 2; s++) {
        { ds.Fenwick f(s); for (int i = -1; i <= 3; i++) { f.add(i, 5); f.set(i, 2); sink = sink + f.get(i) + f.prefix(i) + f.sum(i, i + 1); } int v[3] = {1, 2, 3}; f.build(&v[0], 3); check(f.size() == s && f.total() == ((s == 0) ? 0 : (s == 1) ? 1 : 3), "Fenwick small total"); sink = sink + f.lowerBound(2) + f.lowerBound(0) + f.lowerBound(99); f.clear(); check(f.total() == 0, "Fenwick small clear"); f.dispose(); f.clear(); }
        { ds.RangeFenwick f(s); for (int i = -1; i <= 3; i++) { f.add(i, i + 1, 4); sink = sink + f.get(i) + f.prefix(i) + f.sum(i, i + 1); } check(f.size() == s, "RangeFenwick small size"); f.dispose(); }
        { ds.SegTree t(s, ds.SEG_MAX); for (int i = -1; i <= 3; i++) { t.add(i, i + 1, 4); t.assign(i, i, 7); sink = sink + t.get(i) + t.query(i, i + 1); } int v[3] = {1, 2, 3}; t.build(&v[0], 3); sink = sink + t.total(); check(t.size() == s, "SegTree small size"); t.dispose(); }
        { ds.BitSet b(s); for (int i = -1; i <= 3; i++) { b.set(i); b.flip(i); sink = sink + b.get(i) + b.nextSet(i) + b.nextClear(i) + b.prevSet(i); } b.setRange(-2, 5); b.setAll(); b.clearAll(); check(b.size() == s && b.count() == 0, "BitSet small"); b.dispose(); }
        { ds.DisjointSet d(s); for (int i = -1; i <= 3; i++) { d.unite(i, i + 1); sink = sink + d.find(i) + d.sizeOf(i) + d.same(i, 0); } check(d.count() <= ((s > 0) ? s : 0), "DisjointSet small count"); d.dispose(); }
        { ds.Deque d(s); for (int i = 0; i < 4; i++) { d.pushBack(i); } for (int i = -1; i <= 4; i++) { sink = sink + d.get(i) + d.removeAt(i) + d.indexOf(i); d.insertAt(i, i); } check(d.size() > 0, "Deque small capacity grows"); d.dispose(); }
        { ds.RingBuffer r(s); for (int i = 0; i < 4; i++) { r.push(i); } for (int i = -1; i <= 4; i++) { sink = sink + r.get(i) + r.fromNewest(i); } check(r.size() == ((s < 1) ? 0 : (s < 2) ? 1 : 2), "RingBuffer small size"); r.dispose(); }
        { ds.ByteRing r(s, true); char o[4]; r.write("abcd", 4); check(r.available() == s, "ByteRing small available"); sink = sink + r.peek(&o[0], 4) + r.read(&o[0], 4) + r.skip(1) + r.byteAt(0); r.dispose(); }
        { ds.LruCache c(s); for (int i = 0; i < 4; i++) { c.put(i, i); } for (int i = -1; i <= 4; i++) { sink = sink + c.get(i, 0) + c.peek(i, 0) + c.remove(i); } check(c.size() == 0, "LruCache small size"); c.dispose(); }
        { ds.BloomFilter b(s, 2); b.add(1); sink = sink + b.mightContain(1) + b.mightContain(2) + b.fillPermille() + b.falsePositivePpm(); b.clear(); b.dispose(); }
        { ds.CountMinSketch c(s, s); c.add(1, 2); sink = sink + c.estimate(1) + c.estimate(9); c.clear(); c.dispose(); }
        { ds.HashMap m; ds.OrderedMap o; for (int i = 0; i < s; i++) { m.put(i, i); o.put(i, i); } check(m.size() == s && o.size() == s && o.verify() && m.verify(), "maps of size 0, 1, 2"); m.shrink(); m.dispose(); o.dispose(); }
    }
}

// ---- the strx and rng classes zeroed --------------------------------------------------------------------------------------------------------
void zeroedStrx() {
    { strx.Kmp p; check(p.find("abc", -1, 0) == 0 && p.count("abc", -1, true) == 4, "zeroed Kmp is an empty pattern"); p.dispose(); p.dispose(); }
    { strx.Horspool p; check(p.find("abc", -1, 0) == 0 && p.count("abc", -1, true) == 4, "zeroed Horspool is an empty pattern"); p.dispose(); }
    { strx.RabinKarp p; check(p.find("abc", -1, 0) == 0 && p.count("abc", -1, true) == 4, "zeroed RabinKarp is an empty pattern"); p.dispose(); }
    { strx.SuffixArray p; check(p.count("a") == 0 && p.find("a") == -1 && p.size() == 0 && p.lcpOf(0, 0) == 0, "zeroed SuffixArray is an empty text"); p.dispose(); }
    { strx.FuzzyMatcher p; int idx[4]; char* items[2]; items[0] = "abc"; items[1] = "x"; check(p.rank(&items[0], 2, &idx[0], 4) == 2, "zeroed FuzzyMatcher matches everything"); p.dispose(); }
    { strx.AhoCorasick p; check(p.count("abc") == 0, "zeroed AhoCorasick"); p.dispose(); p.dispose(); }
    { strx.LineDiff p; check(p.opCount() == 0, "zeroed LineDiff"); p.dispose(); }
    { rng.Rng r; check(r.below(1) == 0, "zeroed Rng"); }
    { rng.AliasTable a; check(a.size() == 0 && !a.ok(), "zeroed AliasTable"); a.dispose(); }
    { rng.ReservoirSampler a; check(!a.ok() && a.size() == 0, "zeroed ReservoirSampler"); a.dispose(); }
}

// ---- the fixes ----------------------------------------------------------------------------------------------------------------------------
void fixes() {
    // strx.naturalCompare(null, ...) crashed
    check(strx.naturalCompare(null, "a") < 0 && strx.naturalCompare("a", null) > 0 && strx.naturalCompare(null, null) == 0, "naturalCompare with null");
    check(strx.naturalCompare(null, "") == 0 && strx.naturalCompare("", null) == 0 && strx.naturalCompare(null, "a", true) < 0, "naturalCompare null is the empty text");
    char* items[5];
    items[0] = "b2"; items[1] = null; items[2] = "b10"; items[3] = "a"; items[4] = null;
    strx.naturalSort(&items[0], 5);
    check(items[0] == null && items[1] == null && strcmp(items[2], "a") == 0 && strcmp(items[3], "b2") == 0 && strcmp(items[4], "b10") == 0, "naturalSort with null items: they sort first");
    strx.naturalSort(&items[0], 5, true);
    strx.naturalSort(null, 4);
    strx.naturalSort(&items[0], -3);
    strx.naturalSort(&items[0], 0);
    check(strcmp(items[4], "b10") == 0, "naturalSort with a null array, negative and zero counts");

    // the empty pattern in a SuffixArray: n + 1 positions everywhere, like Kmp, Horspool and RabinKarp
    strx.SuffixArray sa("banana");
    int out[10];
    for (int i = 0; i < 10; i++) { out[i] = -9; }
    int total = sa.findAll("", -1, &out[0], 10);
    check(sa.count("") == 7 && total == 7 && sa.find("") == 0, "SuffixArray empty pattern counts 7");
    int seen[7];
    for (int i = 0; i < 7; i++) { seen[i] = 0; }
    for (int i = 0; i < 7; i++) { if (out[i] >= 0 && out[i] <= 6) { seen[out[i]]++; } }
    bool every = true;
    for (int i = 0; i < 7; i++) { if (seen[i] != 1) { every = false; } }
    check(every, "findAll(\"\") stores every position 0 .. 6 once");
    check(sa.findAll("", -1, &out[0], 3) == 7 && out[0] == 6 && out[1] == 5 && out[2] == 3, "findAll(\"\") with a small max stores only max, returns the total");
    check(sa.findAll("", -1, null, 3) == 7 && sa.findAll("", -1, &out[0], 0) == 7 && sa.findAll("", -1, &out[0], -4) == 7, "findAll(\"\") with null, 0 or negative max stores nothing");
    check(sa.findAll("an", -1, &out[0], 10) == 2 && sa.findAll("zz", -1, &out[0], 10) == 0, "SuffixArray non-empty patterns unchanged");
    strx.SuffixArray e("");
    out[0] = -9;
    check(e.count("") == 1 && e.findAll("", -1, &out[0], 4) == 1 && out[0] == 0 && e.find("") == 0, "empty text, empty pattern: one position");
    strx.Kmp k("");
    check(k.count("banana", -1, true) == 7, "Kmp agrees: 7");
    k.dispose();
    sa.dispose();
    e.dispose();
}

// ---- the examples of the module headers and of docs/ALGO.md, as printed there --------------------------------------------------------------
void headerExamples() {
    // lib/ds.a
    ds.Deque d(16);   d.pushBack(1); d.pushFront(0); int x = d.popBack();
    printf("deque %d size=%d first=%d\n", x, d.size(), d.get(0));
    ds.BinaryHeap h;  int hd = h.push(40, 7); h.push(10, 8); h.update(hd, 5); int v = h.popValue();
    printf("heap %d\n", v);
    ds.OrderedMap m;  m.put(10, 1); m.put(20, 2); int n = m.floorNode(15); int k = m.keyAt(n);
    int cnt = m.countRange(5, 25); int r = m.rank(20); int i3 = m.select(0);
    printf("ordered %d %d %d %d\n", k, cnt, r, m.keyAt(i3));
    ds.OrderedTextMap words;  words.put("pear", 1); char* nextWord = words.higher("apple");
    printf("words %s\n", nextWord);
    ds.HashMap hm;    hm.add(42, 1); hm.add(42, 1); int c = hm.get(42, 0);
    printf("hashmap %d\n", c);
    for (int e = hm.first(); e >= 0; e = hm.next(e)) { printf("entry %d -> %d\n", hm.keyAt(e), hm.valueAt(e)); }
    ds.Trie t;        t.put("car", 1); t.put("cat", 2); int n2 = t.countPrefix("ca"); int w = t.countWildcard("c?t");
    printf("trie %d %d\n", n2, w);
    ds.IntervalSet s; s.add(1, 5); s.add(6, 9); s.remove(3, 4);
    printf("intervals %d [%d,%d] [%d,%d]\n", s.count(), s.lowAt(0), s.highAt(0), s.lowAt(1), s.highAt(1));
    ds.LruCache lc(100);  lc.put(1, 10); int got = lc.get(1, -1);
    printf("lru %d\n", got);
    ds.BloomFilter bf(10000, 100);  bf.addText("alice"); bool maybe = bf.mightContainText("alice");
    printf("bloom %d\n", maybe);
    ds.BloomFilter f(1000, 100);  f.add(7);
    printf("bloom2 %d %d\n", f.mightContain(7), f.bitCount() > 0);
    ds.CountMinSketch cm(272, 5);  cm.add(5, 3); cm.add(5, 4);
    printf("cms %d\n", cm.estimate(5) >= 7);
    ds.Deque dq2;  dq2.pushBack(5);  dq2.pushBack(6);
    int total2 = 0;
    foreach (int q in dq2) { total2 = total2 + q; }
    printf("foreach deque %d\n", total2);

    // docs/ALGO.md: the ds example (the heap with ds.cmpDesc and the descending order)
    ds.BinaryHeap hd2(ds.cmpDesc);  hd2.push(1, 100); hd2.push(9, 900); hd2.push(5, 500);
    printf("cmpDesc %d\n", hd2.popValue());
    ds.OrderedMap nm;  nm.put(10, 1);  nm.put(20, 2);
    printf("nth %d\n", nm.keyAt(nm.select(0)));

    // lib/strx.a and docs/ALGO.md
    strx.AhoCorasick ac;  ac.add("he"); ac.add("she"); ac.add("hers");  ac.build();
    int ids[16]; int ends[16];  int kk = ac.findAll("ushers", -1, ids, ends, 16);
    printf("aho %d:", kk);
    for (int i = 0; i < kk; i++) { printf(" %d@%d", ids[i], ends[i]); }
    printf("\n");
    ac.dispose();
    printf("hamming %d %d %d\n", strx.hamming("karolin", 7, "kathrin", 7), strx.hamming("ab", -1, "abc", -1), strx.hammingBits("a", 1, "b", 1));
    printf("common %d %d\n", strx.commonPrefix("interview", 9, "internet", 8), strx.commonSuffix("walking", 7, "talking", 7));
    char* textA = "one\ntwo\nthree\n";
    char* textB = "one\n2\nthree\nfour\n";
    int n1; int n22; bool noEol;
    char** la = strx.splitLines(textA, -1, &n1, &noEol, false);
    char** lb = strx.splitLines(textB, -1, &n22, null, true);
    printf("lines %d %d noEol=%d\n", n1, n22, noEol);
    strx.LineDiff ld;  ld.run(la, n1, lb, n22);
    char* patch = ld.unified("a.txt", "b.txt", 3);
    printf("%s", patch);
    strx.freeText(patch);  ld.dispose();  strx.freeText((char*) la);  strx.freeText((char*) lb);
    strx.SuffixArray sa("banana", -1);
    int pos[8];
    printf("suffix %d %d %d %d\n", sa.count("ana", 3), sa.find("nan", 3), sa.findAll("a", 1, &pos[0], 8), sa.lcpOf(1, 3));

    // lib/rng.a and docs/ALGO.md (the same seed gives the same numbers on every target)
    rng.Xoshiro256 g(12345);   int roll = g.uniformInt(1, 6);   double xv = g.normalAt(100.0, 15.0);   int kp = g.poisson(4.5);
    // (the exact sequences of the generators are checked by t430 to t436; here only that the example runs and gives sane values)
    printf("rng %d %d %d\n", roll >= 1 && roll <= 6, xv > 40.0 && xv < 160.0, kp >= 0 && kp < 40);
    int deck[52]; algo.iota(deck, 52, 0); g.shuffle(deck, 52);
    int sum = 0;
    int cards[52];
    for (int i = 0; i < 52; i++) { cards[i] = 0; }
    for (int i = 0; i < 52; i++) { sum = sum + deck[i]; if (deck[i] >= 0 && deck[i] < 52) { cards[deck[i]]++; } }
    bool perm = true;
    for (int i = 0; i < 52; i++) { if (cards[i] != 1) { perm = false; } }
    printf("deck sum %d permutation %d shuffled %d\n", sum, perm, deck[0] != 0 || deck[1] != 1 || deck[2] != 2);
    char id[40]; rng.uuid4(id);
    printf("uuid %d v%c %d\n", (int) strlen(id), id[14], id[8] == '-' && id[13] == '-' && id[18] == '-' && id[23] == '-');
    char id2[40]; rng.Rng sysr; sysr.uuid4(id2);
    printf("uuid2 %d v%c\n", (int) strlen(id2), id2[14]);
    check(strcmp(id, id2) != 0, "two uuids differ");

    // everything the examples made goes back (the examples above do not dispose, the code below does)
    d.dispose(); h.dispose(); m.dispose(); words.dispose(); hm.dispose(); t.dispose(); s.dispose(); lc.dispose(); bf.dispose(); f.dispose(); cm.dispose();
    dq2.dispose(); hd2.dispose(); nm.dispose(); sa.dispose();
}

int main() {
    char warm[40];
    rng.uuid4(&warm[0]);                // the shared system generator of rng is made on first use and lives on: not a leak, so make it before counting
    int m0 = asys.memInUse();
    int b0 = asys.memBlocks();
    zeroedGrowing();
    zeroedSized();
    smallSizes();
    zeroedStrx();
    fixes();
    headerExamples();
    printf("memory: %d\n", asys.memBlocks() == b0 && asys.memInUse() == m0);
    printf("bad frees %d\n", asys.memBadFrees());
    printf("%s\n", (fails == 0) ? "OK" : "FAILED");
    return (fails == 0) ? 0 : 1;
}
