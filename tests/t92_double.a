import dmath;

struct Vec { double x; double y; }

double gsum = 0.5;
double garr[3];

double scale(double v, int k) { return v * k; }
int half(double v) { return (int)(v / 2); }

int main() {
    double a = 2.5;
    double b = a * 3 + 0.25;
    printlnDouble(b);
    printlnDouble(0.1 + 0.2);
    printlnDouble(1.0 / 3);
    printlnDouble(10 - a);
    printlnDouble(-a);
    printlnInt((int) b);
    printlnInt(a < b);
    printlnInt(a > b);
    printlnInt(a <= 2.5);
    printlnInt(a >= 2.6);
    printlnInt(a == 2.5);
    printlnInt(a != 2.5);
    printlnInt(3 > a);
    a += 1.5;
    a *= 2;
    printlnDouble(a);
    a -= 0.5;
    a /= 4;
    printlnDouble(a);
    Vec v;
    v.x = 3;
    v.y = 4;
    printlnDouble(dmath.sqrt(v.x * v.x + v.y * v.y));
    garr[0] = 1.25;
    garr[1] = garr[0] * 2;
    garr[2] = garr[1] + gsum;
    printlnDouble(garr[2]);
    printlnDouble(scale(1.5, 3));
    printlnInt(half(9.0));
    printlnDouble(dmath.floor(-2.5));
    printlnDouble(dmath.ceil(2.1));
    printlnDouble(dmath.pow(2, 10));
    printlnDouble(dmath.sin(0));
    printlnDouble(dmath.cos(0));
    printlnDouble(dmath.PI);
    println(doubleToFixed(3.14159265, 3));
    printlnDouble(parseDouble("123.456e2"));
    printlnDouble(1.7976931348623157e308);
    printlnDouble(5e-324);
    printlnDouble(123456789012345678901234567890.0);
    printlnDouble(0.30000000000000004);
    printlnInt(isNaN(dmath.nan()));
    printlnInt(isInf(1e308 * 10));
    bool t = a > 0;
    printlnInt(t);
    if (a) { println("truthy"); }
    double z = 0;
    if (!z) { println("zero"); }
    printlnDouble(a > 1 ? 1.5 : 2.5);
    return 0;
}
