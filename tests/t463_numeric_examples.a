// stats, matrix, optim: the examples of the module headers and of docs/ALGO.md, run as printed (the text of each example is the same as in the documentation, only wrapped in
// functions), so that the documentation cannot rot. Expected output: tests/algo2_ref/gen_t463.py (exact fractions and the 70 digit decimal distributions of refspecial.py).
import cstdio;
import asys;
import stats;
import matrix;
import optim;
import dmath;

void pr(char* name, double v) {
    printf("%s", name);
    printfd(" %.9g\n", __bits(v));
}

// ---- the example of the header of stats and of the stats section of docs/ALGO.md
void exampleStats() {
    double x[8] = {2.1, 2.5, 3.1, 3.6, 4.0, 4.4, 5.2, 5.9};   double y[8] = {1.1, 1.7, 2.0, 2.8, 3.1, 3.9, 4.2, 5.0};
    double m = stats.mean(x, 8),  sd = stats.stddev(x, 8, 1),  med = stats.median(x, 8);
    double q1 = stats.quantile(x, 8, 0.25, 7);                         // NumPy's default definition
    stats.Regression r = stats.linearFit(x, y, 8);                     // r.coef[0] + r.coef[1] x, r.r2, r.pvalue[1], r.residuals[i]
    stats.TestResult t = stats.ttestTwoSample(x, 8, y, 8, false, stats.TAIL_TWO);   // Welch: t.stat, t.pvalue
    double p = stats.tSf(2.5, 7.0);   double z = stats.normalQuantile(0.975, 0.0, 1.0);           // 1.959963984540054
    stats.Interval ci = stats.meanCI(x, 8, 0.95);                      // ci.lo, ci.hi
    pr("mean", m);
    pr("stddev", sd);
    pr("median", med);
    pr("quantile 0.25", q1);
    printf("regression status %d, n %d, p %d, df %d\n", r.err, r.n, r.p, r.df);
    pr("intercept", r.coef[0]);
    pr("slope", r.coef[1]);
    pr("r2", r.r2);
    pr("slope p value", r.pvalue[1]);
    pr("residual 0", r.residuals[0]);
    pr("residual 7", r.residuals[7]);
    pr("predict(4.2)", r.predict(4.2));
    pr("t", t.stat);
    pr("df", t.df);
    pr("p value", t.pvalue);
    pr("tSf(2.5, 7)", p);
    printfd("normalQuantile(0.975) %.15g\n", __bits(z));
    pr("ci lo", ci.lo);
    pr("ci hi", ci.hi);
    r.dispose();
}

// ---- the example of the header of matrix and of the matrix section of docs/ALGO.md
void exampleMatrix() {
    matrix.Matrix a(3, 3);                                         // 2 1 1 / 1 3 2 / 1 0 0
    double v[9] = {2, 1, 1, 1, 3, 2, 1, 0, 0};   for (int i = 0; i < 9; i++) { a.d[i] = v[i]; }
    matrix.LU f(&a);                                               // P A = L U with partial pivoting
    double b[3] = {4, 5, 6};   double x[3];
    if (f.solve(b, x) == matrix.OK) { printfd("x = %.12g %.12g %.12g\n", __bits(x[0]), __bits(x[1]), __bits(x[2])); } else { printf("%s\n", matrix.errorText(f.err)); }
    double d = f.det();  double rc = f.rcond();                    // 1-norm reciprocal condition estimate
    pr("det", d);
    printf("rcond within a factor 3 of the exact value 1/36: %d\n", rc >= 1.0 / 36.0 / 3.0 && rc <= 3.0 / 36.0);
    f.dispose();  a.dispose();
}

// ---- the callback example of the optim section
struct Decay { double k; int calls; }                              // the context: a parameter and a counter

double fdecay(double x, void* c) { Decay* p = (Decay*) c;  p->calls++;  return dmath.exp(-p->k * x) - 0.5; }

void exampleOptim() {
    Decay p;  p.k = 2.0;  p.calls = 0;
    optim.Result r = optim.brent(fdecay, &p, 0.0, 5.0, 1.0e-12, 100);      // the root of exp(-k x) = 1/2 in [0, 5]
    if (r.status == optim.OK) {
        pr("root", r.x);
        printf("calls counted by the context equal evals: %d, iterations below 30: %d\n", p.calls == r.evals, r.iterations < 30);
        printf("residual below 1e-12: %d\n", dmath.fabs(r.fx) < 1.0e-12);
    }
}

int main() {
    int base = asys.memInUse();
    exampleStats();
    exampleMatrix();
    exampleOptim();
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
