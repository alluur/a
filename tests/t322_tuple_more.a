// tuples: classes, structs, nesting, arrays, globals, parameters, narrow types, hostile shapes
struct P { int x; int y; }

class Box {
public:
    (int, int) size;
    int id;
    Box(int w, int h) { size = (w, h); id = 7; }
    (int, int) dims() { return size; }
    (int, char*) idName() { return (id, "box"); }
    void grow((int, int) by) { size = (size.0 + by.0, size.1 + by.1); }
}

(int, int) g;
(int, int) g2 = {3, 4};
static (int, int) g3;

((int, int), int) nested() { return ((1, 2), 3); }
(int, int) swapped((int, int) p) { return (p.1, p.0); }
int sum3(int a, (int, int) p) { return a + p.0 + p.1; }
(P, int) withStruct() { P p; p.x = 5; p.y = 6; return (p, 9); }
(uint8, int32, bool) narrow() { return (300, 5000 * 1000000, 5); }
(int, int) mk(int a) { return (a, a + 1); }
(int, int) fib2(int n) {
    if (n == 0) { return (0, 1); }
    (int a, int b) = fib2(n - 1);
    return (b, a + b);
}
(Box*, int) boxAndId() { return (new Box(1, 2), 42); }

int main() {
    var n = nested();
    printf("%d %d %d\n", n.0.0, n.0.1, n.1);
    (int, int) q = swapped((10, 20));
    printf("%d %d\n", q.0, q.1);
    printf("%d\n", sum3(1, (2, 3)));
    printf("%d\n", sum3(1, mk(5)));

    Box bx(4, 5);
    (int w, int h) = bx.dims();
    printf("%d %d\n", w, h);
    (int id, char* nm) = bx.idName();
    printf("%d %s\n", id, nm);
    bx.grow((10, 20));
    printf("%d %d\n", bx.size.0, bx.size.1);
    var (bp, bid) = boxAndId();
    printf("%d %d %d\n", bp->id, bp->size.1, bid);

    var (ws, bn) = withStruct();
    printf("%d %d %d\n", ws.x, ws.y, bn);
    ws.x = 99;
    var again = withStruct();
    printf("%d %d\n", ws.x, again.0.x);

    var (u, i32, bl) = narrow();
    printf("%d %d %d\n", u, i32, bl);

    // globals
    g = mk(5);
    printf("%d %d %d %d\n", g.0, g.1, g2.0, g2.1);
    g3 = g2;
    printf("%d\n", g3.1);
    (g.0, g.1) = mk(100);
    printf("%d %d\n", g.0, g.1);

    // pointers to tuples and arrays of tuples
    (int, int)* tp = &q;
    printf("%d %d\n", tp->0, tp->1);
    (int, int) ts[3];
    ts[0] = (1, 2);
    ts[1] = (3, 4);
    ts[2] = mk(7);
    printf("%d %d %d\n", ts[1].0, ts[0].1, ts[2].1);
    (ts[0], ts[1]) = (ts[1], ts[0]);
    printf("%d %d\n", ts[0].0, ts[1].0);
    (ts[0].0, ts[0].1) = (ts[0].1, ts[0].0);
    printf("%d %d\n", ts[0].0, ts[0].1);

    // recursion
    (int f1, int f2) = fib2(20);
    printf("%d %d\n", f1, f2);

    // tuples of tuples are copied whole
    (int, int) inner = (7, 8);
    var outer = (inner, 9);
    inner.0 = 0;
    printf("%d %d %d\n", outer.0.0, outer.0.1, outer.1);
    (var o1, var o2) = outer;
    printf("%d %d\n", o1.1, o2);

    // the elements are evaluated left to right, once each
    int cnt = 0;
    var ord = (cnt++, cnt++, cnt++);
    printf("%d %d %d %d\n", ord.0, ord.1, ord.2, cnt);

    // assignment targets are evaluated before the right side, the assignments run from left to right
    int idx = 0;
    int vals[3] = {0, 0, 0};
    (vals[idx], idx) = (5, 2);
    printf("%d %d %d %d\n", vals[0], vals[1], vals[2], idx);
    (idx, idx) = (1, 2);
    printf("%d\n", idx);

    // a tuple in a condition-driven loop
    int k = 0;
    int total = 0;
    while (k < 4) {
        (int lo, int hi) = (k, k * k);
        total = total + lo + hi;
        k++;
    }
    printf("%d\n", total);

    // patterns in the head of a for, foreach over tuples
    for (var (fa, fb) = (0, 1); fa < 60; (fa, fb) = (fb, fa + fb)) { printf("%d ", fa); }
    printf("\n");
    for ((int ga, int gb) = mk(1); ga < 4; (ga, gb) = mk(ga + 1)) { printf("%d,%d ", ga, gb); }
    printf("\n");
    foreach (var t in ts) { printf("%d:%d ", t.0, t.1); }
    printf("\n");
    foreach ((int, int)* tpp in ts) { printf("%d ", tpp->1); }
    printf("\n");

    // doubles in tuples survive the soft-float round trip
    (double dd, double ee) = (1.5, 2.25);
    (dd, ee) = (ee, dd);
    printf("%d %d\n", (int)(dd * 100.0), (int)(ee * 100.0));
    return 0;
}
