char* SERVER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPTCB5aADAgECAghotNTSsBOFvDAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAUMRIwEAYD\nVQQDDAkxMjcuMC4wLjEwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASQo30/KSJR\nbLR0qkuSKMRwxN2Xvd08KFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA\n0tODiEQ9MEeCoyEwHzAMBgNVHRMBAf8EAjAAMA8GA1UdEQQIMAaHBH8AAAEwCgYI\nKoZIzj0EAwIDRwAwRAIgU64nzo1fbN1Q020h4M68boDulT6ZPr2sHq2luv7FldQC\nIC+L4vvfr326IW2u5O57h04274NWnE7Q40w44uqIwI8m\n-----END CERTIFICATE-----\n";
char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";
char* STRANGER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPzCB5qADAgECAggQooP33JMRCDAKBggqhkjOPQQDAjATMREwDwYDVQQDDAhP\ndGhlciBDQTAgFw0yMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowFDESMBAG\nA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAESGzdSqEX\nfcdvOu7FW5LokaFUX6T3H+Uv6Phce9S06Dw9oh5p2phKAMqbGn8NL20emZetycF1\nyFTn/teSJ1Bt3aMhMB8wDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwR/AAABMAoG\nCCqGSM49BAMCA0gAMEUCIQDN+ASE1vNvveEm/4o9If40ZlMUQWP6kr0zrWnk1taQ\n9QIgYVrITfLWZqRs9cbjtTaEDcrOadDwvBx1R+R1f5qk01s=\n-----END CERTIFICATE-----\n";
char* STRANGER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2Hn4c01UmR2L+x+7\nDlLis81vDspgD6J4c2wPo8uS7W2hRANCAARIbN1KoRd9x2867sVbkuiRoVRfpPcf\n5S/o+Fx71LToPD2iHmnamEoAypsafw0vbR6Zl63JwXXIVOf+15InUG3d\n-----END PRIVATE KEY-----\n";

// POP3: the client against the server module over loopback (one thread: the server runs from net.setIdleHook), and the server through raw sockets. The exact replies of a whole
// dialogue (STAT, LIST, UIDL, RETR with line ends made CRLF and dots stuffed, TOP, DELE, RSET, QUIT), errors for every kind of bad message number, deletions that happen at QUIT and
// not when the connection breaks, a message of 300 KB that is sent in blocks, limits, APOP, STLS with a real handshake, plain bytes behind STLS, a client that refuses to send the password
// in the clear, and memory: the heap does not move over many sessions.
import pop3;
import pop3d;
import asys;
import net;
import tls;
import x509;
import mail;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

pop3d.Server* srv;
char root[200];
char box[300];

int hook() {
    srv->poll(0);
    return 0;
}

void rmTree(char* path) {
    asys.DirList dl;
    if (asys.listDir(path, &dl) < 0) return;
    for (int i = 0; i < dl.count; i++) {
        char sub[400];
        format(&sub[0], 400, "%s/%s", path, dl.name(i), 0, 0, 0, 0);
        asys.Stat st;
        if (asys.lstat(&sub[0], &st) >= 0 && st.isDir()) rmTree(&sub[0]); else asys.unlink(&sub[0]);
    }
    dl.dispose();
    asys.rmdir(path);
}

char* in(char* rel) {
    char* r = alloc(500);
    format(r, 500, "%s/%s", &box[0], rel, 0, 0, 0, 0);
    return r;
}

void put(char* rel, char* data, int n) { asys.writeFile(in(rel), data, n); }

// ---- raw connections ---------------------------------------------------------------------------------------------------------------------------------
bool closedFlag = false;

char* readFor(int h, int ms, bool untilFinal = true) {
    mail.Buf b;
    int t0 = millis();
    closedFlag = false;
    while (millis() - t0 < ms) {
        if (!net.waitReadable(h, 30)) {
            if (untilFinal && b.len > 0 && finished(&b)) break;
            continue;
        }
        char tmp[4096];
        int n = net.recv(h, &tmp[0], 4096);
        if (n <= 0) { closedFlag = true; break; }
        b.add(&tmp[0], n);
        if (untilFinal && finished(&b) && !net.waitReadable(h, 3)) break;
    }
    return b.take() ?? "";
}

// a reply is complete: a single line "+OK ..." / "-ERR ...", or a list that ends with a line "."
bool finished(mail.Buf* b) {
    if (b->len < 3 || b->d[b->len - 1] != 10) return false;
    bool multi = false;
    if (b->len >= 3 && (b->d[b->len - 2] == 13)) {
        // the first line decides: a +OK that starts a list is followed by a "." line; single line answers end at the first line
    }
    int firstEnd = 0;
    while (firstEnd < b->len && b->d[firstEnd] != 10) firstEnd++;
    char* t = b->text();
    bool listAnswer = (startsWith(t, "+OK") && (contains(t, "follow") || startsWith(t, "+OK\r\n") || contains(t, "capabilities")));
    if (!listAnswer) return firstEnd + 1 == b->len;
    return b->len >= 3 && b->d[b->len - 3] == '.' && b->d[b->len - 2] == 13 && (b->len == 3 || b->d[b->len - 4] == 10);
}

int rawOpen() {
    int h = net.connect("127.0.0.1", srv->port);
    net.setTimeout(h, 3000);
    readFor(h, 500);
    return h;
}

char* cmd(int h, char* line) {
    char* l = alloc(strlen(line) + 3);
    format(l, strlen(line) + 3, "%s\r\n", line, 0, 0, 0, 0, 0);
    net.send(h, l, strlen(l));
    return readFor(h, 2000);
}

int login(char* user, char* pass) {
    int h = rawOpen();
    char u[100];
    format(&u[0], 100, "USER %s", user, 0, 0, 0, 0, 0);
    cmd(h, &u[0]);
    format(&u[0], 100, "PASS %s", pass, 0, 0, 0, 0, 0);
    char* r = cmd(h, &u[0]);
    if (!startsWith(r, "+OK")) printf("     login: %s\n", r);
    return h;
}

pop3.Options* opts() {
    pop3.Options* o = pop3.newOptions();
    o->username = "ann";
    o->password = "secret";
    o->startTls = pop3.STARTTLS_NEVER;
    o->allowPlainLogin = true;
    o->record = true;
    o->commandTimeoutMs = 4000;
    o->dataTimeoutMs = 4000;
    return o;
}

int main() {
    char rnd[4];
    asys.randomBytes(&rnd[0], 4);
    format(&root[0], 200, "build/tests/t409-%d", (rnd[0] & 255) * 65536 + (rnd[1] & 255) * 256 + (rnd[2] & 255), 0, 0, 0, 0);
    format(&box[0], 300, "%s/ann", &root[0], 0, 0, 0, 0, 0);
    asys.mkdirs(in("new"));
    asys.mkdirs(in("cur"));
    char* m1 = "From: a@x.test\r\nSubject: one\r\n\r\nhello\r\n";
    char* m2 = "Subject: two\n\n.dot line\n..two dots\n\nend";
    put("new/1000.m1", m1, strlen(m1));
    put("new/1001.m2", m2, strlen(m2));
    int bigN = 300000;
    char* big = alloc(bigN + 1);
    int seed = 3;
    for (int i = 0; i < bigN; i++) { seed = seed * 1103515245 + 12345; int r = (seed >> 16) & 63; big[i] = r < 5 ? '\n' : (r < 7 ? '.' : 'a' + r % 26); }
    big[bigN - 1] = '\n';
    for (int i = 0; i + 1 < bigN; i++) { if (big[i] == '\n' && big[i + 1] == '\n') big[i + 1] = 'x'; }
    big[bigN - 1] = '\n';
    put("new/1002.big", big, bigN);
    put("new/1003.empty", "", 0);
    put("cur/0999.old:2,S", "Subject: old\r\n\r\nold message\r\n", 30);
    put("new/bad name", "x", 1);
    put("new/.hidden", "x", 1);
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    srv = pop3d.newServer();
    srv->addUser("ann", "secret", in(""));
    srv->addUser("bob", "pw", "build/tests/does-not-exist");
    srv->listenOn("127.0.0.1", 0, null);
    net.setIdleHook(hook);

    // ---- the dialogue -------------------------------------------------------------------------------------------------------------------------------------
    int h = rawOpen();
    check("commands before the login: -ERR", startsWith(cmd(h, "STAT"), "-ERR log in first") && startsWith(cmd(h, "RETR 1"), "-ERR log in first") && startsWith(cmd(h, "LIST"), "-ERR ") && startsWith(cmd(h, "DELE 1"), "-ERR ") && startsWith(cmd(h, "PASS x"), "-ERR USER first"));
    check("NOOP and CAPA before the login", startsWith(cmd(h, "NOOP"), "+OK") && startsWith(cmd(h, "CAPA"), "+OK capabilities follow\r\nUSER\r\nTOP\r\nUIDL\r\nRESP-CODES\r\nPIPELINING\r\nIMPLEMENTATION pop3d\r\n.\r\n"));
    check("USER, a wrong PASS, USER again, the right PASS", startsWith(cmd(h, "USER ann"), "+OK send PASS") && startsWith(cmd(h, "PASS wrong"), "-ERR authentication failed") && startsWith(cmd(h, "USER ann"), "+OK") && startsWith(cmd(h, "PASS secret"), "+OK 5 messages (")); 
    char* st = cmd(h, "STAT");
    int sz1 = strlen(m1);
    check("STAT: five messages (the file with a bad name and the hidden one are not listed)", startsWith(st, "+OK 5 ") && endsWith(st, "\r\n"));
    check("LIST n: the size as it goes over the wire (CRLF, no dot-stuffing counted)", streq(cmd(h, "LIST 1"), "+OK 1 39\r\n") && streq(cmd(h, "LIST 2"), "+OK 2 46\r\n"));
    char* l1 = cmd(h, "LIST");
    check("LIST: all messages, one line each, a dot at the end", startsWith(l1, "+OK\r\n1 ") && endsWith(l1, "\r\n.\r\n") && contains(l1, "\r\n5 "));
    check("UIDL: the file names", startsWith(cmd(h, "UIDL 1"), "+OK 1 1000.m1\r\n") && contains(cmd(h, "UIDL"), "\r\n5 0999.old:2,S\r\n") && contains(cmd(h, "UIDL"), "\r\n4 1003.empty\r\n"));
    check("RETR 1: the message as it is", streq(cmd(h, "RETR 1"), "+OK message follows\r\nFrom: a@x.test\r\nSubject: one\r\n\r\nhello\r\n.\r\n"));
    check("RETR 2: LF line ends become CRLF, dots are stuffed, a CRLF is added at the end", streq(cmd(h, "RETR 2"), "+OK message follows\r\nSubject: two\r\n\r\n..dot line\r\n...two dots\r\n\r\nend\r\n.\r\n"));
    check("RETR of the empty file", streq(cmd(h, "RETR 4"), "+OK message follows\r\n.\r\n"));
    check("TOP 2 1: the header and one line of the body", streq(cmd(h, "TOP 2 1"), "+OK top of message follows\r\nSubject: two\r\n\r\n..dot line\r\n.\r\n"));
    check("TOP 1 0: only the header (and the empty line)", streq(cmd(h, "TOP 1 0"), "+OK top of message follows\r\nFrom: a@x.test\r\nSubject: one\r\n\r\n.\r\n"));
    check("TOP 2 100: all of the message", streq(cmd(h, "TOP 2 100"), "+OK top of message follows\r\nSubject: two\r\n\r\n..dot line\r\n...two dots\r\n\r\nend\r\n.\r\n"));
    char* badn[10];
    badn[0] = "RETR 0"; badn[1] = "RETR 99"; badn[2] = "RETR abc"; badn[3] = "RETR 1 2"; badn[4] = "RETR"; badn[5] = "DELE 0"; badn[6] = "DELE x"; badn[7] = "LIST 99"; badn[8] = "UIDL 0"; badn[9] = "TOP 1";
    int badOk = 0;
    for (int i = 0; i < 10; i++) { if (startsWith(cmd(h, badn[i]), "-ERR ")) badOk++; else printf("     %s accepted\n", badn[i]); }
    check("bad message numbers and arguments: -ERR (0, too big, not a number, extra arguments, none, TOP without lines)", badOk == 10);
    check("DELE 1, DELE 1 again, RETR of the deleted message, STAT and LIST skip it", startsWith(cmd(h, "DELE 1"), "+OK message deleted") && startsWith(cmd(h, "DELE 1"), "-ERR no such message") && startsWith(cmd(h, "RETR 1"), "-ERR no such message")
        && startsWith(cmd(h, "STAT"), "+OK 4 ") && !contains(cmd(h, "LIST"), "\r\n1 "));
    check("RSET brings it back", startsWith(cmd(h, "RSET"), "+OK maildrop reset") && startsWith(cmd(h, "STAT"), "+OK 5 "));
    cmd(h, "DELE 2");
    net.close(h);
    int t0 = millis();
    while (millis() - t0 < 500) srv->poll(5);
    check("a connection that breaks deletes nothing", asys.exists(in("new/1000.m1")) && asys.exists(in("new/1001.m2")));
    h = login("ann", "secret");
    cmd(h, "DELE 1");
    cmd(h, "DELE 2");
    check("QUIT commits the deletions", startsWith(cmd(h, "QUIT"), "+OK bye") && !asys.exists(in("new/1000.m1")) && !asys.exists(in("new/1001.m2")) && asys.exists(in("new/1002.big")) && asys.exists(in("cur/0999.old:2,S")));
    net.close(h);
    put("new/1000.m1", m1, strlen(m1));
    put("new/1001.m2", m2, strlen(m2));

    // ---- the big message, in blocks -----------------------------------------------------------------------------------------------------------------------------
    h = login("ann", "secret");
    net.send(h, "RETR 3\r\n", 8);
    mail.Buf bigGot;
    int t1 = millis();
    while (millis() - t1 < 5000) {
        if (!net.waitReadable(h, 30)) { if (bigGot.len > 10 && endsWith(bigGot.text(), "\r\n.\r\n")) break; continue; }
        char tmp[8192];
        int n = net.recv(h, &tmp[0], 8192);
        if (n <= 0) break;
        bigGot.add(&tmp[0], n);
    }
    mail.Buf expect;
    expect.addText("+OK message follows\r\n");
    bool ls = true;
    for (int i = 0; i < bigN; i++) {
        int c = big[i] & 255;
        if (ls && c == '.') expect.addByte('.');
        if (c == 10) expect.addByte(13);
        expect.addByte(c);
        ls = c == 10;
    }
    expect.addText(".\r\n");
    check("RETR of 300000 bytes: every line CRLF, dots stuffed, a dot at the end", bigGot.len == expect.len && memcmp(bigGot.d, expect.d, expect.len) == 0);
    check("the session is usable after the big message (the next command was waiting)", startsWith(cmd(h, "NOOP"), "+OK"));
    net.close(h);

    // ---- the client ------------------------------------------------------------------------------------------------------------------------------------------------
    pop3.Options* o = opts();
    pop3.Client* c = pop3.newClient("127.0.0.1", srv->port, o);
    check("client: connect, CAPA, login", c->connect() && c->loggedIn && c->hasUidl && c->hasTop && !c->hasStls);
    check("transcript: the password is not in it", contains(c->transcript(), "C: USER ann\n") && contains(c->transcript(), "C: PASS ****\n") && !contains(c->transcript(), "secret"));
    check("count and octets", c->count() == 5 && c->octets > 300000);
    check("size of one message", c->size(1) == strlen(m1) && c->size(3) > 300000 && c->size(0) == -1 && c->size(7) == -1);
    char uid[100];
    check("UIDL of one message", c->uidl(1, &uid[0], 100) && streq(&uid[0], "1000.m1") && c->uidl(5, &uid[0], 100) && streq(&uid[0], "0999.old:2,S") && !c->uidl(9, &uid[0], 100));
    int n = 0;
    char* msg = c->retr(1, &n);
    check("retr: the whole message", msg != null && n == sz1 && memcmp(msg, m1, sz1) == 0 && msg[n] == 0);
    free(msg);
    msg = c->retr(2, &n);
    check("retr: dots un-stuffed, line ends CRLF", msg != null && streq(msg, "Subject: two\r\n\r\n.dot line\r\n..two dots\r\n\r\nend\r\n"));
    free(msg);
    msg = c->retr(3, &n);
    mail.Buf canon;
    for (int i = 0; i < bigN; i++) { if (big[i] == 10) canon.addByte(13); canon.addByte(big[i]); }
    check("retr: 300000 bytes", msg != null && n == canon.len && memcmp(msg, canon.d, n) == 0);
    free(msg);
    msg = c->top(2, 1, &n);
    check("top: the header and one line", msg != null && streq(msg, "Subject: two\r\n\r\n.dot line\r\n"));
    free(msg);
    check("retr of a message that does not exist: null, -ERR", c->retr(9, &n) == null && contains(c->error, "no such message") && c->noop());
    check("dele and reset, noop", c->dele(1) && c->reset() && c->count() == 5 && c->noop());
    check("quit commits: the message is gone for the next session", c->dele(1) && c->quit() && !asys.exists(in("new/1000.m1")));
    c->dispose();
    put("new/1000.m1", m1, strlen(m1));
    o = opts();
    o->maxMessage = 100000;
    c = pop3.newClient("127.0.0.1", srv->port, o);
    c->connect();
    check("retr over the limit: null, the connection is closed (the rest of the message cannot be skipped)", c->retr(3, &n) == null && contains(c->error, "bigger than the limit") && !c->isOpen());
    c->dispose();
    o = opts();
    o->allowPlainLogin = false;
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("the password is not sent in the clear: refused by the client, USER may go but PASS never", !c->connect() && contains(c->error, "no TLS") && !contains(c->transcript(), "PASS"));
    c->dispose();
    char url[200];
    format(&url[0], 200, "pop3://ann:secret@127.0.0.1:%d", srv->port, 0, 0, 0, 0, 0);
    check("a URL with a password and no TLS: refused (STLS is required for it, the server has none)", pop3.connect(&url[0]) == null && contains(pop3.error(), "STLS"));
    o = opts();
    c = pop3.connectWith(&url[0], o);
    check("... with startTls NEVER in the options it works", c != null && c->loggedIn);
    if (c != null) { c->quit(); c->dispose(); }
    check("URLs: other schemes, no host, bad ports", pop3.connect("http://x") == null && pop3.connect("pop3://") == null && pop3.connect("pop3://127.0.0.1:0") == null && pop3.connect("pop3://127.0.0.1:99999") == null);
    o = opts();
    o->password = "wrong";
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("a wrong password: connect fails with the text of the server", !c->connect() && contains(c->error, "authentication failed") && !c->isOpen());
    c->dispose();
    o = opts();
    o->username = "bob";
    o->password = "pw";
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("a user whose Maildir does not exist: an empty maildrop", c->connect() && c->count() == 0);
    c->dispose();

    // ---- limits ----------------------------------------------------------------------------------------------------------------------------------------------------
    h = login("ann", "secret");
    char* longCmd = alloc(3000);
    for (int i = 0; i < 2500; i++) longCmd[i] = 'A';
    check("a command line of 2500 bytes: -ERR, the session goes on", startsWith(cmd(h, longCmd), "-ERR line too long") && startsWith(cmd(h, "NOOP"), "+OK"));
    net.send(h, "NOOP\nQUIT\r\n", 11);
    check("a bare LF: -ERR, the QUIT behind it is not run", startsWith(readFor(h, 500), "-ERR bare CR or LF") && startsWith(cmd(h, "NOOP"), "+OK"));
    mail.Buf flood;
    for (int i = 0; i < 1000; i++) flood.addText("STAT\r\n");
    net.send(h, flood.d, flood.len);
    int lines = 0;
    int t2 = millis();
    while (lines < 1000 && millis() - t2 < 3000) {
        if (!net.waitReadable(h, 50)) continue;
        char tmp[4096];
        int k = net.recv(h, &tmp[0], 4096);
        if (k <= 0) break;
        for (int i = 0; i < k; i++) { if (tmp[i] == 10) lines++; }
    }
    check("1000 STAT commands in one write: 1000 answers", lines == 1000);
    mail.Buf rflood;
    for (int i = 0; i < 7000; i++) rflood.addText("RETR 4\r\n");
    net.send(h, rflood.d, rflood.len);
    int dots = 0;
    int t4 = millis();
    while (dots < 7000 && millis() - t4 < 5000) {
        if (!net.waitReadable(h, 50)) continue;
        char tmp[8192];
        int k = net.recv(h, &tmp[0], 8192);
        if (k <= 0) break;
        for (int i = 0; i + 2 < k; i++) { if (tmp[i] == 10 && tmp[i + 1] == '.' && tmp[i + 2] == 13) dots++; }
    }
    check("7000 pipelined RETRs of a small message: every one is answered, and there is no recursion that could use up the stack", dots >= 6990);
    net.close(h);
    h = rawOpen();
    cmd(h, "USER ann");
    cmd(h, "PASS bad1");
    cmd(h, "USER ann");
    char* third = cmd(h, "PASS bad2");
    check("the third failure: -ERR and -ERR too many failures, closed", contains(third, "-ERR") || closedFlag);
    cmd(h, "USER ann");
    char* fin = cmd(h, "PASS bad3");
    check("... the connection is closed", contains(fin, "too many failures") || closedFlag);
    net.close(h);
    srv->idleTimeoutMs = 300;
    h = rawOpen();
    char* idleMsg = readFor(h, 1500, false);
    check("idleTimeoutMs: a silent session gets -ERR and is closed", contains(idleMsg, "-ERR idle time out") || closedFlag);
    net.close(h);
    srv->idleTimeoutMs = 600000;

    // ---- APOP ----------------------------------------------------------------------------------------------------------------------------------------------------------
    pop3d.Server* ap = pop3d.newServer();
    ap->addUser("ann", "secret", in(""));
    ap->apop = true;
    ap->listenOn("127.0.0.1", 0, null);
    pop3d.Server* keep = srv;
    srv = ap;
    o = opts();
    o->useApop = true;
    o->allowPlainLogin = false;
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("APOP: the password is not sent, the login works", c->connect() && c->loggedIn && contains(c->transcript(), "C: APOP ****\n") && !contains(c->transcript(), "PASS") && c->count() == 5);
    c->dispose();
    o = opts();
    o->useApop = true;
    o->password = "wrong";
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("APOP with a wrong password: -ERR", !c->connect() && contains(c->error, "authentication failed"));
    c->dispose();
    srv = keep;
    int hp = rawOpen();
    check("a server without apop says -ERR to APOP", startsWith(cmd(hp, "APOP ann 00000000000000000000000000000000"), "-ERR APOP is not available"));
    net.close(hp);

    // ---- STLS ----------------------------------------------------------------------------------------------------------------------------------------------------------
    pop3d.Server* ts = pop3d.newServer();
    ts->addUser("ann", "secret", in(""));
    ts->tlsConfig = good;
    ts->requireTls = true;
    ts->listenOn("127.0.0.1", 0, null);
    srv = ts;
    h = rawOpen();
    check("requireTls: USER before STLS is refused", startsWith(cmd(h, "USER ann"), "-ERR login only after STLS") && startsWith(cmd(h, "CAPA"), "+OK") && contains(cmd(h, "CAPA"), "STLS\r\n"));
    net.close(h);
    h = rawOpen();
    net.send(h, "STLS\r\nUSER ann\r\n", 16);
    char* inj = readFor(h, 400, false);
    check("STLS followed by a command in the same read: the command is not run, the connection is closed", startsWith(inj, "+OK begin TLS negotiation") && !contains(inj, "send PASS"));
    net.close(h);
    o = opts();
    o->startTls = pop3.STARTTLS_REQUIRED;
    o->allowPlainLogin = false;
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("STLS: handshake, then the login on the encrypted connection, CAPA again", c->connect() && c->secure && c->loggedIn && !c->hasStls && contains(c->transcript(), "C: STLS\nS: +OK begin TLS negotiation\n"));
    msg = c->retr(1, &n);
    check("a message over TLS", msg != null && n == strlen(m1) && memcmp(msg, m1, n) == 0);
    free(msg);
    c->quit();
    c->dispose();
    o = opts();
    o->startTls = pop3.STARTTLS_NEVER;
    o->allowPlainLogin = true;
    c = pop3.newClient("127.0.0.1", srv->port, o);
    check("a client that does not use STLS cannot log in to a server that requires it", !c->connect() && contains(c->error, "STLS"));
    c->dispose();
    srv = keep;

    // ---- a big mailbox: the login counts the sizes in slices, the other connections are served meanwhile (the old login read the whole mailbox before it did anything else) ---------
    char bigBox[300];
    format(&bigBox[0], 300, "%s/big", &root[0], 0, 0, 0, 0, 0);
    char nb[400];
    format(&nb[0], 400, "%s/new", &bigBox[0], 0, 0, 0, 0, 0);
    asys.mkdirs(&nb[0]);
    mail.Buf lineBuf;
    for (int i = 0; i < 500; i++) {
        char ln[100];
        int ll = format(&ln[0], 100, "line %d of the big message, filled up to 79 characters with some text .........", 1000 + i, 0, 0, 0, 0, 0);
        while (ll < 79) { ln[ll] = 'z'; ll++; }
        ln[79] = '\n';
        lineBuf.add(&ln[0], 80);
    }
    for (int i = 0; i < 12; i++) {
        char fnm[500];
        format(&fnm[0], 500, "%s/m%03d", &nb[0], i, 0, 0, 0, 0);
        asys.writeFile(&fnm[0], lineBuf.d, lineBuf.len);
    }
    char* oneName = alloc(500);
    format(oneName, 500, "%s/m000", &nb[0], 0, 0, 0, 0, 0);
    srv->addUser("big", "pw", &bigBox[0]);
    srv->scanBytesPerTurn = 4096;
    int steps0 = srv->scanSteps;
    int ha = rawOpen();
    cmd(ha, "USER big");
    net.send(ha, "PASS pw\r\nSTAT\r\n", 15);                // the login and a command that follows at once
    int hb = net.connect("127.0.0.1", srv->port);
    net.setTimeout(hb, 3000);
    bool bGreeted = false;
    bool aEarly = false;
    int tb = millis();
    while (millis() - tb < 3000 && !bGreeted) {
        srv->poll(0);
        if (net.waitReadable(hb, 0)) bGreeted = true;
    }
    if (bGreeted) aEarly = net.waitReadable(ha, 0);                  // the answer to PASS is not there yet: the scan is still going on
    check("big mailbox: a second client gets its greeting while the login of the first still counts", bGreeted && !aEarly);
    char* ra = readFor(ha, 3000, false);
    int per = 40000 + 500;
    char want[200];
    format(&want[0], 200, "+OK 12 messages (%d octets)\r\n+OK 12 %d\r\n", per * 12, per * 12, 0, 0, 0, 0);
    check("big mailbox: the sizes are right (LF counted as CRLF), and the command sent behind PASS is answered behind it", streq(ra, &want[0]));
    check("big mailbox: the count took many slices (4 KiB a turn)", srv->scanSteps - steps0 >= 100);
    check("big mailbox: LIST 12 is the size on the wire", streq(cmd(ha, "LIST 12"), "+OK 12 40500\r\n"));
    check("big mailbox: STAT after the login: 12 messages, 486000 octets", startsWith(cmd(ha, "STAT"), "+OK 12 486000"));
    net.close(ha);
    net.close(hb);
    srv->scanBytesPerTurn = 2097152;
    // a client that leaves in the middle of the count: the session, the listing and the file are freed
    int hAb = 0;
    for (int r = 0; r < 6; r++) {
        if (r == 2) hAb = __heap_pos;
        srv->scanBytesPerTurn = 4096;
        int hx = net.connect("127.0.0.1", srv->port);
        net.setTimeout(hx, 2000);
        char tmp2[600];
        net.recv(hx, &tmp2[0], 500);
        net.send(hx, "USER big\r\n", 10);
        net.recv(hx, &tmp2[0], 500);
        net.send(hx, "PASS pw\r\n", 9);
        for (int k = 0; k < 3; k++) srv->poll(0);                    // the scan has begun
        net.close(hx);
        int tx = millis();
        while (millis() - tx < 1500 && srv->sessions > 0) srv->poll(5);
    }
    check("big mailbox: a client that leaves in the middle of the count: no session is left, the heap did not move", srv->sessions == 0 && __heap_pos == hAb);
    if (__heap_pos != hAb) printf("     the heap grew by %d bytes\n", __heap_pos - hAb);
    srv->scanBytesPerTurn = 2097152;

    // ---- memory ----------------------------------------------------------------------------------------------------------------------------------------------------------
    int h0 = 0;
    for (int r = 0; r < 12; r++) {
        if (r == 3) h0 = __heap_pos;
        o = opts();
        c = pop3.newClient("127.0.0.1", srv->port, o);
        if (c->connect()) {
            int cnt = c->count();
            for (int i = 1; i <= cnt && i < 5; i++) {
                c->size(i);
                c->uidl(i, &uid[0], 100);
                char* mm = c->retr(i, &n);
                if (mm != null) free(mm);
                char* tt = c->top(i, 2, &n);
                if (tt != null) free(tt);
            }
            c->retr(99, &n);
            c->dele(2);
            c->reset();
            c->quit();
        }
        c->dispose();
        free((char*) o);
        int rh = net.connect("127.0.0.1", srv->port);
        net.setTimeout(rh, 2000);
        char tmp[600];
        net.recv(rh, &tmp[0], 500);
        net.send(rh, "USER ann\r\n", 10);
        net.recv(rh, &tmp[0], 500);
        net.send(rh, "PASS secret\r\n", 13);
        net.recv(rh, &tmp[0], 500);
        net.send(rh, "RETR 3\r\n", 8);
        net.recv(rh, &tmp[0], 50);
        net.close(rh);
    }
    check("12 sessions with every command, a message that is dropped in the middle: the heap did not move", __heap_pos == h0);
    if (__heap_pos != h0) printf("     the heap grew by %d bytes\n", __heap_pos - h0);
    int t3 = millis();
    while (millis() - t3 < 1500 && srv->sessions > 0) srv->poll(5);
    check("every session was freed", srv->sessions == 0 && srv->net->watchCount() == 0);

    net.setIdleHook(null);
    rmTree(&root[0]);
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
