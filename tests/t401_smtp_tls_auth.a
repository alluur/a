// generated by tests/gen/gen_https_test.py (test certificates, valid until 2100): do not edit
char* CA_PEM = "-----BEGIN CERTIFICATE-----\nMIIBLjCB1aADAgECAggQvbB9NiqTqjAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjASMRAwDgYD\nVQQDDAdUZXN0IENBMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEZoa0iPF3loM9\nqz2/ImJLRjibLJ9hd1WdtHD49KKzTbauTzUXNZX0JXbYVQF1P3l/QpVkXnf50+NE\n5T+hdgwFwaMTMBEwDwYDVR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDAgNIADBFAiAi\n2nMi9gLSWn22okG7qxH4QY8cymApI39Z6xKucwY6DQIhAJGEtUeEhQhgL/OMhpvm\ngSel0jdLf5pEleFCFoHzH7Hn\n-----END CERTIFICATE-----\n";
char* SERVER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPTCB5aADAgECAghotNTSsBOFvDAKBggqhkjOPQQDAjASMRAwDgYDVQQDDAdU\nZXN0IENBMCAXDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAUMRIwEAYD\nVQQDDAkxMjcuMC4wLjEwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASQo30/KSJR\nbLR0qkuSKMRwxN2Xvd08KFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA\n0tODiEQ9MEeCoyEwHzAMBgNVHRMBAf8EAjAAMA8GA1UdEQQIMAaHBH8AAAEwCgYI\nKoZIzj0EAwIDRwAwRAIgU64nzo1fbN1Q020h4M68boDulT6ZPr2sHq2luv7FldQC\nIC+L4vvfr326IW2u5O57h04274NWnE7Q40w44uqIwI8m\n-----END CERTIFICATE-----\n";
char* SERVER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgjkHetyroAurcAQSh\noQBzdjYBVkO2WijWdr8TvP8vR4KhRANCAASQo30/KSJRbLR0qkuSKMRwxN2Xvd08\nKFAZbZ4NWesNpEV8B/N1jV9LHMHUpc0A0tZ0unXph6DA0tODiEQ9MEeC\n-----END PRIVATE KEY-----\n";
char* STRANGER_CERT = "-----BEGIN CERTIFICATE-----\nMIIBPzCB5qADAgECAggQooP33JMRCDAKBggqhkjOPQQDAjATMREwDwYDVQQDDAhP\ndGhlciBDQTAgFw0yMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowFDESMBAG\nA1UEAwwJMTI3LjAuMC4xMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAESGzdSqEX\nfcdvOu7FW5LokaFUX6T3H+Uv6Phce9S06Dw9oh5p2phKAMqbGn8NL20emZetycF1\nyFTn/teSJ1Bt3aMhMB8wDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwR/AAABMAoG\nCCqGSM49BAMCA0gAMEUCIQDN+ASE1vNvveEm/4o9If40ZlMUQWP6kr0zrWnk1taQ\n9QIgYVrITfLWZqRs9cbjtTaEDcrOadDwvBx1R+R1f5qk01s=\n-----END CERTIFICATE-----\n";
char* STRANGER_KEY = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg2Hn4c01UmR2L+x+7\nDlLis81vDspgD6J4c2wPo8uS7W2hRANCAARIbN1KoRd9x2867sVbkuiRoVRfpPcf\n5S/o+Fx71LToPD2iHmnamEoAypsafw0vbR6Zl63JwXXIVOf+15InUG3d\n-----END PRIVATE KEY-----\n";

// SMTP over TLS and with authentication, the client against the server module over loopback sockets (one thread: the server runs from net.setIdleHook): STARTTLS (the
// handshake, a second EHLO, a message of 300 KB through it), TLS from the start, certificates that are checked, AUTH PLAIN / LOGIN / CRAM-MD5 with good and bad passwords,
// passwords that are never sent in the clear and never written to a transcript, a server that hides STARTTLS, plain bytes behind STARTTLS (from the client side and the
// server side), and a session that starts again after the switch to TLS.
import smtp;
import smtpd;
import mail;
import net;
import tls;
import x509;
import netio;

int fails = 0;
int checks = 0;

void check(char* name, bool ok) {
    checks++;
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

smtpd.Server* srv;

// what the delivery hook saw
char* gotData;
int gotLen;
char gotFrom[300];
char gotAuth[100];
bool gotTls;
int gotCount;
int gotRcpts;

int deliver(smtpd.Core* core, smtpd.Session* s, char* data, int n) {
    if (gotData != null) free(gotData);
    gotData = malloc(n + 1);
    memcpy(gotData, data, n);
    gotLen = n;
    strcpy(&gotFrom[0], s->from == null ? "?" : s->from);
    strcpy(&gotAuth[0], s->authUser == null ? "-" : s->authUser);
    gotTls = s->tls;
    gotRcpts = s->nrcpt;
    gotCount++;
    return 0;
}

int hook() {
    srv->poll(0);
    return 0;
}

smtpd.Server* newSrv(tls.Config* cfg, bool insecureAuth) {
    smtpd.Server* s = smtpd.newServer();
    s->core->hostname = "mail.test";
    s->core->addLocalDomain("example.org");
    s->core->addUser("ann", "s3cret pass");
    s->core->addUser("bob", "");
    s->core->tlsConfig = cfg;
    s->core->allowInsecureAuth = insecureAuth;
    s->core->idPrefix = "Q";
    s->core->deliverHook = deliver;
    s->listenOn("127.0.0.1", 0, null);
    return s;
}

smtp.Options* opts() {
    smtp.Options* o = smtp.newOptions();
    o->heloName = "client.test";
    o->record = true;
    o->commandTimeoutMs = 5000;
    o->greetingTimeoutMs = 5000;
    o->connectTimeoutMs = 5000;
    o->dataEndTimeoutMs = 10000;
    return o;
}

smtp.Client* client(smtp.Options* o) {
    return smtp.newClient("127.0.0.1", srv->port, o);
}

bool sendOne(smtp.Client* c, char* data, int n) {
    char* rc[1];
    rc[0] = "bob@example.org";
    smtp.Result* r = c->send("ann@example.net", &rc[0], 1, data, n);
    bool ok = r->ok;
    free((char*) r);
    return ok;
}

// a raw connection to the server: sends text, collects the reply for a moment
int rawConn() {
    int h = net.connect("127.0.0.1", srv->port);
    net.setTimeout(h, 2000);
    return h;
}

void rawRead(int h, mail.Buf* out, int ms) {
    int t0 = millis();
    while (millis() - t0 < ms) {
        char b[2048];
        if (!net.waitReadable(h, 20)) { continue; }
        int n = net.recv(h, &b[0], 2048);
        if (n <= 0) return;
        out->add(&b[0], n);
    }
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* good = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    tls.Config* stranger = tls.loadConfig(STRANGER_CERT, STRANGER_KEY);
    check("the test certificates load", good != null && stranger != null);
    srv = newSrv(good, true);
    net.setIdleHook(hook);

    // ---- STARTTLS -------------------------------------------------------------------------------------------------------------------------------------------
    smtp.Options* o = opts();
    smtp.Client* c = client(o);
    check("STARTTLS: connect, the handshake, EHLO again", c->connect() && c->secure && c->conn->tlsActive && srv->core->stats->tlsStarted == 1);
    char* t = c->transcript();
    check("STARTTLS: the transcript shows both EHLOs and the go-ahead", contains(t, "S: 250-STARTTLS\n") && contains(t, "C: STARTTLS\nS: 220 2.0.0 Ready to start TLS\nC: EHLO client.test\n") && !contains(&t[strlen(t) - 50], "STARTTLS\nS: 250-mail.test\nS: 250-PIPELINING") );
    check("STARTTLS: after TLS the server no longer offers it", !c->hasStartTls && c->authMask != 0);
    check("STARTTLS: a message goes through", sendOne(c, "Subject: tls\n\nhello over tls\n", 29) && gotCount == 1 && gotTls && gotLen == 32 && memcmp(gotData, "Subject: tls\r\n\r\nhello over tls\r\n", 32) == 0 && streq(&gotFrom[0], "ann@example.net"));
    int bigN = 300000;
    char* big = alloc(bigN + 2);
    int seed = 11;
    for (int i = 0; i < bigN; i++) { seed = seed * 1103515245 + 12345; int r = (seed >> 16) & 63; big[i] = r < 4 ? '\n' : (r < 6 ? '.' : 'a' + r % 26); }
    big[bigN - 1] = '\n';
    check("STARTTLS: a message of 300000 bytes", sendOne(c, big, bigN));
    bool same = gotLen > bigN;
    mail.Buf canon;
    for (int i = 0; i < bigN; i++) { if (big[i] == 10) canon.addByte(13); canon.addByte(big[i]); }
    same = gotLen == canon.len && memcmp(gotData, canon.d, canon.len) == 0;
    check("STARTTLS: ... and the server has it byte for byte (dots, line ends)", same);
    canon.release();
    c->quit();
    c->dispose();

    // ---- STARTTLS required, not offered; certificates ----------------------------------------------------------------------------------------------------------
    smtpd.Server* plainSrv = newSrv(null, true);
    smtpd.Server* keep = srv;
    srv = plainSrv;
    o = opts();
    o->startTls = smtp.STARTTLS_REQUIRED;
    c = client(o);
    check("required STARTTLS, a server that does not offer it: connect fails", !c->connect() && contains(c->error, "does not offer STARTTLS") && !c->isOpen());
    c->dispose();
    o = opts();
    o->startTls = smtp.STARTTLS_IF_OFFERED;
    c = client(o);
    check("optional STARTTLS, a server without it: plain connection", c->connect() && !c->secure && sendOne(c, "x\n", 2));
    c->quit();
    c->dispose();
    o = opts();
    o->startTls = smtp.STARTTLS_REQUIRED;
    o->username = "ann";
    o->password = "s3cret pass";
    o->allowPlainAuth = true;
    c = client(o);
    int authBefore = srv->core->stats->authOk + srv->core->stats->authFailed;
    check("credentials and a server that hides STARTTLS (a man in the middle): connect fails and no AUTH is sent", !c->connect() && srv->core->stats->authOk + srv->core->stats->authFailed == authBefore && !contains(c->transcript(), "C: AUTH"));
    c->dispose();
    srv = keep;
    smtpd.Server* strangerSrv = newSrv(stranger, true);
    srv = strangerSrv;
    o = opts();
    o->startTls = smtp.STARTTLS_REQUIRED;
    c = client(o);
    check("a certificate of an unknown CA is refused (STARTTLS)", !c->connect() && !c->isOpen());
    c->dispose();
    o = opts();
    o->startTls = smtp.STARTTLS_REQUIRED;
    o->verify = false;
    c = client(o);
    check("... verify off accepts it", c->connect() && c->secure && sendOne(c, "x\n", 2));
    c->quit();
    c->dispose();
    srv = keep;

    // ---- TLS from the start ---------------------------------------------------------------------------------------------------------------------------------
    smtpd.Server* implicit = newSrv(null, false);
    implicit->net->shutdown();
    implicit->listenOn("127.0.0.1", 0, good);
    implicit->port = implicit->net->listenerPort(0);
    srv = implicit;
    o = opts();
    o->useTls = true;
    c = client(o);
    check("TLS from the start (smtps): connect and send", c->connect() && c->secure && !contains(c->transcript(), "STARTTLS") && sendOne(c, "implicit\n", 9) && gotTls);
    c->quit();
    c->dispose();
    o = opts();
    o->useTls = true;
    o->verify = true;
    char iurl[100];
    format(&iurl[0], 100, "smtps://127.0.0.1:%d", implicit->port, 0, 0, 0, 0, 0);
    c = smtp.connectWith(&iurl[0], o);
    check("smtps:// URL", c != null && c->secure);
    if (c != null) { c->quit(); c->dispose(); }
    c = null;
    // a plain client on the TLS port and the other way round
    o = opts();
    o->greetingTimeoutMs = 400;
    c = client(o);
    check("a plain client on a TLS port fails and does not hang", !c->connect());
    c->dispose();
    srv = keep;
    o = opts();
    o->useTls = true;
    c = client(o);
    check("a TLS client on a plain port fails and does not hang", !c->connect());
    c->dispose();

    // ---- AUTH ------------------------------------------------------------------------------------------------------------------------------------------------
    int mechs[3];
    mechs[0] = smtp.AUTH_PLAIN; mechs[1] = smtp.AUTH_LOGIN; mechs[2] = smtp.AUTH_CRAM_MD5;
    char* names[3];
    names[0] = "PLAIN"; names[1] = "LOGIN"; names[2] = "CRAM-MD5";
    int authOk = 0;
    for (int i = 0; i < 3; i++) {
        o = opts();
        o->startTls = smtp.STARTTLS_NEVER;
        o->username = "ann";
        o->password = "s3cret pass";
        o->allowPlainAuth = true;
        o->authMethods = mechs[i];
        c = client(o);
        bool ok = c->connect() && c->authenticated && sendOne(c, "x\n", 2) && streq(&gotAuth[0], "ann");
        if (ok) authOk++; else printf("     %s: %s\n", names[i], c->error);
        char note[40];
        format(&note[0], 40, "AUTH %s", names[i], 0, 0, 0, 0, 0);
        if (!contains(c->transcript(), &note[0])) ok = false;
        c->quit();
        c->dispose();
        char nm[80];
        format(&nm[0], 80, "AUTH %s works and the server knows the user", names[i], 0, 0, 0, 0, 0);
        check(&nm[0], ok);
    }
    check("AUTH: all three mechanisms succeeded", authOk == 3);
    int failedBefore = srv->core->stats->authFailed;
    int badOk = 0;
    for (int i = 0; i < 3; i++) {
        o = opts();
        o->startTls = smtp.STARTTLS_NEVER;
        o->username = "ann";
        o->password = "wrong";
        o->allowPlainAuth = true;
        o->authMethods = mechs[i];
        c = client(o);
        if (!c->connect() && contains(c->error, "authentication failed") && !c->isOpen()) badOk++;
        c->dispose();
        o = opts();
        o->startTls = smtp.STARTTLS_NEVER;
        o->username = "nobody";
        o->password = "x";
        o->allowPlainAuth = true;
        o->authMethods = mechs[i];
        c = client(o);
        if (!c->connect() && contains(c->error, "authentication failed")) badOk++;
        c->dispose();
    }
    check("AUTH: a wrong password and an unknown user fail with every mechanism (6 tries)", badOk == 6 && srv->core->stats->authFailed == failedBefore + 6);
    o = opts();
    o->startTls = smtp.STARTTLS_NEVER;
    o->username = "bob";
    o->password = "";
    o->allowPlainAuth = true;
    o->authMethods = smtp.AUTH_PLAIN;
    c = client(o);
    check("AUTH: an empty password for a user that has one", c->connect() && c->authenticated);
    c->dispose();
    o = opts();
    o->startTls = smtp.STARTTLS_NEVER;
    o->username = "ann";
    o->password = "s3cret pass";
    c = client(o);
    check("AUTH on a plain connection: CRAM-MD5 is used (the password is not sent), PLAIN and LOGIN are not tried", c->connect() && contains(c->transcript(), "C: AUTH CRAM-MD5") && !contains(c->transcript(), "C: AUTH PLAIN") && !contains(c->transcript(), "s3cret"));
    c->dispose();
    o = opts();
    o->startTls = smtp.STARTTLS_NEVER;
    o->username = "ann";
    o->password = "s3cret pass";
    o->authMethods = smtp.AUTH_PLAIN;
    c = client(o);
    check("AUTH PLAIN without TLS and without allowPlainAuth is refused by the client, nothing is sent", !c->connect() && contains(c->error, "no TLS") && !contains(c->transcript(), "C: AUTH"));
    c->dispose();

    // ---- credentials over STARTTLS, nothing in the transcript --------------------------------------------------------------------------------------------------
    smtpd.Server* strict = newSrv(good, false);
    srv = strict;
    char url[120];
    format(&url[0], 120, "smtp://ann:s3cret%%20pass@127.0.0.1:%d", strict->port, 0, 0, 0, 0, 0);
    o = opts();
    c = smtp.connectWith(&url[0], o);
    check("URL with credentials: STARTTLS first, then AUTH PLAIN or CRAM-MD5 (the server offers PLAIN only on TLS)", c != null && c->secure && c->authenticated);
    if (c != null) {
        t = c->transcript();
        check("the transcript has no password and not its base64, the secret lines are shown as ****", !contains(t, "s3cret") && !contains(t, "czNjcmV0") && !contains(t, "AGFubgBzM2NyZXQgcGFzcw") && (contains(t, "C: AUTH PLAIN ****\n") || contains(t, "C: AUTH CRAM-MD5\nS: 334 ") && contains(t, "C: ****\n")));
        check("a message after AUTH: the server hook knows the user and the TLS state", sendOne(c, "authed\n", 7) && streq(&gotAuth[0], "ann") && gotTls);
        c->quit();
        c->dispose();
    }
    o = opts();
    o->startTls = smtp.STARTTLS_NEVER;
    o->username = "ann";
    o->password = "s3cret pass";
    o->allowPlainAuth = true;
    o->authMethods = smtp.AUTH_PLAIN;
    c = client(o);
    check("a server that offers PLAIN only on TLS: no PLAIN offered on a plain connection (the client has nothing to use)", !c->connect() && !c->isOpen());
    c->dispose();
    smtpd.Server* needTls = newSrv(good, true);
    needTls->core->requireTls = true;
    srv = needTls;
    o = opts();
    o->startTls = smtp.STARTTLS_NEVER;
    c = client(o);
    c->connect();
    char* rc[1];
    rc[0] = "bob@example.org";
    smtp.Result* r = c->send("ann@example.net", &rc[0], 1, "x\n", 2);
    check("requireTls: MAIL FROM before STARTTLS is refused with 530", !r->ok && r->code == 530 && r->status == 5007000 && !r->temporary);
    free((char*) r);
    c->dispose();
    o = opts();
    c = client(o);
    check("requireTls: with STARTTLS everything works", c->connect() && sendOne(c, "x\n", 2));
    c->quit();
    c->dispose();
    srv = keep;

    // ---- plain bytes behind STARTTLS --------------------------------------------------------------------------------------------------------------------------------
    // the client side: a server that sends text behind its go-ahead
    int lsn = net.listenOn("127.0.0.1", 0, 4);
    int lport = net.localPort(lsn);
    net.setNonBlocking(lsn, true);
    int stage = 0;
    int peer = -1;
    srv = null;
    net.setIdleHook(null);
    o = opts();
    o->startTls = smtp.STARTTLS_REQUIRED;
    o->commandTimeoutMs = 3000;
    smtp.Client* ic = smtp.newClient("127.0.0.1", lport, o);
    // the fake server is served from the hook of this scope
    net.setIdleHook(hookFake);
    fakeLsn = lsn;
    check("STARTTLS injection (client side): plain text behind the go-ahead makes the connection fail", !ic->connect() && contains(ic->error, "plain text after its go-ahead") && !ic->isOpen());
    ic->dispose();
    net.setIdleHook(hook);
    srv = keep;

    // the server side, without sockets: STARTTLS and a command in one read
    smtpd.Core* core = new smtpd.Core();
    core->hostname = "mail.test";
    core->tlsConfig = good;
    core->addLocalDomain("example.org");
    netio.Queue q;
    smtpd.Session* s = core->open(0x7F000001, &q);
    q.consume(q.pending());
    int fr = core->feed(s, "EHLO x\r\nSTARTTLS\r\nMAIL FROM:<a@example.org>\r\n", 45);
    mail.Buf outText;
    outText.add(q.data(), q.pending());
    check("STARTTLS injection (server side): the command behind STARTTLS in the same read is not run, the session ends", fr < 0 && s->closeAfter && !s->wantStartTls && contains(outText.text(), "220 2.0.0 Ready to start TLS\r\n") && !contains(outText.text(), "2.1.0"));
    core->closeSession(s);
    q.consume(q.pending());
    outText.release();
    s = core->open(0x7F000001, &q);
    q.consume(q.pending());
    core->feed(s, "EHLO x\r\n", 8);
    q.consume(q.pending());
    fr = core->feed(s, "STARTTLS\r\n", 10);
    check("STARTTLS alone: the session wants the switch", fr == 0 && s->wantStartTls && q.pending() > 0);
    q.consume(q.pending());
    core->tlsStarted(s);
    core->feed(s, "MAIL FROM:<a@example.org>\r\n", 27);
    mail.Buf o2;
    o2.add(q.data(), q.pending());
    check("after the switch the session starts again: the EHLO of before is forgotten (503)", s->tls && contains(o2.text(), "503 5.5.1 Send EHLO or HELO first\r\n"));
    o2.release();
    core->closeSession(s);
    // the same through a socket: bytes behind STARTTLS and the connection is closed
    int rh = rawConn();
    mail.Buf rb;
    rawRead(rh, &rb, 100);
    net.send(rh, "EHLO x\r\nSTARTTLS\r\nMAIL FROM:<a@example.org>\r\n", 45);
    rawRead(rh, &rb, 300);
    check("STARTTLS injection through a socket: no answer to the command behind it, the connection is closed", contains(rb.text(), "220 2.0.0 Ready to start TLS\r\n") && !contains(rb.text(), "2.1.0") && !contains(rb.text(), "503"));
    net.close(rh);
    rb.release();

    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}

int fakeLsn = -1;
int fakeConn = -1;
int fakeStage = 0;
mail.Buf fakeBuf;

// a fake server for the injection test: greeting, EHLO with STARTTLS, then "220 go ahead" and plain text in one write
int hookFake() {
    if (fakeConn < 0) {
        int c = net.acceptSome(fakeLsn);
        if (c < 0) return 0;
        fakeConn = c;
        net.setNonBlocking(c, true);
        net.sendText(c, "220 fake ESMTP\r\n");
        return 0;
    }
    char b[1024];
    int n = net.recvSome(fakeConn, &b[0], 1024);
    if (n <= 0) return 0;
    fakeBuf.add(&b[0], n);
    char* t = fakeBuf.text();
    if (fakeStage == 0 && contains(t, "EHLO client.test\r\n")) {
        fakeStage = 1;
        net.sendText(fakeConn, "250-fake\r\n250 STARTTLS\r\n");
    } else if (fakeStage == 1 && contains(t, "STARTTLS\r\n")) {
        fakeStage = 2;
        net.sendText(fakeConn, "220 go ahead\r\n250 injected plain text\r\n");
    }
    return 0;
}
