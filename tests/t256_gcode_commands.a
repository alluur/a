// gcode.Commands (key specifications, registry, conflicts, user bindings in the settings), the shortcuts that reach the window before
// the focused widget (also together with a menu bar), and gcode.Palette (commands, a list, files; fuzzy filter, keys, mouse, focus)
import wsrv;
import gui;
import guix;
import gcode;
import aproject;
import atheme;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.Commands* cmds;
gcode.Palette* pal;
gcode.CodeEditor* e;
gui.Window* w;
int hits[8];
int chosen = 0;
int menuHits = 0;

int act(int u) { hits[u]++; return 0; }
int menuAct(int item) { menuHits++; return 0; }
int onChoose(int p) { chosen++; return 0; }

void parse(char* spec) {
    int k = 0;
    int m = 0;
    bool ok = gcode.parseKeys(spec, &k, &m);
    char back[48];
    if (ok) { gcode.formatKeys(k, m, &back[0]); } else { back[0] = 0; }
    printf("parseKeys(%s): %d key %d mods %d -> [%s]\n", spec, ok, k, m, &back[0]);
}

void listShown(char* label) {
    printf("%s: %d of %d:", label, pal->shownCount(), pal->itemCount());
    for (int i = 0; i < pal->shownCount() && i < 6; i++) { printf(" %s", pal->shownLabel(i)); }
    printf(" (selected %d)\n", pal->selected);
}

int main() {
    gcode.theLook()->autoComplete = false;
    rmtree("build/tests/t256_project");
    startServer(7356, "t256");

    // key specifications
    parse("ctrl+s");
    parse("Ctrl+Shift+P");
    parse("F5");
    parse("alt+left");
    parse("ctrl+alt+Delete");
    parse("pgdn");
    parse("shift+tab");
    parse("ctrl+/");
    parse("ctrl+plus");
    parse("ctrl+");
    parse("hello+x");
    parse("ctrl+f13");
    parse("");

    // the registry
    cmds = new gcode.Commands();
    cmds->add("file.save", "File: Save", "ctrl+s", act, 1);
    cmds->add("file.open", "File: Open", "ctrl+o", act, 2);
    cmds->add("view.sidebar", "View: Toggle Sidebar", "ctrl+b", act, 3);
    cmds->add("view.palette", "View: Command Palette", "ctrl+shift+p", act, 4);
    cmds->add("edit.nokeys", "Edit: Something Without Keys", "", act, 5);
    printf("commands %d, find: %d %d, keys of file.save [%s], of edit.nokeys [%s]\n", cmds->count, cmds->find("file.save") != null, cmds->find("nothing") != null, cmds->find("file.save")->keys, cmds->find("edit.nokeys")->keys);
    printf("by keys ctrl+o: %s\n", cmds->byKeys('o', adp.MOD_CTRL)->id);
    printf("a key that is free: %d, a key that is taken: %d, invalid: %d\n", cmds->setKeys("file.save", "ctrl+shift+s"), cmds->setKeys("file.save", "ctrl+o"), cmds->setKeys("file.save", "banana"));
    printf("file.save now [%s]; ctrl+s is free: %d\n", cmds->find("file.save")->keys, cmds->byKeys('s', adp.MOD_CTRL) == null);
    cmds->setKeys("file.save", "ctrl+s");
    printf("keys removed: %d, [%s]\n", cmds->setKeys("edit.nokeys", ""), cmds->find("edit.nokeys")->keys);
    printf("an unknown id: %d\n", cmds->setKeys("nope", "ctrl+q"));
    printf("run by id: %d, unknown id: %d\n", cmds->run("file.open"), cmds->run("nope"));
    cmds->find("file.open")->enabled = false;
    printf("a disabled command does not run: %d\n", cmds->run("file.open"));
    cmds->find("file.open")->enabled = true;
    printf("dispatch ctrl+s %d, ctrl+x %d\n", cmds->dispatch('s', adp.MOD_CTRL), cmds->dispatch('x', adp.MOD_CTRL));
    printf("hits so far: save %d open %d\n", hits[1], hits[2]);

    // settings: the user's bindings
    atheme.Settings st();
    st.setBinding("file.save", "ctrl+alt+s");
    st.setBinding("view.sidebar", "none");
    st.setBinding("unknown.command", "ctrl+q");
    cmds->applySettings(&st);
    printf("after applySettings: save [%s], sidebar [%s], palette [%s]\n", cmds->find("file.save")->keys, cmds->find("view.sidebar")->keys, cmds->find("view.palette")->keys);
    atheme.Settings out();
    cmds->storeSettings(&out);
    char* ini = out.toIni();
    atheme.Settings back();
    back.parse(ini, strlen(ini));
    asys.free(ini);
    printf("stored: file.save %s, view.sidebar %s, view.palette %s, file.open %s\n", back.binding("file.save"), back.binding("view.sidebar"), (back.binding("view.palette") == null) ? "(default)" : back.binding("view.palette"), (back.binding("file.open") == null) ? "(default)" : back.binding("file.open"));
    cmds->setKeys("file.save", "ctrl+s");
    cmds->setKeys("view.sidebar", "ctrl+b");

    // the window: the focused editor has Ctrl+O etc. free; the registry sees keys first
    w = d->createWindow("Commands", 700, 420, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Menu Item", menuAct)->accel("Ctrl+M");
    gui.Box* col = gui.vbox(0, 0);
    col->add(bar);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    cmds->install(w);
    e->setText("hello\n");
    settle();
    hits[1] = 0; hits[2] = 0; hits[3] = 0;
    ctrl('s');
    ctrl('o');
    printf("keys reach the registry: save %d, open %d\n", hits[1], hits[2]);
    ctrl('m');
    printf("keys the registry does not know go on to the menu bar: %d\n", menuHits);
    typeStr("x");
    printf("normal typing is not touched: [%s]\n", e->getText());
    ctrl('a');
    printf("Ctrl+A still reaches the editor: selection %d\n", e->ed->anySelection());

    // the palette with commands
    pal = new gcode.Palette();
    pal->showCommands(w, cmds);
    settle();
    printf("palette open: %d, popup %d, the field has the focus %d\n", pal->open, w->popup != null, w->focusWidget == (gui.Widget*) pal->box);
    listShown("all commands");
    typeStr("sav");
    listShown("typed sav");
    pal->setText("");
    typeStr("palette");
    listShown("typed palette");
    pal->setText("");
    typeStr("fs");
    listShown("fs (letters in order, not next to each other)");
    pal->setText("");
    typeStr("zzzz");
    listShown("no match");
    pal->setText("");
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    printf("Down twice: selected %d\n", pal->selected);
    key(adp.KEY_UP, 0);
    printf("Up: selected %d\n", pal->selected);
    keyMods(adp.KEY_END, 0, 0);
    key(adp.KEY_ESCAPE, 27);
    printf("Esc: open %d, popup %d, focus back in the editor %d\n", pal->open, w->popup != null, w->focusWidget == e);
    hits[1] = 0; hits[2] = 0; hits[3] = 0; hits[4] = 0;
    pal->showCommands(w, cmds);
    settle();
    typeStr("toggle");
    key(adp.KEY_ENTER, 13);
    printf("typed toggle + Enter ran: sidebar %d, popup closed %d, focus back in the editor %d\n", hits[3], w->popup == null, w->focusWidget == e);
    pal->showCommands(w, cmds);
    settle();
    typeStr("open");
    int px = pal->box->absX() + 20;
    int py = pal->box->absY() + pal->box->h + 6 + 12;
    hb->click(screenX(w, pal, px - pal->absX()), screenY(w, pal, py - pal->absY()));
    settle();
    printf("a click on the first row ran: open %d, popup closed %d\n", hits[2], w->popup == null);
    pal->showCommands(w, cmds);
    settle();
    hb->click(screenX(w, pal, 5), screenY(w, pal, 400));
    settle();
    printf("a click outside closes it: %d\n", w->popup == null);

    // a palette with a list of your own: the choice comes back as an index
    pal->clearItems();
    pal->addItem("alpha", "first", 10);
    pal->addItem("beta", "second", 20);
    pal->addItem("gamma", "third", 30);
    pal->onChoose = onChoose;
    pal->onQuery = null;
    pal->show(w, "Pick a letter");
    settle();
    listShown("own list");
    typeStr("gm");
    key(adp.KEY_ENTER, 13);
    printf("chosen %d: index %d data %d\n", chosen, pal->chosenIndex, pal->chosenData);

    // files: the index of a project, fuzzy search
    asys.mkdirs("build/tests/t256_project/src/deep");
    asys.mkdirs("build/tests/t256_project/docs");
    asys.writeFile("build/tests/t256_project/src/main.a", "x", 1);
    asys.writeFile("build/tests/t256_project/src/util.a", "x", 1);
    asys.writeFile("build/tests/t256_project/src/deep/mainloop.a", "x", 1);
    asys.writeFile("build/tests/t256_project/docs/main.md", "x", 1);
    asys.writeFile("build/tests/t256_project/README.md", "x", 1);
    aproject.Ignore ign();
    ign.addBuiltin();
    aproject.QuickOpen* quick = new aproject.QuickOpen();
    printf("indexed %d files\n", quick->index("build/tests/t256_project", &ign));
    pal->onChoose = onChoose;
    pal->showFiles(w, quick);
    settle();
    typeStr("main");
    listShown("files: main");
    typeStr("a");
    listShown("files: maina");
    key(adp.KEY_ENTER, 13);
    printf("chosen file: %s\n", pal->chosenPath());
    pal->showFiles(w, quick);
    settle();
    typeStr("rdme");
    listShown("files: rdme");
    key(adp.KEY_ESCAPE, 27);

    // pictures in two themes
    pal->showCommands(w, cmds);
    settle();
    typeStr("e");
    gcode.theLook()->setThemeName("dark");
    settle();
    printf("dark screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("dark");
    key(adp.KEY_ESCAPE, 27);
    return 0;
}
