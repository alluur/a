// override and final: override checks the base class method (virtual, same name, same result and parameter types); final stops further
// overriding of a method or deriving from a class; plain same-name overrides without the keyword keep working
struct Pt { int x; int y; }

class Base {
public:
    int tag;
    virtual int plain() { return 1; }
    virtual int calc(int a, int b) { return a + b; }
    virtual double ratio(double d) { return d / 2.0; }
    virtual char* label(char* prefix) { return prefix; }
    virtual Pt mk(int x) { Pt p; p.x = x; p.y = 0; return p; }
    virtual void poke(Base* other) { tag = 1; }
    virtual bool ok() { return true; }
    virtual int locked() { return 100; }
    int fixed() { return 7; }
}

class Mid : Base {
public:
    override int plain() { return 2; }
    override int calc(int a, int b) { return a * b; }
    override double ratio(double d) { return d * 3.0; }
    override char* label(char* prefix) { return "mid"; }
    override Pt mk(int x) { Pt p; p.x = x; p.y = x * 2; return p; }
    override void poke(Base* other) { tag = 2; }
    override bool ok() { return false; }
    override final int locked() { return 200; }          // nobody below can override this one
    int fixed() { return 8; }                            // hides the non-virtual method of the base class
}

class Leaf : Mid {
public:
    int plain() { return 3; }                            // an override without the word is fine
    override int calc(int a, int b) { return a - b; }
}

final class Sealed : Leaf {
public:
    override int plain() { return 4; }
    final int calc(int a, int b) { return a + b + 1000; }
}

int main() {
    Base* items[4];
    items[0] = new Base();
    items[1] = new Mid();
    items[2] = new Leaf();
    items[3] = new Sealed();
    foreach (Base* b in items) {
        printInt(b->plain()); print(" "); printInt(b->calc(6, 3)); print(" ");
        printDouble(b->ratio(4.0)); print(" "); print(b->label("base")); print(" ");
        Pt p = b->mk(5);
        printInt(p.x); print(","); printInt(p.y); print(" ");
        b->poke(b); printInt(b->tag); print(" ");
        printInt(b->ok()); print(" "); printInt(b->locked()); print(" "); printInt(b->fixed());
        println("");
    }
    Mid* m = new Leaf();
    printlnInt(m->fixed());                              // not virtual: decided by the type of the pointer
    printlnInt(m->locked());
    return 0;
}
