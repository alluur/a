-- parseKey and keyName
a              -> a  (key 61, mods 0)
A              -> a  (key 61, mods 0)
Ctrl+S         -> Ctrl+S  (key 73, mods 4)
ctrl-s         -> Ctrl+S  (key 73, mods 4)
C-s            -> Ctrl+S  (key 73, mods 4)
Alt+F          -> Alt+f  (key 66, mods 2)
Shift+Tab      -> Shift+Tab  (key 200002, mods 1)
Ctrl+Alt+Delete -> Ctrl+Alt+Delete  (key 20000e, mods 6)
F1             -> F1  (key 200010, mods 0)
f10            -> F10  (key 200019, mods 0)
F24            -> F24  (key 200027, mods 0)
F25            -> not a key
F0             -> not a key
Enter          -> Enter  (key 200001, mods 0)
Return         -> Enter  (key 200001, mods 0)
Esc            -> Esc  (key 200004, mods 0)
Escape         -> Esc  (key 200004, mods 0)
Backspace      -> Backspace  (key 200003, mods 0)
Up             -> Up  (key 200005, mods 0)
PgDn           -> PgDn  (key 20000c, mods 0)
PageUp         -> PgUp  (key 20000b, mods 0)
Home           -> Home  (key 200009, mods 0)
End            -> End  (key 20000a, mods 0)
Insert         -> Insert  (key 20000d, mods 0)
Space          -> Space  (key 20, mods 0)
Ctrl+Space     -> Ctrl+Space  (key 20, mods 4)
Plus           -> +  (key 2b, mods 0)
Ctrl+Plus      -> Ctrl++  (key 2b, mods 4)
Minus          -> -  (key 2d, mods 0)
+              -> +  (key 2b, mods 0)
-              -> -  (key 2d, mods 0)
Ctrl+/         -> Ctrl+/  (key 2f, mods 4)
é             -> é  (key e9, mods 0)
Alt+世        -> Alt+世  (key 4e16, mods 2)
Meta+X         -> Meta+x  (key 78, mods 8)
Super+X        -> Meta+x  (key 78, mods 8)
Hyper+X        -> not a key
               -> not a key
Ctrl+          -> not a key
Ctrl+Shift+Alt+Meta+F5 -> Ctrl+Alt+Shift+Meta+F5  (key 200014, mods 15)
-- keyIs and shortcut matching
1 1 0
Alt+F typed as ESC F (upper case): 0 1 0
a '?' typed: 1 1
Shift+F1: 1 0
1
1
