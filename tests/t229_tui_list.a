// tui: ListView - selection, scrolling, filter-as-you-type, mouse, scroll bar, custom matcher
import tui;
import term;
import tscreen;

tui.App* app;
tui.ListView* lv;
int selects;
int activates;

int onSelect(int l) { selects++; return 0; }
int onActivate(int l) { activates++; return 0; }

void show(char* what) {
    printf("-- %s (selected: %s, row %d, top %d)\n", what, lv->selectedText(), lv->sel, lv->top);
    println(app->text());
}

// items that start with the filter text
int startsWithMatcher(int list, int item, char* filter) {
    tui.ListView* l = (tui.ListView*) list;
    return startsWith(l->itemText(item), filter) ? 1 : 0;
}

int main() {
    app = new tui.App();
    app->initHeadless(24, 8);
    tui.Box* col = tui.vbox(0, 0);
    tui.Label* head = new tui.Label("header");
    col->add(head);
    lv = new tui.ListView();
    lv->flex = 1;
    lv->filterable = true;
    lv->onSelect = onSelect;
    lv->onActivate = onActivate;
    char* names[14] = {"apple", "apricot", "banana", "blueberry", "cherry", "date", "elderberry", "fig", "grape", "kiwi", "lemon", "mango", "nectarine", "orange"};
    for (int i = 0; i < 14; i++) { lv->add(names[i], i * 10); }
    col->add(lv);
    app->setRoot(col);
    app->pump(0);
    app->press("Tab");
    show("the first frame: 7 rows, a scroll bar");
    printf("focus %d, count %d, selected item %d, data %d\n", app->focus == lv, lv->count, lv->selected(), lv->selectedData());

    println("-- keys");
    app->press("Down"); app->press("Down");
    show("two down");
    app->press("PgDn");
    show("PgDn");
    app->press("End");
    show("End");
    app->press("Down");
    printf("Down at the end stays: %s\n", lv->selectedText());
    app->press("Home");
    app->press("Up");
    printf("Up at the start stays: %s\n", lv->selectedText());
    app->press("PgDn"); app->press("PgUp");
    show("PgDn, PgUp");
    printf("selection changes reported: %d\n", selects);

    println("-- Enter activates");
    app->press("Enter");
    printf("activates: %d\n", activates);

    println("-- filter as you type");
    app->press("Home");
    app->type("rr");
    show("filter 'rr'");
    printf("shown rows: %d\n", lv->nshown);
    app->press("Backspace");
    show("Backspace: filter 'r'");
    app->press("Down");
    printf("selected: %s (item %d)\n", lv->selectedText(), lv->selected());
    app->press("Escape");
    show("Esc clears the filter, the selection stays");
    app->type("zzz");
    show("a filter that matches nothing");
    printf("selected item: %d\n", lv->selected());
    app->press("Enter");
    printf("Enter with nothing selected: activates %d\n", activates);
    app->press("Esc");

    println("-- mouse");
    app->click(3, 3);
    printf("clicked row 2 of the list: %s\n", lv->selectedText());
    app->advanceClock(1000);
    app->click(3, 4);
    app->click(3, 4);
    printf("double click: %s, activates %d\n", lv->selectedText(), activates);
    app->wheel(5, 3, false);
    printf("wheel down: top %d\n", lv->top);
    app->wheel(5, 3, false);
    printf("wheel down: top %d\n", lv->top);
    app->wheel(5, 3, true);
    printf("wheel up: top %d\n", lv->top);
    app->advanceClock(1000);
    app->mouseDown(23, 2);
    app->mouseDrag(23, 6);
    app->mouseUp(23, 6);
    printf("scroll bar dragged to the bottom: top %d\n", lv->top);
    show("after the drag");
    app->click(23, 1);
    printf("click at the top of the scroll bar: top %d\n", lv->top);

    println("-- a custom matcher (starts with)");
    lv->matcher = startsWithMatcher;
    lv->setFilter("e");
    show("filter e");
    lv->setFilter("");
    lv->matcher = null;

    println("-- select(), clear(), item styles");
    lv->select(9);
    printf("select(9): %s at row %d, top %d\n", lv->selectedText(), lv->sel, lv->top);
    lv->clear();
    printf("cleared: count %d, selected %d\n", lv->count, lv->selected());
    lv->add("only", 1);
    lv->add("coloured", 2, tscreen.style(tscreen.RED, 0, 0));
    show("two items, no scroll bar");
    printf("the item style of an unselected row is used: %d\n", tscreen.fgOf(app->screen->styleAt(2, 2)) == tscreen.RED ? 1 : 0);
    app->press("Down");
    app->pump(0);
    printf("the selection style wins on the selected row: %d\n", tscreen.fgOf(app->screen->styleAt(2, 2)) == tscreen.RED ? 1 : 0);
    return 0;
}
