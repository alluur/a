// strx: KMP, Horspool, Rabin-Karp, one-shot search, prefix / Z functions and Aho-Corasick checked against naive searches
import cstdio;
import cstring;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 4242;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void randText(char* buf, int len, int alpha) {
    for (int i = 0; i < len; i++) { buf[i] = 'a' + rnd(alpha); }
    buf[len] = 0;
}

// naive: does pat occur at position i of text (length n)?
bool occursAt(char* text, int n, char* pat, int m, int i) {
    if (i < 0 || i + m > n) { return false; }
    for (int k = 0; k < m; k++) { if (text[i + k] != pat[k]) { return false; } }
    return true;
}

int naiveFind(char* text, int n, char* pat, int m, int from) {
    if (from < 0 || from > n) { return -1; }
    for (int i = from; i + m <= n; i++) { if (occursAt(text, n, pat, m, i)) { return i; } }
    return -1;
}

// all matches, overlapping or not; returns the count and stores the first max
int naiveAll(char* text, int n, char* pat, int m, bool overlap, int* out, int max) {
    int total = 0;
    int i = 0;
    while (i + m <= n) {
        if (occursAt(text, n, pat, m, i)) {
            if (total < max) { out[total] = i; }
            total++;
            i = i + (overlap ? 1 : (m > 0 ? m : 1));
        } else {
            i++;
        }
    }
    if (m == 0) { total = 0; for (int p = 0; p <= n; p++) { if (total < max) { out[total] = p; } total++; } }
    return total;
}

bool sameList(int* a, int* b, int n) {
    for (int i = 0; i < n; i++) { if (a[i] != b[i]) { return false; } }
    return true;
}

void functions() {
    char s[80];
    int pi[80];
    int z[80];
    int bad = 0;
    for (int round = 0; round < 400; round++) {
        int n = rnd(40);
        randText(&s[0], n, 1 + rnd(3));
        for (int i = 0; i < 80; i++) { pi[i] = -1; z[i] = -1; }
        strx.prefixFunction(&s[0], n, &pi[0]);
        strx.zFunction(&s[0], n, &z[0]);
        for (int i = 0; i < n; i++) {
            int best = 0;
            for (int k = 1; k <= i; k++) { if (occursAt(&s[0], n, &s[0], k, i - k + 1)) { best = k; } }
            if (pi[i] != best) { bad++; }
            int zz = 0;
            while (i + zz < n && s[zz] == s[i + zz]) { zz++; }
            if (i == 0) { zz = n; }
            if (z[i] != zz) { bad++; }
        }
        int per = strx.period(&s[0], n);
        int wantPer = (n == 0) ? 0 : n;
        for (int p = 1; p < n; p++) {
            bool ok = true;
            for (int i = 0; i + p < n; i++) { if (s[i] != s[i + p]) { ok = false; break; } }
            if (ok) { wantPer = p; break; }
        }
        if (per != wantPer) { bad++; }
    }
    check(bad == 0, "prefix function, Z function and period agree with the definitions");
    check(strx.period("abcabcabc", -1) == 3 && strx.period("aaaa", -1) == 1 && strx.period("abcd", -1) == 4 && strx.period("", -1) == 0, "period examples");
}

void oneAlgo(int which, char* text, int n, char* pat, int m, int* bad) {
    int want[200];
    int got[200];
    strx.Kmp kmp(pat, m);
    strx.Horspool hor(pat, m);
    strx.RabinKarp rk(pat, m, 7);
    for (int from = 0; from <= n + 1; from++) {
        int w = naiveFind(text, n, pat, m, from);
        if (kmp.find(text, n, from) != w) { *bad = *bad + 1; }
        if (hor.find(text, n, from) != w) { *bad = *bad + 1; }
        if (rk.find(text, n, from) != w) { *bad = *bad + 1; }
        if (strx.indexOf(text, pat, from, n, m) != w) { *bad = *bad + 1; }
    }
    for (int ov = 0; ov < 2; ov++) {
        bool overlap = (ov == 0);
        int wn = naiveAll(text, n, pat, m, overlap, &want[0], 200);
        int c1 = kmp.findAll(text, n, &got[0], 200, overlap);
        if (c1 != wn || !sameList(&want[0], &got[0], (wn < 200) ? wn : 200)) { *bad = *bad + 1; }
        int c2 = hor.findAll(text, n, &got[0], 200, overlap);
        if (c2 != wn || !sameList(&want[0], &got[0], (wn < 200) ? wn : 200)) { *bad = *bad + 1; }
        int c3 = rk.findAll(text, n, &got[0], 200, overlap);
        if (c3 != wn || !sameList(&want[0], &got[0], (wn < 200) ? wn : 200)) { *bad = *bad + 1; }
        if (kmp.count(text, n, overlap) != wn || hor.count(text, n, overlap) != wn || rk.count(text, n, overlap) != wn) { *bad = *bad + 1; }
        if (strx.countOf(text, pat, overlap, n, m) != wn) { *bad = *bad + 1; }
        int c4 = strx.findAll(text, pat, &got[0], 200, overlap, n, m);
        if (c4 != wn || !sameList(&want[0], &got[0], (wn < 200) ? wn : 200)) { *bad = *bad + 1; }
    }
    kmp.dispose();
    hor.dispose();
    rk.dispose();
}

void searches() {
    char text[90];
    char pat[12];
    int bad = 0;
    for (int round = 0; round < 700; round++) {
        int n = rnd(60);
        int m = rnd(7);
        int alpha = 1 + rnd(3);
        randText(&text[0], n, alpha);
        randText(&pat[0], m, alpha);
        if (rnd(3) == 0 && n > m) {                         // make sure there is a match now and then
            int at = rnd(n - m + 1);
            for (int i = 0; i < m; i++) { text[at + i] = pat[i]; }
        }
        oneAlgo(0, &text[0], n, &pat[0], m, &bad);
    }
    check(bad == 0, "Kmp, Horspool, RabinKarp, indexOf, countOf, findAll agree with the naive search (700 random cases)");

    // the length is respected: the byte after n is never looked at, and 0 bytes inside are ordinary bytes
    char bin[16];
    bin[0] = 'x'; bin[1] = 0; bin[2] = 'y'; bin[3] = 0; bin[4] = 'x'; bin[5] = 0; bin[6] = 'y';
    char pb[4];
    pb[0] = 0; pb[1] = 'y';
    strx.Kmp k1(&pb[0], 2);
    check(k1.find(&bin[0], 7, 0) == 1 && k1.find(&bin[0], 7, 2) == 5 && k1.count(&bin[0], 7, true) == 2, "binary text with 0 bytes");
    check(k1.find(&bin[0], 6, 2) == -1, "the last byte (index 6) is outside n = 6");
    k1.dispose();
    check(strx.indexOf("abab", "bab", 0, 3, -1) == -1 && strx.indexOf("abab", "bab") == 1, "indexOf respects n");
    check(strx.indexOf("abc", "", 2) == 2 && strx.indexOf("abc", "", 3) == 3 && strx.indexOf("abc", "", 4) == -1 && strx.indexOf("abc", "", -1) == -1, "empty pattern");
    check(strx.indexOf(null, "a") == -1 && strx.indexOf(null, null) == 0 && strx.countOf("abc", "") == 4, "null and empty texts");
    check(strx.indexOf("aaaa", "aaaaa") == -1 && strx.indexOf("aaaaa", "aaaaa") == 0 && strx.indexOf("a", "a") == 0, "pattern as long as or longer than the text");
}

void hugeTexts() {
    // 400000 letters 'a' and a pattern that needs the whole text to be rejected: must stay linear
    int n = 400000;
    char* text = alloc(n + 1);
    memset(text, 'a', n);
    char* pat = alloc(61);
    memset(pat, 'a', 60);
    pat[0] = 'b';
    check(strx.indexOf(text, pat, 0, n, 60) == -1, "indexOf on a nasty text (fallback to KMP)");
    strx.Horspool h(pat, 60);
    strx.Kmp k(pat, 60);
    strx.RabinKarp r(pat, 60, 1);
    check(k.find(text, n, 0) == -1 && r.find(text, n, 0) == -1, "KMP and Rabin-Karp on the nasty text");
    h.dispose(); k.dispose(); r.dispose();
    memset(pat, 'a', 60);
    strx.Kmp k2(pat, 60);
    check(k2.count(text, n, true) == n - 59 && k2.count(text, n, false) == n / 60, "overlapping and separate matches of a^60 in a^400000");
    k2.dispose();
    strx.RabinKarp r2(pat, 60, 5);
    check(r2.count(text, n, true) == n - 59, "Rabin-Karp counts a^60 in a^400000");
    r2.dispose();
}

// ---- Aho-Corasick ----------------------------------------------------------------------------------------------------------------------
char pats[64];                  // 8 patterns of up to 8 bytes
int patLen[8];

void aho() {
    int bad = 0;
    char text[70];
    int ids[400];
    int ends[400];
    for (int round = 0; round < 500; round++) {
        int np = 1 + rnd(6);
        int alpha = 1 + rnd(3);
        bool ic = (rnd(4) == 0);
        strx.AhoCorasick ac(ic);
        int idOf[8];
        int distinct = 0;
        for (int p = 0; p < np; p++) {
            patLen[p] = 1 + rnd(4);
            randText(&pats[p * 8], patLen[p], alpha);
            if (ic && rnd(2) == 0) { pats[p * 8] = pats[p * 8] - 32; }      // upper case letter in a pattern
            idOf[p] = ac.add(&pats[p * 8], patLen[p]);
            // a pattern that was added before gets the old id
            int first = p;
            for (int q = 0; q < p; q++) {
                bool same = (patLen[q] == patLen[p]);
                for (int i = 0; same && i < patLen[p]; i++) {
                    int c1 = pats[q * 8 + i]; int c2 = pats[p * 8 + i];
                    if (ic) { if (c1 >= 'A' && c1 <= 'Z') { c1 = c1 + 32; } if (c2 >= 'A' && c2 <= 'Z') { c2 = c2 + 32; } }
                    if (c1 != c2) { same = false; }
                }
                if (same) { first = q; break; }
            }
            if (first == p) { if (idOf[p] != distinct) { bad++; } distinct++; }
            else if (idOf[p] != idOf[first]) { bad++; }
        }
        int n = rnd(60);
        randText(&text[0], n, alpha);
        if (ic) { for (int i = 0; i < n; i++) { if (rnd(3) == 0) { text[i] = text[i] - 32; } } }
        // naive: by end position, longer patterns first
        int wn = 0;
        int wantId[400];
        int wantEnd[400];
        for (int e = 1; e <= n; e++) {
            for (int len = 8; len >= 1; len--) {
                for (int p = 0; p < np; p++) {
                    if (patLen[p] != len || idOf[p] < 0) { continue; }
                    // each distinct pattern once: only the first of equal ones
                    bool dup = false;
                    for (int q = 0; q < p; q++) { if (idOf[q] == idOf[p]) { dup = true; } }
                    if (dup || e - len < 0) { continue; }
                    bool ok = true;
                    for (int i = 0; i < len; i++) {
                        int c1 = text[e - len + i]; int c2 = pats[p * 8 + i];
                        if (ic) { if (c1 >= 'A' && c1 <= 'Z') { c1 = c1 + 32; } if (c2 >= 'A' && c2 <= 'Z') { c2 = c2 + 32; } }
                        if (c1 != c2) { ok = false; break; }
                    }
                    if (ok) { wantId[wn] = idOf[p]; wantEnd[wn] = e; wn++; }
                }
            }
        }
        int got = ac.findAll(&text[0], n, &ids[0], &ends[0], 400);
        if (got != wn) { bad++; }
        else { for (int i = 0; i < wn; i++) { if (ids[i] != wantId[i] || ends[i] != wantEnd[i]) { bad++; break; } } }
        if (ac.count(&text[0], n) != wn) { bad++; }
        int fid = -1; int fend = -1;
        int fr = ac.first(&text[0], n, &fid, &fend);
        if (wn == 0) { if (fr != -1) { bad++; } }
        else if (fr != wantEnd[0] || fid != wantId[0] || fend != wantEnd[0]) { bad++; }
        // the cursor interface lists the same matches
        int s = 0;
        int cur = 0;
        for (int i = 0; i < n; i++) {
            s = ac.step(s, text[i]);
            for (int t = ac.match(s); t > 0; t = ac.nextMatch(t)) {
                int id = ac.patternAt(t);
                if (cur >= wn || wantId[cur] != id || wantEnd[cur] != i + 1) { bad++; }
                cur++;
            }
        }
        if (cur != wn) { bad++; }
        ac.dispose();
    }
    check(bad == 0, "AhoCorasick: ids, order and ends agree with the naive search (500 random pattern sets, also ignoring case)");
}

int eachCalls = 0;
int eachSum = 0;
int onMatch(int id, int end, int ctx) {
    eachCalls++;
    eachSum = eachSum + id * 100 + end + ctx;
    return (eachCalls >= ctx) ? 1 : 0;
}

void ahoMore() {
    strx.AhoCorasick ac;
    int a = ac.add("he");
    int b = ac.add("she");
    int c = ac.add("hers");
    int d = ac.add("his");
    int e = ac.add("he");
    check(a == 0 && b == 1 && c == 2 && d == 3 && e == 0, "pattern ids, a repeated pattern gets its old id");
    check(ac.add("", -1) == -1 && ac.patternCount() == 4 && ac.patternLength(2) == 4 && ac.patternLength(9) == 0, "empty pattern refused, lengths");
    int ids[8]; int ends[8];
    int n = ac.findAll("ushers", -1, &ids[0], &ends[0], 8);
    check(n == 3 && ids[0] == 1 && ends[0] == 4 && ids[1] == 0 && ends[1] == 4 && ids[2] == 2 && ends[2] == 6, "ushers: she, he, hers");
    n = ac.findAll("ushers", -1, &ids[0], &ends[0], 2);
    check(n == 3 && ids[1] == 0, "findAll returns the total even when max is smaller");
    n = ac.each("ushers", -1, onMatch, 100);
    check(n == 3 && eachCalls == 3, "each() reports every match");
    eachCalls = 0; eachSum = 0;
    n = ac.each("ushers", -1, onMatch, 2);
    check(n == 2 && eachCalls == 2, "each() stops when the callback returns non-zero");
    // adding after a search rebuilds on the next search
    int f = ac.add("sher");
    n = ac.findAll("ushers", -1, &ids[0], &ends[0], 8);
    check(f == 4 && n == 4, "add after a search");
    check(ac.count("", -1) == 0 && ac.count(null) == 0, "empty text");
    // the length is respected
    check(ac.count("ushers", 3) == 0 && ac.count("ushers", 4) == 2, "n limits the text");
    ac.dispose();
    check(ac.count("ushers", -1) == 0 && ac.patternCount() == 0, "empty after dispose");
    int g = ac.add("abc");
    check(g == 0 && ac.count("xabcabc", -1) == 2, "reusable after dispose");
    ac.dispose();

    // binary patterns and bytes >= 128
    strx.AhoCorasick bin;
    char p1[4]; p1[0] = 0; p1[1] = 255; p1[2] = 128;
    bin.add(&p1[0], 3);
    char t1[8]; t1[0] = 1; t1[1] = 0; t1[2] = 255; t1[3] = 128; t1[4] = 0; t1[5] = 255; t1[6] = 128;
    check(bin.count(&t1[0], 7) == 2, "bytes 0 and >= 128");
    bin.dispose();

    // the node limit: a refused pattern leaves the others working and changes nothing
    strx.AhoCorasick lim(false, 8);
    int x1 = lim.add("abcd");
    int x2 = lim.add("abxyz");       // needs 3 new nodes beyond "ab": 1 + 4 + 3 = 8 nodes: fits exactly
    int x3 = lim.add("qqqq");        // would need 4 more: refused
    int x4 = lim.add("abx");         // a prefix of an existing pattern needs no node
    check(x1 == 0 && x2 == 1 && x3 == -1 && x4 == 2, "node limit");
    check(lim.nodeTotal() == 8 && lim.count("abcdabxyzabx", -1) == 4, "limit: nothing changed by the refused pattern");
    lim.dispose();

    // case folding
    strx.AhoCorasick ic(true);
    ic.add("HeLLo");
    check(ic.count("hello HELLO Hello hElLo helL", -1) == 4, "ignore case");
    ic.dispose();
}

void ahoBig() {
    // 2000 words, a text of 300000 letters
    strx.AhoCorasick ac;
    char w[12];
    for (int i = 0; i < 2000; i++) {
        int len = 3 + rnd(6);
        randText(&w[0], len, 6);
        ac.add(&w[0], len);
    }
    int n = 300000;
    char* text = alloc(n + 1);
    for (int i = 0; i < n; i++) { text[i] = 'a' + rnd(6); }
    int total = ac.count(text, n);
    // verify a sample of patterns separately with Horspool: the sum of the counts of the distinct patterns
    check(total > 1000 && ac.patternCount() > 1500, "big pattern set finds matches");
    // all-same-letter texts give a match for every end position of each prefix pattern
    strx.AhoCorasick rep;
    rep.add("a"); rep.add("aa"); rep.add("aaa"); rep.add("aaaa");
    char* as = alloc(100001);
    memset(as, 'a', 100000);
    check(rep.count(as, 100000) == 100000 + 99999 + 99998 + 99997, "overlapping matches of nested patterns");
    rep.dispose();
    ac.dispose();
}

int main() {
    functions();
    searches();
    hugeTexts();
    aho();
    ahoMore();
    ahoBig();
    printf("search: %d checks, %d failures\n", checks, fails);
    return fails;
}
