import tls;
import x509;

int fails = 0;

void check(char* name, bool ok) {
    if (ok) {
        printf("ok   %s\n", name);
    } else {
        printf("FAIL %s\n", name);
        fails++;
    }
}

// runs the two ends against each other in memory until both are ready or one failed
bool handshake(tls.Tls* c, tls.Tls* s) {
    for (int i = 0; i < 30; i++) {
        int n = tls.outLength(c);
        if (n > 0) { tls.feed(s, tls.outData(c), n); tls.outConsumed(c, n); }
        n = tls.outLength(s);
        if (n > 0) { tls.feed(c, tls.outData(s), n); tls.outConsumed(s, n); }
        if (tls.ready(c) && tls.ready(s)) return true;
        if (tls.failed(c) || tls.failed(s)) return false;
    }
    return false;
}

// application data both ways
bool talk(tls.Tls* c, tls.Tls* s, char* a, char* b) {
    char buf[200];
    tls.write(c, a, strlen(a));
    int n = tls.outLength(c);
    tls.feed(s, tls.outData(c), n);
    tls.outConsumed(c, n);
    int got = tls.readApp(s, &buf[0], 200);
    buf[got] = 0;
    if (!streq(&buf[0], a)) return false;
    tls.write(s, b, strlen(b));
    n = tls.outLength(s);
    tls.feed(c, tls.outData(s), n);
    tls.outConsumed(s, n);
    got = tls.readApp(c, &buf[0], 200);
    buf[got] = 0;
    return streq(&buf[0], b);
}

int main() {
    x509.addRootPem(CA_PEM);
    tls.Config* cfg = tls.loadConfig(SERVER_CERT, SERVER_KEY);
    int suites[3] = { 0x1301, 0x1302, 0x1303 };
    char* names[3] = { "TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256" };
    tls.Tls* lastC = null;
    tls.Tls* lastS = null;
    int reused = 0;
    for (int round = 0; round < 6; round++) {
        tls.Tls* c = tls.clientOnly("127.0.0.1", true, suites[round % 3]);
        tls.Tls* s = tls.accept(cfg);
        if (round > 0 && (c == lastC || c == lastS)) reused++;
        if (round > 0 && (s == lastC || s == lastS)) reused++;
        bool hs = handshake(c, s);
        char label[100];
        format(&label[0], 100, "round %d (%s): handshake", round, names[round % 3]);
        check(&label[0], hs && streq(c->suiteName, names[round % 3]) && streq(s->suiteName, names[round % 3]));
        char a[40];
        char b[40];
        format(&a[0], 40, "request number %d", round);
        format(&b[0], 40, "reply number %d", round * 7);
        format(&label[0], 100, "round %d: data in both directions", round);
        check(&label[0], talk(c, s, &a[0], &b[0]));
        // a second message in a long stream (sequence numbers start at 0 again in every round)
        check("... and again", talk(c, s, "second", "answer"));
        tls.release(c);
        tls.release(s);
        lastC = c;
        lastS = s;
    }
    check("after the first round the sessions come from the pool", reused >= 8);

    // a failed handshake (wrong host name) gives its sessions back too
    tls.Tls* c = tls.client("wrong.example", true);
    tls.Tls* s = tls.accept(cfg);
    check("a handshake with a wrong host name fails", !handshake(c, s) && tls.failed(c) && c->certProblem != null);
    tls.release(c);
    tls.release(s);
    c = tls.client("127.0.0.1", true);
    s = tls.accept(cfg);
    check("a pooled session that failed works again (no leftover error or state)", handshake(c, s) && c->error == null && s->error == null && talk(c, s, "fine", "again"));
    check("a fresh session has no data of the old one", tls.available(c) == 0 && tls.available(s) == 0 && c->certProblem == null);
    // releasing twice must not hand the same session to two connections
    tls.release(c);
    tls.release(c);
    tls.release(s);
    tls.Tls* x = tls.client("127.0.0.1", true);
    tls.Tls* y = tls.accept(cfg);
    check("a session released twice is in the pool once", x != y);
    check("... and both work", handshake(x, y) && talk(x, y, "x", "y"));
    printf("failures: %d\n", fails);
    return fails;
}
