// matrix: hostile and degenerate input. Every class declared without parentheses (zeroed), empty and disposed objects, null pointers, absurd shapes, shapes that do not fit,
// NaN and infinity in every factorization, aliasing of arguments, sparse and complex edge cases, cg on matrices that are not positive definite. Nothing may crash, every
// answer must be the documented status or an empty result. The checks are self describing: each prints  label: ok  or  FAIL label ... ; the expected values are the contract
// in the header of lib/matrix.a (the numeric values were computed by hand or by tests/algo2_ref/gen_t464.py).
import cstdio;
import asys;
import matrix;
import dmath;

int fails = 0;
int checks = 0;

void expectInt(char* label, int got, int want) {
    checks++;
    if (got == want) { printf("%s: ok\n", label); return; }
    fails++;
    printf("FAIL %s: got %d, want %d\n", label, got, want);
}

void expectBool(char* label, bool got, bool want) {
    expectInt(label, got ? 1 : 0, want ? 1 : 0);
}

void expectNan(char* label, double v) {
    checks++;
    if (v != v) { printf("%s: ok\n", label); return; }
    fails++;
    printfd("FAIL %s: got %.9g, want NaN\n", label, __bits(v));
}

void expectNear(char* label, double got, double want, double tol) {
    checks++;
    double e = got - want;
    if (e < 0.0) { e = -e; }
    if (e <= tol) { printf("%s: ok\n", label); return; }
    fails++;
    printfd("FAIL %s: got %.12g, want %.12g\n", label, __bits(got), __bits(want));
}

void expectEmpty(char* label, matrix.Matrix m, int err) {
    checks++;
    if (!m.ok() && m.rows == 0 && m.d == null && m.err == err) { printf("%s: ok\n", label); return; }
    fails++;
    printf("FAIL %s: ok %d rows %d err %d, want empty with err %d\n", label, m.ok(), m.rows, m.err, err);
    m.dispose();
}

matrix.Matrix make2x2(double a, double b, double c, double d) {
    matrix.Matrix m(2, 2);
    m.d[0] = a;
    m.d[1] = b;
    m.d[2] = c;
    m.d[3] = d;
    return m;
}

int main() {
    int base = asys.memInUse();
    double nan = dmath.nan();
    double inf = dmath.INFINITY;
    double v2[2] = {1.0, 2.0};
    double w2[2] = {0.0, 0.0};
    double v3[3] = {1.0, 2.0, 3.0};
    double w3[3] = {0.0, 0.0, 0.0};

    // ---- constructors with absurd shapes
    {
        matrix.Matrix a(0, 3);
        matrix.Matrix b(3, 0);
        matrix.Matrix c(-1, 5);
        matrix.Matrix d(5, -1);
        matrix.Matrix e(0x7FFFFFFFFFFFFFFF, 2);
        matrix.Matrix f(2, 0x7FFFFFFFFFFFFFFF);
        matrix.Matrix g(0x100000000, 0x100000000);
        matrix.Matrix h(100000, 100000);
        expectInt("Matrix(0, 3) is empty with ERR_ARG", a.ok() ? -1 : a.err, matrix.ERR_ARG);
        expectInt("Matrix(3, 0)", b.ok() ? -1 : b.err, matrix.ERR_ARG);
        expectInt("Matrix(-1, 5)", c.ok() ? -1 : c.err, matrix.ERR_ARG);
        expectInt("Matrix(5, -1)", d.ok() ? -1 : d.err, matrix.ERR_ARG);
        expectInt("Matrix(2^63 - 1, 2)", e.ok() ? -1 : e.err, matrix.ERR_ARG);
        expectInt("Matrix(2, 2^63 - 1)", f.ok() ? -1 : f.err, matrix.ERR_ARG);
        expectInt("Matrix(2^32, 2^32): the product overflows", g.ok() ? -1 : g.err, matrix.ERR_ARG);
        expectInt("Matrix(100000, 100000): above the limit of 2^28 numbers", h.ok() ? -1 : h.err, matrix.ERR_ARG);
        matrix.CMatrix ca(0, 2);
        matrix.CMatrix cb(0x100000000, 0x100000000);
        expectInt("CMatrix(0, 2)", ca.ok() ? -1 : ca.err, matrix.ERR_ARG);
        expectInt("CMatrix(2^32, 2^32)", cb.ok() ? -1 : cb.err, matrix.ERR_ARG);
        matrix.Matrix z1 = matrix.identity(0);
        matrix.Matrix z2 = matrix.zeros(-3, 3);
        matrix.Matrix z3 = matrix.hilbert(0);
        matrix.Matrix z4 = matrix.fromArray(null, 2, 2);
        matrix.Matrix z5 = matrix.diagonal(null, 3);
        matrix.Matrix z6 = matrix.outer(null, 2, v2, 2);
        expectInt("identity(0)", z1.ok() ? -1 : z1.err, matrix.ERR_ARG);
        expectInt("zeros(-3, 3)", z2.ok() ? -1 : z2.err, matrix.ERR_ARG);
        expectInt("hilbert(0)", z3.ok() ? -1 : z3.err, matrix.ERR_ARG);
        expectInt("fromArray(null, 2, 2)", z4.ok() ? -1 : z4.err, matrix.ERR_ARG);
        expectInt("diagonal(null, 3)", z5.ok() ? -1 : z5.err, matrix.ERR_ARG);
        expectInt("outer(null, 2, v, 2)", z6.ok() ? -1 : z6.err, matrix.ERR_ARG);
    }

    // ---- a zeroed Matrix (declared without parentheses) and a disposed one
    {
        matrix.Matrix z;
        matrix.Matrix a = make2x2(1.0, 2.0, 3.0, 4.0);
        expectBool("zeroed Matrix: ok()", z.ok(), false);
        expectNan("zeroed Matrix: get", z.get(0, 0));
        expectBool("zeroed Matrix: set", z.set(0, 0, 1.0), false);
        expectBool("zeroed Matrix: row() is null", z.row(0) == null, true);
        expectEmpty("zeroed Matrix: copy()", z.copy(), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: transpose()", z.transpose(), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: add", z.add(&a), matrix.ERR_ARG);
        expectEmpty("2x2 + zeroed", a.add(&z), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: mul", z.mul(&a), matrix.ERR_ARG);
        expectEmpty("2x2 * zeroed", a.mul(&z), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: scaled", z.scaled(2.0), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: inverse()", z.inverse(), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: solve", z.solve(&a), matrix.ERR_ARG);
        expectEmpty("zeroed Matrix: submatrix", z.submatrix(0, 0, 1, 1), matrix.ERR_ARG);
        expectNan("zeroed Matrix: det()", z.det());
        expectNan("zeroed Matrix: trace()", z.trace());
        expectNan("zeroed Matrix: norm1()", z.norm1());
        expectNan("zeroed Matrix: normFro()", z.normFro());
        expectNan("zeroed Matrix: cond()", z.cond());
        expectInt("zeroed Matrix: rank()", z.rank(matrix.AUTO), -1);
        expectInt("zeroed Matrix: mulVec", z.mulVec(v2, w2), matrix.ERR_ARG);
        expectInt("zeroed Matrix: addInPlace", z.addInPlace(&a), matrix.ERR_ARG);
        expectInt("zeroed Matrix: transposeInPlace", z.transposeInPlace(), matrix.ERR_ARG);
        expectInt("zeroed Matrix: copyFrom", z.copyFrom(&a), matrix.ERR_ARG);
        expectInt("2x2.copyFrom(zeroed)", a.copyFrom(&z), matrix.ERR_ARG);
        expectBool("zeroed Matrix: isFinite", z.isFinite(), false);
        expectBool("zeroed Matrix: isSymmetric", z.isSymmetric(0.0), false);
        z.fill(1.0);
        z.setIdentity();
        z.scaleInPlace(3.0);
        z.dispose();
        z.dispose();
        expectBool("zeroed Matrix after fill, setIdentity, scaleInPlace and two dispose calls", z.ok(), false);
        a.dispose();
        a.dispose();
        expectNan("disposed Matrix: get", a.get(0, 0));
        expectEmpty("disposed Matrix: transpose()", a.transpose(), matrix.ERR_ARG);
        expectBool("disposed Matrix: set", a.set(1, 1, 1.0), false);
    }

    // ---- bad indexes and bad shapes of a valid matrix
    {
        matrix.Matrix a = make2x2(1.0, 2.0, 3.0, 4.0);
        matrix.Matrix r(2, 3);
        matrix.Matrix c(3, 2);
        expectNan("get(-1, 0)", a.get(-1, 0));
        expectNan("get(0, 2)", a.get(0, 2));
        expectNan("get(2, 0)", a.get(2, 0));
        expectBool("set(0, 2)", a.set(0, 2, 1.0), false);
        expectBool("row(2) is null", a.row(2) == null, true);
        expectBool("row(-1) is null", a.row(-1) == null, true);
        expectInt("getRow(2)", a.getRow(2, w2), matrix.ERR_ARG);
        expectInt("getRow(0, null)", a.getRow(0, null), matrix.ERR_ARG);
        expectInt("getCol(-1)", a.getCol(-1, w2), matrix.ERR_ARG);
        expectInt("setRow(5)", a.setRow(5, v2), matrix.ERR_ARG);
        expectInt("setCol(0, null)", a.setCol(0, null), matrix.ERR_ARG);
        expectInt("swapRows(0, 2)", a.swapRows(0, 2), matrix.ERR_ARG);
        expectInt("swapCols(-1, 0)", a.swapCols(-1, 0), matrix.ERR_ARG);
        expectEmpty("submatrix(1, 1, 2, 2) sticks out", a.submatrix(1, 1, 2, 2), matrix.ERR_ARG);
        expectEmpty("submatrix(0, 0, 0, 1)", a.submatrix(0, 0, 0, 1), matrix.ERR_ARG);
        expectEmpty("submatrix(-1, 0, 1, 1)", a.submatrix(-1, 0, 1, 1), matrix.ERR_ARG);
        expectEmpty("submatrix with huge nr", a.submatrix(0, 0, 0x7FFFFFFFFFFFFFFF, 1), matrix.ERR_ARG);
        expectInt("setSubmatrix sticks out", a.setSubmatrix(1, 1, &r), matrix.ERR_ARG);
        expectInt("setSubmatrix(null)", a.setSubmatrix(0, 0, null), matrix.ERR_ARG);
        expectEmpty("2x2 + 2x3", a.add(&r), matrix.ERR_DIM);
        expectEmpty("2x2 - 3x2", a.sub(&c), matrix.ERR_DIM);
        expectEmpty("2x2 hadamard 2x3", a.hadamard(&r), matrix.ERR_DIM);
        expectEmpty("2x3 * 2x3", r.mul(&r), matrix.ERR_DIM);
        expectEmpty("2x2 * null", a.mul(null), matrix.ERR_ARG);
        expectInt("2x2.addInPlace(2x3)", a.addInPlace(&r), matrix.ERR_DIM);
        expectInt("2x2.subInPlace(null)", a.subInPlace(null), matrix.ERR_ARG);
        expectInt("2x2.axpyInPlace(2x3)", a.axpyInPlace(2.0, &r), matrix.ERR_DIM);
        expectInt("2x3.transposeInPlace (not square)", r.transposeInPlace(), matrix.ERR_DIM);
        expectInt("copyFrom a matrix of another shape", a.copyFrom(&r), matrix.ERR_DIM);
        expectInt("copyFrom(null)", a.copyFrom(null), matrix.ERR_ARG);
        expectInt("mulVec(null, y)", a.mulVec(null, w2), matrix.ERR_ARG);
        expectInt("mulVec(x, null)", a.mulVec(v2, null), matrix.ERR_ARG);
        expectInt("mulVec(x, x): the output must not be the input", a.mulVec(v2, v2), matrix.ERR_ARG);
        expectInt("mulVecT(x, x)", a.mulVecT(v2, v2), matrix.ERR_ARG);
        matrix.Matrix p(2, 2);
        expectInt("mulInto(2x3, p): shape", a.mulInto(&r, &p), matrix.ERR_DIM);
        expectInt("mulInto into one of the operands", a.mulInto(&a, &a), matrix.ERR_ARG);
        expectInt("mulInto(null, p)", a.mulInto(null, &p), matrix.ERR_ARG);
        expectInt("mulInto(a, null)", a.mulInto(&a, null), matrix.ERR_ARG);
        expectEmpty("2x3.inverse(): not square", r.inverse(), matrix.ERR_DIM);
        expectNan("2x3.det(): not square", r.det());
        expectBool("2x3.isSymmetric", r.isSymmetric(0.0), false);
        expectNear("2x3.trace() uses the shorter diagonal", r.trace(), 0.0, 0.0);
        a.dispose();
        r.dispose();
        c.dispose();
        p.dispose();
    }

    // ---- NaN and infinity in every factorization
    {
        matrix.Matrix a = make2x2(4.0, 1.0, 1.0, 3.0);
        matrix.Matrix b = make2x2(4.0, 1.0, 1.0, 3.0);
        b.d[1] = nan;
        matrix.Matrix c = make2x2(4.0, 1.0, 1.0, 3.0);
        c.d[3] = inf;
        matrix.Matrix e = make2x2(nan, nan, nan, nan);
        matrix.LU lb(&b);
        matrix.LU lc(&c);
        matrix.LU le(&e);
        expectInt("LU of a matrix with NaN", lb.err, matrix.ERR_NOT_FINITE);
        expectInt("LU of a matrix with infinity", lc.err, matrix.ERR_NOT_FINITE);
        expectInt("LU of an all NaN matrix", le.err, matrix.ERR_NOT_FINITE);
        expectInt("LU.solve after a refused factorization", lb.solve(v2, w2), matrix.ERR_NOT_FINITE);
        expectNan("LU.det of a refused factorization", lb.det());
        expectNear("LU.rcond of a refused factorization is 0", lb.rcond(), 0.0, 0.0);
        expectEmpty("LU.inverse of a refused factorization", lb.inverse(), matrix.ERR_NOT_FINITE);
        matrix.Cholesky cb(&b);
        matrix.Cholesky cc(&c);
        expectBool("Cholesky of a matrix with NaN fails", cb.ok(), false);
        expectBool("Cholesky of a matrix with infinity fails", cc.ok(), false);
        expectBool("Cholesky error is not OK", cb.err != matrix.OK, true);
        matrix.QR qb(&b);
        matrix.QR qc(&c);
        expectInt("QR with NaN", qb.err, matrix.ERR_NOT_FINITE);
        expectInt("QR with infinity", qc.err, matrix.ERR_NOT_FINITE);
        matrix.SymEigen sb(&b, true);
        matrix.SymEigen sc(&c, true);
        expectBool("SymEigen with NaN fails", sb.ok(), false);
        expectBool("SymEigen with infinity fails", sc.ok(), false);
        matrix.SVD vb(&b);
        matrix.SVD vc(&c);
        expectInt("SVD with NaN", vb.err, matrix.ERR_NOT_FINITE);
        expectInt("SVD with infinity", vc.err, matrix.ERR_NOT_FINITE);
        expectNan("Matrix.det with NaN", b.det());
        expectEmpty("Matrix.inverse with NaN", b.inverse(), matrix.ERR_NOT_FINITE);
        expectNan("Matrix.cond with NaN", b.cond());
        expectInt("Matrix.rank with NaN", b.rank(matrix.AUTO), -1);
        double rhs[2] = {nan, 1.0};
        matrix.LU la(&a);
        expectInt("LU.solve with a NaN right hand side", la.solve(rhs, w2), matrix.ERR_NOT_FINITE);
        double x2[2] = {0.0, 0.0};
        double resid = 0.0;
        expectInt("lstsq with NaN in the matrix", matrix.lstsq(&b, v2, x2, &resid, null), matrix.ERR_NOT_FINITE);
        expectInt("lstsq with NaN in b", matrix.lstsq(&a, rhs, x2, &resid, null), matrix.ERR_NOT_FINITE);
        expectBool("isFinite of the NaN matrix", b.isFinite(), false);
        expectNan("normFro of the NaN matrix", b.normFro());
        expectNan("norm1 of the NaN matrix", b.norm1());
        expectNan("normInf of the NaN matrix", b.normInf());
        matrix.Matrix s = b.add(&a);
        expectBool("add spreads the NaN (IEEE)", s.ok() && s.d[1] != s.d[1] && s.d[0] == 8.0, true);
        s.dispose();
        lb.dispose();
        lc.dispose();
        le.dispose();
        la.dispose();
        cb.dispose();
        cc.dispose();
        qb.dispose();
        qc.dispose();
        sb.dispose();
        sc.dispose();
        vb.dispose();
        vc.dispose();
        a.dispose();
        b.dispose();
        c.dispose();
        e.dispose();
    }

    // ---- zeroed factorization objects and null arguments
    {
        matrix.LU f;
        matrix.Cholesky ch;
        matrix.QR qr;
        matrix.SymEigen se;
        matrix.SVD sv;
        expectBool("zeroed LU: ok()", f.ok() && f.n > 0, false);
        expectInt("zeroed LU.solve", f.solve(v2, w2) == matrix.OK ? 0 : 1, 1);
        expectNan("zeroed LU.det", f.det());
        expectEmpty("zeroed LU.inverse", f.inverse(), matrix.ERR_ARG);
        expectBool("zeroed Cholesky: ok", ch.ok() && ch.n > 0, false);
        expectInt("zeroed Cholesky.solve", ch.solve(v2, w2) == matrix.OK ? 0 : 1, 1);
        expectBool("zeroed QR: ok", qr.ok() && qr.m > 0, false);
        expectInt("zeroed QR.solveLS", qr.solveLS(v2, w2, null) == matrix.OK ? 0 : 1, 1);
        expectBool("zeroed SymEigen: ok", se.ok(), false);
        expectBool("zeroed SVD: ok", sv.ok(), false);
        expectInt("zeroed SVD.rank", sv.rank(matrix.AUTO) <= 0 ? 0 : 1, 0);
        f.dispose();
        ch.dispose();
        qr.dispose();
        se.dispose();
        sv.dispose();
        matrix.LU n1(null);
        matrix.Cholesky n2(null);
        matrix.QR n3(null);
        matrix.SymEigen n4(null, true);
        matrix.SVD n5(null);
        expectInt("LU(null)", n1.err, matrix.ERR_ARG);
        expectBool("Cholesky(null)", n2.ok(), false);
        expectInt("QR(null)", n3.err, matrix.ERR_ARG);
        expectBool("SymEigen(null)", n4.ok(), false);
        expectInt("SVD(null)", n5.err, matrix.ERR_ARG);
        matrix.Matrix em;
        matrix.LU e1(&em);
        matrix.QR e3(&em);
        matrix.SVD e5(&em);
        expectInt("LU(empty)", e1.err, matrix.ERR_ARG);
        expectInt("QR(empty)", e3.err, matrix.ERR_ARG);
        expectInt("SVD(empty)", e5.err, matrix.ERR_ARG);
        expectInt("lstsq(null)", matrix.lstsq(null, v2, w2, null, null), matrix.ERR_ARG);
        n1.dispose();
        n3.dispose();
        n5.dispose();
        e1.dispose();
        e3.dispose();
        e5.dispose();
        matrix.Matrix a = make2x2(1.0, 2.0, 3.0, 4.0);
        expectInt("lstsq(a, null, x)", matrix.lstsq(&a, null, w2, null, null), matrix.ERR_ARG);
        expectInt("lstsq(a, b, null)", matrix.lstsq(&a, v2, null, null, null), matrix.ERR_ARG);
        a.dispose();
        expectInt("luFactor(null)", matrix.luFactor(null, 2, null, null, null), matrix.ERR_ARG);
    }

    // ---- shapes that do not fit in the solvers
    {
        matrix.Matrix a = make2x2(4.0, 1.0, 1.0, 3.0);
        matrix.Matrix t(3, 2);
        matrix.Matrix w(2, 3);
        for (int i = 0; i < 6; i++) { t.d[i] = (double) (i * i + 1); w.d[i] = (double) (7 - i); }
        matrix.Matrix rhs(3, 1);
        matrix.LU f(&a);
        expectEmpty("LU.solveMatrix with 3 rows against a 2 x 2 system", f.solveMatrix(&rhs), matrix.ERR_DIM);
        expectEmpty("LU.solveMatrix(null)", f.solveMatrix(null), matrix.ERR_ARG);
        matrix.LU lt(&t);
        matrix.Cholesky cht(&t);
        expectInt("LU of a 3 x 2 matrix", lt.err, matrix.ERR_DIM);
        expectInt("Cholesky of a 3 x 2 matrix", cht.err, matrix.ERR_DIM);
        lt.dispose();
        cht.dispose();
        matrix.QR qt(&t);
        matrix.QR qw(&w);
        expectInt("QR of a 3 x 2 matrix is fine", qt.err, matrix.OK);
        expectInt("QR of a 2 x 3 matrix is fine", qw.err, matrix.OK);
        double b3[3] = {1.0, 2.0, 3.0};
        double x2[2] = {0.0, 0.0};
        expectInt("QR.solveLS of a 3 x 2 system", qt.solveLS(b3, x2, null), matrix.OK);
        double bb2[2] = {1.0, 2.0};
        double x3[3] = {0.0, 0.0, 0.0};
        expectBool("QR.solveLS of a wide 2 x 3 matrix is refused (use lstsq)", qw.solveLS(bb2, x3, null) != matrix.OK, true);
        expectInt("lstsq of the wide matrix gives the minimum norm solution", matrix.lstsq(&w, bb2, x3, null, null), matrix.OK);
        matrix.SymEigen se(&t, true);
        expectBool("SymEigen of a 3 x 2 matrix fails", se.ok(), false);
        se.dispose();
        matrix.Matrix ns = make2x2(1.0, 2.0, 3.0, 4.0);
        matrix.SymEigen se2(&ns, true);
        expectInt("SymEigen of a matrix that is not symmetric", se2.err, matrix.ERR_NOT_SYMMETRIC);
        matrix.Cholesky cn(&ns);
        expectInt("Cholesky of a matrix that is not symmetric", cn.err, matrix.ERR_NOT_SYMMETRIC);
        matrix.Matrix neg = make2x2(1.0, 2.0, 2.0, 1.0);
        matrix.Cholesky cneg(&neg);
        expectInt("Cholesky of an indefinite matrix", cneg.err, matrix.ERR_NOT_SPD);
        matrix.Matrix semi = make2x2(1.0, 1.0, 1.0, 1.0);
        matrix.Cholesky csemi(&semi);
        expectInt("Cholesky of a semi definite matrix", csemi.err, matrix.ERR_NOT_SPD);
        se2.dispose();
        cn.dispose();
        cneg.dispose();
        csemi.dispose();
        f.dispose();
        qt.dispose();
        qw.dispose();
        a.dispose();
        t.dispose();
        w.dispose();
        rhs.dispose();
        ns.dispose();
        neg.dispose();
        semi.dispose();
    }

    // ---- overflow: values near the limits of a double are refused instead of giving NaN or infinity as an answer
    {
        matrix.Matrix big = make2x2(1.0e200, 0.0, 0.0, 1.0e200);
        matrix.Matrix tiny = make2x2(1.0e-200, 0.0, 0.0, 1.0e-200);
        expectNear("normFro of 1e200 x identity is finite and right (no overflow of squares)", big.normFro() / 1.0e200, 1.4142135623730951, 1.0e-15);
        expectNear("normFro of 1e-200 x identity (no underflow of squares)", tiny.normFro() / 1.0e-200, 1.4142135623730951, 1.0e-15);
        expectNear("vecNorm2 of (3e200, 4e200)", matrix.vecNorm2(v2, 0) + 0.0, 0.0, 0.0);
        double bv[2] = {3.0e200, 4.0e200};
        expectNear("vecNorm2 of (3e200, 4e200) = 5e200", matrix.vecNorm2(bv, 2) / 1.0e200, 5.0, 1.0e-14);
        matrix.LU lb(&big);
        double x[2] = {0.0, 0.0};
        double b2[2] = {1.0e200, 1.0e200};
        expectInt("LU.solve of 1e200 x identity", lb.solve(b2, x), matrix.OK);
        expectNear("x = (1, 1)", x[0], 1.0, 1.0e-14);
        double ld = 0.0;
        int sg = 0;
        ld = lb.logAbsDet(&sg);
        expectNear("logAbsDet of 1e200 x identity = 2 ln(1e200)", ld, 2.0 * 200.0 * 2.302585092994046, 1.0e-9);
        expectInt("sign of the determinant", sg, 1);
        expectBool("det overflows to infinity (the determinant is 1e400)", lb.det() > 1.0e300, true);
        lb.dispose();
        big.dispose();
        tiny.dispose();
    }

    // ---- the empty and the one by one matrices
    {
        matrix.Matrix one(1, 1);
        one.d[0] = -2.0;
        matrix.LU f(&one);
        double x1[1] = {0.0};
        double b1[1] = {6.0};
        expectInt("1x1 LU.solve", f.solve(b1, x1), matrix.OK);
        expectNear("1x1 solution", x1[0], -3.0, 0.0);
        expectNear("1x1 det", f.det(), -2.0, 0.0);
        matrix.SVD sv(&one);
        expectNear("1x1 singular value", sv.s[0], 2.0, 1.0e-15);
        matrix.SymEigen se(&one, true);
        expectNear("1x1 eigenvalue", se.values[0], -2.0, 0.0);
        matrix.QR qr(&one);
        expectInt("1x1 QR", qr.err, matrix.OK);
        expectNear("1x1 cond", one.cond(), 1.0, 1.0e-15);
        expectInt("1x1 rank", one.rank(matrix.AUTO), 1);
        f.dispose();
        sv.dispose();
        se.dispose();
        qr.dispose();
        matrix.Matrix col(5, 1);
        matrix.Matrix row(1, 5);
        for (int i = 0; i < 5; i++) { col.d[i] = (double) (i + 1); row.d[i] = (double) (i + 1); }
        matrix.Matrix outer = col.mul(&row);
        matrix.Matrix inner = row.mul(&col);
        expectBool("5x1 times 1x5 is 5x5", outer.rows == 5 && outer.cols == 5, true);
        expectNear("1x5 times 5x1 is 55", inner.d[0], 55.0, 0.0);
        expectInt("rank of an outer product is 1", outer.rank(matrix.AUTO), 1);
        matrix.SVD so(&outer);
        expectNear("its only singular value is 55", so.s[0], 55.0, 1.0e-12);
        so.dispose();
        outer.dispose();
        inner.dispose();
        col.dispose();
        row.dispose();
        one.dispose();
    }

    // ---- sparse vectors and matrices
    {
        matrix.SparseVector z;
        expectBool("zeroed SparseVector: put fails", z.put(0, 1.0), false);
        expectNan("zeroed SparseVector.get", z.get(0));
        expectNan("zeroed SparseVector.norm2", z.norm2() * 0.0 + (z.n == 0 ? dmath.nan() : 0.0));
        matrix.SparseVector sv(5);
        expectBool("put(5): out of range", sv.put(5, 1.0), false);
        expectBool("put(-1)", sv.put(-1, 1.0), false);
        expectBool("put(2, 3.5)", sv.put(2, 3.5), true);
        expectBool("put(0, 1.5)", sv.put(0, 1.5), true);
        expectBool("put(2, 0) removes the entry", sv.put(2, 0.0), true);
        expectInt("nnz is 1", sv.nnz, 1);
        expectNan("get(7) is NaN", sv.get(7));
        expectNear("get(1) is 0", sv.get(1), 0.0, 0.0);
        matrix.SparseVector other(4);
        expectNan("dot of vectors with different dimensions", sv.dot(&other));
        matrix.SparseVector sum = sv.addScaled(1.0, &other);
        expectBool("addScaled with different dimensions is refused", sum.ok(), false);
        expectInt("with ERR_DIM", sum.err, matrix.ERR_DIM);
        matrix.SparseVector nul = sv.addScaled(1.0, null);
        expectInt("addScaled(null) is ERR_ARG", nul.err, matrix.ERR_ARG);
        expectNan("dotDense(null)", sv.dotDense(null));
        matrix.SparseVector sv0(0);
        expectBool("SparseVector(0) is not usable", sv0.put(0, 1.0), false);
        matrix.SparseVector svn(-4);
        expectBool("SparseVector(-4) is not usable", svn.put(0, 1.0), false);
        z.dispose();
        sv.dispose();
        other.dispose();
        sv0.dispose();
        svn.dispose();

        matrix.CooBuilder cb(3, 3);
        expectBool("CooBuilder.add out of range", cb.add(3, 0, 1.0), false);
        expectBool("CooBuilder.add negative", cb.add(0, -1, 1.0), false);
        expectBool("CooBuilder.add NaN", cb.add(0, 0, nan), false);
        expectBool("CooBuilder.add infinity", cb.add(0, 0, inf), false);
        expectBool("CooBuilder.add valid", cb.add(1, 1, 2.0), true);
        expectBool("CooBuilder.add duplicate adds up", cb.add(1, 1, 3.0), true);
        expectBool("CooBuilder.add cancels", cb.add(2, 2, 4.0) && cb.add(2, 2, -4.0), true);
        matrix.CsrMatrix m = cb.build();
        expectInt("built: 1 stored entry (the cancelled one is dropped)", m.nnz, 1);
        expectNear("entry (1, 1) = 5", m.get(1, 1), 5.0, 0.0);
        expectNan("get(3, 0) out of range", m.get(3, 0));
        double x3[3] = {1.0, 2.0, 3.0};
        double y3[3] = {9.0, 9.0, 9.0};
        expectInt("mulVec", m.mulVec(x3, y3), matrix.OK);
        expectNear("y[1] = 10", y3[1], 10.0, 0.0);
        expectNear("y[0] = 0", y3[0], 0.0, 0.0);
        expectInt("mulVec(x, x)", m.mulVec(x3, x3), matrix.ERR_ARG);
        expectInt("mulVec(null)", m.mulVec(null, y3), matrix.ERR_ARG);
        expectInt("mulVecT(x, x)", m.mulVecT(x3, x3), matrix.ERR_ARG);
        matrix.CsrMatrix wide(3, 4, 0);
        matrix.CsrMatrix p = m.mul(&wide);
        expectBool("3x3 times an empty 3x4 is a 3x4 without entries", p.ok() && p.cols == 4 && p.nnz == 0, true);
        matrix.CsrMatrix q = wide.mul(&m);
        expectBool("3x4 times 3x3 is refused", q.ok(), false);
        matrix.CsrMatrix s = m.addScaled(1.0, &wide);
        expectBool("addScaled with another shape is refused", s.ok(), false);
        matrix.CsrMatrix zr;
        expectBool("zeroed CsrMatrix: ok()", zr.ok(), false);
        expectNan("zeroed CsrMatrix.get", zr.get(0, 0));
        expectInt("zeroed CsrMatrix.mulVec", zr.mulVec(x3, y3), matrix.ERR_ARG);
        expectNan("zeroed CsrMatrix.normFro", zr.normFro());
        cb.dispose();
        cb.dispose();
        expectBool("CooBuilder after dispose: empty but usable again", cb.add(0, 0, 1.0), true);
        cb.dispose();
        m.dispose();
        wide.dispose();
        p.dispose();
        q.dispose();
        s.dispose();
        zr.dispose();
        matrix.CooBuilder cb0(0, 3);
        expectBool("CooBuilder(0, 3): add fails", cb0.add(0, 0, 1.0), false);
        matrix.CsrMatrix e = cb0.build();
        expectBool("CooBuilder(0, 3).build() is empty", e.ok(), false);
        e.dispose();
        cb0.dispose();
    }

    // ---- conjugate gradient on bad systems
    {
        matrix.CooBuilder cb(3, 3);
        for (int i = 0; i < 3; i++) { cb.add(i, i, (double) (i + 1)); }
        matrix.CsrMatrix a = cb.build();
        cb.dispose();
        double b[3] = {1.0, 1.0, 1.0};
        double x[3] = {0.0, 0.0, 0.0};
        int iters = -1;
        expectInt("cg on diag(1, 2, 3)", matrix.cg(&a, b, x, 100, 1.0e-12, &iters, true), matrix.OK);
        expectNear("x[2] = 1/3", x[2], 1.0 / 3.0, 1.0e-12);
        expectBool("at most 3 iterations", iters >= 1 && iters <= 3, true);
        x[0] = 0.0;
        x[1] = 0.0;
        x[2] = 0.0;
        expectInt("cg with maxIter = 0", matrix.cg(&a, b, x, 0, 1.0e-12, &iters, true), matrix.ERR_NO_CONVERGE);
        expectInt("cg(null matrix)", matrix.cg(null, b, x, 10, 1.0e-12, null, true), matrix.ERR_ARG);
        expectInt("cg(null b)", matrix.cg(&a, null, x, 10, 1.0e-12, null, true), matrix.ERR_ARG);
        expectInt("cg(null x)", matrix.cg(&a, b, null, 10, 1.0e-12, null, true), matrix.ERR_ARG);
        double zero[3] = {0.0, 0.0, 0.0};
        x[0] = 5.0;
        x[1] = 5.0;
        x[2] = 5.0;
        expectInt("cg with b = 0 and a wrong start", matrix.cg(&a, zero, x, 100, 1.0e-12, &iters, true), matrix.OK);
        expectNear("then x = 0", x[0] + x[1] + x[2], 0.0, 1.0e-9);
        double bn[3] = {1.0, nan, 1.0};
        expectBool("cg with NaN in b is not OK", matrix.cg(&a, bn, x, 100, 1.0e-12, &iters, true) != matrix.OK, true);
        matrix.CooBuilder cn(2, 2);
        cn.add(0, 0, 1.0);
        cn.add(1, 1, -1.0);
        matrix.CsrMatrix ind = cn.build();
        cn.dispose();
        double b2[2] = {1.0, 1.0};
        double x2[2] = {0.0, 0.0};
        expectInt("cg on an indefinite matrix", matrix.cg(&ind, b2, x2, 50, 1.0e-12, null, false), matrix.ERR_NOT_SPD);
        matrix.CooBuilder cr(2, 3);
        cr.add(0, 0, 1.0);
        matrix.CsrMatrix rect = cr.build();
        cr.dispose();
        expectBool("cg on a 2 x 3 matrix is not OK", matrix.cg(&rect, b2, x2, 50, 1.0e-12, null, false) != matrix.OK, true);
        a.dispose();
        ind.dispose();
        rect.dispose();
    }

    // ---- complex matrices
    {
        matrix.CMatrix z;
        expectBool("zeroed CMatrix: ok()", z.ok(), false);
        double xr[2] = {1.0, 2.0};
        double xi[2] = {0.5, 0.0};
        double yr[2] = {0.0, 0.0};
        double yi[2] = {0.0, 0.0};
        expectInt("zeroed CMatrix.mulVec", z.mulVec(xr, xi, yr, yi), matrix.ERR_ARG);
        expectBool("zeroed CMatrix.set", z.set(0, 0, 1.0, 1.0), false);
        expectNan("zeroed CMatrix.getRe", z.getRe(0, 0));
        double dr = 0.0;
        double di = 0.0;
        expectInt("zeroed CMatrix.det", z.det(&dr, &di), matrix.ERR_ARG);
        matrix.CMatrix a(2, 2);
        a.set(0, 0, 1.0, 1.0);
        a.set(0, 1, 2.0, 0.0);
        a.set(1, 0, 0.0, 0.0);
        a.set(1, 1, 3.0, -1.0);
        expectBool("set out of range", a.set(2, 0, 1.0, 1.0), false);
        expectNan("getIm out of range", a.getIm(0, 5));
        expectInt("det of the triangular matrix", a.det(&dr, &di), matrix.OK);
        expectNear("det re = (1+i)(3-i) = 4 + 2i", dr, 4.0, 1.0e-15);
        expectNear("det im = 2", di, 2.0, 1.0e-15);
        a.set(0, 0, nan, 0.0);
        expectInt("det with NaN", a.det(&dr, &di), matrix.ERR_NOT_FINITE);
        expectInt("solve with NaN", a.solve(xr, xi, yr, yi), matrix.ERR_NOT_FINITE);
        a.set(0, 0, 0.0, 0.0);
        a.set(0, 1, 0.0, 0.0);
        expectInt("singular complex matrix: solve", a.solve(xr, xi, yr, yi), matrix.ERR_SINGULAR);
        expectInt("singular complex matrix: det", a.det(&dr, &di), matrix.OK);
        expectNear("det of a singular complex matrix is 0", dr * dr + di * di, 0.0, 0.0);
        matrix.CMatrix b(3, 2);
        matrix.CMatrix s = a.mul(&b);
        expectBool("2x2 times 3x2 is refused", s.ok(), false);
        matrix.CMatrix t = a.add(&b);
        expectBool("2x2 + 3x2 is refused", t.ok(), false);
        double tr = 0.0;
        double ti = 0.0;
        expectInt("trace of a non square matrix sums the shorter diagonal", b.trace(&tr, &ti), matrix.OK);
        expectInt("mulVec(null)", a.mulVec(null, xi, yr, yi), matrix.ERR_ARG);
        z.dispose();
        a.dispose();
        b.dispose();
        s.dispose();
        t.dispose();
    }

    // ---- vectors: zero length and null
    {
        expectNear("vecDot(null, null, 0)", matrix.vecDot(null, null, 0), 0.0, 0.0);
        expectNear("vecNorm2(null, 0)", matrix.vecNorm2(null, 0), 0.0, 0.0);
        expectNear("vecNorm1(x, -3)", matrix.vecNorm1(v3, -3), 0.0, 0.0);
        expectNear("vecNormInf(x, 0)", matrix.vecNormInf(v3, 0), 0.0, 0.0);
        expectNear("vecDot of (1, 2, 3) with itself", matrix.vecDot(v3, v3, 3), 14.0, 0.0);
        expectNear("vecNorm2 of (1, 2, 3)", matrix.vecNorm2(v3, 3), dmath.sqrt(14.0), 1.0e-15);
        matrix.vecAxpy(2.0, v3, w3, 3);
        expectNear("axpy", w3[2], 6.0, 0.0);
        matrix.vecScale(w3, 0.5, 3);
        expectNear("scale", w3[2], 3.0, 0.0);
        matrix.vecFill(w3, -1.0, 0);
        expectNear("fill with n = 0 changes nothing", w3[2], 3.0, 0.0);
        double nv[2] = {1.0, nan};
        expectNan("vecNorm2 with NaN", matrix.vecNorm2(nv, 2));
        expectNan("vecNorm1 with NaN", matrix.vecNorm1(nv, 2));
        expectNan("vecNormInf with NaN", matrix.vecNormInf(nv, 2));
        double iv[2] = {1.0, inf};
        expectBool("vecNorm2 with infinity is infinity", matrix.vecNorm2(iv, 2) == inf, true);
    }

    printf("%d checks, %d failed\n", checks, fails);
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return fails == 0 ? 0 : 1;
}
