// literal suffixes, typed constants, enum base types, climits uint64 limits
import cstdio;
import climits;
const uint8 K8 = 300;
const int16 K16 = -5;
enum Kind : uint8 { Text, Binary, Image = 200 }
struct Frame { Kind kind; uint16 length; Kind other; }
int main() {
    printf("%d %d\n", K8, K16);
    long l = 10L; unsigned u = 10u; unsigned long ul = 0xFFul;
    printf("%d %d %d\n", l, u, ul);
    printf("%u %d %d\n", UINT64_MAX, UINT64_MAX > 5, SIZE_MAX == UINT64_MAX);
    printf("%d %d\n", sizeof(Kind), sizeof(Frame));
    Frame f; f.kind = Image; f.length = 9; f.other = Binary;
    printf("%d %d %d\n", f.kind, f.length, f.other);
    Kind k = 300;
    printf("%d\n", k);
    return 0;
}
