import path;
import csv;

int main() {
    println(path.join("a/b", "c.txt")); println(path.join("a/b/", "/c")); println(path.join("a", "/abs")); println(path.join("", "x")); println(path.join("a", ""));
    println(path.basename("/usr/lib/a/x.tar.gz")); println(path.basename("dir/")); println(path.basename("file"));
    println(path.dirname("/usr/lib/a/x.tar.gz")); println(path.dirname("file")); println(path.dirname("/file")); println(path.dirname("a\\b\\c"));
    println(path.extension("a/b/c.txt")); println(path.extension("a.b/c")); println(path.extension(".bashrc")); println(path.extension("x.tar.gz"));
    println(path.stem("a/b/c.tar.gz")); println(path.withExtension("a/b/c.txt", ".bak")); println(path.withExtension("noext", ".md"));
    printBool(path.isAbsolute("/x")); printBool(path.isAbsolute("C:\\x")); printBool(path.isAbsolute("x/y")); println("");
    println(path.normalize("a//b/./c/../d")); println(path.normalize("/../a/b/..")); println(path.normalize("../x/./y/..")); println(path.normalize("a/..")); println(path.normalize("/a/b/../../.."));

    char* f[8];
    int n = csv.parseLine("a,b,,\"c,d\",\"say \"\"hi\"\"\",e", ',', f, 8);
    printlnInt(n);
    for (int i = 0; i < n; i++) { print("<"); print(f[i]); print(">"); }
    println("");
    n = csv.parseLine("", ',', f, 8); printlnInt(n); printlnInt(strlen(f[0]));
    n = csv.parseLine("x;y;z", ';', f, 8); printlnInt(n);
    println(csv.quote("plain", ',')); println(csv.quote("a,b", ',')); println(csv.quote("q\"q", ','));
    char* row[4]; row[0] = "id"; row[1] = "hello, world"; row[2] = "say \"x\""; row[3] = "";
    char* line = csv.joinLine(row, 4, ',');
    println(line);
    n = csv.parseLine(line, ',', f, 8);
    printlnInt(n); println(f[1]); println(f[2]);
    return 0;
}
