// dns: queries for several record types, a reply parser with compressed names, and a query answered through the loopback interface
import dns;
import net;
import netaddr;

int main() {
    char q[600];
    int n = dns.buildQuery("www.example.org", dns.MX, 0x1234, q);
    printlnInt(n);
    printlnInt(q[n - 4] * 256 + q[n - 3]);
    printlnInt(dns.buildQuery("a..b", dns.A, 1, q));
    printlnInt(dns.buildQuery("example.org.", dns.A, 1, q) > 0);

    // a handmade reply: MX 10 mail.example.org (the name is a pointer into the question) and an A record
    char r[600];
    int len = dns.buildQuery("example.org", dns.MX, 0x4321, r);
    r[2] = 0x81; r[3] = 0x80; r[7] = 3;
    int p = len;
    r[p] = 0xC0; r[p+1] = 12; r[p+2] = 0; r[p+3] = 15; r[p+4] = 0; r[p+5] = 1; r[p+6] = 0; r[p+7] = 0; r[p+8] = 1; r[p+9] = 0;
    r[p+10] = 0; r[p+11] = 9;                     // rdlength: pref(2) + 4 'mail' + pointer 2 + ... see below
    r[p+12] = 0; r[p+13] = 10;                    // preference 10
    r[p+14] = 4; r[p+15] = 'm'; r[p+16] = 'a'; r[p+17] = 'i'; r[p+18] = 'l';
    r[p+19] = 0xC0; r[p+20] = 12;                 // .example.org
    p = p + 21;
    // TXT
    r[p] = 0xC0; r[p+1] = 12; r[p+2] = 0; r[p+3] = 16; r[p+4] = 0; r[p+5] = 1; r[p+6] = 0; r[p+7] = 0; r[p+8] = 0; r[p+9] = 5;
    r[p+10] = 0; r[p+11] = 7;
    r[p+12] = 2; r[p+13] = 'h'; r[p+14] = 'i'; r[p+15] = 3; r[p+16] = 'y'; r[p+17] = 'o'; r[p+18] = 'u';
    p = p + 19;
    // A
    r[p] = 0xC0; r[p+1] = 12; r[p+2] = 0; r[p+3] = 1; r[p+4] = 0; r[p+5] = 1; r[p+6] = 0; r[p+7] = 0; r[p+8] = 14; r[p+9] = 16;
    r[p+10] = 0; r[p+11] = 4; r[p+12] = 93; r[p+13] = 184; r[p+14] = 216; r[p+15] = 34;
    p = p + 16;
    printlnInt(dns.parseReply(r, p, 0x4321));
    for (int i = 0; i < dns.recordCount(); i++) {
        dns.Record* rec = dns.recordAt(i);
        print(dns.typeName(rec->type)); print(" "); print(rec->name); print(" "); printInt(rec->ttl); print(" ");
        println(dns.recordText(rec));
    }
    printlnInt(dns.parseReply(r, p, 0x1111));        // not the reply to that query
    printlnInt(dns.rcode());

    // a DNS exchange on the loopback interface in one process: the "server" is a UDP socket we read ourselves
    int server = net.udpBind(0);
    int port = net.localPort(server);
    net.setTimeout(server, 1000);
    dns.Pending* pend = dns.startQuery(0x7F000001, port, "host.test", dns.A);
    printlnInt(pend != null);
    char in[600];
    int cip; int cport;
    int got = net.recvFrom(server, in, 600, &cip, &cport);
    printlnInt(got > 12);
    char reply[600];
    int rl = dns.buildReply(in, got, netaddr.ipFromBytes(10, 1, 2, 3), reply);
    net.sendTo(server, cip, cport, reply, rl);
    printlnInt(dns.finishQuery(pend, 1000));
    println(dns.recordText(dns.recordAt(0)));
    println(dns.recordAt(0)->name);

    // and the answer "no such name"
    pend = dns.startQuery(0x7F000001, port, "nothing.test", dns.A);
    got = net.recvFrom(server, in, 600, &cip, &cport);
    rl = dns.buildReply(in, got, 0, reply);
    net.sendTo(server, cip, cport, reply, rl);
    printlnInt(dns.finishQuery(pend, 1000));
    printlnInt(dns.rcode());

    // the whole query() path against that socket
    dns.setServer(0x7F000001, port);
    printlnInt(dns.lookupA("10.9.8.7") == netaddr.ipFromBytes(10, 9, 8, 7));      // an address needs no query
    net.close(server);
    return 0;
}
