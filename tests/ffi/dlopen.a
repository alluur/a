// dlopen / dlsym: a C function pointer filled in at run time (how AGE loads EGL, GLES and audio libraries)
a_module c {
extern "libc.so.6" {
    void* dlopen(char* file, int mode);
    void* dlsym(void* handle, char* name);
    char* dlerror();
}
}
extern "C" {
    double pcos(double x);              // pointer slots, set from dlsym
    float pfabsf(float x);
    int pabs(int x);
}
int main() {
    void* m = c.dlopen("libm.so.6", 2);
    if (m == null) { println("no libm"); return 1; }
    pcos = c.dlsym(m, "cos");
    pfabsf = c.dlsym(m, "fabsf");
    void* lc = c.dlopen("libc.so.6", 2);
    pabs = c.dlsym(lc, "abs");
    printInt(pcos != null); printInt(pfabsf != null); printInt(pabs != null); println("");
    printlnDouble(pcos(0.0)); printlnDouble(pfabsf(-2.5)); printInt(pabs(-7)); println("");
    void* none = c.dlsym(m, "no_such_function");
    printInt(none == null); println("");
    return 0;
}
