// calling Windows DLLs: msvcrt (printf with doubles, qsort with an A callback, strlen, cos), kernel32
a_module c {
extern "msvcrt.dll" {
    int printf(char* fmt, ...);
    uint64_t strlen(char* s);
    void qsort(void* base, uint64_t n, uint64_t size, void* cmp);
    void* malloc(uint64_t n);
    void free(void* p);
    double cos(double x);
    double pow(double x, double y);
    int _snprintf(char* buf, uint64_t n, char* fmt, ...);
    int fflush(void* f);
}
extern "kernel32.dll" {
    uint32_t GetCurrentProcessId();
    int32_t MulDiv(int32_t a, int32_t b, int32_t c);
}
}
extern "C" int cmp_desc(int32_t* a, int32_t* b) { return *b - *a; }
int main() {
    c.printf("hello %s %d %.3f %lld %c\n", "from A", 42, 3.14159, 1234567890123, 65);
    c.printf("strlen %llu\n", c.strlen("Aytict"));
    int32_t* v = c.malloc(5 * 4);
    v[0] = 3; v[1] = 9; v[2] = -2; v[3] = 7; v[4] = 0;
    c.qsort(v, 5, 4, cmp_desc);
    c.printf("sorted %d %d %d %d %d\n", v[0], v[1], v[2], v[3], v[4]);
    c.free(v);
    c.printf("cos(0)=%g pow(2,10)=%g MulDiv=%d pid>0=%d\n", c.cos(0.0), c.pow(2, 10), c.MulDiv(1000, 3, 4), c.GetCurrentProcessId() > 0);
    char buf[64];
    int n = c._snprintf(buf, 64, "%5.2f|%-4d|%x", 2.5, 7, 255);
    c.printf("snprintf %d [%s]\n", n, buf);
    c.fflush(null);
    return 3;
}
