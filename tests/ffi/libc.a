// calling the C library: printf (... with doubles), strlen, qsort with an A comparison function, getenv, libm
a_module c {
extern "libc.so.6" {
    int printf(char* fmt, ...);
    uint64_t strlen(char* s);
    void qsort(void* base, uint64_t n, uint64_t size, void* cmp);
    char* getenv(char* name);
    int snprintf(char* buf, uint64_t n, char* fmt, ...);
    void* malloc(uint64_t n);
    void free(void* p);
}
}
a_module m {                            // (A's cmath already uses the <math.h> names: the C ones go in a namespace)
    extern "libm.so.6" {
        double cos(double x);
        double pow(double x, double y);
        float sqrtf(float x);
        double ldexp(double x, int e);
    }
}
extern "C" int cmp_desc(int32_t* a, int32_t* b) { return *b - *a; }
int main() {
    c.printf("hello %s %d %.3f %ld %c\n", "from A", 42, 3.14159, 1234567890123, 65);
    c.printf("strlen %lu\n", c.strlen("Aytict"));
    int32_t* v = c.malloc(5 * 4);
    v[0] = 3; v[1] = 9; v[2] = -2; v[3] = 7; v[4] = 0;
    c.qsort(v, 5, 4, cmp_desc);
    c.printf("sorted %d %d %d %d %d\n", v[0], v[1], v[2], v[3], v[4]);
    c.free(v);
    c.printf("cos(0)=%g pow(2,10)=%g sqrtf(2)=%.6f ldexp(1,-3)=%g\n", m.cos(0.0), m.pow(2, 10), m.sqrtf(2), m.ldexp(1, -3));
    char buf[64];
    int n = c.snprintf(buf, 64, "%5.2f|%-4d|%x", 2.5, 7, 255);
    c.printf("snprintf %d [%s]\n", n, buf);
    print("A's own print still works\n");
    c.printf("no newline at the end, flushed by exit");
    return 3;
}
