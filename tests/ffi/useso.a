// loads an A shared library with dlopen and calls its exported functions
a_module c {
extern "libc.so.6" {
    void* dlopen(char* file, int mode);
    void* dlsym(void* handle, char* name);
    char* dlerror();
}
}
extern "C" {
    int64_t add(int64_t a, int64_t b);
    double hyp(double x, double y);
    char* greet();
    int osum();
    int ncalls();
}
int main(int argc, char** argv) {
    void* h = c.dlopen(argv[1], 2);
    if (h == null) { print(c.dlerror()); println(""); return 1; }
    add = c.dlsym(h, "a_add"); hyp = c.dlsym(h, "a_hyp"); greet = c.dlsym(h, "a_greeting");
    osum = c.dlsym(h, "a_origin_sum"); ncalls = c.dlsym(h, "a_calls");
    printInt(add(40, 2)); print(" "); printDouble(hyp(3, 4)); print(" "); print(greet()); print(" ");
    printInt(osum()); print(" "); printInt(ncalls()); println("");
    return 0;
}
