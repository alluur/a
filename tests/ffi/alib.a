// a shared library written in A: its extern "C" functions are exported
struct Point { int x; int y; }
Point origin = {3, 4};
char* greeting = "hello from an A library";
int calls;
extern "C" {
    int64_t a_add(int64_t a, int64_t b) { calls++; return a + b; }
    double a_hyp(double x, double y) { calls++; return x * x + y * y; }
    char* a_greeting() { calls++; return greeting; }
    int a_origin_sum() { calls++; return origin.x + origin.y; }
    int a_calls() { return calls; }
    int a_strlen(char* s) { int n = 0; while (s[n] != 0) n++; return n; }
}
