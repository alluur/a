import collections;

int main() {
    collections.IntQueue q;
    for (int i = 0; i < 20; i++) q.push(i);
    printlnInt(q.size()); printlnInt(q.peek());
    for (int i = 0; i < 15; i++) q.pop();
    for (int i = 100; i < 110; i++) q.push(i);            // wraps around the ring buffer
    printlnInt(q.size());
    int sum = 0; while (!q.isEmpty()) sum = sum + q.pop();
    printlnInt(sum); printlnInt(q.pop()); printlnInt(q.peek());

    collections.IntSet s;
    for (int i = 0; i < 100; i++) s.add(i % 10);
    printlnInt(s.size()); printBool(s.has(3)); printBool(s.has(30)); printBool(s.remove(3)); printBool(s.remove(3)); printBool(s.has(3)); println("");
    int total = 0;
    for (int slot = 0; slot < s.capacity(); slot++) { if (s.usedAt(slot)) total = total + s.valueAt(slot); }
    printlnInt(total);

    collections.StrSet ss;
    ss.add("red"); ss.add("green"); ss.add("red"); ss.add("blue");
    printlnInt(ss.size()); printBool(ss.has("green")); printBool(ss.has("pink")); printBool(ss.remove("red")); printlnInt(ss.size());

    collections.IntHeap h;
    int vals[12]; vals[0]=9; vals[1]=4; vals[2]=7; vals[3]=1; vals[4]=8; vals[5]=3; vals[6]=3; vals[7]=-5; vals[8]=100; vals[9]=0; vals[10]=42; vals[11]=-5;
    for (int i = 0; i < 12; i++) h.push(vals[i]);
    printlnInt(h.size()); printlnInt(h.peek());
    while (!h.isEmpty()) { printInt(h.pop()); print(" "); }
    println(""); printlnInt(h.pop());
    // a big heap sorts
    collections.IntHeap big;
    srand(3);
    for (int i = 0; i < 3000; i++) big.push(rand() % 10000);
    int prev = -1; bool sorted = true;
    while (!big.isEmpty()) { int v = big.pop(); if (v < prev) sorted = false; prev = v; }
    printBool(sorted); println("");

    collections.PriorityQueue pq;
    pq.push(5, 50); pq.push(1, 10); pq.push(3, 30); pq.push(2, 20); pq.push(4, 40);
    printlnInt(pq.peekPriority());
    while (!pq.isEmpty()) { printInt(pq.pop()); print(" "); }
    println("");
    return 0;
}
