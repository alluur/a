import random;
import decimal;
int main() {
    random.Random r(12345);
    for (int i = 0; i < 5; i++) { printlnInt(r.next()); }
    random.Random r2(12345);
    printlnInt(r2.next());
    printlnInt(r.range(1, 6)); printlnInt(r.range(-10, 10)); printlnInt(r.range(5, 5));
    int a[6]; for (int i = 0; i < 6; i++) a[i] = i;
    r.shuffle(a, 6);
    for (int i = 0; i < 6; i++) printInt(a[i]);
    println("");
    println(r.token(12));
    random.Random z(0); printlnInt(z.next());
    int ones = 0; for (int i = 0; i < 1000; i++) { if (r.chance(30)) ones++; }
    printBool(ones > 200 && ones < 400); println("");

    printlnInt(decimal.parse("12.345", 2)); printlnInt(decimal.parse("-0.005", 2)); printlnInt(decimal.parse("7", 3)); printlnInt(decimal.parse("1.5", 0));
    printlnInt(decimal.parse("abc", 2)); printlnInt(decimal.parse(".5", 1)); printBool(decimal.isValid("1.")); printBool(decimal.isValid("")); println("");
    println(decimal.format(1234, 2)); println(decimal.format(-5, 2)); println(decimal.format(7, 3)); println(decimal.format(-1999, 0)); println(decimal.format(0, 2));
    println(decimal.format(-9223372036854775807 - 1, 2));
    printlnInt(decimal.mul(1250, 300, 2)); printlnInt(decimal.mul(-1250, 333, 2)); printlnInt(decimal.div(1000, 300, 2)); printlnInt(decimal.div(-100, 300, 2));
    printlnInt(decimal.rescale(1234, 2, 4)); printlnInt(decimal.rescale(1235, 2, 1)); printlnInt(decimal.rescale(-1235, 2, 1));
    printlnInt(decimal.percentOf(20000, 15, 0)); printlnInt(decimal.percentOf(1999, 250, 1));
    println(decimal.formatMoney(123456789)); println(decimal.formatMoney(-5)); println(decimal.formatMoney(100000)); println(decimal.formatMoney(99999));
    return 0;
}
