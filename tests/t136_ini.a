import cstdio;
import ini;

int main() {
    ini.Ini* c = ini.parse("; settings\ntop = 1\n[server]\nport = 8080\nname = \"my ; site\"  ; the name\nhost=example.org # comment\ndebug = yes\n\n[ui]\ntheme=dark\nsize = -12\n");
    printf("top: %s\n", c->get("", "top", "?"));
    printf("port: %d\n", c->getInt("server", "port", 80));
    printf("name: [%s]\n", c->get("server", "name", "?"));
    printf("host: [%s]\n", c->get("server", "host", "?"));
    printf("debug: %d\n", c->getBool("server", "debug", false));
    printf("size: %d\n", c->getInt("ui", "size", 0));
    printf("missing: %s %d %d\n", c->get("ui", "none", "fallback"), c->getInt("ui", "none", 7), c->getBool("ui", "none", true));
    printf("theme is not a number: %d\n", c->getInt("ui", "theme", 99));
    c->set("ui", "theme", "light");
    c->set("new", "k", " padded ");
    c->remove("server", "host");
    printf("%s", c->toString());
    ini.Ini* d = ini.parse(c->toString());
    printf("round trip: %s %s %d\n", d->get("ui", "theme", "?"), d->get("new", "k", "?"), d->count == c->count);
    return 0;
}
