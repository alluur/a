// gcode.CodeEditor with the mouse: click, double and triple click, drag, Shift+click, Ctrl+click, Alt+drag, wheel, scroll bars, gutter, context menu
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.CodeEditor* e;
gui.Window* w;

void show(char* label) {
    printf("%s: caret %d", label, e->ed->caret());
    for (int i = 0; i < e->ed->ncur; i++) {
        if (e->ed->hasSelection(i)) {
            char* t = e->ed->selectedText(i);
            printf(" [%s]", t);
            asys.free(t);
        }
    }
    if (e->ed->ncur > 1) { printf(" cursors %d", e->ed->ncur); }
    printf("\n");
}

// click so that the caret lands before the character at byte offset off
void clickOff(int off, int mods) {
    int px = 0;
    int py = 0;
    if (!e->pointOfOffset(off, &px, &py)) { printf("offset %d not visible\n", off); return; }
    if ((mods & adp.MOD_SHIFT) != 0) { hb->keyDown(adp.KEY_SHIFT, 0); }
    if ((mods & adp.MOD_CTRL) != 0) { hb->keyDown(adp.KEY_CTRL, 0); }
    clickWd(w, e, px - 3, py);
    if ((mods & adp.MOD_CTRL) != 0) { hb->keyUp(adp.KEY_CTRL, 0); }
    if ((mods & adp.MOD_SHIFT) != 0) { hb->keyUp(adp.KEY_SHIFT, 0); }
    settle();
}

void dragOff(int from, int to) {
    int x0 = 0; int y0 = 0; int x1 = 0; int y1 = 0;
    e->pointOfOffset(from, &x0, &y0);
    e->pointOfOffset(to, &x1, &y1);
    dragWd(w, e, x0 - 3, y0, x1 - 3, y1);
}

int main() {
    startServer(7341, "t241");
    w = d->createWindow("Editor", 640, 400, 0);
    e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    e->setText("hello world\nsecond line\nthird");
    settle();
    printf("cell %d x %d, gutter %d\n", e->cellWidth(), e->lineHeight(), e->gutterWidth());

    // a click puts the caret between characters; past the end of a line it goes to the end; below the text to the end of the text
    clickOff(3, 0);
    show("click at 3");
    clickOff(18, 0);
    show("click at 18");
    clickWd(w, e, 400, 20);
    show("click right of line 2");
    clickWd(w, e, 100, 300);
    show("click below the text");
    clickWd(w, e, 54, 8);
    show("click at the left edge of the text");

    // double click selects a word, triple click the line, a fourth click starts over
    e->doubleClickMs = 100000;
    clickOff(7, 0);
    clickOff(7, 0);
    show("double click");
    clickOff(7, 0);
    show("triple click");
    clickOff(7, 0);
    show("fourth click");
    e->doubleClickMs = 0;
    clickOff(7, 0);
    clickOff(7, 0);
    show("two clicks, doubleClickMs = 0");
    e->doubleClickMs = 100000;

    // dragging selects; so do Shift+click, and dragging after a double click goes word by word
    dragOff(2, 9);
    show("drag 2 to 9");
    dragOff(9, 2);
    show("drag 9 to 2");
    dragOff(4, 17);
    show("drag over two lines");
    clickOff(2, 0);
    clickOff(9, adp.MOD_SHIFT);
    show("shift+click");
    clickOff(7, 0);
    int x0 = 0; int y0 = 0; int x1 = 0; int y1 = 0;
    e->pointOfOffset(7, &x0, &y0);
    e->pointOfOffset(15, &x1, &y1);
    hb->buttonDown(1);
    settle();
    hb->moveTo(screenX(w, e, x1 - 3), screenY(w, e, y1));
    settle();
    hb->buttonUp(1);
    settle();
    show("double click, then drag keeps whole words");

    // Ctrl+click adds a caret
    clickOff(1, 0);
    clickOff(12, adp.MOD_CTRL);
    show("ctrl+click");
    key(adp.KEY_ESCAPE, 27);

    // Alt+drag: a rectangular selection
    e->setText("abcdef\nghijkl\nmnopqr");
    settle();
    int ax = 0; int ay = 0; int bx = 0; int by = 0;
    e->pointOfOffset(1, &ax, &ay);
    e->pointOfOffset(7 + 7 + 3, &bx, &by);
    hb->keyDown(adp.KEY_ALT, 0);
    dragWd(w, e, ax - 3, ay, bx - 3, by);
    hb->keyUp(adp.KEY_ALT, 0);
    settle();
    show("alt+drag");
    key(adp.KEY_DELETE, 127);
    char* t = e->getText();
    printf("after delete [%s]\n", t);
    asys.free(t);
    key(adp.KEY_ESCAPE, 27);

    // the gutter: the number selects the line, a drag selects lines, the left strip sets a bookmark
    e->setText("l1\nl2\nl3\nl4\nl5");
    settle();
    int gx = 0; int gy = 0;
    e->gutterPoint(1, &gx, &gy);
    clickWd(w, e, gx, gy);
    show("gutter click on line 2");
    int g3 = 0; int g4 = 0;
    e->gutterPoint(3, &g3, &g4);
    dragWd(w, e, gx, gy, g3, g4);
    show("gutter drag lines 2 to 4");
    clickWd(w, e, 6, gy);
    printf("bookmark on line 2: %d, line 3: %d\n", e->doc->hasBookmark(1), e->doc->hasBookmark(2));
    clickWd(w, e, 6, gy);
    printf("bookmark on line 2 after the second click: %d\n", e->doc->hasBookmark(1));

    // the wheel and the scroll bars
    char* big = (char*) asys.alloc(40000);
    int n = 0;
    for (int i = 1; i <= 300; i++) {
        n = n + format(&big[n], 200, "line number %d of the long text, which is not short at all%s\n", i, (i % 100 == 0) ? " and this one goes on and on and on and on and on and on and on and on and on and on" : "");
    }
    e->setText(big);
    asys.free(big);
    settle();
    printf("first line %d, rows %d\n", e->firstLine(), e->visibleRows());
    wheelWd(w, e, 200, 100, -1);
    printf("after one notch down: first line %d\n", e->firstLine());
    wheelWd(w, e, 200, 100, 2);
    printf("after two notches up: first line %d\n", e->firstLine());
    wheelWd(w, e, 200, 100, -100);
    printf("after a lot of notches down: first line %d (last possible %d)\n", e->firstLine(), 301 - e->visibleRows());
    wheelWd(w, e, 200, 100, 100);
    printf("back at the top: first line %d\n", e->firstLine());
    // the thumb of the vertical bar: drag it half way down
    int barX = e->w - 7;
    dragWd(w, e, barX, 10, barX, 10 + (e->h - 14) / 2);
    printf("thumb dragged half way: first line %d\n", e->firstLine());
    // a click below the thumb scrolls one page
    int before = e->firstLine();
    clickWd(w, e, barX, e->h - 20);
    printf("click in the track below the thumb: moved %d lines (page %d)\n", e->firstLine() - before, e->visibleRows() - 1);
    // sideways: Shift+wheel and the horizontal bar
    hb->keyDown(adp.KEY_SHIFT, 0);
    wheelWd(w, e, 200, 100, -3);
    hb->keyUp(adp.KEY_SHIFT, 0);
    printf("shift+wheel: first column %d\n", e->firstCol());
    e->setFirstCol(0);
    int barY = e->h - 7;
    dragWd(w, e, e->gutterWidth() + 20, barY, e->gutterWidth() + 120, barY);
    printf("horizontal thumb dragged 100 pixels: first column %d\n", e->firstCol());
    clickWd(w, e, e->gutterWidth() + 10, barY);
    printf("click in the track left of the thumb: first column %d\n", e->firstCol());
    e->setFirstCol(1000);
    printf("first column is limited to %d\n", e->firstCol());

    // dragging below the text scrolls the view
    e->setFirstLine(0);
    e->setFirstCol(0);
    settle();
    clickOff(0, 0);
    int sx = 0; int sy = 0;
    e->pointOfOffset(0, &sx, &sy);
    hb->moveTo(screenX(w, e, sx), screenY(w, e, sy));
    hb->buttonDown(1);
    settle();
    hb->moveTo(screenX(w, e, sx + 100), screenY(w, e, e->h - 14 + 40));
    settle();
    hb->buttonUp(1);
    settle();
    printf("drag below the text: the view scrolled %d, something selected %d\n", e->firstLine() > 0, e->ed->anySelection());

    // the context menu
    e->setText("alpha beta");
    settle();
    clickOff(2, 0);
    rightClickWd(w, e, 100, 8);
    printf("popup open %d\n", w->popup != null);
    key(adp.KEY_ESCAPE, 27);
    printf("popup open after Esc %d\n", w->popup != null);
    dragOff(0, 5);
    int rx = 0; int ry = 0;
    e->pointOfOffset(2, &rx, &ry);
    rightClickWd(w, e, rx, ry);
    show("right click inside the selection keeps it");
    key(adp.KEY_ESCAPE, 27);
    e->pointOfOffset(8, &rx, &ry);
    rightClickWd(w, e, rx, ry);
    show("right click outside moves the caret");
    // pick Select All with the keyboard: Undo, Redo and Cut are disabled here, so Copy, Paste and Select All are the first three
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_ENTER, 13);
    show("menu: Select All");
    printf("popup open %d\n", w->popup != null);
    return 0;
}
