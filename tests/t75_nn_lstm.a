// neural networks: an LSTM that remembers the first symbol of a sequence
import nn;
import fixed;
int main() {
    int ONE = fixed.ONE;
    fixed.seed(5);
    // remember the first symbol: two sequences of length 6, the class is shown only at step 0
    nn.LSTM* net = new nn.LSTM(2, 6, 2);
    net->softmaxOut = true;
    int xs[24]; int ts[24];
    for (int s = 0; s < 2; s++) {
        for (int t = 0; t < 6; t++) {
            for (int k = 0; k < 2; k++) {
                xs[s*12 + t*2 + k] = (t == 0 && k == s) ? ONE : 0;
                ts[s*12 + t*2 + k] = (k == s) ? ONE : 0;
            }
        }
    }
    int l = 0;
    for (int e = 0; e < 300; e++) {
        l = net->trainSequence(&xs[0], &ts[0], 6, fixed.fromText("0.5"));
        l = l + net->trainSequence(&xs[12], &ts[12], 6, fixed.fromText("0.5"));
    }
    fixed.putln(l, 3);
    int ys[12];
    for (int s = 0; s < 2; s++) {
        net->run(&xs[s*12], 6, ys);
        printInt(nn.argmax(&ys[10], 2));
    }
    println("");
    return 0;
}
