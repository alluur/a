module geometry;

const PI_TIMES_100 = 314;

enum Shape { Circle, Square }

struct Vec {
    int x;
    int y;
}

public int dot(Vec* a, Vec* b) {
    return a->x * b->x + a->y * b->y;
}

public Vec* make(int x, int y) {
    Vec* v = new Vec;
    v->x = x; v->y = y;
    return v;
}

private int helper(int x) { return x * 1000; }

public int viaHelper(int x) { return helper(x) + 1; }

public class Box {
    private int w;
    private int h;
    public Box(int w, int h) { this.w = w; this.h = h; }
    public int area() { return w * h; }
}
