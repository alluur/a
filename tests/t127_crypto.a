    if (!aes.open(aes.gcm(k, kl), iv, aad, al, ct, cl, out)) { return "rejected"; }
    return secure.toHex(out, cl - 16);
}

char* ccSeal(char* keyHex, char* ivHex, char* aadHex, char* ptHex) {
