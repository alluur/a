    char* s = unhex(sigHex, &sl);
    return rsa.verifyPss(n, nl, e, el, bits, d, s, sl);
}

bool ecVerify(int bits, char* pubHex, char* digestHex, char* rHex, char* sHex) {
    int pl = 0; int dl = 0; int rl = 0; int sl = 0;
