char* dig(int bits, char* hexData, int n) {
    int len = 0;
    char* d = unhex(hexData, &len);
    char out[64];
    int hl = hash.digest(bits, d, len, &out[0]);
    return secure.toHex(&out[0], hl);
}

char* mac(int bits, char* keyHex, char* msgHex) {
