import os;
import sort;

int main() {
    char* cwd = os.getCwd();
    printBool(cwd != null && strlen(cwd) > 3); println("");
    writeFile("build/tests/os_a.txt", "hello");
    printlnInt(os.fileSize("build/tests/os_a.txt"));
    printlnInt(os.fileSize("build/tests/definitely_missing.txt"));
    fileDelete("build/tests/os_b.txt");
    printBool(os.rename("build/tests/os_a.txt", "build/tests/os_b.txt")); println("");
    printBool(fileExists("build/tests/os_a.txt")); printBool(fileExists("build/tests/os_b.txt")); println("");
    fileDelete("build/tests/os_b.txt");
    char* names[16];
    int n = os.listDir("tests/modules", names, 16);
    printlnInt(n);
    sort.sortStrings(names, n);
    for (int i = 0; i < n; i++) { print(names[i]); print(" "); }
    println("");
    printlnInt(os.fileSize("tests/modules"));                // a directory is not a file
    printlnInt(os.listDir("tests/no_such_dir", names, 16));
    return 0;
}
