// tui: a modal dialog shuts out mouse clicks on everything below it (other dialogs included), while a popup above a dialog still gets its clicks
import tui;
import tuix;
import term;

tui.App* app;

tui.Dialog* makeDialog(char* title, char* text) {
    tui.Label* l = new tui.Label(text);
    tui.Dialog* d = new tui.Dialog(title, l);
    d->addButton("&OK", 1, true);
    d->addButton("&Cancel", 0);
    return d;
}

// the screen position of the middle of a button
int btnX(tui.Dialog* d, int i) { tui.Widget* b = d->buttons->kids[i]; return b->absX() + b->w / 2; }
int btnY(tui.Dialog* d, int i) { tui.Widget* b = d->buttons->kids[i]; return b->absY(); }

bool inside(tui.Dialog* d, int x, int y) { return x >= d->x && x < d->x + d->w && y >= d->y && y < d->y + d->h; }

int main() {
    app = new tui.App();
    app->initHeadless(80, 24);
    tui.Label* back = new tui.Label("the program behind the dialogs");
    app->setRoot(back);
    app->pump(0);

    println("-- a modal dialog on top of another modal dialog");
    tui.Dialog* a = makeDialog("Lower", "A wide lower dialog with a long line of text in it so that it is much larger than the upper one\n\n\n\n\n\n\n\nand it is tall");
    app->showDialog(a);
    tui.Dialog* b = makeDialog("Upper", "Small");
    app->showDialog(b);
    app->pump(0);
    printf("overlays: %d, the upper dialog has the focus: %d\n", app->nov, app->focus == b->buttons->kids[0]);
    printf("the lower dialog is wider and taller: %d, its buttons are outside the upper dialog: %d\n", a->w > b->w && a->h > b->h, !inside(b, btnX(a, 0), btnY(a, 0)) && !inside(b, btnX(a, 1), btnY(a, 1)));
    app->click(btnX(a, 1), btnY(a, 1));                                 // the lower dialog's Cancel button
    printf("click on the lower dialog's button: overlays %d, lower still open %d (result %d), focus still on the upper dialog %d\n", app->nov, a->open, a->result, app->focus != null && b->contains(app->focus));
    app->click(a->x + 2, a->y);                                          // its title bar
    printf("click on the lower dialog's title: overlays %d, focus still on the upper dialog %d\n", app->nov, app->focus != null && b->contains(app->focus));
    app->click(0, 0);                                                    // outside both
    printf("click outside both: overlays %d\n", app->nov);
    app->click(btnX(b, 1), btnY(b, 1));                                  // the upper dialog's Cancel button works
    printf("click on the upper dialog's Cancel: overlays %d, upper open %d, lower open %d\n", app->nov, b->open, a->open);
    app->click(btnX(a, 0), btnY(a, 0));                                  // now the lower dialog is on top: its OK button works
    printf("click on the lower dialog's OK: overlays %d, result %d\n", app->nov, a->result);

    println("-- a popup above a modal dialog still gets its clicks");
    tui.Dialog* c = makeDialog("Dialog", "A dialog with a popup menu above it");
    app->showDialog(c);
    tui.Dialog* p = makeDialog("Popup", "Not modal");
    p->fit();
    app->centerOverlay(p);
    p->open = true;
    app->showOverlay(p, false);
    app->pump(0);
    printf("overlays: %d\n", app->nov);
    app->click(btnX(p, 0), btnY(p, 0));
    printf("click on the popup's OK: overlays %d, popup open %d\n", app->nov, p->open);
    app->click(btnX(c, 1), btnY(c, 1));
    printf("click on the dialog's Cancel: overlays %d, dialog open %d\n", app->nov, c->open);

    println("-- a click on the program behind a modal dialog is swallowed");
    tui.Dialog* d = makeDialog("Modal", "Modal");
    app->showDialog(d);
    app->click(0, 0);
    printf("overlays: %d, dialog open %d, focus in the dialog %d\n", app->nov, d->open, app->focus != null && d->contains(app->focus));
    app->press("Esc");
    printf("Esc closes it: overlays %d\n", app->nov);
    return 0;
}
