// strx: dispose() and every function give all their memory back (asys.memInUse is the same before and after), repeated use does not grow
import cstdio;
import cstring;
import asys;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 77;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

char text[2000];
char pat[40];

void fillText(int n, int alpha) {
    for (int i = 0; i < n; i++) { text[i] = 'a' + rnd(alpha); }
    text[n] = 0;
}

void matchers() {
    int before = asys.memInUse();
    for (int round = 0; round < 40; round++) {
        fillText(1500, 3);
        int m = 2 + rnd(30);
        for (int i = 0; i < m; i++) { pat[i] = 'a' + rnd(3); }
        pat[m] = 0;
        strx.Kmp k(&pat[0], m);
        strx.Horspool h(&pat[0], m);
        strx.RabinKarp r(&pat[0], m, round);
        int a = k.count(&text[0]);
        int b = h.count(&text[0]);
        int c = r.count(&text[0]);
        if (a != b || b != c) { check(false, "matchers disagree"); }
        k.dispose(); h.dispose(); r.dispose();
        strx.indexOf(&text[0], &pat[0]);
        strx.countOf(&text[0], &pat[0]);
        int out[4];
        strx.findAll(&text[0], &pat[0], &out[0], 4);
    }
    check(asys.memInUse() == before, "Kmp, Horspool, RabinKarp and the one-shot searches leave nothing behind");
    // the nasty text makes indexOf switch to KMP: that path frees too
    char* nasty = alloc(3000);
    memset(nasty, 'a', 2999);
    char* np = alloc(70);
    memset(np, 'a', 69);
    np[0] = 'b';
    int mid = asys.memInUse();
    strx.indexOf(nasty, np, 0, 2999, 69);
    check(asys.memInUse() == mid, "indexOf: the fallback to KMP frees its table");
}

void automaton() {
    int before = asys.memInUse();
    for (int round = 0; round < 20; round++) {
        strx.AhoCorasick ac;
        for (int i = 0; i < 200; i++) {
            int m = 2 + rnd(6);
            for (int j = 0; j < m; j++) { pat[j] = 'a' + rnd(4); }
            ac.add(&pat[0], m);
        }
        fillText(1000, 4);
        ac.count(&text[0]);
        for (int i = 0; i < 20; i++) { pat[0] = 'a' + rnd(4); pat[1] = 'a' + rnd(4); pat[2] = 'a' + rnd(4); pat[3] = 'a' + rnd(4); ac.add(&pat[0], 4); ac.count(&text[0]); }
        ac.dispose();
    }
    check(asys.memInUse() == before, "AhoCorasick: nothing left after 20 rounds of add, build, search, dispose");
    // dispose twice, use after dispose
    strx.AhoCorasick a2;
    a2.add("x");
    a2.dispose();
    a2.dispose();
    check(a2.count("xx") == 0 && a2.add("x") == 0 && a2.count("xx") == 2, "dispose twice, then reuse");
    a2.dispose();
    check(asys.memInUse() == before, "AhoCorasick: nothing left after the reuse");
    // a refused pattern (node limit) does not leak or leave nodes behind
    strx.AhoCorasick lim(false, 6);
    lim.add("abcde");
    int nodes = lim.nodeTotal();
    for (int i = 0; i < 50; i++) { lim.add("qrstuvwx", -1); }
    check(lim.nodeTotal() == nodes, "refused patterns add no node");
    lim.dispose();
    check(asys.memInUse() == before, "AhoCorasick with a node limit: nothing left");
}

void suffixes() {
    int before = asys.memInUse();
    for (int round = 0; round < 25; round++) {
        fillText(1000 + rnd(500), 2 + rnd(3));
        strx.SuffixArray sa(&text[0]);
        sa.count("ab");
        sa.lcpOf(3, 40);
        sa.longestRepeat(null);
        sa.distinctSubstrings();
        int out[8];
        sa.findAll("a", 1, &out[0], 8);
        sa.dispose();
        char other[200];
        for (int i = 0; i < 199; i++) { other[i] = 'a' + rnd(3); }
        other[199] = 0;
        strx.longestCommonSubstring(&text[0], -1, &other[0], -1);
        strx.longestCommonSubstring(&text[0], -1, &other[0], -1, null, null, true);
    }
    check(asys.memInUse() == before, "SuffixArray and longestCommonSubstring leave nothing behind");
}

void distances() {
    int before = asys.memInUse();
    char a[60];
    char b[60];
    for (int round = 0; round < 60; round++) {
        int na = rnd(50);
        int nb = rnd(50);
        for (int i = 0; i < na; i++) { a[i] = 'a' + rnd(4); }
        for (int i = 0; i < nb; i++) { b[i] = 'a' + rnd(4); }
        for (int u = 0; u < 2; u++) {
            bool utf8 = (u == 1);
            strx.levenshtein(&a[0], na, &b[0], nb, utf8);
            strx.levenshteinMax(&a[0], na, &b[0], nb, 3, utf8);
            strx.levenshteinSimilarity(&a[0], na, &b[0], nb, utf8);
            strx.osa(&a[0], na, &b[0], nb, utf8);
            strx.damerau(&a[0], na, &b[0], nb, utf8);
            strx.hamming(&a[0], na, &b[0], nb, utf8);
            strx.jaro(&a[0], na, &b[0], nb, utf8);
            strx.jaroWinkler(&a[0], na, &b[0], nb, utf8);
            strx.diceBigrams(&a[0], na, &b[0], nb, utf8);
            strx.jaccardQgrams(&a[0], na, &b[0], nb, 3, utf8);
            strx.cosineQgrams(&a[0], na, &b[0], nb, 2, utf8);
            strx.lcsLength(&a[0], na, &b[0], nb, utf8);
            int len = 0;
            char* l = strx.lcs(&a[0], na, &b[0], nb, &len, utf8);
            strx.freeText(l);
            strx.longestPalindrome(&a[0], na, null, utf8);
            strx.countPalindromes(&a[0], na, utf8);
            strx.isPalindrome(&a[0], na, utf8);
        }
        int d1[60]; int d2[60];
        strx.manacher(&a[0], na, &d1[0], &d2[0]);
        strx.period(&a[0], na);
    }
    check(asys.memInUse() == before, "all the distance, similarity, lcs and palindrome functions leave nothing behind");
}

void diffs() {
    int before = asys.memInUse();
    char* pool[6] = { "a", "b", "c", "d", "e", "f" };
    char* x[40];
    char* y[40];
    strx.LineDiff d;
    for (int round = 0; round < 60; round++) {
        int nx = rnd(40);
        int ny = rnd(40);
        for (int i = 0; i < nx; i++) { x[i] = pool[rnd(6)]; }
        for (int i = 0; i < ny; i++) { y[i] = pool[rnd(6)]; }
        d.run(&x[0], nx, &y[0], ny, (round % 3 == 0) ? 5 : 8000);
        char* u = d.unified("x", "y", 2);
        strx.freeText(u);
    }
    d.runText("one\ntwo\n", "one\nthree\n");
    d.runText("x\ny\n", "x\ny\nz\n");
    d.dispose();
    d.dispose();
    int n = 0;
    char** l = strx.splitLines("a\nb\nc\n", -1, &n);
    strx.freeText((char*) l);
    check(asys.memInUse() == before, "LineDiff (run, runText, unified, dispose) and splitLines leave nothing behind");
}

void fuzzy() {
    int before = asys.memInUse();
    char* items[5] = { "src/main.a", "lib/strx.a", "README.md", "a long long long path/with/many/segments/and/words.txt", "x" };
    for (int round = 0; round < 30; round++) {
        strx.FuzzyMatcher f("ma");
        int idx[5];
        f.rank(&items[0], 5, &idx[0], 5, null);
        int pos[4];
        f.score(items[3], -1, &pos[0]);
        f.dispose();
        strx.fuzzyScore("sx", "lib/strx.a");
    }
    // growing candidates: the scratch is replaced, not leaked
    strx.FuzzyMatcher g("ab");
    char* big = asys.alloc(6000);
    for (int len = 10; len <= 5000; len = len * 3) {
        memset(big, 'a', len);
        big[len - 1] = 'b';
        big[len] = 0;
        g.score(big, -1, null);
    }
    g.dispose();
    asys.free(big);
    check(asys.memInUse() == before, "FuzzyMatcher leaves nothing behind, also with growing candidates");
}

void repeated() {
    // the same object used a thousand times keeps a constant footprint
    strx.AhoCorasick ac;
    ac.add("needle");
    strx.FuzzyMatcher f("nd");
    strx.LineDiff d;
    char* l1[3] = { "a", "b", "c" };
    char* l2[3] = { "a", "x", "c" };
    d.run(&l1[0], 3, &l2[0], 3);
    f.score("needle", -1, null);
    fillText(500, 3);
    ac.count(&text[0]);
    int base = asys.memInUse();
    for (int i = 0; i < 1000; i++) {
        ac.count(&text[0]);
        f.score("needle in a haystack", -1, null);
        d.run(&l1[0], 3, &l2[0], 3);
        char* u = d.unified("a", "b");
        strx.freeText(u);
    }
    check(asys.memInUse() == base, "a thousand searches, scores and diffs with the same objects: constant memory");
    ac.dispose(); f.dispose(); d.dispose();
    check(asys.memBadFrees() == 0, "no bad free");
}

int main() {
    matchers();
    automaton();
    suffixes();
    distances();
    diffs();
    fuzzy();
    repeated();
    printf("memory: %d checks, %d failures\n", checks, fails);
    return fails;
}
