// x is Class (a bool) and x as Class (x or null): a run time check of the class of an object behind a pointer to a class with virtual
// methods; deep hierarchies, null pointers, objects created in every way, use in conditions and loops
class Animal {
public:
    int id;
    virtual int kind() { return 0; }
    Animal() { id = 1; }
}
class Mammal : Animal {
public:
    virtual int legs() { return 4; }
    int kind() { return 1; }
}
class Dog : Mammal {
public:
    char* name;
    Dog() { name = "dog"; }
    int kind() { return 2; }
    int bark() { return 100 + id; }
}
class Puppy : Dog {
public:
    int kind() { return 3; }
    int bark() { return 1; }
}
class Cat : Mammal {
public:
    int kind() { return 4; }
    int meow() { return 200; }
}
class Bird : Animal {
public:
    int legs() { return 2; }
    int kind() { return 5; }
}

Dog globalDog;                                  // objects get their class from the vtable pointer wherever they live
Cat globalCat;

int classify(Animal* a) {
    int r = 0;
    if (a is Mammal) { r += 1; }
    if (a is Dog) { r += 10; }
    if (a is Puppy) { r += 100; }
    if (a is Cat) { r += 1000; }
    if (a is Bird) { r += 10000; }
    if (a is Animal) { r += 100000; }
    return r;
}

int main() {
    Animal* zoo[7];
    zoo[0] = new Animal();
    zoo[1] = new Mammal();
    zoo[2] = new Dog();
    zoo[3] = new Puppy();
    zoo[4] = new Cat();
    zoo[5] = new Bird();
    zoo[6] = null;
    foreach (int i, Animal* a in zoo) { printInt(i); print(": "); printlnInt(classify(a)); }

    // as: the pointer itself or null
    foreach (Animal* a in zoo) {
        Dog* d = a as Dog;
        Cat* c = a as Cat;
        printInt(d != null); printInt(c != null);
        if (d) { printInt(d->bark()); }
        if (c) { printInt(c->meow()); }
        print(" ");
    }
    println("");
    // as inside a larger expression, with -> and with the star written
    printlnInt((zoo[2] as Dog)->bark() + (zoo[3] as Puppy*)->bark());
    printlnInt(zoo[2] as Dog->bark());
    Dog* maybe = zoo[4] as Dog;
    printlnInt(maybe == null);
    printlnInt((zoo[3] as Mammal)->legs());

    // locals, globals and objects on the stack
    Dog local;
    Puppy pup;
    Animal* p1 = &local;
    Animal* p2 = &pup;
    Animal* p3 = &globalDog;
    Animal* p4 = &globalCat;
    printlnInt(classify(p1)); printlnInt(classify(p2)); printlnInt(classify(p3)); printlnInt(classify(p4));
    // upcasts and the static type
    Puppy* pp = new Puppy();
    printlnInt(pp is Dog); printlnInt(pp is Animal); printlnInt(pp is Puppy);
    Dog* dp = pp;
    printlnInt(dp is Puppy); printlnInt(dp is Dog);

    // not, and, or, ?:
    int n = 0;
    foreach (Animal* a in zoo) {
        if (!(a is Mammal) && a != null) { n += 1; }
        if (a is Dog || a is Cat) { n += 10; }
        n += (a is Puppy) ? 100 : 0;
    }
    printlnInt(n);
    // a loop that picks the dogs out
    int barks = 0;
    foreach (Animal* a in zoo) {
        Dog* d = a as Dog;
        if (d != null) { barks += d->bark(); }
    }
    printlnInt(barks);
    // the result is an ordinary bool
    bool isCat = zoo[4] is Cat;
    bool isDog = zoo[4] is Mammal && !(zoo[4] is Dog);
    printlnInt(isCat); printlnInt(isDog);
    return 0;
}
