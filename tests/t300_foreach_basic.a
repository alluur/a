struct Point { int x; int y; }
struct Box { int vals[4]; Point pts[2]; char* names[3]; }
int garr[5] = {10, 20, 30, 40, 50};

int part1() {
    int a[4] = {1, 2, 3, 4};
    foreach (int x in a) { printInt(x); print(" "); }
    println("");
    foreach (int x in garr) { printInt(x); print(" "); }
    println("");
    foreach (int i, int x in a) { printInt(i * 10 + x); print(" "); }
    println("");
    foreach (int x in rev a) { printInt(x); print(" "); }
    println("");
    foreach (char c in "hello") { printChar(c); printChar('-'); }
    println("");
    foreach (int i in 0..5) { printInt(i); print(","); }
    println("");
    foreach (int i in rev 0..5) { printInt(i); print(","); }
    println("");
    foreach (i in 3..3) { print("never"); }
    foreach (i in 5..3) { print("never"); }
    foreach (i in rev 5..3) { print("never"); }
    Box b;
    b.vals[0] = 7; b.vals[3] = 9;
    foreach (v in b.vals) { printInt(v); print(" "); }
    println("");
    b.pts[0].x = 1; b.pts[0].y = 2; b.pts[1].x = 3; b.pts[1].y = 4;
    foreach (Point p in b.pts) { printInt(p.x * 10 + p.y); print(" "); }
    println("");
    foreach (Point* p in b.pts) { p->x = p->x + 100; }
    foreach (Point p in b.pts) { printInt(p.x); print(" "); }
    println("");
    b.names[0] = "a"; b.names[1] = "bb"; b.names[2] = "ccc";
    foreach (char* s in b.names) { print(s); print(";"); }
    println("");
    foreach (int i, char* s in rev b.names) { printInt(i); print(s); print(";"); }
    println("");
    int* p = a;
    foreach (int x in p, 3) { printInt(x); print(" "); }
    println("");
    foreach (int x in p, 0) { print("never"); }
    foreach (int x in p, -2) { print("never"); }
    return 0;
}

struct Rec { int8 a; int16 b; uint32 c; }
class Holder {
public:
    int items[4];
    int total;
    int sum() {
        int s = 0;
        foreach (int v in items) s += v;
        foreach (int v in this.items) s += v;
        return s;
    }
    void fill() { foreach (int* p in items) *p = 3; }
}
enum Color { Red, Green = 5, Blue }
int gcount[3] = {7, 8, 9};
int part2() {
    int8 a8[4] = {-1, -2, 3, 4};
    foreach (int8 v in a8) { printInt(v); print(" "); }
    println("");
    uint16 u16[3] = {65535, 2, 3};
    foreach (int v in u16) { printInt(v); print(" "); }
    println("");
    int32 i32[3] = {-5, 6, -7};
    foreach (int v in rev i32) { printInt(v); print(" "); }
    println("");
    uint32 u32[2] = {4000000000, 1};
    foreach (uint32 v in u32) { printInt(v); print(" "); }
    println("");
    bool bl[3] = {true, false, true};
    foreach (bool v in bl) { printInt(v); print(" "); }
    println("");
    char name[4] = "abc";
    foreach (int i, char c in name) { printInt(i); print(":"); printInt(c); print(" "); }
    println("");
    foreach (int x in (int[]){4, 5, 6}) { printInt(x); print(" "); }
    println("");
    Rec recs[2];
    recs[0].a = -3; recs[0].b = 300; recs[0].c = 70000;
    recs[1].a = 4; recs[1].b = -4; recs[1].c = 5;
    foreach (Rec r in recs) { printInt(r.a); print(","); printInt(r.b); print(","); printInt(r.c); print(" "); }
    println("");
    foreach (Rec* r in recs) { r->c = r->c + 1; }
    foreach (r in recs) { printInt(r.c); print(" "); }
    println("");
    Holder h;
    h.fill();
    printlnInt(h.sum());
    Holder* hp = &h;
    foreach (int v in hp->items) { printInt(v); }
    println("");
    foreach (int v in gcount) { printInt(v); }
    println("");
    foreach (Color c in 0..3) { printInt(c); }
    println("");
    foreach (char* p in "xyz") { printChar(*p); printChar('.'); }
    println("");
    foreach (int i, char c in rev "xyz") { printInt(i); printChar(c); }
    println("");
    foreach (c in "") { print("never"); }
    char* empty = "";
    foreach (c in empty) { print("never"); }
    // 1000 iterations stays correct
    int t = 0;
    foreach (i in 0..1000) t += i;
    printlnInt(t);
    // a variable that is also named like the iterated array
    int a[3] = {1, 2, 3};
    foreach (int a in a) { printInt(a); }
    println("");
    // rev as a variable name
    int rev[2] = {8, 9};
    foreach (int v in rev) { printInt(v); }
    println("");
    println("");
    return 0;
}

int main() {
    println("-- part 1");
    part1();
    println("-- part 2");
    part2();
    return 0;
}
