// Completion in big files: asyntax.Completer works in time linear in the number of words that share the typed prefix (it was quadratic:
// 20000 words took 10 s, 100000 lines made the editor freeze), removes duplicates across buffers and symbols/keywords/words, keeps the
// order (exact case first, symbols, keywords, words; shorter first, then alphabetical), caps what it gives out and does not scan a big
// buffer again after every single edit. The editor opens its popup for 'va' in a 30000 word document at once.
import wsrv;
import gui;
import guix;
import gcode;
import asyntax;
import acode;
import asys;
import adp;
import gfx;
import cstdlib;
#include "gcode_harness.inc"

void show(char* label, asyntax.Candidate* c, int n, int limit) {
    printf("%s: %d", label, n);
    for (int i = 0; i < n && i < limit; i++) { printf(" %s/%d/%d", c[i].text, c[i].kind, c[i].score); }
    printf("\n");
}

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;

    // ---- the model: 20000 words with the same prefix in one buffer, 6000 of them again (and some in other case) in another one
    acode.Buffer* b1 = new acode.Buffer();
    acode.Buffer* b2 = new acode.Buffer();
    int cap = 20000 * 20 + 100;
    char* t = (char*) asys.alloc(cap);
    int n = 0;
    for (int i = 0; i < 20000; i++) { n = n + format(&t[n], 24, "value%d\n", i); }
    b1->setText(t, n);
    n = 0;
    for (int i = 0; i < 6000; i++) { n = n + format(&t[n], 24, "x = value%d + Value%d;\n", i * 2, i); }
    n = n + format(&t[n], 120, "int counter = 0;\nvoid counted() { }\nint compute(int x) { return x; }\nvalue = value;\n");
    b2->setText(t, n);
    asys.free(t);
    asyntax.Completer* comp = new asyntax.Completer();
    comp->addBuffer(b1, asyntax.Lang.A);
    comp->addBuffer(b2, asyntax.Lang.A);
    asyntax.Candidate out[1100];
    int k = comp->complete("va", asyntax.Lang.A, &out[0], 12);
    show("va, 12 best", &out[0], k, 12);
    k = comp->complete("Va", asyntax.Lang.A, &out[0], 5);
    show("Va, 5 best (other case: 'value' ranks below the exact matches)", &out[0], k, 5);
    k = comp->complete("value19", asyntax.Lang.A, &out[0], 1100);
    printf("value19, up to 1100: %d candidates, first %s, last %s\n", k, out[0].text, out[k - 1].text);
    bool sorted = true;
    for (int i = 1; i < k; i++) {
        int la = strlen(out[i - 1].text);
        int lb = strlen(out[i].text);
        if (out[i - 1].score < out[i].score) { sorted = false; }
        if (out[i - 1].score == out[i].score && (la > lb || (la == lb && strcmp(out[i - 1].text, out[i].text) >= 0))) { sorted = false; }
    }
    printf("sorted by score, length, name: %d\n", sorted);
    k = comp->complete("value", asyntax.Lang.A, &out[0], 5000);
    printf("5000 asked for, at most 1024 given: %d\n", k);
    bool unique = true;
    for (int i = 0; i < k && unique; i++) {
        for (int j = i + 1; j < k; j++) { if (streq(out[i].text, out[j].text)) { unique = false; break; } }
    }
    printf("no name twice: %d\n", unique);
    k = comp->complete("value5", asyntax.Lang.A, &out[0], 0);
    printf("max 0: %d\n", k);
    k = comp->complete("value5", asyntax.Lang.A, &out[0], -3);
    printf("max -3: %d\n", k);
    k = comp->complete("", asyntax.Lang.A, &out[0], 3);
    show("empty prefix, 3 best", &out[0], k, 3);
    k = comp->complete("zzzz", asyntax.Lang.A, &out[0], 10);
    printf("nothing matches: %d\n", k);
    k = comp->complete("cou", asyntax.Lang.A, &out[0], 10);
    show("words of the second buffer", &out[0], k, 10);
    k = comp->complete("comp", asyntax.Lang.A, &out[0], 10);
    show("a symbol that is also a word is offered once, as the symbol", &out[0], k, 10);
    k = comp->complete("value19999", asyntax.Lang.A, &out[0], 10);
    printf("the prefix itself is not offered: %d\n", k);
    k = comp->complete("value1999", asyntax.Lang.A, &out[0], 10);
    show("value1999", &out[0], k, 10);

    // ---- a big buffer (1.4 MB) is scanned again after 25 edits or 2000 changed bytes, not after every key
    acode.Buffer* big = new acode.Buffer();
    int bigCap = 1400000;
    char* bt = (char*) asys.alloc(bigCap + 100);
    int bn = 0;
    while (bn < bigCap - 40) { bn = bn + format(&bt[bn], 40, "int filler%d = 1;\n", bn / 17); }
    big->setText(bt, bn);
    asys.free(bt);
    asyntax.Completer* c2 = new asyntax.Completer();
    c2->addBuffer(big, asyntax.Lang.A);
    k = c2->complete("zqw", asyntax.Lang.A, &out[0], 10);
    printf("big buffer (%d bytes): zqw finds %d\n", big->length(), k);
    big->insert(big->length(), "zqword1 ", 8);
    k = c2->complete("zqw", asyntax.Lang.A, &out[0], 10);
    printf("after one edit the cached words are used: zqw finds %d\n", k);
    for (int i = 0; i < 30; i++) { big->insert(big->length(), "z ", 2); }
    k = c2->complete("zqw", asyntax.Lang.A, &out[0], 10);
    printf("after 31 edits the buffer is scanned again: zqw finds %d (%s)\n", k, (k > 0) ? out[0].text : "-");
    char* chunk = (char*) asys.alloc(2100);
    memset(chunk, ' ', 2100);
    memcpy(&chunk[0], "zqother ", 8);
    big->insert(big->length(), chunk, 2100);
    asys.free(chunk);
    k = c2->complete("zqo", asyntax.Lang.A, &out[0], 10);
    printf("a change of 2000 bytes scans at once: zqo finds %d\n", k);
    c2->addBuffer(big, asyntax.Lang.Text);
    k = c2->complete("zqo", asyntax.Lang.Text, &out[0], 10);
    printf("a new language scans again: zqo finds %d\n", k);
    big->setText("int small = 1;\nzqfresh\n", 23);
    k = c2->complete("zq", asyntax.Lang.Text, &out[0], 10);
    printf("a buffer that became small is scanned again: zq finds %d (%s)\n", k, (k > 0) ? out[0].text : "-");

    // ---- the editor: 30000 words, Ctrl+Space after 'va'
    startServerSized(7362, "t262", 900, 600);
    gui.Window* w = d->createWindow("Big completion", 520, 320, 0);
    gcode.CodeEditor* e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    w->setRoot(col);
    w->setFocus(e);
    char* et = (char*) asys.alloc(30000 * 20 + 100);
    int en = 0;
    for (int i = 0; i < 30000; i++) { en = en + format(&et[en], 24, "int value%d;\n", i); }
    en = en + format(&et[en], 20, "va");
    e->doc->setLanguage(asyntax.Lang.A);
    e->setText(et);
    asys.free(et);
    e->gotoLine(30000, 2);
    settle();
    ctrl(' ');
    printf("editor: popup open %d, %d candidates, first %s, second %s\n", e->completionOpen(), e->completionCount(), e->completionText(0), e->completionText(1));
    key(adp.KEY_ESCAPE, 27);
    w->close();
    return 0;
}
