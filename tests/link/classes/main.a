#include "shapes.h"
import collections;

int local(int v) { return v + 1; }

int main(int argc, char** argv) {
    println(greeting());
    printlnInt(makeSquareArea(5));
    printlnInt(makeSquareArea(6));
    printlnInt(shapeCount);
    int total = 0;
    for (int i = 0; i < 5; i++) total += primes[i];
    printlnInt(total);
    Vec v;
    v.x = 3;
    v.y = 4;
    printlnDouble(vecLength2(v));
    printlnDouble(scale);
    printlnInt(apply(triple, 14));
    printlnInt(apply(local, 1));
    collections.IntList list;
    list.push(10);
    list.push(20);
    list.push(30);
    printlnInt(list.size());
    printlnInt(list.get(1));
    Square sq(7);
    printlnInt(sq.describe());
    Shape* sp = &sq;
    printlnInt(sp->area());
    printlnInt(argc);
    return 0;
}
