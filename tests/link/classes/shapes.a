#include "shapes.h"
int shapeCount = 0;
int primes[5] = {2, 3, 5, 7, 11};
double scale = 2.5;
static int privateCounter = 40;

int makeSquareArea(int s) {
    shapeCount++;
    Square sq(s);
    privateCounter++;
    return sq.describe() + privateCounter - 41;
}
double vecLength2(Vec v) { return (v.x * v.x + v.y * v.y) * scale; }
int apply(func f, int v) { return f(v); }
int triple(int v) { return v * 3; }
char* greeting() { return "hello from shapes"; }
