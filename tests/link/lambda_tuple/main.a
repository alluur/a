#include "lib.h"
int main() {
    (int q, int r) = divmod(17, 5);
    printf("%d %d\n", q, r);
    (int i, double d) = both(10);
    printf("%d %d\n", i, (int)(d * 100.0));
    func t = getTwice();
    printf("%d\n", t(21));
    printf("%d\n", applyAll(x => x * x, 4));
    printf("%d\n", applyAll(getTwice(), 4));
    return 0;
}
