#include "zoo.h"
Animal* makeLocal(int kind) {
    if (kind == 1) return new Dog();
    if (kind == 2) return new Puppy();
    if (kind == 3) return new Bird();
    return new Animal();
}
int classifyHere(Animal* a) {
    return (a is Dog ? 1 : 0) + (a is Puppy ? 2 : 0) + (a is Bird ? 4 : 0) + (a is Animal ? 8 : 0);
}
int main() {
    int bad = 0;
    for (int kind = 0; kind < 4; kind++) {
        Animal* far = make(kind);           // made in the other unit
        Animal* near = makeLocal(kind);     // made in this unit
        int a = classifyHere(far);          // tested in this unit
        int b = classify(far);              // tested in the other unit
        int c = classifyHere(near);
        int d = classify(near);
        printf("kind %d: %d %d %d %d\n", kind, a, b, c, d);
        if (a != b or b != c or c != d) bad++;
        // as: the cast result is the object or null, in both directions
        Dog* dg = far as Dog;
        Dog* dn = near as Dog;
        Bird* bg = far as Bird;
        printf("  as Dog far %d near %d, as Bird far %d\n", dg != null ? 1 : 0, dn != null ? 1 : 0, bg != null ? 1 : 0);
        if (dg != null) printf("  legs %d\n", dg->legs());
    }
    Animal* none = null;
    printf("null: %d %d\n", none is Dog ? 1 : 0, none as Dog != null ? 1 : 0);
    printf("bad %d\n", bad);
    return 0;
}
