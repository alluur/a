#include "zoo.h"
Animal* make(int kind) {
    if (kind == 1) return new Dog();
    if (kind == 2) return new Puppy();
    if (kind == 3) return new Bird();
    return new Animal();
}
int classify(Animal* a) {
    return (a is Dog ? 1 : 0) + (a is Puppy ? 2 : 0) + (a is Bird ? 4 : 0) + (a is Animal ? 8 : 0);
}
