void bubble(int* a, int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - 1 - i; j++)
            if (a[j] > a[j + 1]) { int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
}
bool isPrime(int n) {
    if (n < 2) return false;
    for (int i = 2; i * i <= n; i++) if (n % i == 0) return false;
    return true;
}
int main() {
    int a[10];
    int seed = 12345;
    for (int i = 0; i < 10; i++) { seed = (seed * 1103515245 + 12345) & 0x7fffffff; a[i] = seed % 100; }
    bubble(a, 10);
    for (int i = 0; i < 10; i++) { printInt(a[i]); print(" "); }
    println("");
    int count = 0;
    for (int n = 0; n < 1000; n++) if (isPrime(n)) count++;
    printlnInt(count);
    // sieve using the static heap
    char* sieve = alloc(100001);
    int c2 = 0;
    for (int i = 2; i <= 100000; i++) {
        if (sieve[i] == 0) { c2++; for (int j = i * 2; j <= 100000; j += i) sieve[j] = 1; }
    }
    printlnInt(c2);
    return 0;
}
