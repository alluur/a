// enum reflection: count, name, parse, has
import cstdio;

enum Color { Red, Green = 5, Blue }
enum Kind : uint8 { Text, Binary, Image = 200 }

int main() {
    printf("count %d %d\n", Color.count, Kind.count);
    printf("names: %s %s %s\n", Color.name(Color.Red), Color.name(5), Color.name(Blue));
    Color c = Color.Blue;
    printf("variable: %s, unknown: %s\n", Color.name(c), Color.name(99));
    printf("kind: %s %s\n", Kind.name(Kind.Image), Kind.name(1));
    printf("parse: %d %d %d\n", Color.parse("Green"), Color.parse("Blue", 42), Color.parse("Purple", 42));
    printf("parse default: %d\n", Color.parse("nope"));
    printf("has: %d %d %d\n", Color.has(0), Color.has(1), Color.has(Color.Blue));
    for (int i = 0; i < Color.count; i++) { }
    int total = 0;
    for (int v = 0; v < 8; v++) {
        if (Color.has(v)) { total = total + v; printf("  member %d = %s\n", v, Color.name(v)); }
    }
    printf("total %d\n", total);
    return 0;
}
