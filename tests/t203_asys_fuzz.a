// asys allocator fuzz: 6000 random alloc / realloc / free operations on up to 100 live blocks of all size classes (1 byte to 3 MB),
// checked against a pattern that every block carries: contents survive realloc (grow and shrink, small <-> big), fresh memory
// and the part added by realloc is zero, nothing overlaps, blockSize is at least what was asked, and when everything is freed the
// counters are back where they started. It runs twice: with the platform's own treatment of big blocks (unmapped when freed, except on
// Windows and AOS) and with the AOS / Windows treatment forced (asys.setKeepBigBlocks(1): freed big blocks stay in free lists and are
// reused: the AOS kernel's mmap area only grows, so unmapping would use it up). Deterministic (a fixed seed).
import asys;

int checks;
int fails;

void check(bool ok, char* what) {
    checks++;
    if (!ok) {
        fails++;
        printf("FAIL: %s\n", what);
    }
}

void checkEq(int got, int want, char* what) {
    checks++;
    if (got != want) {
        fails++;
        printf("FAIL: %s: got %d want %d\n", what, got, want);
    }
}

const SLOTS = 100;

char* blk[100];
int sz[100];
int tag[100];

int seed = 987654321;

int rnd() {
    seed = (seed * 6364136223846793005 + 1442695040888963407);
    return (seed >> 33) & 0x7FFFFFFF;
}

// a size from a mix: mostly small, some medium, a few big (blocks above 128 KiB are mapped separately)
int pickSize() {
    int r = rnd() % 100;
    if (r < 60) { return 1 + rnd() % 300; }
    if (r < 85) { return 1 + rnd() % 5000; }
    if (r < 96) { return 1 + rnd() % 70000; }
    if (r < 99) { return 100000 + rnd() % 300000; }
    return 1000000 + rnd() % 2000000;
}

int patternByte(int t, int i) {
    return (t * 31 + i * 7 + (i >> 8)) & 255;
}

void fill(int s) {
    char* p = blk[s];
    int t = tag[s];
    for (int i = 0; i < sz[s]; i++) { p[i] = patternByte(t, i); }
}

// the first n bytes carry the pattern of the tag (big blocks are sampled)
bool verify(int s, int n) {
    char* p = blk[s];
    int t = tag[s];
    int step = (n > 200000) ? 61 : 1;
    for (int i = 0; i < n; i = i + step) {
        if (p[i] != patternByte(t, i)) { return false; }
    }
    return true;
}

// bytes [from, to) are zero (big ranges are sampled)
bool zeroRange(char* p, int from, int to) {
    int step = (to - from > 200000) ? 61 : 1;
    for (int i = from; i < to; i = i + step) {
        if (p[i] != 0) { return false; }
    }
    return to <= from || p[to - 1] == 0;
}

void fuzz(char* label, int mode) {
    asys.setKeepBigBlocks(mode);
    printf("%s\n", label);
    int baseUse = asys.memInUse();
    int baseBlocks = asys.memBlocks();
    int baseMapped = asys.memMapped();
    int baseBad = asys.memBadFrees();
    bool patternsOk = true;
    bool zeroOk = true;
    bool sizeOk = true;
    bool overlapOk = true;
    int allocs = 0;
    int reallocs = 0;
    int frees = 0;
    int bigOps = 0;
    for (int op = 0; op < 6000; op++) {
        int s = rnd() % SLOTS;
        int kind = rnd() % 10;
        if (blk[s] == null) {
            if (kind < 7) {
                int n = pickSize();
                if (n > 128 * 1024) { bigOps++; if (bigOps > 12) { n = 1 + n % 5000; } }
                char* p = asys.alloc(n);
                if (p == null) { sizeOk = false; continue; }
                if (!zeroRange(p, 0, n)) { zeroOk = false; }
                if (asys.blockSize(p) < n) { sizeOk = false; }
                blk[s] = p;
                sz[s] = n;
                tag[s] = rnd() & 255;
                fill(s);
                allocs++;
            }
        } else if (kind < 5) {
            // realloc to a different size
            int n = pickSize();
            if (n > 128 * 1024) { bigOps++; if (bigOps > 12) { n = 1 + n % 5000; } }
            int old = sz[s];
            char* p = asys.realloc(blk[s], n);
            if (p == null) { sizeOk = false; continue; }
            blk[s] = p;
            int keep = (n < old) ? n : old;
            sz[s] = n;
            if (!verify(s, keep)) { patternsOk = false; }
            if (n > old && !zeroRange(p, old, n)) { zeroOk = false; }
            if (asys.blockSize(p) < n) { sizeOk = false; }
            tag[s] = rnd() & 255;
            fill(s);
            reallocs++;
        } else if (kind < 8) {
            if (!verify(s, sz[s])) { patternsOk = false; }
            asys.free(blk[s]);
            blk[s] = null;
            sz[s] = 0;
            frees++;
        } else {
            // a neighbour check: the first and last byte of every live block still carry their pattern (an overlap would break one)
            for (int j = 0; j < SLOTS; j++) {
                if (blk[j] != null && sz[j] > 0) {
                    char* p = blk[j];
                    int last = sz[j] - 1;
                    if (p[0] != patternByte(tag[j], 0) || p[last] != patternByte(tag[j], last)) { overlapOk = false; }
                }
            }
        }
    }
    check(allocs > 500 && reallocs > 500 && frees > 500, "the run did many allocations, reallocations and frees");
    check(patternsOk, "the contents of blocks survive realloc and are never disturbed");
    check(zeroOk, "fresh memory and memory added by realloc is zero, also after reuse");
    check(sizeOk, "blockSize is at least the requested size, nothing ran out of memory");
    check(overlapOk, "no two live blocks overlap");
    // everything still live is intact, then freed
    bool allIntact = true;
    int live = 0;
    for (int s = 0; s < SLOTS; s++) {
        if (blk[s] != null) {
            live++;
            if (!verify(s, sz[s])) { allIntact = false; }
            asys.free(blk[s]);
            blk[s] = null;
        }
    }
    check(allIntact && live > 10, "the blocks that were still live are intact");
    checkEq(asys.memInUse(), baseUse, "memInUse is back");
    checkEq(asys.memBlocks(), baseBlocks, "memBlocks is back");
    int grown = asys.memMapped() - baseMapped;
    if (asys.keepsBigBlocks()) {
        check(grown <= 64 * 1024 * 1024, "freed big blocks are kept for reuse: at most the blocks of the run stay mapped");
    } else {
        check(grown % 2097152 == 0 && grown <= 16 * 1024 * 1024, "only whole 2 MiB chunks of small blocks stay mapped: every big block went back to the system");
    }
    checkEq(asys.memBadFrees() - baseBad, 0, "no bad frees");
    asys.setKeepBigBlocks(0);
}

// The AOS problem in miniature: its kernel never takes mmap address space back (and allows only 32 mappings per process), so
// thousands of alloc + free cycles of a big block ran the process out of address space (alloc returned null with nothing in use).
// With kept blocks the cycles reuse one block. Two tiers exist in this mode: blocks up to a quarter of the next chunk (512 KiB at first,
// growing to 8 MiB) are carved from chunks, bigger ones are mapped on their own and kept in free lists when freed.
// (The numbers are small on purpose: every reuse zeroes the block again, and the ARM64 / RISC-V / LoongArch64 runs go through
// qemu-user, where 2.5 GB of zeroing took 100 seconds; the proof is that the cycles all get the SAME block and map nothing new.)
void keepCycle() {
    asys.setKeepBigBlocks(1);
    int base = asys.memInUse();
    int mapped0 = asys.memMapped();
    bool allOk = true;
    char* first = null;
    bool same = true;
    for (int i = 0; i < 200; i++) {
        char* p = asys.alloc(300000);
        if (p == null) { allOk = false; break; }
        if (first == null) { first = p; }
        if (p != first) { same = false; }
        p[0] = 1;
        p[299999] = 1;
        asys.free(p);
    }
    check(allOk, "200 cycles of alloc(300000) + free never fail");
    check(same, "and they all get the same block");
    check(asys.memMapped() - mapped0 <= 8 * 1024 * 1024, "so no address space is used up");
    checkEq(asys.memInUse(), base, "nothing is in use afterwards");
    char* p = asys.alloc(300000);
    p[1000] = 7;
    p[150000] = 8;
    p[299999] = 9;
    asys.free(p);
    char* q = asys.alloc(300000);
    check(q == p, "the freed block is handed out again");
    check(zeroRange(q, 0, 300000), "and it is zero (sampled: every 61st byte)");
    asys.free(q);

    // the tier of blocks with their own mapping (over the 1 MiB limit of carved blocks at this point): 4 cycles map one block
    int m1 = asys.memMapped();
    bool bigOk = true;
    char* firstBig = null;
    bool sameBig = true;
    for (int i = 0; i < 4; i++) {
        char* b = asys.alloc(12000000);
        if (b == null) { bigOk = false; break; }
        if (firstBig == null) { firstBig = b; }
        if (b != firstBig) { sameBig = false; }
        b[0] = 1;
        b[11999999] = 1;
        asys.free(b);
    }
    check(bigOk && sameBig, "4 cycles of a 12 MB block always get the same block");
    check(asys.memMapped() - m1 <= 14 * 1024 * 1024, "and map only one");
    char* big = asys.alloc(12000000);
    big[12345] = 5;
    big[11000000] = 6;
    asys.free(big);
    char* big2 = asys.alloc(12000000);
    check(big2 == big && zeroRange(big2, 0, 12000000), "a reused 12 MB block is zero again");
    // a smaller request takes a free block that is at most two size classes bigger, a much smaller one gets a block of its own
    asys.free(big2);
    int m2 = asys.memMapped();
    char* r = asys.alloc(10400000);
    check(r == big2 && asys.memMapped() == m2, "a request one size class below reuses the free block");
    check(asys.blockSize(r) >= 12000000, "(it got the bigger block)");
    asys.free(r);
    char* r2 = asys.alloc(4000000);
    check(r2 != r && asys.memMapped() > m2 && asys.blockSize(r2) < 8000000, "a request far below does not waste it: a new block");
    // growing by realloc (a text buffer doubling) keeps the content
    char* g = asys.alloc(200000);
    g[0] = 5;
    g[199999] = 6;
    g = asys.realloc(g, 2000000);
    check(g != null && g[0] == 5 && g[199999] == 6 && zeroRange(g, 200000, 2000000), "realloc of a big block grows it and keeps its content");
    g = asys.realloc(g, 6000000);
    check(g != null && g[0] == 5 && g[199999] == 6 && zeroRange(g, 200000, 6000000), "and again, into a block of its own");
    asys.free(g);
    int bad0 = asys.memBadFrees();
    asys.free(r2);
    asys.free(r2);                      // a double free is ignored and counted
    checkEq(asys.memBadFrees() - bad0, 1, "a double free of a kept block is ignored and counted once");
    checkEq(asys.memInUse(), base, "everything is back");
    asys.setKeepBigBlocks(0);
}

int main() {
    keepCycle();                        // first: the free lists are still empty, so the sizes below are hermetic
    fuzz("run 1: the platform's own treatment of big blocks", 0);
    seed = 987654321;
    fuzz("run 2: freed big blocks kept in free lists (AOS, Windows)", 1);
    printf("%d checks, %d failed\n", checks, fails);
    return fails == 0 ? 0 : 1;
}
