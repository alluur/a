// Small windows: the Dock leaves out a panel that would squeeze the centre below its minimum (and brings it back when the window is big
// enough), the find bar hides its count and buttons so that the find field keeps room, and the demo editor keeps its room with the bars
// and panels open at 320 x 240 and does not break at any size down to 40 x 30
#define CODEDEMO_NOMAIN
import wsrv;
import gcode;
#include "examples/gui/codedemo.a"
#include "gcode_harness.inc"

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;
    rmtree("build/tests/t267_project");
    asys.mkdirs("build/tests/t267_project");
    put("build/tests/t267_project/a.a", "int main() {\n    return 0;\n}\n");
    startServerSized(7367, "t267", 1400, 1000);

    // 1. the Dock on its own
    gui.Window* w = d->createWindow("Dock", 900, 600, 0);
    gcode.Dock* dock = new gcode.Dock();
    gui.Box* side = gui.vbox(0, 0);
    side->add(new gcode.FileTree());
    gcode.CodeEditor* e = new gcode.CodeEditor();
    e->blink = false;
    gui.Box* bot = gui.vbox(0, 0);
    bot->add(new gcode.OutputPane());
    dock->setSidebar(side);
    dock->setCenter(e);
    dock->setBottom(bot);
    w->setRoot(dock);
    settle();
    int sizes[18] = {900, 600, 400, 300, 300, 200, 284, 400, 285, 400, 500, 184, 500, 185, 100, 100, 900, 600};
    for (int i = 0; i < 9; i++) {
        w->resize(sizes[2 * i], sizes[2 * i + 1]);
        settle();
        printf("%d x %d: sidebar ", dock->w, dock->h);
        if (side->visible) { printf("%d wide", side->w); } else { printf("left out"); }
        printf(", bottom ");
        if (bot->visible) { printf("%d high", bot->h); } else { printf("left out"); }
        printf(", centre %d x %d at %d,%d, wanted: side %d bottom %d\n", e->w, e->h, e->x, e->y, dock->sideVisible, dock->bottomVisible);
        bool fits = (e->w >= dock->minCenter || !side->visible) && (e->h >= dock->minCenterH || !bot->visible);
        if (!fits) { printf("  the centre is squeezed\n"); }
    }
    dock->toggleSidebar();
    dock->toggleBottom();
    w->resize(900, 600);
    settle();
    printf("both hidden by the user: %d %d, centre %d x %d\n", side->visible, bot->visible, e->w, e->h);
    dock->toggleSidebar();
    dock->toggleBottom();
    settle();
    printf("shown again: %d %d\n", side->visible, bot->visible);
    w->close();

    // 2. the find bar in a narrow window
    gui.Window* w2 = d->createWindow("Find", 700, 120, 0);
    gcode.CodeEditor* e2 = new gcode.CodeEditor();
    e2->blink = false;
    gcode.FindBar* fb = new gcode.FindBar(e2);
    gui.Box* col = gui.vbox(0, 0);
    col->add(e2);
    col->add(fb);
    w2->setRoot(col);
    e2->setText("find me\n");
    fb->open(true);
    settle();
    int widths[7] = {700, 460, 380, 300, 200, 120, 60};
    for (int i = 0; i < 7; i++) {
        w2->resize(widths[i], 120);
        settle();
        printf("find bar %d wide: field %d wide (at least 90: %d), option buttons %s\n", widths[i], fb->findBox->w, fb->findBox->w >= 90 || widths[i] < 150,
               fb->toggleOf(0)->visible ? "shown" : "hidden");
    }
    w2->close();

    // 3. the demo
    startServerSized(7368, "t267b", 1400, 1000);
    CodeDemo* app = new CodeDemo(d, "build/tests/t267_project", "build/tests/t267_project/settings.ini");
    app->editor->blink = false;
    app->showFind(true);
    settle();
    int dsizes[10] = {640, 480, 320, 240, 160, 120, 80, 60, 40, 30};
    for (int i = 0; i < 5; i++) {
        app->win->resize(dsizes[2 * i], dsizes[2 * i + 1]);
        settle();
        app->toggleSidebar();
        settle();
        app->toggleBottom();
        settle();
        app->toggleSidebar();
        settle();
        app->toggleBottom();
        settle();
        typeStr("abc");
        key(adp.KEY_ENTER, 13);
        app->showGoto();
        settle();
        app->showFind(false);
        settle();
        printf("demo %dx%d: editor %d x %d (a line fits: %d), find field %d wide, sidebar %d, bottom %d\n", dsizes[2 * i], dsizes[2 * i + 1], app->editor->w, app->editor->h,
               app->editor->h >= app->editor->lineHeight(), app->find->findBox->w, app->dock->sidebar->visible, app->dock->bottom->visible);
    }
    app->win->resize(2400, 1600);
    settle();
    printf("big again: editor %d x %d, sidebar %d, bottom %d\n", app->editor->w, app->editor->h, app->dock->sidebar->visible, app->dock->bottom->visible);
    rmtree("build/tests/t267_project");
    return 0;
}
