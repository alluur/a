// abstract classes and methods: no objects of them, every concrete subclass implements the abstract methods, calls through a base pointer
// dispatch virtually (also from methods of the base class), several levels deep, abstract methods in the middle of a hierarchy

abstract class Animal {
protected:
    char* name;
    int legs;
public:
    Animal(char* n, int l) { name = n; legs = l; }
    abstract char* sound();                       // no body
    virtual int weight() = 0;                     // C++ style: also abstract
    virtual int cost() { return 10; }
    char* getName() { return name; }
    int describe() {                              // a template method: calls abstract methods of the subclass
        print(name); print(" says "); print(sound()); print(", weight "); printInt(weight()); print(", cost "); printInt(cost()); println("");
        return legs;
    }
}

abstract class Pet : Animal {                    // implements one abstract method, leaves the other one
public:
    Pet(char* n) { super(n, 4); }
    char* sound() { return "purr"; }
    int cost() { return super.cost() + 5; }
}

class Cat : Pet {
public:
    Cat() { super("cat"); }
    int weight() { return 4; }
}

class Lion : Cat {                               // overrides what Cat has
public:
    Lion() { super(); name = "lion"; }
    char* sound() { return "roar"; }
    int weight() { return 190; }
    int cost() { return 1000; }
}

class Bird : Animal {
public:
    Bird() { super("bird", 2); }
    char* sound() { return "tweet"; }
    int weight() { return 1; }
}

abstract class Shape {
public:
    abstract int area();
    abstract int perimeter();
    int ratio() { return area() * 100 / perimeter(); }
}
abstract class Polygon : Shape {
public:
    abstract int sides();
    int perimeter() { return sides() * edge(); }
    abstract int edge();
}
class Square : Polygon {
public:
    int s;
    Square(int x) { s = x; }
    int area() { return s * s; }
    int sides() { return 4; }
    int edge() { return s; }
}
class Hexagon : Polygon {
public:
    int s;
    Hexagon(int x) { s = x; }
    int area() { return s * s * 2; }
    int sides() { return 6; }
    int edge() { return s; }
}
class Circle : Shape {
public:
    int r;
    Circle(int x) { r = x; }
    int area() { return 3 * r * r; }
    int perimeter() { return 6 * r; }
}

int main() {
    Animal* zoo[4];
    zoo[0] = new Cat();
    zoo[1] = new Lion();
    zoo[2] = new Bird();
    zoo[3] = new Cat();
    int legs = 0;
    foreach (Animal* a in zoo) { legs += a->describe(); }
    printlnInt(legs);
    Pet* p = new Lion();                          // a Lion through a pointer to the intermediate abstract class
    println(p->sound()); printlnInt(p->weight()); printlnInt(p->cost());
    Cat c;                                        // a concrete class has objects (on the stack too)
    printlnInt(c.weight());
    Cat c2();
    printlnInt(c2.weight()); println(c2.getName());

    Shape* shapes[4];
    shapes[0] = new Square(5);
    shapes[1] = new Hexagon(2);
    shapes[2] = new Circle(10);
    shapes[3] = new Square(1);
    foreach (int i, Shape* s in shapes) {
        printInt(i); print(": area "); printInt(s->area()); print(", perimeter "); printInt(s->perimeter()); print(", ratio "); printlnInt(s->ratio());
    }
    Polygon* poly = new Hexagon(3);
    printlnInt(poly->sides() * 100 + poly->perimeter());
    return 0;
}
