// neural networks: perceptron, MLP (XOR, softmax classification), saving and loading
import nn;
import fixed;

int main() {
    int ONE = fixed.ONE;
    fixed.seed(42);
    nn.Perceptron* p = new nn.Perceptron(2);
    int x[8]; x[0]=0; x[1]=0; x[2]=0; x[3]=ONE; x[4]=ONE; x[5]=0; x[6]=ONE; x[7]=ONE;
    int t[4]; t[0]=0; t[1]=1; t[2]=1; t[3]=1;
    printlnInt(p->fit(x, t, 4, 100, fixed.fromText("0.1")));
    for (int i = 0; i < 4; i++) printInt(p->predict(&x[i*2]));
    println("");

    // XOR cannot be learned by a single neuron but by a network with a hidden layer
    int sizes[3]; sizes[0] = 2; sizes[1] = 4; sizes[2] = 1;
    nn.Network* net = new nn.Network(3, sizes, nn.ACT_TANH, nn.ACT_SIGMOID);
    int tx[4]; tx[0]=0; tx[1]=ONE; tx[2]=ONE; tx[3]=0;
    int l = net->fit(x, tx, 4, 3000, fixed.fromText("0.5"), 0);
    printlnInt(l < fixed.fromText("0.01"));
    for (int i = 0; i < 4; i++) { int* y = net->forward(&x[i*2]); fixed.putln(y[0], 1); }

    // three classes, relu hidden layer, softmax output, cross-entropy loss
    int sz[3]; sz[0] = 2; sz[1] = 6; sz[2] = 3;
    nn.Network* c = new nn.Network(3, sz, nn.ACT_RELU, nn.ACT_SOFTMAX);
    int px[12]; int pt[9];
    int cx[3]; int cy[3];
    cx[0] = 0; cy[0] = 0; cx[1] = ONE; cy[1] = 0; cx[2] = 0; cy[2] = ONE;
    for (int k = 0; k < 3; k++) {
        px[k*2] = cx[k]; px[k*2+1] = cy[k];
        for (int j = 0; j < 3; j++) pt[k*3+j] = (j == k) ? ONE : 0;
    }
    c->fit(px, pt, 3, 500, fixed.fromText("0.1"), 0);
    printlnInt(c->accuracy(px, pt, 3));
    printlnInt(c->save("build/tests/t71_net.bin"));
    nn.Network* c2 = new nn.Network(3, sz, nn.ACT_RELU, nn.ACT_SOFTMAX);
    printlnInt(c2->load("build/tests/t71_net.bin"));
    printlnInt(c2->accuracy(px, pt, 3));
    printlnInt(c->parameters());
    int sz4[2]; sz4[0] = 2; sz4[1] = 3;
    nn.Network* other = new nn.Network(2, sz4, nn.ACT_RELU, nn.ACT_SOFTMAX);
    printlnInt(other->load("build/tests/t71_net.bin"));       // a different shape is refused
    return 0;
}
