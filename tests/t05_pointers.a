void swap(int* a, int* b) { int t = *a; *a = *b; *b = t; }
int sum(int* arr, int n) { int s = 0; for (int i = 0; i < n; i++) s += arr[i]; return s; }
int main() {
    int x = 1; int y = 2;
    swap(&x, &y);
    printlnInt(x); printlnInt(y);
    int arr[5];
    for (int i = 0; i < 5; i++) arr[i] = i * i;
    printlnInt(sum(arr, 5));
    int* p = arr;
    printlnInt(*p);
    p++;
    printlnInt(*p);
    p += 2;
    printlnInt(*p);
    printlnInt(p - arr);
    printlnInt(*(arr + 4));
    int** pp = &p;
    printlnInt(**pp);
    char s[6];
    s[0] = 'h'; s[1] = 'e'; s[2] = 'l'; s[3] = 'l'; s[4] = 'o'; s[5] = 0;
    println(s);
    char* q = s;
    q[0] = 'J';
    println(q);
    printlnInt(strlen(q));
    int big[100];
    big[99] = 42;
    printlnInt(big[99]);
    printlnInt(sizeof(int)); printlnInt(sizeof(char)); printlnInt(sizeof(int*));
    int* nothing = null;
    if (nothing == null) println("null ok");
    arr[2]++;
    arr[2] += 10;
    printlnInt(arr[2]);
    return 0;
}
