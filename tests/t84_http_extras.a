// http: Basic auth, MIME types, serving files from a directory (and refusing to leave it), downloads
import http;
import net;

int main() {
    print(http.basicAuth("Aladdin", "open sesame"));          // the example of RFC 7617
    println(http.mimeType("site/style.css"));
    println(http.mimeType("a.b/photo.JPG"));
    println(http.mimeType("a.b/README"));
    println(http.mimeType("x/page.html"));

    makeDir("build/tests/www");
    writeFile("build/tests/www/index.html", "<h1>home</h1>");
    writeFile("build/tests/www/data.json", "{\"a\":1}");
    writeFile("build/tests/secret.txt", "top secret");

    int server = net.listenOn("127.0.0.1", 47161, 8);
    char* paths[6];
    paths[0] = "/"; paths[1] = "/data.json"; paths[2] = "/missing.txt"; paths[3] = "/../secret.txt";
    paths[4] = "/%2e%2e/secret.txt"; paths[5] = "/data.json";
    for (int i = 0; i < 6; i++) {
        int client = net.connect("127.0.0.1", 47161);
        char* method = "GET";
        if (i == 5) method = "HEAD";
        http.sendRequest(client, method, "localhost", paths[i], "", null, 0);
        int conn = net.accept(server);
        http.Request* q = new http.Request();
        http.readRequest(conn, q);
        http.serveFile(conn, "build/tests/www", q);
        net.close(conn);
        http.Response* r = http.readResponse(client);
        print(method); print(" "); print(paths[i]); print(" -> "); printInt(r->status);
        if (r->status == 200) { print(" "); print(r->header("Content-Type")); print(" "); printInt(r->bodyLen); }
        println("");
        if (i < 2) println(r->body);
        net.close(client);
    }
    // another method
    int client = net.connect("127.0.0.1", 47161);
    http.sendRequest(client, "DELETE", "localhost", "/", "", null, 0);
    int conn = net.accept(server);
    http.Request* q = new http.Request();
    http.readRequest(conn, q);
    http.serveFile(conn, "build/tests/www", q);
    net.close(conn);
    printlnInt(http.readResponse(client)->status);
    net.close(client);
    net.close(server);
    printlnInt(http.download("http://127.0.0.1:1/x", "build/tests/dl.bin"));
    println(http.error());
    return 0;
}
