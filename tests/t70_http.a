import net;
import http;

void answer(http.Request* q, int c) {
    char v[64];
    if (http.queryValue(q, "name", v, 64)) {
        char out[128];
        format(out, 128, "hello %s", v);
        http.respond(c, 200, "text/plain", out);
    } else {
        http.respond(c, 404, "text/plain", "no name");
    }
}

int main() {
    http.Url* u = new http.Url();
    printlnInt(http.parseUrl("http://example.org:8080/a/b?x=1", u));
    println(u->host); printlnInt(u->port); println(u->path);
    http.parseUrl("http://example.org", u);
    println(u->path); printlnInt(u->port);
    printlnInt(http.parseUrl("ftp://x/", u));
    println(http.statusText(404));

    int server = net.listenOn("127.0.0.1", 47131, 4);
    int client = net.connect("127.0.0.1", 47131);
    http.sendRequest(client, "POST", "localhost", "/submit?id=7&name=Ada%20L", "X-Test: yes\r\n", "payload", 7);
    int conn = net.accept(server);
    http.Request* q = new http.Request();
    printlnInt(http.readRequest(conn, q));
    println(q->method); println(q->path); println(q->query);
    println(q->body); printlnInt(q->bodyLen);
    println(q->header("x-test"));
    char v[64];
    http.queryValue(q, "name", v, 64);
    println(v);
    http.queryValue(q, "id", v, 64);
    println(v);
    printlnInt(http.queryValue(q, "nope", v, 64));
    answer(q, conn);
    net.close(conn);
    http.Response* r = http.readResponse(client);
    printlnInt(r->status); println(r->body); printlnInt(r->bodyLen);
    println(r->header("Content-Type"));
    net.close(client);

    // a chunked answer written by hand
    client = net.connect("127.0.0.1", 47131);
    conn = net.accept(server);
    net.sendText(conn, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n");
    net.close(conn);
    r = http.readResponse(client);
    println(r->body); printlnInt(r->bodyLen);
    net.close(client);

    // an answer that ends when the connection closes
    client = net.connect("127.0.0.1", 47131);
    conn = net.accept(server);
    net.sendText(conn, "HTTP/1.0 302 Found\r\nLocation: /elsewhere\r\n\r\nbody until close");
    net.close(conn);
    r = http.readResponse(client);
    printlnInt(r->status); println(r->body); println(r->header("location"));
    net.close(client);

    printlnInt(http.get("https://127.0.0.1:1/") == null);
    println(http.error());
    net.close(server);
    return 0;
}
