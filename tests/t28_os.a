int main(int argc, char** argv) {
    char* path = getEnv(argc, argv, "PATH");
    printBool(path != null && strlen(path) > 0); println("");
    printBool(getEnv(argc, argv, "A_LANG_SURELY_NOT_SET") == null); println("");
    makeDir("build/tests/os_dir");                    // may already exist from an earlier run
    printBool(fileExists("build/tests/os_dir/x.txt")); println("");
    writeFile("build/tests/os_dir/x.txt", "data");
    printBool(fileExists("build/tests/os_dir/x.txt")); println("");
    println(readFile("build/tests/os_dir/x.txt"));
    printBool(fileDelete("build/tests/os_dir/x.txt")); println("");
    printBool(fileExists("build/tests/os_dir/x.txt")); println("");
    printBool(fileDelete("build/tests/os_dir/x.txt")); println("");
    return 0;
}
