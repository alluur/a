// Input details: keys that carry values that are not text (surrogates, above 0x10FFFF, control characters from a VNC client) never reach
// the text of a CodeEditor or a LineEdit, so the text stays valid UTF-8; the mouse wheel scrolls a TabBar that overflows (and goes on to
// the widgets around when the tabs fit); the type-ahead of the FileTree takes several letters ("file59") and falls back to the next row
// that starts with the letter
import wsrv;
import gui;
import guix;
import gcode;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

bool validUtf8(char* t, int n) {
    int i = 0;
    while (i < n) {
        int c = t[i] & 255;
        int need = 0;
        if (c < 0x80) { need = 0; }
        else if (c >= 0xC2 && c < 0xE0) { need = 1; }
        else if (c >= 0xE0 && c < 0xF0) { need = 2; }
        else if (c >= 0xF0 && c < 0xF5) { need = 3; }
        else { return false; }
        for (int k = 1; k <= need; k++) {
            if (i + k >= n || (t[i + k] & 0xC0) != 0x80) { return false; }
        }
        if (need == 2 && c == 0xED && (t[i + 1] & 0xE0) == 0xA0) { return false; }       // a surrogate
        if (need == 3 && c == 0xF4 && (t[i + 1] & 0xF0) != 0x80) { return false; }       // above 0x10FFFF
        i = i + need + 1;
    }
    return true;
}

void hex(char* t, int n) {
    for (int i = 0; i < n; i++) { printf("%02x ", t[i] & 255); }
    printf("\n");
}

void put(char* path, char* text) { asys.writeFile(path, text, strlen(text)); }

int main() {
    gcode.theLook()->autoComplete = false;
    gcode.theLook()->highlightWord = false;
    gcode.theLook()->matchBrackets = false;
    rmtree("build/tests/t265_tree");
    startServerSized(7365, "t265", 1200, 800);

    // 1. key values: valid characters get in, the others are ignored
    gui.Window* w = d->createWindow("Input", 600, 240, 0);
    gcode.CodeEditor* e = new gcode.CodeEditor();
    e->blink = false;
    gcode.LineEdit* le = new gcode.LineEdit();
    gui.Box* col = gui.vbox(0, 0);
    col->add(e);
    col->add(le);
    w->setRoot(col);
    w->setFocus(e);
    settle();
    int unis[18] = {0xD800, 0xDFFF, 0x110000, 0x7FFFFFFF, -1, 0x80, 0x9F, 0x7F, 0x0, 0x1F, 0x20, 0xE9, 0x20AC, 0x1F600, 0x10FFFF, 0xFEFF, 0xA0, 0x7E};
    for (int i = 0; i < 18; i++) {
        hb->keyDown(0, unis[i]);
        hb->keyUp(0, unis[i]);
        settle();
    }
    char* t = e->getText();
    printf("editor: %d bytes, valid UTF-8 %d\n", e->buf->length(), validUtf8(t, e->buf->length()));
    hex(t, e->buf->length());
    asys.free(t);
    w->setFocus(le);
    for (int i = 0; i < 18; i++) {
        hb->keyDown(0, unis[i]);
        hb->keyUp(0, unis[i]);
        settle();
    }
    char* lt = le->text();
    printf("line edit: %d bytes, valid UTF-8 %d\n", strlen(lt), validUtf8(lt, strlen(lt)));
    hex(lt, strlen(lt));
    printf("gui.isTextChar: 65 %d, 0xD800 %d, 0x10FFFF %d, 0x110000 %d, 0x9F %d, 0xA0 %d, 127 %d, 31 %d\n", gui.isTextChar(65), gui.isTextChar(0xD800), gui.isTextChar(0x10FFFF),
           gui.isTextChar(0x110000), gui.isTextChar(0x9F), gui.isTextChar(0xA0), gui.isTextChar(127), gui.isTextChar(31));
    w->close();

    // 2. the wheel over a tab bar
    gui.Window* w2 = d->createWindow("Tabs", 600, 160, 0);
    gcode.TabBar* tabs = new gcode.TabBar();
    gui.Box* c2 = gui.vbox(0, 0);
    c2->add(tabs);
    w2->setRoot(c2);
    settle();
    tabs->addTab("main.a", 1);
    tabs->addTab("util.a", 2);
    settle();
    wheelWd(w2, tabs, 100, 10, -5);
    printf("two tabs fit (overflow %d): the wheel does not scroll them (scrollX %d, wants the wheel %d)\n", tabs->overflowing(), tabs->scrollX, tabs->wantsScroll());
    for (int i = 0; i < 30; i++) {
        char nm[40];
        format(&nm[0], 40, "file%d.a", i);
        tabs->addTab(&nm[0], 10 + i);
    }
    tabs->select(0);
    settle();
    printf("30 more tabs: overflow %d, wants the wheel %d, scrollX %d\n", tabs->overflowing(), tabs->wantsScroll(), tabs->scrollX);
    wheelWd(w2, tabs, 100, 10, -5);
    printf("wheel down 5: scrollX %d\n", tabs->scrollX);
    wheelWd(w2, tabs, 100, 10, -5);
    printf("wheel down 5: scrollX %d\n", tabs->scrollX);
    wheelWd(w2, tabs, 100, 10, 2);
    printf("wheel up 2: scrollX %d\n", tabs->scrollX);
    wheelWd(w2, tabs, 100, 10, 500);
    printf("wheel up 500: scrollX %d\n", tabs->scrollX);
    wheelWd(w2, tabs, 100, 10, -500);
    int atEnd = tabs->scrollX;
    wheelWd(w2, tabs, 100, 10, -500);
    printf("wheel down 500 twice: the end is reached and kept (%d, scrolled %d, same %d)\n", atEnd > 600, tabs->scrollX > 0, tabs->scrollX == atEnd);
    w2->close();

    // 3. type-ahead in the file tree
    asys.mkdirs("build/tests/t265_tree/loop");
    for (int i = 0; i < 100; i++) {
        char p[100];
        format(&p[0], 100, "build/tests/t265_tree/file%d.txt", i);
        put(&p[0], "x\n");
    }
    put("build/tests/t265_tree/README.md", "r\n");
    put("build/tests/t265_tree/readme.txt", "r\n");
    put("build/tests/t265_tree/Makefile", "m\n");
    put("build/tests/t265_tree/fib.a", "f\n");
    gui.Window* w3 = d->createWindow("Files", 320, 400, 0);
    gcode.FileTree* tree = new gcode.FileTree();
    gui.Box* c3 = gui.vbox(0, 0);
    c3->add(tree);
    w3->setRoot(c3);
    w3->setFocus(tree);
    printf("setRoot %d\n", tree->setRoot("build/tests/t265_tree"));
    settle();
    printf("%d rows, first %s\n", tree->visibleCount(), tree->nameAt(0));
    tree->typeAheadMs = 600000;                       // letters that follow each other count together for the whole test
    key('f', 'f');
    printf("f: %s\n", tree->nameAt(tree->selected));
    key('i', 'i');
    printf("fi: %s\n", tree->nameAt(tree->selected));
    key('l', 'l');
    printf("fil: %s\n", tree->nameAt(tree->selected));
    key('e', 'e');
    key('5', '5');
    key('9', '9');
    printf("file59: %s\n", tree->nameAt(tree->selected));
    key('.', '.');
    printf("file59.: %s\n", tree->nameAt(tree->selected));
    key('x', 'x');
    printf("file59.x (nothing starts with it, so the letter x alone: no row): %s\n", tree->nameAt(tree->selected));
    tree->typeAheadMs = -1;                           // every key starts again
    key('r', 'r');
    printf("r: %s\n", tree->nameAt(tree->selected));
    key('r', 'r');
    printf("r again: %s\n", tree->nameAt(tree->selected));
    key('R', 'R');
    printf("R (case does not matter): %s\n", tree->nameAt(tree->selected));
    key('m', 'm');
    printf("m: %s\n", tree->nameAt(tree->selected));
    key('l', 'l');
    printf("l: %s\n", tree->nameAt(tree->selected));
    tree->typeAheadMs = 600000;
    key('r', 'r');
    key('e', 'e');
    key('a', 'a');
    printf("rea: %s\n", tree->nameAt(tree->selected));
    key('d', 'd');
    key('m', 'm');
    key('e', 'e');
    printf("readme: %s\n", tree->nameAt(tree->selected));
    key('.', '.');
    key('t', 't');
    printf("readme.t: %s\n", tree->nameAt(tree->selected));
    keyMods('f', 'F', adp.MOD_SHIFT);
    printf("a letter typed with Shift counts too (the prefix restarts after no match): %s\n", tree->nameAt(tree->selected));
    w3->close();
    rmtree("build/tests/t265_tree");
    return 0;
}
