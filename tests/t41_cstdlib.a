import cstdlib;
import cstring;
import climits;

int main() {
    char* e;
    // strtol / strtoul
    printf("%d [%s]\n", strtol("  -1234xyz", &e, 10), e);
    printf("%d [%s]\n", strtol("0x1fZ", &e, 0), e);
    printf("%d [%s]\n", strtol("077", &e, 0), e);
    printf("%d [%s]\n", strtol("0x", &e, 16), e);
    printf("%d [%s]\n", strtol("zz", &e, 36), e);
    printf("%d [%s]\n", strtol("101", &e, 2), e);
    printf("%d [%s]\n", strtol("abc", &e, 10), e);
    printf("%d [%s]\n", strtol("+42", &e, 10), e);
    printf("%d\n", strtol("12345678901234567890", &e, 10));
    printf("%d\n", strtol("-12345678901234567890", &e, 10));
    printf("%u\n", strtoul("18446744073709551615", &e, 10));
    printf("%u\n", strtoul("-1", &e, 10));
    printf("%d\n", strtoll("9223372036854775807", &e, 10));
    printf("%d %d %d\n", atol("123"), atoll("-77"), atoi("99x"));
    printf("%d %d %d\n", labs(-5), llabs(7), abs(-9));
    div_t* d = div(-7, 2);
    printf("%d %d\n", d->quot, d->rem);
    d = ldiv(17, 5);
    printf("%d %d\n", d->quot, d->rem);
    // memory
    char* p = malloc(100);
    strcpy(p, "hello");
    char* q = realloc(p, 5000);
    printf("%s %d\n", q, malloc_usable_size(q) >= 5000);
    free(q);
    char* r = malloc(6000);
    printf("%d %d\n", r == q, r[10]);
    char* z = calloc(10, 8);
    int sum = 0;
    for (int i = 0; i < 80; i++) sum += z[i];
    printf("%d\n", sum);
    free(null);
    int* list[50];
    for (int i = 0; i < 50; i++) {
        list[i] = (int*) malloc(24);
        list[i][0] = i;
    }
    int ok = 1;
    for (int i = 0; i < 50; i++) {
        if (list[i][0] != i) ok = 0;
    }
    printf("%d\n", ok);
    for (int i = 0; i < 50; i++) free((char*) list[i]);
    char* big = malloc(200 * 1024 * 1024);
    big[200 * 1024 * 1024 - 1] = 7;
    printf("%d\n", big[200 * 1024 * 1024 - 1]);
    // environment
    printf("%d\n", getenv("A_LANG_SURELY_UNSET_VARIABLE") == null);
    printf("%d\n", setenv("A_TEST_VAR", "value1", true));
    printf("%s\n", getenv("A_TEST_VAR"));
    setenv("A_TEST_VAR", "value2", false);
    printf("%s\n", getenv("A_TEST_VAR"));
    setenv("A_TEST_VAR", "value3", true);
    printf("%s\n", getenv("A_TEST_VAR"));
    putenv("A_OTHER=xyz");
    printf("%s\n", getenv("A_OTHER"));
    unsetenv("A_OTHER");
    printf("%d\n", getenv("A_OTHER") == null);
    printf("%d\n", setenv("BAD=NAME", "x", true));
    // processes
    printf("%d\n", system("exit 3"));
    printf("%d\n", system("exit 0"));
    printf("%d\n", system(null));
    // multibyte
    int wc;
    printf("%d %d\n", mbtowc(&wc, "\xC3\xA9x", 4), wc);
    printf("%d %d\n", mbtowc(&wc, "\xE2\x82\xAC", 4), wc);
    printf("%d %d\n", mblen("abc", 4), mblen("\xF0\x9F\x98\x80", 4));
    char out[8];
    printf("%d %d %d\n", wctomb(out, 0x20AC), out[0], out[2]);
    int wide[10];
    int n = mbstowcs(wide, "a\xC3\xA9\xE2\x82\xAC", 10);
    printf("%d %d %d %d %d\n", n, wide[0], wide[1], wide[2], wide[3]);
    char back[20];
    printf("%d %s\n", wcstombs(back, wide, 20), back);
    printf("%d %d %d\n", RAND_MAX, EXIT_FAILURE, INT_MAX == 9223372036854775807);
    return 0;
}
