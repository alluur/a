int counter = 0;
void note(int v) { counter = counter * 10 + v; }
int work(int n) {
    int base = 100;
    defer note(1);
    defer note(base / 50);
    if (n > 5) { return n * 2; }
    note(7);
    return n;
}
void noret() {
    defer println("bye");
    println("hello");
}
int main() {
    printlnInt(work(9));
    printlnInt(counter);
    counter = 0;
    printlnInt(work(3));
    printlnInt(counter);
    noret();
    return 0;
}
