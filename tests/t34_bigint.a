import bigint;

void show(bigint.BigInt* v) { println(v->toString()); }

int main() {
    show(bigint.fromInt(0)); show(bigint.fromInt(-5)); show(bigint.fromInt(1000000000)); show(bigint.fromInt(-9223372036854775807 - 1)); show(bigint.fromInt(9223372036854775807));
    show(bigint.factorial(50)); show(bigint.factorial(100));
    show(bigint.fibonacci(300));
    show(bigint.pow(bigint.fromInt(2), 200)); show(bigint.pow(bigint.fromInt(-3), 77)); show(bigint.pow(bigint.fromInt(7), 0));
    bigint.BigInt* a = bigint.parse("123456789012345678901234567890");
    bigint.BigInt* b = bigint.parse("-987654321098765432109876543210");
    show(a); show(b);
    show(bigint.add(a, b)); show(bigint.sub(a, b)); show(bigint.sub(a, a)); show(bigint.mul(a, b)); show(bigint.mul(a, a));
    show(bigint.add(bigint.parse("999999999999999999"), bigint.fromInt(1)));
    show(bigint.sub(bigint.parse("1000000000000000000"), bigint.fromInt(1)));
    int rem;
    show(bigint.divSmall(bigint.factorial(30), 1000007, &rem)); printlnInt(rem);
    show(bigint.divSmall(bigint.parse("-100"), 7, &rem)); printlnInt(rem);
    printlnInt(bigint.cmp(a, b)); printlnInt(bigint.cmp(b, a)); printlnInt(bigint.cmp(a, a)); printlnInt(bigint.cmp(bigint.fromInt(-5), bigint.fromInt(-7)));
    printlnInt(bigint.factorial(100)->digits()); printlnInt(bigint.fromInt(0)->digits()); printlnInt(bigint.fromInt(999999999)->digits());
    printlnInt(bigint.fromInt(-123456789012)->toInt()); printBool(bigint.parse("12x") == null); printBool(bigint.parse("") == null); println("");
    show(bigint.negate(a));
    return 0;
}
