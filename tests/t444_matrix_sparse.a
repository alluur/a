// matrix: sparse vectors, CSR matrices (builder, multiply, transpose, add, product), conjugate gradients, memory.
// Expected output: tests/algo2_ref/gen_t444.py (dictionaries of exact integers).
import cstdio;
import asys;
import matrix;
import dmath;

int seed = 99;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

void dumpCsr(char* name, matrix.CsrMatrix* m) {
    printf("%s %d x %d nnz %d\n", name, m->rows, m->cols, m->nnz);
    printf("  rowPtr:");
    for (int i = 0; i <= m->rows; i++) { printf(" %d", m->rowPtr[i]); }
    printf("\n  cols:");
    for (int i = 0; i < m->nnz; i++) { printf(" %d", m->colIdx[i]); }
    printf("\n  vals:");
    for (int i = 0; i < m->nnz; i++) { printfd(" %.10g", __bits(m->val[i])); }
    printf("\n");
}

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.10g", __bits(v[i])); }
    printf("\n");
}

double maxAbsDiff(double* a, double* b, int n) {
    double m = 0.0;
    for (int i = 0; i < n; i++) {
        double d = dmath.fabs(a[i] - b[i]);
        if (d > m) { m = d; }
    }
    return m;
}

matrix.CsrMatrix randomCsr(int rows, int cols, int entries) {
    matrix.CooBuilder b(rows, cols);
    for (int k = 0; k < entries; k++) {
        int i = lcg() % rows;
        int j = lcg() % cols;
        double v = (double) (lcg() % 9 - 4);
        b.add(i, j, v);
    }
    matrix.CsrMatrix m = b.build();
    b.dispose();
    return m;
}

int main() {
    int base = asys.memInUse();
    // ---- sparse vectors
    {
        matrix.SparseVector v(10);
        v.put(7, 2.5);
        v.put(2, -1.0);
        v.put(9, 4.0);
        v.put(2, 3.0);                                    // replaces
        v.put(5, 0.0);                                    // a zero is not stored
        printf("nnz %d, indexes %d %d %d, values", v.nnz, v.indexAt(0), v.indexAt(1), v.indexAt(2));
        printfd(" %g %g %g\n", __bits(v.valueAt(0)), __bits(v.valueAt(1)), __bits(v.valueAt(2)));
        printfd("get(7) %g, get(3) %g, get(10) is NaN %d, put(10) %d\n", __bits(v.get(7)), __bits(v.get(3)), v.get(10) != v.get(10), v.put(10, 1.0));
        v.put(7, 0.0);                                    // removes
        printf("after removing 7: nnz %d\n", v.nnz);
        v.put(7, 2.5);
        matrix.SparseVector w(10);
        w.put(2, 2.0);
        w.put(3, 7.0);
        w.put(9, -1.0);
        printfd("dot %g, norm %g\n", __bits(v.dot(&w)), __bits(v.norm2()));
        double dense[10];
        for (int i = 0; i < 10; i++) { dense[i] = (double) (i + 1); }
        printfd("dotDense %g\n", __bits(v.dotDense(dense)));
        matrix.SparseVector* s = v.addScaled(-2.0, &w);
        double out[10];
        s->toDense(out);
        dumpV("v - 2 w", out, 10);
        printf("nnz of the sum %d\n", s->nnz);
        double y[10];
        for (int i = 0; i < 10; i++) { y[i] = 1.0; }
        w.axpyDense(3.0, y);
        dumpV("y + 3 w", y, 10);
        matrix.SparseVector other(5);
        printf("dot with a different dimension is NaN %d, addScaled gives null %d\n", v.dot(&other) != v.dot(&other), v.addScaled(1.0, &other) == null);
        s->dispose();
        v.dispose(); w.dispose(); other.dispose();
    }

    // ---- CSR from a builder with duplicates, unsorted entries and cancelling entries
    {
        matrix.CooBuilder b(4, 5);
        b.add(2, 3, 5.0);
        b.add(0, 4, 1.0);
        b.add(2, 0, -2.0);
        b.add(0, 4, 2.0);
        b.add(3, 1, 7.0);
        b.add(1, 2, 3.0);
        b.add(1, 2, -3.0);                               // cancels to zero: dropped
        b.add(0, 0, 4.0);
        printf("builder out of range: %d %d %d, NaN %d\n", b.add(4, 0, 1.0), b.add(0, 5, 1.0), b.add(-1, 0, 1.0), b.add(0, 0, __dbl(0x7FF8000000000000)));
        matrix.CsrMatrix m = b.build();
        printf("count %d\n", b.count);
        dumpCsr("A", &m);
        printfd("get(0,4) %g, get(1,2) %g, get(3,3) %g, get(9,9) is NaN %d\n", __bits(m.get(0, 4)), __bits(m.get(1, 2)), __bits(m.get(3, 3)), m.get(9, 9) != m.get(9, 9));
        matrix.Matrix d = m.toDense();
        printf("dense:");
        for (int i = 0; i < 20; i++) { printfd(" %g", __bits(d.d[i])); }
        printf("\n");
        matrix.CsrMatrix back = matrix.fromDense(&d, 0.0);
        dumpCsr("fromDense", &back);
        double x[5] = {1, 2, 3, 4, 5};
        double y[4];
        printf("mulVec %d\n", m.mulVec(x, y));
        dumpV("A x", y, 4);
        double xt[4] = {1, -1, 2, 0.5};
        double yt[5];
        m.mulVecT(xt, yt);
        dumpV("A^T x", yt, 5);
        double diag[4];
        m.diagonal(diag);
        dumpV("diagonal", diag, 4);
        printf("mulVec aliasing: %d (ERR_ARG = %d)\n", m.mulVec(x, x), matrix.ERR_ARG);
        matrix.CsrMatrix t = m.transpose();
        dumpCsr("A^T", &t);
        matrix.CsrMatrix sc = m.scaled(-0.5);
        dumpCsr("-0.5 A", &sc);
        printfd("normFro %g\n", __bits(m.normFro()));
        t.dispose(); sc.dispose(); d.dispose(); back.dispose(); m.dispose(); b.dispose();
        printf("after dispose: ok %d, build of an empty builder: ", m.ok());
        matrix.CooBuilder e(2, 2);
        matrix.CsrMatrix em = e.build();
        printf("nnz %d rowPtr %d %d %d\n", em.nnz, em.rowPtr[0], em.rowPtr[1], em.rowPtr[2]);
        em.dispose(); e.dispose();
        matrix.CooBuilder bad(0, 3);
        matrix.CsrMatrix bm = bad.build();
        printf("0 rows: ok %d err %d\n", bm.ok(), bm.err);
    }

    // ---- random sparse matrices against the dense computation
    {
        matrix.CsrMatrix a = randomCsr(12, 9, 30);
        matrix.CsrMatrix b = randomCsr(9, 7, 25);
        matrix.CsrMatrix c = randomCsr(12, 9, 20);
        printf("A nnz %d, B nnz %d, C nnz %d\n", a.nnz, b.nnz, c.nnz);
        matrix.Matrix da = a.toDense();
        matrix.Matrix db = b.toDense();
        matrix.Matrix dc = c.toDense();
        matrix.CsrMatrix p = a.mul(&b);
        matrix.Matrix dp = p.toDense();
        matrix.Matrix want = da * &db;
        printf("A * B equals the dense product: %d, nnz %d\n", maxAbsDiff(dp.d, want.d, 12 * 7) == 0.0, p.nnz);
        dumpCsr("A * B", &p);
        matrix.CsrMatrix s = a.addScaled(2.0, &c);
        matrix.Matrix ds = s.toDense();
        matrix.Matrix twoC = dc.scaled(2.0);
        matrix.Matrix w2 = da.add(&twoC);
        printf("A + 2 C equals the dense sum: %d, nnz %d\n", maxAbsDiff(ds.d, w2.d, 12 * 9) == 0.0, s.nnz);
        dumpCsr("A + 2 C", &s);
        matrix.CsrMatrix cancel = a.addScaled(-1.0, &a);
        printf("A - A has %d entries\n", cancel.nnz);
        matrix.CsrMatrix wrong = a.mul(&a);
        printf("A * A (12x9 times 12x9): ok %d err %d\n", wrong.ok(), wrong.err);
        matrix.CsrMatrix wrong2 = a.addScaled(1.0, &b);
        printf("A + B (different shapes): ok %d err %d\n", wrong2.ok(), wrong2.err);
        matrix.CsrMatrix t = a.transpose();
        matrix.CsrMatrix tt = t.transpose();
        matrix.Matrix dtt = tt.toDense();
        printf("(A^T)^T = A: %d\n", maxAbsDiff(dtt.d, da.d, 12 * 9) == 0.0);
        double x[9];
        for (int i = 0; i < 9; i++) { x[i] = (double) (lcg() % 9 - 4); }
        double ys[12];
        double yd[12];
        a.mulVec(x, ys);
        da.mulVec(x, yd);
        printf("A x sparse = dense: %d\n", maxAbsDiff(ys, yd, 12) == 0.0);
        double z[12];
        for (int i = 0; i < 12; i++) { z[i] = (double) (lcg() % 9 - 4); }
        double ts[9];
        double td[9];
        a.mulVecT(z, ts);
        da.mulVecT(z, td);
        printf("A^T z sparse = dense: %d\n", maxAbsDiff(ts, td, 9) == 0.0);
        a.dispose(); b.dispose(); c.dispose(); da.dispose(); db.dispose(); dc.dispose(); p.dispose(); dp.dispose(); want.dispose();
        s.dispose(); ds.dispose(); twoC.dispose(); w2.dispose(); cancel.dispose(); t.dispose(); tt.dispose(); dtt.dispose();
    }

    // ---- conjugate gradients on the 1-D Laplacian (tridiagonal 2, -1)
    {
        int n = 60;
        matrix.CooBuilder b(n, n);
        for (int i = 0; i < n; i++) {
            b.add(i, i, 2.0);
            if (i > 0) { b.add(i, i - 1, -1.0); }
            if (i + 1 < n) { b.add(i, i + 1, -1.0); }
        }
        matrix.CsrMatrix a = b.build();
        b.dispose();
        double xt[60];
        double rhs[60];
        double x[60];
        for (int i = 0; i < n; i++) { xt[i] = (double) (i % 7) - 3.0; x[i] = 0.0; }
        a.mulVec(xt, rhs);
        int iters;
        int st = matrix.cg(&a, rhs, x, 200, 1.0e-12, &iters, true);
        printf("cg: status %d, iterations at most %d: %d, error below 1e-8: %d\n", st, n + 2, iters <= n + 2, maxAbsDiff(x, xt, n) < 1.0e-8);
        for (int i = 0; i < n; i++) { x[i] = 0.0; }
        st = matrix.cg(&a, rhs, x, 5, 1.0e-12, &iters, false);
        printf("cg with 5 iterations: status %d (ERR_NO_CONVERGE = %d), iterations %d\n", st, matrix.ERR_NO_CONVERGE, iters);
        for (int i = 0; i < n; i++) { x[i] = xt[i]; }
        st = matrix.cg(&a, rhs, x, 5, 1.0e-12, &iters, true);
        printf("cg started at the solution: status %d, iterations %d\n", st, iters);
        double zero[60];
        for (int i = 0; i < n; i++) { zero[i] = 0.0; x[i] = 5.0; }
        st = matrix.cg(&a, zero, x, 100, 1.0e-12, &iters, true);
        printf("cg with b = 0: status %d, x is zero %d\n", st, maxAbsDiff(x, zero, n) < 1.0e-9);
        matrix.CsrMatrix neg = a.scaled(-1.0);
        for (int i = 0; i < n; i++) { x[i] = 0.0; }
        st = matrix.cg(&neg, rhs, x, 100, 1.0e-12, &iters, true);
        printf("negative definite: status %d (ERR_NOT_SPD = %d)\n", st, matrix.ERR_NOT_SPD);
        matrix.CsrMatrix r = randomCsr(3, 4, 5);
        printf("non square: %d (ERR_DIM = %d), null: %d\n", matrix.cg(&r, rhs, x, 10, 1.0e-6, null, true), matrix.ERR_DIM, matrix.cg(null, rhs, x, 10, 1.0e-6, null, true));
        r.dispose(); neg.dispose(); a.dispose();
    }

    // ---- a large sparse matrix: 20000 x 20000 with 3 entries per row, multiplied ten times with a vector (all values are exact integers)
    {
        int n = 20000;
        matrix.CooBuilder b(n, n);
        for (int i = 0; i < n; i++) {
            b.add(i, i, 4.0);
            if (i > 0) { b.add(i, i - 1, -1.0); }
            if (i + 1 < n) { b.add(i, i + 1, -1.0); }
        }
        matrix.CsrMatrix a = b.build();
        b.dispose();
        double* x = (double*) asys.alloc(n * 8);
        double* y = (double*) asys.alloc(n * 8);
        for (int i = 0; i < n; i++) { x[i] = 1.0; }
        for (int k = 0; k < 10; k++) {
            a.mulVec(x, y);
            for (int i = 0; i < n; i++) { x[i] = y[i]; }
        }
        double total = 0.0;
        for (int i = 0; i < n; i++) { total += x[i]; }
        printf("nnz %d, A^10 times ones: x[0] = %d, x[1] = %d, x[10000] = %d, sum %d\n", a.nnz, (int) x[0], (int) x[1], (int) x[10000], (int) total);
        asys.free((char*) x);
        asys.free((char*) y);
        a.dispose();
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
