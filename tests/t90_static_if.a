// static if: compile time conditions for declarations and statements; the other branch is skipped completely
static if (__OS == 1) {
    int platform() { return 1; }
} else static if (__OS == 2) {
    int platform() { return 2; }
} else {
    int platform() { return 0; }
}

const BITS = 64;
static if (BITS == 64) {
    const WORD = 8;
    static if (__ARCH >= 2) {
        int family() { return __ARCH; }
    } else {
        int family() { return __ARCH; }
    }
} else {
    const WORD = 4;
    this_is_never_compiled(;
}

static if (false) {
    int skipped() { return undeclared_name; }
}

class Config {
    public int flag;
}

int main() {
    printlnInt(platform() == __OS);
    printlnInt(WORD);
    printlnInt(family() == __ARCH);
    int which = 99;
    static if (__ARCH == 0) {
        which = 0;
    } else static if (__ARCH == 1) {
        which = 1;
    } else static if (__ARCH == 2) {
        which = 2;
    } else {
        which = 3;
    }
    printlnInt(which == __ARCH);
    int x = 5;
    static if (BITS == 32) {
        x = 1000;
    } else {
        x = x + 1;
    }
    printlnInt(x);
    static if (BITS == 64) { static if (WORD == 8) { println("nested"); } }
    return 0;
}
