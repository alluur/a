// the gfx module: drawing, blending, text, pixel transfer
import gfx;

int main() {
    gfx.Surface* s = new gfx.Surface(200, 120);
    s->clear(gfx.rgb(30, 34, 44));
    s->gradientV(0, 0, 200, 30, gfx.rgb(70, 90, 160), gfx.rgb(30, 40, 80));
    s->fillRoundRect(8, 40, 80, 30, 7, gfx.rgb(200, 80, 60));
    s->roundRect(96, 40, 80, 30, 7, gfx.WHITE);
    s->fillCircle(30, 95, 16, gfx.GREEN);
    s->circle(80, 95, 16, gfx.YELLOW);
    s->line(110, 80, 190, 115, gfx.WHITE);
    s->fill(140, 85, 50, 25, gfx.argb(128, 255, 0, 0));
    s->rect(2, 2, 196, 116, gfx.GRAY);
    s->text(gfx.sansBold(), 8, 6, "Hello, A! Älä ÖÅ ©", gfx.WHITE);
    s->text(gfx.sans(), 14, 47, "Button", gfx.WHITE);
    s->text(gfx.mono(), 102, 47, "mono 012", gfx.WHITE);
    printlnInt(s->checksum());
    printlnInt(gfx.textWidth(gfx.sans(), "Hello"));
    printlnInt(gfx.textWidth(gfx.sansBold(), "Hello"));
    printlnInt(gfx.textWidth(gfx.mono(), "Hello"));
    printlnInt(gfx.sans()->height);
    printlnInt(gfx.sans()->ascent);

    // colours
    printlnInt(gfx.rgb(1, 2, 3));
    printlnInt(gfx.red(0xFF112233) * 10000 + gfx.green(0xFF112233) * 100 + gfx.blue(0xFF112233));
    printlnInt(gfx.mix(gfx.rgb(0, 0, 0), gfx.rgb(255, 255, 255), 128));
    printlnInt(gfx.withAlpha(gfx.rgb(9, 9, 9), 77));

    // blending and clipping
    gfx.Surface* t = new gfx.Surface(10, 10);
    t->clear(gfx.rgb(100, 100, 100));
    t->fill(2, 2, 4, 4, gfx.argb(128, 200, 0, 0));
    printlnInt(t->get(3, 3));
    printlnInt(t->get(0, 0));
    t->setClip(5, 5, 3, 3);
    t->fill(0, 0, 10, 10, gfx.BLUE);
    printlnInt(t->get(4, 4) == gfx.BLUE);
    printlnInt(t->get(5, 5) == gfx.BLUE);
    printlnInt(t->get(7, 7) == gfx.BLUE);
    printlnInt(t->get(8, 8) == gfx.BLUE);
    t->resetClip();
    t->put(-5, -5, 1);
    t->put(50, 50, 1);
    printlnInt(t->get(-1, 0));

    // blit and pixel transfer
    gfx.Surface* u = new gfx.Surface(6, 4);
    u->clear(gfx.rgb(9, 8, 7));
    u->blit(s, 8, 40, 6, 4, 0, 0);
    printlnInt(u->checksum());
    gfx.Surface* v = new gfx.Surface(6, 4);
    char buf[100];
    int n = u->pack(0, 0, 6, 4, &buf[0]);
    v->unpack(0, 0, 6, 4, &buf[0]);
    printlnInt(n);
    printlnInt(u->checksum() == v->checksum());
    printlnInt(buf[0] * 1000000 + buf[1] * 1000 + buf[2]);
    gfx.Surface* w = new gfx.Surface(8, 8);
    w->clear(gfx.rgb(0, 0, 0));
    w->blitBlend(t, 0, 0, 8, 8, 0, 0, 255);
    printlnInt(w->get(3, 3));
    return 0;
}
