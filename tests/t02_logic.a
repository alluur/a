bool t() { print("t "); return true; }
bool f() { print("f "); return false; }
int main() {
    printBool(1 < 2); print("\n");
    printBool(2 < 1); print("\n");
    printBool(3 == 3); print("\n");
    printBool(3 != 3); print("\n");
    printBool(3 <= 3); print("\n");
    printBool(4 >= 5); print("\n");
    printBool(!true); print("\n");
    printBool(t() && f()); print("\n");
    printBool(f() && t()); print("\n");
    printBool(t() || f()); print("\n");
    printBool(f() || t()); print("\n");
    printBool(f() || f() || t()); print("\n");
    printBool(t() && t() && t()); print("\n");
    int x = 5;
    int y = x > 3 ? 10 : 20;
    printlnInt(y);
    printlnInt(x < 3 ? 10 : x < 10 ? 20 : 30);
    return 0;
}
