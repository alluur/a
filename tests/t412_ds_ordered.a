// ds: OrderedMap / OrderedSet / OrderedTextMap on an AVL tree, checked against a sorted array model with random operations
import cstdio;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 12345;
int rnd(int n) {                                   // xorshift, deterministic on every target
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

// the model: sorted keys and values
int mk[4000];
int mv[4000];
int mn = 0;

int mfind(int key) {                               // index of the first key >= key
    int lo = 0;
    int hi = mn;
    while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (mk[mid] < key) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}
bool mput(int key, int v) {                        // true when new
    int i = mfind(key);
    if (i < mn && mk[i] == key) { mv[i] = v; return false; }
    for (int j = mn; j > i; j--) { mk[j] = mk[j - 1]; mv[j] = mv[j - 1]; }
    mk[i] = key; mv[i] = v; mn++;
    return true;
}
bool mremove(int key) {
    int i = mfind(key);
    if (i >= mn || mk[i] != key) { return false; }
    for (int j = i; j < mn - 1; j++) { mk[j] = mk[j + 1]; mv[j] = mv[j + 1]; }
    mn--;
    return true;
}

int sumCb(int key, int val, int ctx) {
    int* acc = (int*) ctx;
    acc[0] = acc[0] + key;
    acc[1]++;
    return 0;
}
int stopAt3(int key, int val, int ctx) {
    int* acc = (int*) ctx;
    acc[0]++;
    return (acc[0] == 3) ? 77 : 0;
}

int cmpMod(int a, int b) {                         // a custom order: by last digit, then by value, descending
    int x = a % 10;
    int y = b % 10;
    if (x != y) { return y <=> x; }
    return a <=> b;
}

void randomOps() {
    ds.OrderedMap m();
    int mismatches = 0;
    for (int op = 0; op < 30000; op++) {
        int k = rnd(1000);
        int what = rnd(100);
        if (what < 40) {
            int v = rnd(100000);
            int r = m.put(k, v);
            bool isNew = mput(k, v);
            if ((r == 1) != isNew || r < 0) { mismatches++; }
        } else if (what < 65) {
            bool a = m.remove(k);
            bool b = mremove(k);
            if (a != b) { mismatches++; }
        } else if (what < 72) {
            int i = mfind(k);
            bool has = i < mn && mk[i] == k;
            if (m.has(k) != has) { mismatches++; }
            if (m.get(k, -5) != (has ? mv[i] : -5)) { mismatches++; }
        } else if (what < 80) {
            int i = mfind(k);                      // ceil
            int c = m.ceilNode(k);
            if ((c < 0) != (i == mn)) { mismatches++; } else if (c >= 0 && m.keyAt(c) != mk[i]) { mismatches++; }
            int h = m.higherNode(k);
            int ih = (i < mn && mk[i] == k) ? i + 1 : i;
            if ((h < 0) != (ih == mn)) { mismatches++; } else if (h >= 0 && m.keyAt(h) != mk[ih]) { mismatches++; }
            int fl = m.floorNode(k);
            int ifl = (i < mn && mk[i] == k) ? i : i - 1;
            if ((fl < 0) != (ifl < 0)) { mismatches++; } else if (fl >= 0 && m.keyAt(fl) != mk[ifl]) { mismatches++; }
            int lo = m.lowerNode(k);
            int ilo = i - 1;
            if ((lo < 0) != (ilo < 0)) { mismatches++; } else if (lo >= 0 && m.keyAt(lo) != mk[ilo]) { mismatches++; }
        } else if (what < 88) {
            int i = mfind(k);
            if (m.rank(k) != i) { mismatches++; }
            int up = (i < mn && mk[i] == k) ? i + 1 : i;
            if (m.rankUpTo(k) != up) { mismatches++; }
            if (mn > 0) {
                int s = rnd(mn);
                int t = m.select(s);
                if (t < 0 || m.keyAt(t) != mk[s] || m.valueAt(t) != mv[s]) { mismatches++; }
            }
        } else if (what < 96) {
            int k2 = k + rnd(200) - 20;
            int ks[300];
            int vs[300];
            int got = m.range(k, k2, &ks[0], &vs[0], 300);
            int want = 0;
            int i = mfind(k);
            while (i < mn && mk[i] <= k2) {
                if (want < got && (ks[want] != mk[i] || vs[want] != mv[i])) { mismatches++; }
                want++;
                i++;
            }
            if (want != got) { mismatches++; }
            int cr = (k2 >= k) ? m.countRange(k, k2) : 0;
            if (cr != want) { mismatches++; }
        } else {
            if (m.size() != mn) { mismatches++; }
            if (mn > 0) {
                if (m.firstKey() != mk[0] || m.lastKey() != mk[mn - 1]) { mismatches++; }
            }
        }
        if (op % 1000 == 999 && !m.verify()) { mismatches++; }
    }
    check(mismatches == 0, "random operations agree with the sorted array model");
    check(m.verify(), "AVL invariants hold at the end");
    check(m.size() == mn, "same size at the end");
    int ks[1000];
    int vs[1000];
    int cnt = m.toArrays(&ks[0], &vs[0]);
    bool same = cnt == mn;
    for (int i = 0; i < cnt && same; i++) { if (ks[i] != mk[i] || vs[i] != mv[i]) { same = false; } }
    check(same, "toArrays gives the model");
    int acc[2];
    acc[0] = 0; acc[1] = 0;
    m.forEach(sumCb, (int) &acc[0]);
    int want = 0;
    for (int i = 0; i < mn; i++) { want = want + mk[i]; }
    check(acc[0] == want && acc[1] == mn, "forEach visits every entry once");
    acc[0] = 0;
    check(m.forEach(stopAt3, (int) &acc[0]) == 77 && acc[0] == 3, "forEach stops when the callback returns non-zero");
    // a node number stays valid while other keys change
    int nodeA = m.find(mk[mn / 2]);
    int keyA = mk[mn / 2];
    int valA = mv[mn / 2];
    for (int i = 0; i < 3000; i++) {
        int k = rnd(1000);
        if (k != keyA) { if (rnd(2) == 0) { m.put(k, 1); } else { m.remove(k); } }
    }
    check(m.find(keyA) == nodeA && m.valueAt(nodeA) == valA && m.verify(), "node numbers are stable");
    m.dispose();
}

void smallCases() {
    ds.OrderedMap m();
    check(m.size() == 0 && m.firstNode() == -1 && m.lastNode() == -1 && m.verify(), "empty map");
    check(m.floorNode(5) == -1 && m.ceilNode(5) == -1 && m.rank(5) == 0 && m.select(0) == -1, "queries on an empty map");
    check(!m.remove(5) && m.get(5, 9) == 9, "remove / get on an empty map");
    check(m.put(5, 50) == 1 && m.put(5, 51) == 0 && m.get(5, 0) == 51 && m.size() == 1, "put twice");
    check(m.removeFirst() && m.size() == 0 && !m.removeLast(), "removeFirst / removeLast");
    // ascending, descending and zigzag insertion stay balanced
    for (int i = 0; i < 5000; i++) { m.put(i, i * 2); }
    check(m.verify() && m.height() <= 14, "ascending insertion is balanced");
    for (int i = 0; i < 5000; i += 2) { m.remove(i); }
    check(m.verify() && m.size() == 2500 && m.firstKey() == 1 && m.lastKey() == 4999, "removing every other key");
    m.clear();
    for (int i = 5000; i > 0; i--) { m.put(i, i); }
    check(m.verify() && m.height() <= 14, "descending insertion is balanced");
    bool allRemoved = true;
    for (int i = 1; i <= 5000; i++) { if (!m.remove(i)) { allRemoved = false; } }
    check(allRemoved, "remove every key");
    check(m.size() == 0 && m.verify(), "everything removed");
    // negative keys and the extremes
    m.put(-9223372036854775807 - 1, 1);
    m.put(9223372036854775807, 2);
    m.put(0, 3);
    m.put(-1, 4);
    check(m.firstKey() == -9223372036854775807 - 1 && m.lastKey() == 9223372036854775807 && m.rank(0) == 2, "extreme keys");
    check(m.floorKey(-2) == -9223372036854775807 - 1 && m.ceilKey(1) == 9223372036854775807 && m.higherKey(9223372036854775807, 42) == 42, "extreme neighbours");
    check(m.countRange(-9223372036854775807 - 1, 9223372036854775807) == 4, "count over the whole range");
    m.dispose();
}

void comparatorMap() {
    ds.OrderedMap m(cmpMod);
    for (int i = 0; i < 40; i++) { m.put(i + 100, i); }
    int ks[40];
    int n = m.toArrays(&ks[0], null);
    bool ok = n == 40;
    for (int i = 1; i < n; i++) { if (cmpMod(ks[i - 1], ks[i]) >= 0) { ok = false; } }
    check(ok && ks[0] % 10 == 9 && m.verify(), "custom comparator order (last digit descending)");
    check(m.has(105) && !m.has(5) && m.get(133, -1) == 33, "lookups use the comparator");
    check(m.floorKey(109, -1) == 109 && m.lowerKey(109, -1) == -1 && m.ceilKey(100, -1) == 100, "neighbours with a comparator");
    m.dispose();
}

void sets() {
    ds.OrderedSet s();
    int model[600];
    bool in[600];
    int cnt = 0;
    int bad = 0;
    for (int i = 0; i < 20000; i++) {
        int k = rnd(600);
        if (rnd(3) != 0) {
            int r = s.add(k);
            if ((r == 1) == in[k]) { bad++; }
            if (!in[k]) { in[k] = true; cnt++; }
        } else {
            if (s.remove(k) != in[k]) { bad++; }
            if (in[k]) { in[k] = false; cnt--; }
        }
    }
    check(bad == 0 && s.size() == cnt && s.verify(), "set add / remove agree with a bitmap");
    int prev = -1;
    bool sorted = true;
    int seen = 0;
    foreach (int k in s) {
        if (k <= prev || !in[k]) { sorted = false; }
        prev = k;
        seen++;
    }
    check(sorted && seen == cnt, "foreach over a set visits the keys in order");
    int out[600];
    int got = s.range(100, 199, &out[0], 600);
    int want = 0;
    for (int k = 100; k <= 199; k++) { if (in[k]) { want++; } }
    check(got == want && s.countRange(100, 199) == want, "set range");
    int lt = 0;
    for (int k = 0; k < 250; k++) { if (in[k]) { lt++; } }
    check(s.rank(250) == lt && s.at(lt, -1) >= 250, "set rank and at");
    s.dispose();
    check(s.size() == 0 && s.add(7) == 1 && s.has(7) && s.first() == 7, "a disposed set can be used again");
    s.dispose();
}

void textMaps() {
    ds.OrderedTextMap t();
    char* words[8] = { "pear", "apple", "fig", "banana", "cherry", "date", "apple pie", "" };
    for (int i = 0; i < 8; i++) { t.put(words[i], i); }
    check(t.size() == 8 && t.get("fig", -1) == 2 && t.get("figs", -1) == -1, "text keys");
    check(streq(t.first(), "") && streq(t.last(), "pear") && streq(t.ceil("b"), "banana") && streq(t.floor("b"), "apple pie"), "text ordering");
    check(t.higher("pear") == null && t.lower("") == null && streq(t.higher("apple"), "apple pie"), "text neighbours, null for none");
    char buf[16];
    strcpy(&buf[0], "fig");
    t.put(&buf[0], 99);                            // the key is copied, an equal key only changes the value
    strcpy(&buf[0], "zzz");
    check(t.size() == 8 && t.get("fig", -1) == 99 && !t.has("zzz"), "keys are copied");
    check(t.rank("c") == 4 && streq(t.select(3), "banana"), "text rank and select");
    char* ks[8];
    int vs[8];
    int n = t.range("b", "d", &ks[0], &vs[0], 8);
    check(n == 2 && streq(ks[0], "banana") && streq(ks[1], "cherry") && vs[1] == 4, "text range");
    check(t.remove("apple") && !t.remove("apple") && t.size() == 7 && t.verify(), "text remove");
    t.dispose();
    ds.OrderedTextSet ts();
    ts.add("one"); ts.add("two"); ts.add("three"); ts.add("one");
    check(ts.size() == 3 && ts.has("two") && streq(ts.get(0), "one") && streq(ts.get(2), "two"), "text set");
    ts.dispose();
}

// every class gives its memory back
void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.OrderedMap m();
    ds.OrderedTextMap t();
    ds.OrderedSet s();
    char name[16];
    for (int i = 0; i < 3000; i++) {
        m.put(i * 7, i);
        s.add(i);
        format(&name[0], 16, "key%d", i);
        t.put(&name[0], i);
    }
    for (int i = 0; i < 3000; i += 3) {
        m.remove(i * 7);
        format(&name[0], 16, "key%d", i);
        t.remove(&name[0]);
    }
    check(asys.memBlocks() > b0, "the structures hold memory");
    m.dispose();
    t.dispose();
    s.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees every block, also the text keys");
    ds.OrderedMap* p = new ds.OrderedMap();
    p->put(1, 2);
    p->dispose();
    check(asys.memBlocks() == b0, "dispose of a heap object");
}

int main() {
    randomOps();
    smallCases();
    comparatorMap();
    sets();
    textMaps();
    memory();
    printf("ordered: %d checks, %d failures\n", checks, fails);
    return fails;
}
