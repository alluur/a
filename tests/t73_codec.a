// codec: text <-> binary, image <-> binary, text <-> image, files
import codec;
import fixed;

int main() {
    // text <-> binary
    println(codec.textToBinary("Hi!", " "));
    println(codec.textToBinary("A", ""));
    println(codec.binaryToText("01001000 01101001 00100001"));
    println(codec.binaryToText("0100100001101001001000010101"));     // the last 4 digits are dropped
    println(codec.intToBinary(37, 8));
    printlnInt(codec.binaryToInt("100101"));
    char data[4]; data[0] = 255; data[1] = 0; data[2] = 170; data[3] = 1;
    char* bin = codec.bytesToBinary(data, 4, "|");
    println(bin);
    char back[8];
    printlnInt(codec.binaryToBytes(bin, back));
    printlnInt(back[0] == 255 && back[1] == 0 && back[2] == 170 && back[3] == 1);
    char bits[32];
    codec.bytesToBits(data, 4, bits);
    char packed[4];
    printlnInt(codec.bitsToBytes(bits, 32, packed));
    printlnInt(packed[2]);

    // image <-> binary
    codec.Image* img = codec.binaryToImage("01110\n10001\n11111\n10001\n10001\n");
    printlnInt(img->w); printlnInt(img->h);
    print(codec.imageToBinary(img, 128));
    print(codec.toAscii(img, 1));
    printlnInt(img->get(1, 0)); printlnInt(img->get(0, 0)); printlnInt(img->get(99, 99));
    char ib[25];
    codec.imageToBits(img, 128, ib);
    codec.Image* again = codec.bitsToImage(ib, 5, 5);
    printlnInt(again->px[1] == img->px[1] && again->px[0] == img->px[0]);
    codec.Image* big = img->scaleUp(3);
    printlnInt(big->w);
    codec.Image* small = big->resize(5, 5);
    printlnInt(small->px[1] == img->px[1] && small->px[6] == img->px[6]);

    // text <-> image (clean, scaled, two lines, with noise)
    codec.Image* t1 = codec.textToImage("Hello, World!", 1);
    printlnInt(t1->w); printlnInt(t1->h);
    println(codec.imageToText(t1, 0));
    println(codec.imageToText(codec.textToImage("Line one\nSecond line: 42", 2), 0));
    codec.Image* t3 = codec.textToImage("Noisy text", 4);
    fixed.seed(3);
    for (int k = 0; k < 40; k++) {                         // flip some single pixels
        int x = fixed.next() % t3->w;
        int y = fixed.next() % t3->h;
        t3->set(x, y, 255 - t3->get(x, y));
    }
    println(codec.imageToText(t3, 4));

    // files
    codec.Image* pic = codec.textToImage("File IO", 2);
    printlnInt(codec.writePgm(pic, "build/tests/t73.pgm"));
    codec.Image* p2 = codec.readPgm("build/tests/t73.pgm");
    println(codec.imageToText(p2, 2));
    printlnInt(codec.writePbm(pic, "build/tests/t73.pbm", 128, true));
    println(codec.imageToText(codec.readPbm("build/tests/t73.pbm"), 2));
    printlnInt(codec.writePbm(pic, "build/tests/t73b.pbm", 128, false));
    println(codec.imageToText(codec.readPbm("build/tests/t73b.pbm"), 2));
    printlnInt(codec.writeBmp(pic, "build/tests/t73.bmp"));
    codec.Image* b2 = codec.readBmp("build/tests/t73.bmp");
    printlnInt(b2->w == pic->w && b2->h == pic->h);
    println(codec.imageToText(b2, 2));
    printlnInt(codec.readBmp("build/tests/does_not_exist.bmp") == null);
    return 0;
}
