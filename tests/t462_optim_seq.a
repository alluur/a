// optim: special sequences and orthogonal polynomials: Fibonacci, Lucas, Catalan, harmonic and Bernoulli numbers, factorials, binomial coefficients, Legendre, Chebyshev,
// Hermite and Laguerre polynomials. Expected output: tests/algo2_ref/gen_t462.py (exact integers and fractions).
import cstdio;
import asys;
import optim;
import dmath;

void line(char* name, double v) {
    print(name);
    if (isNaN(v)) { println(" nan"); }
    else if (isInf(v) && v > 0.0) { println(" inf"); }
    else if (isInf(v)) { println(" -inf"); }
    else { printfd(" %.12g\n", __bits(v)); }
}

int main() {
    int base = asys.memInUse();
    // ---- Fibonacci and Lucas
    printf("Fibonacci 0 .. 20:");
    for (int i = 0; i <= 20; i++) { printfd(" %.0f", __bits(optim.fibonacciD(i))); }
    printf("\n");
    int fl[8] = {30, 40, 50, 70, 78, 79, 90, 100};
    for (int i = 0; i < 8; i++) {
        char name[32];
        sprintf(name, "F(%d)", fl[i]);
        line(name, optim.fibonacciD(fl[i]));
    }
    line("F(1476)", optim.fibonacciD(1476));
    line("F(1477)", optim.fibonacciD(1477));
    line("F(5000)", optim.fibonacciD(5000));
    printf("negative indexes F(-n) = (-1)^(n+1) F(n):");
    for (int i = 1; i <= 8; i++) { printfd(" %.0f", __bits(optim.fibonacciD(-i))); }
    printf("\n");
    printf("exact up to F(78): %d, F(n+1) / F(n) -> phi: %d\n", optim.fibonacciD(78) == 8944394323791464.0, dmath.fabs(optim.fibonacciD(60) / optim.fibonacciD(59) - 1.618033988749895) < 1.0e-15);
    printf("Lucas 0 .. 15:");
    for (int i = 0; i <= 15; i++) { printfd(" %.0f", __bits(optim.lucasD(i))); }
    printf("\n");
    line("L(60)", optim.lucasD(60));
    line("L(-5)", optim.lucasD(-5));
    line("L(1476)", optim.lucasD(1476));
    bool rel = true;
    for (int n = 1; n < 60; n++) { if (optim.lucasD(n) != optim.fibonacciD(n - 1) + optim.fibonacciD(n + 1)) { rel = false; } }
    printf("L(n) = F(n - 1) + F(n + 1) for n = 1 .. 59: %d\n", rel);

    // ---- Catalan, harmonic, factorial, binomial
    printf("Catalan 0 .. 15:");
    for (int i = 0; i <= 15; i++) { printfd(" %.0f", __bits(optim.catalanD(i))); }
    printf("\n");
    line("C(30)", optim.catalanD(30));
    line("C(50)", optim.catalanD(50));
    line("C(100)", optim.catalanD(100));
    line("C(-1)", optim.catalanD(-1));
    printf("Harmonic 1 .. 10:");
    for (int i = 1; i <= 10; i++) { printfd(" %.12g", __bits(optim.harmonicD(i))); }
    printf("\n");
    line("H(0)", optim.harmonicD(0));
    line("H(100)", optim.harmonicD(100));
    line("H(1000)", optim.harmonicD(1000));
    line("H(1001)", optim.harmonicD(1001));
    line("H(100000)", optim.harmonicD(100000));
    line("H(10000000)", optim.harmonicD(10000000));
    line("H(-3)", optim.harmonicD(-3));
    printf("Factorials 0 .. 22:");
    for (int i = 0; i <= 22; i++) { printfd(" %.0f", __bits(optim.factorialD(i))); }
    printf("\n");
    line("170!", optim.factorialD(170));
    line("171!", optim.factorialD(171));
    line("(-1)!", optim.factorialD(-1));
    printf("binomial(n, k) for n = 0 .. 8:");
    for (int n = 0; n <= 8; n++) { for (int k = 0; k <= n; k++) { printfd(" %.0f", __bits(optim.binomialD(n, k))); } printf(" |"); }
    printf("\n");
    line("C(60, 30)", optim.binomialD(60, 30));
    line("C(100, 50)", optim.binomialD(100, 50));
    line("C(52, 5)", optim.binomialD(52, 5));
    line("C(1000, 3)", optim.binomialD(1000, 3));
    line("C(5, 7)", optim.binomialD(5, 7));
    line("C(-1, 2)", optim.binomialD(-1, 2));
    line("C(5, -1)", optim.binomialD(5, -1));
    line("C(10, 10)", optim.binomialD(10, 10));

    // ---- Bernoulli numbers
    printf("Bernoulli 0 .. 12:");
    for (int i = 0; i <= 12; i++) { printfd(" %.12g", __bits(optim.bernoulliD(i))); }
    printf("\n");
    int bn[9] = {14, 20, 24, 30, 32, 40, 60, 100, 200};
    for (int i = 0; i < 9; i++) {
        char name[32];
        sprintf(name, "B(%d)", bn[i]);
        double v = optim.bernoulliD(bn[i]);
        print(name);
        printfd(" %.9g\n", __bits(v));
    }
    line("B(262)", optim.bernoulliD(262));
    line("B(261)", optim.bernoulliD(261));
    line("B(7)", optim.bernoulliD(7));
    line("B(-2)", optim.bernoulliD(-2));

    // ---- orthogonal polynomials
    double xs[5] = {-0.9, -0.3, 0.0, 0.45, 1.3};
    int degs[5] = {0, 1, 2, 5, 12};
    char* names[4] = {"Legendre P", "Chebyshev T", "Chebyshev U", "Hermite H"};
    for (int kind = 0; kind < 5; kind++) {
        char* nm = (kind < 4) ? names[kind] : "Laguerre L";
        for (int d = 0; d < 5; d++) {
            printf("%s_%d:", nm, degs[d]);
            for (int i = 0; i < 5; i++) {
                double v = 0.0;
                if (kind == 0) { v = optim.legendreP(degs[d], xs[i]); }
                if (kind == 1) { v = optim.chebyshevT(degs[d], xs[i]); }
                if (kind == 2) { v = optim.chebyshevU(degs[d], xs[i]); }
                if (kind == 3) { v = optim.hermiteH(degs[d], xs[i]); }
                if (kind == 4) { v = optim.laguerreL(degs[d], xs[i]); }
                printfd(" %.9g", __bits(v));
            }
            printf("\n");
        }
    }
    printfd("P_20(0.3) %.9g, T_20(0.3) %.9g, U_20(0.3) %.9g, H_20(0.3) %.9g, L_20(0.3) %.9g\n", __bits(optim.legendreP(20, 0.3)), __bits(optim.chebyshevT(20, 0.3)), __bits(optim.chebyshevU(20, 0.3)), __bits(optim.hermiteH(20, 0.3)), __bits(optim.laguerreL(20, 0.3)));
    printf("negative degrees are NaN: %d %d %d %d %d\n", isNaN(optim.legendreP(-1, 0.5)), isNaN(optim.chebyshevT(-1, 0.5)), isNaN(optim.chebyshevU(-1, 0.5)), isNaN(optim.hermiteH(-1, 0.5)), isNaN(optim.laguerreL(-1, 0.5)));
    // T_n(cos t) = cos(n t) and the orthogonality of the Legendre polynomials through Gauss-Legendre quadrature
    bool trig = true;
    for (int n = 0; n < 30; n++) {
        double t = 0.7;
        if (dmath.fabs(optim.chebyshevT(n, dmath.cos(t)) - dmath.cos((double) n * t)) > 1.0e-13) { trig = false; }
    }
    printf("T_n(cos t) = cos(n t) for n < 30: %d\n", trig);
    double x[12];
    double w[12];
    optim.gaussLegendre(12, x, w);
    double worst = 0.0;
    for (int a = 0; a < 6; a++) {
        for (int b = 0; b < 6; b++) {
            double s = 0.0;
            for (int i = 0; i < 12; i++) { s += w[i] * optim.legendreP(a, x[i]) * optim.legendreP(b, x[i]); }
            double want = (a == b) ? 2.0 / (2.0 * (double) a + 1.0) : 0.0;
            worst = dmath.fmax(worst, dmath.fabs(s - want));
        }
    }
    printf("Legendre polynomials are orthogonal (1e-14): %d\n", worst < 1.0e-14);
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
