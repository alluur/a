// sized integers in classes, globals, static locals, struct copies (odd sizes), arrays, pointers, switch, uint64_t ?:
class Packet {
    public uint8_t kind;
    public uint16_t len;
    public int32_t seq;
    public uint8_t data[5];
    public void fill(int k) { kind = k; len = k * 1000; seq = -k; for (int i = 0; i < 5; i++) data[i] = k + 250 + i; }
    public int total() { int s = kind + len + seq; for (int i = 0; i < 5; i++) s += data[i]; return s; }
}
struct Odd { int16_t a; int8_t b; int8_t c; int8_t d; }
uint16_t gx;
int8_t gy;
uint32_t gz;
uint64_t gw;
int counter() { static uint8_t n = 254; n++; return n; }
Odd mk(int v) { Odd o; o.a = v; o.b = v + 1; o.c = -v; o.d = 127 + v; return o; }
int sumOdd(Odd o) { return o.a + o.b + o.c + o.d; }
void p(int v) { printInt(v); print(" "); }
int main() {
    Packet* k = new Packet();
    k.fill(70);
    p(sizeof(Packet)); p(k.kind); p(k.len); p(k.seq); p(k.data[0]); p(k.data[4]); p(k.total()); println("");
    gx = 70000; gy = 200; gz = -1; gw = -1;
    p(gx); p(gy); p(gz); p(gw > 0); p(gw == 0xFFFFFFFFFFFFFFFF); println("");
    p(counter()); p(counter()); p(counter()); println("");
    Odd o = mk(5); Odd o2; o2 = o;
    p(sizeof(Odd)); p(o2.a); p(o2.b); p(o2.c); p(o2.d); p(sumOdd(o2)); println("");
    Odd arr[3]; arr[1] = mk(1); arr[2] = mk(2); p(arr[1].d); p(arr[2].d); p(arr[0].a); println("");
    int16_t buf[4] = {1, -2, 3, -4};
    int16_t* q = buf; int t = 0;
    while (q < buf + 4) { t = t * 10 + *q; *q++ = 7; }
    p(t); p(buf[0]); p(buf[3]); println("");
    uint8_t s8 = 3;
    switch (s8) { case 3: p(33); break; default: p(0); }
    if (s8) p(1); uint8_t z8 = 256; if (!z8) p(2); println("");
    uint64_t big = 0x8000000000000000;
    uint64_t r = big > 1 ? big : 1; p(r > 1); p((big | 1) > big); println("");
    int32_t neg = -5; uint32_t pos = neg; p(pos); p(neg < pos); p((int)pos + neg); println("");
    return 0;
}
