import net;

int main() {
    printlnInt(net.parseIp("127.0.0.1") == 0x7F000001);
    printlnInt(net.parseIp("10.20.30.40"));
    printlnInt(net.parseIp("300.1.1.1"));
    printlnInt(net.parseIp("1.2.3"));
    printlnInt(net.parseIp("localhost") == 0x7F000001);

    int server = net.listenOn("127.0.0.1", 47123, 4);
    if (server < 0) { println("listen failed"); return 1; }
    int client = net.connect("127.0.0.1", 47123);
    if (client < 0) { println("connect failed"); return 1; }
    int conn = net.accept(server);
    if (conn < 0) { println("accept failed"); return 1; }

    net.sendText(client, "hello server\r\nsecond line\n");
    char line[128];
    net.recvLine(conn, line, 128);   println(line);
    net.recvLine(conn, line, 128);   println(line);

    net.sendText(conn, "reply from server");
    char buf[64];
    int n = net.recv(client, buf, 63);
    buf[n] = 0;
    println(buf);

    // sending a large block: all bytes arrive
    char* big = alloc(100000);
    for (int i = 0; i < 100000; i++) big[i] = 'a' + (i % 26);
    int total = 0;
    int sent = 0;
    // send in chunks that fit the socket buffers, receive them on the other side
    while (sent < 100000) {
        net.send(client, &big[sent], 5000);
        sent = sent + 5000;
        int got = 0;
        while (got < 5000) {
            int r = net.recv(conn, buf, 63);
            if (r <= 0) { println("recv failed"); return 1; }
            got = got + r;
        }
        total = total + got;
    }
    printlnInt(total);

    net.close(client);
    printlnInt(net.recv(conn, buf, 63));     // 0: the peer closed
    net.close(conn);
    net.close(server);
    printlnInt(net.connect("127.0.0.1", 47124) < 0);   // nothing listens there
    return 0;
}
