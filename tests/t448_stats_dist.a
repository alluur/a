// function ids: the table rows are  parameters..., x, then the expected values (pdf, cdf, sf) or  parameters..., p, quantile
int evalRow(int fn, double* a, double* out) {
    if (fn == 1) { out[0] = stats.normalPdf(a[2], a[0], a[1]); out[1] = stats.normalCdf(a[2], a[0], a[1]); out[2] = stats.normalSf(a[2], a[0], a[1]); return 3; }
    if (fn == 2) { out[0] = stats.tPdf(a[1], a[0]); out[1] = stats.tCdf(a[1], a[0]); out[2] = stats.tSf(a[1], a[0]); return 3; }
    if (fn == 20) { out[0] = stats.tPdf(a[1], a[0]); out[1] = stats.tCdf(a[1], a[0]); out[2] = stats.tSf(a[1], a[0]); return 3; }
    if (fn == 3) { out[0] = stats.chi2Pdf(a[1], a[0]); out[1] = stats.chi2Cdf(a[1], a[0]); out[2] = stats.chi2Sf(a[1], a[0]); return 3; }
    if (fn == 4) { out[0] = stats.fPdf(a[2], a[0], a[1]); out[1] = stats.fCdf(a[2], a[0], a[1]); out[2] = stats.fSf(a[2], a[0], a[1]); return 3; }
    if (fn == 5) { out[0] = stats.gammaPdf(a[2], a[0], a[1]); out[1] = stats.gammaCdf(a[2], a[0], a[1]); out[2] = stats.gammaSf(a[2], a[0], a[1]); return 3; }
    if (fn == 6) { out[0] = stats.betaPdf(a[2], a[0], a[1]); out[1] = stats.betaCdf(a[2], a[0], a[1]); out[2] = stats.betaSf(a[2], a[0], a[1]); return 3; }
    if (fn == 7) { out[0] = stats.expPdf(a[1], a[0]); out[1] = stats.expCdf(a[1], a[0]); out[2] = stats.expSf(a[1], a[0]); return 3; }
    if (fn == 8) { out[0] = stats.lognormalPdf(a[2], a[0], a[1]); out[1] = stats.lognormalCdf(a[2], a[0], a[1]); return 2; }
    if (fn == 11) { out[0] = stats.normalQuantile(a[2], a[0], a[1]); return 1; }
    if (fn == 12) { out[0] = stats.tQuantile(a[1], a[0]); return 1; }
    if (fn == 13) { out[0] = stats.chi2Quantile(a[1], a[0]); return 1; }
    if (fn == 14) { out[0] = stats.fQuantile(a[2], a[0], a[1]); return 1; }
    if (fn == 15) { out[0] = stats.gammaQuantile(a[2], a[0], a[1]); return 1; }
    if (fn == 16) { out[0] = stats.betaQuantile(a[2], a[0], a[1]); return 1; }
    if (fn == 17) { out[0] = stats.expQuantile(a[1], a[0]); return 1; }
    if (fn == 18) { out[0] = stats.lognormalQuantile(a[2], a[0], a[1]); return 1; }
    return 0;
}

void family(char* name, int fn, double* t, int tableBytes, int nargs, int nout, double tol, char* tolText) {
    int cols = nargs + nout;
    int rows = tableBytes / 8 / cols;
    double worst = 0.0;
    int fails = 0;
    for (int r = 0; r < rows; r++) {
        double out[4];
        int got = evalRow(fn, &t[r * cols], &out[0]);
        for (int k = 0; k < nout; k++) {
            double want = t[r * cols + nargs + k];
            double err = dmath.fabs(out[k] - want);
            if (want != 0.0) { err = err / dmath.fabs(want); }
            if (!(err <= tol) || got != nout) {
                fails++;
                if (fails <= 3) {
                    printfd("  FAIL %s row %d result %d: got %.17g want %.17g\n", name, r, k, __bits(out[k]), __bits(want));
                }
            }
            if (err > worst) { worst = err; }
        }
    }
    if (PROBE) { printfd("  worst relative error of %s: %.2e\n", name, __bits(worst)); }
    printf("%s: all within %s: %d\n", name, tolText, fails == 0);
}

void show(char* label, double v) {
    print(label);
    if (v != v) { println(" nan"); }
    else if (v > 1.0e308 * 10.0) { println(" inf"); }
    else if (v < -1.0e308 * 10.0) { println(" -inf"); }
    else { printfd(" %.10g\n", __bits(v)); }
}

void limits() {
    double inf = dmath.INFINITY;
    double nan = dmath.nan();
    show("normalPdf sigma 0", stats.normalPdf(0.0, 0.0, 0.0));
    show("normalCdf sigma -1", stats.normalCdf(0.0, 0.0, -1.0));
    show("normalCdf(inf)", stats.normalCdf(inf, 0.0, 1.0));
    show("normalCdf(-inf)", stats.normalCdf(-inf, 0.0, 1.0));
    show("normalCdf(nan)", stats.normalCdf(nan, 0.0, 1.0));
    show("normalSf(10)", stats.normalSf(10.0, 0.0, 1.0));
    show("normalLogPdf(1, 0, 2)", stats.normalLogPdf(1.0, 0.0, 2.0));
    show("normalQuantile(0.975, 10, 2)", stats.normalQuantile(0.975, 10.0, 2.0));
    show("tPdf df 0", stats.tPdf(0.0, 0.0));
    show("tCdf df -1", stats.tCdf(0.0, -1.0));
    show("tCdf(inf, 5)", stats.tCdf(inf, 5.0));
    show("tCdf(-inf, 5)", stats.tCdf(-inf, 5.0));
    show("tCdf(0, 5)", stats.tCdf(0.0, 5.0));
    show("tCdf(1.5, df inf) = normal", stats.tCdf(1.5, inf) - stats.stdNormalCdf(1.5));
    show("tSf(nan, 5)", stats.tSf(nan, 5.0));
    show("tCdf(1, 1) (Cauchy)", stats.tCdf(1.0, 1.0));
    show("tQuantile(0.75, 1) (Cauchy)", stats.tQuantile(0.75, 1.0));
    show("tQuantile(0, 3)", stats.tQuantile(0.0, 3.0));
    show("tQuantile(1, 3)", stats.tQuantile(1.0, 3.0));
    show("tQuantile(0.5, 3)", stats.tQuantile(0.5, 3.0));
    show("tQuantile(1.5, 3)", stats.tQuantile(1.5, 3.0));
    show("tQuantile(0.9, 0)", stats.tQuantile(0.9, 0.0));
    show("chi2Cdf(-1, 3)", stats.chi2Cdf(-1.0, 3.0));
    show("chi2Sf(-1, 3)", stats.chi2Sf(-1.0, 3.0));
    show("chi2Pdf(0, 1)", stats.chi2Pdf(0.0, 1.0));
    show("chi2Pdf(0, 2)", stats.chi2Pdf(0.0, 2.0));
    show("chi2Pdf(0, 3)", stats.chi2Pdf(0.0, 3.0));
    show("chi2Pdf(-2, 3)", stats.chi2Pdf(-2.0, 3.0));
    show("chi2Cdf(5, 0)", stats.chi2Cdf(5.0, 0.0));
    show("chi2Quantile(0, 4)", stats.chi2Quantile(0.0, 4.0));
    show("chi2Quantile(1, 4)", stats.chi2Quantile(1.0, 4.0));
    show("chi2Quantile(0.95, 1)", stats.chi2Quantile(0.95, 1.0));
    show("fPdf(0, 1, 5)", stats.fPdf(0.0, 1.0, 5.0));
    show("fPdf(0, 2, 5)", stats.fPdf(0.0, 2.0, 5.0));
    show("fPdf(0, 4, 5)", stats.fPdf(0.0, 4.0, 5.0));
    show("fCdf(-1, 3, 4)", stats.fCdf(-1.0, 3.0, 4.0));
    show("fCdf(inf, 3, 4)", stats.fCdf(inf, 3.0, 4.0));
    show("fCdf(1, 0, 4)", stats.fCdf(1.0, 0.0, 4.0));
    show("fQuantile(0, 3, 4)", stats.fQuantile(0.0, 3.0, 4.0));
    show("fQuantile(1, 3, 4)", stats.fQuantile(1.0, 3.0, 4.0));
    show("fQuantile(0.95, 1, 1)", stats.fQuantile(0.95, 1.0, 1.0));
    show("gammaPdf(0, 0.5, 1)", stats.gammaPdf(0.0, 0.5, 1.0));
    show("gammaPdf(0, 1, 2)", stats.gammaPdf(0.0, 1.0, 2.0));
    show("gammaPdf(0, 2, 1)", stats.gammaPdf(0.0, 2.0, 1.0));
    show("gammaCdf(1, 2, 0)", stats.gammaCdf(1.0, 2.0, 0.0));
    show("gammaQuantile(0.5, 1, 1) = ln 2", stats.gammaQuantile(0.5, 1.0, 1.0));
    show("betaPdf(0, 0.5, 2)", stats.betaPdf(0.0, 0.5, 2.0));
    show("betaPdf(0, 1, 3)", stats.betaPdf(0.0, 1.0, 3.0));
    show("betaPdf(1, 2, 0.5)", stats.betaPdf(1.0, 2.0, 0.5));
    show("betaPdf(1.5, 2, 2)", stats.betaPdf(1.5, 2.0, 2.0));
    show("betaCdf(-1, 2, 2)", stats.betaCdf(-1.0, 2.0, 2.0));
    show("betaCdf(2, 2, 2)", stats.betaCdf(2.0, 2.0, 2.0));
    show("betaQuantile(0, 2, 2)", stats.betaQuantile(0.0, 2.0, 2.0));
    show("betaQuantile(1, 2, 2)", stats.betaQuantile(1.0, 2.0, 2.0));
    show("betaQuantile(0.5, 3, 3)", stats.betaQuantile(0.5, 3.0, 3.0));
    show("expPdf(-1, 2)", stats.expPdf(-1.0, 2.0));
    show("expCdf(-1, 2)", stats.expCdf(-1.0, 2.0));
    show("expCdf(1e-20, 1)", stats.expCdf(1.0e-20, 1.0));
    show("expQuantile(1, 2)", stats.expQuantile(1.0, 2.0));
    show("expQuantile(0.5, 0)", stats.expQuantile(0.5, 0.0));
    show("uniformPdf(0.5, 0, 1)", stats.uniformPdf(0.5, 0.0, 1.0));
    show("uniformPdf(2, 0, 1)", stats.uniformPdf(2.0, 0.0, 1.0));
    show("uniformPdf(1, 1, 1)", stats.uniformPdf(1.0, 1.0, 1.0));
    show("uniformCdf(2.5, -2.5, 4)", stats.uniformCdf(2.5, -2.5, 4.0));
    show("uniformCdf(-9, -2.5, 4)", stats.uniformCdf(-9.0, -2.5, 4.0));
    show("uniformCdf(9, -2.5, 4)", stats.uniformCdf(9.0, -2.5, 4.0));
    show("uniformQuantile(0.25, -2.5, 4)", stats.uniformQuantile(0.25, -2.5, 4.0));
    show("uniformQuantile(1.5, 0, 1)", stats.uniformQuantile(1.5, 0.0, 1.0));
    show("lognormalCdf(0, 0, 1)", stats.lognormalCdf(0.0, 0.0, 1.0));
    show("lognormalPdf(-1, 0, 1)", stats.lognormalPdf(-1.0, 0.0, 1.0));
    show("lognormalQuantile(0.5, 2, 1) = e^2", stats.lognormalQuantile(0.5, 2.0, 1.0));
    show("lognormalQuantile(0, 0, 1)", stats.lognormalQuantile(0.0, 0.0, 1.0));
}

int main() {
    family("normal pdf, cdf, sf", 1, T_NORMAL, sizeof(T_NORMAL), 3, 3, 3.0e-14, "3e-14");
    family("t pdf, cdf, sf", 2, T_T, sizeof(T_T), 2, 3, 1.0e-12, "1e-12");
