-- characters and UTF-8
a -> a
Z -> Z
hi! -> h i !
~ -> ~
é -> é
€ -> €
😀 -> 😀
� -> �
� -> �
�A -> � A
-- control characters
^A -> Ctrl+A
^C -> Ctrl+C
^Z -> Ctrl+Z
\r -> Enter
\n -> Ctrl+Enter
^I -> Tab
^? -> Backspace
^H -> Backspace
 -> Ctrl+Space
^\^]^^^_ -> Ctrl+\ Ctrl+] Ctrl+^ Ctrl+/
-- Esc and Alt
\e -> Esc
\ex -> Alt+x
\eX -> Alt+X
\e\r -> Alt+Enter
\e^? -> Alt+Backspace
\e^A -> Ctrl+Alt+A
\e\e -> Alt+Esc
\e\e[A -> Alt+Up
\e[ -> Alt+[
\eO -> Alt+O
\eé -> Alt+é
-- arrows, home, end
\e[A\e[B\e[C\e[D -> Up Down Right Left
\eOA\eOB\eOC\eOD -> Up Down Right Left
\e[H\e[F\eOH\eOF -> Home End Home End
\e[1~\e[4~\e[7~\e[8~ -> Home End Home End
\e[E -> Begin
-- modifiers on arrows (xterm: 2 shift, 3 alt, 4 shift+alt, 5 ctrl, 6, 7, 8, 9 meta)
\e[1;2A -> Shift+Up
\e[1;3B -> Alt+Down
\e[1;4C -> Alt+Shift+Right
\e[1;5D -> Ctrl+Left
\e[1;6A -> Ctrl+Shift+Up
\e[1;7B -> Ctrl+Alt+Down
\e[1;8C -> Ctrl+Alt+Shift+Right
\e[1;9D -> Meta+Left
\e[1;5H\e[1;2F -> Ctrl+Home Shift+End
-- editing keys
\e[2~\e[3~\e[5~\e[6~ -> Insert Delete PgUp PgDn
\e[3;5~ -> Ctrl+Delete
\e[3;2~ -> Shift+Delete
\e[5;3~ -> Alt+PgUp
-- function keys
\eOP\eOQ\eOR\eOS -> F1 F2 F3 F4
\e[11~\e[12~\e[13~\e[14~ -> F1 F2 F3 F4
\e[15~\e[17~\e[18~\e[19~\e[20~\e[21~\e[23~\e[24~ -> F5 F6 F7 F8 F9 F10 F11 F12
\e[[A\e[[B\e[[C\e[[D\e[[E -> F1 F2 F3 F4 F5
\e[25~\e[26~\e[28~\e[29~\e[31~\e[32~\e[33~\e[34~ -> F13 F14 F15 F16 F17 F18 F19 F20
\e[1;5P -> Ctrl+F1
\e[1;2Q -> Shift+F2
\e[1;3R -> Alt+F3
\e[1;6S -> Ctrl+Shift+F4
\e[15;5~ -> Ctrl+F5
\e[24;2~ -> Shift+F12
\e[17;7~ -> Ctrl+Alt+F6
-- tab
\e[Z -> Shift+Tab
\e[1;5Z -> Ctrl+Shift+Tab
-- keypad in application mode
\eOM\eOp\eOq\eOy\eOk\eOm\eOo\eOj -> Enter 0 1 9 + - / *
-- fixterms / kitty / modifyOtherKeys
\e[97;5u -> Ctrl+A
\e[13;2u -> Shift+Enter
\e[27;5;13~ -> Ctrl+Enter
\e[27;3;9~ -> Alt+Tab
\e[27;5;105~ -> Ctrl+I
\e[233;3u -> Alt+é
\e[57344u ->
-- unknown or foreign sequences are dropped
\e[?1;2c ->
\e[?25;1$y ->
\e[99~ ->
\e[200;1H ->
\e[38:2::1:2:3m ->
-- focus and replies
\e[I\e[O -> Focus in Focus out
\e[24;80R ->
\e[8;24;80t -> Size report 24;80
-- byte by byte with a flush between (the Esc timeout)
pending: yes
no event yet
 -> Ctrl+Right
pending: no
-- Enter followed by NUL in the same read (telnet) is one Enter
CR NUL -> Enter
-- a NUL in the next read is Ctrl+Space (Enter, then Ctrl+Space for completion)
CR | NUL -> Enter Ctrl+Space
x NUL -> x Ctrl+Space
-- crNul off: the NUL is never dropped
CR NUL -> Enter Ctrl+Space
