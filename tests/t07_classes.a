class Counter {
    private int n;
    public int step;
    Counter(int start, int step) { this.n = start; this.step = step; }
    public void inc() { n = n + step; }
    public int get() { return n; }
    private int secret() { return 42; }
    public int reveal() { return secret() + n; }
}

class Animal {
    char* name;
    int legs;
    public Animal(char* name, int legs) { this.name = name; this.legs = legs; }
    public void describe() {
        print(name); print(" has "); printInt(legs); println(" legs");
    }
}

class Stack {
    private int data[16];
    private int top;
    public void push(int v) { data[top] = v; top++; }
    public int pop() { top--; return data[top]; }
    public bool empty() { return top == 0; }
}

int main() {
    Counter c(10, 5);
    c.inc(); c.inc();
    printlnInt(c.get());
    printlnInt(c.reveal());
    Counter* p = new Counter(1, 1);
    p->inc();
    printlnInt(p->get());
    p.step = 100;
    p->inc();
    printlnInt(p->get());
    Animal* a = new Animal("dog", 4);
    a->describe();
    Stack s;
    s.push(1); s.push(2); s.push(3);
    while (!s.empty()) printlnInt(s.pop());
    return 0;
}
