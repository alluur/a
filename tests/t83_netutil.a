// netutil and rawnet: Wake-on-LAN, NTP, ping, tcpPing, raw frames on the loopback interface (when allowed)
import netutil;
import rawnet;
import packet;
import netaddr;
import net;

int main() {
    // Wake-on-LAN: the magic packet, then really sent to a UDP socket of ours
    char pkt[110];
    printlnInt(netutil.wolPacket("aa:bb:cc:00:11:22", pkt));
    printlnInt(pkt[0] == 255 && pkt[5] == 255 && pkt[6] == 0xaa && pkt[101] == 0x22 && pkt[6 + 6 * 7 + 3] == 0);
    printlnInt(netutil.wolPacket("not a mac", pkt));
    int s = net.udpBind(0);
    net.setTimeout(s, 1000);
    printlnInt(netutil.wakeOnLanTo("aa:bb:cc:00:11:22", 0x7F000001, net.localPort(s)));
    char buf[200];
    printlnInt(net.recvFrom(s, buf, 200, null, null));

    // NTP: the request and a handmade reply, then a real exchange with a fake server on the loopback interface
    char req[48];
    printlnInt(netutil.ntpBuildRequest(req));
    printlnInt(req[0]);
    char rep[48];
    for (int i = 0; i < 48; i++) rep[i] = 0;
    rep[0] = 0x24; rep[1] = 2;                       // mode 4 (server), stratum 2
    // 2024-01-01 00:00:00 UTC = 1704067200 = 3913056000 since 1900
    rep[40] = 0xE9; rep[41] = 0x3C; rep[42] = 0x7F; rep[43] = 0x00;
    printlnInt(netutil.ntpParse(rep, 48));
    rep[1] = 0;
    printlnInt(netutil.ntpParse(rep, 48));          // stratum 0: not usable
    rep[1] = 2;
    netutil.NtpPending* p = netutil.ntpStart(0x7F000001, net.localPort(s));
    int ip; int port;
    printlnInt(net.recvFrom(s, buf, 200, &ip, &port));
    printlnInt(buf[0]);
    net.sendTo(s, ip, port, rep, 48);
    printlnInt(netutil.ntpFinish(p, 1000));

    // tcpPing and portOpen
    int l = net.listenOn("127.0.0.1", 47151, 4);
    printlnInt(netutil.tcpPing("127.0.0.1", 47151, 1000) >= 0);
    printlnInt(netutil.portOpen("127.0.0.1", 47151, 1000));
    net.close(l);
    printlnInt(netutil.tcpPing("127.0.0.1", 47151, 300));
    printlnInt(netutil.portOpen("127.0.0.1", 47151, 300));

    // ping: a time in ms (0 or more), -1 no answer, -2 not allowed here; all three are fine
    int r = netutil.ping("127.0.0.1", 1000);
    printlnInt(r >= -2);

    // raw frames on the loopback interface, only if this program may open packet sockets
    int h = rawnet.open("lo");
    int ok = 1;
    if (h >= 0) {
        char mac[6];
        for (int i = 0; i < 6; i++) mac[i] = 0;
        char frame[100];
        int n = packet.ethBuild(mac, mac, 0x88B5, "ping-pong", 9, frame);
        ok = 0;
        if (rawnet.send(h, frame, n) == n) {
            for (int tries = 0; tries < 20 && ok == 0; tries++) {
                char rb[200];
                int got = rawnet.recv(h, rb, 200, 200);
                if (got == n && rb[12] == 0x88 && rb[13] == 0xB5 && rb[14] == 'p') ok = 1;
            }
        }
        rawnet.close(h);
    }
    printlnInt(ok);
    printlnInt(rawnet.open("no-such-interface") < 0);
    return 0;
}
