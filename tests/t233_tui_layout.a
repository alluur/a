// tui: layout - Box (flex, fixed sizes, alignment), Frame, Splitter, TabView, overlays on resize, themes without colour
import tui;
import term;
import tscreen;

tui.App* app;

int main() {
    println("-- vertical box: preferred sizes and flex");
    app = new tui.App();
    app->initHeadless(30, 10);
    tui.Box* col = tui.vbox(0, 0);
    col->add(new tui.Label("fixed one"));
    tui.Label* mid = new tui.Label("flex 1");
    mid->flex = 1;
    mid->setStyle(tscreen.style(0, 0, 0));
    col->add(mid);
    tui.Label* mid2 = new tui.Label("flex 2");
    mid2->flex = 2;
    col->add(mid2);
    col->add(new tui.Label("fixed two"));
    app->setRoot(col);
    app->pump(0);
    printf("heights: %d %d %d %d, y: %d %d %d %d\n", col->kids[0]->h, col->kids[1]->h, col->kids[2]->h, col->kids[3]->h,
           col->kids[0]->y, col->kids[1]->y, col->kids[2]->y, col->kids[3]->y);

    println("-- horizontal box with spacing and padding");
    app = new tui.App();
    app->initHeadless(30, 5);
    tui.Box* row = tui.hbox(2, 1);
    row->add(new tui.Label("aa"));
    tui.Label* f1 = new tui.Label("f1");
    f1->flex = 1;
    row->add(f1);
    tui.Label* f3 = new tui.Label("f3");
    f3->flex = 3;
    row->add(f3);
    row->add(new tui.Label("zz"));
    app->setRoot(row);
    app->pump(0);
    printf("x: %d %d %d %d, widths: %d %d %d %d\n", row->kids[0]->x, row->kids[1]->x, row->kids[2]->x, row->kids[3]->x,
           row->kids[0]->w, row->kids[1]->w, row->kids[2]->w, row->kids[3]->w);
    printf("heights %d (a padding of 1 above and below)\n", row->kids[0]->h);
    printf("preferred size of the box: %d x %d\n", row->prefW(), row->prefH());

    println("-- alignment in a box, hidden children, fixed sizes");
    app = new tui.App();
    app->initHeadless(20, 8);
    col = tui.vbox(0, 0);
    tui.Button* b1 = new tui.Button("Left");
    b1->halign = 1;
    tui.Button* b2 = new tui.Button("Centre");
    b2->halign = 2;
    tui.Button* b3 = new tui.Button("Right");
    b3->halign = 3;
    tui.Button* b4 = new tui.Button("Fill");
    col->add(b1); col->add(b2); col->add(b3); col->add(b4);
    app->setRoot(col);
    println(app->text());
    b2->setVisible(false);
    println(app->text());
    b2->setVisible(true);
    b4->fixedW = 8;
    b4->halign = 2;
    println(app->text());

    println("-- a frame with a title");
    app = new tui.App();
    app->initHeadless(24, 7);
    tui.Frame* fr = new tui.Frame("Settings");
    tui.Box* inner = tui.vbox(0, 0);
    inner->add(new tui.CheckBox("enabled"));
    inner->add(new tui.CheckBox("verbose"));
    fr->add(inner);
    app->setRoot(fr);
    println(app->text());
    fr->setTitle("A much much too long title");
    println(app->text());
    fr->kind = tscreen.BOX_DOUBLE;
    println(app->text());

    println("-- a splitter: positions, the mouse, minimum sizes and a resize");
    app = new tui.App();
    app->initHeadless(31, 6);
    tui.Splitter* sp = new tui.Splitter(true);
    tui.Label* left = new tui.Label("left pane");
    tui.Label* right = new tui.Label("right pane");
    sp->add(left);
    sp->add(right);
    app->setRoot(sp);
    println(app->text());
    printf("first %d, second at %d width %d\n", sp->firstSize(), right->x, right->w);
    app->mouseDown(sp->firstSize(), 2);
    app->mouseDrag(10, 2);
    app->mouseDrag(8, 2);
    app->mouseUp(8, 2);
    printf("dragged to column 8: first %d\n", sp->firstSize());
    println(app->text());
    app->mouseDown(sp->firstSize(), 2);
    app->mouseDrag(0, 2);
    app->mouseUp(0, 2);
    printf("minimum size: first %d\n", sp->firstSize());
    app->mouseDown(sp->firstSize(), 2);
    app->mouseDrag(40, 2);
    app->mouseUp(40, 2);
    printf("maximum: first %d, second %d\n", sp->firstSize(), right->w);
    app->mouseDown(2, 2);
    app->mouseUp(2, 2);
    printf("pressing somewhere else does not move it: %d\n", sp->firstSize());
    sp->setFirstSize(10);
    app->resizeTo(61, 6);
    app->pump(0);
    printf("after a resize to 61 columns: first %d, second %d (the ratio is kept)\n", sp->firstSize(), right->w);
    println("-- a horizontal divider");
    tui.Splitter* hs = new tui.Splitter(false);
    hs->add(new tui.Label("top"));
    hs->add(new tui.Label("bottom"));
    app->setRoot(hs);
    app->resizeTo(20, 7);
    println(app->text());

    println("-- tabs");
    app = new tui.App();
    app->initHeadless(30, 6);
    tui.TabView* tv = new tui.TabView();
    tui.Label* p1 = new tui.Label("page one");
    tui.Label* p2 = new tui.Label("page two");
    tui.Label* p3 = new tui.Label("page three");
    tv->addPage(p1, "&One");
    tv->addPage(p2, "&Two");
    tv->addPage(p3, "T&hree");
    app->setRoot(tv);
    println(app->text());
    printf("current %d, pages %d\n", tv->current(), tv->pageCount());
    app->press("Alt+2");
    printf("Alt+2: %d\n", tv->current());
    println(app->text());
    app->press("Ctrl+PgDn");
    printf("Ctrl+PgDn: %d, ", tv->current());
    app->press("Ctrl+PgDn");
    printf("wraps: %d, ", tv->current());
    app->press("Ctrl+PgUp");
    printf("Ctrl+PgUp: %d\n", tv->current());
    app->click(2, 0);
    printf("click on the first tab: %d\n", tv->current());
    app->press("Right");
    printf("Right on the tab bar: %d\n", tv->current());
    tv->bar->closable = true;
    println(app->text());
    tv->closePage(1);
    printf("after closing page 1: pages %d, current %d\n", tv->pageCount(), tv->current());
    println(app->text());

    println("-- overlays: shadow, clamping to the screen, re-centering after a resize");
    app = new tui.App();
    app->initHeadless(30, 10);
    app->setRoot(new tui.Label("background"));
    tui.Dialog* d = new tui.Dialog("Hi", new tui.Label("a dialog"));
    d->addButton("OK", 1, true);
    app->showDialog(d);
    printf("dialog at %d,%d size %dx%d\n", d->x, d->y, d->w, d->h);
    println(app->text());
    app->resizeTo(60, 20);
    app->pump(0);
    printf("after growing to 60x20: dialog at %d,%d\n", d->x, d->y);
    app->resizeTo(14, 6);
    app->pump(0);
    printf("after shrinking to 14x6: dialog at %d,%d size %dx%d\n", d->x, d->y, d->w, d->h);
    println(app->text());
    println("-- dragging a dialog by its title");
    app->resizeTo(40, 12);
    app->pump(0);
    printf("start at %d,%d\n", d->x, d->y);
    app->mouseDown(d->x + 2, d->y);
    app->mouseDrag(d->x + 12, d->y + 3);
    app->mouseUp(d->x + 12, d->y + 3);
    printf("moved to %d,%d\n", d->x, d->y);

    println("-- the mono theme uses only attributes");
    app = new tui.App();
    app->initHeadless(20, 3, term.COLORS_NONE);
    printf("theme chosen for no colours: input style %x, selection attr %d\n", tui.theme->input, tscreen.attrOf(tui.theme->selection));
    tui.Box* mb = tui.vbox(0, 0);
    mb->add(new tui.Button("Press"));
    mb->add(new tui.CheckBox("check"));
    app->setRoot(mb);
    println(app->text());
    int s = app->screen->styleAt(2, 0);
    printf("a focused button is reverse: %d\n", (tscreen.attrOf(s) & tscreen.A_REVERSE) != 0);
    printf("colours used: fg %x bg %x\n", tscreen.fgOf(s), tscreen.bgOf(s));
    return 0;
}
