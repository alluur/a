// rng: the distributions themselves: moments, bin counts against exact probabilities (also the parts that NumPy does not share: the split binomial),
// normal and exponential tails, edge cases. Fixed seeds, so the result never varies.
import cstdio;
import cstring;
import asys;
import dmath;
import rng;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

// mean and central moments of n samples
double m1;
double m2;
double m3;
double m4;

void moments(rng.Rng* g, int kind, double p1, double p2, int n) {
    double* v = (double*) alloc(n * 8);
    double sum = 0.0;
    for (int i = 0; i < n; i++) {
        double x = 0.0;
        if (kind == 0) { x = g->normal(); }
        else if (kind == 1) { x = g->exponential(); }
        else if (kind == 2) { x = g->gamma(p1); }
        else if (kind == 3) { x = g->beta(p1, p2); }
        else if (kind == 4) { x = g->chiSquared(p1); }
        else if (kind == 5) { x = (double) g->poisson(p1); }
        else if (kind == 6) { x = (double) g->binomial((int) p2, p1); }
        else if (kind == 7) { x = (double) g->geometric(p1); }
        else if (kind == 8) { x = g->lognormal(p1, p2); }
        v[i] = x;
        sum = sum + x;
    }
    m1 = sum / (double) n;
    double s2 = 0.0;
    double s3 = 0.0;
    double s4 = 0.0;
    for (int i = 0; i < n; i++) {
        double d = v[i] - m1;
        s2 = s2 + d * d;
        s3 = s3 + d * d * d;
        s4 = s4 + d * d * d * d;
    }
    m2 = s2 / (double) n;
    m3 = s3 / (double) n;
    m4 = s4 / (double) n;
}

bool near(double v, double want, double tol) {
    double d = v - want;
    if (d < 0.0) { d = -d; }
    return d <= tol;
}

void distributionChecks() {
    rng.Xoshiro256 g(20260101);
    moments(&g, 0, 0.0, 0.0, 25000);
    check(near(m1, 0.0, 0.03) && near(m2, 1.0, 0.04) && near(m3, 0.0, 0.1) && near(m4, 3.0, 0.25), "normal: mean 0, variance 1, skewness 0, kurtosis 3");
    moments(&g, 1, 0.0, 0.0, 25000);
    check(near(m1, 1.0, 0.04) && near(m2, 1.0, 0.06) && near(m3, 2.0, 0.5) && near(m4, 9.0, 2.5), "exponential: mean 1, variance 1, third moment 2, fourth 9");
    moments(&g, 2, 3.5, 0.0, 8000);
    check(near(m1, 3.5, 0.12) && near(m2, 3.5, 0.4), "gamma(3.5): mean 3.5, variance 3.5");
    moments(&g, 2, 0.4, 0.0, 1200);
    check(near(m1, 0.4, 0.06) && near(m2, 0.4, 0.11), "gamma(0.4): mean 0.4, variance 0.4");
    moments(&g, 3, 2.0, 5.0, 6000);
    check(near(m1, 2.0 / 7.0, 0.01) && near(m2, 10.0 / (49.0 * 8.0), 0.004), "beta(2, 5): mean 2/7, variance 5 * 2 / (49 * 8)");
    moments(&g, 3, 0.5, 0.5, 800);
    check(near(m1, 0.5, 0.04) && near(m2, 0.125, 0.02), "beta(0.5, 0.5): mean 0.5, variance 1/8");
    moments(&g, 4, 5.0, 0.0, 10000);
    check(near(m1, 5.0, 0.17) && near(m2, 10.0, 0.7), "chi-squared(5): mean 5, variance 10");
    moments(&g, 8, 0.0, 0.5, 3000);
    double wantMean = dmath.exp(0.125);
    check(near(m1, wantMean, 0.05), "lognormal(0, 0.5): mean exp(1/8)");
    moments(&g, 5, 4.5, 0.0, 15000);
    check(near(m1, 4.5, 0.08) && near(m2, 4.5, 0.28), "poisson(4.5): mean and variance 4.5");
    moments(&g, 5, 250.0, 0.0, 4000);
    check(near(m1, 250.0, 1.1) && near(m2, 250.0, 25.0), "poisson(250): mean and variance 250");
    moments(&g, 6, 0.25, 40.0, 10000);
    check(near(m1, 10.0, 0.14) && near(m2, 7.5, 0.4), "binomial(40, 0.25): mean 10, variance 7.5");
    moments(&g, 7, 0.3, 0.0, 15000);
    check(near(m1, 1.0 / 0.3, 0.1) && near(m2, 0.7 / (0.3 * 0.3), 0.7), "geometric(0.3): mean 1/p, variance (1 - p) / p^2");
    // the order statistic split of binomial (n * p above 30) is not NumPy's algorithm: mean, variance and the exact probabilities
    moments(&g, 6, 0.3, 1000000.0, 250);
    check(near(m1, 300000.0, 110.0) && near(m2, 210000.0, 80000.0), "binomial(10^6, 0.3): mean 300000, variance 210000");
    moments(&g, 6, 0.9, 100000.0, 250);
    check(near(m1, 90000.0, 60.0) && near(m2, 9000.0, 3500.0), "binomial(100000, 0.9): the p > 1/2 branch");
}

// the exact binomial probabilities by the recurrence p(k+1) = p(k) * (n - k) / (k + 1) * p / (1 - p), starting from (1 - p)^n
void binomialPmf(int n, double p, double* pmf) {
    pmf[0] = dmath.exp((double) n * dmath.log(1.0 - p));
    for (int k = 0; k < n; k++) { pmf[k + 1] = pmf[k] * (double) (n - k) / (double) (k + 1) * p / (1.0 - p); }
}

void binomialGoodness() {
    // n = 100, p = 0.5 goes through the split (np = 50 > 30): 20000 draws, 9 bins of the values, chi-square against the exact probabilities
    int n = 100;
    double pmf[101];
    binomialPmf(n, 0.5, &pmf[0]);
    rng.Xoshiro256 g(8128);
    int draws = 3000;
    int counts[101];
    for (int i = 0; i < draws; i++) { counts[g.binomial(n, 0.5)]++; }
    // bins: <= 42, 43..45, 46, 47, 48..52 ... use 11 bins by value
    int edges[10] = { 43, 45, 47, 49, 50, 51, 53, 55, 57, 59 };
    double stat = 0.0;
    int lo = 0;
    for (int b = 0; b <= 10; b++) {
        int hi = (b < 10) ? edges[b] : 101;
        double pr = 0.0;
        int obs = 0;
        for (int k = lo; k < hi; k++) { pr = pr + pmf[k]; obs = obs + counts[k]; }
        double exp = pr * (double) draws;
        double d = (double) obs - exp;
        stat = stat + d * d / exp;
        lo = hi;
    }
    check(stat < 35.0, "binomial(100, 0.5) (split algorithm) matches the exact probabilities: chi-square, 10 degrees of freedom");
    // the symmetric case p = 0.9: n = 100
    binomialPmf(n, 0.9, &pmf[0]);
    int c2[101];
    for (int i = 0; i < draws; i++) { c2[g.binomial(n, 0.9)]++; }
    int edges2[8] = { 84, 86, 88, 89, 90, 91, 93, 95 };
    stat = 0.0;
    lo = 0;
    for (int b = 0; b <= 8; b++) {
        int hi = (b < 8) ? edges2[b] : 101;
        double pr = 0.0;
        int obs = 0;
        for (int k = lo; k < hi; k++) { pr = pr + pmf[k]; obs = obs + c2[k]; }
        double exp = pr * (double) draws;
        double d = (double) obs - exp;
        stat = stat + d * d / exp;
        lo = hi;
    }
    check(stat < 30.0, "binomial(100, 0.9) matches the exact probabilities");
    // the range
    bool ok = true;
    for (int i = 0; i < 2000; i++) {
        int v = g.binomial(1000, 0.5);
        if (v < 0 || v > 1000) { ok = false; }
        int w = g.binomial(7, 0.999);
        if (w < 0 || w > 7) { ok = false; }
    }
    check(ok, "binomial stays in 0..n");
    check(g.binomial(0, 0.5) == 0 && g.binomial(-3, 0.5) == 0 && g.binomial(10, 0.0) == 0 && g.binomial(10, 1.0) == 10 && g.binomial(10, -1.0) == 0 && g.binomial(10, 2.0) == 10, "binomial: n <= 0, p <= 0, p >= 1");
}

void poissonGoodness() {
    rng.Xoshiro256 g(4242);
    // lambda = 3: bins 0..9, 10+
    double lam = 3.0;
    int draws = 20000;
    int counts[12];
    for (int i = 0; i < draws; i++) { int k = g.poisson(lam); if (k > 10) { k = 10; } counts[k]++; }
    double pk = dmath.exp(-lam);
    double stat = 0.0;
    double rest = 1.0;
    for (int k = 0; k < 10; k++) {
        double exp = pk * (double) draws;
        double d = (double) counts[k] - exp;
        stat = stat + d * d / exp;
        rest = rest - pk;
        pk = pk * lam / (double) (k + 1);
    }
    double exp10 = rest * (double) draws;
    double d10 = (double) counts[10] - exp10;
    stat = stat + d10 * d10 / exp10;
    check(stat < 33.0, "poisson(3) matches the exact probabilities (multiplication method)");
    // lambda = 40 (PTRS): bins of 4 values around the mean
    lam = 40.0;
    int c2[40];
    for (int i = 0; i < 8000; i++) { int k = g.poisson(lam) / 4; if (k > 19) { k = 19; } c2[k]++; }
    double pmf[200];
    pmf[0] = dmath.exp(-lam);
    for (int k = 0; k < 199; k++) { pmf[k + 1] = pmf[k] * lam / (double) (k + 1); }
    stat = 0.0;
    double used = 0.0;
    for (int b = 0; b < 20; b++) {
        double pr = 0.0;
        if (b < 19) { for (int k = 4 * b; k < 4 * b + 4; k++) { pr = pr + pmf[k]; } }
        else { pr = 1.0 - used; }
        used = used + pr;
        double exp = pr * 8000.0;
        double d = (double) c2[b] - exp;
        if (exp > 5.0) { stat = stat + d * d / exp; }
    }
    check(stat < 50.0, "poisson(40) matches the exact probabilities (PTRS)");
    // geometric
    int c3[12];
    for (int i = 0; i < draws; i++) { int k = g.geometric(0.4); if (k > 11) { k = 11; } c3[k]++; }
    stat = 0.0;
    double q = 1.0;
    for (int k = 1; k <= 10; k++) {
        double pr = q * 0.4;
        q = q * 0.6;
        double exp = pr * (double) draws;
        double d = (double) c3[k] - exp;
        stat = stat + d * d / exp;
    }
    double expRest = q * (double) draws;
    double dRest = (double) c3[11] - expRest;
    stat = stat + dRest * dRest / expRest;
    check(stat < 33.0 && c3[0] == 0, "geometric(0.4): 1, 2, 3 ... with probability 0.4 * 0.6^(k-1), never 0");
}

void normalTails() {
    // fractions of normal samples inside |x| < 1, 2, 3 and beyond the ziggurat's tail start (3.654): exact values from the normal distribution
    rng.Xoshiro256 g(777);
    int n = 120000;
    int in1 = 0;
    int in2 = 0;
    int in3 = 0;
    int tail = 0;
    int pos = 0;
    for (int i = 0; i < n; i++) {
        double x = g.normal();
        double a = (x < 0.0) ? -x : x;
        if (a < 1.0) { in1++; }
        if (a < 2.0) { in2++; }
        if (a < 3.0) { in3++; }
        if (a > 3.6541528853610088) { tail++; }
        if (x > 0.0) { pos++; }
    }
    // P(|X| < 1) = 0.682689, P(|X| < 2) = 0.954500, P(|X| < 3) = 0.997300, P(|X| > 3.6541) = 0.000258
    check(in1 > 81500 && in1 < 82400 && in2 > 114000 && in2 < 115200 && in3 > 119500 && in3 < 120000, "normal: 68.27 / 95.45 / 99.73 percent within one, two, three sigma (120000 draws)");
    check(tail > 8 && tail < 70, "normal: the tail beyond the ziggurat start occurs about 0.026 percent of the time");
    check(pos > 59000 && pos < 61000, "normal: half of the values are positive");
    // exponential: P(X > 1) = 0.367879, P(X > 5) = 0.006738, P(X > 7.697) = 0.000454
    int gt1 = 0;
    int gt5 = 0;
    int gt7 = 0;
    for (int i = 0; i < n; i++) {
        double x = g.exponential();
        if (x > 1.0) { gt1++; }
        if (x > 5.0) { gt5++; }
        if (x > 7.69711747013104972) { gt7++; }
    }
    check(gt1 > 43300 && gt1 < 45000 && gt5 > 650 && gt5 < 970 && gt7 > 20 && gt7 < 95, "exponential: tail fractions 0.3679, 0.00674, 0.00045 (120000 draws)");
}

void edgeCases() {
    rng.Xoshiro256 g(1);
    check(g.gamma(0.0) == 0.0 && g.poisson(0.0) == 0 && g.poisson(-5.0) == 0, "gamma(0) = 0, poisson(0) = 0, poisson(negative) = 0");
    check(g.geometric(1.0) == 1 && g.geometric(2.0) == 1 && g.geometric(0.0) == 0 && g.geometric(-1.0) == 0, "geometric(p >= 1) = 1, geometric(p <= 0) = 0");
    bool pos = true;
    for (int i = 0; i < 300; i++) {
        if (g.exponential() < 0.0 || g.gamma(0.3) < 0.0 || g.gamma(7.0) <= 0.0) { pos = false; }
        double b = g.beta(0.3, 0.4);
        if (b < 0.0 || b > 1.0) { pos = false; }
        double c = g.beta(3.0, 0.4);
        if (c < 0.0 || c > 1.0) { pos = false; }
    }
    check(pos, "exponential, gamma and beta stay in their ranges");
    check(near(g.exponentialRate(1.0e9), 0.0, 1.0e-7), "exponentialRate(1e9) is tiny");
    check(near(g.gammaAt(1.0, 1.0e-9), 0.0, 1.0e-6), "gammaAt with a tiny scale is tiny");
    // the same seed gives the same normals, also when the table is already built
    rng.Xoshiro256 a(5);
    rng.Xoshiro256 b(5);
    check(a.normal() == b.normal() && a.normal() == b.normal() && a.exponential() == b.exponential(), "same seed, same normals and exponentials");
}


int main() {
    distributionChecks();
    binomialGoodness();
    poissonGoodness();
    normalTails();
    edgeCases();
    check(asys.memBadFrees() == 0, "no bad free");
    printf("distributions: %d checks, %d failures\n", checks, fails);
    return fails;
}
