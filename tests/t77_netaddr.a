// netaddr: addresses, subnets, MAC, IPv6, services, checksum
import netaddr;
int main() {
    int ip = netaddr.ipFromBytes(192, 168, 1, 77);
    println(netaddr.ipToText(ip));
    printlnInt(netaddr.isPrivate(ip));
    int net; int bits;
    printlnInt(netaddr.parseCidr("192.168.1.77/26", &net, &bits));
    println(netaddr.ipToText(netaddr.network(net, bits)));
    println(netaddr.ipToText(netaddr.broadcast(net, bits)));
    println(netaddr.ipToText(netaddr.firstHost(net, bits)));
    println(netaddr.ipToText(netaddr.lastHost(net, bits)));
    printlnInt(netaddr.hostCount(bits));
    println(netaddr.ipToText(netaddr.maskFromPrefix(bits)));
    printlnInt(netaddr.prefixFromMask(0xFFFFFF00));
    printlnInt(netaddr.prefixFromMask(0xFF00FF00));
    printlnInt(netaddr.inSubnet(ip, net, 24));
    println(netaddr.reverseName(netaddr.ipFromBytes(1, 2, 3, 4)));
    char mac[6];
    printlnInt(netaddr.macParse("AA-bb-0c-0D-ee-01", mac));
    println(netaddr.macToText(mac));
    printlnInt(netaddr.macParse("aa:bb:cc", mac));
    char a6[16];
    printlnInt(netaddr.ip6Parse("2001:db8::ff00:42:8329", a6));
    println(netaddr.ip6ToText(a6));
    netaddr.ip6Parse("::1", a6); println(netaddr.ip6ToText(a6)); printlnInt(netaddr.ip6IsLoopback(a6));
    netaddr.ip6Parse("::", a6); println(netaddr.ip6ToText(a6));
    netaddr.ip6Parse("fe80::1:0:0:2", a6); println(netaddr.ip6ToText(a6));
    netaddr.ip6Parse("::ffff:10.1.2.3", a6); println(netaddr.ip6ToText(a6));
    int v4; printlnInt(netaddr.ip6ToV4(a6, &v4)); println(netaddr.ipToText(v4));
    printlnInt(netaddr.ip6Parse("1:2:3:4:5:6:7:8:9", a6));
    println(netaddr.serviceName(443)); printlnInt(netaddr.servicePort("ssh")); printlnInt(netaddr.servicePort("nope"));
    printlnInt(netaddr.isHostname("my-host.example.org")); printlnInt(netaddr.isHostname("-bad.org")); printlnInt(netaddr.isHostname("a..b"));
    // RFC 1071 example: 00 01 f2 03 f4 f5 f6 f7 -> sum ddf2, checksum 220d
    char d[8]; d[0]=0; d[1]=1; d[2]=0xf2; d[3]=3; d[4]=0xf4; d[5]=0xf5; d[6]=0xf6; d[7]=0xf7;
    printlnInt(netaddr.checksum(d, 8) == 0x220d);
    printlnInt(netaddr.htons(0x1234) == 0x3412);
    printlnInt(netaddr.htonl(0x01020304) == 0x04030201);
    return 0;
}
