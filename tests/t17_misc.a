int g1(int x) { return g2(x) + 1; }
int g2(int x) { return g3(x) + 1; }
int g3(int x) { return g4(x) + 1; }
int g4(int x) { return x; }

struct Pair { int a; int b; }
struct Matrix { int cells[9]; }

int idx(int r, int c) { return r * 3 + c; }

void setCell(Matrix* m, int r, int c, int v) { m->cells[idx(r, c)] = v; }
int getCell(Matrix* m, int r, int c) { return m->cells[idx(r, c)]; }

int collatz(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) n = n / 2; else n = 3 * n + 1;
        steps++;
    }
    return steps;
}

int main() {
    printlnInt(g1(10));
    Matrix m;
    for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) setCell(&m, r, c, r * 10 + c);
    printlnInt(getCell(&m, 2, 1));
    printlnInt(collatz(27));
    Pair ps[4];
    for (int i = 0; i < 4; i++) { ps[i].a = i; ps[i].b = i * i; }
    int t = 0;
    for (int i = 0; i < 4; i++) t += ps[i].a * ps[i].b;
    printlnInt(t);
    // bit tricks
    int x = 0xABCD;
    printlnInt((x >> 4) & 0xFF);
    printlnInt(x ^ (x << 1));
    printlnInt(!0 + !5);
    printlnInt(~5 & 0xF);
    // comparison chain, char math
    char c = 'x';
    printBool(c >= 'a' && c <= 'z'); println("");
    printBool(c == 'x' || c == 'y'); println("");
    int neg = -17;
    printlnInt(neg / 5); printlnInt(neg % 5); printlnInt(neg >> 1);
    bool b = 5;
    printlnInt(b);
    return 0;
}
