// netif: parsers for the kernel tables (sample texts), and a smoke test of the live data
import netif;
import netaddr;

int main() {
    // /proc/net/dev
    char dev[2048];
    dev[0] = 0;
    strcat(dev, "Inter-|   Receive                                                |  Transmit\n");
    strcat(dev, " face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n");
    strcat(dev, "    lo:  286578     370    0    0    0     0          0         0   286578     371    0    0    0     0       0          0\n");
    strcat(dev, "  eth0: 1560731    2000    1    2    0     0          0         3    90210      55    0    0    0     0       0          0\n");
    printlnInt(netif.parseNetDev(dev));

    // /proc/net/arp
    char arp[2048];
    arp[0] = 0;
    strcat(arp, "IP address       HW type     Flags       HW address            Mask     Device\n");
    strcat(arp, "192.168.1.1      0x1         0x2         aa:bb:cc:dd:ee:01     *        eth0\n");
    strcat(arp, "192.168.1.20     0x1         0x0         00:00:00:00:00:00     *        eth0\n");
    strcat(arp, "10.0.0.7         0x1         0x2         02:42:ac:11:00:02     *        docker0\n");
    printlnInt(netif.parseArp(arp));
    netif.ArpEntry* e = netif.arpAt(0);
    println(netaddr.ipToText(e->ip)); println(netaddr.macToText(&e->mac[0])); println(e->device); printlnInt(e->complete);
    e = netif.arpAt(1);
    println(netaddr.ipToText(e->ip)); printlnInt(e->complete);
    println(netaddr.macToText(&netif.arpAt(2)->mac[0]));

    // /proc/net/route (addresses are little endian hex)
    char rt[2048];
    rt[0] = 0;
    strcat(rt, "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n");
    strcat(rt, "eth0\t00000000\t0101A8C0\t0003\t0\t0\t100\t00000000\t0\t0\t0\n");
    strcat(rt, "eth0\t0001A8C0\t00000000\t0001\t0\t0\t100\t00FFFFFF\t0\t0\t0\n");
    strcat(rt, "docker0\t000011AC\t00000000\t0001\t0\t0\t0\t0000FFFF\t0\t0\t0\n");
    printlnInt(netif.parseRoutes(rt));
    netif.Route* r = netif.routeAt(0);
    println(netaddr.ipToText(r->dest)); println(netaddr.ipToText(r->gateway)); printlnInt(r->metric);
    r = netif.routeAt(2);
    println(netaddr.ipToText(r->dest)); println(netaddr.ipToText(r->mask)); println(r->device);

    // /proc/net/tcp
    char tcp[2048];
    tcp[0] = 0;
    strcat(tcp, "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n");
    strcat(tcp, "   0: 0100007F:1F90 00000000:0000 0A 00000000:00000000 00:00000000 00000000  1000        0 37 1 0000 100 0 0 10 0\n");
    strcat(tcp, "   1: 0201A8C0:C350 0100A8C0:0050 01 00000000:00000000 00:00000000 00000000     0        0 38 1 0000 100 0 0 10 0\n");
    printlnInt(netif.parseSockets(tcp, "tcp", true));
    netif.Socket* s = netif.connectionAt(0);
    println(s->proto); println(netaddr.ipToText(s->localIp)); printlnInt(s->localPort); println(netif.stateName(s->state)); printlnInt(s->uid);
    s = netif.connectionAt(1);
    println(netaddr.ipToText(s->remoteIp)); printlnInt(s->remotePort); println(netif.stateName(s->state));
    println(netif.stateName(99));

    // the real system: whatever it has, the calls work and agree with themselves
    int n = netif.interfaceCount();
    printlnInt(n >= 0);
    int good = 1;
    for (int i = 0; i < n; i++) {
        netif.Iface* f = netif.interfaceAt(i);
        if (strlen(&f->name[0]) == 0) good = 0;
        if (netif.findInterface(&f->name[0]) == null) good = 0;
    }
    printlnInt(good);
    printlnInt(netif.arpCount() >= 0);
    printlnInt(netif.routeCount() >= 0);
    printlnInt(netif.connectionCount() >= 0);
    printlnInt(netif.interfaceAt(-1) == null);
    return 0;
}
