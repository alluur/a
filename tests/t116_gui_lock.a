// the screen locker: while it is there no other window gets input, and only the right password removes it
import wsrv;
import gui;
import glock;
import adp;
import gfx;

wsrv.Server* srv;
wsrv.Headless* hb;
gui.Display* d;
int clicks = 0;
int checks = 0;

int stepServer(int unused) { srv->step(0); return 0; }

void settle() {
    d->sync();
    for (int i = 0; i < 40; i++) {
        srv->step(0);
        d->pump(0);
    }
}

int onClick(int self) { clicks++; return 0; }

int check(int password) {
    checks++;
    return streq((char*) password, "secret") ? 1 : 0;
}

int main() {
    hb = new wsrv.Headless(640, 480);
    srv = new wsrv.Server(hb, 7214);
    gui.idleHook = stepServer;
    d = gui.connectAs("7214", "locktest");

    gui.Window* w = d->createWindow("App", 200, 100, 0);
    gui.Button* b = new gui.Button("Press");
    b->onClick = onClick;
    gui.Box* col = gui.vbox(0, 10);
    col->add(b);
    w->setRoot(col);
    settle();
    wsrv.Win* sw = srv->findWindow(d->clientNum, w->id);
    int bx = sw->x + b->absX() + 10;
    int by = sw->y + b->absY() + 8;
    hb->click(bx, by);
    settle();
    printlnInt(clicks);
    printlnInt(srv->locked());

    // the locker takes over
    glock.Locker* l = new glock.Locker(d, "aleksi", check);
    settle();
    printlnInt(srv->locked());
    wsrv.Win* lw = srv->lockWindow();
    printlnInt(lw->w * 1000 + lw->h);
    printlnInt(srv->focus == lw);
    hb->click(bx, by);
    settle();
    printlnInt(clicks);
    hb->keyDown(adp.KEY_ALT, 0);
    hb->tap(adp.KEY_TAB, 0);
    hb->keyUp(adp.KEY_ALT, 0);
    settle();
    printlnInt(srv->focus == lw);
    printlnInt(w->focused);

    // a wrong password, then the right one at once (it has to wait), then the right one after the wait
    hb->typeText("nope");
    hb->tap(adp.KEY_ENTER, 13);
    settle();
    printlnInt(l->failures);
    printlnInt(l->unlocked);
    hb->typeText("secret");
    hb->tap(adp.KEY_ENTER, 13);
    settle();
    printlnInt(l->unlocked);
    printlnInt(checks);
    sleepMs(1100);
    hb->typeText("secret");
    hb->tap(adp.KEY_ENTER, 13);
    settle();
    printlnInt(l->unlocked);
    printlnInt(checks);

    // everything is back as it was
    printlnInt(srv->locked());
    printlnInt(srv->windowCount());
    printlnInt(srv->focus != null && srv->focus->cid == w->id);
    hb->click(bx, by);
    settle();
    printlnInt(clicks);
    d->disconnect();
    srv->close();
    return 0;
}
