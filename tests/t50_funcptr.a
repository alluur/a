// function pointers: the type func, &function, calls through variables, fields, arrays and parameters
int twice(int x) { return x * 2; }
int square(int x) { return x * x; }
int add(int a, int b) { return a + b; }

int apply(func f, int v) {
    return f(v);
}

struct Handler {
    func cb;
    int tag;
}

func table[3];
func chosen;

int compare(char* a, char* b) {
    return a[0] - b[0];
}

int main() {
    func f = twice;
    printlnInt(f(21));
    f = &square;
    printlnInt(f(9));
    printlnInt(apply(twice, 5));
    printlnInt(apply(&square, 6));
    func g = add;
    printlnInt(g(3, 4));
    Handler h;
    h.cb = square;
    h.tag = 7;
    printlnInt(h.cb(h.tag));
    Handler* hp = &h;
    printlnInt(hp->cb(8));
    table[0] = twice;
    table[1] = square;
    table[2] = add;
    for (int i = 0; i < 2; i++) {
        printlnInt(table[i](10));
    }
    printlnInt(table[2](1, 2));
    chosen = square;
    printlnInt(chosen(4) + chosen(5));
    printlnInt(f == square);
    printlnInt(f != null);
    func none;
    printlnInt(none == null);
    printlnInt(twice(square(3)));
    printlnInt(f(f(3)));
    return 0;
}
