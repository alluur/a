// ds: HashMap / TextHashMap / HashSet: random operations against OrderedMap models, tombstones, churn, iteration, seeds
import cstdio;
import cstring;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 99;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void intMap(int hashSeed, int keySpace, int ops, char* label) {
    ds.HashMap m(hashSeed);
    ds.OrderedMap model;
    int bad = 0;
    for (int op = 0; op < ops; op++) {
        int k = rnd(keySpace) - keySpace / 2;
        int what = rnd(100);
        if (what < 45) {
            int v = rnd(1000000);
            int a = m.put(k, v);
            int b = model.put(k, v);
            if (a != b) { bad++; }
        } else if (what < 75) {
            if (m.remove(k) != model.remove(k)) { bad++; }
        } else if (what < 90) {
            if (m.get(k, -7) != model.get(k, -7) || m.has(k) != model.has(k)) { bad++; }
        } else if (what < 94) {
            int a = m.add(k, 3);
            int t = model.find(k);
            int b = (t < 0) ? 3 : model.valueAt(t) + 3;
            model.put(k, b);
            if (a != b) { bad++; }
        } else if (what < 97) {
            bool a = m.putIfAbsent(k, 5);
            bool b = !model.has(k);
            if (b) { model.put(k, 5); }
            if (a != b) { bad++; }
        } else {
            if (m.size() != model.size()) { bad++; }
        }
    }
    printf("%s\n", label);
    check(bad == 0, "random operations agree with the ordered map model");
    check(m.size() == model.size() && m.verify(), "size and table are consistent");
    // every entry through iteration, in insertion order, exactly once
    int seen = 0;
    bool allThere = true;
    int last = -1;
    for (int e = m.first(); e >= 0; e = m.next(e)) {
        seen++;
        if (e <= last) { allThere = false; }
        last = e;
        if (model.get(m.keyAt(e), -1) != m.valueAt(e) || !model.has(m.keyAt(e))) { allThere = false; }
    }
    check(seen == model.size() && allThere, "iteration visits each entry once");
    check(m.toArrays(null, null) == m.size(), "toArrays count");
    m.dispose();
    model.dispose();
}

void textMap() {
    ds.TextHashMap t;
    ds.OrderedTextMap model;
    char key[24];
    int bad = 0;
    for (int op = 0; op < 20000; op++) {
        format(&key[0], 24, "k%d", rnd(700));
        int what = rnd(100);
        if (what < 50) {
            int v = rnd(1000);
            if (t.put(&key[0], v) != model.put(&key[0], v)) { bad++; }
        } else if (what < 80) {
            if (t.remove(&key[0]) != model.remove(&key[0])) { bad++; }
        } else {
            if (t.get(&key[0], -1) != model.get(&key[0], -1)) { bad++; }
        }
    }
    check(bad == 0 && t.size() == model.size() && t.verify(), "text keys agree with the ordered text map");
    int seen = 0;
    for (int e = t.first(); e >= 0; e = t.next(e)) {
        if (model.get(t.keyAt(e), -1) != t.valueAt(e)) { bad++; }
        seen++;
    }
    check(seen == model.size() && bad == 0, "text iteration");
    // the key is copied
    strcpy(&key[0], "copy me");
    t.put(&key[0], 11);
    strcpy(&key[0], "xxxxxxx");
    check(t.get("copy me", 0) == 11 && !t.has("xxxxxxx"), "keys are copied");
    check(t.add("counter", 2) == 2 && t.add("counter", 5) == 7 && t.add("counter") == 8, "add counts");
    check(t.get("", -1) == -1 && t.put("", 4) == 1 && t.get("", -1) == 4 && t.remove(""), "the empty text is a key");
    // word count
    ds.TextHashMap wc;
    char* words[6] = { "the", "cat", "the", "hat", "the", "cat" };
    for (int i = 0; i < 6; i++) { wc.add(words[i]); }
    check(wc.get("the") == 3 && wc.get("cat") == 2 && wc.get("hat") == 1 && wc.size() == 3, "word count");
    t.dispose();
    model.dispose();
    wc.dispose();
}

// remove and insert in steady state: the table must not grow without limit
void churn() {
    ds.HashMap m;
    for (int i = 0; i < 100; i++) { m.put(i, i); }
    int cap0 = 0;
    for (int round = 0; round < 200000; round++) {
        m.remove(round);
        m.put(round + 100, round);
        if (round == 1000) { cap0 = m.capacity(); }
    }
    check(m.size() == 100 && m.capacity() == cap0 && m.verify(), "steady state churn keeps the capacity");
    check(m.has(200099) && !m.has(199) && m.get(200050, -1) == 199950, "the right entries survived");
    // fill, delete almost all, shrink
    ds.HashMap n;
    for (int i = 0; i < 50000; i++) { n.put(i * 7, i); }
    int bigCap = n.capacity();
    for (int i = 0; i < 50000; i++) { if (i % 1000 != 0) { n.remove(i * 7); } }
    check(n.size() == 50 && n.capacity() == bigCap && n.verify(), "removing does not move entries");
    n.shrink();
    check(n.capacity() < bigCap / 100 && n.size() == 50 && n.verify() && n.get(7000, -1) == 1000, "shrink gives memory back");
    n.clear();
    check(n.size() == 0 && n.first() == -1 && n.get(7000, -1) == -1 && n.put(1, 2) == 1, "clear");
    // removing while iterating
    ds.HashMap r;
    for (int i = 0; i < 1000; i++) { r.put(i, i); }
    for (int e = r.first(); e >= 0; e = r.next(e)) {
        if (r.keyAt(e) % 3 != 0) { r.remove(r.keyAt(e)); }
    }
    bool ok = r.size() == 334 && r.verify();
    for (int i = 0; i < 1000; i++) { if (r.has(i) != (i % 3 == 0)) { ok = false; } }
    check(ok, "removing while iterating");
    // many deletions leave tombstones; lookups of absent keys must still stop
    ds.HashMap t;
    for (int i = 0; i < 4000; i++) { t.put(i, i); }
    for (int i = 0; i < 4000; i += 2) { t.remove(i); }
    bool absent = true;
    for (int i = 10000; i < 12000; i++) { if (t.has(i)) { absent = false; } }
    check(absent && t.size() == 2000 && t.verify(), "tombstones do not hide or invent keys");
    m.dispose(); n.dispose(); r.dispose(); t.dispose();
}

void sets() {
    ds.HashSet s;
    ds.TextHashSet ts;
    check(s.add(5) == 1 && s.add(5) == 0 && s.has(5) && s.contains(5) && !s.has(6) && s.size() == 1, "HashSet");
    for (int i = 0; i < 100; i++) { s.add(i * i); }
    int out[200];
    int n = s.toArray(&out[0]);
    check(n == s.size() && out[0] == 5 && s.remove(5) && !s.remove(5), "HashSet toArray and remove");
    check(ts.add("a") == 1 && ts.add("a") == 0 && ts.add("b") == 1 && ts.size() == 2 && ts.has("b") && !ts.has("c"), "TextHashSet");
    int cnt = 0;
    for (int e = ts.first(); e >= 0; e = ts.next(e)) { cnt++; }
    check(cnt == 2 && streq(ts.keyAt(ts.first()), "a"), "TextHashSet iteration");
    s.dispose(); ts.dispose();
}

// keys that collide in the low bits and keys chosen against the default seed are still handled; the seed changes the order of slots
void hashing() {
    ds.HashMap m;
    for (int i = 0; i < 20000; i++) { m.put(i << 20, i); }              // identical low 20 bits
    bool ok = m.size() == 20000;
    for (int i = 0; i < 20000; i++) { if (m.get(i << 20, -1) != i) { ok = false; } }
    check(ok && m.verify(), "keys that differ only in the high bits");
    check(ds.hashInt(5, 0) != ds.hashInt(5, 1) && ds.hashInt(5, 3) == ds.hashInt(5, 3), "the seed changes the hash");
    check(ds.hashText("abc", 0) == ds.hashBytes("abc", 3, 0) && ds.hashText("abc", 0) != ds.hashText("abd", 0) && ds.hashText("", 0) == ds.hashBytes("", 0, 0), "text and byte hashes agree");
    // the hash of the default seed is fixed: the same on every target
    printf("hash values: %d %d %d\n", ds.hashInt(1, 0) & 0xFFFFFF, ds.hashText("hello", 0) & 0xFFFFFF, ds.mix64(0) & 0xFFFFFF);
    ds.HashMap a(ds.randomSeed());
    for (int i = 0; i < 1000; i++) { a.put(i, i); }
    check(a.size() == 1000 && a.get(500, -1) == 500, "random seed");
    m.dispose(); a.dispose();
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.HashMap m;
    ds.TextHashMap t;
    ds.HashSet s;
    ds.TextHashSet ts;
    char key[16];
    for (int i = 0; i < 3000; i++) {
        m.put(i, i); s.add(i);
        format(&key[0], 16, "key%d", i);
        t.put(&key[0], i); ts.add(&key[0]);
    }
    for (int i = 0; i < 3000; i += 2) {
        m.remove(i);
        format(&key[0], 16, "key%d", i);
        t.remove(&key[0]);
    }
    check(asys.memBlocks() > b0, "memory in use");
    m.dispose(); t.dispose(); s.dispose(); ts.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees the tables and the text keys");
    t.put("again", 1);
    check(t.get("again", 0) == 1, "usable after dispose");
    t.clear();
    t.dispose();
    check(asys.memBlocks() == b0, "clear then dispose");
}

int main() {
    intMap(0, 100, 30000, "small key space");
    intMap(5, 5000, 40000, "medium key space, seed 5");
    intMap(0, 1000000, 30000, "huge key space");
    textMap();
    churn();
    sets();
    hashing();
    memory();
    printf("hashmap: %d checks, %d failures\n", checks, fails);
    return fails;
}
