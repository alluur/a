// fixed width integers: int8 int16 int32 int64 uint8 uint16 uint32 uint64 size_t ... (sizes, wrapping, sign, structs, pointers)
import cstdio;

struct Packet {
    uint8 kind;
    uint16 length;
    uint32 id;
    int8 delta;
    int16 offset;
    int32 code;
    uint64 stamp;
}

int32 gi = -5;
uint16 gu = 65535;
uint8 gtab[4] = { 1, 2, 3, 250 };
int16 gs[3] = { -1, 300, -32768 };
uint32 gw[2] = { 4000000000, 7 };
int8 gb = -128;

uint8 low(int x) { return x; }
int16 narrow16(int x) { return x; }
uint32 twice(uint32 v) { return v * 2; }
int32 neg32(int32 v) { return -v; }
uint64 big() { return 0x8000000000000000; }
int bump(int8 v) { v++; return v; }

int main() {
    printf("sizeof: %d %d %d %d", sizeof(int8), sizeof(uint8), sizeof(int16), sizeof(uint16));
    printf(" %d %d %d %d %d\n", sizeof(int32), sizeof(uint32), sizeof(int64), sizeof(uint64), sizeof(size_t));
    printf("Packet: %d\n", sizeof(Packet));

    // truncation on assignment, sign and zero extension on reading
    int8 a = 200;          printf("int8 200 = %d\n", a);
    uint8 b = 300;         printf("uint8 300 = %d\n", b);
    int16 c = 40000;       printf("int16 40000 = %d\n", c);
    uint16 d = 70000;      printf("uint16 70000 = %d\n", d);
    int32 e = 3000000000;  printf("int32 3e9 = %d\n", e);
    uint32 f = 5000000000; printf("uint32 5e9 = %d\n", f);
    int64 g = 5000000000;  printf("int64 5e9 = %d\n", g);

    // arithmetic wraps at the width of the type
    uint32 w = 0; w = w - 1;           printf("uint32 0-1 = %d\n", w);
    uint8 u8 = 250; u8 = u8 + 10;      printf("uint8 250+10 = %d\n", u8);
    int8 i8 = 127; i8++;               printf("int8 127++ = %d\n", i8);
    int16 i16 = -32768; i16--;         printf("int16 -32768-- = %d\n", i16);
    uint16 u16 = 65535; u16 += 2;      printf("uint16 65535+=2 = %d\n", u16);
    int32 i32 = 2147483647; i32 = i32 + 1; printf("int32 max+1 = %d\n", i32);
    uint32 m = 65536; m = m * 65536;   printf("uint32 65536*65536 = %d\n", m);
    uint32 s32 = 1; s32 <<= 31;        printf("uint32 1<<31 = %d\n", s32);
    int32 neg = -2147483648;           printf("int32 min = %d, -min = %d\n", neg, neg32(neg));
    printf("~uint32 0 = %d\n", ~(uint32)0);
    printf("-(uint8)1 as uint32: %d\n", (uint32)(-(uint32)1));

    // casts
    int x = 0x1234ABCD;
    printf("casts: %d %d %d %d %d %d\n", (int8)x, (uint8)x, (int16)x, (uint16)x, (int32)x, (uint32)x);
    printf("cast of -1: %d %d %d\n", (uint8)-1, (uint16)-1, (uint32)-1);

    // functions
    printf("low(511) = %d, narrow16(100000) = %d, twice(3000000000) = %d\n", low(511), narrow16(100000), twice(3000000000));
    printf("bump(127) = %d\n", bump(127));

    // globals
    printf("globals: %d %d %d %d %d %d\n", gi, gu, gtab[3], gs[0], gs[2], gb);
    printf("gw: %d %d\n", gw[0], gw[1]);
    gi = gi * 1000000000;  printf("gi after = %d\n", gi);

    // unsigned 64 bit
    uint64 h = 0xFFFFFFFFFFFFFFFF;
    printf("uint64 max: /2 = %d, %%10 = %d, >>60 = %d, >1 = %d, <1 = %d\n", h / 2, h % 10, h >> 60, h > 1, h < 1);
    uint64 bg = big();
    printf("big: %d %d %d\n", bg > 5, bg >> 63, bg / 3);
    int sgn = -1;
    printf("signed -1 < 1: %d; uint64 cast: %d\n", sgn < 1, (uint64)sgn > 1);

    // structures with natural alignment
    Packet p;
    p.kind = 7; p.length = 513; p.id = 0xDEADBEEF; p.delta = -3; p.offset = -300; p.code = -70000; p.stamp = 123456789012;
    printf("packet: %d %d %d %d %d %d %d\n", p.kind, p.length, p.id, p.delta, p.offset, p.code, p.stamp);
    uint8* raw = (uint8*) &p;
    printf("bytes: %d %d %d %d", raw[0], raw[2], raw[3], raw[4]);
    printf(" %d %d %d\n", raw[5], raw[6], raw[7]);
    Packet* pp = &p;
    pp->length += 1;
    pp->delta--;
    printf("through pointer: %d %d\n", p.length, p.delta);

    // pointers and arrays scale by the element size
    uint16 arr[4] = { 1, 65535, 65543, 9 };
    uint16* q = &arr[0];
    q = q + 2;
    printf("pointer step: %d, diff %d\n", *q, q - &arr[0]);
    int32 nums[3] = { -1, -2, -3 };
    int tot = 0;
    for (int i = 0; i < 3; i++) { tot = tot + nums[i]; }
    printf("int32 sum %d\n", tot);
    uint32 words[2];
    words[0] = 0x01020304; words[1] = 0xFFFFFFFF;
    uint8* wb = (uint8*) words;
    printf("little endian: %d %d %d %d, %d\n", wb[0], wb[1], wb[2], wb[3], words[1]);

    // mixed comparisons stay mathematically correct
    uint8 small = 200; int8 sm = -56;
    printf("compare: %d %d %d\n", small > sm, (int)small + sm, small == 200);
    uint32 big32 = 4000000000; int32 neg32v = -1;
    printf("compare 2: %d\n", big32 > neg32v);

    // conversions with double
    double dd = 300.7;
    uint8 fromd = dd;
    int16 fromd2 = -40000.0;
    printf("from double: %d %d\n", fromd, fromd2);
    double back = (uint16)65535;
    printf("to double: %d\n", (int)back);

    // static locals and switch
    static uint16 counter;
    counter = counter + 40000; counter = counter + 40000;
    printf("static uint16: %d\n", counter);
    switch (low(258)) { case 2: printf("switch ok\n"); break; default: printf("switch bad\n"); }

    // typedef names
    size_t sz = sizeof(Packet);
    ssize_t neg2 = -5;
    uintptr_t addr = (uintptr_t) &p;
    printf("size_t %d, ssize_t %d, uintptr_t nonzero %d\n", sz, neg2, addr != 0);
    return 0;
}
