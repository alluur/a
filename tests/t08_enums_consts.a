const MAX = 10;
const NAME = "aytict";
const int FLAGS = 1 << 3 | 1;
const BIG = MAX * MAX + 1;
enum Color { Red, Green = 5, Blue }
enum Dir { Up = 1, Down, Left, Right }

int main() {
    printlnInt(MAX); println(NAME); printlnInt(FLAGS); printlnInt(BIG);
    printlnInt(Red); printlnInt(Green); printlnInt(Blue);
    Color c = Color.Blue;
    printlnInt(c);
    Dir d = Left;
    printlnInt(d);
    printlnInt(Dir.Right);
    int arr[MAX];
    arr[MAX - 1] = 77;
    printlnInt(arr[9]);
    const LOCAL = 3;
    printlnInt(LOCAL * 2);
    switch (c) {
        case Red: println("red"); break;
        case Green: println("green"); break;
        case Blue: println("blue");
        case 99: println("fallthrough"); break;
        default: println("other");
    }
    for (int i = 0; i < 4; i++) {
        switch (i) {
            case 0: print("zero "); break;
            case 2: print("two "); continue;
            case 3: print("three ");
            default: print("d ");
        }
        print("| ");
    }
    println("");
    return 0;
}
