// tuple literals in initializer lists, in global and static initializers, and as fields of structs
struct S { (int, int) p; int z; }
struct N { (int, (int, int)) deep; }

(int, int) g = (5, 6);
(int, double) gd = (7, 8);
(int, int) ga[3] = {(1, 2), (3, 4)};
S gs = {(10, 20), 30};
S gt[2] = {{(1, 2), 3}, {(4, 5), 6}};
(int, char*) gname = (42, "answer");

(int, int) swap((int, int) t) {
    return (t.1, t.0);
}

int main() {
    (int, int) a[2] = {(1, 2), (3, 4)};
    printf("%d %d %d %d\n", a[0].0, a[0].1, a[1].0, a[1].1);

    int x = 9;
    (int, int) b[3] = {(x, x + 1), (x * 2, x * 3)};
    printf("%d %d %d %d %d %d\n", b[0].0, b[0].1, b[1].0, b[1].1, b[2].0, b[2].1);

    (int, double) c[2] = {(1, 2), (3, 4)};
    printf("%d %d %d\n", c[0].0, (int) c[0].1, (int) c[1].1);

    S s = {(1, 2), 3};
    printf("%d %d %d\n", s.p.0, s.p.1, s.z);
    S t[2] = {{(7, 8), 9}, {swap((1, 2)), 5}};
    printf("%d %d %d %d %d %d\n", t[0].p.0, t[0].p.1, t[0].z, t[1].p.0, t[1].p.1, t[1].z);

    N n = {(1, (2, 3))};
    printf("%d %d %d\n", n.deep.0, n.deep.1.0, n.deep.1.1);

    printf("%d %d %d %d %d %d\n", g.0, g.1, ga[0].1, ga[1].0, ga[2].1, gs.z);
    printf("%d %d %d %d %d\n", gs.p.0, gs.p.1, gt[1].p.0, gt[1].z, gt[0].p.1);
    printf("%d %d %s\n", gd.0, (int) gd.1, gname.1);

    static (int, int) st = (11, 12);
    static S ss = {(13, 14), 15};
    st.0 = st.0 + 1;
    printf("%d %d %d %d %d\n", st.0, st.1, ss.p.0, ss.p.1, ss.z);

    // a variable of the same struct type is fine too
    S copy = s;
    S* sptr = &s;
    S viaPtr = sptr;                // a pointer to a struct is accepted too: the struct is copied from it
    printf("%d %d\n", viaPtr.p.1, viaPtr.z);
    S pair[2] = {s, copy};
    printf("%d %d\n", pair[1].p.1, pair[0].z);
    (int, int) q = {5, 6};
    (int, int) r[2] = {q, (q.1, q.0)};
    printf("%d %d %d %d\n", r[0].0, r[0].1, r[1].0, r[1].1);
    return 0;
}
