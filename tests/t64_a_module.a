// a_module / a_import
a_import('amodules/shapes.am');
a_import('amodules/solids.am', 'volume');
a_import("amodules/shapes.am", 'perimeter, Box');

int main() {
    printlnInt(shapes.area(3, 4));
    printlnInt(shapes.SIDES);
    printlnInt(shapes.reveal());
    printlnInt(volume(2, 3, 4));            // imported by name
    printlnInt(solids.volume(1, 2, 3));     // and still reachable with the prefix
    printlnInt(perimeter(3, 4));
    Box* b = new Box(5, 6);                 // a class imported by name
    printlnInt(b->area());
    shapes.Box* c = new shapes.Box(2, 2);
    printlnInt(c->area());
    return 0;
}
