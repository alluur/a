import json;

int main() {
    char* text = "{ \"name\": \"A lang\", \"version\": 1, \"neg\": -42, \"pi\": 3.14, \"big\": 1e3, \"ok\": true, \"no\": false, \"none\": null,\n \"tags\": [1, \"two\", [3, 4], {\"five\": 5}, [], {}],\n \"text\": \"tab\\there \\\"quoted\\\" \\u00e9 \\u20ac \\ud83d\\ude00 \\\\ \\/\",\n \"nested\": {\"a\": {\"b\": {\"c\": [10, 20]}}} }";
    json.Json* doc = json.parse(text);
    if (doc == null) { println(json.errorMessage()); return 1; }
    println(doc->get("name")->asString());
    printlnInt(doc->get("version")->asInt()); printlnInt(doc->get("neg")->asInt()); printlnInt(doc->get("pi")->asInt()); printlnInt(doc->get("big")->asInt());
    printBool(doc->get("ok")->asBool()); printBool(doc->get("no")->asBool()); printBool(doc->get("none")->isNull()); printBool(doc->get("missing") == null); println("");
    json.Json* tags = doc->get("tags");
    printlnInt(tags->size()); printlnInt(tags->at(0)->asInt()); println(tags->at(1)->asString()); printlnInt(tags->at(2)->at(1)->asInt());
    printlnInt(tags->at(3)->get("five")->asInt()); printBool(tags->at(4)->isArray()); printBool(tags->at(5)->isObject()); println("");
    println(doc->get("text")->asString());
    printlnInt(doc->get("nested")->get("a")->get("b")->get("c")->at(1)->asInt());
    printlnInt(doc->intOr("version", -1)); printlnInt(doc->intOr("nope", -1)); println(doc->stringOr("name", "?")); println(doc->stringOr("version", "?"));
    printBool(doc->boolOr("ok", false)); println("");
    println(doc->keyAt(0)); printlnInt(doc->size());
    println(json.stringify(doc));
    println(json.pretty(doc->get("tags")));
    println(json.pretty(doc->get("nested")));

    json.Json* o = json.newObject();
    o->set("id", json.newInt(7)); o->set("name", json.newString("line\nbreak \"q\" \x01")); o->set("ok", json.newBool(true));
    json.Json* arr = json.newArray(); arr->push(json.newInt(1)); arr->push(json.newNull()); arr->push(json.newString("x"));
    o->set("list", arr); o->set("id", json.newInt(8));
    println(json.stringify(o));
    json.Json* back = json.parse(json.stringify(o));
    printBool(back != null && back->get("id")->asInt() == 8); println("");

    char* bad[12];
    bad[0] = "{"; bad[1] = "[1,]"; bad[2] = "{\"a\" 1}"; bad[3] = "tru"; bad[4] = "\"abc"; bad[5] = "[1 2]"; bad[6] = "1 2"; bad[7] = "";
    bad[8] = "{\"a\":}"; bad[9] = "-"; bad[10] = "\"\\x\""; bad[11] = "[1.]";
    for (int i = 0; i < 12; i++) {
        json.Json* r = json.parse(bad[i]);
        printBool(r == null); print(" "); println(json.errorMessage());
    }
    printBool(json.parse("  [ ]  ")->isArray()); printBool(json.parse("123456789012")->asInt() == 123456789012); println("");
    return 0;
}
