struct S { double v; }
double g = 1.5;
int main() {
    double x = 1.5;
    double y = x++;
    printlnDouble(x); printlnDouble(y);
    y = ++x;
    printlnDouble(x); printlnDouble(y);
    y = x--; printlnDouble(y); printlnDouble(x);
    --x;
    printlnDouble(x);
    g++; ++g;
    printlnDouble(g);
    S s; s.v = 0.5; s.v++;
    printlnDouble(s.v);
    double a[2]; a[1] = 9; a[1]--;
    printlnDouble(a[1]);
    for (double d = 0; d < 3; d++) printDouble(d);
    println("");
    return 0;
}
