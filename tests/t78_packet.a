// packet: Ethernet, ARP, IPv4, ICMP, UDP, TCP, pcap files
import packet;
import netaddr;

int main() {
    char mine[6]; netaddr.macParse("02:00:00:00:00:01", mine);
    char other[6]; netaddr.macParse("02:00:00:00:00:02", other);
    int a = netaddr.ipFromBytes(10, 0, 0, 1);
    int b = netaddr.ipFromBytes(10, 0, 0, 2);
    char frame[200];
    int n = packet.arpRequestFrame(mine, a, b, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(frame, n));
    packet.Eth* e = new packet.Eth();
    printlnInt(packet.ethParse(frame, n, e));
    println(netaddr.macToText(&e->dst[0]));
    printlnInt(e->type == packet.ETH_ARP);
    packet.Arp* ar = new packet.Arp();
    printlnInt(packet.arpParse(&frame[e->offset], n - e->offset, ar));
    printlnInt(ar->op); println(netaddr.ipToText(ar->senderIp)); println(netaddr.ipToText(ar->targetIp));
    n = packet.arpReplyFrame(other, b, mine, a, frame);
    println(packet.describe(frame, n));

    // UDP inside IPv4 inside Ethernet (checked against an independent implementation)
    char udp[100]; char ip[200];
    int un = packet.udpBuild(a, b, 5353, 53, "hello", 5, udp);
    int in = packet.ipBuild(a, b, packet.PROTO_UDP, 64, 4242, udp, un, ip);
    n = packet.ethBuild(other, mine, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(&frame[14], n - 14));
    packet.Ip* ih = new packet.Ip();
    printlnInt(packet.ipParse(&frame[14], n - 14, ih));
    printlnInt(ih->checksumOk); printlnInt(ih->ttl); printlnInt(ih->proto); printlnInt(ih->id);
    packet.Udp* uh = new packet.Udp();
    printlnInt(packet.udpParse(&frame[14 + ih->offset], ih->totalLen - 20, uh));
    printlnInt(uh->srcPort); printlnInt(uh->dstPort); printlnInt(uh->length);
    printlnInt(packet.udpChecksumOk(a, b, &frame[14 + ih->offset], uh->length));
    frame[14 + 20 + 9] = frame[14 + 20 + 9] ^ 1;                   // damage the data
    printlnInt(packet.udpChecksumOk(a, b, &frame[14 + ih->offset], uh->length));

    // TCP SYN with the MSS option
    char tcp[100];
    int tn = packet.tcpBuild(a, b, 40000, 80, 1000, 0, packet.TCP_SYN, 65535, 1460, "", 0, tcp);
    printlnInt(tn);
    in = packet.ipBuild(a, b, packet.PROTO_TCP, 64, 1, tcp, tn, ip);
    n = packet.ethBuild(other, mine, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(&frame[14], n - 14));
    packet.Tcp* th = new packet.Tcp();
    printlnInt(packet.tcpParse(tcp, tn, th));
    printlnInt(th->mss); printlnInt(th->flags == packet.TCP_SYN); printlnInt(th->seq); printlnInt(th->headerLen);
    printlnInt(packet.tcpChecksumOk(a, b, tcp, tn));
    // data segment
    tn = packet.tcpBuild(b, a, 80, 40000, 5000, 1001, packet.TCP_ACK | packet.TCP_PSH, 1000, 0, "GET /", 5, tcp);
    in = packet.ipBuild(b, a, packet.PROTO_TCP, 64, 2, tcp, tn, ip);
    n = packet.ethBuild(mine, other, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));

    // ICMP echo
    char icmp[100];
    int cn = packet.icmpEcho(packet.ICMP_ECHO, 7, 1, "abcd", 4, icmp);
    in = packet.ipBuild(a, b, packet.PROTO_ICMP, 64, 2, icmp, cn, ip);
    n = packet.ethBuild(other, mine, packet.ETH_IPV4, ip, in, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(&frame[14], n - 14));
    packet.Icmp* im = new packet.Icmp();
    printlnInt(packet.icmpParse(icmp, cn, im));
    printlnInt(im->checksumOk); printlnInt(im->id); printlnInt(im->seq);

    // a VLAN tagged frame
    char tagged[100];
    memcpy(&tagged[0], &frame[0], 12);
    packet.put16(tagged, 12, packet.ETH_VLAN);
    packet.put16(tagged, 14, 0x0064);
    packet.put16(tagged, 16, packet.ETH_IPV4);
    memcpy(&tagged[18], &frame[14], n - 14);
    printlnInt(packet.ethParse(tagged, n + 4, e));
    printlnInt(e->vlan); printlnInt(e->offset);
    println(packet.describe(tagged, n + 4));
    printlnInt(packet.ethParse(tagged, 10, e));

    // pcap: write three frames, read them back
    packet.PcapWriter* w = new packet.PcapWriter("build/tests/t78.pcap");
    printlnInt(w->ok());
    w->write(frame, n, 1700000000, 250000);
    w->write(frame, 20, 1700000001, 5);
    w->write(frame, 60, 1700000002, 999999);
    w->close();
    packet.PcapReader* r = new packet.PcapReader("build/tests/t78.pcap");
    printlnInt(r->ok());
    char buf[200];
    int len;
    while ((len = r->next(buf, 200)) >= 0) {
        printInt(len); print(" "); printInt(r->sec); print(" "); printlnInt(r->usec);
    }
    r->close();
    packet.PcapReader* bad = new packet.PcapReader("build/tests/does_not_exist.pcap");
    printlnInt(bad->ok());
    return 0;
}
