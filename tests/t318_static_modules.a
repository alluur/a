// static fields and methods of a class that lives in a module, used as module.Class.member in every place an expression can stand:
// as a statement, after an opening parenthesis, in an argument, in a condition, with assignments and ++, and a module enum in parentheses
module app;

import langmods.statics;

int main() {
    statics.Reg.bump();                                  // a statement that starts with module.Class.
    statics.Reg.bump();
    printlnInt(statics.Reg.counter);                     // 2
    int y = (statics.Reg.counter + 1);                   // after an opening parenthesis
    printlnInt(y);                                       // 3
    statics.Reg.counter = 9;                             // statement: assignment
    statics.Reg.counter += 3;
    statics.Reg.counter++;
    printlnInt(statics.Reg.counter);                     // 13
    (statics.Reg.counter)--;
    printlnInt(statics.Reg.counter);                     // 12
    statics.Reg.table[1] = 5;                            // an element of a static array
    statics.Reg.table[2] = statics.Reg.table[1] * 2;
    printlnInt(statics.Reg.table[1] + statics.Reg.table[2]);    // 15
    if (statics.Reg.counter == 12) { println("cond ok"); }
    while (statics.Reg.counter > 10) { statics.Reg.counter--; }
    printlnInt(statics.Reg.counter);                     // 10
    printlnInt(statics.Reg.limit);
    println(statics.Reg.label);
    printlnInt(statics.Reg.add(5));                      // 15
    int r = (statics.Reg.add(1) * 2);                    // a call after an opening parenthesis
    printlnInt(r);                                       // 32
    statics.Reg a();                                     // a declaration of the module class still works
    statics.Reg* p = new statics.Reg();
    printlnInt(a.id); printlnInt(p->id);                 // 17, 18
    statics.Reg* q = (statics.Reg*)p;                    // and a cast
    printlnInt(q->id);
    // a subclass
    printlnInt(statics.Sub.both());                      // 18 + 7
    statics.Sub.extra = 1;
    printlnInt(statics.Sub.both());                      // 19
    // a module enum value in parentheses and at the start of a statement
    int lv = (statics.Level.High);
    printlnInt(lv);
    printlnInt((statics.Level.Mid) + 10);
    statics.Level.count;                                 // a harmless expression statement
    printlnInt(statics.Level.count);
    return 0;
}
