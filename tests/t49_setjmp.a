// setjmp / longjmp: a non-local exit through several function calls
int env[4];
int depth;
int cleanup;

void fail(int code) {
    printf("failing with %d at depth %d\n", code, depth);
    longjmp(env, code);
}

void deep(int n) {
    depth = n;
    if (n == 5) {
        fail(7);
    }
    deep(n + 1);
    printf("not reached\n");
}

// a try / catch pattern with a global stack of jump buffers
int try1[4];
int try2[4];

int risky(int v) {
    if (v < 0) {
        longjmp(try2, 2);
    }
    if (v == 0) {
        longjmp(try1, 1);
    }
    return v * 2;
}

int main() {
    int local = 10;
    int r = setjmp(env);
    printf("setjmp returned %d, local=%d\n", r, local);
    local = local + 1;
    if (r == 0) {
        deep(0);
    } else if (r == 7) {
        local = local * 2;
        if (local < 100) {
            longjmp(env, 0);          // zero becomes 1
        }
    }
    printf("done %d %d\n", r, local);
    // nested handlers
    for (int v = 3; v >= -1; v--) {
        int e = setjmp(try1);
        if (e == 0) {
            int e2 = setjmp(try2);
            if (e2 == 0) {
                printf("risky(%d) = %d\n", v, risky(v));
            } else {
                printf("inner handler %d for %d\n", e2, v);
            }
        } else {
            printf("outer handler %d for %d\n", e, v);
        }
    }
    return 0;
}
