// a typedef of a class can stand in front of '.' like the class name itself: Alias.field, Alias.method(), also module.Alias.member,
// as a statement and after an opening parenthesis; and it is still a type in declarations, casts and sizeof
module app;

import langmods.statics;

class Meter { public: static int ticks; static int tick() { ticks++; return ticks; } int v; }
typedef Meter Gauge;
typedef Meter* GaugeP;

int main() {
    Gauge.tick();                                        // a statement that starts with the alias
    Gauge.ticks += 5;
    int a = (Gauge.ticks + 1);
    printlnInt(Meter.ticks);                             // 6
    printlnInt(Gauge.ticks);                             // 6
    printlnInt(a);                                       // 7
    printlnInt(Gauge.tick());                            // 7
    statics.RegAlias.bump();                             // module.Alias.method() as a statement
    statics.RegAlias.counter = statics.RegAlias.counter * 10;
    printlnInt(statics.Reg.counter);                     // 10
    Gauge m;                                             // declarations, pointers, casts and sizeof still work
    m.v = 4;
    GaugeP mp = &m;
    Meter* mq = (Gauge*) mp;
    printlnInt(mq->v);                                   // 4
    printlnInt(sizeof(Gauge) == sizeof(Meter) ? 1 : 0);  // 1
    statics.RegAlias r();
    printlnInt(r.id);                                    // 11
    return 0;
}
