import cunistd;
import cstdio;
import cstdlib;
import cstring;

// sorts n strings
void sortNames(char** names, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (strcmp(names[j], names[i]) < 0) {
                char* t = names[i];
                names[i] = names[j];
                names[j] = t;
            }
        }
    }
}

int main() {
    char* dir = "build/tests/t44dir";
    char buf[300];
    // clean start
    unlink("build/tests/t44dir/a.txt");
    unlink("build/tests/t44dir/b.txt");
    unlink("build/tests/t44dir/c.txt");
    unlink("build/tests/t44dir/link");
    rmdir(dir);
    printf("mkdir %d\n", mkdir(dir, 493));
    printf("again %d %d\n", mkdir(dir, 493), errno);
    // files with the raw functions
    int fd = open("build/tests/t44dir/a.txt", O_WRONLY | O_CREAT | O_TRUNC, 420);
    printf("open %d\n", fd >= 0);
    printf("write %d\n", write(fd, "0123456789", 10));
    printf("seek %d\n", lseek(fd, 4, SEEK_SET));
    printf("write %d\n", write(fd, "XY", 2));
    printf("close %d\n", close(fd));
    fd = open("build/tests/t44dir/a.txt", O_RDONLY);
    int n = read(fd, buf, 100);
    buf[n] = 0;
    printf("read %d %s\n", n, buf);
    printf("eof %d\n", read(fd, buf, 100));
    Stat st;
    printf("fstat %d %d\n", fstat(fd, &st), st.st_size);
    close(fd);
    printf("bad open %d %d\n", open("build/tests/t44dir/nope", O_RDONLY), errno);
    // stat
    printf("stat %d size=%d reg=%d dir=%d\n", stat("build/tests/t44dir/a.txt", &st), st.st_size, S_ISREG(st.st_mode), S_ISDIR(st.st_mode));
    printf("stat dir %d reg=%d dir=%d\n", stat(dir, &st), S_ISREG(st.st_mode), S_ISDIR(st.st_mode));
    printf("stat missing %d\n", stat("build/tests/t44dir/missing", &st));
    // truncate, rename, access
    printf("truncate %d\n", truncate("build/tests/t44dir/a.txt", 3));
    stat("build/tests/t44dir/a.txt", &st);
    printf("size %d\n", st.st_size);
    printf("rename %d\n", rename("build/tests/t44dir/a.txt", "build/tests/t44dir/b.txt"));
    printf("access %d %d\n", access("build/tests/t44dir/b.txt", F_OK), access("build/tests/t44dir/a.txt", F_OK));
    FILE* f = fopen("build/tests/t44dir/c.txt", "w");
    fputs("c", f);
    fclose(f);
    // directory listing
    DIR* d = opendir(dir);
    char* names[20];
    int count = 0;
    Dirent* e;
    while ((e = readdir(d)) != null) {
        if (!streq(&e->d_name[0], ".") && !streq(&e->d_name[0], "..")) {
            names[count] = strdup(&e->d_name[0]);
            count++;
        }
    }
    closedir(d);
    sortNames(names, count);
    for (int i = 0; i < count; i++) {
        printf("entry %s\n", names[i]);
    }
    printf("opendir missing %d\n", opendir("build/tests/t44dir/missing") == null);
    // working directory
    getcwd(buf, 300);
    int before = strlen(buf);
    printf("chdir %d\n", chdir(dir));
    printf("in dir: %d\n", access("b.txt", F_OK));
    getcwd(buf, 300);
    printf("cwd longer %d\n", strlen(buf) > before);
    char* real = realpath("b.txt", buf);
    printf("realpath %d %d\n", real != null, endsWith(buf, "b.txt"));
    printf("chdir back %d\n", chdir("../../.."));
    printf("access %d\n", access("build/tests/t44dir/b.txt", R_OK | W_OK));
    // links (Linux and Android only: on Windows this counts as passed)
    bool linksOk = true;
    if (__OS != 1) {
        linksOk = symlink("b.txt", "build/tests/t44dir/link") == 0;
        n = readlink("build/tests/t44dir/link", buf, 100);
        buf[n] = 0;
        linksOk = linksOk && streq(buf, "b.txt");
        lstat("build/tests/t44dir/link", &st);
        linksOk = linksOk && S_ISLNK(st.st_mode);
        stat("build/tests/t44dir/link", &st);
        linksOk = linksOk && S_ISREG(st.st_mode);
        unlink("build/tests/t44dir/link");
    }
    printf("links %d\n", linksOk);
    // pipes
    int fds[2];
    printf("pipe %d\n", pipe(&fds[0]));
    write(fds[1], "through the pipe", 16);
    n = read(fds[0], buf, 100);
    buf[n] = 0;
    printf("%s\n", buf);
    close(fds[0]);
    close(fds[1]);
    // processes (Linux and Android only: on Windows this counts as passed)
    bool forkOk = true;
    if (__OS != 1) {
        int pid = fork();
        if (pid == 0) {
            _exit(42);
        }
        int status;
        forkOk = waitpid(pid, &status, 0) == pid && ((status >> 8) & 255) == 42;
    }
    printf("fork %d\n", forkOk);
    printf("getpid %d\n", getpid() > 0);
    // cleanup
    unlink("build/tests/t44dir/b.txt");
    unlink("build/tests/t44dir/c.txt");
    printf("rmdir %d\n", rmdir(dir));
    printf("rmdir again %d\n", rmdir(dir));
    // getopt
    char* args[8];
    args[0] = "prog";
    args[1] = "-ab";
    args[2] = "-o";
    args[3] = "out.txt";
    args[4] = "-x";
    args[5] = "-n5";
    args[6] = "file1";
    args[7] = "-q";
    opterr = 0;
    int c;
    while ((c = getopt(8, args, "abo:n:")) != -1) {
        if (c == 'o' || c == 'n') {
            printf("option %c = %s\n", c, optarg);
        } else if (c == '?') {
            printf("unknown option %c\n", optopt);
        } else {
            printf("option %c\n", c);
        }
    }
    printf("optind %d, next %s\n", optind, args[optind]);
    return 0;
}
