import cstdio;
import cstring;
import cstdlib;

int main() {
    char buf[200];
    char* name = "build/tests/t42.tmp";
    // standard input: scanf, fgets, getchar, ungetc
    int a;
    int b;
    char word[40];
    int n = scanf("%d %d %s", &a, &b, word);
    printf("%d: %d %d %s\n", n, a, b, word);
    int c = getchar();
    printf("after scanf: %d\n", c);
    fgets(buf, 200, stdin);
    printf("line: %s", buf);
    c = getchar();
    ungetc(c, stdin);
    printf("peek: %c\n", c);
    fgets(buf, 200, stdin);
    printf("line: %s", buf);
    n = scanf("%d", &a);
    printf("scanf at end: %d %d\n", n, feof(stdin));
    // writing and reading a file
    FILE* f = fopen(name, "w");
    printf("%d\n", f != null);
    fprintf(f, "line %d\n", 1);
    fputs("second line\n", f);
    fputc('x', f);
    putc('y', f);
    fwrite("raw bytes\n", 1, 10, f);
    fprintf(f, "%5.2s|%-4d|%04x\n", "abcdef", 7, 255);
    printf("%d\n", fclose(f));
    f = fopen(name, "r");
    while (fgets(buf, 200, f) != null) {
        fputs(buf, stdout);
    }
    printf("eof=%d err=%d\n", feof(f), ferror(f));
    printf("%d\n", fgetc(f));
    clearerr(f);
    printf("eof=%d\n", feof(f));
    // seeking
    printf("%d\n", fseek(f, 5, SEEK_SET));
    printf("%d %c\n", ftell(f), fgetc(f));
    fseek(f, -3, SEEK_END);
    printf("%d\n", ftell(f));
    n = fread(buf, 1, 100, f);
    buf[n] = 0;
    printf("%d [%s]\n", n, buf);
    rewind(f);
    printf("%d %c\n", ftell(f), getc(f));
    ungetc('Q', f);
    printf("%c%c\n", fgetc(f), fgetc(f));
    int pos;
    fgetpos(f, &pos);
    fseek(f, 0, SEEK_END);
    fsetpos(f, &pos);
    printf("%d\n", ftell(f));
    fclose(f);
    // append and read/write
    f = fopen(name, "a");
    fputs("appended\n", f);
    fclose(f);
    f = fopen(name, "r+");
    fgets(buf, 200, f);
    fseek(f, 0, SEEK_CUR);
    fputs("LINE", f);
    fclose(f);
    f = fopen(name, "r");
    n = fread(buf, 1, 30, f);
    buf[n] = 0;
    printf("%s\n", buf);
    fclose(f);
    // getline
    f = fopen(name, "r");
    char* line = null;
    int cap = 0;
    n = getline(&line, &cap, f);
    printf("%d %s", n, line);
    n = getline(&line, &cap, f);
    printf("%d %s", n, line);
    fclose(f);
    // fscanf
    f = fopen(name, "w");
    fprintf(f, "10 20 abc\n3.5\n");
    fclose(f);
    f = fopen(name, "r");
    n = fscanf(f, "%d %d %s", &a, &b, word);
    printf("%d %d %d %s\n", n, a, b, word);
    fclose(f);
    // failure
    f = fopen("build/tests/no/such/dir/file", "r");
    printf("%d %d\n", f == null, errno);
    printf("%d\n", f == null && fclose(f) == EOF);
    // buffering
    f = fopen(name, "w");
    fputs("buffered", f);
    FILE* g = fopen(name, "r");
    printf("%d\n", fgetc(g));
    fflush(f);
    fclose(g);
    g = fopen(name, "r");
    n = fread(buf, 1, 20, g);
    printf("%d\n", n);
    fclose(g);
    fclose(f);
    // rename, remove, tmpfile
    char* name2 = "build/tests/t42.tmp2";
    printf("%d\n", rename(name, name2));
    FILE* gone = fopen(name, "r");
    FILE* moved = fopen(name2, "r");
    printf("%d %d\n", gone == null, moved != null);
    fclose(moved);
    printf("%d\n", remove(name2));
    printf("%d\n", remove(name2));
    FILE* t = tmpfile();
    fputs("temporary", t);
    rewind(t);
    n = fread(buf, 1, 50, t);
    buf[n] = 0;
    printf("%s\n", buf);
    fclose(t);
    // string functions
    char out[64];
    printf("%d\n", sprintf(out, "%d+%d=%d", 1, 2, 3));
    println(out);
    printf("%d\n", snprintf(out, 6, "%s", "truncated"));
    println(out);
    int args[3];
    args[0] = 5;
    args[1] = (int)"abc";
    args[2] = 255;
    vsnprintf(out, 64, "%03d %s %#x", args, 3);
    println(out);
    n = sscanf("12 apples 3.0", "%d %s", &a, word);
    printf("%d %d %s\n", n, a, word);
    char hex[10];
    n = sscanf("ff 077", "%x %o", &a, &b);
    printf("%d %d %d\n", n, a, b);
    n = sscanf("a=1,b=22", "a=%d,b=%d", &a, &b);
    printf("%d %d %d\n", n, a, b);
    char c1;
    char c2;
    n = sscanf("xy z", "%c%c %c", &c1, &c2, word);
    printf("%d %c %c %c\n", n, c1, c2, word[0]);
    n = sscanf("key: value here", "%[a-z]: %[^\n]", word, buf);
    printf("%d [%s] [%s]\n", n, word, buf);
    n = sscanf("5", "%d%n", &a, &b);
    printf("%d %d %d\n", n, a, b);
    // processes (exit codes only: the output of the command is not portable)
    FILE* p = popen("exit 5", "r");
    printf("%d\n", p != null);
    printf("%d\n", pclose(p));
    printf("%d %d %d\n", EOF, SEEK_END, BUFSIZ);
    return 0;
}
