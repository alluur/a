// gchart: charts, gauges, switch and rating are drawn identically on every target (checksum), and react to input
import cstdio;
import cstdlib;
import gui;
import gfx;
import adp;
import gchart;

int changes = 0;
int onSwitch(int w) { changes++; return 0; }

int main() {
    gfx.Surface* s = new gfx.Surface(520, 420);
    s->clear(gui.cBack);
    int a[8] = { 10, 35, 22, 60, 48, 75, 66, 90 };
    int b[8] = { 5, 12, 30, 25, 40, 38, 55, 70 };
    char* labels[8] = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun", "Mon2" };

    gchart.Chart* line = new gchart.Chart(gchart.LINE);
    line->title = "Load";
    int cpu = line->addSeries("CPU", 0);
    int mem = line->addSeries("Memory", 0);
    line->setValues(cpu, a, 8);
    line->setValues(mem, b, 8);
    line->w = 250; line->h = 140;
    line->paint(s, 10, 10);

    gchart.Chart* bar = new gchart.Chart(gchart.BAR);
    bar->title = "Sales";
    int x1 = bar->addSeries("2025", 0);
    int x2 = bar->addSeries("2026", 0);
    bar->setValues(x1, a, 6);
    bar->setValues(x2, b, 6);
    bar->setLabels(labels, 6);
    bar->w = 250; bar->h = 140;
    bar->paint(s, 270, 10);

    gchart.Chart* area = new gchart.Chart(gchart.AREA);
    int s1 = area->addSeries("Net", 0);
    for (int i = 0; i < 20; i++) { area->push(s1, 30 + (i * 37) % 50); }
    area->w = 250; area->h = 120;
    area->paint(s, 10, 160);

    gchart.Chart* pie = new gchart.Chart(gchart.PIE);
    pie->title = "Share";
    int ps = pie->addSeries("share", 0);
    int shares[4] = { 40, 25, 20, 15 };
    char* names[4] = { "Linux", "Windows", "Android", "Other" };
    pie->setValues(ps, shares, 4);
    pie->setLabels(names, 4);
    pie->w = 250; pie->h = 120;
    pie->paint(s, 270, 160);

    gchart.Gauge* g1 = new gchart.Gauge(0, 100);
    g1->setValue(30); g1->caption = "CPU %";
    g1->paint(s, 10, 295);
    gchart.Gauge* g2 = new gchart.Gauge(0, 100);
    g2->setValue(92); g2->caption = "Disk %";
    g2->paint(s, 160, 295);

    gchart.Switch* sw1 = new gchart.Switch(false);
    sw1->onChange = onSwitch;
    gchart.Switch* sw2 = new gchart.Switch(true);
    sw1->paint(s, 320, 300);
    sw2->paint(s, 380, 300);
    gchart.Rating* rt = new gchart.Rating(5, 3);
    rt->paint(s, 320, 340);
    printf("checksum %d\n", s->checksum());

    // behaviour: switch, rating, chart data
    sw1->onMouse(adp.M_DOWN, 1, 5, 5, 0);
    printf("switch: on %d, changes %d\n", sw1->on, changes);
    sw1->onKey(1, 0, ' ', 0);
    printf("switch after space: on %d, changes %d\n", sw1->on, changes);
    rt->onMouse(adp.M_DOWN, 1, 22 * 4 + 5, 10, 0);
    printf("rating: %d\n", rt->value);
    rt->onMouse(adp.M_DOWN, 1, 22 * 4 + 5, 10, 0);
    printf("rating clicked twice: %d\n", rt->value);
    area->maxPoints = 5;
    for (int i = 0; i < 12; i++) { area->push(s1, i); }
    printf("rolling: %d points, first %d, last %d\n", area->pointCount(s1), area->valueAt(s1, 0), area->valueAt(s1, 4));
    g1->setValue(500);
    printf("gauge clamps: %d\n", g1->value);
    printf("series: %d %d\n", line->seriesCount(), line->addSeries("x", 0));
    return 0;
}
