// stats: streaming accumulators (Welford with merge, exponential moving average, rolling window statistics), moving averages, cumulative sums and histograms with
// the binning rules of NumPy. Expected output: tests/algo2_ref/gen_t450.py (exact fractions; the binning rules are NumPy's formulas written out in Python).
import cstdio;
import asys;
import stats;
import dmath;

int seed = 8675309;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

void pv(char* name, double v) {
    printf("%s", name);
    printfd(" %.9g\n", __bits(v));
}

void dumpV(char* name, double* v, int n) {
    printf("%s %d:", name, n);
    for (int i = 0; i < n; i++) { printfd(" %.9g", __bits(v[i])); }
    printf("\n");
}

void chk(char* label, bool v) {
    printf("%s: %d\n", label, v);
}

bool isNan(double v) { return v != v; }

int main() {
    int base = asys.memInUse();
    // ---- Welford
    double v[300];
    for (int i = 0; i < 300; i++) { v[i] = (double) (lcg() % 20000) / 37.0 - 100.0; }
    stats.Welford w;
    w.addAll(v, 300);
    printf("Welford count %d\n", w.size());
    pv("mean", w.mean());
    pv("variance (n - 1)", w.variance(1));
    pv("variance (n)", w.variance(0));
    pv("stddev", w.stddev(1));
    pv("sem", w.sem());
    pv("minimum", w.minimum());
    pv("maximum", w.maximum());
    pv("skewness", w.skewness());
    pv("excess kurtosis", w.kurtosis());
    chk("equals the batch functions (1e-12 relative)", dmath.fabs(w.mean() - stats.mean(v, 300)) < 1.0e-12 * 100.0 && dmath.fabs(w.variance(1) / stats.variance(v, 300, 1) - 1.0) < 1.0e-12
        && dmath.fabs(w.skewness() - stats.skewness(v, 300, true)) < 1.0e-12 && dmath.fabs(w.kurtosis() - stats.kurtosis(v, 300, true, true)) < 1.0e-12);
    // merging two halves (and an empty accumulator) gives the same statistics
    stats.Welford a;
    stats.Welford b;
    stats.Welford e;
    a.addAll(v, 120);
    b.addAll(&v[120], 180);
    a.merge(&e);
    a.merge(&b);
    e.merge(&a);
    printf("merged: count %d\n", a.size());
    pv("merged mean", a.mean());
    pv("merged variance", a.variance(1));
    pv("merged skewness", a.skewness());
    pv("merged kurtosis", a.kurtosis());
    printf("merged min and max equal: %d, merge into an empty accumulator: count %d mean equal %d\n", a.minimum() == w.minimum() && a.maximum() == w.maximum(), e.size(), dmath.fabs(e.mean() - a.mean()) < 1.0e-12);
    // many small merges (as a parallel reduction would do)
    stats.Welford acc;
    for (int i = 0; i < 300; i += 10) {
        stats.Welford part;
        part.addAll(&v[i], 10);
        acc.merge(&part);
    }
    chk("30 merged parts of 10: variance", dmath.fabs(acc.variance(1) / w.variance(1) - 1.0) < 1.0e-12);
    // a huge offset: Welford keeps its digits where the sum of squares does not
    stats.Welford big;
    for (int i = 0; i < 1000; i++) { big.add(1.0e9 + (double) (i % 7)); }
    pv("variance of 1e9 + (i mod 7)", big.variance(1));
    w.reset();
    printf("after reset: count %d, mean is NaN %d, variance is NaN %d\n", w.size(), isNan(w.mean()), isNan(w.variance(1)));
    stats.Welford one;
    one.add(5.0);
    printfd("one value: mean %g, variance(1) is NaN %d, variance(0) %g\n", __bits(one.mean()), isNan(one.variance(1)), __bits(one.variance(0)));
    one.add(dmath.nan());
    printf("a NaN poisons the accumulator: mean %d min %d var %d\n", isNan(one.mean()), isNan(one.minimum()), isNan(one.variance(1)));
    stats.Welford cst;
    for (int i = 0; i < 10; i++) { cst.add(2.5); }
    printfd("constant data: variance %g, skewness is NaN %d\n", __bits(cst.variance(1)), isNan(cst.skewness()));

    // ---- Ema
    double s[12];
    for (int i = 0; i < 12; i++) { s[i] = (double) (lcg() % 100) / 4.0; }
    dumpV("series", s, 12);
    double out[12];
    stats.emaSeries(s, 12, 0.3, false, out);
    dumpV("ema alpha 0.3", out, 12);
    stats.emaSeries(s, 12, 0.3, true, out);
    dumpV("ema alpha 0.3, adjust", out, 12);
    pv("alpha for span 9", stats.emaAlphaFromSpan(9.0));
    pv("alpha for half life 3", stats.emaAlphaFromHalfLife(3.0));
    stats.Ema em(1.0, false);
    em.add(3.0);
    em.add(8.0);
    pv("alpha 1 follows the input", em.current());
    stats.Ema bad(0.0, false);
    printf("alpha 0 gives NaN: %d, emaSeries refuses alpha 2: %d\n", isNan(bad.add(1.0)), stats.emaSeries(s, 12, 2.0, false, out));
    stats.Ema fresh(0.5, false);
    printf("current of an empty Ema is NaN: %d\n", isNan(fresh.current()));
    fresh.add(4.0);
    fresh.reset();
    printf("after reset: %d count %d\n", isNan(fresh.current()), fresh.count);

    // ---- RollingStats
    {
        int n = 40;
        double d[40];
        for (int i = 0; i < n; i++) { d[i] = (double) (lcg() % 5000) / 13.0 - 150.0; }
        stats.RollingStats r(5);
        printf("window %d, ok %d\n", r.window(), r.ok());
        for (int i = 0; i < n; i++) {
            r.add(d[i]);
            if (i == 2 || i == 4 || i == 11 || i == 19 || i == 32 || i == 39) {
                printf("after %d values: size %d full %d\n", i + 1, r.size(), r.full());
                printfd("  mean %.9g sum %.9g variance %.9g stddev %.9g min %.9g max %.9g median %.9g\n", __bits(r.mean()), __bits(r.sum()), __bits(r.variance(1)), __bits(r.stddev(1)), __bits(r.minimum()), __bits(r.maximum()), __bits(r.median()));
            }
        }
        // every step against the batch functions of the last five values
        bool ok = true;
        stats.RollingStats r2(5);
        for (int i = 0; i < n; i++) {
            r2.add(d[i]);
            int k = (i + 1 < 5) ? i + 1 : 5;
            double* win = &d[i + 1 - k];
            if (dmath.fabs(r2.mean() - stats.mean(win, k)) > 1.0e-9) { ok = false; }
            if (dmath.fabs(r2.sum() - stats.sum(win, k)) > 1.0e-9) { ok = false; }
            if (r2.minimum() != stats.minimum(win, k) || r2.maximum() != stats.maximum(win, k)) { ok = false; }
            if (dmath.fabs(r2.median() - stats.median(win, k)) > 1.0e-9) { ok = false; }
            if (k >= 2 && dmath.fabs(r2.variance(1) - stats.variance(win, k, 1)) > 1.0e-6) { ok = false; }
        }
        chk("all 40 steps equal the batch statistics of the window", ok);
        r.dispose();
        r2.dispose();
        // a window of 1, and invalid sizes
        stats.RollingStats one(1);
        one.add(4.0);
        one.add(9.0);
        printfd("window 1: mean %g min %g max %g median %g variance(1) is NaN %d variance(0) %g\n", __bits(one.mean()), __bits(one.minimum()), __bits(one.maximum()), __bits(one.median()), isNan(one.variance(1)), __bits(one.variance(0)));
        one.dispose();
        stats.RollingStats zero(0);
        stats.RollingStats huge(0x4000001);
        zero.add(1.0);
        printf("window 0: ok %d size %d; window 2^26 + 1: ok %d; mean of nothing is NaN %d\n", zero.ok(), zero.size(), huge.ok(), isNan(zero.mean()));
        // NaN inside the window: every statistic is NaN until the NaN has left
        stats.RollingStats pn(3);
        double seq[8] = {1.0, 2.0, 3.0, dmath.nan(), 5.0, 6.0, 7.0, 8.0};
        printf("NaN window:");
        for (int i = 0; i < 8; i++) {
            pn.add(seq[i]);
            printf(" %d", isNan(pn.mean()) ? 1 : 0);
        }
        printfd("\nafter the NaN left: mean %g min %g max %g median %g\n", __bits(pn.mean()), __bits(pn.minimum()), __bits(pn.maximum()), __bits(pn.median()));
        pn.dispose();
        // 200000 values around 1e8 in a window of 100: no drift, memory stays flat
        stats.RollingStats big(100);
        int before = asys.memInUse();
        double last[100];
        for (int i = 0; i < 200000; i++) {
            double x = 1.0e8 + (double) (lcg() % 100000) / 100.0;
            big.add(x);
            last[i % 100] = x;
        }
        printfd("long run: mean %.9g variance %.9g min %.9g max %.9g median %.9g\n", __bits(big.mean()), __bits(big.variance(1)), __bits(big.minimum()), __bits(big.maximum()), __bits(big.median()));
        printf("long run: memory flat %d, added %d\n", asys.memInUse() == before, big.added());
        big.dispose();
    }

    // ---- moving averages
    {
        int n = 30;
        double d[30];
        for (int i = 0; i < n; i++) { d[i] = (double) (lcg() % 1000) / 7.0; }
        double ma[30];
        printf("movingAverage window 7: %d values\n", stats.movingAverage(d, n, 7, ma));
        dumpV("ma", ma, 24);
        double wma[30];
        printf("weightedMovingAverage window 4: %d values\n", stats.weightedMovingAverage(d, n, 4, wma));
        dumpV("wma", wma, 27);
        printf("window larger than the data: %d, window 0: %d, window equal to n: %d\n", stats.movingAverage(d, n, 31, ma), stats.movingAverage(d, n, 0, ma), stats.movingAverage(d, n, 30, ma));
        pv("single average", ma[0]);
        double cs[30];
        stats.cumsum(d, n, cs);
        dumpV("cumsum", cs, 30);
        // long series: the running window sum is recomputed exactly every window steps
        int m = 5000;
        double* big = (double*) asys.alloc(m * 8);
        double* bo = (double*) asys.alloc(m * 8);
        for (int i = 0; i < m; i++) { big[i] = 1.0e6 + (double) (lcg() % 1000) / 8.0; }
        int cnt = stats.movingAverage(big, m, 50, bo);
        double worst = 0.0;
        for (int i = 0; i < cnt; i += 97) {
            double want = stats.mean(&big[i], 50);
            double dd = dmath.fabs(bo[i] - want);
            if (dd > worst) { worst = dd; }
        }
        printf("long moving average: %d values, worst deviation from the exact mean below 1e-9: %d\n", cnt, worst < 1.0e-9);
        asys.free((char*) big);
        asys.free((char*) bo);
    }

    // ---- histogram of fixed bins
    {
        stats.Histogram h(5, 0.0, 10.0);
        double d[16] = {0.0, 1.999, 2.0, 2.0001, 3.5, 4.0, 5.5, 7.77, 8.0, 9.999, 10.0, -0.001, 10.001, 6.0, 6.0, 1.0};
        h.addAll(d, 16);
        h.add(dmath.nan());
        printf("bins %d total %d below %d above %d nans %d\n", h.bins, h.total, h.below, h.above, h.nans);
        printf("counts:");
        for (int i = 0; i < 5; i++) { printf(" %d", h.count(i)); }
        printf("\n");
        printf("edges:");
        for (int i = 0; i <= 5; i++) { printfd(" %g", __bits(h.edge(i))); }
        printf("\n");
        printf("density:");
        for (int i = 0; i < 5; i++) { printfd(" %.9g", __bits(h.density(i))); }
        printf("\n");
        double integral = 0.0;
        for (int i = 0; i < 5; i++) { integral += h.density(i) * h.width(); }
        printf("density integrates to 1: %d, fullest bin %d\n", dmath.fabs(integral - 1.0) < 1.0e-12, h.modeBin());
        printf("binOf: %d %d %d %d %d %d %d\n", h.binOf(-1.0), h.binOf(0.0), h.binOf(1.9999999), h.binOf(2.0), h.binOf(10.0), h.binOf(10.5), h.binOf(dmath.nan()));
        printf("out of range accessors: count(-1) %d count(5) %d, edge(6) is NaN %d, density(7) is NaN %d\n", h.count(-1), h.count(5), isNan(h.edge(6)), isNan(h.density(7)));
        h.dispose();
        printf("after dispose: ok %d, count(0) %d, bins %d\n", h.ok(), h.count(0), h.bins);
        stats.Histogram b1(0, 0.0, 1.0);
        stats.Histogram b2(3, 1.0, 1.0);
        stats.Histogram b3(3, 2.0, 1.0);
        stats.Histogram b4(3, 0.0, dmath.INFINITY);
        printf("invalid histograms: ok %d %d %d %d\n", b1.ok(), b2.ok(), b3.ok(), b4.ok());
    }

    // ---- automatic bins (the rules of NumPy)
    {
        int n = 200;
        double d[200];
        for (int i = 0; i < n; i++) { d[i] = (double) (lcg() % 100000) / 997.0; }
        pv("data minimum", stats.minimum(d, n));
        pv("data maximum", stats.maximum(d, n));
        int rules[7] = {stats.STURGES, stats.SQRT_RULE, stats.RICE, stats.SCOTT, stats.FD, stats.DOANE, stats.AUTO_RULE};
        char* names[7] = {"sturges", "sqrt", "rice", "scott", "fd", "doane", "auto"};
        for (int k = 0; k < 7; k++) {
            printf("%s:", names[k]);
            printfd(" width %.9g", __bits(stats.binWidth(d, n, rules[k])));
            printf(" bins %d", stats.binCount(d, n, rules[k]));
            stats.Histogram h = stats.histogramAuto(d, n, rules[k], 0);
            printf(" counts");
            for (int i = 0; i < h.bins; i++) { printf(" %d", h.count(i)); }
            printf(" total %d\n", h.total);
            h.dispose();
        }
        stats.Histogram f = stats.histogramAuto(d, n, stats.FD, 7);
        printf("fixed 7 bins:");
        for (int i = 0; i < 7; i++) { printf(" %d", f.count(i)); }
        printf("\n");
        f.dispose();
        double same[5] = {3.0, 3.0, 3.0, 3.0, 3.0};
        stats.Histogram c = stats.histogramAuto(same, 5, stats.AUTO_RULE, 0);
        printfd("constant data: bins %d, range %g .. %g, counts", c.bins, __bits(c.lo), __bits(c.hi));
        for (int i = 0; i < c.bins; i++) { printf(" %d", c.count(i)); }
        printf("\n");
        c.dispose();
        double nn[3] = {1.0, dmath.nan(), 2.0};
        stats.Histogram nh = stats.histogramAuto(nn, 3, stats.STURGES, 0);
        printf("data with NaN: ok %d, binWidth is zero %d, binCount %d\n", nh.ok(), stats.binWidth(nn, 3, stats.STURGES) == 0.0, stats.binCount(nn, 3, stats.STURGES));
        printf("one value: binWidth is zero %d, binCount %d\n", stats.binWidth(same, 1, stats.STURGES) == 0.0, stats.binCount(same, 1, stats.STURGES));
        printf("unknown rule: binWidth is zero %d\n", stats.binWidth(d, n, 99) == 0.0);
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
