// term: the key decoder - every common key sequence of the xterm family, the Linux console and rxvt
import term;

term.Decoder* dec;

// prints the bytes of s readably: ESC as \e, control characters as ^X, other bytes as they are
void showBytes(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        int c = s[i];
        if (c == 27) print("\\e");
        else if (c == 13) print("\\r");
        else if (c == 10) print("\\n");
        else if (c == 127) print("^?");
        else if (c < 32) { print("^"); printChar(c + 64); }
        else printChar(c);
    }
}

// prints the queued events
void drain() {
    term.Event e;
    char buf[64];
    while (dec->next(&e)) {
        term.describe(&e, &buf[0], 64);
        print(" ");
        print(&buf[0]);
    }
    println("");
}

// feeds the bytes one by one, then flushes (the Esc timeout), and prints the events
void check(char* seq) {
    showBytes(seq);
    print(" ->");
    dec->feedText(seq);
    dec->flush();
    drain();
}

int main() {
    dec = new term.Decoder();
    println("-- characters and UTF-8");
    check("a");
    check("Z");
    check("hi!");
    check("~");
    check("\xc3\xa9");
    check("\xe2\x82\xac");
    check("\xf0\x9f\x98\x80");
    check("\xc3");
    check("\xff");
    check("\xc3\x41");
    println("-- control characters");
    check("\x01");
    check("\x03");
    check("\x1a");
    check("\r");
    check("\n");
    check("\t");
    check("\x7f");
    check("\x08");
    dec->feed(0);
    check("");
    check("\x1c\x1d\x1e\x1f");
    println("-- Esc and Alt");
    check("\e");
    check("\ex");
    check("\eX");
    check("\e\r");
    check("\e\x7f");
    check("\e\x01");
    check("\e\e");
    check("\e\e[A");
    check("\e[");
    check("\eO");
    check("\e\xc3\xa9");
    println("-- arrows, home, end");
    check("\e[A\e[B\e[C\e[D");
    check("\eOA\eOB\eOC\eOD");
    check("\e[H\e[F\eOH\eOF");
    check("\e[1~\e[4~\e[7~\e[8~");
    check("\e[E");
    println("-- modifiers on arrows (xterm: 2 shift, 3 alt, 4 shift+alt, 5 ctrl, 6, 7, 8, 9 meta)");
    check("\e[1;2A");
    check("\e[1;3B");
    check("\e[1;4C");
    check("\e[1;5D");
    check("\e[1;6A");
    check("\e[1;7B");
    check("\e[1;8C");
    check("\e[1;9D");
    check("\e[1;5H\e[1;2F");
    println("-- editing keys");
    check("\e[2~\e[3~\e[5~\e[6~");
    check("\e[3;5~");
    check("\e[3;2~");
    check("\e[5;3~");
    println("-- function keys");
    check("\eOP\eOQ\eOR\eOS");
    check("\e[11~\e[12~\e[13~\e[14~");
    check("\e[15~\e[17~\e[18~\e[19~\e[20~\e[21~\e[23~\e[24~");
    check("\e[[A\e[[B\e[[C\e[[D\e[[E");
    check("\e[25~\e[26~\e[28~\e[29~\e[31~\e[32~\e[33~\e[34~");
    check("\e[1;5P");
    check("\e[1;2Q");
    check("\e[1;3R");
    check("\e[1;6S");
    check("\e[15;5~");
    check("\e[24;2~");
    check("\e[17;7~");
    println("-- tab");
    check("\e[Z");
    check("\e[1;5Z");
    println("-- keypad in application mode");
    check("\eOM\eOp\eOq\eOy\eOk\eOm\eOo\eOj");
    println("-- fixterms / kitty / modifyOtherKeys");
    check("\e[97;5u");
    check("\e[13;2u");
    check("\e[27;5;13~");
    check("\e[27;3;9~");
    check("\e[27;5;105~");
    check("\e[233;3u");
    check("\e[57344u");
    println("-- unknown or foreign sequences are dropped");
    check("\e[?1;2c");
    check("\e[?25;1$y");
    check("\e[99~");
    check("\e[200;1H");
    check("\e[38:2::1:2:3m");
    println("-- focus and replies");
    check("\e[I\e[O");
    check("\e[24;80R");
    check("\e[8;24;80t");
    println("-- byte by byte with a flush between (the Esc timeout)");
    dec->feed(27);
    println(dec->flushDelay() > 0 ? "pending: yes" : "pending: no");
    dec->feed('[');
    dec->feed('1');
    dec->feed(';');
    println(dec->count() == 0 ? "no event yet" : "event too early");
    dec->feed('5');
    dec->feed('C');
    check("");
    println(dec->flushDelay() == 0 ? "pending: no" : "pending: yes");
    println("-- Enter followed by NUL in the same read (telnet) is one Enter");
    print("CR NUL ->");
    dec->feed(13);
    dec->feed(0);
    drain();
    println("-- a NUL in the next read is Ctrl+Space (Enter, then Ctrl+Space for completion)");
    print("CR | NUL ->");
    dec->feed(13);
    dec->endRead();
    dec->feed(0);
    drain();
    print("x NUL ->");
    dec->feed('x');
    dec->feed(0);
    drain();
    println("-- crNul off: the NUL is never dropped");
    dec->crNul = false;
    print("CR NUL ->");
    dec->feed(13);
    dec->feed(0);
    drain();
    dec->crNul = true;
    return 0;
}
