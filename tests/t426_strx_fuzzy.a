// strx: fuzzy matching with scores and positions (quick open): a model of the score checked against the reported positions, ranking examples, UTF-8
import cstdio;
import cstring;
import asys;
import strx;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 5551212;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

int lowerOf(int c) { return (c >= 'A' && c <= 'Z') ? c + 32 : c; }
bool isWordCh(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'); }

// the bonus of a match at position j (the rules of the module, written down again)
int bonusOf(char* s, int j) {
    if (j == 0) { return 8; }
    int p = s[j - 1];
    int c = s[j];
    if (!isWordCh(p)) {
        if (p == ' ' || p == '\t') { return 10; }
        if (p == '/' || p == '\\') { return 9; }
        return 8;
    }
    if (p >= 'a' && p <= 'z' && c >= 'A' && c <= 'Z') { return 7; }
    if (!(p >= '0' && p <= '9') && c >= '0' && c <= '9') { return 7; }
    return 0;
}

// the score of a given choice of positions
int modelScore(char* cand, int* pos, int m) {
    int total = 0;
    int chunk = 0;
    for (int i = 0; i < m; i++) {
        int b = bonusOf(cand, pos[i]);
        if (i == 0) { total = 16 + 2 * b; chunk = b; continue; }
        if (pos[i] == pos[i - 1] + 1) {
            int eff = (b > 4) ? b : 4;
            if (chunk >= 8 && chunk > eff) { eff = chunk; }
            total = total + 16 + eff;
            chunk = (chunk >= 8) ? chunk : b;
        } else {
            int gap = pos[i] - pos[i - 1] - 1;
            total = total + 16 + b - 3 - (gap - 1);
            chunk = b;
        }
    }
    return total;
}

// the best model score over all choices of positions (brute force, small inputs)
int bestModel(char* pat, int m, char* cand, int n, bool icase, int from, int* pos, int depth) {
    if (depth == m) { return modelScore(cand, pos, m); }
    int best = -1;
    for (int j = from; j < n; j++) {
        bool same = icase ? (lowerOf(cand[j]) == lowerOf(pat[depth])) : (cand[j] == pat[depth]);
        if (!same) { continue; }
        pos[depth] = j;
        int v = bestModel(pat, m, cand, n, icase, j + 1, pos, depth + 1);
        if (v > best) { best = v; }
    }
    return best;
}

void randomChecks() {
    char pat[8];
    char cand[24];
    int pos[8];
    int tmp[8];
    int badMatch = 0;
    int badPos = 0;
    int badModel = 0;
    int badBest = 0;
    int below = 0;
    int total = 0;
    for (int round = 0; round < 3000; round++) {
        int m = rnd(4);
        int n = rnd(14);
        for (int i = 0; i < m; i++) { pat[i] = (rnd(4) == 0) ? 'A' + rnd(3) : 'a' + rnd(3); }
        pat[m] = 0;
        for (int i = 0; i < n; i++) {
            int r = rnd(10);
            cand[i] = (r < 6) ? 'a' + rnd(3) : (r < 8 ? 'A' + rnd(3) : (r == 8 ? '_' : '/'));
        }
        cand[n] = 0;
        bool hasUpper = false;
        for (int i = 0; i < m; i++) { if (pat[i] >= 'A' && pat[i] <= 'Z') { hasUpper = true; } }
        bool icase = !hasUpper;                                    // smart case
        // is the pattern a subsequence under the case rule?
        int k = 0;
        for (int j = 0; j < n && k < m; j++) {
            bool same = icase ? (lowerOf(cand[j]) == lowerOf(pat[k])) : (cand[j] == pat[k]);
            if (same) { k++; }
        }
        bool isSub = (k == m);
        int sc = strx.fuzzyScore(&pat[0], &cand[0], &pos[0]);
        if ((sc >= 0) != isSub) { badMatch++; continue; }
        if (m == 0) { if (sc != 0) { badMatch++; } continue; }
        if (!isSub) { continue; }
        // the positions are increasing and the letters match
        for (int i = 0; i < m; i++) {
            bool same = icase ? (lowerOf(cand[pos[i]]) == lowerOf(pat[i])) : (cand[pos[i]] == pat[i]);
            if (!same || (i > 0 && pos[i] <= pos[i - 1])) { badPos++; break; }
        }
        // the score is the model score of the reported positions
        if (modelScore(&cand[0], &pos[0], m) != sc) { badModel++; }
        // it is never better than the best possible choice
        int best = bestModel(&pat[0], m, &cand[0], n, icase, 0, &tmp[0], 0);
        if (sc > best) { badBest++; }
        total++;
        if (sc < best) { below++; }
    }
    check(badMatch == 0, "a score exists exactly when the pattern is a subsequence (smart case), empty pattern scores 0 (3000 random cases)");
    check(badPos == 0, "the reported positions increase and carry the pattern letters");
    check(badModel == 0, "the score equals the model score of the reported positions");
    check(badBest == 0, "the score is never above the best choice of positions");
    check(total > 500 && below * 20 < total, "the choice is the best one in more than 95 percent of the cases");
}

void show(char* pat, char** items, int n) {
    strx.FuzzyMatcher f(pat);
    int idx[40];
    int sc[40];
    int k = f.rank(items, n, &idx[0], 40, &sc[0]);
    printf("pattern %s:", pat);
    for (int i = 0; i < k; i++) { printf(" %s(%d)", items[idx[i]], sc[i]); }
    printf("\n");
    f.dispose();
}

void rankings() {
    char* files[12] = { "src/main.a", "src/domain.a", "lib/strx.a", "docs/ALGO.md", "tests/t420_strx_search.a", "README.md", "src/make_all.a", "fooBar.a", "foo_bar.a", "fabulous.txt", "xfxb", "bar_foo" };
    show("fb", files, 12);
    show("main", files, 12);
    show("sx", files, 12);
    show("ma", files, 12);
    show("strx", files, 12);
    show("FB", files, 12);
    show("readme", files, 12);
    show("t420", files, 12);
    show("", files, 3);
    int pos[8];
    check(strx.fuzzyScore("fb", "foo_bar", &pos[0]) > 0 && pos[0] == 0 && pos[1] == 4, "fb in foo_bar: 0 and 4");
    check(strx.fuzzyScore("fb", "fooBar", &pos[0]) > 0 && pos[0] == 0 && pos[1] == 3, "fb in fooBar: 0 and 3");
    // ordering relations
    check(strx.fuzzyScore("abc", "abc") > strx.fuzzyScore("abc", "a b c"), "a consecutive match beats the same letters apart");
    check(strx.fuzzyScore("abc", "xabcx") > strx.fuzzyScore("abc", "xaxbxc"), "consecutive beats scattered");
    check(strx.fuzzyScore("bar", "foo_bar") > strx.fuzzyScore("bar", "foobar"), "a word start beats the middle of a word");
    check(strx.fuzzyScore("bar", "fooBar") > strx.fuzzyScore("bar", "foobar"), "a camel case hump beats the middle of a word");
    check(strx.fuzzyScore("bar", "foo/bar") >= strx.fuzzyScore("bar", "foo_bar"), "after a path separator is as good as after an underscore");
    check(strx.fuzzyScore("ab", "ab") > strx.fuzzyScore("ab", "a-----b"), "gaps cost");
    check(strx.fuzzyScore("ab", "a-b") > strx.fuzzyScore("ab", "a--b"), "longer gaps cost more");
    check(strx.fuzzyScore("x", "") == -1 && strx.fuzzyScore("", "") == 0 && strx.fuzzyScore("", "abc") == 0 && strx.fuzzyScore("abc", "ab") == -1, "empty strings, pattern longer than the text");
    // case rules
    check(strx.fuzzyScore("foo", "FOO.a") > 0 && strx.fuzzyScore("Foo", "foo.a") == -1 && strx.fuzzyScore("Foo", "Foo.a") > 0, "smart case");
    check(strx.fuzzyScore("Foo", "foo.a", null, strx.FUZZY_IGNORE_CASE) > 0 && strx.fuzzyScore("foo", "Foo.a", null, strx.FUZZY_CASE) == -1, "case flags");
    // null positions are fine; matcher reuse with candidates of growing length
    strx.FuzzyMatcher f("tst");
    check(f.length() == 3 && f.score("test", -1, null) > 0, "matcher: short candidate");
    char* longer = "a long candidate string with the letters t, s and t somewhere";
    check(f.score(longer, -1, &pos[0]) > 0 && pos[0] < pos[1] && pos[1] < pos[2], "matcher: longer candidate");
    check(f.score("test", 2, null) == -1, "matcher: n limits the candidate (te)");
    f.dispose();
}

void ranking() {
    strx.FuzzyMatcher f("ab");
    char* items[6] = { "xxab", "ab", "a_b", "nothing", "abab", "ba" };
    int idx[6];
    int sc[6];
    int n = f.rank(&items[0], 6, &idx[0], 6, &sc[0]);
    check(n == 4 && idx[0] == 1, "rank: four candidates match, the exact one is first");
    check(sc[0] >= sc[1] && sc[1] >= sc[2] && sc[2] >= sc[3], "rank: scores are in descending order");
    // equal scores: the shorter first, then the earlier index
    char* same[4] = { "ab-long-tail", "ab", "ab", "ab-" };
    n = f.rank(&same[0], 4, &idx[0], 4, null);
    check(n == 4 && idx[0] == 1 && idx[1] == 2, "rank: ties go to the shorter text, then to the earlier index");
    n = f.rank(&items[0], 6, &idx[0], 2, null);
    check(n == 2, "rank: max limits the result");
    check(f.rank(&items[0], 6, &idx[0], 0, null) == 0 && f.rank(&items[0], -1, &idx[0], 3, null) == 0 && f.rank(&items[0], 0x1000000, &idx[0], 3, null) == 0, "rank: bad arguments");
    char* withNull[3] = { "ab", null, "ba" };
    check(f.rank(&withNull[0], 3, &idx[0], 3, null) == 1 && idx[0] == 0, "rank: a null item is skipped");
    f.dispose();
    // 120000 file names
    int count = 120000;
    char** names = (char**) alloc((count + 1) * 8);
    char* store = alloc(count * 32);
    for (int i = 0; i < count; i++) {
        names[i] = &store[i * 32];
        format(names[i], 32, "src/dir%d/file%d.a", rnd(300), i);
    }
    strx.FuzzyMatcher g("d12f77");
    int top[10];
    int got = g.rank(names, count, &top[0], 10, null);
    check(got == 10 && strstr(names[top[0]], "dir12") != null, "rank: 120000 names, the best match is in dir12");
    // every result really contains the letters in order
    bool allSub = true;
    for (int i = 0; i < got; i++) {
        char* s = names[top[i]];
        char* want = "d12f77";
        int k = 0;
        for (int j = 0; s[j] != 0 && want[k] != 0; j++) { if (s[j] == want[k]) { k++; } }
        if (want[k] != 0) { allSub = false; }
    }
    check(allSub, "rank: all ten are subsequence matches");
    g.dispose();
}

void unicode() {
    int pos[4];
    char* cafe = "Caf\xc3\xa9";                                   // Cafe with an acute accent
    check(strx.fuzzyScore("\xc3\xa9", cafe, &pos[0], strx.FUZZY_UTF8) > 0 && pos[0] == 3, "utf8: the accented letter is found at byte 3");
    check(strx.fuzzyScore("\xc3\x89", cafe, &pos[0], strx.FUZZY_UTF8 | strx.FUZZY_IGNORE_CASE) > 0 && pos[0] == 3, "utf8: E acute matches e acute when ignoring case");
    check(strx.fuzzyScore("\xc3\x89", cafe, &pos[0], strx.FUZZY_UTF8 | strx.FUZZY_CASE) == -1 && strx.fuzzyScore("\xc3\x89", cafe, &pos[0], strx.FUZZY_UTF8) == -1, "utf8: ... but not when case sensitive, nor with smart case (the pattern has a capital)");
    // as bytes the lead byte of e-acute and of o-acute... a pattern of the lead byte alone matches in byte mode only
    check(strx.fuzzyScore("\xc3", cafe, &pos[0]) > 0 && pos[0] == 3, "bytes: a single lead byte matches");
    check(strx.fuzzyScore("\xc3", cafe, &pos[0], strx.FUZZY_UTF8) == -1, "utf8: a lone lead byte is its own symbol and matches nothing here");
    char* cyr = "\xd0\x96\xd1\x83\xd0\xba";                       // Zhe, u, ka
    check(strx.fuzzyScore("\xd0\xb6\xd1\x83", cyr, &pos[0], strx.FUZZY_UTF8) > 0 && pos[0] == 0 && pos[1] == 2, "utf8: Cyrillic letters ignoring case");
    char* greek = "\xce\x91\xce\xb2";
    check(strx.fuzzyScore("\xce\xb1\xce\xb2", greek, &pos[0], strx.FUZZY_UTF8) > 0 && pos[1] == 2, "utf8: Greek capital alpha matches small alpha");
    // multi byte characters are not word boundaries inside
    check(strx.fuzzyScore("b", "\xc3\xa9" "b", &pos[0], strx.FUZZY_UTF8) > 0 && pos[0] == 2, "utf8: positions are byte offsets");
}

void longInputs() {
    // a candidate longer than 1024 symbols and a pattern longer than 64: a cheaper score, but still valid positions
    int n = 5000;
    char* cand = alloc(n + 1);
    for (int i = 0; i < n; i++) { cand[i] = 'a' + (i % 7); }
    int pos[8];
    int sc = strx.fuzzyScore("gfe", cand, &pos[0]);
    check(sc > 0 && cand[pos[0]] == 'g' && cand[pos[1]] == 'f' && cand[pos[2]] == 'e' && pos[0] < pos[1] && pos[1] < pos[2], "candidate of 5000 letters");
    char pat[100];
    for (int i = 0; i < 90; i++) { pat[i] = 'a' + (i % 3); }
    pat[90] = 0;
    char* cand2 = alloc(1000);
    for (int i = 0; i < 900; i++) { cand2[i] = 'a' + (i % 3); }
    int* positions = (int*) alloc(100 * 8);
    sc = strx.fuzzyScore(&pat[0], cand2, positions);
    bool ok = sc > 0;
    for (int i = 0; i < 90 && ok; i++) { if (cand2[positions[i]] != pat[i] || (i > 0 && positions[i] <= positions[i - 1])) { ok = false; } }
    check(ok, "pattern of 90 letters");
    check(strx.fuzzyScore("zzz", cand, null) == -1, "5000 letters without the pattern");
}

int main() {
    randomChecks();
    rankings();
    ranking();
    unicode();
    longInputs();
    check(asys.memBadFrees() == 0, "no bad free");
    printf("fuzzy: %d checks, %d failures\n", checks, fails);
    return fails;
}
