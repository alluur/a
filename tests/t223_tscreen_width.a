// tscreen: character widths (zero, one and two cells) and the text measuring helpers
import tscreen;

void w(int cp) { printf("U+%04X: %d\n", cp, tscreen.runeWidth(cp)); }

int main() {
    println("-- single characters");
    w('a'); w(' '); w('~'); w(0x7F); w(0); w(10); w(0x9F); w(0xA0); w(0xE9);
    w(0x300); w(0x301); w(0x36F); w(0x370);
    w(0x200B); w(0x200D); w(0xFEFF); w(0xAD);
    w(0x1100); w(0x1160); w(0x11FF); w(0xAC00); w(0xD7A3);
    w(0x2E80); w(0x3000); w(0x3041); w(0x30A2); w(0x4E00); w(0x9FFF); w(0xFF01); w(0xFF60); w(0xFF61); w(0xFFE0);
    w(0x1F300); w(0x1F600); w(0x1F9E9); w(0x2764); w(0x2705); w(0x231A); w(0x20000); w(0x2FFFD); w(0x30000);
    w(0x2500); w(0x2588); w(0x25B6); w(0x2603); w(0x1F1E6);
    w(0xE0100); w(0x10FFFF);
    println("-- texts");
    printlnInt(tscreen.textWidth(""));
    printlnInt(tscreen.textWidth("hello"));
    printlnInt(tscreen.textWidth("h\xc3\xa9llo"));
    printlnInt(tscreen.textWidth("e\xcc\x81"));
    printlnInt(tscreen.textWidth("\xe4\xb8\x96\xe7\x95\x8c"));
    printlnInt(tscreen.textWidth("ab\xe4\xb8\x96\xf0\x9f\x98\x80z"));
    printlnInt(tscreen.textWidth("\xe2\x94\x8c\xe2\x94\x80\xe2\x94\x90"));
    printlnInt(tscreen.textWidthN("ab\xe4\xb8\x96z", 4));
    println("-- fitting into cells");
    printlnInt(tscreen.fitBytes("hello", 3));
    printlnInt(tscreen.fitBytes("hello", 10));
    printlnInt(tscreen.fitBytes("\xe4\xb8\x96\xe7\x95\x8c", 3));
    printlnInt(tscreen.fitBytes("\xe4\xb8\x96\xe7\x95\x8c", 4));
    printlnInt(tscreen.fitBytes("a\xe4\xb8\x96", 2));
    printlnInt(tscreen.fitBytes("e\xcc\x81x", 1));
    println("-- text on a screen");
    tscreen.Screen s(12, 6);
    s.clear(0);
    int x = s.text(0, 0, "ab", 0);
    x = s.text(x, 0, "\xe4\xb8\x96\xe7\x95\x8c", 0);
    x = s.text(x, 0, "z", 0);
    printlnInt(x);
    s.text(0, 1, "e\xcc\x81" "o\xcc\x88" "u", 0);
    printlnInt(s.textMax(0, 2, "\xe4\xb8\x96\xe7\x95\x8c" "abc", 5, 0));
    printlnInt(s.textEllipsis(0, 3, "a long line of text", 8, 0));
    printlnInt(s.textEllipsis(0, 4, "short", 8, 0));
    s.text(0, 5, "tab\there\x01", 0);
    println(s.dump());
    println("-- overwriting half of a wide character blanks the other half");
    s.clear(0);
    s.text(2, 0, "\xe4\xb8\x96\xe7\x95\x8c", 0);
    s.put(3, 0, 'x', 0);
    s.text(2, 1, "\xe4\xb8\x96\xe7\x95\x8c", 0);
    s.put(2, 1, 'y', 0);
    s.text(2, 2, "\xe4\xb8\x96\xe7\x95\x8c", 0);
    s.text(3, 2, "\xf0\x9f\x98\x80", 0);
    println(s.dump());
    println("-- a wide character that does not fit at the clip edge is replaced by a blank");
    s.clear(0);
    s.pushClip(0, 0, 5, 1);
    s.text(2, 0, "ab\xe4\xb8\x96\xe4\xb8\x96", 0);
    s.popClip();
    println(s.dump());
    return 0;
}
