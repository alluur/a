// optim: linear programming (two phase simplex): classic examples, equality and greater-or-equal rows, degenerate problems that make Dantzig's rule cycle (Beale),
// infeasible and unbounded programs, rank deficient equations, and 60 random programs whose optimum Python finds by enumerating every vertex with exact fractions
// (tests/algo2_ref/gen_t461.py).
import cstdio;
import asys;
import optim;
import dmath;

int seed = 3141592;
int lcg() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed;
}

bool isNan(double v) { return v != v; }

// checks the solution x of a program and returns whether it is feasible and its objective equals c.x
bool verify(double* c, int n, double* A, int m, double* b, int* kinds, double* x, double obj) {
    double s = 0.0;
    for (int j = 0; j < n; j++) {
        if (x[j] < -1.0e-9) { return false; }
        s += c[j] * x[j];
    }
    if (dmath.fabs(s - obj) > 1.0e-9 * (1.0 + dmath.fabs(obj))) { return false; }
    for (int i = 0; i < m; i++) {
        double r = 0.0;
        for (int j = 0; j < n; j++) { r += A[i * n + j] * x[j]; }
        int k = (kinds != null) ? kinds[i] : optim.LE;
        if (k == optim.LE && r > b[i] + 1.0e-7) { return false; }
        if (k == optim.GE && r < b[i] - 1.0e-7) { return false; }
        if (k == optim.EQ && dmath.fabs(r - b[i]) > 1.0e-7) { return false; }
    }
    return true;
}

void solveShow(char* name, double* c, int n, double* A, int m, double* b, int* kinds, bool maximize) {
    double x[10];
    double obj = 0.0;
    int it = 0;
    int st = optim.linprog(c, n, A, m, b, kinds, maximize, x, &obj, &it);
    printf("%s: status %d", name, st);
    if (st == 0) {
        printfd(" objective %.9g, feasible and objective = c.x: %d, pivots at most 100: %d", __bits(obj), verify(c, n, A, m, b, kinds, x, obj), it <= 100);
    }
    printf("\n");
}

int main() {
    int base = asys.memInUse();
    // ---- classic examples
    {
        double c[2] = {-3.0, -5.0};
        double A[6] = {1.0, 0.0, 0.0, 2.0, 3.0, 2.0};
        double b[3] = {4.0, 12.0, 18.0};
        solveShow("min -3x - 5y, x <= 4, 2y <= 12, 3x + 2y <= 18", c, 2, A, 3, b, null, false);
        double x[2];
        double obj;
        optim.linprog(c, 2, A, 3, b, null, false, x, &obj, null);
        printfd("  solution (%.9g, %.9g)\n", __bits(x[0]), __bits(x[1]));
        double c2[2] = {3.0, 5.0};
        solveShow("max 3x + 5y with the same constraints", c2, 2, A, 3, b, null, true);
        double c3[3] = {4.0, 2.0, 1.0};
        double A3[9] = {1.0, 0.0, 0.0, 4.0, 1.0, 0.0, 8.0, 4.0, 1.0};
        double b3[3] = {5.0, 25.0, 125.0};
        solveShow("Klee-Minty 3: max 4 x1 + 2 x2 + x3", c3, 3, A3, 3, b3, null, true);
        double x3[3];
        optim.linprog(c3, 3, A3, 3, b3, null, true, x3, &obj, null);
        printfd("  solution (%.9g, %.9g, %.9g)\n", __bits(x3[0]), __bits(x3[1]), __bits(x3[2]));
    }
    // ---- equality, >=, negative right hand sides
    {
        double c[2] = {1.0, 2.0};
        double A[2] = {1.0, 1.0};
        double b[1] = {3.0};
        int ge[1] = {optim.GE};
        solveShow("min x + 2y, x + y >= 3", c, 2, A, 1, b, ge, false);
        double nb[1] = {-3.0};
        double nA[2] = {-1.0, -1.0};
        int le[1] = {optim.LE};
        solveShow("min x + 2y, -x - y <= -3 (negative right hand side)", c, 2, nA, 1, nb, le, false);
        int eq[1] = {optim.EQ};
        double c2[2] = {2.0, 1.0};
        double b5eq[1] = {5.0};
        solveShow("min 2x + y, x + y = 5", c2, 2, A, 1, b5eq, eq, false);
        double A2[4] = {1.0, 1.0, 2.0, 2.0};
        double b2[2] = {2.0, 4.0};
        int eq2[2] = {optim.EQ, optim.EQ};
        double c3[2] = {1.0, 0.0};
        solveShow("redundant equations x + y = 2, 2x + 2y = 4, min x", c3, 2, A2, 2, b2, eq2, false);
        double b3[2] = {2.0, 5.0};
        solveShow("contradicting equations x + y = 2, 2x + 2y = 5", c3, 2, A2, 2, b3, eq2, false);
        int mixed[2] = {optim.GE, optim.LE};
        double A5[4] = {1.0, 1.0, 1.0, 1.0};
        double b5[2] = {4.0, 4.0};
        double c13[2] = {1.0, 3.0};
        solveShow("x + y >= 4 and x + y <= 4 together, min x + 3y", c13, 2, A5, 2, b5, mixed, false);
    }
    // ---- infeasible, unbounded and trivial programs
    {
        double c[1] = {1.0};
        double A[2] = {1.0, 1.0};
        double b[2] = {5.0, 3.0};
        int k[2] = {optim.GE, optim.LE};
        solveShow("x >= 5 and x <= 3", c, 1, A, 2, b, k, false);
        double cu[2] = {-1.0, 0.0};
        double Au[2] = {1.0, -1.0};
        double bu[1] = {1.0};
        solveShow("min -x, x - y <= 1 (unbounded)", cu, 2, Au, 1, bu, null, false);
        double cb[2] = {1.0, 1.0};
        solveShow("min x + y with no constraint", cb, 2, null, 0, null, null, false);
        double cn[2] = {-1.0, 1.0};
        double xx[2];
        double o;
        printf("min -x + y with no constraint (unbounded): %d\n", optim.linprog(cn, 2, Au, 0, bu, null, false, xx, &o, null));
        double z[2] = {0.0, 0.0};
        double Az[2] = {1.0, 1.0};
        double bz[1] = {10.0};
        solveShow("zero objective (a feasibility problem)", z, 2, Az, 1, bz, null, false);
        double Ar[2] = {0.0, 0.0};
        double br[1] = {-1.0};
        solveShow("0 x <= -1 (an empty row)", cb, 2, Ar, 1, br, null, false);
        double br2[1] = {5.0};
        solveShow("0 x <= 5 (an empty row that always holds)", cb, 2, Ar, 1, br2, null, false);
        double c1[1] = {-2.0};
        double A1[1] = {1.0};
        double b1[1] = {7.0};
        solveShow("one variable: min -2x, x <= 7", c1, 1, A1, 1, b1, null, false);
    }
    // ---- Beale's example of cycling with Dantzig's rule (the optimum is -0.05 at (0.04, 0, 1, 0))
    {
        double c[4] = {-0.75, 150.0, -0.02, 6.0};
        double A[12] = {0.25, -60.0, -0.04, 9.0, 0.5, -90.0, -0.02, 3.0, 0.0, 0.0, 1.0, 0.0};
        double b[3] = {0.0, 0.0, 1.0};
        solveShow("Beale's cycling example", c, 4, A, 3, b, null, false);
        double x[4];
        double obj;
        int it;
        optim.linprog(c, 4, A, 3, b, null, false, x, &obj, &it);
        printfd("  solution (%.9g, %.9g, %.9g, %.9g)\n", __bits(x[0]), __bits(x[1]), __bits(x[2]), __bits(x[3]));
    }
    // ---- a transportation problem: 3 sources, 3 sinks, supplies 20, 30, 25 and demands 15, 35, 25 (equalities)
    {
        double cost[9] = {8.0, 6.0, 10.0, 9.0, 12.0, 13.0, 14.0, 9.0, 16.0};
        double A[54];
        for (int i = 0; i < 54; i++) { A[i] = 0.0; }
        double b[6] = {20.0, 30.0, 25.0, 15.0, 35.0, 25.0};
        int k[6] = {optim.EQ, optim.EQ, optim.EQ, optim.EQ, optim.EQ, optim.EQ};
        for (int s = 0; s < 3; s++) {
            for (int t = 0; t < 3; t++) {
                A[s * 9 + s * 3 + t] = 1.0;
                A[(3 + t) * 9 + s * 3 + t] = 1.0;
            }
        }
        solveShow("transportation problem 3 x 3", cost, 9, A, 6, b, k, false);
    }
    // ---- a diet problem (6 foods, 4 nutrient minimums)
    {
        double price[6] = {0.18, 0.23, 0.05, 0.30, 0.12, 0.20};
        double nut[24] = {110.0, 205.0, 160.0, 160.0, 420.0, 260.0,
                          4.0, 14.0, 13.0, 8.0, 4.0, 14.0,
                          2.0, 12.0, 54.0, 285.0, 22.0, 80.0,
                          30.0, 20.0, 8.0, 9.0, 15.0, 22.0};
        double need[4] = {2000.0, 55.0, 800.0, 100.0};
        int k[4] = {optim.GE, optim.GE, optim.GE, optim.GE};
        solveShow("diet problem", price, 6, nut, 4, need, k, false);
    }
    // ---- 60 random programs
    {
        for (int t = 0; t < 60; t++) {
            int n = 2 + lcg() % 3;
            int m = 3 + lcg() % 4;
            double c[4];
            for (int j = 0; j < n; j++) { c[j] = (double) (lcg() % 11 - 5); }
            double A[40];
            double b[10];
            int kinds[10];
            for (int i = 0; i < m; i++) {
                for (int j = 0; j < n; j++) { A[i * n + j] = (double) (lcg() % 9 - 3); }
                b[i] = (double) (lcg() % 20 - 3);
                int r = lcg() % 10;
                kinds[i] = (r < 6) ? optim.LE : ((r < 9) ? optim.GE : optim.EQ);
            }
            // a bounding row keeps every program bounded
            for (int j = 0; j < n; j++) { A[m * n + j] = 1.0; }
            b[m] = 30.0;
            kinds[m] = optim.LE;
            bool maximize = (lcg() % 2) == 1;
            char name[40];
            sprintf(name, "random program %d (n %d, m %d, %s)", t, n, m + 1, maximize ? "max" : "min");
            solveShow(name, c, n, A, m + 1, b, kinds, maximize);
        }
    }
    // ---- invalid input
    {
        double c[2] = {1.0, 1.0};
        double A[2] = {1.0, 1.0};
        double b[1] = {1.0};
        double x[2];
        double obj;
        double nanC[2] = {1.0, dmath.nan()};
        double nanB[1] = {dmath.nan()};
        double infA[2] = {1.0, dmath.INFINITY};
        int bad[1] = {5};
        printf("NaN in c: %d, in b: %d, infinity in A: %d (ERR_NAN = %d)\n", optim.linprog(nanC, 2, A, 1, b, null, false, x, &obj, null), optim.linprog(c, 2, A, 1, nanB, null, false, x, &obj, null), optim.linprog(c, 2, infA, 1, b, null, false, x, &obj, null), optim.ERR_NAN);
        printf("n = 0: %d, m < 0: %d, null c: %d, null x: %d, unknown row kind: %d (ERR_ARG = %d)\n", optim.linprog(c, 0, A, 1, b, null, false, x, &obj, null), optim.linprog(c, 2, A, -1, b, null, false, x, &obj, null), optim.linprog(null, 2, A, 1, b, null, false, x, &obj, null),
               optim.linprog(c, 2, A, 1, b, null, false, null, &obj, null), optim.linprog(c, 2, A, 1, b, bad, false, x, &obj, null), optim.ERR_ARG);
        printf("errorText of the program statuses: %s | %s\n", optim.errorText(optim.LP_INFEASIBLE), optim.errorText(optim.LP_UNBOUNDED));
    }
    printf("memory leaked: %d\n", asys.memInUse() - base);
    return 0;
}
