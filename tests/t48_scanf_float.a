import cstdio;

// reads doubles with scanf / sscanf (stored as bit patterns, printed with printfd)
int main() {
    int x;
    int y;
    int z;
    int n;
    char w[32];
    n = sscanf("3.25 -1e3 0x1p4", "%lf %lf %lf", &x, &y, &z);
    printfd("%d: %g %g %g\n", n, x, y, z);
    n = sscanf("price=12.50USD", "price=%lf%s", &x, w);
    printfd("%d: %.2f %s\n", n, x, w);
    n = sscanf("1.5abc", "%lf%s", &x, w);
    printfd("%d: %.2f %s\n", n, x, w);
    n = sscanf("abc", "%lf", &x);
    printfd("%d\n", n);
    n = sscanf("", "%lf", &x);
    printfd("%d\n", n);
    n = sscanf("  .5e1,7", "%lf,%lf", &x, &y);
    printfd("%d: %g\n", n, x);
    n = sscanf("1e5x", "%le%s", &x, w);
    printfd("%d: %g %s\n", n, x, w);
    n = sscanf("inf -inf nan", "%lf %lf %lf", &x, &y, &z);
    printfd("%d: %g %g %g\n", n, x, y, z);
    n = sscanf("12345.6789", "%5lf%lf", &x, &y);
    printfd("%d: %g %g\n", n, x, y);
    n = sscanf("3.14159 2.71828", "%*f %lf", &x);
    printfd("%d: %.5f\n", n, x);
    // from standard input
    n = scanf("%lf %lf", &x, &y);
    printfd("%d: %g + %g = %g\n", n, x, y, dadd(x, y));
    n = scanf("%lf", &x);
    printfd("%d: %g\n", n, x);
    n = scanf("%s", w);
    printfd("%d: %s\n", n, w);
    return 0;
}
