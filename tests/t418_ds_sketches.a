// ds: BloomFilter and CountMinSketch: no false negatives, error rates within the documented bounds, merge, byte and text keys
import cstdio;
import cstring;
import asys;
import ds;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

int seed = 1999;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void bloom() {
    // sizing: the same inputs give the same sizes on every target
    ds.BloomFilter a(1000, 100);
    printf("bloom(1000, 1 in 100): %d bits, %d hash functions\n", a.bitCount(), a.hashCount());
    ds.BloomFilter b(10000, 1000);
    printf("bloom(10000, 1 in 1000): %d bits, %d hash functions\n", b.bitCount(), b.hashCount());
    ds.BloomFilter c(100, 2);
    printf("bloom(100, 1 in 2): %d bits, %d hash functions\n", c.bitCount(), c.hashCount());
    // no false negatives
    for (int i = 0; i < 1000; i++) { a.add(i * 7919); }
    bool all = true;
    for (int i = 0; i < 1000; i++) { if (!a.mightContain(i * 7919)) { all = false; } }
    check(all && a.count() == 1000, "no false negatives");
    // false positives: well below twice the target
    int fp = 0;
    for (int i = 0; i < 20000; i++) { if (a.mightContain(1000000 + i)) { fp++; } }
    check(fp < 2 * 20000 / 100, "false positive rate below 2 percent for a target of 1 percent");
    check(a.fillPermille() > 300 && a.fillPermille() < 700, "about half of the bits are set at the design load");
    int est = a.falsePositivePpm();
    check(est > 1000 && est < 30000, "the estimated false positive rate is in the right range");
    // text and bytes
    ds.BloomFilter t(500, 100);
    char buf[24];
    for (int i = 0; i < 500; i++) {
        format(&buf[0], 24, "user-%d@example.org", i);
        t.addText(&buf[0]);
    }
    bool textOk = true;
    for (int i = 0; i < 500; i++) {
        format(&buf[0], 24, "user-%d@example.org", i);
        if (!t.mightContainText(&buf[0])) { textOk = false; }
    }
    int tfp = 0;
    for (int i = 500; i < 5500; i++) {
        format(&buf[0], 24, "user-%d@example.org", i);
        if (t.mightContainText(&buf[0])) { tfp++; }
    }
    check(textOk && tfp < 2 * 5000 / 100, "text keys");
    ds.BloomFilter by(100, 100);
    by.addBytes("ab\0cd", 5);
    check(by.mightContainBytes("ab\0cd", 5) && !by.mightContainBytes("ab\0ce", 5), "byte keys with a NUL inside");
    check(by.mightContainBytes("ab", 2) == by.mightContainText("ab") && !by.mightContain(5) , "bytes and text hash alike");
    // merge
    ds.BloomFilter m1(1000, 100, 7);
    ds.BloomFilter m2(1000, 100, 7);
    for (int i = 0; i < 100; i++) { m1.add(i); m2.add(i + 1000); }
    check(m1.merge(&m2) && m1.mightContain(5) && m1.mightContain(1005) && m1.count() == 200, "merge");
    ds.BloomFilter other(1000, 100, 8);
    ds.BloomFilter smaller(10, 100, 7);
    check(!m1.merge(&other) && !m1.merge(&smaller), "filters with another seed or size cannot be merged");
    // the seed changes the bit pattern
    ds.BloomFilter s1(100, 100, 1);
    ds.BloomFilter s2(100, 100, 2);
    for (int i = 0; i < 100; i++) { s1.add(i); s2.add(i); }
    int diff = 0;
    for (int i = 100; i < 600; i++) { if (s1.mightContain(i) != s2.mightContain(i)) { diff++; } }
    check(diff > 0, "different seeds give different false positives");
    a.clear();
    check(a.count() == 0 && !a.mightContain(7919) && a.fillPermille() == 0, "clear");
    // degenerate sizes
    ds.BloomFilter tiny(0, 0);
    tiny.add(1);
    check(tiny.mightContain(1) && tiny.bitCount() >= 64 && tiny.hashCount() >= 1, "expected 0 and oneIn 0 are made valid");
    a.dispose(); b.dispose(); c.dispose(); t.dispose(); by.dispose(); m1.dispose(); m2.dispose(); other.dispose(); smaller.dispose(); s1.dispose(); s2.dispose(); tiny.dispose();
    check(a.bitCount() == 0 && !a.mightContain(1) && a.fillPermille() == 0, "a disposed filter says no");
    a.add(5);
    check(a.count() == 0, "adding to a disposed filter does nothing");
}

void countMin() {
    ds.CountMinSketch s(272, 5);
    // a skewed stream: key k appears about 1000 / (k + 1) times
    int truth[500];
    for (int i = 0; i < 500; i++) { truth[i] = 0; }
    int total = 0;
    for (int i = 0; i < 40000; i++) {
        int k = rnd(500);
        k = k * k / 500;                           // small keys are more frequent
        s.add(k);
        truth[k]++;
        total++;
    }
    check(s.total() == total, "total");
    bool lower = true;
    int worst = 0;
    for (int k = 0; k < 500; k++) {
        int e = s.estimate(k);
        if (e < truth[k]) { lower = false; }
        if (e - truth[k] > worst) { worst = e - truth[k]; }
    }
    check(lower, "an estimate is never below the true count");
    check(worst <= total / 100 * 3, "the error stays within a few percent of the total (width 272)");
    // heavy hitters are found exactly enough
    int top = 0;
    for (int k = 0; k < 500; k++) { if (truth[k] > truth[top]) { top = k; } }
    check(s.estimate(top) >= truth[top] && s.estimate(top) <= truth[top] + total / 50, "the most frequent key");
    // conservative update is never worse
    ds.CountMinSketch c(272, 5);
    c.setConservative(true);
    seed = 1999 + 17;
    int worstC = 0;
    int truth2[500];
    for (int i = 0; i < 500; i++) { truth2[i] = 0; }
    ds.CountMinSketch plain(272, 5);
    for (int i = 0; i < 40000; i++) {
        int k = rnd(500);
        k = k * k / 500;
        c.add(k);
        plain.add(k);
        truth2[k]++;
    }
    int sumC = 0;
    int sumP = 0;
    bool noUnder = true;
    for (int k = 0; k < 500; k++) {
        sumC = sumC + c.estimate(k) - truth2[k];
        sumP = sumP + plain.estimate(k) - truth2[k];
        if (c.estimate(k) < truth2[k]) { noUnder = false; }
    }
    check(noUnder && sumC <= sumP, "conservative updates give estimates that are no larger");
    // text and bytes, amounts
    ds.CountMinSketch w(1000, 4, 3);
    w.addText("apple", 5); w.addText("apple"); w.addText("pear", 2); w.addBytes("x\0y", 3, 4);
    check(w.estimateText("apple") == 6 && w.estimateText("pear") == 2 && w.estimateBytes("x\0y", 3) == 4 && w.estimateText("none") == 0 && w.total() == 12, "text and byte keys, amounts");
    w.add(1, 0); w.add(1, -5);
    check(w.total() == 12 && w.estimate(1) == 0, "amounts of 0 or less are ignored");
    // merge
    ds.CountMinSketch w2(1000, 4, 3);
    w2.addText("apple", 10);
    check(w.merge(&w2) && w.estimateText("apple") == 16 && w.total() == 22, "merge");
    ds.CountMinSketch w3(1000, 4, 4);
    ds.CountMinSketch w4(999, 4, 3);
    check(!w.merge(&w3) && !w.merge(&w4), "sketches of another seed or size cannot be merged");
    w.clear();
    check(w.total() == 0 && w.estimateText("apple") == 0, "clear");
    // invalid sizes
    ds.CountMinSketch bad(0, 5);
    bad.add(1);
    check(bad.estimate(1) == 0 && bad.total() == 0, "width 0 is an empty sketch that ignores everything");
    s.dispose(); c.dispose(); plain.dispose(); w.dispose(); w2.dispose(); w3.dispose(); w4.dispose(); bad.dispose();
    check(s.total() == 0 && s.estimate(1) == 0, "disposed");
}

void memory() {
    int b0 = asys.memBlocks();
    int m0 = asys.memInUse();
    ds.BloomFilter b(100000, 100);
    ds.CountMinSketch c(10000, 8);
    for (int i = 0; i < 1000; i++) { b.add(i); c.add(i); }
    b.dispose(); c.dispose();
    check(asys.memBlocks() == b0 && asys.memInUse() == m0, "dispose frees everything");
}

int main() {
    bloom();
    countMin();
    memory();
    printf("sketches: %d checks, %d failures\n", checks, fails);
    return fails;
}
