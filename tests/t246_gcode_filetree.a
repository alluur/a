// gcode.FileTree: the project explorer on a temporary directory: ignore rules, lazy folders, icons, keyboard and mouse, open callback,
// filter, new file / new folder / rename / delete with confirmation, errors, refresh by polling, the context menu
import wsrv;
import gui;
import guix;
import gcode;
import aproject;
import asys;
import adp;
import gfx;
#include "gcode_harness.inc"

gcode.FileTree* tree;
gui.Window* w;
int opened = 0;
int errors = 0;
int changes = 0;
int selections = 0;

int onOpen(int t) { opened++; return 0; }
int onError(int t) { errors++; return 0; }
int onChanged(int t) { changes++; return 0; }
int onSelect(int t) { selections++; return 0; }

void put(char* path, char* text) {
    asys.writeFile(path, text, strlen(text));
}

void rows(char* label) {
    printf("%s:", label);
    for (int i = 0; i < tree->visibleCount(); i++) {
        printf(" %s%s%s", tree->isDirAt(i) ? (tree->isExpandedAt(i) ? "-" : "+") : "", tree->nameAt(i), (i == tree->selected) ? "*" : "");
    }
    if (tree->visibleCount() == 0) { printf(" (empty)"); }
    printf("\n");
}

// the centre of a row in widget coordinates
int rowY(int i) { return tree->headerH + (i - tree->top) * tree->rowH + tree->rowH / 2; }

int main() {
    rmtree("build/tests/t246_project");
    startServer(7346, "t246");
    w = d->createWindow("Files", 300, 300, 0);
    tree = new gcode.FileTree();
    tree->onOpen = onOpen;
    tree->onError = onError;
    tree->onTreeChanged = onChanged;
    tree->onSelect = onSelect;
    tree->dblMs = 100000;
    gui.Box* col = gui.vbox(0, 0);
    col->add(tree);
    w->setRoot(col);
    w->setFocus(tree);
    settle();
    rows("before a folder is set");
    printf("a folder that does not exist is refused: %d\n", !tree->setRoot("build/tests/t246_no_such_dir"));

    // a small project
    char* root = "build/tests/t246_project";
    asys.mkdirs("build/tests/t246_project/src/deep");
    asys.mkdirs("build/tests/t246_project/docs");
    asys.mkdirs("build/tests/t246_project/empty");
    asys.mkdirs("build/tests/t246_project/build");
    put("build/tests/t246_project/.gitignore", "*.log\nbuild/\n");
    put("build/tests/t246_project/README.md", "# project\n");
    put("build/tests/t246_project/Makefile", "all:\n");
    put("build/tests/t246_project/notes.log", "ignored\n");
    put("build/tests/t246_project/src/main.a", "int main() { return 0; }\n");
    put("build/tests/t246_project/src/util.a", "int util() { return 1; }\n");
    put("build/tests/t246_project/src/deep/x.txt", "x\n");
    put("build/tests/t246_project/docs/guide.md", "guide\n");
    put("build/tests/t246_project/build/out.bin", "ignored\n");
    printf("set root: %d\n", tree->setRoot(root));
    settle();
    rows("the top level (folders first, ignored names left out)");
    printf("icon kinds: dir %d, .a %d, .md %d, Makefile %d, .txt %d, .png %d\n", gcode.iconKindOf("src", asys.K_DIR, false), gcode.iconKindOf("main.a", asys.K_FILE, false), gcode.iconKindOf("README.md", asys.K_FILE, false), gcode.iconKindOf("Makefile", asys.K_FILE, false), gcode.iconKindOf("x.txt", asys.K_FILE, false), gcode.iconKindOf("pic.PNG", asys.K_FILE, false));

    // opening folders: the arrow, Right and Left, Enter on a folder
    int srcRow = tree->indexOfPath("src");
    clickWd(w, tree, 6 + 5, rowY(srcRow));
    rows("click on the arrow of src");
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_DOWN, 0);
    key(adp.KEY_RIGHT, 0);
    rows("Down, Down, Right (deep opens)");
    key(adp.KEY_RIGHT, 0);
    printf("Right on an open folder goes to its first child: selected %s\n", tree->nameAt(tree->selected));
    key(adp.KEY_LEFT, 0);
    printf("Left on a file goes to its folder: selected %s\n", tree->nameAt(tree->selected));
    key(adp.KEY_LEFT, 0);
    rows("Left on an open folder closes it");
    key(adp.KEY_HOME, 0);
    printf("Home: %s, End: ", tree->nameAt(tree->selected));
    key(adp.KEY_END, 0);
    printf("%s\n", tree->nameAt(tree->selected));
    key('m', 'm');
    printf("type ahead 'm': %s\n", tree->nameAt(tree->selected));
    key('r', 'r');
    printf("type ahead 'r': %s\n", tree->nameAt(tree->selected));

    // opening files: Enter and a double click; the callback gets the path
    key(adp.KEY_ENTER, 13);
    printf("Enter on README.md: opened %d, path %s\n", opened, tree->openedPath);
    tree->revealRel("src/util.a");
    settle();
    int ur = tree->selected;
    hb->click(screenX(w, tree, 60), screenY(w, tree, rowY(ur)));
    hb->click(screenX(w, tree, 60), screenY(w, tree, rowY(ur)));
    settle();
    printf("double click on util.a: opened %d, path %s\n", opened, tree->openedPath);
    int dr = tree->indexOfPath("docs");
    hb->click(screenX(w, tree, 60), screenY(w, tree, rowY(dr)));
    hb->click(screenX(w, tree, 60), screenY(w, tree, rowY(dr)));
    settle();
    rows("double click on docs opens it");
    printf("a folder is not 'opened': %d\n", opened);
    clickWd(w, tree, 6 + 5, rowY(tree->indexOfPath("docs")));

    // the filter box
    tree->filterBox->focusMe();
    typeStr("UTIL");
    rows("filter UTIL");
    tree->filterBox->setText("x.txt");
    tree->rebuildRows();
    rows("filter x.txt (src/deep was never opened: it is searched)");
    tree->filterBox->setText("");
    tree->rebuildRows();
    tree->focusMe();
    rows("filter cleared");

    // new file and new folder in the selected folder
    tree->select(tree->indexOfPath("src"));
    tree->startNew(false);
    settle();
    printf("name field is shown: %d, rows %d\n", tree->editBox->visible, tree->visibleCount());
    typeStr("fresh.a");
    key(adp.KEY_ENTER, 13);
    printf("fresh.a on disk: %d, selected %s, changes %d\n", asys.isFile("build/tests/t246_project/src/fresh.a"), tree->nameAt(tree->selected), changes);
    tree->select(tree->indexOfPath("src"));
    tree->startNew(true);
    settle();
    typeStr("inner");
    key(adp.KEY_ENTER, 13);
    printf("inner folder on disk: %d, selected %s\n", asys.isDir("build/tests/t246_project/src/inner"), tree->nameAt(tree->selected));
    rows("after creating");
    // wrong names
    tree->select(tree->indexOfPath("src"));
    tree->startNew(false);
    typeStr("a/b");
    key(adp.KEY_ENTER, 13);
    printf("a slash in the name: errors %d (%s)\n", errors, tree->errorText);
    tree->select(tree->indexOfPath("src"));
    tree->startNew(false);
    typeStr("main.a");
    key(adp.KEY_ENTER, 13);
    printf("a name that exists: errors %d (%s)\n", errors, tree->errorText);
    tree->select(tree->indexOfPath("src"));
    tree->startNew(false);
    typeStr("never");
    key(adp.KEY_ESCAPE, 27);
    printf("Esc cancels: never.a exists %d, name field hidden %d, mode %d\n", asys.exists("build/tests/t246_project/src/never"), !tree->editBox->visible, tree->editMode);

    // rename
    tree->select(tree->indexOfPath("src/fresh.a"));
    key(adp.KEY_F1 + 1, 0);
    printf("F2: name field shows %s\n", tree->editBox->text());
    keyMods('a', 0, adp.MOD_CTRL);
    typeStr("renamed.a");
    key(adp.KEY_ENTER, 13);
    printf("renamed: old %d, new %d, selected %s\n", asys.exists("build/tests/t246_project/src/fresh.a"), asys.exists("build/tests/t246_project/src/renamed.a"), tree->selectedRel());
    tree->select(tree->indexOfPath("src/renamed.a"));
    key(adp.KEY_F1 + 1, 0);
    keyMods('a', 0, adp.MOD_CTRL);
    typeStr("util.a");
    key(adp.KEY_ENTER, 13);
    printf("rename to an existing name: errors %d (%s), renamed.a still there %d\n", errors, tree->errorText, asys.exists("build/tests/t246_project/src/renamed.a"));

    // delete: the question comes first; No keeps the file, Yes deletes it
    int windows0 = srv->windowCount();
    tree->select(tree->indexOfPath("src/renamed.a"));
    key(adp.KEY_DELETE, 127);
    printf("delete asks: windows +%d\n", srv->windowCount() - windows0);
    key(adp.KEY_TAB, 9);
    key(adp.KEY_ENTER, 13);
    printf("No: file still there %d, deleted %d\n", asys.exists("build/tests/t246_project/src/renamed.a"), tree->deleted);
    key(adp.KEY_DELETE, 127);
    key(adp.KEY_ENTER, 13);
    printf("Yes: file there %d, deleted %d, dialog closed %d\n", asys.exists("build/tests/t246_project/src/renamed.a"), tree->deleted, srv->windowCount() == windows0);
    tree->select(tree->indexOfPath("src"));
    key(adp.KEY_DELETE, 127);
    key(adp.KEY_ENTER, 13);
    printf("a folder that is not empty stays: exists %d, errors %d (%s)\n", asys.isDir("build/tests/t246_project/src"), errors, tree->errorText);
    tree->select(tree->indexOfPath("src/inner"));
    tree->confirmDelete = false;
    key(adp.KEY_DELETE, 127);
    printf("an empty folder without a question: exists %d\n", asys.isDir("build/tests/t246_project/src/inner"));
    tree->confirmDelete = true;

    // changes on disk are found by polling
    rows("before");
    put("build/tests/t246_project/src/outside.a", "x\n");
    printf("poll finds a new file: %d\n", tree->pollNow());
    printf("outside.a listed: %d\n", tree->indexOfPath("src/outside.a") >= 0);
    tree->select(tree->indexOfPath("src/main.a"));
    asys.unlink("build/tests/t246_project/src/outside.a");
    printf("poll finds the deleted file: %d, outside.a listed: %d, selection kept: %s\n", tree->pollNow(), tree->indexOfPath("src/outside.a") >= 0, tree->selectedRel());
    printf("nothing changed: %d\n", tree->pollNow());

    // reveal a path inside folders that are closed
    tree->collapseAll();
    rows("collapse all");
    printf("reveal: %d\n", tree->revealRel("src/deep/x.txt"));
    rows("after reveal");

    // the context menu
    int mr = tree->indexOfPath("docs");
    rightClickWd(w, tree, 60, rowY(mr));
    printf("context menu open: %d, docs selected: %d\n", w->popup != null, tree->nameAt(tree->selected)[0] == 'd');
    key(adp.KEY_ESCAPE, 27);
    printf("closed: %d\n", w->popup == null);

    // many files: the scroll bar and PageDown
    rmtree("build/tests/t246_project/many");
    asys.mkdirs("build/tests/t246_project/many");
    for (int i = 0; i < 40; i++) {
        char p[100];
        format(&p[0], 100, "build/tests/t246_project/many/f%02d.txt", i);
        put(&p[0], "x");
    }
    tree->refreshAll();
    tree->revealRel("many/f39.txt");
    settle();
    printf("scrolled to the last file: top %d, selected %s, rows shown %d\n", tree->top, tree->nameAt(tree->selected), tree->visibleRows());
    wheelWd(w, tree, 100, 100, 3);
    printf("wheel up: top %d\n", tree->top);
    key(adp.KEY_PGUP, 0);
    printf("PageUp: selected %s\n", tree->nameAt(tree->selected));
    key(adp.KEY_HOME, 0);
    printf("Home: top %d selected %s\n", tree->top, tree->nameAt(tree->selected));

    // pictures in two themes
    tree->collapseAll();
    tree->revealRel("src/main.a");
    settle();
    gcode.theLook()->setThemeName("dark");
    settle();
    printf("dark screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("light");
    settle();
    printf("light screenshot %u\n", shot(w));
    gcode.theLook()->setThemeName("dark");
    return 0;
}
