// rng: normal, exponential, gamma, beta, chi-squared, Poisson, binomial, geometric. The printed numbers are compared with NumPy's Generator in the same
// PCG64 state: the expected output was generated by NumPy (the algorithms are the same, so are the numbers).
import cstdio;
import cstring;
import asys;
import dmath;
import rng;

int fails = 0;
int checks = 0;
void check(bool cond, char* what) {
    checks++;
    if (!cond) { printf("FAIL: %s\n", what); fails++; }
}

void showD(double v) {
    printf(" %s", doubleToFixed(v, 9));
}

// prints the first 6 samples, then the sum (6 decimals), minimum and maximum over n samples
void summaryD(char* label, rng.Rng* g, int kind, double p1, double p2, int n) {
    double sum = 0.0;
    double mn = 1.0e300;
    double mx = -1.0e300;
    printf("%s:", label);
    for (int i = 0; i < n; i++) {
        double v = 0.0;
        if (kind == 0) { v = g->normal(); }
        else if (kind == 1) { v = g->exponential(); }
        else if (kind == 2) { v = g->gamma(p1); }
        else if (kind == 3) { v = g->beta(p1, p2); }
        else if (kind == 4) { v = g->chiSquared(p1); }
        else if (kind == 5) { v = g->normalAt(p1, p2); }
        else if (kind == 6) { v = g->lognormal(p1, p2); }
        else if (kind == 7) { v = g->uniform(p1, p2); }
        else if (kind == 8) { v = g->nextDouble(); }
        if (i < 6) { showD(v); }
        sum = sum + v;
        if (v < mn) { mn = v; }
        if (v > mx) { mx = v; }
    }
    printf(" | sum %s min %s max %s\n", doubleToFixed(sum, 5), doubleToFixed(mn, 9), doubleToFixed(mx, 9));
}

// integer valued: the first 12 values, the sum and the maximum over n samples
void summaryI(char* label, rng.Rng* g, int kind, double p1, int p2, int n) {
    int sum = 0;
    int mx = -1;
    printf("%s:", label);
    for (int i = 0; i < n; i++) {
        int v = 0;
        if (kind == 0) { v = g->poisson(p1); }
        else if (kind == 1) { v = g->binomial(p2, p1); }
        else if (kind == 2) { v = g->geometric(p1); }
        if (i < 12) { printf(" %d", v); }
        sum = sum + v;
        if (v > mx) { mx = v; }
    }
    printf(" | sum %d max %d\n", sum, mx);
}

void numpyComparison() {
    rng.Pcg64 g(42, 54);
    summaryD("normal", &g, 0, 0.0, 0.0, 40000);
    rng.Pcg64 e(42, 54);
    summaryD("exponential", &e, 1, 0.0, 0.0, 40000);
    rng.Pcg64 h(42, 54);
    summaryD("gamma 0.5", &h, 2, 0.5, 0.0, 250);
    rng.Pcg64 h1(42, 54);
    summaryD("gamma 1", &h1, 2, 1.0, 0.0, 300);
    rng.Pcg64 h2(42, 54);
    summaryD("gamma 2.5", &h2, 2, 2.5, 0.0, 3000);
    rng.Pcg64 h3(42, 54);
    summaryD("gamma 30", &h3, 2, 30.0, 0.0, 2500);
    rng.Pcg64 b1(42, 54);
    summaryD("beta 0.5 0.5", &b1, 3, 0.5, 0.5, 200);
    rng.Pcg64 b2(42, 54);
    summaryD("beta 2 5", &b2, 3, 2.0, 5.0, 1500);
    rng.Pcg64 b3(42, 54);
    summaryD("beta 0.7 3", &b3, 3, 0.7, 3.0, 250);
    rng.Pcg64 c(42, 54);
    summaryD("chisquare 5", &c, 4, 5.0, 0.0, 1500);
    rng.Pcg64 n1(42, 54);
    summaryD("normal 100 15", &n1, 5, 100.0, 15.0, 5000);
    rng.Pcg64 n2(42, 54);
    summaryD("lognormal 0 0.5", &n2, 6, 0.0, 0.5, 500);
    rng.Pcg64 u1(42, 54);
    summaryD("uniform -2 5", &u1, 7, -2.0, 5.0, 5000);
    rng.Pcg64 u2(42, 54);
    summaryD("random", &u2, 8, 0.0, 0.0, 5000);

    rng.Pcg64 p0(42, 54);
    summaryI("poisson 0.5", &p0, 0, 0.5, 0, 10000);
    rng.Pcg64 p1(42, 54);
    summaryI("poisson 4", &p1, 0, 4.0, 0, 10000);
    rng.Pcg64 p2(42, 54);
    summaryI("poisson 9.99", &p2, 0, 9.99, 0, 8000);
    rng.Pcg64 p3(42, 54);
    summaryI("poisson 10", &p3, 0, 10.0, 0, 1000);
    rng.Pcg64 p4(42, 54);
    summaryI("poisson 25.5", &p4, 0, 25.5, 0, 1000);
    rng.Pcg64 p5(42, 54);
    summaryI("poisson 1000", &p5, 0, 1000.0, 0, 1000);
    rng.Pcg64 p6(42, 54);
    summaryI("poisson 0", &p6, 0, 0.0, 0, 10);
    rng.Pcg64 p7(42, 54);
    summaryI("poisson 1e6", &p7, 0, 1000000.0, 0, 500);

    rng.Pcg64 q1(42, 54);
    summaryI("binomial 10 0.3", &q1, 1, 0.3, 10, 10000);
    rng.Pcg64 q2(42, 54);
    summaryI("binomial 100 0.1", &q2, 1, 0.1, 100, 5000);
    rng.Pcg64 q3(42, 54);
    summaryI("binomial 60 0.5", &q3, 1, 0.5, 60, 3000);
    rng.Pcg64 q4(42, 54);
    summaryI("binomial 50 0.9", &q4, 1, 0.9, 50, 8000);
    rng.Pcg64 q5(42, 54);
    summaryI("binomial 1 0.5", &q5, 1, 0.5, 1, 10000);
    rng.Pcg64 q6(42, 54);
    summaryI("binomial 1000 0.02", &q6, 1, 0.02, 1000, 3000);

    rng.Pcg64 r1(42, 54);
    summaryI("geometric 0.5", &r1, 2, 0.5, 0, 10000);
    rng.Pcg64 r2(42, 54);
    summaryI("geometric 0.9", &r2, 2, 0.9, 0, 10000);
    rng.Pcg64 r3(42, 54);
    summaryI("geometric 0.2", &r3, 2, 0.2, 0, 5000);
    rng.Pcg64 r4(42, 54);
    summaryI("geometric 0.01", &r4, 2, 0.01, 0, 1000);
    rng.Pcg64 r5(42, 54);
    summaryI("geometric 1e-6", &r5, 2, 0.000001, 0, 1000);
}

int main() {
    numpyComparison();
    check(asys.memBadFrees() == 0, "no bad free");
    printf(fails == 0 ? "OK\n" : "FAILED\n");
    return fails;
}
