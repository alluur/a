// var: the type of a local variable is taken from its initializer
class Point {
public:
    int x;
    int y;
    Point(int a, int b) { x = a; y = b; }
    int sum() { return x + y; }
}

struct Pair { int a; int b; }

Pair makePair(int a, int b) {
    Pair p;
    p.a = a;
    p.b = b;
    return p;
}

int twice(int a) { return a * 2; }
double half(int a) { return a * 0.5; }
char* name() { return "name"; }
bool even(int a) { return a % 2 == 0; }
uint8 byteOf(int a) { return a; }
int32 wide(int a) { return a * 1000000; }

int counter = 0;
int bump() { counter++; return counter; }

int main() {
    var a = 5;
    var b = 2.5;
    var s = "hello";
    var c = 'x';
    var t = true;
    var p = &a;
    var f = twice;
    var q = twice(a) + 1;
    var big = 1 << 40;
    var neg = -7;
    printf("%d %d %s %d %d %d\n", a, (int)(b * 2.0), s, c, t, *p);
    printf("%d %d %d\n", q, big, neg);
    printf("%d\n", f(21));

    // the type really is the type of the initializer: double arithmetic, pointer arithmetic, char arithmetic
    var d = half(5);
    d = d + 1;
    printf("%d\n", (int)(d * 10.0));
    var s2 = name();
    printf("%c%c\n", s2[0], s2[1]);
    var u = byteOf(300);
    u = u + 250;                        // uint8 wraps
    printf("%d\n", u);
    var w = wide(5000);                 // int32 wraps at 32 bits: 5000 * 1000000 = 5e9 -> 705032704
    printf("%d\n", w);
    var e = even(4);
    printf("%d\n", e);

    // structs and classes are copied
    var pair = makePair(3, 4);
    var pair2 = pair;
    pair2.a = 30;
    printf("%d %d %d\n", pair.a, pair2.a, pair2.b);
    Point pt(1, 2);
    var pt2 = pt;
    pt2.x = 10;
    printf("%d %d %d\n", pt.sum(), pt2.sum(), pt2.y);
    var pp = new Point(5, 6);
    printf("%d\n", pp->sum());

    // several declarators, each with its own type
    var i1 = 1, s1 = "two", d1 = 3.5;
    printf("%d %s %d\n", i1, s1, (int)(d1 * 2.0));

    // arrays decay to pointers
    int arr[4] = {10, 20, 30, 40};
    var ap = arr;
    ap++;
    printf("%d\n", *ap);

    // the initializer is evaluated before the name exists: an outer variable of the same name can be used
    {
        var a = a + 1;
        printf("%d\n", a);
    }
    printf("%d\n", a);

    // evaluated exactly once
    var n = bump() + bump();
    printf("%d %d\n", n, counter);

    // in for and foreach
    for (var i = 0; i < 3; i++) { printf("i=%d ", i); }
    printf("\n");
    foreach (var v in arr) { printf("%d ", v); }
    printf("\n");
    foreach (var ch in "abc") { printf("%c", ch); }
    printf("\n");
    foreach (var k in 1..4) { printf("%d ", k); }
    printf("\n");
    foreach (var idx, var el in arr) { printf("%d:%d ", idx, el); }
    printf("\n");

    // var is not a keyword: it can still be a name
    var var = 7;
    printf("%d\n", var);
    int var2 = var + 1;
    printf("%d\n", var2);
    return 0;
}
