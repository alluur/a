struct Point { int x; int y; }
struct Rec { char* name; int vals[3]; double w; }
int primes[6] = {2, 3, 5, 7, 11};
Point origin = {3, 4};
char greeting[16] = "hi there";
char* words[3] = {"alpha", "beta", "gamma"};
Rec recs[2] = {{"one", {1, 2, 3}, 1.5}, {"two", {4, 5}, 2.25}};
double ds[3] = {0.5, 1, -2.5};
int main() {
    static int sq[4] = {1, 4, 9, 16};
    int t = 0;
    for (int i = 0; i < 6; i++) t += primes[i];
    printlnInt(t);
    printlnInt(origin.x * 10 + origin.y);
    println(greeting);
    println(words[1]);
    println(recs[1].name);
    printlnInt(recs[1].vals[1] + recs[0].vals[2]);
    printlnDouble(recs[1].w + ds[0] + ds[2]);
    printlnInt(sq[3] + sq[1]);
    return 0;
}
