// switch on text: strcmp semantics, several labels per case, fall-through, default anywhere, null, constants as labels, nesting,
// evaluation of the switch value once, small switches (compare chain) and bigger ones (hash search)
const KEY = "alpha";
const SEP = "-";
int evals;

char* source(char* s) { evals++; return s; }

int cmd(char* s) {
    switch (s) {
        case "get": return 1;
        case "put", "post": return 2;
        case "delete": return 3;
        case KEY: return 4;
        default: return -1;
    }
}

int ten(char* s) {
    switch (s) {
        case "a": return 1;
        case "bb": return 2;
        case "ccc": return 3;
        case "dddd": return 4;
        case "eeeee": return 5;
        case "f": return 6;
        case "g": return 7;
        case "hh": return 8;
        case "ii": return 9;
        case "jj": return 10;
        default: return 0;
    }
}

int fall(char* s) {
    int r = 0;
    switch (s) {
        case "x": r += 1;
        case "y": r += 10;
        case "z": r += 100; break;
        case "w": r += 1000;
    }
    return r;
}

// default in the middle: labels after it are still found, and execution falls through it
int mid(char* s) {
    int r = 0;
    switch (s) {
        case "one": r += 1; break;
        default: r += 50;
        case "two": r += 2; break;
        case "three": r += 3; break;
    }
    return r;
}

// the escapes of a label are the bytes that are compared; a value that is longer or shorter than a label does not match
int esc(char* s) {
    switch (s) {
        case "a\tb": return 1;
        case "line\n": return 2;
        case "q\"uote": return 3;
        case "caf\xc3\xa9": return 4;
        case "": return 5;
        default: return 0;
    }
}

int outer(char* a, char* b) {
    switch (a) {
        case "left":
            switch (b) {
                case "up": return 11;
                case "down": return 12;
                default: return 10;
            }
        case "right":
            switch (b) {
                case "up": return 21;
                default: break;
            }
            return 20;
    }
    return 0;
}

int main() {
    printlnInt(cmd("get")); printlnInt(cmd("put")); printlnInt(cmd("post")); printlnInt(cmd("delete")); printlnInt(cmd("alpha"));
    printlnInt(cmd("gets")); printlnInt(cmd("ge")); printlnInt(cmd("")); printlnInt(cmd(null)); printlnInt(cmd("GET"));
    foreach (char* s in (char*[]){"a", "bb", "ccc", "dddd", "eeeee", "f", "g", "hh", "ii", "jj", "kk", "", "A", "aa", "j"}) {
        printInt(ten(s)); print(" ");
    }
    println("");
    printlnInt(ten(null));
    printlnInt(fall("x")); printlnInt(fall("y")); printlnInt(fall("z")); printlnInt(fall("w")); printlnInt(fall("q")); printlnInt(fall(null));
    printlnInt(mid("one")); printlnInt(mid("two")); printlnInt(mid("three")); printlnInt(mid("none")); printlnInt(mid(null));
    printlnInt(esc("a\tb")); printlnInt(esc("line\n")); printlnInt(esc("q\"uote")); printlnInt(esc("caf\xc3\xa9")); printlnInt(esc(""));
    printlnInt(esc("line")); printlnInt(esc("a b")); printlnInt(esc(null));
    printlnInt(outer("left", "up")); printlnInt(outer("left", "down")); printlnInt(outer("left", "x")); printlnInt(outer("right", "up"));
    printlnInt(outer("right", "down")); printlnInt(outer("middle", "up")); printlnInt(outer(null, null));

    // the value is evaluated once, also when the switch is big
    switch (source("delete")) { case "get": print("no"); break; case "delete": println("deleted"); break; default: print("no"); }
    switch (source("jj")) { case "a": case "bb": case "ccc": case "dddd": case "eeeee": case "f": break; case "jj": println("jj"); break; }
    printlnInt(evals);

    // loops: break leaves the switch, continue the loop
    char* items[5] = {"skip", "stop", "go", "go", "x"};
    int count = 0;
    foreach (char* it in items) {
        switch (it) {
            case "skip": continue;
            case "stop": break;
            case "go": count += 10; break;
            default: count += 1;
        }
        count += 100;
    }
    printlnInt(count);
    // a switch on text that is built at run time
    char buf[8];
    buf[0] = 'g'; buf[1] = 'e'; buf[2] = 't'; buf[3] = 0;
    printlnInt(cmd(buf));
    buf[3] = 's'; buf[4] = 0;
    printlnInt(cmd(buf));
    // empty and default-only switches
    switch ("x") { }
    switch ("x") { default: println("default only"); }
    char* nothing = null;
    switch (nothing) { case "a": println("never"); break; default: println("null goes to default"); }
    return 0;
}
