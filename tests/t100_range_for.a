int fact(int n) { int r = 1; for (i in 1..=n) r *= i; return r; }
int main() {
    int s = 0;
    for (i in 0..5) s += i;
    printlnInt(s);
    printlnInt(fact(6));
    for (i in 3..3) println("never");
    for (i in 0..10) {
        if (i == 2) continue;
        if (i == 5) break;
        printInt(i);
    }
    println("");
    int n = 3;
    for (i in 0..n) for (j in 0..n) printInt(i * 10 + j);
    println("");
    for (i in 5..2) println("never");
    int k = 7;
    for (k = 0; k < 2; k++) printInt(k);
    println("");
    return 0;
}
