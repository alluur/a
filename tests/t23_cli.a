int main(int argc, char** argv) {
    // formatted output
    char buf[128];
    int n = format(&buf[0], 128, "[%5d|%-5d|%05d|%x]%%", 42, -7, 42, 255);
    println(buf);
    n = format(&buf[0], 128, "%s is %d", (int)"Ann", 31, 0, 0);
    println(buf);
    printlnInt(n);
    printf("%-8s|%8s|\n", (int)"left", (int)"right", 0, 0);
    printRepeat('=', 10); println("");
    // parsing and prompts from stdin
    int v;
    printBool(parseInt("  -123 ", &v)); printlnInt(v);
    printBool(parseInt("12x", &v)); println("");
    printBool(parseInt("", &v)); println("");
    char* name = input("name? ");
    printf("hello %s!\n", (int)name, 0, 0, 0);
    int age = askInt("age? ");            // first answer is not a number, second is
    printlnInt(age + 1);
    printBool(confirm("sure? ")); println("");
    char* rest = readAll();
    printlnInt(strlen(rest));
    printBool(input("more? ") == null); println("");
    // strings
    char t[64];
    strcpy(t, "  Hello, World  ");
    char* tr = trim(t);
    println(tr);
    printBool(endsWith(tr, "World")); printBool(contains(tr, "lo, W")); printlnInt(find(tr, "World"));
    println(substr(tr, 7, 5));
    strUpper(tr); println(tr);
    strLower(tr); println(tr);
    printBool(streqi("AbC", "aBc")); println("");
    // arguments
    printlnInt(argIndex(argc, argv, "-x"));
    println(argValue(argc, argv, "-o", "default.out"));
    // time
    int t0 = millis();
    sleepMs(30);
    int dt = millis() - t0;
    printBool(dt >= 10 && dt < 1000); println("");
    printBool(isTerminal(0)); println("");
    return 0;
}
