import gui;
import gfx;
import adp;
import asys;
import atheme;
import aproject;
import guix;
import cstdlib;
import gcode_core;
import gcode_doc;
import gcode_editor;
import gcode_bars;
module gcode;

// =============================================================================
//  PanelTabs: a tab bar over pages (only the selected page is shown)
// =============================================================================
const PANEL_TABS_H = 28;

public class PanelTabs : gui.Widget {
    public Look* look;
    public TabBar* bar;
    public func onSelect;                   // int f(int panel): the selected page changed
    private int pages;

    public PanelTabs() {
        super();
        look = theLook();
        look->use(this, null);
        flex = 1;
        bar = new TabBar();
        bar->closable = false;
        bar->onSelect = panelTabChanged;
        bar->userData = (int) this;
        add(bar);
        w = 200;
        h = 200;
    }

    public virtual int prefW() { return 240; }
    public virtual int prefH() { return 200; }

    // adds a page (any widget) with a title on its tab; returns its index
    public int addPage(char* title, gui.Widget* page) {
        bar->addTab(title, (int) page);
        add(page);
        page->visible = (pages == 0);
        pages++;
        relayout();
        return pages - 1;
    }

    public int pageCount() { return pages; }
    public int selected() { return bar->selected; }
    public gui.Widget* page(int i) { return (gui.Widget*) bar->dataOf(i); }

    public void select(int i) {
        bar->select(i);
        showSelected();
    }

    public void showSelected() {
        for (int i = 0; i < pages; i++) {
            gui.Widget* p = (gui.Widget*) bar->dataOf(i);
            p->visible = (i == bar->selected);
        }
        relayout();
        if (win != null) { win->invalidateAll(); }
    }

    public void setTitle(int i, char* t) { bar->setTitle(i, t); }

    public virtual void layout() {
        bar->x = 0;
        bar->y = 0;
        bar->w = w;
        bar->h = PANEL_TABS_H;
        for (int i = 0; i < pages; i++) {
            gui.Widget* p = (gui.Widget*) bar->dataOf(i);
            p->x = 0;
            p->y = PANEL_TABS_H;
            p->w = w;
            p->h = h - PANEL_TABS_H;
            if (p->visible) { p->layout(); }
        }
        bar->layout();
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, look->col(atheme.Col.Sidebar));
    }
}

int panelTabChanged(int b) {
    TabBar* t = (TabBar*) b;
    PanelTabs* p = (PanelTabs*) t->userData;
    p->showSelected();
    if (p->onSelect != null) { p->onSelect(p); }
    return 0;
}

// =============================================================================
//  Dock
// =============================================================================
const DOCK_GAP = 5;

public class Dock : gui.Widget {
    public Look* look;
    public gui.Widget* sidebar;
    public gui.Widget* center;
    public gui.Widget* bottom;
    public int sideW;                       // width of the sidebar
    public int bottomH;                     // height of the bottom panel
    public int minSide;
    public int minBottom;
    public int minCenter;
    public bool sideVisible;
    public bool bottomVisible;
    public func onLayout;                   // int f(int dock): a divider was dragged or a panel shown / hidden
    private int drag;                       // 0 none, 1 sidebar divider, 2 bottom divider
    private int grab;
    private int shape;

    public Dock() {
        super();
        look = theLook();
        look->use(this, null);
        flex = 1;
        sideW = 240;
        bottomH = 200;
        minSide = 120;
        minBottom = 80;
        minCenter = 160;
        sideVisible = true;
        bottomVisible = true;
        w = 800;
        h = 500;
    }

    public virtual int prefW() { return 800; }
    public virtual int prefH() { return 500; }

    public void setSidebar(gui.Widget* c) { sidebar = c; add(c); relayout(); }
    public void setCenter(gui.Widget* c) { center = c; add(c); relayout(); }
    public void setBottom(gui.Widget* c) { bottom = c; add(c); relayout(); }

    public void showSidebar(bool v) {
        sideVisible = v;
        if (sidebar != null) { sidebar->visible = v; }
        relayout();
        if (win != null) { win->invalidateAll(); }
        if (onLayout != null) { onLayout(this); }
    }

    public void showBottom(bool v) {
        bottomVisible = v;
        if (bottom != null) { bottom->visible = v; }
        relayout();
        if (win != null) { win->invalidateAll(); }
        if (onLayout != null) { onLayout(this); }
    }

    public void toggleSidebar() { showSidebar(!sideVisible); }
    public void toggleBottom() { showBottom(!bottomVisible); }

    private bool hasSide() { return sidebar != null && sideVisible; }
    private bool hasBottom() { return bottom != null && bottomVisible; }

    private void clampSizes() {
        if (hasSide()) {
            int mx = w - DOCK_GAP - minCenter;
            if (sideW > mx) { sideW = mx; }
            if (sideW < minSide) { sideW = minSide; }
        }
        if (hasBottom()) {
            int mx = h - DOCK_GAP - minBottom;
            if (bottomH > mx) { bottomH = mx; }
            if (bottomH < minBottom) { bottomH = minBottom; }
        }
    }

    // x where the centre column starts
    public int centerX() { return hasSide() ? sideW + DOCK_GAP : 0; }
    // y where the bottom panel starts
    public int bottomY() { return hasBottom() ? h - bottomH : h; }

    public virtual void layout() {
        clampSizes();
        int cx = centerX();
        if (sidebar != null && sideVisible) {
            sidebar->x = 0;
            sidebar->y = 0;
            sidebar->w = sideW;
            sidebar->h = h;
            sidebar->layout();
        }
        int by = bottomY();
        if (center != null) {
            center->x = cx;
            center->y = 0;
            center->w = w - cx;
            center->h = hasBottom() ? by - DOCK_GAP : h;
            center->layout();
        }
        if (bottom != null && bottomVisible) {
            bottom->x = cx;
            bottom->y = by;
            bottom->w = w - cx;
            bottom->h = bottomH;
            bottom->layout();
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int c = look->col(atheme.Col.Border);
        int bg = look->col(atheme.Col.Background);
        s->fill(ox, oy, w, h, bg);
        if (hasSide()) {
            s->fill(ox + sideW, oy, DOCK_GAP, h, look->col(atheme.Col.Sidebar));
            s->vline(ox + sideW + DOCK_GAP / 2, oy, h, (drag == 1) ? look->col(atheme.Col.Info) : c);
        }
        if (hasBottom()) {
            int cx = centerX();
            s->fill(ox + cx, oy + bottomY() - DOCK_GAP, w - cx, DOCK_GAP, look->col(atheme.Col.Sidebar));
            s->hline(ox + cx, oy + bottomY() - DOCK_GAP / 2 - 1, w - cx, (drag == 2) ? look->col(atheme.Col.Info) : c);
        }
    }

    private void setShape(int sh) {
        if (win != null && sh != shape) {
            shape = sh;
            win->setCursor(sh);
        }
    }

    private int part(int mx, int my) {
        if (hasSide() && mx >= sideW && mx < sideW + DOCK_GAP) { return 1; }
        if (hasBottom() && mx >= centerX() && my >= bottomY() - DOCK_GAP && my < bottomY()) { return 2; }
        return 0;
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            drag = part(mx, my);
            if (drag == 1) { grab = mx - sideW; }
            if (drag == 2) { grab = my - bottomY(); }
            invalidate();
        } else if (kind == adp.M_MOVE) {
            if (drag == 1) {
                sideW = mx - grab;
                relayout();
                invalidate();
            } else if (drag == 2) {
                bottomH = h - (my - grab);
                relayout();
                invalidate();
            } else {
                int p = part(mx, my);
                setShape(p == 1 ? adp.CURSOR_SIZE_H : (p == 2 ? adp.CURSOR_SIZE_V : adp.CURSOR_ARROW));
            }
        } else if (kind == adp.M_UP) {
            if (drag != 0) {
                drag = 0;
                invalidate();
                if (onLayout != null) { onLayout(this); }
            }
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        if (!inside && drag == 0) { setShape(adp.CURSOR_ARROW); }
    }
}

// =============================================================================
//  Commands: ids, titles, keys and functions
// =============================================================================
public class Command {
    public char* id;                        // "file.save"
    public char* title;                     // "File: Save"
    public char* keys;                      // "Ctrl+S" ("" when there are none)
    public char* defaultKeys;               // what it was registered with
    public int key;
    public int mods;
    public func fn;                         // int f(int userData)
    public int userData;
    public bool enabled;
}

public class Commands {
    public Command** items;
    public int count;
    public int runs;                        // how many commands ran through dispatch / run
    private int cap;

    public Commands() {
        cap = 32;
        items = (Command**) calloc(cap, 8);
    }

    // adds a command (keys like "ctrl+shift+p", or "" for none); a command with an id that exists is replaced
    public Command* add(char* id, char* title, char* keys, func fn, int userData) {
        Command* c = find(id);
        if (c == null) {
            if (count == cap) {
                cap = cap * 2;
                items = (Command**) realloc((char*) items, cap * 8);
            }
            c = new Command();
            items[count] = c;
            count++;
            c->id = asys.strDup(id);
        }
        asys.free(c->title);
        c->title = asys.strDup(title);
        c->fn = fn;
        c->userData = userData;
        c->enabled = true;
        c->defaultKeys = asys.strDup(keys);
        c->keys = asys.strDup("");
        c->key = 0;
        c->mods = 0;
        setKeys(id, keys);
        return c;
    }

    public Command* find(char* id) {
        for (int i = 0; i < count; i++) {
            if (streq(items[i]->id, id)) { return items[i]; }
        }
        return null;
    }

    public Command* byKeys(int key, int mods) {
        int m = mods & (adp.MOD_CTRL | adp.MOD_ALT | adp.MOD_SHIFT | adp.MOD_META);
        for (int i = 0; i < count; i++) {
            if (items[i]->key != 0 && items[i]->key == key && items[i]->mods == m) { return items[i]; }
        }
        return null;
    }

    // Gives a command other keys ("" removes them). False when the text is not a key or another command already uses it.
    public bool setKeys(char* id, char* keys) {
        Command* c = find(id);
        if (c == null) { return false; }
        if (keys[0] == 0) {
            asys.free(c->keys);
            c->keys = asys.strDup("");
            c->key = 0;
            c->mods = 0;
            return true;
        }
        int k = 0;
        int m = 0;
        if (!parseKeys(keys, &k, &m)) { return false; }
        Command* other = byKeys(k, m);
        if (other != null && other != c) { return false; }
        char t[48];
        formatKeys(k, m, &t[0]);
        asys.free(c->keys);
        c->keys = asys.strDup(&t[0]);
        c->key = k;
        c->mods = m;
        return true;
    }

    // runs the command that has these keys; true when there was one (and it is enabled)
    public bool dispatch(int key, int mods) {
        Command* c = byKeys(key, mods);
        if (c == null || !c->enabled || c->fn == null) { return false; }
        runs++;
        func f = c->fn;
        f(c->userData);
        return true;
    }

    public bool run(char* id) {
        Command* c = find(id);
        if (c == null || !c->enabled || c->fn == null) { return false; }
        runs++;
        func f = c->fn;
        f(c->userData);
        return true;
    }

    // the key bindings the user changed: [keys] id = ctrl+shift+x (an id with an empty value would remove the keys, but the settings
    // file does not store empty values: such a binding is written as "none")
    public void applySettings(atheme.Settings* st) {
        for (int i = 0; i < count; i++) {
            char* b = st->binding(items[i]->id);
            if (b == null) { continue; }
            if (streq(b, "none")) { setKeys(items[i]->id, ""); }
            else { setKeys(items[i]->id, b); }
        }
    }

    // writes the keys that differ from the defaults into the settings (and nothing for the others)
    public void storeSettings(atheme.Settings* st) {
        for (int i = 0; i < count; i++) {
            Command* c = items[i];
            char def[48];
            def[0] = 0;
            int k = 0;
            int m = 0;
            if (parseKeys(c->defaultKeys, &k, &m)) { formatKeys(k, m, &def[0]); }
            if (!streq(c->keys, &def[0])) {
                st->setBinding(c->id, (c->keys[0] == 0) ? "none" : c->keys);
            }
        }
    }

    // makes the window give its key presses to this registry first (after the menu bar has been put in the window)
    public void install(gui.Window* w) {
        ShortcutHost* h = new ShortcutHost();
        h->cmds = this;
        if (w->keyPreview != null) { h->next = w->keyPreview; }
        w->keyPreview = h;
    }
}

public class ShortcutHost : gui.Widget {
    public Commands* cmds;
    public gui.Widget* next;                // the key preview widget that was there before (a menu bar)

    public ShortcutHost() {
        super();
        visible = false;
    }

    public virtual bool onShortcut(int key, int uni, int mods) {
        if (cmds->dispatch(key, mods)) { return true; }
        if (next != null && next->enabled) { return next->onShortcut(key, uni, mods); }
        return false;
    }
}

// =============================================================================
//  Palette: an overlay with a text field and a list; commands, files, symbols
// =============================================================================
public const PAL_ROWS = 10;
const PAL_ROWH = 24;

public class Palette : gui.Widget {
    public Look* look;
    public LineEdit* box;
    public func onChoose;                   // int f(int palette): chosenIndex (the order items were added in) and chosenData
    public func onQuery;                    // int f(int palette): the text changed; refill the items (for lists that are searched elsewhere)
    public int chosenIndex;
    public int chosenData;
    public bool filtering;                  // the palette filters the items by the text itself (true; false: onQuery decides)
    public int selected;
    public int top;
    public bool open;
    private char** labels;
    private char** details;
    private int* data;
    private int count;
    private int cap;
    private int* shown;                     // indexes of the items that match, best first
    private int nshown;
    private aproject.QuickOpen* scorer;
    private aproject.QuickOpen* quick;      // when set: the file index to search (showFiles)
    private Commands* cmds;
    private gui.Window* host;
    private gui.Widget* prevFocus;
    private int px;
    private int py;
    private int pw;

    public Palette() {
        super();
        look = theLook();
        look->use(this, null);
        filtering = true;
        cap = 64;
        labels = (char**) calloc(cap, 8);
        details = (char**) calloc(cap, 8);
        data = (int*) calloc(cap, 8);
        shown = (int*) calloc(cap, 8);
        scorer = new aproject.QuickOpen();
        box = new LineEdit();
        box->onChange = paletteChanged;
        box->onEnter = paletteEnter;
        box->onSpecial = paletteSpecial;
        box->userData = (int) this;
        add(box);
        selected = -1;
    }

    public void clearItems() {
        for (int i = 0; i < count; i++) {
            asys.free(labels[i]);
            asys.free(details[i]);
        }
        count = 0;
        nshown = 0;
        selected = -1;
        top = 0;
    }

    public int addItem(char* label, char* detail, int userData) {
        if (count == cap) {
            cap = cap * 2;
            labels = (char**) realloc((char*) labels, cap * 8);
            details = (char**) realloc((char*) details, cap * 8);
            data = (int*) realloc((char*) data, cap * 8);
            shown = (int*) realloc((char*) shown, cap * 8);
        }
        labels[count] = asys.strDup(label);
        details[count] = asys.strDup(detail);
        data[count] = userData;
        count++;
        return count - 1;
    }

    public int itemCount() { return count; }
    public int shownCount() { return nshown; }
    public char* shownLabel(int i) { return (i >= 0 && i < nshown) ? labels[shown[i]] : ""; }
    public char* shownDetail(int i) { return (i >= 0 && i < nshown) ? details[shown[i]] : ""; }
    public char* text() { return box->text(); }

    // sets the text (as if it was typed) and filters
    public void setText(char* t) {
        box->setText(t);
        refilter();
    }

    // matches the items against the text: the best ones first
    public void refilter() {
        char* q = box->text();
        nshown = 0;
        int* score = (int*) malloc((count + 1) * 8);
        for (int i = 0; i < count; i++) {
            int sc = (q[0] == 0) ? 0 : scorer->scoreOf(q, labels[i]);
            score[i] = sc;
        }
        // the best first (a stable selection: equal scores keep the order the items were added in)
        bool* used = (bool*) malloc(count + 8);
        for (int i = 0; i < count; i++) { used[i] = false; }
        int want = (count < 200) ? count : 200;
        for (int k = 0; k < want; k++) {
            int best = -1;
            for (int i = 0; i < count; i++) {
                if (used[i] || score[i] < 0) { continue; }
                if (best < 0 || score[i] > score[best]) { best = i; }
            }
            if (best < 0) { break; }
            used[best] = true;
            shown[nshown] = best;
            nshown++;
        }
        free((char*) score);
        free((char*) used);
        selected = (nshown > 0) ? 0 : -1;
        top = 0;
        invalidate();
    }

    // the text changed: files are searched in the index, other lists are filtered here
    public void textChanged() {
        if (quick != null) {
            clearItems();
            aproject.QuickMatch m[100];
            int n = quick->query(box->text(), &m[0], 100);
            for (int i = 0; i < n; i++) { addItem(m[i].path, "", i); }
            nshown = n;
            for (int i = 0; i < n; i++) { shown[i] = i; }
            selected = (n > 0) ? 0 : -1;
            top = 0;
            invalidate();
            return;
        }
        if (onQuery != null) {
            onQuery(this);
        }
        if (filtering) { refilter(); }
    }

    // shows the palette as a popup of the window with the items you added; placeholder is the hint in the empty field
    public void show(gui.Window* w, char* placeholder) {
        quick = null;
        cmds = null;
        openPopup(w, placeholder);
    }

    private void openPopup(gui.Window* w, char* placeholder) {
        host = w;
        prevFocus = w->focusWidget;
        box->placeholder = placeholder;
        box->setText("");
        open = true;
        w->showPopup(this);
        w->setFocus(box);
        if (quick == null) { refilter(); }
        textChanged();
    }

    public void hide() {
        if (host != null && open) { host->closePopup(); }
    }

    // all the commands of a registry; choosing one runs it
    public void showCommands(gui.Window* w, Commands* c) {
        cmds = c;
        quick = null;
        clearItems();
        for (int i = 0; i < c->count; i++) {
            addItem(c->items[i]->title, c->items[i]->keys, i);
        }
        onChoose = paletteRunCommand;
        onQuery = null;
        openPopup(w, "Type a command");
    }

    // the files of an index (aproject.QuickOpen.index was called); choosing one calls onChoose: chosenPath
    public void showFiles(gui.Window* w, aproject.QuickOpen* q) {
        quick = q;
        cmds = null;
        clearItems();
        openPopup(w, "Go to file");
    }

    public Commands* cmdsOf() { return cmds; }

    public char* chosenPath() { return (chosenIndex >= 0 && chosenIndex < count) ? labels[chosenIndex] : ""; }

    public void choose() {
        if (selected < 0 || selected >= nshown) { return; }
        int idx = shown[selected];
        chosenIndex = idx;
        chosenData = data[idx];
        func cb = onChoose;
        hide();
        if (cb != null) { cb(this); }
    }

    public virtual void layout() {
        pw = (w > 600) ? 560 : w - 24;
        if (pw < 120) { pw = 120; }
        px = (w - pw) / 2;
        py = 36;
        box->x = px + 6;
        box->y = py + 6;
        box->w = pw - 12;
        box->h = 28;
    }

    public virtual void onDismiss() {
        open = false;
        if (host != null && prevFocus != null) { host->setFocus(prevFocus); }
    }

    private int panelHeight() {
        int rows = (nshown < PAL_ROWS) ? nshown : PAL_ROWS;
        return 40 + ((rows > 0) ? rows * PAL_ROWH + 6 : 28);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, gfx.withAlpha(0xFF000000, 70));
        int ph = panelHeight();
        s->shadow(ox + px, oy + py, pw, ph, 8, 80);
        s->fill(ox + px, oy + py, pw, ph, look->col(atheme.Col.Menu));
        s->rect(ox + px, oy + py, pw, ph, look->col(atheme.Col.Border));
        gfx.Font* f = gfx.sans();
        int rows = (nshown < PAL_ROWS) ? nshown : PAL_ROWS;
        if (nshown == 0) {
            s->text(f, ox + px + 12, oy + py + 46, "No matches", look->col(atheme.Col.Whitespace));
        }
        for (int r = 0; r < rows; r++) {
            int i = top + r;
            if (i >= nshown) { break; }
            int y = oy + py + 40 + r * PAL_ROWH;
            if (i == selected) { s->fill(ox + px + 1, y, pw - 2, PAL_ROWH, look->col(atheme.Col.Selection)); }
            int idx = shown[i];
            char* lb = labels[idx];
            char* dt = details[idx];
            int dw = gfx.textWidth(f, dt);
            int lw = pw - 24 - ((dw > 0) ? dw + 16 : 0);
            drawMatch(s, f, ox + px + 12, y + (PAL_ROWH - f->height) / 2, lb, box->text(), look->col(atheme.Col.MenuText), look->col(atheme.Col.Info), lw);
            if (dw > 0) { s->text(f, ox + px + pw - dw - 12, y + (PAL_ROWH - f->height) / 2, dt, look->col(atheme.Col.Whitespace)); }
        }
    }

    // draws a label with the letters of the query in another colour
    private void drawMatch(gfx.Surface* s, gfx.Font* f, int x, int y, char* text, char* q, int color, int hit, int maxW) {
        int c1 = s->clipX1;
        if (x + maxW < s->clipX1) { s->clipX1 = x + maxW; }
        int qi = 0;
        int ql = strlen(q);
        char one[2];
        one[1] = 0;
        for (int i = 0; text[i] != 0; i++) {
            one[0] = text[i];
            bool match = false;
            if (qi < ql) {
                int a = text[i];
                int b = q[qi];
                if (a >= 'A' && a <= 'Z') { a = a + 32; }
                if (b >= 'A' && b <= 'Z') { b = b + 32; }
                if (a == b) { match = true; qi++; }
            }
            if ((text[i] & 0xC0) == 0x80 || text[i] >= 0xC0) {
                // a multi-byte character: draw the whole thing at once
                char mb[5];
                int n = utf8Len(text[i] & 255);
                for (int k = 0; k < n && k < 4; k++) { mb[k] = text[i + k]; }
                mb[(n < 4) ? n : 4] = 0;
                x = s->text(f, x, y, &mb[0], color);
                i = i + n - 1;
                continue;
            }
            x = s->text(f, x, y, &one[0], match ? hit : color);
            if (match) { s->text(f, x - gfx.textWidth(f, &one[0]) + 1, y, &one[0], hit); }
        }
        s->clipX1 = c1;
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_SCROLL) {
            top = top - button;
            int mxTop = nshown - PAL_ROWS;
            if (top > mxTop) { top = mxTop; }
            if (top < 0) { top = 0; }
            invalidate();
            return true;
        }
        if (kind != adp.M_DOWN) { return true; }
        int ph = panelHeight();
        if (mx < px || mx >= px + pw || my < py || my >= py + ph) {
            hide();
            return true;
        }
        int r = (my - py - 40) / PAL_ROWH;
        if (my >= py + 40 && r >= 0 && top + r < nshown && r < PAL_ROWS) {
            selected = top + r;
            choose();
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return true; }
        return box->onKey(dn, key, uni, mods);
    }

    public void move(int d) {
        if (nshown == 0) { return; }
        selected = selected + d;
        if (selected < 0) { selected = 0; }
        if (selected >= nshown) { selected = nshown - 1; }
        if (selected < top) { top = selected; }
        if (selected >= top + PAL_ROWS) { top = selected - PAL_ROWS + 1; }
        invalidate();
    }
}

int paletteChanged(int b) {
    LineEdit* e = (LineEdit*) b;
    Palette* p = (Palette*) e->userData;
    p->textChanged();
    return 0;
}

int paletteEnter(int b) {
    LineEdit* e = (LineEdit*) b;
    Palette* p = (Palette*) e->userData;
    p->choose();
    return 0;
}

int paletteSpecial(int b) {
    LineEdit* e = (LineEdit*) b;
    Palette* p = (Palette*) e->userData;
    int k = e->special;
    if (k == adp.KEY_ESCAPE) { p->hide(); return 1; }
    if (k == adp.KEY_UP) { p->move(-1); return 1; }
    if (k == adp.KEY_DOWN) { p->move(1); return 1; }
    if (k == adp.KEY_PGUP) { p->move(-PAL_ROWS); return 1; }
    if (k == adp.KEY_PGDN) { p->move(PAL_ROWS); return 1; }
    if (k == adp.KEY_TAB) { p->move(1); return 1; }
    return 0;
}

int paletteRunCommand(int palette) {
    Palette* p = (Palette*) palette;
    Commands* c = p->cmdsOf();
    if (c != null && p->chosenData >= 0 && p->chosenData < c->count) {
        Command* cm = c->items[p->chosenData];
        if (cm->enabled && cm->fn != null) {
            func f = cm->fn;
            c->runs++;
            f(cm->userData);
        }
    }
    return 0;
}
