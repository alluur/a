// =============================================================================
//  collections - growable lists and hash maps              import collections;
//
//    collections.IntList   growable array of ints (also usable as a stack)
//    collections.StrList   growable array of strings
//    collections.StrMap    hash map  string -> int
//    collections.IntMap    hash map  int -> int
//
//  Create with new:  collections.IntList* l = new collections.IntList();
//  Memory is never freed (see the language reference), so growing leaves the old
//  storage behind - reserve a sensible size for very large collections.
// =============================================================================
module collections;

public class IntList {
    private int* data;
    private int cap;
    private int len;

    private void grow() {
        int ncap = 8;
        if (cap > 0) {
            ncap = cap * 2;
        }
        int* nd = (int*) alloc(ncap * 8);
        for (int i = 0; i < len; i++) {
            nd[i] = data[i];
        }
        data = nd;
        cap = ncap;
    }

    public int size() { return len; }
    public bool isEmpty() { return len == 0; }

    public void push(int v) {
        if (len == cap) {
            grow();
        }
        data[len] = v;
        len++;
    }

    // removes and returns the last element (0 when empty)
    public int pop() {
        if (len == 0) {
            return 0;
        }
        len--;
        return data[len];
    }

    // element i, 0 when the index is out of range
    public int get(int i) {
        if (i < 0 || i >= len) {
            return 0;
        }
        return data[i];
    }

    public void set(int i, int v) {
        if (i >= 0 && i < len) {
            data[i] = v;
        }
    }

    public int last() { return get(len - 1); }

    public void clear() { len = 0; }

    public void insert(int i, int v) {
        if (i < 0 || i > len) {
            return;
        }
        if (len == cap) {
            grow();
        }
        for (int k = len; k > i; k--) {
            data[k] = data[k - 1];
        }
        data[i] = v;
        len++;
    }

    public int removeAt(int i) {
        if (i < 0 || i >= len) {
            return 0;
        }
        int v = data[i];
        for (int k = i; k < len - 1; k++) {
            data[k] = data[k + 1];
        }
        len--;
        return v;
    }

    public int indexOf(int v) {
        for (int i = 0; i < len; i++) {
            if (data[i] == v) {
                return i;
            }
        }
        return -1;
    }

    public bool has(int v) { return indexOf(v) >= 0; }

    public void reverse() {
        for (int i = 0; i < len / 2; i++) {
            int t = data[i];
            data[i] = data[len - 1 - i];
            data[len - 1 - i] = t;
        }
    }

    // pointer to the storage (valid until the next push), e.g. for sort.sortInts(list.items(), list.size())
    public int* items() { return data; }
}

public class StrList {
    private char** data;
    private int cap;
    private int len;

    private void grow() {
        int ncap = 8;
        if (cap > 0) {
            ncap = cap * 2;
        }
        char** nd = (char**) alloc(ncap * 8);
        for (int i = 0; i < len; i++) {
            nd[i] = data[i];
        }
        data = nd;
        cap = ncap;
    }

    public int size() { return len; }

    // stores the pointer (the text is not copied)
    public void push(char* s) {
        if (len == cap) {
            grow();
        }
        data[len] = s;
        len++;
    }

    // element i, null when the index is out of range
    public char* get(int i) {
        if (i < 0 || i >= len) {
            return null;
        }
        return data[i];
    }

    public char* pop() {
        if (len == 0) {
            return null;
        }
        len--;
        return data[len];
    }

    public int indexOf(char* s) {
        for (int i = 0; i < len; i++) {
            if (streq(data[i], s)) {
                return i;
            }
        }
        return -1;
    }

    public void clear() { len = 0; }

    public char** items() { return data; }
}

public class StrMap {
    private char** keys;
    private int* vals;
    private int cap;
    private int count;

    private int hashOf(char* s) {
        int h = 5381;
        for (int i = 0; s[i] != 0; i++) {
            h = h * 33 + s[i];
        }
        return h & 0x7FFFFFFFFFFFFFFF;
    }

    private void init(int c) {
        cap = c;
        keys = (char**) alloc(c * 8);
        vals = (int*) alloc(c * 8);
        count = 0;
    }

    // slot holding key, or the empty slot where it belongs
    private int slotOf(char* key) {
        int i = hashOf(key) % cap;
        while (keys[i] != null) {
            if (streq(keys[i], key)) {
                return i;
            }
            i = (i + 1) % cap;
        }
        return i;
    }

    private void rehash() {
        char** ok = keys;
        int* ov = vals;
        int oc = cap;
        init(oc * 2);
        for (int k = 0; k < oc; k++) {
            if (ok[k] != null) {
                int i = slotOf(ok[k]);
                keys[i] = ok[k];
                vals[i] = ov[k];
                count++;
            }
        }
    }

    public int size() { return count; }

    public void put(char* key, int v) {
        if (cap == 0) {
            init(16);
        } else if ((count + 1) * 4 > cap * 3) {
            rehash();
        }
        int i = slotOf(key);
        if (keys[i] == null) {
            keys[i] = strdup(key);
            count++;
        }
        vals[i] = v;
    }

    public bool has(char* key) {
        if (cap == 0) {
            return false;
        }
        return keys[slotOf(key)] != null;
    }

    // the value of key, or fallback when it is missing
    public int get(char* key, int fallback) {
        if (cap == 0) {
            return fallback;
        }
        int i = slotOf(key);
        if (keys[i] == null) {
            return fallback;
        }
        return vals[i];
    }

    public bool remove(char* key) {
        if (cap == 0) {
            return false;
        }
        int i = slotOf(key);
        if (keys[i] == null) {
            return false;
        }
        keys[i] = null;
        count--;
        int j = i;
        for (;;) {
            j = (j + 1) % cap;
            if (keys[j] == null) {
                break;
            }
            int k = hashOf(keys[j]) % cap;
            bool inRange;
            if (i <= j) {
                inRange = i < k && k <= j;
            } else {
                inRange = i < k || k <= j;
            }
            if (inRange) {
                continue;
            }
            keys[i] = keys[j];
            vals[i] = vals[j];
            keys[j] = null;
            i = j;
        }
        return true;
    }

    // iteration: for (int s = 0; s < map.capacity(); s++) { if (map.keyAt(s) != null) ... map.valueAt(s) }
    public int capacity() { return cap; }

    public char* keyAt(int slot) {
        if (slot < 0 || slot >= cap) {
            return null;
        }
        return keys[slot];
    }

    public int valueAt(int slot) {
        if (slot < 0 || slot >= cap) {
            return 0;
        }
        return vals[slot];
    }
}

public class IntMap {
    private int* keys;
    private int* vals;
    private char* used;
    private int cap;
    private int count;

    private int hashOf(int key) {
        return ((key * 0x1E3779B97F4A7C15) >> 20) & 0x7FFFFFFFFFFFF;
    }

    private void init(int c) {
        cap = c;
        keys = (int*) alloc(c * 8);
        vals = (int*) alloc(c * 8);
        used = alloc(c);
        count = 0;
    }

    private int slotOf(int key) {
        int i = hashOf(key) % cap;
        while (used[i] != 0) {
            if (keys[i] == key) {
                return i;
            }
            i = (i + 1) % cap;
        }
        return i;
    }

    private void rehash() {
        int* ok = keys;
        int* ov = vals;
        char* ou = used;
        int oc = cap;
        init(oc * 2);
        for (int k = 0; k < oc; k++) {
            if (ou[k] != 0) {
                int i = slotOf(ok[k]);
                keys[i] = ok[k];
                vals[i] = ov[k];
                used[i] = 1;
                count++;
            }
        }
    }

    public int size() { return count; }

    public void put(int key, int v) {
        if (cap == 0) {
            init(16);
        } else if ((count + 1) * 4 > cap * 3) {
            rehash();
        }
        int i = slotOf(key);
        if (used[i] == 0) {
            used[i] = 1;
            keys[i] = key;
            count++;
        }
        vals[i] = v;
    }

    public bool has(int key) {
        if (cap == 0) {
            return false;
        }
        return used[slotOf(key)] != 0;
    }

    public int get(int key, int fallback) {
        if (cap == 0) {
            return fallback;
        }
        int i = slotOf(key);
        if (used[i] == 0) {
            return fallback;
        }
        return vals[i];
    }

    public bool remove(int key) {
        if (cap == 0) {
            return false;
        }
        int i = slotOf(key);
        if (used[i] == 0) {
            return false;
        }
        used[i] = 0;
        count--;
        int j = i;
        for (;;) {
            j = (j + 1) % cap;
            if (used[j] == 0) {
                break;
            }
            int k = hashOf(keys[j]) % cap;
            bool inRange;
            if (i <= j) {
                inRange = i < k && k <= j;
            } else {
                inRange = i < k || k <= j;
            }
            if (inRange) {
                continue;
            }
            keys[i] = keys[j];
            vals[i] = vals[j];
            used[i] = 1;
            used[j] = 0;
            i = j;
        }
        return true;
    }

    public int capacity() { return cap; }
    public bool usedAt(int slot) { return slot >= 0 && slot < cap && used[slot] != 0; }
    public int keyAt(int slot) { return keys[slot]; }
    public int valueAt(int slot) { return vals[slot]; }
}
