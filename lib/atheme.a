// a new theme with the built-in values of that name (case insensitive), or null for an unknown name
public Theme* builtin(char* name) {
    char lower[40];
    int n = strlen(name);
    if (n > 38) { return null; }
    for (int i = 0; i <= n; i++) {
        int c = name[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        lower[i] = c;
    }
    char* spec = specFor(&lower[0]);
    if (spec == null) { return null; }
    Theme* t = new Theme();
    t->setName(&lower[0]);
    t->applySpec(spec);
    for (int i = 0; i < 24; i++) { t->colorSet[i] = false; t->tokSet[i] = false; }
    return t;
}

// ---- loading theme files ----------------------------------------------------------------------------------------------------------------------------------
struct ThemeLoad {
    Theme* theme;
    Warnings* warn;
    char* base;
    bool sawTheme;
    int applied;
}

int themeEntry(int user, char* section, char* key, char* value) {
    ThemeLoad* L = (ThemeLoad*) user;
    if (streqi(section, "theme")) {
        L->sawTheme = true;
        if (streqi(key, "name")) {
            if (value[0] != 0) { L->theme->setName(value); }
        } else if (streqi(key, "base")) {
            // handled by the caller before the other entries are applied: remembered here
        } else if (L->warn != null) {
            L->warn->add2("unknown key in [theme]: ", key);
        }
        return 0;
    }
    if (streqi(section, "colors")) {
        int k = colByName(key);
        int c = 0;
        if (k < 0) {
            if (L->warn != null) { L->warn->add2("unknown colour: ", key); }
        } else if (!parseColor(value, &c)) {
            if (L->warn != null) { L->warn->add2("bad colour value for ", key); }
        } else {
            L->theme->setColor(k, c);
            L->applied++;
        }
        return 0;
    }
    if (streqi(section, "tokens")) {
        int k = kindByName(key);
        char buf[80];
        int vl = strlen(value);
        if (vl > 70) { vl = 70; }
        for (int i = 0; i < vl; i++) { buf[i] = value[i]; }
        buf[vl] = 0;
        int sp = indexOf(&buf[0], ' ');
        int style = 0;
        if (sp >= 0) {
            style = parseStyle(&buf[sp + 1]);
            buf[sp] = 0;
        }
        int c = 0;
        if (k < 0) {
            if (L->warn != null) { L->warn->add2("unknown token kind: ", key); }
        } else if (!parseColor(&buf[0], &c)) {
            if (L->warn != null) { L->warn->add2("bad colour value for token ", key); }
        } else {
            L->theme->setToken(k, c, style);
            L->applied++;
        }
        return 0;
    }
    if (L->warn != null && section[0] != 0) {
        L->warn->add2("unknown section: ", section);
    }
    return 0;
}

int themeBase(int user, char* section, char* key, char* value) {
    ThemeLoad* L = (ThemeLoad*) user;
    if (streqi(section, "theme") && streqi(key, "base") && L->base == null) {
        L->base = asys.strDup(value);
    }
    return 0;
}

// Parses theme text. The theme starts as the built-in theme named by "base" (or "dark"); the entries of the text replace its
// values. Problems are added to warn (may be null); the result is always a usable theme.
public Theme* parseTheme(char* text, int len, Warnings* warn) {
    ThemeLoad L;
    L.warn = warn;
    L.base = null;
    L.applied = 0;
    L.sawTheme = false;
    L.theme = null;
    parseIni(text, len, themeBase, (int) &L);
    Theme* base = null;
    if (L.base != null) {
        base = builtin(L.base);
        if (base == null && warn != null) { warn->add2("unknown base theme: ", L.base); }
    }
    if (base == null) { base = builtin("dark"); }
    L.theme = base;
    L.theme->setName("untitled");
    int bad = parseIni(text, len, themeEntry, (int) &L);
    if (warn != null && bad > 0) {
        char msg[80];
        format(&msg[0], 80, "%d lines were not understood", bad);
        warn->add(&msg[0]);
    }
    if (warn != null && L.applied == 0) {
        warn->add("the file defines no colours");
    }
    asys.free(L.base);
    return L.theme;
}

// Reads a theme file. A file that cannot be read gives the dark theme and a warning.
public Theme* loadTheme(char* path, Warnings* warn) {
    int len = 0;
    char* text = readSmall(path, &len, warn);
    if (text == null) {
        Theme* t = builtin("dark");
        return t;
    }
    Theme* t = parseTheme(text, len, warn);
    asys.free(text);
    return t;
}

// ---- settings --------------------------------------------------------------------------------------------------------------------------------------------------
// The directory that holds settings.ini and themes/: aideHome if it is not empty, else home + "/.aide", else ".aide". A new string.
public char* configDirFrom(char* aideHome, char* home) {
    if (aideHome != null && aideHome[0] != 0) { return asys.strDup(aideHome); }
    if (home != null && home[0] != 0) { return asys.concat3(home, "/.aide", ""); }
    return asys.strDup(".aide");
}

// the configuration directory of this process ($AIDE_HOME, else $HOME/.aide)
public char* configDir() {
    char* a = asys.getenv("AIDE_HOME");
    char* h = asys.getenv("HOME");
    if (h == null) { h = asys.getenv("USERPROFILE"); }
    char* r = configDirFrom(a, h);
    asys.free(a);
    asys.free(h);
    return r;
}

private void addRecent(char** list, int* count, int cap, char* path) {
    int at = -1;
    for (int i = 0; i < *count; i++) {
        if (streq(list[i], path)) { at = i; break; }
    }
    if (at >= 0) {
        char* keep = list[at];
        for (int i = at; i > 0; i--) { list[i] = list[i - 1]; }
        list[0] = keep;
        return;
    }
    if (*count == cap) {
        asys.free(list[cap - 1]);
        *count = cap - 1;
    }
    for (int i = *count; i > 0; i--) { list[i] = list[i - 1]; }
    list[0] = asys.strDup(path);
    *count = *count + 1;
}

private int parseInt(char* s, int fallback, int lo, int hi) {
    if (s == null || s[0] == 0) { return fallback; }
    int sign = 1;
    int i = 0;
    if (s[0] == '-') { sign = -1; i = 1; }
    if (s[i] < '0' || s[i] > '9') { return fallback; }
    int v = 0;
    while (s[i] >= '0' && s[i] <= '9' && v < 1000000000) {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    if (s[i] != 0) { return fallback; }
    return clamp(v * sign, lo, hi);
}

private bool parseBool(char* s, bool fallback) {
    if (streqi(s, "true") || streqi(s, "yes") || streqi(s, "on") || streqi(s, "1")) { return true; }
    if (streqi(s, "false") || streqi(s, "no") || streqi(s, "off") || streqi(s, "0")) { return false; }
    return fallback;
}

public const MAX_RECENT = 30;

public class Settings {
    public int tabWidth;
    public bool insertSpaces;
    public bool lineNumbers;
    public bool wordWrap;
    public int fontSize;
    public bool autoIndent;
    public bool trimOnSave;
    public bool finalNewline;
    public char* theme;
    public char* font;              // "mono", "sans", "sansbold" or the path of a font file (gfx.loadFont)
    public int winX;
    public int winY;
    public int winW;
    public int winH;
    public bool winMaximized;
    public char** recentFiles;
    public int nFiles;
    public char** recentProjects;
    public int nProjects;
    public char** bindAction;
    public char** bindKeys;
    public int nBinds;
    private int bindCap;

    public Settings() {
        recentFiles = (char**) asys.alloc(MAX_RECENT * 8);
        recentProjects = (char**) asys.alloc(MAX_RECENT * 8);
        reset();
    }

    // the built-in defaults
    public void reset() {
        tabWidth = 4;
        insertSpaces = true;
        lineNumbers = true;
        wordWrap = false;
        fontSize = 14;
        autoIndent = true;
        trimOnSave = false;
        finalNewline = false;
        asys.free(theme);
        theme = asys.strDup("dark");
        asys.free(font);
        font = asys.strDup("mono");
        winX = 80;
        winY = 60;
        winW = 960;
        winH = 640;
        winMaximized = false;
        clearLists();
    }

    private void clearLists() {
        for (int i = 0; i < nFiles; i++) { asys.free(recentFiles[i]); }
        for (int i = 0; i < nProjects; i++) { asys.free(recentProjects[i]); }
        nFiles = 0;
        nProjects = 0;
        for (int i = 0; i < nBinds; i++) {
            asys.free(bindAction[i]);
            asys.free(bindKeys[i]);
        }
        nBinds = 0;
    }

    public void dispose() {
        clearLists();
        asys.free(theme);
        asys.free(font);
        font = null;
        asys.free((char*) recentFiles);
        asys.free((char*) recentProjects);
        asys.free((char*) bindAction);
        asys.free((char*) bindKeys);
        theme = null;
        recentFiles = null;
        recentProjects = null;
        bindAction = null;
        bindKeys = null;
        bindCap = 0;
    }

    public void addRecentFile(char* path) {
        addRecent(recentFiles, &nFiles, MAX_RECENT, path);
    }

    public void addRecentProject(char* path) {
        addRecent(recentProjects, &nProjects, MAX_RECENT, path);
    }

    // a key binding override: action (e.g. "file.save") bound to keys (e.g. "ctrl+s"); a second call for the same action replaces it
    public void setBinding(char* action, char* keys) {
        for (int i = 0; i < nBinds; i++) {
            if (streq(bindAction[i], action)) {
                asys.free(bindKeys[i]);
                bindKeys[i] = asys.strDup(keys);
                return;
            }
        }
        if (nBinds == bindCap) {
            bindCap = (bindCap == 0) ? 16 : bindCap * 2;
            bindAction = (char**) asys.realloc((char*) bindAction, bindCap * 8);
            bindKeys = (char**) asys.realloc((char*) bindKeys, bindCap * 8);
        }
        bindAction[nBinds] = asys.strDup(action);
        bindKeys[nBinds] = asys.strDup(keys);
        nBinds++;
    }

    // the keys bound to an action by the user, or null
    public char* binding(char* action) {
        for (int i = 0; i < nBinds; i++) {
            if (streq(bindAction[i], action)) { return bindKeys[i]; }
        }
        return null;
    }

    // applies one  section / key / value  entry; returns false when it is not a known setting
    public bool apply(char* section, char* key, char* value) {
        if (streqi(section, "editor")) {
            if (streqi(key, "tabwidth")) { tabWidth = parseInt(value, tabWidth, 1, 16); return true; }
            if (streqi(key, "insertspaces")) { insertSpaces = parseBool(value, insertSpaces); return true; }
            if (streqi(key, "linenumbers")) { lineNumbers = parseBool(value, lineNumbers); return true; }
            if (streqi(key, "wordwrap")) { wordWrap = parseBool(value, wordWrap); return true; }
            if (streqi(key, "fontsize")) { fontSize = parseInt(value, fontSize, 6, 72); return true; }
            if (streqi(key, "autoindent")) { autoIndent = parseBool(value, autoIndent); return true; }
            if (streqi(key, "trimonsave")) { trimOnSave = parseBool(value, trimOnSave); return true; }
            if (streqi(key, "finalnewline")) { finalNewline = parseBool(value, finalNewline); return true; }
            if (streqi(key, "theme")) {
                if (value[0] != 0 && strlen(value) < 100) {
                    asys.free(theme);
                    theme = asys.strDup(value);
                }
                return true;
            }
            if (streqi(key, "font")) {
                if (value[0] != 0 && strlen(value) < 300) {
                    asys.free(font);
                    font = asys.strDup(value);
                }
                return true;
            }
            return false;
        }
        if (streqi(section, "window")) {
            if (streqi(key, "x")) { winX = parseInt(value, winX, -10000, 100000); return true; }
            if (streqi(key, "y")) { winY = parseInt(value, winY, -10000, 100000); return true; }
            if (streqi(key, "width")) { winW = parseInt(value, winW, 200, 100000); return true; }
            if (streqi(key, "height")) { winH = parseInt(value, winH, 120, 100000); return true; }
            if (streqi(key, "maximized")) { winMaximized = parseBool(value, winMaximized); return true; }
            return false;
        }
        if (streqi(section, "recent")) {
            if (streqi(key, "file") && value[0] != 0) { appendRecent(recentFiles, &nFiles, value); return true; }
            if (streqi(key, "project") && value[0] != 0) { appendRecent(recentProjects, &nProjects, value); return true; }
            return false;
        }
        if (streqi(section, "keys")) {
            if (key[0] != 0 && value[0] != 0 && strlen(key) < 80) { setBinding(key, value); return true; }
            return false;
        }
        return false;
    }

    private void appendRecent(char** list, int* count, char* path) {
        if (*count >= MAX_RECENT) { return; }
        for (int i = 0; i < *count; i++) {
            if (streq(list[i], path)) { return; }
        }
        list[*count] = asys.strDup(path);
        *count = *count + 1;
    }

    // Reads settings from INI text (the values it does not mention stay as they are). Returns the number of lines or entries
    // that were not understood.
    public int parse(char* text, int len) {
        int bad = parseIni(text, len, settingsEntry, (int) this);
        return bad + unknown;
    }

    public int unknown;

    // Reads a settings file: 0, or -errno when it cannot be read (the settings keep their values). Problems inside the file
    // never fail the call; the count of lines that were not understood is stored in `unknown`.
    public int load(char* path) {
        int len = 0;
        int e = 0;
        unknown = 0;
        char* text = asys.readFile(path, &len, 1048576, &e);
        if (text == null) { return e; }
        parse(text, len);
        asys.free(text);
        return 0;
    }

    // the settings as INI text (a new string)
    public char* toIni() {
        int cap = 4096 + (nFiles + nProjects + nBinds) * 600;
        char* out = asys.alloc(cap);
        int o = 0;
        o = o + format(&out[o], cap - o, "[editor]\ntabWidth = %d\ninsertSpaces = %s\nlineNumbers = %s\nwordWrap = %s\nfontSize = %d\n", tabWidth, insertSpaces ? "true" : "false", lineNumbers ? "true" : "false", wordWrap ? "true" : "false", fontSize);
        o = o + format(&out[o], cap - o, "autoIndent = %s\ntrimOnSave = %s\nfinalNewline = %s\ntheme = %s\nfont = %s\n\n", autoIndent ? "true" : "false", trimOnSave ? "true" : "false", finalNewline ? "true" : "false", theme, font);
        o = o + format(&out[o], cap - o, "[window]\nx = %d\ny = %d\nwidth = %d\nheight = %d\nmaximized = %s\n\n", winX, winY, winW, winH, winMaximized ? "true" : "false");
        o = o + format(&out[o], cap - o, "[recent]\n");
        for (int i = 0; i < nFiles; i++) {
            if (strlen(recentFiles[i]) < 500) { o = o + format(&out[o], cap - o, "file = \"%s\"\n", recentFiles[i]); }
        }
        for (int i = 0; i < nProjects; i++) {
            if (strlen(recentProjects[i]) < 500) { o = o + format(&out[o], cap - o, "project = \"%s\"\n", recentProjects[i]); }
        }
        o = o + format(&out[o], cap - o, "\n[keys]\n");
        for (int i = 0; i < nBinds; i++) {
            if (strlen(bindAction[i]) < 80 && strlen(bindKeys[i]) < 200) { o = o + format(&out[o], cap - o, "%s = %s\n", bindAction[i], bindKeys[i]); }
        }
        out[o] = 0;
        return out;
    }

    // writes the settings atomically (the directory is created when needed): 0 or -errno
    public int save(char* path) {
        char* t = toIni();
        int sl = -1;
        for (int i = 0; path[i] != 0; i++) {
            if (path[i] == '/') { sl = i; }
        }
        if (sl > 0) {
            char* dir = asys.strDupN(path, sl);
            asys.mkdirs(dir);
            asys.free(dir);
        }
        int r = asys.writeFileAtomic(path, t, strlen(t), 420, asys.W_NOSYNC);
        asys.free(t);
        return (r < 0) ? r : 0;
    }
}

int settingsEntry(int user, char* section, char* key, char* value) {
    Settings* s = (Settings*) user;
    if (!s->apply(section, key, value)) {
        s->unknown++;
    }
    return 0;
}
