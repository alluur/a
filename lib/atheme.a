// =============================================================================
//  atheme - themes, user settings and colour helpers                                           import atheme;
//
//  Theme: named colours (Col: Background Foreground LineNumber LineNumberActive CurrentLine Selection Cursor StatusBar
//  StatusBarText TabBar TabBarText TabActive Sidebar SidebarText Menu MenuText Border Error Warning Info BracketMatch
//  FindMatch Whitespace Guide) and one colour plus style (STYLE_BOLD / ITALIC / UNDERLINE) for every syntax token kind
//  (asyntax.Tok). Colours are 0xRRGGBB numbers.
//
//    atheme.Theme* t = atheme.builtin("solarized-dark");            // dark light solarized-dark solarized-light monokai
//    int bg = t->color(atheme.Col.Background);                     // high-contrast gruvbox nord aos
//    int kw = t->tokenColor(asyntax.Tok.Keyword);  int style = t->tokenStyle(asyntax.Tok.Keyword);
//    atheme.Warnings w();  t->validate(&w);                        // "foreground on background: contrast 2.3:1 ..."
//    t->save("my.theme");   atheme.Theme* u = atheme.loadTheme("my.theme", &w);      // INI files, never crash
//
//  Theme files:   [theme] name = ... base = dark      [colors] background = #1e1e1e ...      [tokens] keyword = #569cd6 bold italic
//  Unknown keys and bad colours give warnings and leave the base theme's value. Files over 1 MB, binary garbage and files
//  without sections are survived (warnings, the base theme).
//
//  Settings: tabWidth insertSpaces lineNumbers wordWrap fontSize autoIndent trimOnSave finalNewline theme, key bindings
//  (action = keys), recent files and projects, window geometry; stored as INI in the config directory ($AIDE_HOME, else
//  ~/.aide): settings.ini and themes/NAME.ini. Values are checked and clamped when loaded.
//
//  Colour helpers: rgb(r, g, b) red green blue, parseColor("#fa0" | "#ffaa00" | "ffaa00" | "0xffaa00" | "red"), formatColor,
//  to256 / from256 (xterm palette), to16 / from16 (ANSI colours), lighten / darken / mix (percent), luminance (0 .. 1000000),
//  contrast(a, b) = the WCAG contrast ratio times 100 (21:1 -> 2100), readable(fg, bg, minimum).
// =============================================================================
import asys;
import asyntax;
module atheme;

public enum Col : uint8 {
    Background, Foreground, LineNumber, LineNumberActive, CurrentLine, Selection, Cursor, StatusBar, StatusBarText, TabBar,
    TabBarText, TabActive, Sidebar, SidebarText, Menu, MenuText, Border, Error, Warning, Info, BracketMatch, FindMatch,
    Whitespace, Guide
}

public const STYLE_BOLD = 1;
public const STYLE_ITALIC = 2;
public const STYLE_UNDERLINE = 4;

private int imin(int a, int b) {
    if (a < b) { return a; }
    return b;
}

private int imax(int a, int b) {
    if (a > b) { return a; }
    return b;
}

private int clamp(int v, int lo, int hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// ---- colours -------------------------------------------------------------------------------------------------------------------------
public int rgb(int r, int g, int b) {
    return (clamp(r, 0, 255) << 16) | (clamp(g, 0, 255) << 8) | clamp(b, 0, 255);
}

public int red(int c) {
    return (c >> 16) & 255;
}

public int green(int c) {
    return (c >> 8) & 255;
}

public int blue(int c) {
    return c & 255;
}

private int hexDigit(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

// "#rgb", "#rrggbb", "rrggbb", "0xrrggbb" and the names black white red green blue yellow cyan magenta gray grey orange purple
// brown pink silver; stores the colour in *out. False (and *out unchanged) when the text is not a colour.
public bool parseColor(char* s, int* out) {
    if (s == null) { return false; }
    while (s[0] == ' ' || s[0] == 9) { s = &s[1]; }
    int n = strlen(s);
    while (n > 0 && (s[n - 1] == ' ' || s[n - 1] == 9)) { n--; }
    if (n == 0 || n > 16) { return false; }
    char buf[20];
    for (int i = 0; i < n; i++) { buf[i] = s[i]; }
    buf[n] = 0;
    char* t = &buf[0];
    if (t[0] == '#') { t = &t[1]; n--; }
    else if (t[0] == '0' && (t[1] == 'x' || t[1] == 'X')) { t = &t[2]; n = n - 2; }
    bool hex = n > 0;
    for (int i = 0; i < n; i++) {
        if (hexDigit(t[i]) < 0) { hex = false; }
    }
    if (hex && n == 6) {
        int v = 0;
        for (int i = 0; i < 6; i++) { v = (v << 4) | hexDigit(t[i]); }
        *out = v;
        return true;
    }
    if (hex && n == 3 && s[0] == '#') {
        int r = hexDigit(t[0]);
        int g = hexDigit(t[1]);
        int b = hexDigit(t[2]);
        *out = rgb(r * 17, g * 17, b * 17);
        return true;
    }
    if (hex && (s[0] == '#' || (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')))) {
        return false;                                   // a prefix but the wrong number of digits
    }
    char* names[16];
    int vals[16];
    names[0] = "black"; vals[0] = 0x000000;
    names[1] = "white"; vals[1] = 0xFFFFFF;
    names[2] = "red"; vals[2] = 0xFF0000;
    names[3] = "green"; vals[3] = 0x008000;
    names[4] = "blue"; vals[4] = 0x0000FF;
    names[5] = "yellow"; vals[5] = 0xFFFF00;
    names[6] = "cyan"; vals[6] = 0x00FFFF;
    names[7] = "magenta"; vals[7] = 0xFF00FF;
    names[8] = "gray"; vals[8] = 0x808080;
    names[9] = "grey"; vals[9] = 0x808080;
    names[10] = "orange"; vals[10] = 0xFFA500;
    names[11] = "purple"; vals[11] = 0x800080;
    names[12] = "brown"; vals[12] = 0xA52A2A;
    names[13] = "pink"; vals[13] = 0xFFC0CB;
    names[14] = "silver"; vals[14] = 0xC0C0C0;
    names[15] = "lime"; vals[15] = 0x00FF00;
    for (int i = 0; i < 16; i++) {
        if (streqi(names[i], buf)) {
            *out = vals[i];
            return true;
        }
    }
    return false;
}

// writes "#rrggbb" (7 characters and a NUL) to out
public void formatColor(int c, char* out) {
    char* d = "0123456789abcdef";
    out[0] = '#';
    out[1] = d[(c >> 20) & 15];
    out[2] = d[(c >> 16) & 15];
    out[3] = d[(c >> 12) & 15];
    out[4] = d[(c >> 8) & 15];
    out[5] = d[(c >> 4) & 15];
    out[6] = d[c & 15];
    out[7] = 0;
}

// the colour that is `percent` of the way from a towards b
public int mix(int a, int b, int percent) {
    percent = clamp(percent, 0, 100);
    int r = (red(a) * (100 - percent) + red(b) * percent + 50) / 100;
    int g = (green(a) * (100 - percent) + green(b) * percent + 50) / 100;
    int bl = (blue(a) * (100 - percent) + blue(b) * percent + 50) / 100;
    return rgb(r, g, bl);
}

public int lighten(int c, int percent) {
    return mix(c, 0xFFFFFF, percent);
}

public int darken(int c, int percent) {
    return mix(c, 0x000000, percent);
}

// the 16 ANSI colours as xterm draws them
private int system16(int i) {
    switch (i) {
        case 0: return 0x000000;
        case 1: return 0xCD0000;
        case 2: return 0x00CD00;
        case 3: return 0xCDCD00;
        case 4: return 0x0000EE;
        case 5: return 0xCD00CD;
        case 6: return 0x00CDCD;
        case 7: return 0xE5E5E5;
        case 8: return 0x7F7F7F;
        case 9: return 0xFF0000;
        case 10: return 0x00FF00;
        case 11: return 0xFFFF00;
        case 12: return 0x5C5CFF;
        case 13: return 0xFF00FF;
        case 14: return 0x00FFFF;
    }
    return 0xFFFFFF;
}

private int cubeLevel(int i) {
    if (i == 0) { return 0; }
    return 55 + i * 40;
}

// the colour of an entry of the 256 colour terminal palette (0..15 the ANSI colours, 16..231 a 6x6x6 cube, 232..255 grays)
public int from256(int i) {
    i = clamp(i, 0, 255);
    if (i < 16) { return system16(i); }
    if (i < 232) {
        int k = i - 16;
        return rgb(cubeLevel(k / 36), cubeLevel((k / 6) % 6), cubeLevel(k % 6));
    }
    int v = 8 + (i - 232) * 10;
    return rgb(v, v, v);
}

public int from16(int i) {
    return system16(clamp(i, 0, 15));
}

private int dist(int a, int b) {
    int dr = red(a) - red(b);
    int dg = green(a) - green(b);
    int db = blue(a) - blue(b);
    return dr * dr + dg * dg + db * db;
}

private int nearestLevel(int v) {
    int best = 0;
    int bd = 100000;
    for (int i = 0; i < 6; i++) {
        int d = v - cubeLevel(i);
        if (d < 0) { d = -d; }
        if (d < bd) { bd = d; best = i; }
    }
    return best;
}

// the nearest entry (16..255) of the 256 colour palette: the closer of the best cube colour and the best gray
public int to256(int c) {
    int ci = 16 + 36 * nearestLevel(red(c)) + 6 * nearestLevel(green(c)) + nearestLevel(blue(c));
    int avg = (red(c) + green(c) + blue(c)) / 3;
    int gi = 232 + clamp((avg - 8 + 5) / 10, 0, 23);
    if (dist(c, from256(gi)) < dist(c, from256(ci))) {
        return gi;
    }
    return ci;
}

// the nearest of the 16 ANSI colours (ties go to the lower number)
public int to16(int c) {
    int best = 0;
    int bd = dist(c, system16(0));
    for (int i = 1; i < 16; i++) {
        int d = dist(c, system16(i));
        if (d < bd) { bd = d; best = i; }
    }
    return best;
}

// sRGB to linear light, times 1000000, for the 256 channel values
int linTable[256] = {
    0, 304, 607, 911, 1214, 1518, 1821, 2125, 2428, 2732, 3035, 3347, 3677, 4025, 4391, 4777,
    5182, 5605, 6049, 6512, 6995, 7499, 8023, 8568, 9134, 9721, 10330, 10960, 11612, 12286, 12983, 13702,
    14444, 15209, 15996, 16807, 17642, 18500, 19382, 20289, 21219, 22174, 23153, 24158, 25187, 26241, 27321, 28426,
    29557, 30713, 31896, 33105, 34340, 35601, 36889, 38204, 39546, 40915, 42311, 43735, 45186, 46665, 48172, 49707,
    51269, 52861, 54480, 56128, 57805, 59511, 61246, 63010, 64803, 66626, 68478, 70360, 72272, 74214, 76185, 78187,
    80220, 82283, 84376, 86500, 88656, 90842, 93059, 95307, 97587, 99899, 102242, 104616, 107023, 109462, 111932, 114435,
    116971, 119538, 122139, 124772, 127438, 130136, 132868, 135633, 138432, 141263, 144128, 147027, 149960, 152926, 155926, 158961,
    162029, 165132, 168269, 171441, 174647, 177888, 181164, 184475, 187821, 191202, 194618, 198069, 201556, 205079, 208637, 212231,
    215861, 219526, 223228, 226966, 230740, 234551, 238398, 242281, 246201, 250158, 254152, 258183, 262251, 266356, 270498, 274677,
    278894, 283149, 287441, 291771, 296138, 300544, 304987, 309469, 313989, 318547, 323143, 327778, 332452, 337164, 341914, 346704,
    351533, 356400, 361307, 366253, 371238, 376262, 381326, 386429, 391572, 396755, 401978, 407240, 412543, 417885, 423268, 428690,
    434154, 439657, 445201, 450786, 456411, 462077, 467784, 473531, 479320, 485150, 491021, 496933, 502886, 508881, 514918, 520996,
    527115, 533276, 539479, 545724, 552011, 558340, 564712, 571125, 577580, 584078, 590619, 597202, 603827, 610496, 617207, 623960,
    630757, 637597, 644480, 651406, 658375, 665387, 672443, 679542, 686685, 693872, 701102, 708376, 715694, 723055, 730461, 737910,
    745404, 752942, 760525, 768151, 775822, 783538, 791298, 799103, 806952, 814847, 822786, 830770, 838799, 846873, 854993, 863157,
    871367, 879622, 887923, 896269, 904661, 913099, 921582, 930111, 938686, 947307, 955973, 964686, 973445, 982251, 991102, 1000000
};

// the relative luminance of a colour (WCAG): 0 for black .. 1000000 for white
public int luminance(int c) {
    int l = 2126 * linTable[red(c)] + 7152 * linTable[green(c)] + 722 * linTable[blue(c)];
    return (l + 5000) / 10000;
}

// the contrast ratio of two colours times 100 (black on white is 2100, equal colours 100)
public int contrast(int a, int b) {
    int la = luminance(a) + 50000;
    int lb = luminance(b) + 50000;
    if (la < lb) {
        int t = la;
        la = lb;
        lb = t;
    }
    return (la * 100 + lb / 2) / lb;
}

// is the text colour readable on the background? minimum is the ratio times 100 (450 = WCAG AA for normal text)
public bool readable(int fg, int bg, int minimum) {
    return contrast(fg, bg) >= minimum;
}

// ---- warnings --------------------------------------------------------------------------------------------------------------------------------
// a list of messages (at most 200) that loading and validating collect
public class Warnings {
    public char** items;
    public int count;
    private int cap;

    public Warnings() {
    }

    public void add(char* msg) {
        if (count >= 200) { return; }
        if (count == cap) {
            cap = (cap == 0) ? 16 : cap * 2;
            items = (char**) asys.realloc((char*) items, cap * 8);
        }
        items[count] = asys.strDup(msg);
        count++;
    }

    public void add2(char* a, char* b) {
        char* t = asys.concat3(a, b, "");
        add(t);
        asys.free(t);
    }

    public bool has(char* part) {
        for (int i = 0; i < count; i++) {
            if (contains(items[i], part)) { return true; }
        }
        return false;
    }

    public void dispose() {
        for (int i = 0; i < count; i++) { asys.free(items[i]); }
        asys.free((char*) items);
        items = null;
        count = 0;
        cap = 0;
    }
}

// ---- a tolerant INI reader -------------------------------------------------------------------------------------------------------------------
// Calls cb(user, section, key, value) for every  key = value  line (also  key : value ); section is "" before the first [section].
// Comments (; or # at the start of a line, " ;" / " #" after an unquoted value), blank lines and garbage lines are skipped. Lines
// over 4000 bytes are cut. Binary data does no harm. Returns the number of lines that were not understood.
public int parseIni(char* text, int len, func cb, int user) {
    int bad = 0;
    char* section = asys.strDup("");
    char* line = asys.alloc(4096);
    int pos = 0;
    if (len >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF) {
        pos = 3;                                        // a UTF-8 byte order mark
    }
    while (pos < len) {
        int e = pos;
        while (e < len && text[e] != 10) { e++; }
        int n = e - pos;
        if (n > 4000) { n = 4000; }
        int w = 0;
        for (int i = 0; i < n; i++) {
            int c = text[pos + i];
            if (c == 13 || c == 0) { continue; }
            line[w] = c;
            w++;
        }
        line[w] = 0;
        pos = e + 1;
        int s = 0;
        while (line[s] == ' ' || line[s] == 9) { s++; }
        if (line[s] == 0) { continue; }
        if (line[s] == ';' || line[s] == '#') { continue; }
        if (line[s] == '[') {
            int close = s + 1;
            while (line[close] != 0 && line[close] != ']') { close++; }
            if (line[close] == ']') {
                asys.free(section);
                section = asys.strDupN(&line[s + 1], close - s - 1);
                // trim
                int sl = strlen(section);
                while (sl > 0 && (section[sl - 1] == ' ' || section[sl - 1] == 9)) { sl--; }
                section[sl] = 0;
            } else {
                bad++;
            }
            continue;
        }
        int eq = -1;
        for (int i = s; line[i] != 0; i++) {
            if (line[i] == '=' || line[i] == ':') { eq = i; break; }
        }
        if (eq <= s) {
            bad++;
            continue;
        }
        int ke = eq;
        while (ke > s && (line[ke - 1] == ' ' || line[ke - 1] == 9)) { ke--; }
        line[ke] = 0;
        char* key = &line[s];
        int vs = eq + 1;
        while (line[vs] == ' ' || line[vs] == 9) { vs++; }
        char* val = &line[vs];
        int vl = strlen(val);
        if (val[0] == '"' && vl >= 2 && val[vl - 1] == '"') {
            val[vl - 1] = 0;
            val = &val[1];
        } else {
            // a trailing comment
            for (int i = 1; val[i] != 0; i++) {
                if ((val[i] == ';' || val[i] == '#') && (val[i - 1] == ' ' || val[i - 1] == 9)) {
                    val[i] = 0;
                    break;
                }
            }
            vl = strlen(val);
            while (vl > 0 && (val[vl - 1] == ' ' || val[vl - 1] == 9)) { vl--; }
            val[vl] = 0;
        }
        func f = cb;
        f(user, section, key, val);
    }
    asys.free(section);
    asys.free(line);
    return bad;
}

// reads a text file for the parsers: at most 1 MB; null (and a warning) when it cannot be read
private char* readSmall(char* path, int* len, Warnings* w) {
    int e = 0;
    char* t = asys.readFile(path, len, 1048576, &e);
    if (t == null) {
        if (w != null) {
            char msg[300];
            format(&msg[0], 300, "cannot read %s: %s", path, asys.errText(e));
            w->add(&msg[0]);
        }
    }
    return t;
}

// ---- themes -------------------------------------------------------------------------------------------------------------------------------------
public class Theme {
    public char* name;
    public int colors[24];
    public int tokColor[24];
    public int tokStyle[24];
    public bool colorSet[24];           // set explicitly (in a file or by setColor) rather than inherited
    public bool tokSet[24];

    public Theme() {
        name = asys.strDup("untitled");
    }

    public void dispose() {
        asys.free(name);
        name = null;
    }

    public void setName(char* n) {
        asys.free(name);
        name = asys.strDup(n);
    }

    public int color(int c) {
        if (c < 0 || c >= Col.count) { return 0; }
        return colors[c];
    }

    public void setColor(int c, int rgbValue) {
        if (c < 0 || c >= Col.count) { return; }
        colors[c] = rgbValue & 0xFFFFFF;
        colorSet[c] = true;
    }

    public int tokenColor(int kind) {
        if (kind < 0 || kind >= asyntax.Tok.count) { return colors[Col.Foreground]; }
        return tokColor[kind];
    }

    public int tokenStyle(int kind) {
        if (kind < 0 || kind >= asyntax.Tok.count) { return 0; }
        return tokStyle[kind];
    }

    public void setToken(int kind, int rgbValue, int style) {
        if (kind < 0 || kind >= asyntax.Tok.count) { return; }
        tokColor[kind] = rgbValue & 0xFFFFFF;
        tokStyle[kind] = style & 7;
        tokSet[kind] = true;
    }

    // copies everything from another theme (the name too)
    public void copyFrom(Theme* o) {
        setName(o->name);
        for (int i = 0; i < 24; i++) {
            colors[i] = o->colors[i];
            tokColor[i] = o->tokColor[i];
            tokStyle[i] = o->tokStyle[i];
            colorSet[i] = false;
            tokSet[i] = false;
        }
    }

    // sets colours from a compact specification: "background=1e1e1e foreground=d4d4d4 t.keyword=569cd6:b ..." (t. = a token
    // kind, a suffix after ':' of b i u gives the style). Unknown names are ignored. Used for the built-in themes.
    public void applySpec(char* spec) {
        int n = strlen(spec);
        int s = 0;
        for (int i = 0; i <= n; i++) {
            if (i == n || spec[i] == ' ') {
                if (i > s) {
                    applyItem(&spec[s], i - s);
                }
                s = i + 1;
            }
        }
    }

    private void applyItem(char* item, int len) {
        char buf[64];
        if (len > 60) { return; }
        for (int i = 0; i < len; i++) { buf[i] = item[i]; }
        buf[len] = 0;
        int eq = indexOf(&buf[0], '=');
        if (eq <= 0) { return; }
        buf[eq] = 0;
        char* key = &buf[0];
        char* val = &buf[eq + 1];
        int style = 0;
        int colon = indexOf(val, ':');
        if (colon >= 0) {
            val[colon] = 0;
            style = parseStyle(&val[colon + 1]);
        }
        int c = 0;
        if (!parseColor(val, &c)) { return; }
        if (key[0] == 't' && key[1] == '.') {
            int k = kindByName(&key[2]);
            if (k >= 0) { setToken(k, c, style); }
        } else {
            int k = colByName(key);
            if (k >= 0) { setColor(k, c); }
        }
    }

    // the theme as INI text (a new string)
    public char* toIni() {
        int cap = 8192;
        char* out = asys.alloc(cap);
        int o = 0;
        char line[200];
        char hex[12];
        o = o + format(&out[o], cap - o, "[theme]\nname = %s\n\n[colors]\n", name);
        for (int i = 0; i < Col.count; i++) {
            formatColor(colors[i], &hex[0]);
            int k = format(&line[0], 200, "%s = %s\n", lowerName(Col.name(i)), &hex[0]);
            if (o + k + 1 < cap) { memcpy(&out[o], &line[0], k); o = o + k; }
        }
        o = o + format(&out[o], cap - o, "\n[tokens]\n");
        for (int i = 0; i < asyntax.Tok.count; i++) {
            formatColor(tokColor[i], &hex[0]);
            char st[24];
            styleText(tokStyle[i], &st[0]);
            int k = format(&line[0], 200, "%s = %s%s\n", lowerName(asyntax.Tok.name(i)), &hex[0], &st[0]);
            if (o + k + 1 < cap) { memcpy(&out[o], &line[0], k); o = o + k; }
        }
        out[o] = 0;
        return out;
    }

    // Writes the theme to a file (atomically): 0 or -errno.
    public int save(char* path) {
        char* t = toIni();
        int r = asys.writeFileAtomic(path, t, strlen(t), 420, asys.W_NOSYNC);
        asys.free(t);
        return (r < 0) ? r : 0;
    }

    // Checks that the colours can be read: text colours against their backgrounds (ratio 4.5), line numbers, syntax colours
    // (3.0) and the selection. Adds one message per problem to w and returns how many there were.
    public int validate(Warnings* w) {
        int before = w->count;
        pair(w, "foreground", "background", Col.Foreground, Col.Background, 450);
        pair(w, "line numbers", "background", Col.LineNumber, Col.Background, 300);
        pair(w, "active line number", "background", Col.LineNumberActive, Col.Background, 300);
        pair(w, "foreground", "selection", Col.Foreground, Col.Selection, 300);
        pair(w, "foreground", "current line", Col.Foreground, Col.CurrentLine, 450);
        pair(w, "cursor", "background", Col.Cursor, Col.Background, 300);
        pair(w, "status bar text", "status bar", Col.StatusBarText, Col.StatusBar, 450);
        pair(w, "tab bar text", "tab bar", Col.TabBarText, Col.TabBar, 450);
        pair(w, "sidebar text", "sidebar", Col.SidebarText, Col.Sidebar, 450);
        pair(w, "menu text", "menu", Col.MenuText, Col.Menu, 450);
        pair(w, "error", "background", Col.Error, Col.Background, 300);
        pair(w, "warning", "background", Col.Warning, Col.Background, 300);
        for (int k = 0; k < asyntax.Tok.count; k++) {
            int c = contrast(tokColor[k], colors[Col.Background]);
            if (c < 300) {
                char msg[160];
                format(&msg[0], 160, "%s on background: contrast %d.%02d:1 (minimum 3.0:1)", lowerName(asyntax.Tok.name(k)), c / 100, c % 100);
                w->add(&msg[0]);
            }
        }
        return w->count - before;
    }

    private void pair(Warnings* w, char* what, char* on, int a, int b, int minimum) {
        int c = contrast(colors[a], colors[b]);
        if (c < minimum) {
            char msg[160];
            format(&msg[0], 160, "%s on %s: contrast %d.%02d:1 (minimum %d.%d:1)", what, on, c / 100, c % 100, minimum / 100, (minimum % 100) / 10);
            w->add(&msg[0]);
        }
    }
}

// the lower case name of an enum member (a static buffer: use it at once)
char lowerBuf[48];
private char* lowerName(char* n) {
    int i = 0;
    while (n[i] != 0 && i < 46) {
        int c = n[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        lowerBuf[i] = c;
        i++;
    }
    lowerBuf[i] = 0;
    return &lowerBuf[0];
}

private int colByName(char* name) {
    for (int i = 0; i < Col.count; i++) {
        if (streqi(Col.name(i), name)) { return i; }
    }
    return -1;
}

private int kindByName(char* name) {
    for (int i = 0; i < asyntax.Tok.count; i++) {
        if (streqi(asyntax.Tok.name(i), name)) { return i; }
    }
    return -1;
}

// "bold italic underline" or "biu" -> style bits
private int parseStyle(char* s) {
    int st = 0;
    int n = strlen(s);
    if (contains(s, "bold")) { st = st | STYLE_BOLD; }
    if (contains(s, "italic")) { st = st | STYLE_ITALIC; }
    if (contains(s, "underline")) { st = st | STYLE_UNDERLINE; }
    if (st == 0) {
        for (int i = 0; i < n; i++) {
            if (s[i] == 'b') { st = st | STYLE_BOLD; }
            if (s[i] == 'i') { st = st | STYLE_ITALIC; }
            if (s[i] == 'u') { st = st | STYLE_UNDERLINE; }
        }
    }
    return st;
}

// " bold italic" for style bits ("" for none)
private void styleText(int st, char* out) {
    int o = 0;
    if ((st & STYLE_BOLD) != 0) { out[o] = ' '; o++; memcpy(&out[o], "bold", 4); o = o + 4; }
    if ((st & STYLE_ITALIC) != 0) { out[o] = ' '; o++; memcpy(&out[o], "italic", 6); o = o + 6; }
    if ((st & STYLE_UNDERLINE) != 0) { out[o] = ' '; o++; memcpy(&out[o], "underline", 9); o = o + 9; }
    out[o] = 0;
}

// ---- the built-in themes -----------------------------------------------------------------------------------------------------------------------------
public char* builtinNames() {
    return "dark light solarized-dark solarized-light monokai high-contrast gruvbox nord aos";
}

