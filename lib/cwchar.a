// =============================================================================
//  cwchar - C <wchar.h> and <wctype.h>                        import cwchar;
//
//  Wide characters are Unicode code points stored in ints; a wide string is an `int*` ended by a 0.
//  The functions have the C names: wcslen wcscpy wcsncpy wcscat wcsncat wcscmp wcsncmp wcschr wcsrchr wcsstr
//  wcsspn wcscspn wcspbrk wcstok wcsdup  wmemcpy wmemmove wmemset wmemcmp wmemchr  wcstol wcstoul  btowc wctob
//  wcwidth wcswidth  and the classification iswalpha iswdigit iswalnum iswspace iswupper iswlower iswpunct iswprint
//  iswgraph iswcntrl iswxdigit iswblank  towupper towlower.
//  Conversions to and from UTF-8 text are mbstowcs / wcstombs (cstdlib) - this module imports cstdlib so they come along.
//  Letters and case mapping cover ASCII, Latin-1, Latin Extended-A, Greek, Cyrillic and the common scripts
//  (Hebrew, Arabic, Devanagari, Thai, Hiragana, Katakana, CJK, Hangul) for classification.
// =============================================================================
import cstdlib;

const WEOF = -1;

// ---- strings ---------------------------------------------------------------------------------------------------
int wcslen(int* s) {
    int n = 0;
    while (s[n] != 0) {
        n++;
    }
    return n;
}

int* wcscpy(int* dst, int* src) {
    int i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return dst;
}

int* wcsncpy(int* dst, int* src, int n) {
    int i = 0;
    while (i < n && src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    while (i < n) {
        dst[i] = 0;
        i++;
    }
    return dst;
}

int* wcscat(int* dst, int* src) {
    wcscpy(&dst[wcslen(dst)], src);
    return dst;
}

int* wcsncat(int* dst, int* src, int n) {
    int d = wcslen(dst);
    int i = 0;
    while (i < n && src[i] != 0) {
        dst[d + i] = src[i];
        i++;
    }
    dst[d + i] = 0;
    return dst;
}

int wcscmp(int* a, int* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    if (a[i] < b[i]) { return -1; }
    if (a[i] > b[i]) { return 1; }
    return 0;
}

int wcsncmp(int* a, int* b, int n) {
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) { return -1; }
            return 1;
        }
        if (a[i] == 0) {
            return 0;
        }
    }
    return 0;
}

int* wcschr(int* s, int c) {
    int i = 0;
    for (;;) {
        if (s[i] == c) {
            return &s[i];
        }
        if (s[i] == 0) {
            return null;
        }
        i++;
    }
    return null;
}

int* wcsrchr(int* s, int c) {
    int* found = null;
    int i = 0;
    for (;;) {
        if (s[i] == c) {
            found = &s[i];
        }
        if (s[i] == 0) {
            return found;
        }
        i++;
    }
    return null;
}

int* wcsstr(int* hay, int* needle) {
    int n = wcslen(needle);
    if (n == 0) {
        return hay;
    }
    int i = 0;
    while (hay[i] != 0) {
        int k = 0;
        while (k < n && hay[i + k] == needle[k]) {
            k++;
        }
        if (k == n) {
            return &hay[i];
        }
        if (hay[i + k] == 0) {
            return null;
        }
        i++;
    }
    return null;
}

int wcsspn(int* s, int* accept) {
    int i = 0;
    while (s[i] != 0 && wcschr(accept, s[i]) != null) {
        i++;
    }
    return i;
}

int wcscspn(int* s, int* reject) {
    int i = 0;
    while (s[i] != 0 && wcschr(reject, s[i]) == null) {
        i++;
    }
    return i;
}

int* wcspbrk(int* s, int* accept) {
    int i = 0;
    while (s[i] != 0) {
        if (wcschr(accept, s[i]) != null) {
            return &s[i];
        }
        i++;
    }
    return null;
}

// like strtok: the position is kept in *save
int* wcstok(int* s, int* delim, int** save) {
    if (s == null) {
        s = *save;
    }
    if (s == null) {
        return null;
    }
    s = &s[wcsspn(s, delim)];
    if (s[0] == 0) {
        *save = null;
        return null;
    }
    int n = wcscspn(s, delim);
    if (s[n] == 0) {
        *save = null;
    } else {
        s[n] = 0;
        *save = &s[n + 1];
    }
    return s;
}

int* wcsdup(int* s) {
    int n = wcslen(s);
    int* r = (int*) alloc((n + 1) * 8);
    wcscpy(r, s);
    return r;
}

int* wmemcpy(int* dst, int* src, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = src[i];
    }
    return dst;
}

int* wmemmove(int* dst, int* src, int n) {
    if (dst < src) {
        for (int i = 0; i < n; i++) {
            dst[i] = src[i];
        }
    } else {
        for (int i = n - 1; i >= 0; i--) {
            dst[i] = src[i];
        }
    }
    return dst;
}

int* wmemset(int* dst, int c, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = c;
    }
    return dst;
}

int wmemcmp(int* a, int* b, int n) {
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) { return -1; }
            return 1;
        }
    }
    return 0;
}

int* wmemchr(int* s, int c, int n) {
    for (int i = 0; i < n; i++) {
        if (s[i] == c) {
            return &s[i];
        }
    }
    return null;
}

// number conversion (digits are ASCII): the same rules as strtol
int wcstol(int* s, int** end, int base = 10) {
    char buf[80];
    int n = 0;
    while (s[n] != 0 && n < 79 && s[n] < 128) {
        buf[n] = s[n];
        n++;
    }
    buf[n] = 0;
    char* e;
    int v = strtol(&buf[0], &e, base);
    if (end != null) {
        *end = &s[(int) e - (int) &buf[0]];
    }
    return v;
}

int wcstoul(int* s, int** end, int base = 10) {
    char buf[80];
    int n = 0;
    while (s[n] != 0 && n < 79 && s[n] < 128) {
        buf[n] = s[n];
        n++;
    }
    buf[n] = 0;
    char* e;
    int v = strtoul(&buf[0], &e, base);
    if (end != null) {
        *end = &s[(int) e - (int) &buf[0]];
    }
    return v;
}

// single byte <-> wide character (ASCII only: other bytes give WEOF / -1)
int btowc(int c) {
    if (c >= 0 && c < 128) {
        return c;
    }
    return WEOF;
}

int wctob(int c) {
    if (c >= 0 && c < 128) {
        return c;
    }
    return -1;
}

// ---- classification ----------------------------------------------------------------------------------------------
bool iswupper(int c) {
    return towlower(c) != c;
}

bool iswlower(int c) {
    return towupper(c) != c || c == 0xDF;
}

bool iswalpha(int c) {
    if (c < 128) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }
    if (c == 0xAA || c == 0xB5 || c == 0xBA) { return true; }
    if (c >= 0xC0 && c <= 0x24F) { return c != 0xD7 && c != 0xF7; }
    if (c >= 0x370 && c <= 0x3FF) { return c != 0x375 && c != 0x37E && c != 0x384 && c != 0x385 && c != 0x387; }
    if (c >= 0x400 && c <= 0x481) { return true; }
    if (c >= 0x48A && c <= 0x52F) { return true; }
    if (c >= 0x531 && c <= 0x556) { return true; }
    if (c >= 0x561 && c <= 0x587) { return true; }
    if (c >= 0x5D0 && c <= 0x5EA) { return true; }
    if (c >= 0x620 && c <= 0x64A) { return true; }
    if (c >= 0x671 && c <= 0x6D3) { return true; }
    if (c >= 0x904 && c <= 0x939) { return true; }
    if (c >= 0xE01 && c <= 0xE30) { return true; }
    if (c >= 0x1E00 && c <= 0x1FFF) { return true; }
    if (c >= 0x3041 && c <= 0x3096) { return true; }
    if (c >= 0x30A1 && c <= 0x30FA) { return true; }
    if (c >= 0x3400 && c <= 0x4DBF) { return true; }
    if (c >= 0x4E00 && c <= 0x9FFF) { return true; }
    if (c >= 0xAC00 && c <= 0xD7A3) { return true; }
    if (c >= 0xFF21 && c <= 0xFF3A) { return true; }
    if (c >= 0xFF41 && c <= 0xFF5A) { return true; }
    if (c >= 0x20000 && c <= 0x2FA1F) { return true; }
    return false;
}

bool iswdigit(int c) {
    return c >= '0' && c <= '9';
}

bool iswxdigit(int c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

bool iswalnum(int c) {
    return iswalpha(c) || iswdigit(c);
}

bool iswspace(int c) {
    return c == ' ' || (c >= 9 && c <= 13) || c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000;
}

bool iswblank(int c) {
    return c == ' ' || c == 9 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x202F || c == 0x205F || c == 0x3000;
}

bool iswcntrl(int c) {
    return (c >= 0 && c < 32) || (c >= 127 && c < 160) || c == 0x2028 || c == 0x2029;
}

bool iswprint(int c) {
    if (c < 32 || (c >= 127 && c < 160)) { return false; }
    if (c == 0x2028 || c == 0x2029) { return false; }
    if (c >= 0xD800 && c <= 0xDFFF) { return false; }
    return c <= 0x10FFFF;
}

bool iswgraph(int c) {
    return iswprint(c) && !iswspace(c);
}

bool iswpunct(int c) {
    return iswgraph(c) && !iswalnum(c);
}

// ---- case mapping -----------------------------------------------------------------------------------------------------
int towupper(int c) {
    if (c < 128) {
        if (c >= 'a' && c <= 'z') { return c - 32; }
        return c;
    }
    if (c == 0xB5) { return 0x39C; }
    if (c >= 0xE0 && c <= 0xFE && c != 0xF7) { return c - 32; }
    if (c == 0xFF) { return 0x178; }
    if (c >= 0x100 && c <= 0x137) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c >= 0x139 && c <= 0x148) { if ((c & 1) == 0) { return c - 1; } return c; }
    if (c >= 0x14A && c <= 0x177) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c == 0x17A || c == 0x17C || c == 0x17E) { return c - 1; }
    if (c == 0x17F) { return 'S'; }
    if (c >= 0x3B1 && c <= 0x3CB && c != 0x3C2) { return c - 32; }
    if (c == 0x3C2) { return 0x3A3; }
    if (c == 0x3AC) { return 0x386; }
    if (c >= 0x3AD && c <= 0x3AF) { return c - 37; }
    if (c == 0x3CC) { return 0x38C; }
    if (c == 0x3CD || c == 0x3CE) { return c - 63; }
    if (c >= 0x430 && c <= 0x44F) { return c - 32; }
    if (c >= 0x450 && c <= 0x45F) { return c - 80; }
    if (c >= 0x460 && c <= 0x481) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c >= 0x48A && c <= 0x4BF) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c >= 0x4D0 && c <= 0x52F) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c >= 0x561 && c <= 0x586) { return c - 48; }
    if (c >= 0x1E00 && c <= 0x1EFF) { if ((c & 1) == 1) { return c - 1; } return c; }
    if (c >= 0xFF41 && c <= 0xFF5A) { return c - 32; }
    return c;
}

int towlower(int c) {
    if (c < 128) {
        if (c >= 'A' && c <= 'Z') { return c + 32; }
        return c;
    }
    if (c >= 0xC0 && c <= 0xDE && c != 0xD7) { return c + 32; }
    if (c == 0x178) { return 0xFF; }
    if (c >= 0x100 && c <= 0x137) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c >= 0x139 && c <= 0x148) { if ((c & 1) == 1) { return c + 1; } return c; }
    if (c >= 0x14A && c <= 0x177) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c == 0x179 || c == 0x17B || c == 0x17D) { return c + 1; }
    if (c >= 0x391 && c <= 0x3AB && c != 0x3A2) { return c + 32; }
    if (c == 0x386) { return 0x3AC; }
    if (c >= 0x388 && c <= 0x38A) { return c + 37; }
    if (c == 0x38C) { return 0x3CC; }
    if (c == 0x38E || c == 0x38F) { return c + 63; }
    if (c >= 0x410 && c <= 0x42F) { return c + 32; }
    if (c >= 0x400 && c <= 0x40F) { return c + 80; }
    if (c >= 0x460 && c <= 0x481) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c >= 0x48A && c <= 0x4BF) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c >= 0x4D0 && c <= 0x52F) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c >= 0x531 && c <= 0x556) { return c + 48; }
    if (c >= 0x1E00 && c <= 0x1EFF) { if ((c & 1) == 0) { return c + 1; } return c; }
    if (c >= 0xFF21 && c <= 0xFF3A) { return c + 32; }
    return c;
}

// ---- display width (columns in a terminal) -------------------------------------------------------------------------------
// -1 for control characters, 0 for combining marks, 2 for wide (CJK, emoji) characters, otherwise 1
int wcwidth(int c) {
    if (c == 0) { return 0; }
    if (c < 32 || (c >= 0x7F && c < 0xA0)) { return -1; }
    if ((c >= 0x300 && c <= 0x36F) || (c >= 0x200B && c <= 0x200F) || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0x20D0 && c <= 0x20FF) || c == 0xFEFF) { return 0; }
    if ((c >= 0x1100 && c <= 0x115F) || (c >= 0x2E80 && c <= 0x303E) || (c >= 0x3041 && c <= 0xA4CF) || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF) || (c >= 0xFE30 && c <= 0xFE6F) || (c >= 0xFF00 && c <= 0xFF60) || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F) || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)) {
        return 2;
    }
    return 1;
}

// columns used by the first n characters of s (-1 if one of them is a control character)
int wcswidth(int* s, int n) {
    int w = 0;
    for (int i = 0; i < n && s[i] != 0; i++) {
        int cw = wcwidth(s[i]);
        if (cw < 0) {
            return -1;
        }
        w = w + cw;
    }
    return w;
}
