// =============================================================================
//  clib - the C standard library, all headers at once                   import clib;
//
//  Imports every C-style module (the names go into the global namespace, as in C):
//    cctype    <ctype.h>     isalpha isdigit toupper ...
//    climits   <limits.h> <stdint.h> <stddef.h>      INT_MAX UINT32_MAX NULL ...
//    cerrno    <errno.h>     errno strerror perror
//    cassert   <assert.h>    assert
//    cstring   <string.h>    memmove strchr strstr strtok strncpy ...
//    cstdlib   <stdlib.h>    malloc free realloc strtol getenv system ...
//    cstdio    <stdio.h>     FILE fopen fclose fgets fprintf sscanf popen ...
//    ctime     <time.h>      time localtime strftime mktime ...
//    cunistd   <unistd.h> <sys/stat.h> <dirent.h> <fcntl.h> <signal.h> <fnmatch.h>   getpid stat opendir getopt signal ...
//    cmath     <math.h> <float.h>     sqrt sin pow floor ... (a double is an int holding its bit pattern)
//    cfloat    strtod dtostr printfd ...    text <-> double and printf with %f %e %g
//    clocale   <locale.h>    setlocale localeconv
//    cwchar    <wchar.h> <wctype.h>   wcslen wcscpy towupper iswalpha wcwidth ...
//  (setjmp / longjmp are built into the language; errno, assert and the limits are in their modules.)
//  Using just the modules you need keeps programs smaller.
// =============================================================================
import cctype;
import climits;
import cerrno;
import cassert;
import cstring;
import cstdlib;
import cstdio;
import ctime;
import cunistd;
import cmath;
import cfloat;
import clocale;
import cwchar;
