// =============================================================================
//  strings - text building and manipulation                 import strings;
//  All functions return NEW heap strings and leave their arguments alone
//  (unless the text says otherwise).
// =============================================================================
module strings;

// builds a string piece by piece:
//   strings.StringBuilder sb;  sb.append("x = "); sb.appendInt(42); println(sb.view());
public class StringBuilder {
    private char* buf;
    private int len;
    private int cap;

    private void reserve(int extra) {
        if (len + extra + 1 <= cap) {
            return;
        }
        int ncap = cap * 2;
        if (ncap < 32) {
            ncap = 32;
        }
        while (ncap < len + extra + 1) {
            ncap = ncap * 2;
        }
        char* nb = alloc(ncap);
        memcpy(nb, buf, len);
        buf = nb;
        cap = ncap;
    }

    public void append(char* s) {
        int n = strlen(s);
        reserve(n);
        memcpy(&buf[len], s, n);
        len = len + n;
        buf[len] = 0;
    }

    public void appendChar(char c) {
        reserve(1);
        buf[len] = c;
        len++;
        buf[len] = 0;
    }

    public void appendInt(int n) {
        char tmp[24];
        intToStr(n, tmp);
        append(tmp);
    }

    public int length() { return len; }

    public void clear() {
        len = 0;
        if (cap > 0) {
            buf[0] = 0;
        }
    }

    // the current text; points into the builder and changes when more is appended
    public char* view() {
        if (cap == 0) {
            return "";
        }
        return buf;
    }

    // an independent copy of the text
    public char* toString() {
        if (cap == 0) {
            return "";
        }
        return strdup(buf);
    }
}

public char* concat(char* a, char* b) {
    int n = strlen(a);
    int m = strlen(b);
    char* p = alloc(n + m + 1);
    memcpy(p, a, n);
    memcpy(&p[n], b, m);
    return p;
}

// s repeated n times
public char* repeat(char* s, int n) {
    int len = strlen(s);
    char* p = alloc(len * n + 1);
    for (int i = 0; i < n; i++) {
        memcpy(&p[i * len], s, len);
    }
    return p;
}

public char* reverse(char* s) {
    int n = strlen(s);
    char* p = alloc(n + 1);
    for (int i = 0; i < n; i++) {
        p[i] = s[n - 1 - i];
    }
    return p;
}

// number of (non overlapping) occurrences of sub in s
public int count(char* s, char* sub) {
    int m = strlen(sub);
    if (m == 0) {
        return 0;
    }
    int n = 0;
    int pos = 0;
    for (;;) {
        int at = find(&s[pos], sub);
        if (at < 0) {
            return n;
        }
        n++;
        pos = pos + at + m;
    }
    return n;
}

public int lastIndexOf(char* s, int c) {
    int r = -1;
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == c) {
            r = i;
        }
    }
    return r;
}

// replaces every occurrence of from with to
public char* replace(char* s, char* from, char* to) {
    int fl = strlen(from);
    int tl = strlen(to);
    if (fl == 0) {
        return strdup(s);
    }
    int occurrences = count(s, from);
    char* p = alloc(strlen(s) + occurrences * (tl - fl) + 1);
    int o = 0;
    int i = 0;
    while (s[i] != 0) {
        bool match = true;
        for (int k = 0; k < fl; k++) {
            if (s[i + k] != from[k]) {
                match = false;
                break;
            }
        }
        if (match) {
            memcpy(&p[o], to, tl);
            o = o + tl;
            i = i + fl;
        } else {
            p[o] = s[i];
            o++;
            i++;
        }
    }
    return p;
}

// pads on the left up to width characters with fill (a character such as ' ' or '0')
public char* padLeft(char* s, int width, int fill) {
    int n = strlen(s);
    if (n >= width) {
        return strdup(s);
    }
    char* p = alloc(width + 1);
    for (int i = 0; i < width - n; i++) {
        p[i] = fill;
    }
    memcpy(&p[width - n], s, n);
    return p;
}

public char* padRight(char* s, int width, int fill) {
    int n = strlen(s);
    if (n >= width) {
        return strdup(s);
    }
    char* p = alloc(width + 1);
    memcpy(p, s, n);
    for (int i = n; i < width; i++) {
        p[i] = fill;
    }
    return p;
}

public bool isBlank(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        if (!isSpace(s[i])) {
            return false;
        }
    }
    return true;
}

public char* capitalize(char* s) {
    char* p = strdup(s);
    p[0] = toUpper(p[0]);
    return p;
}

public char* upper(char* s) {
    char* p = strdup(s);
    strUpper(p);
    return p;
}

public char* lower(char* s) {
    char* p = strdup(s);
    strLower(p);
    return p;
}

// splits s at every sep character into at most max new strings stored in out; returns how many
public int split(char* s, int sep, char** out, int max) {
    int n = 0;
    int start = 0;
    int i = 0;
    for (;;) {
        if (s[i] == sep || s[i] == 0) {
            if (n < max) {
                out[n] = substr(s, start, i - start);
                n++;
            }
            if (s[i] == 0) {
                break;
            }
            start = i + 1;
        }
        i++;
    }
    return n;
}

// joins n strings with sep between them
public char* join(char** parts, int n, char* sep) {
    int total = 1;
    int sl = strlen(sep);
    for (int i = 0; i < n; i++) {
        total = total + strlen(parts[i]) + sl;
    }
    char* p = alloc(total);
    int o = 0;
    for (int i = 0; i < n; i++) {
        if (i > 0) {
            memcpy(&p[o], sep, sl);
            o = o + sl;
        }
        int l = strlen(parts[i]);
        memcpy(&p[o], parts[i], l);
        o = o + l;
    }
    return p;
}
