// =============================================================================
//  dmath - mathematics for the type double                              import dmath;
//
//    dmath.sqrt(x)  cbrt  pow(x, y)  exp  exp2  expm1  log  log2  log10  log1p  hypot
//    dmath.sin cos tan asin acos atan atan2(y, x)  sinh cosh tanh asinh acosh atanh
//    dmath.floor ceil round trunc fabs fmod fmin fmax copysign
//    dmath.PI  E  TAU  SQRT2  LN2  LN10  INFINITY  EPSILON,  dmath.nan()
//
//  These are the C library's functions, written for double values: they call the (correctly rounded, soft-float) functions of
//  the cmath module, so the results are the same on every CPU. Use `double x = dmath.sqrt(2);`.
// =============================================================================
import cmath;
module dmath;

public const PI = 3.141592653589793;
public const E = 2.718281828459045;
public const TAU = 6.283185307179586;
public const SQRT2 = 1.4142135623730951;
public const LN2 = 0.6931471805599453;
public const LN10 = 2.302585092994046;
public const EPSILON = 2.220446049250313e-16;
public const INFINITY = 1.0e999;                   // too big for a double: infinity

// not a number
public double nan() { return __dbl(0x7FF8000000000000); }

public double sqrt(double x) { return __dbl(::sqrt(__bits(x))); }
public double cbrt(double x) { return __dbl(::cbrt(__bits(x))); }
public double pow(double x, double y) { return __dbl(::pow(__bits(x), __bits(y))); }
public double exp(double x) { return __dbl(::exp(__bits(x))); }
public double exp2(double x) { return __dbl(::exp2(__bits(x))); }
public double expm1(double x) { return __dbl(::expm1(__bits(x))); }
public double log(double x) { return __dbl(::log(__bits(x))); }
public double log2(double x) { return __dbl(::log2(__bits(x))); }
public double log10(double x) { return __dbl(::log10(__bits(x))); }
public double log1p(double x) { return __dbl(::log1p(__bits(x))); }
public double hypot(double x, double y) { return __dbl(::hypot(__bits(x), __bits(y))); }
public double sin(double x) { return __dbl(::sin(__bits(x))); }
public double cos(double x) { return __dbl(::cos(__bits(x))); }
public double tan(double x) { return __dbl(::tan(__bits(x))); }
public double asin(double x) { return __dbl(::asin(__bits(x))); }
public double acos(double x) { return __dbl(::acos(__bits(x))); }
public double atan(double x) { return __dbl(::atan(__bits(x))); }
public double atan2(double y, double x) { return __dbl(::atan2(__bits(y), __bits(x))); }
public double sinh(double x) { return __dbl(::sinh(__bits(x))); }
public double cosh(double x) { return __dbl(::cosh(__bits(x))); }
public double tanh(double x) { return __dbl(::tanh(__bits(x))); }
public double asinh(double x) { return __dbl(::asinh(__bits(x))); }
public double acosh(double x) { return __dbl(::acosh(__bits(x))); }
public double atanh(double x) { return __dbl(::atanh(__bits(x))); }
public double floor(double x) { return __dbl(::floor(__bits(x))); }
public double ceil(double x) { return __dbl(::ceil(__bits(x))); }
public double round(double x) { return __dbl(::round(__bits(x))); }
public double trunc(double x) { return __dbl(::trunc(__bits(x))); }
public double fabs(double x) { return __dbl(::fabs(__bits(x))); }
public double fmod(double x, double y) { return __dbl(::fmod(__bits(x), __bits(y))); }
public double fmin(double x, double y) { return __dbl(::fmin(__bits(x), __bits(y))); }
public double fmax(double x, double y) { return __dbl(::fmax(__bits(x), __bits(y))); }
public double copysign(double x, double y) { return __dbl(::copysign(__bits(x), __bits(y))); }
