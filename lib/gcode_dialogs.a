//  gcode_dialogs - the colour picker, the theme editor and the settings dialog
//  (part of the module gcode: use  import gcode;)
//
//    gcode.ColorPicker* cp = new gcode.ColorPicker();       // HSV square + hue bar + RGB / HSV sliders + hex field + swatches
//    cp->setColor(0x3C78D8);  cp->onChange = picked;          // int picked(int picker): cp->color is 0xRRGGBB
//    gcode.ThemeEditor* te = new gcode.ThemeEditor();         // every colour and token style, live preview, load / save / duplicate / delete
//    te->show(display);                                       // changes reach every open editor at once (te->live)
//    gcode.SettingsDialog* sd = new gcode.SettingsDialog(settings);   // tab width, spaces / tabs, line numbers, wrap, font ...
//    sd->show(display);
