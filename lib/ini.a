// =============================================================================
//  ini - configuration files in the INI format                                                                  import ini;
//
//    ini.Ini* c = ini.parse("[server]\nport = 8080\nname = \"my site\"  ; comment\n");
//    c->get("server", "port", "80")            // "8080" (the last argument is returned when the key is missing)
//    c->getInt("server", "port", 80)           // 8080
//    c->getBool("server", "debug", false)      // true for true/yes/on/1, false for false/no/off/0
//    c->set("server", "port", "9090");         // adds or replaces
//    char* text = c->toString();               // written back as INI text (a new string)
//    ini.load("app.ini")                       // from a file; null if it cannot be read
//
//  Lines starting with ; or # are comments, so is everything after " ;" or " #" on a value line. Values may be put in double
//  quotes to keep spaces, ';' and '#'. Keys before the first [section] are in the section "". Names are case-sensitive.
// =============================================================================
import cstdlib;
import cstring;
import cstdio;
module ini;

public class Ini {
    public char** sections;
    public char** keys;
    public char** values;
    public int count;
    private int cap;

    public Ini() {
        cap = 16;
        count = 0;
        sections = malloc(cap * 8);
        keys = malloc(cap * 8);
        values = malloc(cap * 8);
    }

    private int find(char* section, char* key) {
        for (int i = 0; i < count; i++) {
            if (strcmp(sections[i], section) == 0 && strcmp(keys[i], key) == 0) { return i; }
        }
        return -1;
    }

    public bool has(char* section, char* key) {
        return find(section, key) >= 0;
    }

    public char* get(char* section, char* key, char* fallback) {
        int i = find(section, key);
        return (i < 0) ? fallback : values[i];
    }

    public int getInt(char* section, char* key, int fallback) {
        int i = find(section, key);
        if (i < 0) { return fallback; }
        char* v = values[i];
        int k = 0;
        int sign = 1;
        if (v[0] == '-') { sign = -1; k = 1; }
        if (v[k] < '0' || v[k] > '9') { return fallback; }
        int n = 0;
        while (v[k] >= '0' && v[k] <= '9') {
            n = n * 10 + (v[k] - '0');
            k++;
        }
        return n * sign;
    }

    public bool getBool(char* section, char* key, bool fallback) {
        int i = find(section, key);
        if (i < 0) { return fallback; }
        char* v = values[i];
        if (strcmp(v, "true") == 0 || strcmp(v, "yes") == 0 || strcmp(v, "on") == 0 || strcmp(v, "1") == 0) { return true; }
        if (strcmp(v, "false") == 0 || strcmp(v, "no") == 0 || strcmp(v, "off") == 0 || strcmp(v, "0") == 0) { return false; }
        return fallback;
    }

    private char* dup(char* s) {
        int n = strlen(s);
        char* r = malloc(n + 1);
        memcpy(r, s, n + 1);
        return r;
    }

    public void set(char* section, char* key, char* value) {
        int i = find(section, key);
        if (i >= 0) {
            values[i] = dup(value);
            return;
        }
        if (count == cap) {
            cap = cap * 2;
            sections = realloc(sections, cap * 8);
            keys = realloc(keys, cap * 8);
            values = realloc(values, cap * 8);
        }
        sections[count] = dup(section);
        keys[count] = dup(key);
        values[count] = dup(value);
        count++;
    }

    public bool remove(char* section, char* key) {
        int i = find(section, key);
        if (i < 0) { return false; }
        for (int j = i; j + 1 < count; j++) {
            sections[j] = sections[j + 1];
            keys[j] = keys[j + 1];
            values[j] = values[j + 1];
        }
        count--;
        return true;
    }

    // the keys of one section are written together, in the order they first appeared
    public char* toString() {
        int total = 64;
        for (int i = 0; i < count; i++) {
            total = total + strlen(sections[i]) + strlen(keys[i]) + strlen(values[i]) + 16;
        }
        char* out = malloc(total);
        int o = 0;
        for (int i = 0; i < count; i++) {
            bool first = true;
            for (int j = 0; j < i; j++) {
                if (strcmp(sections[j], sections[i]) == 0) { first = false; break; }
            }
            if (!first) { continue; }
            if (sections[i][0] != 0) {
                o = o + sprintf(&out[o], "[%s]\n", sections[i]);
            }
            for (int j = i; j < count; j++) {
                if (strcmp(sections[j], sections[i]) != 0) { continue; }
                char* v = values[j];
                bool quote = false;
                for (int k = 0; v[k] != 0; k++) {
                    if (v[k] == ';' || v[k] == '#' || v[k] == '"') { quote = true; }
                }
                if (v[0] == ' ' || (v[0] != 0 && v[strlen(v) - 1] == ' ')) { quote = true; }
                if (quote) {
                    o = o + sprintf(&out[o], "%s = \"%s\"\n", keys[j], v);
                } else {
                    o = o + sprintf(&out[o], "%s = %s\n", keys[j], v);
                }
            }
            o = o + sprintf(&out[o], "\n");
        }
        out[o] = 0;
        return out;
    }
}

private char* trimmed(char* s, int from, int to) {
    while (from < to && (s[from] == ' ' || s[from] == '\t' || s[from] == '\r')) { from++; }
    while (to > from && (s[to - 1] == ' ' || s[to - 1] == '\t' || s[to - 1] == '\r')) { to--; }
    char* r = malloc(to - from + 1);
    memcpy(r, &s[from], to - from);
    r[to - from] = 0;
    return r;
}

public Ini* parse(char* text) {
    Ini* c = new Ini();
    char* section = "";
    int n = strlen(text);
    int p = 0;
    while (p < n) {
        int e = p;
        while (e < n && text[e] != '\n') { e++; }
        int a = p;
        p = e + 1;
        while (a < e && (text[a] == ' ' || text[a] == '\t')) { a++; }
        if (a >= e || text[a] == ';' || text[a] == '#') { continue; }
        if (text[a] == '[') {
            int close = a + 1;
            while (close < e && text[close] != ']') { close++; }
            section = trimmed(text, a + 1, close);
            continue;
        }
        int eq = a;
        while (eq < e && text[eq] != '=') { eq++; }
        if (eq >= e) { continue; }
        char* key = trimmed(text, a, eq);
        int vs = eq + 1;
        while (vs < e && (text[vs] == ' ' || text[vs] == '\t')) { vs++; }
        char* value;
        if (vs < e && text[vs] == '"') {
            int q = vs + 1;
            while (q < e && text[q] != '"') { q++; }
            value = trimmed(text, vs + 1, q);
        } else {
            int ve = e;
            for (int i = vs; i < e; i++) {
                if ((text[i] == ';' || text[i] == '#') && i > vs && (text[i - 1] == ' ' || text[i - 1] == '\t')) { ve = i; break; }
            }
            value = trimmed(text, vs, ve);
        }
        c->set(section, key, value);
    }
    return c;
}

public Ini* load(char* path) {
    FILE* f = fopen(path, "rb");
    if (f == null) { return null; }
    int cap = 4096;
    int len = 0;
    char* buf = malloc(cap);
    for (;;) {
        int got = fread(&buf[len], 1, cap - len - 1, f);
        if (got <= 0) { break; }
        len = len + got;
        if (len + 1 >= cap) {
            cap = cap * 2;
            buf = realloc(buf, cap);
        }
    }
    fclose(f);
    buf[len] = 0;
    return parse(buf);
}
