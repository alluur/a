// =============================================================================
//  fixed - fixed-point numbers (Q20.20) for fast real arithmetic        import fixed;
//
//  A has no floating point type. A fixed-point number is an int that holds value * 2^20:
//  1.0 is `fixed.ONE` (1048576), the resolution is about 0.000001 and the range is +-2048
//  for products (a*b must stay below 2^62). Addition and subtraction are the plain + and -;
//  everything else is a function:
//
//     int a = fixed.fromText("2.5");        int b = fixed.fromInt(3);
//     int c = fixed.mul(a, b);              fixed.putln(c, 3);     // 7.500
//     int s = fixed.sigmoid(fixed.fromText("0.5"));
//
//  This is the number type of the nn and codec modules (neural networks).
// =============================================================================
module fixed;

public const FB = 20;                    // fraction bits
public const ONE = 1048576;              // 1.0
public const HALF = 524288;              // 0.5
public const LN2 = 726817;               // ln 2
public const PI = 3294199;               // pi
public const E = 2850325;                // e

// ---- conversion -------------------------------------------------------------------------------------------------------
public int fromInt(int n) { return n << FB; }
// integer part, rounded towards minus infinity
public int toInt(int x) { return x >> FB; }
// a / b as a fixed-point number
public int ratio(int a, int b) { return (a << FB) / b; }
// an integer part and a number of millionths: fromParts(3, 141593) = 3.141593
public int fromParts(int whole, int millionths) {
    if (whole < 0) {
        return (whole << FB) - ((millionths << FB) / 1000000);
    }
    return (whole << FB) + ((millionths << FB) / 1000000);
}

// "3.25", "-0.5", ".75", "12" -> fixed point (extra digits are rounded away, garbage ends the number)
public int fromText(char* s) {
    int i = 0;
    bool neg = false;
    if (s[i] == '-') { neg = true; i++; } else if (s[i] == '+') { i++; }
    int whole = 0;
    while (isDigit(s[i])) {
        whole = whole * 10 + (s[i] - '0');
        i++;
    }
    int frac = 0;
    int scale = 1;
    if (s[i] == '.') {
        i++;
        while (isDigit(s[i]) && scale < 1000000000000) {
            frac = frac * 10 + (s[i] - '0');
            scale = scale * 10;
            i++;
        }
    }
    int r = (whole << FB) + (((frac << FB) + scale / 2) / scale);
    if (neg) {
        return -r;
    }
    return r;
}

// writes the number with `decimals` digits after the point into buf; returns buf
public char* toText(int x, int decimals, char* buf) {
    int o = 0;
    if (x < 0) {
        buf[o] = '-';
        o++;
        x = -x;
    }
    int p10 = 1;
    for (int i = 0; i < decimals; i++) {
        p10 = p10 * 10;
    }
    // round to the wanted number of decimals
    int scaled = ((x * p10) + HALF) >> FB;
    int whole = scaled / p10;
    int frac = scaled % p10;
    char tmp[24];
    intToStr(whole, &tmp[0]);
    int k = 0;
    while (tmp[k] != 0) {
        buf[o] = tmp[k];
        o++;
        k++;
    }
    if (decimals > 0) {
        buf[o] = '.';
        o++;
        for (int d = decimals - 1; d >= 0; d--) {
            int q = 1;
            for (int j = 0; j < d; j++) {
                q = q * 10;
            }
            buf[o] = '0' + (frac / q) % 10;
            o++;
        }
    }
    buf[o] = 0;
    return buf;
}

// prints with 6 decimals, no newline (put) or with `decimals` decimals and a newline (putln)
public void put(int x) {
    char buf[40];
    print(toText(x, 6, &buf[0]));
}

public void putln(int x, int decimals) {
    char buf[40];
    println(toText(x, decimals, &buf[0]));
}

// ---- arithmetic ---------------------------------------------------------------------------------------------------------
public int mul(int a, int b) { return (a * b + HALF) >> FB; }
public int div(int a, int b) { return (a << FB) / b; }
public int abs(int x) { if (x < 0) return -x; return x; }
public int min(int a, int b) { if (a < b) return a; return b; }
public int max(int a, int b) { if (a > b) return a; return b; }
public int clamp(int x, int lo, int hi) { if (x < lo) return lo; if (x > hi) return hi; return x; }
public int sign(int x) { if (x < 0) return -1; if (x > 0) return 1; return 0; }
public int floor(int x) { return (x >> FB) << FB; }
public int round(int x) { return ((x + HALF) >> FB) << FB; }

// square root (0 for negative numbers)
public int sqrt(int x) {
    if (x <= 0) {
        return 0;
    }
    // integer square root of x * 2^20 by bit-by-bit method (x < 2^42)
    int n = x << FB;
    int res = 0;
    int bit = 1 << 62;
    while (bit > n) {
        bit = bit >> 2;
    }
    while (bit != 0) {
        if (n >= res + bit) {
            n = n - (res + bit);
            res = (res >> 1) + bit;
        } else {
            res = res >> 1;
        }
        bit = bit >> 2;
    }
    return res;
}

// e^x (x is limited to +-25)
public int exp(int x) {
    if (x > 25 * ONE) {
        x = 25 * ONE;
    }
    if (x < -25 * ONE) {
        return 0;
    }
    // x = k ln2 + r, |r| <= ln2 / 2
    int k = (x + (x < 0 ? -(LN2 / 2) : LN2 / 2)) / LN2;
    int r = x - k * LN2;
    int term = ONE;
    int sum = ONE;
    for (int i = 1; i <= 8; i++) {
        term = mul(term, r) / i;
        sum = sum + term;
    }
    if (k >= 0) {
        return sum << k;
    }
    return sum >> (-k);
}

// natural logarithm (x > 0; returns -25.0 for x <= 0)
public int log(int x) {
    if (x <= 0) {
        return -25 * ONE;
    }
    int k = 0;
    while (x >= 2 * ONE) {
        x = x >> 1;
        k++;
    }
    while (x < ONE) {
        x = x << 1;
        k--;
    }
    int z = div(x - ONE, x + ONE);
    int z2 = mul(z, z);
    int term = z;
    int sum = 0;
    for (int i = 1; i <= 13; i = i + 2) {
        sum = sum + term / i;
        term = mul(term, z2);
    }
    return k * LN2 + 2 * sum;
}

// x^y for x > 0
public int pow(int x, int y) {
    return exp(mul(y, log(x)));
}

// sine and cosine (radians)
public int sin(int x) {
    int twopi = 2 * PI;
    x = x % twopi;
    if (x > PI) {
        x = x - twopi;
    }
    if (x < -PI) {
        x = x + twopi;
    }
    // fold into [-pi/2, pi/2]
    if (x > PI / 2) {
        x = PI - x;
    }
    if (x < -(PI / 2)) {
        x = -PI - x;
    }
    int x2 = mul(x, x);
    int term = x;
    int sum = x;
    for (int i = 1; i <= 6; i++) {
        term = -mul(term, x2) / ((2 * i) * (2 * i + 1));
        sum = sum + term;
    }
    return sum;
}

public int cos(int x) {
    return sin(x + PI / 2);
}

// ---- activation functions (and their derivatives, given the OUTPUT of the function) ----------------------------------------
public int sigmoid(int x) {
    if (x > 16 * ONE) { x = 16 * ONE; }
    if (x < -16 * ONE) { x = -16 * ONE; }
    return div(ONE, ONE + exp(-x));
}

public int tanh(int x) {
    return 2 * sigmoid(2 * x) - ONE;
}

public int relu(int x) {
    if (x < 0) return 0;
    return x;
}

// ---- random numbers ----------------------------------------------------------------------------------------------------------
private int rngState = 88172645463325252;

public void seed(int s) {
    if (s == 0) {
        s = 88172645463325252;
    }
    rngState = s;
    for (int i = 0; i < 8; i++) {
        next();
    }
}

// a non-negative 55 bit pseudo random number (xorshift64)
public int next() {
    int x = rngState;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    rngState = x;
    return (x >> 8) & 0x7FFFFFFFFFFFFF;
}

// uniform in [0, 1)
public int rand() {
    return next() & (ONE - 1);
}

// uniform in [lo, hi)
public int randRange(int lo, int hi) {
    return lo + mul(rand(), hi - lo);
}

// approximately normal (mean 0, standard deviation 1): sum of 12 uniform numbers minus 6
public int gauss() {
    int s = 0;
    for (int i = 0; i < 12; i++) {
        s = s + rand();
    }
    return s - 6 * ONE;
}
