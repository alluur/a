// =============================================================================
//  fmath - fast mathematics for double (and float) on the FPU                    import fmath;
//
//    fmath.sin cos tan asin acos atan atan2(y, x)  exp exp2 log log2 log10 pow(x, y)  sqrt cbrt hypot
//    fmath.sinh cosh tanh  floor ceil trunc round fabs fmod(x, y) copysign fmin fmax  scalbn(x, n)
//    fmath.isNaN isInf isFinite  radians degrees clamp lerp  PI TAU HALF_PI E LN2 INFINITY  fmath.nan()
//
//  The algorithms and coefficients are those of fdlibm / musl (Sun Microsystems: "Permission to use, copy, modify, and
//  distribute this software is freely granted, provided that this notice is preserved"; musl: MIT). Only +, -, *, / and the
//  correctly rounded square root are used, never fused multiply-add, so a result is the same on every CPU (and with
//  --soft-float). Accuracy: sin cos tan asin acos atan atan2 exp log within 1 ulp; log2 log10 exp2 cbrt hypot sinh cosh tanh
//  within a few ulp; pow within 2 ulp (exp of y * log(x) computed with extra precision; integer powers up to 64 are
//  products). sqrt, floor, ceil, trunc, round, fabs, fmod, copysign, scalbn are exact.
//  A NaN that a function makes (sin(infinity), sqrt(-1), fmod(x, 0) ...) is the same quiet NaN on every CPU; a NaN argument
//  comes back as the CPU passes it on. dmath has the correctly rounded versions (much slower: they run in software). For |x| beyond about 1.6 million, sin, cos
//  and tan use them too (fdlibm's large argument reduction is not repeated here).
//
//     import fmath;
//     double a = fmath.atan2(dy, dx);
//     float s = fmath.sin(angle);          // floats are converted: the function works in double
// =============================================================================
import cmath;
module fmath;

public const PI = 3.141592653589793;
public const TAU = 6.283185307179586;
public const HALF_PI = 1.5707963267948966;
public const E = 2.718281828459045;
public const LN2 = 0.6931471805599453;
public const INFINITY = 1.0e999;

public double nan() { return __dbl(0x7FF8000000000000); }
public bool isNaN(double x) { return x != x; }
public bool isInf(double x) { return (__bits(x) & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000; }
public bool isFinite(double x) { return (__bits(x) & 0x7FF0000000000000) != 0x7FF0000000000000; }

// the high 32 bits of a double (sign, exponent, top of the mantissa) as a non-negative int
int hiword(double x) { return (__bits(x) >> 32) & 0xFFFFFFFF; }
// x with its low 32 bits cleared
double clearLow(double x) { return __dbl(__bits(x) & 0xFFFFFFFF00000000); }

public double fabs(double x) { return __dbl(__bits(x) & 0x7FFFFFFFFFFFFFFF); }
public double copysign(double x, double y) {
    return __dbl((__bits(x) & 0x7FFFFFFFFFFFFFFF) | (__bits(y) & 0x8000000000000000));
}
public double sqrt(double x) {
    if (x < 0.0) return nan();                           // (the same NaN on every CPU)
    return __sqrt(x);
}
public double fmin(double a, double b) { if (a != a) return b; if (b != b) return a; return a < b ? a : b; }
public double fmax(double a, double b) { if (a != a) return b; if (b != b) return a; return a > b ? a : b; }
public double clamp(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }
public double lerp(double a, double b, double t) { return a + (b - a) * t; }
public double radians(double deg) { return deg * (PI / 180.0); }
public double degrees(double rad) { return rad * (180.0 / PI); }

// ---- rounding ---------------------------------------------------------------------------------------------------------------
public double trunc(double x) {
    double a = fabs(x);
    if (!(a < 4503599627370496.0)) return x;            // |x| >= 2^52 (an integer already), infinity or NaN
    return copysign((double)(int) x, x);                // (the sign of -0.5 -> -0.0 is kept)
}
public double floor(double x) {
    double t = trunc(x);
    if (t > x) return t - 1.0;
    return t;
}
public double ceil(double x) {
    double t = trunc(x);
    if (t < x) return copysign(t + 1.0, x);              // ceil(-0.5) = -0.0
    return t;
}
// halfway cases away from zero, like C's round
public double round(double x) {
    double t = trunc(x);
    double d = x - t;                                    // exact
    if (d >= 0.5) return t + 1.0;
    if (d <= -0.5) return t - 1.0;
    return t;
}

// x * 2^n (exact unless the result overflows or is subnormal)
public double scalbn(double x, int n) {
    double y = x;
    if (n > 1023) {
        y = y * __dbl(0x7FE0000000000000);               // 2^1023
        n = n - 1023;
        if (n > 1023) {
            y = y * __dbl(0x7FE0000000000000);
            n = n - 1023;
            if (n > 1023) n = 1023;
        }
    } else if (n < -1022) {
        y = y * __dbl(0x0360000000000000);               // 2^-1022 * 2^53 = 2^-969
        n = n + 1022 - 53;
        if (n < -1022) {
            y = y * __dbl(0x0360000000000000);
            n = n + 1022 - 53;
            if (n < -1022) n = -1022;
        }
    }
    return y * __dbl((0x3FF + n) << 52);
}

// exact remainder of x / y with the sign of x (integer arithmetic on the mantissas, from musl)
public double fmod(double x, double y) {
    uint64_t uxi = __bits(x);
    uint64_t uyi = __bits(y);
    int ex = (uxi >> 52) & 0x7FF;
    int ey = (uyi >> 52) & 0x7FF;
    uint64_t sx = uxi >> 63;
    uint64_t i;
    if (x != x || y != y) return x + y;
    if ((uyi << 1) == 0 || ex == 0x7FF) return nan();   // fmod(x, 0), fmod(infinity, y)
    if ((uxi << 1) <= (uyi << 1)) {
        if ((uxi << 1) == (uyi << 1)) return 0.0 * x;
        return x;
    }
    if (ex == 0) {
        i = uxi << 12;
        while ((i >> 63) == 0) { ex--; i = i << 1; }
        uxi = uxi << (-ex + 1);
    } else {
        uxi = uxi & 0x000FFFFFFFFFFFFF;
        uxi = uxi | 0x0010000000000000;
    }
    if (ey == 0) {
        i = uyi << 12;
        while ((i >> 63) == 0) { ey--; i = i << 1; }
        uyi = uyi << (-ey + 1);
    } else {
        uyi = uyi & 0x000FFFFFFFFFFFFF;
        uyi = uyi | 0x0010000000000000;
    }
    while (ex > ey) {
        i = uxi - uyi;
        if ((i >> 63) == 0) {
            if (i == 0) return 0.0 * x;
            uxi = i;
        }
        uxi = uxi << 1;
        ex--;
    }
    i = uxi - uyi;
    if ((i >> 63) == 0) {
        if (i == 0) return 0.0 * x;
        uxi = i;
    }
    while ((uxi >> 52) == 0) { uxi = uxi << 1; ex--; }
    if (ex > 0) {
        uxi = uxi - 0x0010000000000000;
        uxi = uxi | ((uint64_t) ex << 52);
    } else {
        uxi = uxi >> (-ex + 1);
    }
    uxi = uxi | (sx << 63);
    return __dbl(uxi);
}

// ---- trigonometry -----------------------------------------------------------------------------------------------------------
// kernels on [-pi/4, pi/4]; y is the tail of the reduced argument
double ksin(double x, double y, int iy) {
    double z = x * x;
    double w = z * z;
    double r = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04 + z * 2.75573137070700676789e-06)
             + z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10);
    double v = z * x;
    if (iy == 0) return x + v * (-1.66666666666666324348e-01 + z * r);
    return x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01);
}

double kcos(double x, double y) {
    double z = x * x;
    double w = z * z;
    double r = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03 + z * 2.48015872894767294178e-05))
             + w * w * (-2.75573143513906633035e-07 + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11));
    double hz = 0.5 * z;
    w = 1.0 - hz;
    return w + (((1.0 - w) - hz) + (z * r - x * y));
}

double ktan(double x, double y, int odd) {
    int hx = hiword(x);
    bool big = (hx & 0x7FFFFFFF) >= 0x3FE59428;          // |x| >= 0.6744
    bool sign = false;
    if (big) {
        sign = (hx >> 31) != 0;
        if (sign) { x = -x; y = -y; }
        x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y);
        y = 0.0;
    }
    double z = x * x;
    double w = z * z;
    double r = 1.33333333333201242699e-01 + w * (2.18694882948595424599e-02 + w * (3.59207910759131235356e-03
             + w * (5.88041240820264096874e-04 + w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05))));
    double v = z * (5.39682539762260521377e-02 + w * (8.86323982359930005737e-03 + w * (1.45620945432529025516e-03
             + w * (2.46463134818469906812e-04 + w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)))));
    double s = z * x;
    r = y + z * (s * (r + v) + y) + s * 3.33333333333334091986e-01;
    w = x + r;
    if (big) {
        s = 1 - 2 * odd;
        v = s - 2.0 * (x + (r - w * w / (w + s)));
        return sign ? -v : v;
    }
    if (odd == 0) return w;
    double w0 = clearLow(w);                             // -1 / (x + r), computed accurately
    v = r - (w0 - x);
    double a = -1.0 / w;
    double a0 = clearLow(a);
    return a0 + a * (1.0 + a0 * w0 + a0 * v);
}

// x - n * pi / 2 for |x| < 2^20 * pi / 2 (y[0] + y[1], about 118 or 151 bits); returns n
int remPio2(double x, double* y) {
    double fn = x * 6.36619772367581382433e-01 + 6755399441055744.0 - 6755399441055744.0;   // round(x * 2 / pi)
    int n = (int) fn;
    double r = x - fn * 1.57079632673412561417e+00;
    double w = fn * 6.07710050650619224932e-11;
    double pio4 = 7.85398163397448278999e-01;
    if (r - w < -pio4) {
        n--; fn = fn - 1.0;
        r = x - fn * 1.57079632673412561417e+00;
        w = fn * 6.07710050650619224932e-11;
    } else if (r - w > pio4) {
        n++; fn = fn + 1.0;
        r = x - fn * 1.57079632673412561417e+00;
        w = fn * 6.07710050650619224932e-11;
    }
    y[0] = r - w;
    int ex = (hiword(x) & 0x7FFFFFFF) >> 20;
    int ey = (hiword(y[0]) >> 20) & 0x7FF;
    if (ex - ey > 16) {                                  // second round
        double t = r;
        w = fn * 6.07710050630396597660e-11;
        r = t - w;
        w = fn * 2.02226624879595063154e-21 - ((t - r) - w);
        y[0] = r - w;
        ey = (hiword(y[0]) >> 20) & 0x7FF;
        if (ex - ey > 49) {                              // third round
            t = r;
            w = fn * 2.02226624871116645580e-21;
            r = t - w;
            w = fn * 8.47842766036889956997e-32 - ((t - r) - w);
            y[0] = r - w;
        }
    }
    y[1] = (r - y[0]) - w;
    return n;
}

public double sin(double x) {
    int ix = hiword(x) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {                              // |x| ~< pi/4
        if (ix < 0x3E500000) return x;                   // |x| < 2^-26
        return ksin(x, 0.0, 0);
    }
    if (ix >= 0x7FF00000) return x != x ? x : nan();     // NaN, infinity
    if (ix >= 0x413921FB) return __dbl(::sin(__bits(x)));    // huge: dmath's exact reduction
    double y[2];
    int n = remPio2(x, y);
    int q = n & 3;
    if (q == 0) return ksin(y[0], y[1], 1);
    if (q == 1) return kcos(y[0], y[1]);
    if (q == 2) return -ksin(y[0], y[1], 1);
    return -kcos(y[0], y[1]);
}

public double cos(double x) {
    int ix = hiword(x) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E46A09E) return 1.0;                 // |x| < 2^-27 * sqrt(2)
        return kcos(x, 0.0);
    }
    if (ix >= 0x7FF00000) return x != x ? x : nan();
    if (ix >= 0x413921FB) return __dbl(::cos(__bits(x)));
    double y[2];
    int n = remPio2(x, y);
    int q = n & 3;
    if (q == 0) return kcos(y[0], y[1]);
    if (q == 1) return -ksin(y[0], y[1], 1);
    if (q == 2) return -kcos(y[0], y[1]);
    return ksin(y[0], y[1], 1);
}

public double tan(double x) {
    int ix = hiword(x) & 0x7FFFFFFF;
    if (ix <= 0x3FE921FB) {
        if (ix < 0x3E400000) return x;                   // |x| < 2^-27
        return ktan(x, 0.0, 0);
    }
    if (ix >= 0x7FF00000) return x != x ? x : nan();
    if (ix >= 0x413921FB) return __dbl(::tan(__bits(x)));
    double y[2];
    int n = remPio2(x, y);
    return ktan(y[0], y[1], n & 1);
}

// ---- inverse trigonometry ---------------------------------------------------------------------------------------------------
double asinR(double z) {
    double p = z * (1.66666666666666657415e-01 + z * (-3.25565818622400915405e-01 + z * (2.01212532134862925881e-01
             + z * (-4.00555345006794114027e-02 + z * (7.91534994289814532176e-04 + z * 3.47933107596021167570e-05)))));
    double q = 1.0 + z * (-2.40339491173441421878e+00 + z * (2.02094576023350569471e+00 + z * (-6.88283971605453293030e-01
             + z * 7.70381505559019352791e-02)));
    return p / q;
}

public double asin(double x) {
    double pio2hi = 1.57079632679489655800e+00;
    double pio2lo = 6.12323399573676603587e-17;
    int hx = hiword(x);
    int ix = hx & 0x7FFFFFFF;
    if (ix >= 0x3FF00000) {                              // |x| >= 1 or NaN
        if (ix - 0x3FF00000 == 0 && (__bits(x) & 0xFFFFFFFF) == 0) return x * pio2hi;
        return nan();
    }
    if (ix < 0x3FE00000) {                               // |x| < 0.5
        if (ix < 0x3E500000 && ix >= 0x00100000) return x;
        return x + x * asinR(x * x);
    }
    double z = (1.0 - fabs(x)) * 0.5;
    double s = __sqrt(z);
    double r = asinR(z);
    double res;
    if (ix >= 0x3FEF3333) {                              // |x| > 0.975
        res = pio2hi - (2.0 * (s + s * r) - pio2lo);
    } else {
        double f = clearLow(s);
        double c = (z - f * f) / (s + f);
        res = 0.5 * pio2hi - (2.0 * s * r - (pio2lo - 2.0 * c) - (0.5 * pio2hi - 2.0 * f));
    }
    if ((hx >> 31) != 0) return -res;
    return res;
}

public double acos(double x) {
    double pio2hi = 1.57079632679489655800e+00;
    double pio2lo = 6.12323399573676603587e-17;
    int hx = hiword(x);
    int ix = hx & 0x7FFFFFFF;
    if (ix >= 0x3FF00000) {
        if (ix - 0x3FF00000 == 0 && (__bits(x) & 0xFFFFFFFF) == 0) {
            if ((hx >> 31) != 0) return 2.0 * pio2hi;
            return 0.0;
        }
        return nan();
    }
    if (ix < 0x3FE00000) {                               // |x| < 0.5
        if (ix <= 0x3C600000) return pio2hi;
        return pio2hi - (x - (pio2lo - x * asinR(x * x)));
    }
    if ((hx >> 31) != 0) {                               // x < -0.5
        double z = (1.0 + x) * 0.5;
        double s = __sqrt(z);
        double w = asinR(z) * s - pio2lo;
        return 2.0 * (pio2hi - (s + w));
    }
    double z = (1.0 - x) * 0.5;                          // x > 0.5
    double s = __sqrt(z);
    double df = clearLow(s);
    double c = (z - df * df) / (s + df);
    double w = asinR(z) * s + c;
    return 2.0 * (df + w);
}

public double atan(double x) {
    int hx = hiword(x);
    int ix = hx & 0x7FFFFFFF;
    bool sign = (hx >> 31) != 0;
    if (ix >= 0x44100000) {                              // |x| >= 2^66 or NaN
        if (x != x) return x + x;
        return sign ? -1.57079632679489655800e+00 : 1.57079632679489655800e+00;
    }
    int id;
    if (ix < 0x3FDC0000) {                               // |x| < 0.4375
        if (ix < 0x3E400000) return x;
        id = -1;
    } else {
        x = fabs(x);
        if (ix < 0x3FF30000) {                           // |x| < 1.1875
            if (ix < 0x3FE60000) { id = 0; x = (2.0 * x - 1.0) / (2.0 + x); }
            else { id = 1; x = (x - 1.0) / (x + 1.0); }
        } else {
            if (ix < 0x40038000) { id = 2; x = (x - 1.5) / (1.0 + 1.5 * x); }
            else { id = 3; x = -1.0 / x; }
        }
    }
    double z = x * x;
    double w = z * z;
    double s1 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02
              + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))));
    double s2 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02
              + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))));
    if (id < 0) return x - x * (s1 + s2);
    double hi;
    double lo;
    if (id == 0) { hi = 4.63647609000806093515e-01; lo = 2.26987774529616870924e-17; }
    else if (id == 1) { hi = 7.85398163397448278999e-01; lo = 3.06161699786838301793e-17; }
    else if (id == 2) { hi = 9.82793723247329054082e-01; lo = 1.39033110312309984516e-17; }
    else { hi = 1.57079632679489655800e+00; lo = 6.12323399573676603587e-17; }
    z = hi - (x * (s1 + s2) - lo - x);
    return sign ? -z : z;
}

public double atan2(double y, double x) {
    double pi = 3.1415926535897931160e+00;
    double pilo = 1.2246467991473531772e-16;
    if (x != x || y != y) return x + y;
    int ix = hiword(x);
    int lx = __bits(x) & 0xFFFFFFFF;
    int iy = hiword(y);
    int ly = __bits(y) & 0xFFFFFFFF;
    if (ix - 0x3FF00000 == 0 && lx == 0) return atan(y);                 // x = 1
    int m = ((iy >> 31) & 1) | ((ix >> 30) & 2);                         // 2 * sign(x) + sign(y)
    ix = ix & 0x7FFFFFFF;
    iy = iy & 0x7FFFFFFF;
    if ((iy | ly) == 0) {                                                // y = 0
        if (m <= 1) return y;
        if (m == 2) return pi;
        return -pi;
    }
    if ((ix | lx) == 0) return (m & 1) != 0 ? -pi / 2 : pi / 2;         // x = 0
    if (ix == 0x7FF00000) {                                              // x = +-infinity
        if (iy == 0x7FF00000) {
            if (m == 0) return pi / 4;
            if (m == 1) return -pi / 4;
            if (m == 2) return 3 * pi / 4;
            return -3 * pi / 4;
        }
        if (m == 0) return 0.0;
        if (m == 1) return -0.0;
        if (m == 2) return pi;
        return -pi;
    }
    if (ix + (64 << 20) < iy || iy == 0x7FF00000) return (m & 1) != 0 ? -pi / 2 : pi / 2;
    double z;
    if ((m & 2) != 0 && iy + (64 << 20) < ix) z = 0.0;
    else z = atan(fabs(y / x));
    if (m == 0) return z;
    if (m == 1) return -z;
    if (m == 2) return pi - (z - pilo);
    return (z - pilo) - pi;
}

// ---- exponentials and logarithms --------------------------------------------------------------------------------------------
public double exp(double x) {
    double ln2hi = 6.93147180369123816490e-01;
    double ln2lo = 1.90821492927058770002e-10;
    int hx = hiword(x);
    int sign = (hx >> 31) & 1;
    hx = hx & 0x7FFFFFFF;
    if (hx >= 0x4086232B) {                              // |x| >= 708.39 or NaN
        if (x != x) return x;
        if (x > 709.782712893383973096) return x * __dbl(0x7FE0000000000000);     // overflow (or +infinity)
        if (x < -745.13321910194110842) return 0.0;
    }
    double hi;
    double lo = 0.0;
    int k = 0;
    if (hx > 0x3FD62E42) {                               // |x| > 0.5 ln2
        if (hx >= 0x3FF0A2B2) {                          // |x| >= 1.5 ln2
            k = (int) (1.44269504088896338700e+00 * x + (sign != 0 ? -0.5 : 0.5));
        } else {
            k = 1 - sign - sign;
        }
        hi = x - k * ln2hi;
        lo = k * ln2lo;
        x = hi - lo;
    } else if (hx > 0x3E300000) {                        // |x| > 2^-28
        hi = x;
    } else {
        return 1.0 + x;
    }
    double xx = x * x;
    double c = x - xx * (1.66666666666666019037e-01 + xx * (-2.77777777770155933842e-03 + xx * (6.61375632143793436117e-05
             + xx * (-1.65339022054652515390e-06 + xx * 4.13813679705723846039e-08))));
    double y = 1.0 + (x * c / (2.0 - c) - lo + hi);
    if (k == 0) return y;
    return scalbn(y, k);
}

public double log(double x) {
    uint64_t u = __bits(x);
    int hx = (u >> 32) & 0xFFFFFFFF;
    int k = 0;
    if (hx < 0x00100000 || (hx >> 31) != 0) {
        if ((u << 1) == 0) return -1.0 / 0.0;            // log(+-0) = -infinity
        if ((hx >> 31) != 0) return nan();               // log(negative) = NaN
        k = k - 54;                                      // subnormal: scale it up
        x = x * 18014398509481984.0;                     // 2^54
        u = __bits(x);
        hx = (u >> 32) & 0xFFFFFFFF;
    } else if (hx >= 0x7FF00000) {
        return x;
    } else if (hx == 0x3FF00000 && (u << 32) == 0) {
        return 0.0;
    }
    hx = hx + 0x3FF00000 - 0x3FE6A09E;                   // reduce x into [sqrt(2)/2, sqrt(2)]
    k = k + (hx >> 20) - 0x3FF;
    hx = (hx & 0x000FFFFF) + 0x3FE6A09E;
    x = __dbl((hx << 32) | (u & 0xFFFFFFFF));
    double f = x - 1.0;
    double hfsq = 0.5 * f * f;
    double s = f / (2.0 + f);
    double z = s * s;
    double w = z * z;
    double t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01));
    double t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01
              + w * 1.479819860511658591e-01)));
    double r = t2 + t1;
    double dk = k;
    return s * (hfsq + r) + dk * 1.90821492927058770002e-10 - hfsq + f + dk * 6.93147180369123816490e-01;
}

// ---- extra precision for pow: log(x) as hi + lo (about 63 bits), exact products by splitting into 26-bit halves
double splitHi(double a) {
    double c = 134217729.0 * a;                          // 2^27 + 1
    return c - (c - a);
}
// the rounding error of the product p = a * b (p + the result = a * b exactly)
double prodErr(double a, double b, double p) {
    double ah = splitHi(a);
    double al = a - ah;
    double bh = splitHi(b);
    double bl = b - bh;
    return ((ah * bh - p) + ah * bl + al * bh) + al * bl;
}
// x > 0 and finite -> out[0] + out[1] = log(x)
void logdd(double x, double* out) {
    uint64_t u = __bits(x);
    int hx = (u >> 32) & 0xFFFFFFFF;
    int k = 0;
    if (hx < 0x00100000) {
        k = -54;
        x = x * 18014398509481984.0;
        u = __bits(x);
        hx = (u >> 32) & 0xFFFFFFFF;
    }
    hx = hx + 0x3FF00000 - 0x3FE6A09E;
    k = k + (hx >> 20) - 0x3FF;
    hx = (hx & 0x000FFFFF) + 0x3FE6A09E;
    x = __dbl((hx << 32) | (u & 0xFFFFFFFF));
    double f = x - 1.0;                                  // exact
    double ff = f * f;
    double ffe = prodErr(f, f, ff);
    double hh = 0.5 * ff;                                // hfsq = hh + hl exactly
    double hl = 0.5 * ffe;
    double s = f / (2.0 + f);
    double z = s * s;
    double w = z * z;
    double t1 = w * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01));
    double t2 = z * (6.666666666666735130e-01 + w * (2.857142874366239149e-01 + w * (1.818357216161805012e-01
              + w * 1.479819860511658591e-01)));
    double c = s * (hh + t1 + t2);                       // the small correction term
    double dk = k;
    double a = dk * 6.93147180369123816490e-01;          // exact (ln2_hi has 21 zero bits at the end)
    double ah = f - hh;                                  // (two-sum: ah + ae = f - hh exactly)
    double bb = ah - f;
    double ae = (f - (ah - bb)) + (-hh - bb);
    double sh = a + ah;
    double bv = sh - a;
    double se = (a - (sh - bv)) + (ah - bv);
    double lo = se + ae - hl + c + dk * 1.90821492927058770002e-10;
    double hi = sh + lo;
    out[0] = hi;
    out[1] = lo - (hi - sh);
}

public double log2(double x) { return log(x) * 1.44269504088896338700e+00; }
public double log10(double x) { return log(x) * 4.34294481903251827651e-01; }
public double exp2(double x) {
    if (x != x) return x;
    if (x >= 1024.0) return 1.0 / 0.0;
    if (x <= -1080.0) return 0.0;
    double n = round(x);                                 // 2^x = 2^n * e^((x - n) ln 2), |x - n| <= 0.5 (exact)
    if (n == x) return scalbn(1.0, (int) n);
    return scalbn(exp((x - n) * 6.93147180559945309417e-01), (int) n);
}

public double pow(double x, double y) {
    if (y == 0.0) return 1.0;
    if (x == 1.0) return 1.0;
    if (x != x || y != y) return x + y;
    if (y == 1.0) return x;
    if (y == 2.0) return x * x;
    if (y == 0.5 && x >= 0.0 && !isInf(x)) return __sqrt(x);
    if (y == -1.0) return 1.0 / x;
    bool yint = y == trunc(y);
    if (yint && fabs(y) <= 64.0) {                       // integer powers: repeated squaring
        int n = (int) y;
        bool neg = n < 0;
        if (neg) n = -n;
        double r = 1.0;
        double b = x;
        while (n > 0) {
            if ((n & 1) != 0) r = r * b;
            b = b * b;
            n = n >> 1;
        }
        return neg ? 1.0 / r : r;
    }
    if (x == 0.0) {
        bool oddint = yint && fabs(y) < 9007199254740992.0 && ((int) y & 1) != 0;
        if (y < 0.0) return oddint ? copysign(1.0 / 0.0, x) : 1.0 / 0.0;
        return oddint ? x : 0.0;
    }
    if (isInf(y)) {
        double ax = fabs(x);
        if (ax == 1.0) return 1.0;
        if ((ax > 1.0) == (y > 0.0)) return 1.0 / 0.0;
        return 0.0;
    }
    if (x == -1.0 / 0.0) {                               // pow(-infinity, y)
        bool odd = yint && fabs(y) < 9007199254740992.0 && ((int) y & 1) != 0;
        if (y > 0.0) return odd ? x : 1.0 / 0.0;
        return odd ? -0.0 : 0.0;
    }
    bool negate = false;
    if (x < 0.0) {
        if (!yint) return nan();                         // a negative number to a fractional power
        negate = fabs(y) < 9007199254740992.0 && ((int) y & 1) != 0;
        x = -x;
    }
    if (isInf(x)) {
        double r = y > 0.0 ? x : 0.0;
        return negate ? -r : r;
    }
    if (fabs(y) > 1e300) return exp(y * log(x));         // (would overflow the splitting; the result is 0 or infinity)
    double l[2];
    logdd(x, l);                                         // y * log(x) with about 10 extra bits, then exp
    double zh = y * l[0];
    double ze = prodErr(y, l[0], zh) + y * l[1];
    double r;
    if (zh > 709.79) r = 1.0 / 0.0;
    else if (zh < -745.2) r = 0.0;
    else {
        r = exp(zh);
        r = r + r * ze;
    }
    return negate ? -r : r;
}

public double cbrt(double x) {
    if (x == 0.0 || x != x || isInf(x)) return x;
    double a = fabs(x);
    double scale = 1.0;
    if (a < 1e-290) {                                    // tiny: work on a * 2^1020, the root is then 2^340 too big
        a = a * __dbl(0x7FB0000000000000);
        scale = __dbl(0x2AB0000000000000);               // 2^-340
    }
    double r = exp(log(a) / 3.0);
    r = r - (r * r * r - a) / (3.0 * r * r);             // one Newton step
    return copysign(r * scale, x);
}

public double hypot(double x, double y) {
    double a = fabs(x);
    double b = fabs(y);
    if (isInf(a) || isInf(b)) return 1.0 / 0.0;
    if (a != a || b != b) return a + b;
    if (a < b) { double t = a; a = b; b = t; }
    if (a == 0.0) return 0.0;
    double r = b / a;
    return a * __sqrt(1.0 + r * r);
}

// sinh for |x| < 1: its Taylor series (to x^19, below the rounding error)
double sinhSeries(double x) {
    double z = x * x;
    return x + x * z * (1.0 / 6.0 + z * (1.0 / 120.0 + z * (1.0 / 5040.0 + z * (1.0 / 362880.0 + z * (1.0 / 39916800.0
         + z * (1.0 / 6227020800.0 + z * (1.0 / 1307674368000.0 + z * (1.0 / 355687428096000.0
         + z * (1.0 / 121645100408832000.0)))))))));
}
public double sinh(double x) {
    double a = fabs(x);
    if (a < 1.0) return sinhSeries(x);
    if (a > 709.0) {                                     // exp(a) alone would overflow before exp(a) / 2 does
        double h = exp(0.5 * a);
        return copysign(0.5 * h * h, x);
    }
    double e = exp(a);
    return copysign(0.5 * (e - 1.0 / e), x);
}
public double cosh(double x) {
    double a = fabs(x);
    if (a > 709.0) {
        double h = exp(0.5 * a);
        return 0.5 * h * h;
    }
    double e = exp(a);
    return 0.5 * (e + 1.0 / e);
}
public double tanh(double x) {
    double a = fabs(x);
    if (a > 22.0) return copysign(1.0, x);
    if (a < 1.0) {
        double s = sinhSeries(x);
        return s / __sqrt(1.0 + s * s);                  // sinh / cosh, cosh = sqrt(1 + sinh^2)
    }
    double e = exp(2.0 * a);
    return copysign((e - 1.0) / (e + 1.0), x);
}
