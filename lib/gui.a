// =============================================================================
//  gui - graphical programs: a connection to a display server, windows and widgets          import gui;
//
//    gui.Display* d = gui.connect(null);                     // uses ADISPLAY (default 127.0.0.1:7000)
//    gui.Window* w = d->createWindow("Hello", 300, 160, 0);
//    gui.Box* col = gui.vbox(10, 12);                        // vertical box: spacing 10, padding 12
//    col->add(new gui.Label("Press the button"));
//    gui.Button* b = new gui.Button("Click me");
//    b->onClick = clicked;                                    // int clicked(int widget) { ... return 0; }
//    col->add(b);
//    w->setRoot(col);
//    d->run();                                                // until every window is closed
//
//  Widgets      Label  Button  CheckBox  TextBox  ListBox  Slider  ProgressBar  ImageView  Separator  Spacer  Box (layout)
//  Layout       a Box lays its children out in a row or column. A child with flex > 0 takes its share of the free space,
//               the others get their preferred size. Children are stretched across the box.
//  Callbacks    are plain functions  int f(int widget);  the widget comes as an int (cast it: (gui.Button*) widget);
//               every widget has a userData field for your own use.
//  Own drawing  derive from gui.Widget and override paint(), onMouse(), onKey(); or draw into window->surf and call
//               window->invalidateAll().
//  Timers       d->after(ms, f, arg) calls  int f(int arg)  once.
//  Events are handled by d->run() (or d->pump(ms) if you have a loop of your own). Windows are repainted after every
//  event that changed something.
// =============================================================================
import net;
import gfx;
import adp;
import cstdlib;
import hash;
import secure;
module gui;

// ---- colours of the standard theme ------------------------------------------------------------------------------------------
public int cBack = 0xFFEEEEF2;
public int cText = 0xFF202428;
public int cTextDim = 0xFF80848C;
public int cAccent = 0xFF3C78D8;
public int cAccentText = 0xFFFFFFFF;
public int cField = 0xFFFFFFFF;
public int cBorder = 0xFF9CA0AA;
public int cButton = 0xFFE4E6EC;
public int cButtonHot = 0xFFD6DAE6;
public int cButtonDown = 0xFFBCC4DC;
public int cSelect = 0xFF9CC0F0;

// a function that is called while the library waits for the server (a program that runs the display server in the
// same process sets it to a function that calls server->step(0))
public func idleHook;

class Window;
class Widget;
class Display;

// moves count bytes up in a buffer (the ranges may overlap, so the copy runs backwards)
private void moveUp(char* b, int from, int to, int count) {
    for (int i = count - 1; i >= 0; i--) {
        b[to + i] = b[from + i];
    }
}

// =============================================================================
//  widgets
// =============================================================================
public class Widget {
    public int x;
    public int y;
    public int w;
    public int h;
    public int flex;                // share of the free space in a Box (0 = preferred size)
    public int userData;
    public bool visible;
    public bool enabled;
    public bool focusable;
    public char* tooltip;           // shown when the pointer rests on the widget (null = none)
    public func onContext;          // right click:  int f(int widget)  (see win->lastMouseX / lastMouseY)
    public Widget* parent;
    public Window* win;
    public Widget** kids;
    public int nkids;
    public int capKids;

    public Widget() {
        visible = true;
        enabled = true;
        w = 10;
        h = 10;
    }

    public void add(Widget* k) {
        if (capKids == 0) {
            capKids = 8;
            kids = (Widget**) calloc(capKids, 8);
        } else if (nkids == capKids) {
            capKids = capKids * 2;
            kids = (Widget**) realloc((char*) kids, capKids * 8);
        }
        kids[nkids] = k;
        nkids++;
        k->parent = this;
        k->attach(win);
        relayout();
    }

    public void removeAll() {
        for (int i = 0; i < nkids; i++) {
            kids[i]->attach(null);
            kids[i]->parent = null;
        }
        nkids = 0;
        relayout();
    }

    // tells the widget and its children which window they belong to
    public virtual void attach(Window* wn) {
        win = wn;
        for (int i = 0; i < nkids; i++) {
            kids[i]->attach(wn);
        }
    }

    public virtual int prefW() { return w; }
    public virtual int prefH() { return h; }
    public virtual void layout() {
        for (int i = 0; i < nkids; i++) {
            kids[i]->layout();
        }
    }
    public virtual void paint(gfx.Surface* s, int ox, int oy) {
    }
    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        return false;
    }
    public virtual bool onKey(int down, int key, int uni, int mods) {
        return false;
    }
    public virtual void onFocus(bool gained) {
    }
    public virtual void onHover(bool inside) {
    }
    // true for widgets that scroll by themselves (the mouse wheel goes to the first one of these under the pointer)
    public virtual bool wantsScroll() {
        return false;
    }
    // text arrived for Display.requestPasteTo(widget)
    public virtual void onPaste(char* t) {
    }
    // a child of this widget got the focus: scroll it into view (containers that scroll override this)
    public virtual void reveal(Widget* child) {
    }
    // keys that are offered to the widget before the focused widget sees them (see Window.keyPreview)
    public virtual bool onShortcut(int key, int uni, int mods) {
        return false;
    }
    // the widget was shown as a popup of the window and got closed by the window (Esc or a click elsewhere)
    public virtual void onDismiss() {
    }

    public int absX() {
        int v = x;
        Widget* p = parent;
        while (p != null) {
            v = v + p->x;
            p = p->parent;
        }
        return v;
    }

    public int absY() {
        int v = y;
        Widget* p = parent;
        while (p != null) {
            v = v + p->y;
            p = p->parent;
        }
        return v;
    }

    // the deepest visible widget at (px, py) given relative to this widget, null if none
    public Widget* hit(int px, int py) {
        if (!visible || px < 0 || py < 0 || px >= w || py >= h) {
            return null;
        }
        for (int i = nkids - 1; i >= 0; i--) {
            Widget* k = kids[i];
            Widget* r = k->hit(px - k->x, py - k->y);
            if (r != null) {
                return r;
            }
        }
        return this;
    }

    public void paintTree(gfx.Surface* s, int ox, int oy) {
        if (!visible) {
            return;
        }
        int c0 = s->clipX0;
        int c1 = s->clipY0;
        int c2 = s->clipX1;
        int c3 = s->clipY1;
        int nx0 = (ox > c0) ? ox : c0;
        int ny0 = (oy > c1) ? oy : c1;
        int nx1 = (ox + w < c2) ? ox + w : c2;
        int ny1 = (oy + h < c3) ? oy + h : c3;
        if (nx0 < nx1 && ny0 < ny1) {
            s->clipX0 = nx0;
            s->clipY0 = ny0;
            s->clipX1 = nx1;
            s->clipY1 = ny1;
            paint(s, ox, oy);
            for (int i = 0; i < nkids; i++) {
                kids[i]->paintTree(s, ox + kids[i]->x, oy + kids[i]->y);
            }
        }
        s->clipX0 = c0;
        s->clipY0 = c1;
        s->clipX1 = c2;
        s->clipY1 = c3;
    }

    public void invalidate() {
        if (win != null) {
            win->invalidate(absX(), absY(), w, h);
        }
    }

    // the widget (or a child of it) changed size: arrange everything again
    public void relayout() {
        if (win != null) {
            win->needLayout = true;
        }
    }

    public void setVisible(bool v) {
        visible = v;
        relayout();
        if (win != null) {
            win->invalidateAll();
        }
    }

    public void setEnabled(bool v) {
        enabled = v;
        invalidate();
    }

    public void focusMe() {
        if (win != null) {
            win->setFocus(this);
        }
    }
}

// ---- a row or a column of widgets ---------------------------------------------------------------------------------------------------
public class Box : Widget {
    public bool vertical;
    public int spacing;
    public int padding;
    public int background;          // 0 = transparent
    public int border;              // 0 = none

    public Box(bool vert, int space, int pad) {
        super();
        vertical = vert;
        spacing = space;
        padding = pad;
    }

    public virtual int prefW() {
        int total = 0;
        int count = 0;
        for (int i = 0; i < nkids; i++) {
            if (!kids[i]->visible) { continue; }
            int pw = kids[i]->prefW();
            if (vertical) {
                if (pw > total) { total = pw; }
            } else {
                total = total + pw;
            }
            count++;
        }
        if (!vertical && count > 1) {
            total = total + spacing * (count - 1);
        }
        return total + padding * 2;
    }

    public virtual int prefH() {
        int total = 0;
        int count = 0;
        for (int i = 0; i < nkids; i++) {
            if (!kids[i]->visible) { continue; }
            int ph = kids[i]->prefH();
            if (!vertical) {
                if (ph > total) { total = ph; }
            } else {
                total = total + ph;
            }
            count++;
        }
        if (vertical && count > 1) {
            total = total + spacing * (count - 1);
        }
        return total + padding * 2;
    }

    public virtual void layout() {
        int count = 0;
        int fixedSum = 0;
        int flexSum = 0;
        for (int i = 0; i < nkids; i++) {
            Widget* k = kids[i];
            if (!k->visible) { continue; }
            count++;
            if (k->flex > 0) {
                flexSum = flexSum + k->flex;
            } else {
                fixedSum = fixedSum + (vertical ? k->prefH() : k->prefW());
            }
        }
        int mainSize = (vertical ? h : w) - padding * 2;
        int free = mainSize - fixedSum - ((count > 1) ? spacing * (count - 1) : 0);
        if (free < 0) { free = 0; }
        int cross = (vertical ? w : h) - padding * 2;
        int pos = padding;
        int flexLeft = flexSum;
        int freeLeft = free;
        for (int i = 0; i < nkids; i++) {
            Widget* k = kids[i];
            if (!k->visible) { continue; }
            int size;
            if (k->flex > 0) {
                size = freeLeft * k->flex / flexLeft;
                freeLeft = freeLeft - size;
                flexLeft = flexLeft - k->flex;
            } else {
                size = vertical ? k->prefH() : k->prefW();
            }
            if (vertical) {
                k->x = padding;
                k->y = pos;
                k->w = cross;
                k->h = size;
            } else {
                k->x = pos;
                k->y = padding;
                k->w = size;
                k->h = cross;
            }
            pos = pos + size + spacing;
            k->layout();
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        if (background != 0) {
            s->fill(ox, oy, w, h, background);
        }
        if (border != 0) {
            s->rect(ox, oy, w, h, border);
        }
    }
}

public Box* vbox(int spacing, int padding) {
    return new Box(true, spacing, padding);
}

public Box* hbox(int spacing, int padding) {
    return new Box(false, spacing, padding);
}

// ---- Label ---------------------------------------------------------------------------------------------------------------------------
public class Label : Widget {
    public char* text;
    public int color;
    public int align;               // 0 left, 1 centre, 2 right
    public gfx.Font* font;

    public Label(char* t) {
        super();
        text = strdup(t);
        color = cText;
        font = gfx.sans();
    }

    public void setText(char* t) {
        text = strdup(t);
        relayout();
        invalidate();
    }

    public virtual int prefW() { return gfx.textWidth(font, text) + 2; }
    public virtual int prefH() { return font->height + 4; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int tw = gfx.textWidth(font, text);
        int tx = ox + 1;
        if (align == 1) { tx = ox + (w - tw) / 2; }
        if (align == 2) { tx = ox + w - tw - 1; }
        s->text(font, tx, oy + (h - font->height) / 2, text, enabled ? color : cTextDim);
    }
}

// ---- Button ------------------------------------------------------------------------------------------------------------------------------
public class Button : Widget {
    public char* text;
    public func onClick;
    public bool primary;            // drawn in the accent colour
    private bool down;
    private bool hot;

    public Button(char* t) {
        super();
        text = strdup(t);
        focusable = true;
    }

    public void setText(char* t) {
        text = strdup(t);
        relayout();
        invalidate();
    }

    public virtual int prefW() { return gfx.textWidth(gfx.sans(), text) + 28; }
    public virtual int prefH() { return 28; }

    public void click() {
        if (enabled && onClick != null) {
            onClick(this);
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int base = primary ? cAccent : cButton;
        int c = base;
        if (!enabled) {
            c = gfx.mix(base, cBack, 140);
        } else if (down) {
            c = primary ? gfx.darken(cAccent, 50) : cButtonDown;
        } else if (hot) {
            c = primary ? gfx.lighten(cAccent, 40) : cButtonHot;
        }
        s->fillRoundRect(ox, oy, w, h, 5, c);
        s->roundRect(ox, oy, w, h, 5, (win != null && win->focusWidget == this) ? cAccent : cBorder);
        int tc = primary ? cAccentText : cText;
        if (!enabled) { tc = cTextDim; }
        s->textCentered(gfx.sans(), ox, oy + (down ? 1 : 0), w, h, text, tc);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (!enabled) {
            return true;
        }
        if (kind == adp.M_DOWN && button == 1) {
            down = true;
            invalidate();
            return true;
        }
        if (kind == adp.M_UP && button == 1) {
            bool was = down;
            down = false;
            invalidate();
            if (was && mx >= 0 && my >= 0 && mx < w && my < h) {
                click();
            }
            return true;
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        hot = inside;
        if (!inside) { down = false; }
        invalidate();
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn != 0 && (key == adp.KEY_ENTER || key == adp.KEY_SPACE)) {
            click();
            return true;
        }
        return false;
    }

    public virtual void onFocus(bool gained) {
        invalidate();
    }
}

// ---- CheckBox ----------------------------------------------------------------------------------------------------------------------------
public class CheckBox : Widget {
    public char* text;
    public bool checked;
    public func onChange;

    public CheckBox(char* t) {
        super();
        text = strdup(t);
        focusable = true;
    }

    public virtual int prefW() { return gfx.textWidth(gfx.sans(), text) + 26; }
    public virtual int prefH() { return 22; }

    public void setChecked(bool v) {
        checked = v;
        invalidate();
        if (onChange != null) {
            onChange(this);
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int by = oy + (h - 16) / 2;
        s->fillRoundRect(ox + 1, by, 16, 16, 3, cField);
        s->roundRect(ox + 1, by, 16, 16, 3, (win != null && win->focusWidget == this) ? cAccent : cBorder);
        if (checked) {
            int ink = enabled ? cAccent : cTextDim;
            s->line(ox + 4, by + 8, ox + 7, by + 11, ink);
            s->line(ox + 5, by + 8, ox + 8, by + 11, ink);
            s->line(ox + 7, by + 11, ox + 13, by + 4, ink);
            s->line(ox + 8, by + 11, ox + 14, by + 4, ink);
        }
        s->text(gfx.sans(), ox + 24, oy + (h - gfx.sans()->height) / 2, text, enabled ? cText : cTextDim);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (enabled && kind == adp.M_UP && button == 1 && mx >= 0 && my >= 0 && mx < w && my < h) {
            setChecked(!checked);
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn != 0 && key == adp.KEY_SPACE) {
            setChecked(!checked);
            return true;
        }
        return false;
    }

    public virtual void onFocus(bool gained) {
        invalidate();
    }
}

// ---- TextBox ---------------------------------------------------------------------------------------------------------------------------------
public class TextBox : Widget {
    public func onEnter;
    public func onChange;
    public bool password;
    public char* placeholder;
    private char* buf;
    private int cap;
    private int len;
    private int cur;
    private int anchor;             // the other end of the selection (== cur: nothing selected)
    private int scroll;             // pixels the text is shifted left
    private bool caretOn;
    private bool dragging;

    public TextBox() {
        super();
        focusable = true;
        cap = 256;
        buf = malloc(cap);
        buf[0] = 0;
        placeholder = "";
        w = 160;
        h = 26;
    }

    public virtual int prefW() { return 160; }
    public virtual int prefH() { return 26; }

    public char* text() { return buf; }

    public void setText(char* t) {
        len = 0;
        buf[0] = 0;
        cur = 0;
        anchor = 0;
        scroll = 0;
        insertText(t);
        anchor = cur;
        invalidate();
    }

    public void selectAll() {
        anchor = 0;
        cur = len;
        invalidate();
    }

    private void grow(int extra) {
        if (len + extra + 8 > cap) {
            while (len + extra + 8 > cap) {
                cap = cap * 2;
            }
            buf = realloc(buf, cap);
        }
    }

    private bool hasSelection() { return anchor != cur; }

    private void deleteSelection() {
        if (!hasSelection()) {
            return;
        }
        int a = (anchor < cur) ? anchor : cur;
        int b = (anchor < cur) ? cur : anchor;
        memcpy(&buf[a], &buf[b], len - b + 1);
        len = len - (b - a);
        cur = a;
        anchor = a;
    }

    private void insertText(char* t) {
        deleteSelection();
        int n = strlen(t);
        grow(n);
        moveUp(buf, cur, cur + n, len - cur + 1);
        memcpy(&buf[cur], t, n);
        len = len + n;
        cur = cur + n;
        anchor = cur;
    }

    // inserts a character (code point; encoded as UTF-8)
    private void insertChar(int c) {
        char tmp[8];
        if (c < 128) {
            tmp[0] = c;
            tmp[1] = 0;
        } else if (c < 2048) {
            tmp[0] = 0xC0 | (c >> 6);
            tmp[1] = 0x80 | (c & 63);
            tmp[2] = 0;
        } else {
            tmp[0] = '?';
            tmp[1] = 0;
        }
        insertText(&tmp[0]);
    }

    // the byte position of the character before / after a position (UTF-8 aware)
    private int prevPos(int p) {
        if (p <= 0) { return 0; }
        p--;
        while (p > 0 && (buf[p] & 0xC0) == 0x80) { p--; }
        return p;
    }

    private int nextPos(int p) {
        if (p >= len) { return len; }
        p++;
        while (p < len && (buf[p] & 0xC0) == 0x80) { p++; }
        return p;
    }

    private int widthTo(int p) {
        char save = buf[p];
        buf[p] = 0;
        int tw;
        if (password) {
            tw = 0;
            int q = 0;
            while (q < p) {
                tw = tw + gfx.sans()->advance('*');
                q = nextPos(q);
            }
        } else {
            tw = gfx.textWidth(gfx.sans(), buf);
        }
        buf[p] = save;
        return tw;
    }

    private int posAt(int px) {
        int best = 0;
        int p = 0;
        while (p <= len) {
            int wd = widthTo(p);
            if (wd - scroll > px) {
                break;
            }
            best = p;
            if (p == len) { break; }
            p = nextPos(p);
        }
        return best;
    }

    private void changed() {
        invalidate();
        if (onChange != null) {
            onChange(this);
        }
    }

    private void keepCaretVisible() {
        int cx = widthTo(cur);
        int room = w - 12;
        if (cx - scroll > room) { scroll = cx - room; }
        if (cx - scroll < 0) { scroll = cx; }
        if (scroll < 0) { scroll = 0; }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        bool focused = (win != null && win->focusWidget == this);
        s->fillRoundRect(ox, oy, w, h, 4, enabled ? cField : cBack);
        s->roundRect(ox, oy, w, h, 4, focused ? cAccent : cBorder);
        int c0 = s->clipX0;
        int c2 = s->clipX1;
        int ix = ox + 5;
        if (ix > s->clipX0) { s->clipX0 = ix; }
        if (ox + w - 5 < s->clipX1) { s->clipX1 = ox + w - 5; }
        gfx.Font* f = gfx.sans();
        int ty = oy + (h - f->height) / 2;
        if (len == 0 && !focused) {
            s->text(f, ix, ty, placeholder, cTextDim);
        } else {
            if (hasSelection()) {
                int a = (anchor < cur) ? anchor : cur;
                int b = (anchor < cur) ? cur : anchor;
                int sx0 = ix + widthTo(a) - scroll;
                int sx1 = ix + widthTo(b) - scroll;
                s->fill(sx0, ty - 1, sx1 - sx0, f->height + 2, cSelect);
            }
            if (password) {
                int px = ix - scroll;
                int q = 0;
                while (q < len) {
                    px = s->text(f, px, ty, "*", cText);
                    q = nextPos(q);
                }
            } else {
                s->text(f, ix - scroll, ty, buf, cText);
            }
            if (focused && caretOn) {
                int cx = ix + widthTo(cur) - scroll;
                s->fill(cx, ty, 1, f->height, cText);
            }
        }
        s->clipX0 = c0;
        s->clipX1 = c2;
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (!enabled) {
            return true;
        }
        if (kind == adp.M_DOWN && button == 1) {
            cur = posAt(mx - 5);
            if ((mods & adp.MOD_SHIFT) == 0) {
                anchor = cur;
            }
            dragging = true;
            caretOn = true;
            invalidate();
        } else if (kind == adp.M_MOVE && dragging) {
            cur = posAt(mx - 5);
            keepCaretVisible();
            invalidate();
        } else if (kind == adp.M_UP) {
            dragging = false;
        }
        return true;
    }

    public virtual void onFocus(bool gained) {
        caretOn = gained;
        if (gained && win != null) {
            win->display->after(500, blink, (int) this);
        }
        invalidate();
    }

    public void toggleCaret() {
        if (win != null && win->focusWidget == this) {
            caretOn = !caretOn;
            invalidate();
            win->display->after(500, blink, (int) this);
        }
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0 || !enabled) {
            return false;
        }
        bool shift = (mods & adp.MOD_SHIFT) != 0;
        bool ctrl = (mods & adp.MOD_CTRL) != 0;
        caretOn = true;
        if (ctrl) {
            if (key == 'a') {
                selectAll();
                return true;
            }
            if ((key == 'c' || key == 'x') && hasSelection()) {
                int a = (anchor < cur) ? anchor : cur;
                int b = (anchor < cur) ? cur : anchor;
                char saved = buf[b];
                buf[b] = 0;
                win->display->setClipboard(&buf[a]);
                buf[b] = saved;
                if (key == 'x') {
                    deleteSelection();
                    changed();
                }
                return true;
            }
            if (key == 'v') {
                win->display->requestPaste(this);
                return true;
            }
            return false;
        }
        if (key == adp.KEY_LEFT) {
            cur = prevPos(cur);
            if (!shift) { anchor = cur; }
        } else if (key == adp.KEY_RIGHT) {
            cur = nextPos(cur);
            if (!shift) { anchor = cur; }
        } else if (key == adp.KEY_HOME) {
            cur = 0;
            if (!shift) { anchor = cur; }
        } else if (key == adp.KEY_END) {
            cur = len;
            if (!shift) { anchor = cur; }
        } else if (key == adp.KEY_BACKSPACE) {
            if (hasSelection()) {
                deleteSelection();
            } else if (cur > 0) {
                anchor = prevPos(cur);
                deleteSelection();
            }
            changed();
        } else if (key == adp.KEY_DELETE) {
            if (hasSelection()) {
                deleteSelection();
            } else if (cur < len) {
                anchor = nextPos(cur);
                deleteSelection();
            }
            changed();
        } else if (key == adp.KEY_ENTER) {
            if (onEnter != null) {
                onEnter(this);
            }
            return true;
        } else if (uni >= 32 && uni != 127 && uni < 0x10000) {
            insertChar(uni);
            changed();
        } else {
            return false;
        }
        keepCaretVisible();
        invalidate();
        return true;
    }

    // text that arrives from the clipboard
    public void paste(char* t) {
        // only the first line
        char* line = strdup(t);
        for (int i = 0; line[i] != 0; i++) {
            if (line[i] == 10 || line[i] == 13) {
                line[i] = 0;
                break;
            }
        }
        insertText(line);
        changed();
        keepCaretVisible();
    }
}

int blink(int self) {
    TextBox* t = (TextBox*) self;
    t->toggleCaret();
    return 0;
}

// ---- ProgressBar and Slider -----------------------------------------------------------------------------------------------------
public class ProgressBar : Widget {
    public int value;               // 0 .. 100
    public bool busy;               // indeterminate: a block moves back and forth (start() / stop())
    private int phase;
    private int timer;

    public ProgressBar() { super(); h = 16; w = 120; }
    public virtual int prefW() { return 120; }
    public virtual int prefH() { return 16; }

    public void setValue(int v) {
        if (v < 0) { v = 0; }
        if (v > 100) { v = 100; }
        value = v;
        invalidate();
    }

    // an animation for work of unknown length
    public void start() {
        if (busy || win == null) {
            return;
        }
        busy = true;
        timer = win->display->after(40, progressTick, (int) this);
    }

    public void stop() {
        busy = false;
        if (timer != 0 && win != null) {
            win->display->cancel(timer);
        }
        timer = 0;
        invalidate();
    }

    public void tick() {
        timer = 0;
        if (!busy || win == null) {
            return;
        }
        phase = (phase + 3) % 200;
        invalidate();
        timer = win->display->after(40, progressTick, (int) this);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fillRoundRect(ox, oy, w, h, 4, cField);
        if (busy) {
            int span = w - 2;
            int bw = span / 4;
            int pos = (phase < 100) ? phase : 200 - phase;
            int bx = ox + 1 + (span - bw) * pos / 100;
            s->fillRoundRect(bx, oy + 1, bw, h - 2, 3, cAccent);
        } else {
            int fw = (w - 2) * value / 100;
            if (fw > 0) {
                s->fillRoundRect(ox + 1, oy + 1, fw, h - 2, 3, cAccent);
            }
        }
        s->roundRect(ox, oy, w, h, 4, cBorder);
    }
}

int progressTick(int arg) {
    ProgressBar* p = (ProgressBar*) arg;
    p->tick();
    return 0;
}

public class Slider : Widget {
    public int min;
    public int max;
    public int value;
    public func onChange;
    private bool dragging;

    public Slider(int lo, int hi) {
        super();
        min = lo;
        max = hi;
        value = lo;
        focusable = true;
        h = 22;
        w = 140;
    }

    public virtual int prefW() { return 140; }
    public virtual int prefH() { return 22; }

    public void setValue(int v) {
        if (v < min) { v = min; }
        if (v > max) { v = max; }
        if (v != value) {
            value = v;
            invalidate();
            if (onChange != null) {
                onChange(this);
            }
        }
    }

    private int knobX() {
        if (max <= min) { return 8; }
        return 8 + (w - 16) * (value - min) / (max - min);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int ty = oy + h / 2 - 2;
        s->fillRoundRect(ox + 4, ty, w - 8, 4, 2, cBorder);
        int kx = knobX();
        s->fillRoundRect(ox + 4, ty, kx - 4, 4, 2, cAccent);
        s->fillCircle(ox + kx, oy + h / 2, 7, cField);
        s->circle(ox + kx, oy + h / 2, 7, (win != null && win->focusWidget == this) ? cAccent : cBorder);
    }

    private void setFromX(int mx) {
        if (w <= 16) { return; }
        int v = min + ((mx - 8) * (max - min) + (w - 16) / 2) / (w - 16);
        setValue(v);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (!enabled) { return true; }
        if (kind == adp.M_DOWN && button == 1) {
            dragging = true;
            setFromX(mx);
        } else if (kind == adp.M_MOVE && dragging) {
            setFromX(mx);
        } else if (kind == adp.M_UP) {
            dragging = false;
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        int step = (max - min) / 20;
        if (step < 1) { step = 1; }
        if (key == adp.KEY_LEFT) { setValue(value - step); return true; }
        if (key == adp.KEY_RIGHT) { setValue(value + step); return true; }
        return false;
    }

    public virtual void onFocus(bool gained) {
        invalidate();
    }
}

// ---- ListBox -------------------------------------------------------------------------------------------------------------------------
public class ListBox : Widget {
    public int selected;            // -1 = none
    public func onSelect;
    public func onActivate;         // double click or Enter
    private char** items;
    private int count;
    private int cap;
    private int top;                // first visible row
    private int lastClick;

    public ListBox() {
        super();
        focusable = true;
        selected = -1;
        w = 160;
        h = 120;
        cap = 16;
        items = (char**) calloc(cap, 8);
    }

    public virtual int prefW() { return 160; }
    public virtual int prefH() { return 120; }
    public virtual bool wantsScroll() { return true; }
    public int size() { return count; }

    public void clear() {
        count = 0;
        selected = -1;
        top = 0;
        invalidate();
    }

    public void addItem(char* t) {
        if (count == cap) {
            cap = cap * 2;
            items = (char**) realloc((char*) items, cap * 8);
        }
        items[count] = strdup(t);
        count++;
        invalidate();
    }

    public char* item(int i) {
        if (i < 0 || i >= count) {
            return "";
        }
        return items[i];
    }

    private int rowH() { return gfx.sans()->height + 6; }
    private int rows() { return (h - 2) / rowH(); }

    private void clampTop() {
        int r = rows();
        if (top > count - r) { top = count - r; }
        if (top < 0) { top = 0; }
    }

    public void select(int i) {
        if (i < -1 || i >= count) {
            return;
        }
        selected = i;
        int r = rows();
        if (i >= 0 && i < top) { top = i; }
        if (i >= top + r) { top = i - r + 1; }
        clampTop();
        invalidate();
        if (onSelect != null) {
            onSelect(this);
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, cField);
        gfx.Font* f = gfx.sans();
        int rh = rowH();
        int r = rows();
        for (int i = 0; i < r + 1 && top + i < count; i++) {
            int ry = oy + 1 + i * rh;
            int idx = top + i;
            if (idx == selected) {
                bool focused = (win != null && win->focusWidget == this);
                s->fill(ox + 1, ry, w - 2, rh, focused ? cAccent : cSelect);
                s->text(f, ox + 6, ry + (rh - f->height) / 2, items[idx], focused ? cAccentText : cText);
            } else {
                s->text(f, ox + 6, ry + (rh - f->height) / 2, items[idx], cText);
            }
        }
        if (count > r && r > 0) {
            int trackH = h - 2;
            int thumbH = trackH * r / count;
            if (thumbH < 12) { thumbH = 12; }
            int thumbY = (trackH - thumbH) * top / (count - r);
            s->fillRoundRect(ox + w - 8, oy + 1 + thumbY, 6, thumbH, 3, cBorder);
        }
        s->rect(ox, oy, w, h, (win != null && win->focusWidget == this) ? cAccent : cBorder);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            int i = top + (my - 1) / rowH();
            if (i >= 0 && i < count) {
                select(i);
                int now = millis();
                if (now - lastClick < 400 && onActivate != null) {
                    onActivate(this);
                }
                lastClick = now;
            }
        } else if (kind == adp.M_SCROLL) {
            top = top - button * 3;
            clampTop();
            invalidate();
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        if (key == adp.KEY_DOWN) {
            select((selected < count - 1) ? selected + 1 : selected);
            return true;
        }
        if (key == adp.KEY_UP) {
            select((selected > 0) ? selected - 1 : selected);
            return true;
        }
        if (key == adp.KEY_PGDN) { select((selected + rows() < count) ? selected + rows() : count - 1); return true; }
        if (key == adp.KEY_PGUP) { select((selected - rows() > 0) ? selected - rows() : 0); return true; }
        if (key == adp.KEY_HOME && count > 0) { select(0); return true; }
        if (key == adp.KEY_END && count > 0) { select(count - 1); return true; }
        if (key == adp.KEY_ENTER && selected >= 0 && onActivate != null) {
            onActivate(this);
            return true;
        }
        return false;
    }

    public virtual void onFocus(bool gained) {
        invalidate();
    }
}

// ---- ImageView, Separator, Spacer ----------------------------------------------------------------------------------------------------
public class ImageView : Widget {
    public gfx.Surface* image;

    public ImageView(gfx.Surface* img) {
        super();
        image = img;
        w = img->w;
        h = img->h;
    }

    public virtual int prefW() { return image->w; }
    public virtual int prefH() { return image->h; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->blitBlend(image, 0, 0, image->w, image->h, ox, oy, 255);
    }
}

public class Separator : Widget {
    public Separator() { super(); h = 3; w = 3; }
    public virtual int prefW() { return 3; }
    public virtual int prefH() { return 3; }
    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        if (w > h) {
            s->hline(ox, oy + h / 2, w, cBorder);
        } else {
            s->vline(ox + w / 2, oy, h, cBorder);
        }
    }
}

public class Spacer : Widget {
    public Spacer(int size) { super(); w = size; h = size; flex = 0; }
    public virtual int prefW() { return w; }
    public virtual int prefH() { return h; }
}

// ---- TextArea: a multi-line text editor ---------------------------------------------------------------------------------------
public class TextArea : Widget {
    public func onChange;
    public bool readOnly;
    private char* buf;
    private int cap;
    private int len;
    private int cur;
    private int top;                // first visible line
    private int left;               // pixels the text is shifted left
    private int wantCol;            // the column that Up / Down try to keep
    private bool caretOn;

    public TextArea() {
        super();
        focusable = true;
        cap = 1024;
        buf = malloc(cap);
        buf[0] = 0;
        w = 240;
        h = 120;
        flex = 1;
    }

    public virtual bool wantsScroll() { return true; }
    public virtual int prefW() { return 240; }
    public virtual int prefH() { return 120; }
    public char* text() { return buf; }

    public void setText(char* t) {
        len = 0;
        buf[0] = 0;
        cur = 0;
        top = 0;
        left = 0;
        insert(t, strlen(t));
        cur = 0;
        invalidate();
    }

    private void insert(char* t, int n) {
        // carriage returns (from CRLF text) are dropped
        bool hasCr = false;
        for (int i = 0; i < n; i++) {
            if (t[i] == 13) { hasCr = true; break; }
        }
        if (hasCr) {
            char* clean = malloc(n + 1);
            int m = 0;
            for (int i = 0; i < n; i++) {
                if (t[i] != 13) { clean[m] = t[i]; m++; }
            }
            t = clean;
            n = m;
        }
        if (len + n + 8 > cap) {
            while (len + n + 8 > cap) {
                cap = cap * 2;
            }
            buf = realloc(buf, cap);
        }
        moveUp(buf, cur, cur + n, len - cur + 1);
        memcpy(&buf[cur], t, n);
        len = len + n;
        cur = cur + n;
    }

    private int lineHeight() { return gfx.mono()->height + 2; }
    private int visibleLines() { return (h - 8) / lineHeight(); }

    private int lineStart(int pos) {
        while (pos > 0 && buf[pos - 1] != 10) { pos--; }
        return pos;
    }

    private int lineEnd(int pos) {
        while (pos < len && buf[pos] != 10) { pos++; }
        return pos;
    }

    private int lineOf(int pos) {
        int n = 0;
        for (int i = 0; i < pos; i++) {
            if (buf[i] == 10) { n++; }
        }
        return n;
    }

    public int lineCount() {
        return lineOf(len) + 1;
    }

    // the byte position of the start of line n (clamped)
    private int startOfLine(int n) {
        int pos = 0;
        while (n > 0) {
            int e = lineEnd(pos);
            if (e >= len) { break; }
            pos = e + 1;
            n--;
        }
        return pos;
    }

    private int widthOf(int from, int to) {
        char save = buf[to];
        buf[to] = 0;
        int tw = gfx.textWidth(gfx.mono(), &buf[from]);
        buf[to] = save;
        return tw;
    }

    private void changed() {
        invalidate();
        if (onChange != null) {
            onChange(this);
        }
    }

    private void keepCaretVisible() {
        int line = lineOf(cur);
        int rows = visibleLines();
        if (line < top) { top = line; }
        if (line >= top + rows) { top = line - rows + 1; }
        int cx = widthOf(lineStart(cur), cur);
        int room = w - 24;
        if (cx - left > room) { left = cx - room; }
        if (cx - left < 0) { left = cx; }
        if (left < 0) { left = 0; }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        bool focused = (win != null && win->focusWidget == this);
        s->fill(ox, oy, w, h, enabled ? cField : cBack);
        gfx.Font* f = gfx.mono();
        int lh = lineHeight();
        int rows = visibleLines();
        int pos = startOfLine(top);
        for (int i = 0; i <= rows && pos <= len; i++) {
            int e = lineEnd(pos);
            char save = buf[e];
            buf[e] = 0;
            s->text(f, ox + 6 - left, oy + 4 + i * lh, &buf[pos], cText);
            buf[e] = save;
            if (focused && caretOn && cur >= pos && cur <= e) {
                int cx = ox + 6 - left + widthOf(pos, cur);
                s->fill(cx, oy + 4 + i * lh, 1, lh - 1, cText);
            }
            if (e >= len) { break; }
            pos = e + 1;
        }
        int total = lineCount();
        if (total > rows && rows > 0) {
            int trackH = h - 4;
            int thumbH = trackH * rows / total;
            if (thumbH < 12) { thumbH = 12; }
            int thumbY = (trackH - thumbH) * top / (total - rows);
            s->fillRoundRect(ox + w - 8, oy + 2 + thumbY, 6, thumbH, 3, cBorder);
        }
        s->rect(ox, oy, w, h, focused ? cAccent : cBorder);
    }

    private int posAtPoint(int mx, int my) {
        int line = top + (my - 4) / lineHeight();
        if (line < 0) { line = 0; }
        int ls = startOfLine(line);
        int le = lineEnd(ls);
        int best = ls;
        int p = ls;
        while (p <= le) {
            if (widthOf(ls, p) - left > mx - 6) { break; }
            best = p;
            if (p == le) { break; }
            p++;
            while (p < le && (buf[p] & 0xC0) == 0x80) { p++; }
        }
        return best;
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            cur = posAtPoint(mx, my);
            wantCol = cur - lineStart(cur);
            caretOn = true;
            invalidate();
        } else if (kind == adp.M_SCROLL) {
            top = top - button * 3;
            int maxTop = lineCount() - visibleLines();
            if (top > maxTop) { top = maxTop; }
            if (top < 0) { top = 0; }
            invalidate();
        }
        return true;
    }

    public virtual void onFocus(bool gained) {
        caretOn = gained;
        if (gained && win != null) {
            win->display->after(500, blinkArea, (int) this);
        }
        invalidate();
    }

    public void toggleCaret() {
        if (win != null && win->focusWidget == this) {
            caretOn = !caretOn;
            invalidate();
            win->display->after(500, blinkArea, (int) this);
        }
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0 || !enabled) {
            return false;
        }
        caretOn = true;
        if ((mods & adp.MOD_CTRL) != 0) {
            if (key == 'v' && !readOnly) {
                win->display->requestPasteArea(this);
                return true;
            }
            return false;
        }
        int ls = lineStart(cur);
        if (key == adp.KEY_LEFT) {
            if (cur > 0) {
                cur--;
                while (cur > 0 && (buf[cur] & 0xC0) == 0x80) { cur--; }
            }
            wantCol = cur - lineStart(cur);
        } else if (key == adp.KEY_RIGHT) {
            if (cur < len) {
                cur++;
                while (cur < len && (buf[cur] & 0xC0) == 0x80) { cur++; }
            }
            wantCol = cur - lineStart(cur);
        } else if (key == adp.KEY_UP || key == adp.KEY_DOWN || key == adp.KEY_PGUP || key == adp.KEY_PGDN) {
            int line = lineOf(cur);
            int delta = 1;
            if (key == adp.KEY_PGUP || key == adp.KEY_PGDN) { delta = visibleLines() - 1; }
            if (key == adp.KEY_UP || key == adp.KEY_PGUP) { delta = -delta; }
            int target = line + delta;
            if (target < 0) { target = 0; }
            if (target > lineCount() - 1) { target = lineCount() - 1; }
            int ns = startOfLine(target);
            int ne = lineEnd(ns);
            cur = ns + wantCol;
            if (cur > ne) { cur = ne; }
        } else if (key == adp.KEY_HOME) {
            cur = ls;
            wantCol = 0;
        } else if (key == adp.KEY_END) {
            cur = lineEnd(cur);
            wantCol = cur - ls;
        } else if (readOnly) {
            return false;
        } else if (key == adp.KEY_BACKSPACE) {
            if (cur > 0) {
                int p = cur - 1;
                while (p > 0 && (buf[p] & 0xC0) == 0x80) { p--; }
                memcpy(&buf[p], &buf[cur], len - cur + 1);
                len = len - (cur - p);
                cur = p;
                changed();
            }
            wantCol = cur - lineStart(cur);
        } else if (key == adp.KEY_DELETE) {
            if (cur < len) {
                int p = cur + 1;
                while (p < len && (buf[p] & 0xC0) == 0x80) { p++; }
                memcpy(&buf[cur], &buf[p], len - p + 1);
                len = len - (p - cur);
                changed();
            }
        } else if (key == adp.KEY_ENTER) {
            insert("\n", 1);
            wantCol = 0;
            changed();
        } else if (uni >= 32 && uni != 127 && uni < 2048) {
            char tmp[4];
            int n = 1;
            if (uni < 128) {
                tmp[0] = uni;
            } else {
                tmp[0] = 0xC0 | (uni >> 6);
                tmp[1] = 0x80 | (uni & 63);
                n = 2;
            }
            insert(&tmp[0], n);
            wantCol = cur - lineStart(cur);
            changed();
        } else {
            return false;
        }
        keepCaretVisible();
        invalidate();
        return true;
    }

    // text that arrives from the clipboard
    public void paste(char* t) {
        if (!readOnly) {
            insert(t, strlen(t));
            changed();
            keepCaretVisible();
        }
    }
}

int blinkArea(int self) {
    TextArea* t = (TextArea*) self;
    t->toggleCaret();
    return 0;
}

// ---- Canvas: a picture that the program draws into ---------------------------------------------------------------------------------
public class Canvas : Widget {
    public gfx.Surface* surf;
    public func onMouseEvent;       // int f(int canvas): see lastKind, lastButton, lastX, lastY
    public int lastKind;
    public int lastButton;
    public int lastX;
    public int lastY;
    public int mods;

    public Canvas(int width, int height) {
        super();
        surf = new gfx.Surface(width, height);
        surf->clear(0xFFFFFFFF);
        w = width;
        h = height;
        flex = 1;
    }

    public virtual int prefW() { return surf->w; }
    public virtual int prefH() { return surf->h; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->blit(surf, 0, 0, surf->w, surf->h, ox, oy);
        s->rect(ox, oy, w, h, cBorder);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int m) {
        lastKind = kind;
        lastButton = button;
        lastX = mx;
        lastY = my;
        mods = m;
        if (onMouseEvent != null) {
            onMouseEvent(this);
        }
        return true;
    }
}

// =============================================================================
//  windows
// =============================================================================
int tipFire(int arg) {
    Window* w = (Window*) arg;
    w->showTip();
    return 0;
}

// ---- the little yellow text that appears when the pointer rests on a widget ------------------------------------------------------------
class TipView : Widget {
    public char* text;

    public TipView(char* t) {
        super();
        text = strdup(t);
        w = gfx.textWidth(gfx.sans(), t) + 12;
        h = gfx.sans()->height + 8;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->shadow(ox, oy, w, h, 4, 50);
        s->fill(ox, oy, w, h, 0xFFFFFBE0);
        s->rect(ox, oy, w, h, 0xFF707070);
        s->text(gfx.sans(), ox + 6, oy + 4, text, cText);
    }
}

public class Window {
    public int id;
    public Display* display;
    public char* title;
    public int w;
    public int h;
    public int flags;
    public gfx.Surface* surf;
    public Widget* root;
    public Widget* focusWidget;
    public Widget* defaultButton;
    public func onClose;            // return 0 to let the window close (the default when not set)
    public func onKey;              // keys no widget wanted:  int f(int window, int key, int uni)
    public func onResize;           // after the window got another size
    public func onMouseRaw;         // every mouse event before the widgets:  int f(int window)  (see lastMouse*)
    public int userData;
    public int lastMouseX;
    public int lastMouseY;
    public int lastMouseKind;
    public int lastMouseButton;
    public bool needLayout;
    public bool noClear;            // do not paint the background colour first (for windows that draw everything themselves)
    public bool closed;
    public bool focused;
    public Widget* popup;           // a widget drawn above everything and getting all the mouse and key events (menus, drop-down lists)
    public Widget* keyPreview;      // sees every key press first (onShortcut); a menu bar sets itself here
    private TipView* tipView;
    private int tipTimer;
    private Widget* tipFor;
    private Widget* hoverWidget;
    private Widget* captureWidget;
    private bool dirty;
    private int dx0;
    private int dy0;
    private int dx1;
    private int dy1;

    public void setRoot(Widget* r) {
        root = r;
        r->attach(this);
        r->x = 0;
        r->y = 0;
        r->w = w;
        r->h = h;
        needLayout = true;
        invalidateAll();
    }

    // resizes the window to the preferred size of the content
    public void fit() {
        if (root == null) {
            return;
        }
        resize(root->prefW(), root->prefH());
    }

    public void invalidate(int x, int y, int rw, int rh) {
        int x1 = x + rw;
        int y1 = y + rh;
        if (x < 0) { x = 0; }
        if (y < 0) { y = 0; }
        if (x1 > w) { x1 = w; }
        if (y1 > h) { y1 = h; }
        if (x >= x1 || y >= y1) {
            return;
        }
        if (!dirty) {
            dx0 = x; dy0 = y; dx1 = x1; dy1 = y1;
            dirty = true;
        } else {
            if (x < dx0) { dx0 = x; }
            if (y < dy0) { dy0 = y; }
            if (x1 > dx1) { dx1 = x1; }
            if (y1 > dy1) { dy1 = y1; }
        }
    }

    public void invalidateAll() {
        invalidate(0, 0, w, h);
    }

    // shows p above the whole window. p covers the window (its own children are laid out by p itself); it gets the mouse
    // and keyboard events until closePopup() or until it is dismissed.
    public void showPopup(Widget* p) {
        closePopup();
        hideTip();
        popup = p;
        p->parent = null;
        p->x = 0;
        p->y = 0;
        p->w = w;
        p->h = h;
        p->attach(this);
        p->layout();
        captureWidget = null;
        invalidateAll();
    }

    public void closePopup() {
        if (popup == null) {
            return;
        }
        Widget* p = popup;
        popup = null;
        captureWidget = null;
        hoverWidget = null;
        p->attach(null);
        invalidateAll();
        p->onDismiss();
    }

    // ---- tooltips ------------------------------------------------------------------------------------------------------------------
    public bool tipVisible() { return tipView != null; }

    public void hideTip() {
        if (tipTimer != 0) {
            display->cancel(tipTimer);
            tipTimer = 0;
        }
        if (tipView != null) {
            tipView = null;
            invalidateAll();
        }
    }

    public void showTip() {
        tipTimer = 0;
        if (tipFor == null || tipFor->tooltip == null || popup != null || closed) {
            return;
        }
        tipView = new TipView(tipFor->tooltip);
        int tx = lastMouseX + 12;
        int ty = lastMouseY + 20;
        if (tx + tipView->w > w) { tx = w - tipView->w; }
        if (tx < 0) { tx = 0; }
        if (ty + tipView->h > h) { ty = lastMouseY - tipView->h - 6; }
        if (ty < 0) { ty = 0; }
        tipView->x = tx;
        tipView->y = ty;
        invalidateAll();
    }

    public void setFocus(Widget* wd) {
        if (wd == focusWidget) {
            return;
        }
        Widget* old = focusWidget;
        focusWidget = wd;
        if (wd != null) {
            Widget* anc = wd->parent;
            while (anc != null) {
                anc->reveal(wd);
                anc = anc->parent;
            }
        }
        if (old != null) {
            old->onFocus(false);
            old->invalidate();
        }
        if (wd != null) {
            wd->onFocus(true);
            wd->invalidate();
        }
    }

    // the next (or previous) widget that can take the focus, in tree order
    private void collect(Widget* wd, Widget** list, int* n) {
        if (!wd->visible || !wd->enabled) {
            return;
        }
        if (wd->focusable && *n < 64) {
            list[*n] = wd;
            *n = *n + 1;
        }
        for (int i = 0; i < wd->nkids; i++) {
            collect(wd->kids[i], list, n);
        }
    }

    public void focusNext(int dir) {
        if (root == null) {
            return;
        }
        Widget* list[64];
        int n = 0;
        collect(root, &list[0], &n);
        if (n == 0) {
            return;
        }
        int at = -1;
        for (int i = 0; i < n; i++) {
            if (list[i] == focusWidget) {
                at = i;
            }
        }
        int next = (at < 0) ? ((dir > 0) ? 0 : n - 1) : (at + dir + n) % n;
        setFocus(list[next]);
    }

    // ---- painting and presenting ---------------------------------------------------------------------------------------------
    public void update() {
        if (closed) {
            return;
        }
        if (needLayout && root != null) {
            needLayout = false;
            root->w = w;
            root->h = h;
            root->layout();
            invalidateAll();
        }
        if (!dirty) {
            return;
        }
        dirty = false;
        surf->setClip(dx0, dy0, dx1 - dx0, dy1 - dy0);
        if (!noClear) {
            surf->fill(0, 0, w, h, cBack);
        }
        if (root != null) {
            root->paintTree(surf, 0, 0);
        }
        if (popup != null) {
            popup->paintTree(surf, popup->x, popup->y);
        }
        if (tipView != null) {
            tipView->paintTree(surf, tipView->x, tipView->y);
        }
        surf->resetClip();
        display->sendPresent(this, dx0, dy0, dx1 - dx0, dy1 - dy0);
    }

    // ---- requests to the server ----------------------------------------------------------------------------------------------
    public void setTitle(char* t) {
        title = strdup(t);
        display->sendText(adp.Q_TITLE, id, title);
    }

    public void move(int x, int y) {
        display->send3(adp.Q_MOVE, id, x, y);
    }

    // asks for another size of the client area
    public void resize(int nw, int nh) {
        if (nw < 1) { nw = 1; }
        if (nh < 1) { nh = 1; }
        w = nw;
        h = nh;
        surf->resize(nw, nh);
        display->send3(adp.Q_RESIZE, id, nw, nh);
        if (root != null) {
            root->w = nw;
            root->h = nh;
        }
        needLayout = true;
        invalidateAll();
    }

    public void show() { display->send3(adp.Q_VISIBLE, id, 1, 0); }
    public void hide() { display->send3(adp.Q_VISIBLE, id, 0, 0); }
    public void raise() { display->send3(adp.Q_RAISE, id, 0, 0); }
    public void focusWindow() { display->send3(adp.Q_FOCUS, id, 0, 0); }
    public void setCursor(int shape) { display->send3(adp.Q_CURSOR, id, shape, 0); }

    public void close() {
        if (closed) {
            return;
        }
        closed = true;
        hideTip();
        display->send3(adp.Q_DESTROY, id, 0, 0);
        display->windowClosed(this);
    }

    // ---- events from the server ----------------------------------------------------------------------------------------------
    public void handleMouse(int kind, int button, int mx, int my, int mods) {
        lastMouseX = mx;
        lastMouseY = my;
        lastMouseKind = kind;
        lastMouseButton = button;
        if (onMouseRaw != null) {
            onMouseRaw(this);
        }
        if (root == null) {
            return;
        }
        Widget* top = (popup != null) ? popup : root;
        Widget* target = captureWidget;
        if (target == null) {
            target = top->hit(mx - top->x, my - top->y);
        }
        if (kind == adp.M_MOVE || kind == adp.M_DOWN) {
            Widget* under = top->hit(mx - top->x, my - top->y);
            if (under != hoverWidget) {
                if (hoverWidget != null) {
                    hoverWidget->onHover(false);
                }
                hoverWidget = under;
                if (under != null) {
                    under->onHover(true);
                }
                hideTip();
                tipFor = under;
            }
            if (kind == adp.M_DOWN) {
                hideTip();
            } else if (tipView == null && tipTimer == 0 && under != null && under->tooltip != null && popup == null) {
                tipTimer = display->after(500, tipFire, (int) this);
            }
        }
        if (target == null) {
            return;
        }
        if (kind == adp.M_DOWN) {
            if (captureWidget == null) {
                captureWidget = target;
            }
            if (popup == null) {
                Widget* f = target;
                while (f != null && !f->focusable) {
                    f = f->parent;
                }
                if (f != null) {
                    setFocus(f);
                }
            }
            if (button == 3 && target->onContext != null && popup == null) {
                target->onContext(target);
            }
        }
        if (kind == adp.M_SCROLL) {
            // the wheel goes to the first widget (from the one under the pointer upwards) that uses it
            Widget* t = target;
            while (t != null) {
                if (t->wantsScroll() && t->onMouse(kind, button, mx - t->absX(), my - t->absY(), mods)) {
                    break;
                }
                t = t->parent;
            }
        } else {
            target->onMouse(kind, button, mx - target->absX(), my - target->absY(), mods);
        }
        if (kind == adp.M_UP) {
            captureWidget = null;
        }
    }

    public void handleLeave() {
        if (hoverWidget != null) {
            hoverWidget->onHover(false);
            hoverWidget = null;
        }
    }

    public void handleKey(int down, int key, int uni, int mods) {
        if (popup != null) {
            Widget* p = popup;
            if (!p->onKey(down, key, uni, mods) && down != 0 && key == adp.KEY_ESCAPE) {
                closePopup();
            }
            return;
        }
        if (down != 0) {
            hideTip();
            if (keyPreview != null && keyPreview->enabled && keyPreview->onShortcut(key, uni, mods)) {
                return;
            }
        }
        bool done = false;
        if (focusWidget != null && focusWidget->enabled) {
            done = focusWidget->onKey(down, key, uni, mods);
        }
        if (!done && down != 0) {
            if (key == adp.KEY_TAB) {
                focusNext(((mods & adp.MOD_SHIFT) != 0) ? -1 : 1);
                done = true;
            } else if (key == adp.KEY_ENTER && defaultButton != null && defaultButton->enabled) {
                Button* b = (Button*) defaultButton;
                b->click();
                done = true;
            }
        }
        if (!done && down != 0 && onKey != null) {
            onKey(this, key, uni);
        }
    }

    public void handleResize(int nw, int nh) {
        closePopup();
        resize(nw, nh);
        if (onResize != null) {
            onResize(this);
        }
    }
}

// =============================================================================
//  the connection
// =============================================================================
// a window of any client as the display server lists it (for taskbars)
public class WinInfo {
    public int gid;
    public int state;               // adp.WS_MINIMIZED | WS_FOCUSED | WS_MAXIMIZED
    public int owner;               // client number
    public char* title;
}

public class Display {
    public int fd;
    public int clientNum;
    public int screenW;
    public int screenH;
    public bool connected;
    public bool quit;
    public char* clipText;
    private adp.Bytes* in;
    private adp.Bytes* outq;
    private adp.Bytes* msg;
    private Window** windows;
    private int nwin;
    private int nextId;
    private int* timerDue;
    private int* timerArg;
    private func* timerFn;
    private int* timerId;
    private int nextTimer;
    private TextBox* pasteTarget;
    private TextArea* pasteArea;
    private Widget* pasteWidget;
    private int* watchFd;
    private func* watchFn;
    private int* watchArg;
    private int nwatch;
    private bool welcomed;
    public char* cookie;            // the shared secret as hex text, for servers that ask for one
    public bool denied;             // the server did not accept the cookie (or there was none)
    public func onWinList;          // int f(int display): winList holds the answer to requestWindowList()
    public WinInfo** winList;
    public int nWinList;

    public Display(int handle) {
        fd = handle;
        connected = true;
        in = new adp.Bytes();
        outq = new adp.Bytes();
        msg = new adp.Bytes();
        windows = (Window**) calloc(64, 8);
        timerDue = (int*) calloc(32, 8);
        timerArg = (int*) calloc(32, 8);
        timerFn = (func*) calloc(32, 8);
        timerId = (int*) calloc(32, 8);
        watchFd = (int*) calloc(64, 8);
        watchFn = (func*) calloc(64, 8);
        watchArg = (int*) calloc(64, 8);
        nextId = 1;
        nextTimer = 1;
        clipText = "";
    }

    // ---- output: messages are queued and sent as the socket takes them -----------------------------------------------------------------
    private void queue() {
        msg->finish();
        outq->addBytes(msg->data, msg->len);
        flushOut();
    }

    // sends what the socket accepts right now; returns true when everything is out
    public bool flushOut() {
        int sent = 0;
        while (sent < outq->len && connected) {
            if (!net.waitWritable(fd, 0)) {
                break;
            }
            int n = outq->len - sent;
            if (n > 16384) { n = 16384; }
            if (__OS != 1) {
                // never block: sendto with MSG_DONTWAIT takes what fits. A blocking send would hang a program whose display
                // server runs in the same thread (the display manager) as soon as the socket buffer is nearly full
                int k = __syscall(__ARCH == 0 ? 44 : 206, fd, (int) &outq->data[sent], n, 0x40, 0, 0);
                if (k == -11) {
                    break;
                }
                if (k < 0) {
                    connected = false;
                    break;
                }
                sent = sent + k;
                continue;
            }
            if (net.send(fd, &outq->data[sent], n) < 0) {
                connected = false;
                break;
            }
            sent = sent + n;
        }
        if (sent > 0) {
            outq->consume(sent);
        }
        return outq->len == 0;
    }

    // waits until everything has been sent
    public void sync() {
        while (connected && !flushOut()) {
            if (idleHook != null) {
                idleHook(0);
            }
            net.waitWritable(fd, 50);
        }
    }

    public void send3(int op, int id, int a, int b) {
        msg->begin(op);
        msg->add32(id);
        msg->add32(a);
        msg->add32(b);
        queue();
    }

    public void sendText(int op, int id, char* text) {
        msg->begin(op);
        msg->add32(id);
        msg->addText(text);
        queue();
    }

    public void sendPresent(Window* w, int x, int y, int rw, int rh) {
        msg->begin(adp.Q_PRESENT);
        msg->add32(w->id);
        msg->add32(x);
        msg->add32(y);
        msg->add32(rw);
        msg->add32(rh);
        msg->reserve(rw * rh * 4);
        int n = w->surf->pack(x, y, rw, rh, &msg->data[msg->len]);
        msg->len = msg->len + n;
        queue();
    }

    // asks the server for the normal windows of all clients; the answer arrives later and calls onWinList
    public void requestWindowList() {
        msg->begin(adp.Q_LISTWIN);
        queue();
    }

    // activate (restores and focuses), minimize, close or maximize a window of any client (adp.WC_*)
    public void windowCommand(int gid, int cmd) {
        msg->begin(adp.Q_WINCMD);
        msg->add32(gid);
        msg->add32(cmd);
        queue();
    }

    public void setClipboard(char* t) {
        clipText = strdup(t);
        msg->begin(adp.Q_CLIPSET);
        msg->addText(t);
        queue();
    }

    public void requestPaste(TextBox* t) {
        pasteTarget = t;
        msg->begin(adp.Q_CLIPGET);
        queue();
    }

    // asks the display server for the clipboard; the text goes to wd->onPaste(text)
    public void requestPasteTo(Widget* wd) {
        pasteWidget = wd;
        msg->begin(adp.Q_CLIPGET);
        queue();
    }

    // calls f(arg) whenever there is something to read on the descriptor fdv (a pipe, a terminal, a socket); at most 64
    public bool watch(int fdv, func f, int arg) {
        if (nwatch >= 64) {
            return false;
        }
        watchFd[nwatch] = fdv;
        watchFn[nwatch] = f;
        watchArg[nwatch] = arg;
        nwatch++;
        return true;
    }

    public void unwatch(int fdv) {
        for (int i = 0; i < nwatch; i++) {
            if (watchFd[i] == fdv) {
                for (int j = i; j < nwatch - 1; j++) {
                    watchFd[j] = watchFd[j + 1];
                    watchFn[j] = watchFn[j + 1];
                    watchArg[j] = watchArg[j + 1];
                }
                nwatch--;
                return;
            }
        }
    }

    public void requestPasteArea(TextArea* t) {
        pasteArea = t;
        msg->begin(adp.Q_CLIPGET);
        queue();
    }

    // ---- windows ---------------------------------------------------------------------------------------------------------------------
    public Window* createWindow(char* title, int w, int h, int flags) {
        return createWindowAt(title, -1, -1, w, h, flags);
    }

    public Window* createWindowAt(char* title, int x, int y, int w, int h, int flags) {
        if (nwin >= 63) {
            return null;
        }
        Window* win = new Window();
        win->id = nextId;
        nextId++;
        win->display = this;
        win->title = strdup(title);
        win->w = w;
        win->h = h;
        win->flags = flags;
        win->surf = new gfx.Surface(w, h);
        win->surf->clear(cBack);
        windows[nwin] = win;
        nwin++;
        msg->begin(adp.Q_CREATE);
        msg->add32(win->id);
        msg->add32(x);
        msg->add32(y);
        msg->add32(w);
        msg->add32(h);
        msg->add32(flags);
        msg->addText(title);
        queue();
        win->invalidateAll();
        return win;
    }

    public void windowClosed(Window* w) {
        for (int i = 0; i < nwin; i++) {
            if (windows[i] == w) {
                for (int j = i; j < nwin - 1; j++) {
                    windows[j] = windows[j + 1];
                }
                nwin--;
                break;
            }
        }
        if (nwin == 0) {
            quit = true;
        }
    }

    public int windowCount() { return nwin; }

    private Window* find(int id) {
        for (int i = 0; i < nwin; i++) {
            if (windows[i]->id == id) {
                return windows[i];
            }
        }
        return null;
    }

    // ---- timers ----------------------------------------------------------------------------------------------------------------------
    // calls f(arg) once after ms milliseconds; returns a number for cancel()
    public int after(int ms, func f, int arg) {
        for (int i = 0; i < 32; i++) {
            if (timerFn[i] == null) {
                timerDue[i] = millis() + ms;
                timerArg[i] = arg;
                timerFn[i] = f;
                timerId[i] = nextTimer;
                nextTimer++;
                return timerId[i];
            }
        }
        return -1;
    }

    public void cancel(int id) {
        for (int i = 0; i < 32; i++) {
            if (timerFn[i] != null && timerId[i] == id) {
                timerFn[i] = null;
            }
        }
    }

    private int nextDue(int now, int limit) {
        int wait = limit;
        for (int i = 0; i < 32; i++) {
            if (timerFn[i] != null) {
                int d = timerDue[i] - now;
                if (d < 0) { d = 0; }
                if (d < wait) { wait = d; }
            }
        }
        return wait;
    }

    private void runTimers() {
        int now = millis();
        for (int i = 0; i < 32; i++) {
            if (timerFn[i] != null && timerDue[i] - now <= 0) {
                func f = timerFn[i];
                int a = timerArg[i];
                timerFn[i] = null;
                f(a);
            }
        }
    }

    // ---- events ----------------------------------------------------------------------------------------------------------------------
    private void handle(int op, char* p, int len) {
        if (op == adp.E_AUTH && len >= 16) {
            char* raw = malloc(300);
            int n = (cookie != null) ? secure.fromHex(cookie, raw, 256) : -1;
            if (n < 16) {
                denied = true;
                connected = false;
                return;
            }
            char mac[32];
            hash.hmacSha256(raw, n, p, 16, &mac[0]);
            msg->begin(adp.Q_AUTH);
            msg->addBytes(&mac[0], 32);
            queue();
            return;
        }
        if (op == adp.E_DENIED) {
            denied = true;
            connected = false;
            return;
        }
        if (op == adp.E_WELCOME && len >= 16) {
            clientNum = adp.get32(p, 4);
            screenW = adp.get32(p, 8);
            screenH = adp.get32(p, 12);
            welcomed = true;
            return;
        }
        if (op == adp.E_CLIP) {
            char* t = malloc(len + 1);
            memcpy(t, p, len);
            t[len] = 0;
            clipText = t;
            if (pasteTarget != null) {
                TextBox* tb = pasteTarget;
                pasteTarget = null;
                tb->paste(t);
            }
            if (pasteArea != null) {
                TextArea* ta = pasteArea;
                pasteArea = null;
                ta->paste(t);
            }
            if (pasteWidget != null) {
                Widget* pw = pasteWidget;
                pasteWidget = null;
                pw->onPaste(t);
            }
            return;
        }
        if (op == adp.E_WINLIST && len >= 4) {
            int count = adp.get32(p, 0);
            WinInfo** list = (WinInfo**) calloc(count + 1, 8);
            int at = 4;
            int n = 0;
            for (int i = 0; i < count && at + 16 <= len; i++) {
                WinInfo* wi = new WinInfo();
                wi->gid = adp.get32(p, at);
                wi->state = adp.get32(p, at + 4);
                wi->owner = adp.get32(p, at + 8);
                int tl = adp.get32(p, at + 12);
                if (tl < 0 || at + 16 + tl > len) {
                    break;
                }
                char* t = malloc(tl + 1);
                memcpy(t, &p[at + 16], tl);
                t[tl] = 0;
                wi->title = t;
                list[n] = wi;
                n++;
                at = at + 16 + tl;
            }
            winList = list;
            nWinList = n;
            if (onWinList != null) {
                onWinList(this);
            }
            return;
        }
        if (len < 4) {
            return;
        }
        Window* w = find(adp.get32(p, 0));
        if (w == null) {
            return;
        }
        if (op == adp.E_MOUSE && len >= 24) {
            w->handleMouse(adp.get32(p, 4), adp.get32(p, 8), adp.get32(p, 12), adp.get32(p, 16), adp.get32(p, 20));
        } else if (op == adp.E_KEY && len >= 20) {
            w->handleKey(adp.get32(p, 4), adp.get32(p, 8), adp.get32(p, 12), adp.get32(p, 16));
        } else if (op == adp.E_FOCUS && len >= 8) {
            w->focused = adp.get32(p, 4) != 0;
            if (w->focusWidget != null) {
                w->focusWidget->onFocus(w->focused);
            }
        } else if (op == adp.E_CLOSE) {
            if (w->onClose == null || w->onClose(w) == 0) {
                w->close();
            }
        } else if (op == adp.E_RESIZE && len >= 12) {
            w->handleResize(adp.get32(p, 4), adp.get32(p, 8));
        } else if (op == adp.E_EXPOSE) {
            w->invalidateAll();
        } else if (op == adp.E_CROSS && len >= 8) {
            if (adp.get32(p, 4) == 0) {
                w->handleLeave();
            }
        }
    }

    private void readInput() {
        in->reserve(65536);
        int n = net.recv(fd, &in->data[in->len], 65536);
        if (n <= 0) {
            connected = false;
            return;
        }
        in->len = in->len + n;
        for (;;) {
            int size = adp.messageSize(in);
            if (size < 0) {
                connected = false;
                return;
            }
            if (size == 0) {
                break;
            }
            handle(adp.get32(in->data, 4), &in->data[8], size - 8);
            in->consume(size);
        }
    }

    // repaints the windows that changed
    public void update() {
        for (int i = 0; i < nwin; i++) {
            windows[i]->update();
        }
    }

    // processes events for up to ms milliseconds (returns earlier when there was something to do)
    public void pump(int ms) {
        update();
        flushOut();
        if (!connected) {
            quit = true;
            return;
        }
        int wait = nextDue(millis(), ms);
        int h[65];
        int ev[65];
        int rev[65];
        h[0] = fd;
        ev[0] = net.READABLE;
        rev[0] = 0;
        for (int i = 0; i < nwatch; i++) {
            h[1 + i] = watchFd[i];
            ev[1 + i] = net.READABLE;
            rev[1 + i] = 0;
        }
        int r = net.poll(&h[0], &ev[0], &rev[0], 1 + nwatch, wait);
        if (r > 0) {
            if ((rev[0] & (net.READABLE | net.HUNGUP | net.FAILED)) != 0) {
                readInput();
            }
            // the callbacks may add or remove watches, so they are collected first
            func fns[64];
            int args[64];
            int ready = 0;
            for (int i = 0; i < nwatch; i++) {
                if ((rev[1 + i] & (net.READABLE | net.HUNGUP | net.FAILED)) != 0) {
                    fns[ready] = watchFn[i];
                    args[ready] = watchArg[i];
                    ready++;
                }
            }
            for (int i = 0; i < ready; i++) {
                func f = fns[i];
                f(args[i]);
            }
        }
        runTimers();
        update();
        flushOut();
        if (!connected) {
            quit = true;
        }
    }

    // the main loop: until the last window is closed, the connection ends or quit is set
    public void run() {
        while (!quit && connected) {
            pump(50);
        }
        sync();
    }

    public void disconnect() {
        sync();
        connected = false;
        net.close(fd);
    }

    // waits for the greeting of the server
    public bool hello(char* name) {
        msg->begin(adp.Q_HELLO);
        msg->add32(adp.VERSION);
        msg->addText(name);
        queue();
        for (int i = 0; i < 60 && !welcomed && connected; i++) {
            if (idleHook != null) {
                idleHook(0);
            }
            pump(idleHook != null ? 0 : 50);
        }
        return welcomed;
    }
}

// connects to the display server named by spec (null: the ADISPLAY environment variable, or 127.0.0.1:7000); cookie is the
// shared secret as hex text (null: findCookie())
public Display* connectWith(char* spec, char* name, char* cookie) {
    char* s = spec;
    if (s == null) {
        s = getenv("ADISPLAY");
    }
    int port = adp.portOf(s);
    char* host = adp.hostOf(s);
    net.init();
    int h = net.connect(host, port);
    if (h < 0) {
        return null;
    }
    net.setNoDelay(h, true);
    Display* d = new Display(h);
    d->cookie = (cookie != null) ? cookie : adp.findCookie();
    if (!d->hello(name)) {
        net.close(h);
        return null;
    }
    return d;
}

public Display* connectAs(char* spec, char* name) {
    return connectWith(spec, name, null);
}

public Display* connect(char* spec) {
    return connectAs(spec, "gui");
}

// a small window with a message and an OK button; returns it (it closes itself)
int okClicked(int self) {
    Widget* b = (Widget*) self;
    b->win->close();
    return 0;
}

public Window* messageBox(Display* d, char* title, char* text) {
    Window* w = d->createWindow(title, 280, 110, adp.F_FIXED);
    Box* col = vbox(12, 14);
    col->add(new Label(text));
    Button* ok = new Button("OK");
    ok->primary = true;
    ok->onClick = okClicked;
    col->add(ok);
    w->setRoot(col);
    w->defaultButton = ok;
    w->fit();
    w->setFocus(ok);
    return w;
}
