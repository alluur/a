// =============================================================================
//  cstring - C <string.h>                                     import cstring;
//
//  The functions of the C header that the standard library (strlen, strcmp, strcpy, strcat, strdup,
//  memcpy, memset) does not already have, with the C names and arguments. Texts are NUL-terminated
//  `char*`, "memory" functions take `char*` and a byte count. It also imports cerrno, for `strerror`.
// =============================================================================
import cerrno;

char* __strtok_save;

// ---- memory -----------------------------------------------------------------------------------------------
// copies n bytes, also when the areas overlap; returns dst
char* memmove(char* dst, char* src, int n) {
    if (dst == src || n <= 0) {
        return dst;
    }
    if (dst < src) {
        for (int i = 0; i < n; i++) {
            dst[i] = src[i];
        }
    } else {
        for (int i = n - 1; i >= 0; i--) {
            dst[i] = src[i];
        }
    }
    return dst;
}

// <0, 0, >0 like strcmp, for n bytes
int memcmp(char* a, char* b, int n) {
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            return a[i] - b[i];
        }
    }
    return 0;
}

// address of the first byte equal to c in the first n bytes, null if there is none
char* memchr(char* s, int c, int n) {
    c = c & 255;
    for (int i = 0; i < n; i++) {
        if (s[i] == c) {
            return &s[i];
        }
    }
    return null;
}

// like memchr, but the last match
char* memrchr(char* s, int c, int n) {
    c = c & 255;
    for (int i = n - 1; i >= 0; i--) {
        if (s[i] == c) {
            return &s[i];
        }
    }
    return null;
}

// copies up to n bytes and stops after the first byte equal to c; returns the address after it, null if c was not found
char* memccpy(char* dst, char* src, int c, int n) {
    c = c & 255;
    for (int i = 0; i < n; i++) {
        dst[i] = src[i];
        if (src[i] == c) {
            return &dst[i + 1];
        }
    }
    return null;
}

// ---- copying and joining --------------------------------------------------------------------------------
// copies at most n characters and fills the rest of dst (up to n) with zero bytes; returns dst
char* strncpy(char* dst, char* src, int n) {
    int i = 0;
    while (i < n && src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    while (i < n) {
        dst[i] = 0;
        i++;
    }
    return dst;
}

// appends at most n characters of src, always adds the terminating zero; returns dst
char* strncat(char* dst, char* src, int n) {
    int d = strlen(dst);
    int i = 0;
    while (i < n && src[i] != 0) {
        dst[d + i] = src[i];
        i++;
    }
    dst[d + i] = 0;
    return dst;
}

// copies and returns the address of the terminating zero in dst
char* stpcpy(char* dst, char* src) {
    int i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return &dst[i];
}

// BSD safe copy: at most size-1 characters plus the zero; returns the length of src
int strlcpy(char* dst, char* src, int size) {
    int n = strlen(src);
    if (size > 0) {
        int c = n;
        if (c > size - 1) {
            c = size - 1;
        }
        for (int i = 0; i < c; i++) {
            dst[i] = src[i];
        }
        dst[c] = 0;
    }
    return n;
}

// BSD safe append: the result has at most size-1 characters; returns the length it would have had
int strlcat(char* dst, char* src, int size) {
    int d = 0;
    while (d < size && dst[d] != 0) {
        d++;
    }
    int n = strlen(src);
    if (d >= size) {
        return size + n;
    }
    int c = n;
    if (c > size - d - 1) {
        c = size - d - 1;
    }
    for (int i = 0; i < c; i++) {
        dst[d + i] = src[i];
    }
    dst[d + c] = 0;
    return d + n;
}

// a heap copy of at most n characters of s
char* strndup(char* s, int n) {
    int len = strnlen(s, n);
    char* r = alloc(len + 1);
    for (int i = 0; i < len; i++) {
        r[i] = s[i];
    }
    r[len] = 0;
    return r;
}

// ---- comparing ---------------------------------------------------------------------------------------------
int strncmp(char* a, char* b, int n) {
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) {
            return a[i] - b[i];
        }
        if (a[i] == 0) {
            return 0;
        }
    }
    return 0;
}

// comparison that ignores the case of ASCII letters
int strcasecmp(char* a, char* b) {
    int i = 0;
    for (;;) {
        int x = toLower(a[i]);
        int y = toLower(b[i]);
        if (x != y) {
            return x - y;
        }
        if (x == 0) {
            return 0;
        }
        i++;
    }
    return 0;
}

int strncasecmp(char* a, char* b, int n) {
    for (int i = 0; i < n; i++) {
        int x = toLower(a[i]);
        int y = toLower(b[i]);
        if (x != y) {
            return x - y;
        }
        if (x == 0) {
            return 0;
        }
    }
    return 0;
}

// locale comparison (the "C" locale: same as strcmp)
int strcoll(char* a, char* b) {
    return strcmp(a, b);
}

// locale transformation (the "C" locale: a copy); returns the length of src
int strxfrm(char* dst, char* src, int n) {
    return strlcpy(dst, src, n);
}

// ---- searching ---------------------------------------------------------------------------------------------
// length of s, but looks at no more than max characters
int strnlen(char* s, int max) {
    int n = 0;
    while (n < max && s[n] != 0) {
        n++;
    }
    return n;
}

// address of the first c (searching includes the terminating zero), null if there is none
char* strchr(char* s, int c) {
    c = c & 255;
    int i = 0;
    for (;;) {
        if (s[i] == c) {
            return &s[i];
        }
        if (s[i] == 0) {
            return null;
        }
        i++;
    }
    return null;
}

// address of the last c, null if there is none
char* strrchr(char* s, int c) {
    c = c & 255;
    char* found = null;
    int i = 0;
    for (;;) {
        if (s[i] == c) {
            found = &s[i];
        }
        if (s[i] == 0) {
            return found;
        }
        i++;
    }
    return null;
}

// address of the first occurrence of needle in hay, null if there is none
char* strstr(char* hay, char* needle) {
    int n = strlen(needle);
    if (n == 0) {
        return hay;
    }
    int i = 0;
    while (hay[i] != 0) {
        int k = 0;
        while (k < n && hay[i + k] == needle[k]) {
            k++;
        }
        if (k == n) {
            return &hay[i];
        }
        if (hay[i + k] == 0) {
            return null;
        }
        i++;
    }
    return null;
}

// case-insensitive strstr
char* strcasestr(char* hay, char* needle) {
    int n = strlen(needle);
    if (n == 0) {
        return hay;
    }
    int i = 0;
    while (hay[i] != 0) {
        int k = 0;
        while (k < n && toLower(hay[i + k]) == toLower(needle[k])) {
            k++;
        }
        if (k == n) {
            return &hay[i];
        }
        if (hay[i + k] == 0) {
            return null;
        }
        i++;
    }
    return null;
}

// number of leading characters of s that all appear in accept
int strspn(char* s, char* accept) {
    int i = 0;
    while (s[i] != 0 && strchr(accept, s[i]) != null) {
        i++;
    }
    return i;
}

// number of leading characters of s that do not appear in reject
int strcspn(char* s, char* reject) {
    int i = 0;
    while (s[i] != 0 && strchr(reject, s[i]) == null) {
        i++;
    }
    return i;
}

// address of the first character of s that appears in accept, null if there is none
char* strpbrk(char* s, char* accept) {
    int i = 0;
    while (s[i] != 0) {
        if (strchr(accept, s[i]) != null) {
            return &s[i];
        }
        i++;
    }
    return null;
}

// ---- splitting -----------------------------------------------------------------------------------------------
// splits s into tokens separated by any character of delim. The first call passes the text (it is
// modified: delimiters become zero bytes), the next calls pass null. Returns null after the last token.
char* strtok(char* s, char* delim) {
    return strtok_r(s, delim, &__strtok_save);
}

// like strtok, with the position kept in *save so that several splits can run at once
char* strtok_r(char* s, char* delim, char** save) {
    if (s == null) {
        s = *save;
    }
    if (s == null) {
        return null;
    }
    s = s + strspn(s, delim);
    if (s[0] == 0) {
        *save = null;
        return null;
    }
    int n = strcspn(s, delim);
    if (s[n] == 0) {
        *save = null;
    } else {
        s[n] = 0;
        *save = &s[n + 1];
    }
    return s;
}

// like strtok_r but empty tokens are returned too; *sp is the position, null when the text is used up
char* strsep(char** sp, char* delim) {
    char* s = *sp;
    if (s == null) {
        return null;
    }
    int n = strcspn(s, delim);
    if (s[n] == 0) {
        *sp = null;
    } else {
        s[n] = 0;
        *sp = &s[n + 1];
    }
    return s;
}
