// =============================================================================
//  utf8 - UTF-8 text                                         import utf8;
//  Code points are plain ints. Strings stay normal char* (bytes).
// =============================================================================
module utf8;

// bytes in the sequence that starts with byte b (1 for invalid bytes)
private int seqLength(int b) {
    if (b < 0x80) return 1;
    if (b >= 0xC2 && b < 0xE0) return 2;
    if (b >= 0xE0 && b < 0xF0) return 3;
    if (b >= 0xF0 && b < 0xF5) return 4;
    return 1;
}

// decodes the code point at byte offset pos into *cp and returns how many bytes it used;
// invalid bytes decode as U+FFFD using 1 byte
public int decode(char* s, int pos, int* cp) {
    int b = s[pos];
    int n = seqLength(b);
    if (n == 1) {
        if (b < 0x80) {
            *cp = b;
        } else {
            *cp = 0xFFFD;
        }
        return 1;
    }
    int v = b & (0xFF >> (n + 1));
    for (int i = 1; i < n; i++) {
        int c = s[pos + i];
        if ((c & 0xC0) != 0x80) {
            *cp = 0xFFFD;
            return 1;
        }
        v = (v << 6) | (c & 0x3F);
    }
    *cp = v;
    return n;
}

// writes the UTF-8 form of cp to out (up to 4 bytes) and returns the byte count
public int encode(int cp, char* out) {
    if (cp < 0x80) {
        out[0] = cp;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = 0xC0 | (cp >> 6);
        out[1] = 0x80 | (cp & 0x3F);
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = 0xE0 | (cp >> 12);
        out[1] = 0x80 | ((cp >> 6) & 0x3F);
        out[2] = 0x80 | (cp & 0x3F);
        return 3;
    }
    out[0] = 0xF0 | (cp >> 18);
    out[1] = 0x80 | ((cp >> 12) & 0x3F);
    out[2] = 0x80 | ((cp >> 6) & 0x3F);
    out[3] = 0x80 | (cp & 0x3F);
    return 4;
}

// number of code points
public int length(char* s) {
    int n = 0;
    int pos = 0;
    while (s[pos] != 0) {
        int cp;
        pos = pos + decode(s, pos, &cp);
        n++;
    }
    return n;
}

// true if the whole text is well formed UTF-8
public bool isValid(char* s) {
    int pos = 0;
    while (s[pos] != 0) {
        int cp;
        int used = decode(s, pos, &cp);
        if (cp == 0xFFFD && !(s[pos] == 0xEF && s[pos + 1] == 0xBF && s[pos + 2] == 0xBD)) {
            return false;
        }
        pos = pos + used;
    }
    return true;
}

// byte offset of code point number index (strlen(s) when index is past the end)
public int byteOffset(char* s, int index) {
    int pos = 0;
    for (int i = 0; i < index && s[pos] != 0; i++) {
        int cp;
        pos = pos + decode(s, pos, &cp);
    }
    return pos;
}

// stores up to max code points into out, returns how many
public int toCodepoints(char* s, int* out, int max) {
    int n = 0;
    int pos = 0;
    while (s[pos] != 0 && n < max) {
        int cp;
        pos = pos + decode(s, pos, &cp);
        out[n] = cp;
        n++;
    }
    return n;
}

// new string from n code points
public char* fromCodepoints(int* cps, int n) {
    char* out = alloc(n * 4 + 1);
    int o = 0;
    for (int i = 0; i < n; i++) {
        o = o + encode(cps[i], &out[o]);
    }
    return out;
}

// reverses by code point (so multi byte characters stay intact)
public char* reverse(char* s) {
    int cps[1024];
    int n = toCodepoints(s, cps, 1024);
    for (int i = 0; i < n / 2; i++) {
        int t = cps[i];
        cps[i] = cps[n - 1 - i];
        cps[n - 1 - i] = t;
    }
    return fromCodepoints(cps, n);
}
