// =============================================================================
//  guix - more widgets for gui: menus, combo boxes, radio buttons, tabs, scrolling, spin boxes, splitters, dialogs
//                                                                                              import guix;
//
//    guix.MenuBar* bar = new guix.MenuBar();
//    guix.Menu* file = bar->addMenu("&File");                    // & marks the key for Alt+F
//    file->add("Open...", openFile)->accel("Ctrl+O");            // int openFile(int item) { ... return 0; }
//    file->addSeparator();
//    file->add("Quit", quit)->accel("Ctrl+Q");
//    guix.Menu* view = bar->addMenu("&View");
//    view->addCheck("Word wrap", true, wrapChanged);
//    col->add(bar);                                              // put it at the top of the window
//
//  Context menus   widget->onContext = f;   and in f:   menu->popup(widget->win, widget->win->lastMouseX, widget->win->lastMouseY);
//  Widgets         MenuBar  Menu  ComboBox  RadioButton/RadioGroup  TabView  ScrollView  ScrollBar  SpinBox  Splitter  Swatch
//  Dialogs         confirm  prompt  openFile  saveFile  chooseColor      (they open a window, call your function with the result and close)
//  Tooltips        widget->tooltip = "text" (a field of every gui.Widget)
// =============================================================================
import gui;
import gfx;
import adp;
import os;
import path;
import cstdlib;
import cunistd;
import cstring;
module guix;

class Menu;
class MenuBar;
class MenuStack;
class ComboBox;
class RadioButton;

private bool hasPrefix(char* s, char* pre) {
    return startsWith(s, pre);
}

// =============================================================================
//  menus
// =============================================================================
public class MenuItem {
    public char* text;
    public char* accelText;         // shown at the right edge, for example "Ctrl+S"
    public int key;                 // the accelerator: a lower case letter or one of adp.KEY_*  (0 = none)
    public int mods;
    public func onSelect;           // int f(int item)  (cast: (guix.MenuItem*) item)
    public int id;
    public int userData;
    public bool checkable;
    public bool checked;
    public bool enabled;
    public bool separator;
    public Menu* sub;

    public MenuItem(char* t) {
        text = strdup(t);
        accelText = "";
        enabled = true;
    }

    // sets the accelerator from a text such as "Ctrl+S", "Ctrl+Shift+Z", "F5", "Alt+Enter", "Del"
    public MenuItem* accel(char* spec) {
        accelText = strdup(spec);
        key = 0;
        mods = 0;
        char* p = spec;
        bool more = true;
        while (more) {
            more = false;
            if (hasPrefix(p, "Ctrl+")) { mods = mods | adp.MOD_CTRL; p = p + 5; more = true; }
            else if (hasPrefix(p, "Shift+")) { mods = mods | adp.MOD_SHIFT; p = p + 6; more = true; }
            else if (hasPrefix(p, "Alt+")) { mods = mods | adp.MOD_ALT; p = p + 4; more = true; }
            else if (hasPrefix(p, "Meta+")) { mods = mods | adp.MOD_META; p = p + 5; more = true; }
        }
        if (strlen(p) == 1) {
            key = toLower(p[0]);
        } else if (p[0] == 'F' && p[1] >= '0' && p[1] <= '9') {
            key = adp.KEY_F1 + atoi(&p[1]) - 1;
        } else if (streq(p, "Enter")) { key = adp.KEY_ENTER; }
        else if (streq(p, "Esc")) { key = adp.KEY_ESCAPE; }
        else if (streq(p, "Del")) { key = adp.KEY_DELETE; }
        else if (streq(p, "Tab")) { key = adp.KEY_TAB; }
        else if (streq(p, "Space")) { key = adp.KEY_SPACE; }
        else if (streq(p, "Backspace")) { key = adp.KEY_BACKSPACE; }
        else if (streq(p, "Home")) { key = adp.KEY_HOME; }
        else if (streq(p, "End")) { key = adp.KEY_END; }
        else if (streq(p, "Up")) { key = adp.KEY_UP; }
        else if (streq(p, "Down")) { key = adp.KEY_DOWN; }
        else if (streq(p, "Left")) { key = adp.KEY_LEFT; }
        else if (streq(p, "Right")) { key = adp.KEY_RIGHT; }
        else if (streq(p, "PgUp")) { key = adp.KEY_PGUP; }
        else if (streq(p, "PgDn")) { key = adp.KEY_PGDN; }
        else if (streq(p, "Ins")) { key = adp.KEY_INSERT; }
        return this;
    }

    public MenuItem* setId(int v) {
        id = v;
        return this;
    }

    public MenuItem* disable() {
        enabled = false;
        return this;
    }

    // runs the item as if it had been chosen
    public void invoke() {
        if (!enabled || separator) {
            return;
        }
        if (checkable) {
            checked = !checked;
        }
        if (onSelect != null) {
            onSelect(this);
        }
    }
}

public class Menu {
    public MenuItem** items;
    public int count;
    public char* title;
    private int cap;

    public Menu() {
        cap = 8;
        items = (MenuItem**) calloc(cap, 8);
        title = "";
    }

    private MenuItem* push(MenuItem* it) {
        if (count == cap) {
            cap = cap * 2;
            items = (MenuItem**) realloc((char*) items, cap * 8);
        }
        items[count] = it;
        count++;
        return it;
    }

    public MenuItem* add(char* text, func f) {
        MenuItem* it = new MenuItem(text);
        it->onSelect = f;
        return push(it);
    }

    public MenuItem* addCheck(char* text, bool checked, func f) {
        MenuItem* it = new MenuItem(text);
        it->onSelect = f;
        it->checkable = true;
        it->checked = checked;
        return push(it);
    }

    public MenuItem* addSub(char* text, Menu* m) {
        MenuItem* it = new MenuItem(text);
        it->sub = m;
        return push(it);
    }

    public void addSeparator() {
        MenuItem* it = new MenuItem("");
        it->separator = true;
        push(it);
    }

    public void clear() {
        count = 0;
    }

    public MenuItem* byId(int id) {
        for (int i = 0; i < count; i++) {
            if (items[i]->id == id && !items[i]->separator) {
                return items[i];
            }
            if (items[i]->sub != null) {
                MenuItem* r = items[i]->sub->byId(id);
                if (r != null) {
                    return r;
                }
            }
        }
        return null;
    }

    // runs the item whose accelerator is key+mods (also in the submenus); true if there was one
    public bool dispatch(int key, int mods) {
        for (int i = 0; i < count; i++) {
            MenuItem* it = items[i];
            if (it->sub != null) {
                if (it->enabled && it->sub->dispatch(key, mods)) {
                    return true;
                }
            } else if (it->key != 0 && it->key == key && it->mods == (mods & (adp.MOD_CTRL | adp.MOD_ALT | adp.MOD_SHIFT | adp.MOD_META))) {
                if (it->enabled) {
                    it->invoke();
                }
                return true;
            }
        }
        return false;
    }

    // shows the menu as a context menu at a position in the window
    public void popup(gui.Window* w, int x, int y) {
        MenuStack* st = new MenuStack(null, -1);
        st->w = w->w;
        st->h = w->h;
        st->open(this, x, y, y);
        w->showPopup(st);
    }
}

// ---- the popup that shows a menu and the submenus that are open ---------------------------------------------------------------------
const ITEM_H = 24;
const SEP_H = 9;
const PANEL_PAD = 4;

class MenuStack : gui.Widget {
    private Menu** menus;
    private int* px;
    private int* py;
    private int* pw;
    private int* ph;
    private int* hot;
    private int depth;
    private MenuBar* bar;
    private int barIndex;

    public MenuStack(MenuBar* b, int index) {
        super();
        menus = (Menu**) calloc(8, 8);
        px = (int*) calloc(8, 8);
        py = (int*) calloc(8, 8);
        pw = (int*) calloc(8, 8);
        ph = (int*) calloc(8, 8);
        hot = (int*) calloc(8, 8);
        bar = b;
        barIndex = index;
    }

    private int widthOf(Menu* m) {
        int best = 120;
        gfx.Font* f = gfx.sans();
        for (int i = 0; i < m->count; i++) {
            MenuItem* it = m->items[i];
            if (it->separator) {
                continue;
            }
            int need = 24 + gfx.textWidth(f, it->text) + 28;
            if (strlen(it->accelText) > 0) {
                need = need + 24 + gfx.textWidth(f, it->accelText);
            }
            if (need > best) {
                best = need;
            }
        }
        return best;
    }

    private int heightOf(Menu* m) {
        int total = PANEL_PAD * 2;
        for (int i = 0; i < m->count; i++) {
            total = total + (m->items[i]->separator ? SEP_H : ITEM_H);
        }
        return total;
    }

    // adds a panel for menu m with its top left corner at (x, y); altY is where the panel goes (its bottom edge) when it does not fit below
    public void open(Menu* m, int x, int y, int altY) {
        if (depth >= 8) {
            return;
        }
        int wd = widthOf(m);
        int ht = heightOf(m);
        if (x + wd > w) { x = w - wd; }
        if (x < 0) { x = 0; }
        if (y + ht > h) {
            y = (altY >= ht) ? altY - ht : h - ht;
        }
        if (y < 0) { y = 0; }
        menus[depth] = m;
        px[depth] = x;
        py[depth] = y;
        pw[depth] = wd;
        ph[depth] = ht;
        hot[depth] = -1;
        depth++;
    }

    private void openSub(int panel, int idx) {
        MenuItem* it = menus[panel]->items[idx];
        if (it->sub == null || !it->enabled) {
            return;
        }
        if (depth > panel + 1 && menus[panel + 1] == it->sub) {
            return;
        }
        depth = panel + 1;
        int y = py[panel] + PANEL_PAD + rowTop(panel, idx);
        int wd = widthOf(it->sub);
        int x = px[panel] + pw[panel] - 2;
        if (x + wd > w) {
            x = px[panel] - wd + 2;
        }
        open(it->sub, x, y - PANEL_PAD, y + ITEM_H + PANEL_PAD);
        invalidate();
    }

    // distance of the top of row idx from the first row of panel
    private int rowTop(int panel, int idx) {
        int t = 0;
        Menu* m = menus[panel];
        for (int i = 0; i < idx; i++) {
            t = t + (m->items[i]->separator ? SEP_H : ITEM_H);
        }
        return t;
    }

    private int panelAt(int mx, int my) {
        for (int i = depth - 1; i >= 0; i--) {
            if (mx >= px[i] && my >= py[i] && mx < px[i] + pw[i] && my < py[i] + ph[i]) {
                return i;
            }
        }
        return -1;
    }

    private int itemAt(int panel, int mx, int my) {
        if (my < py[panel] + PANEL_PAD || mx < px[panel] || mx >= px[panel] + pw[panel]) {
            return -1;
        }
        int rel = my - py[panel] - PANEL_PAD;
        Menu* m = menus[panel];
        int t = 0;
        for (int i = 0; i < m->count; i++) {
            int hh = m->items[i]->separator ? SEP_H : ITEM_H;
            if (rel >= t && rel < t + hh) {
                return i;
            }
            t = t + hh;
        }
        return -1;
    }

    private void setHot(int panel, int idx) {
        if (hot[panel] != idx) {
            hot[panel] = idx;
            invalidate();
        }
        // moving onto an item closes the submenus that belong to other items
        if (depth > panel + 1) {
            if (idx < 0 || menus[panel]->items[idx]->sub != menus[panel + 1]) {
                depth = panel + 1;
                invalidate();
            }
        }
        if (idx >= 0) {
            openSub(panel, idx);
        }
    }

    private void activate(int panel, int idx) {
        MenuItem* it = menus[panel]->items[idx];
        if (it->separator || !it->enabled) {
            return;
        }
        if (it->sub != null) {
            openSub(panel, idx);
            if (depth > panel + 1) {
                hot[panel + 1] = firstEnabled(panel + 1);
            }
            return;
        }
        gui.Window* wn = win;
        wn->closePopup();
        it->invoke();
    }

    private int firstEnabled(int panel) {
        Menu* m = menus[panel];
        for (int i = 0; i < m->count; i++) {
            if (!m->items[i]->separator && m->items[i]->enabled) {
                return i;
            }
        }
        return -1;
    }

    private int step(int panel, int from, int dir) {
        Menu* m = menus[panel];
        if (m->count == 0) {
            return -1;
        }
        int i = from;
        for (int n = 0; n < m->count; n++) {
            i = i + dir;
            if (i < 0) { i = m->count - 1; }
            if (i >= m->count) { i = 0; }
            if (!m->items[i]->separator && m->items[i]->enabled) {
                return i;
            }
        }
        return from;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        gfx.Font* f = gfx.sans();
        for (int p = 0; p < depth; p++) {
            Menu* m = menus[p];
            int x = ox + px[p];
            int y = oy + py[p];
            s->shadow(x, y, pw[p], ph[p], 5, 60);
            s->fill(x, y, pw[p], ph[p], 0xFFFAFAFC);
            s->rect(x, y, pw[p], ph[p], gui.cBorder);
            int ry = y + PANEL_PAD;
            for (int i = 0; i < m->count; i++) {
                MenuItem* it = m->items[i];
                if (it->separator) {
                    s->hline(x + 6, ry + SEP_H / 2, pw[p] - 12, gui.cBorder);
                    ry = ry + SEP_H;
                    continue;
                }
                bool isHot = (hot[p] == i);
                int fg = it->enabled ? gui.cText : gui.cTextDim;
                if (isHot && it->enabled) {
                    s->fill(x + 2, ry, pw[p] - 4, ITEM_H, gui.cAccent);
                    fg = gui.cAccentText;
                }
                if (it->checkable && it->checked) {
                    int cx = x + 8;
                    int cy = ry + ITEM_H / 2;
                    s->line(cx, cy, cx + 3, cy + 4, fg);
                    s->line(cx + 1, cy, cx + 4, cy + 4, fg);
                    s->line(cx + 3, cy + 4, cx + 9, cy - 4, fg);
                    s->line(cx + 4, cy + 4, cx + 10, cy - 4, fg);
                }
                s->text(f, x + 24, ry + (ITEM_H - f->height) / 2, it->text, fg);
                if (strlen(it->accelText) > 0) {
                    int aw = gfx.textWidth(f, it->accelText);
                    s->text(f, x + pw[p] - aw - 14, ry + (ITEM_H - f->height) / 2, it->accelText, isHot && it->enabled ? gui.cAccentText : gui.cTextDim);
                }
                if (it->sub != null) {
                    int ax = x + pw[p] - 14;
                    int ay = ry + ITEM_H / 2;
                    for (int k = 0; k < 4; k++) {
                        s->vline(ax + k, ay - 4 + k, 9 - 2 * k, fg);
                    }
                }
                ry = ry + ITEM_H;
            }
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int p = panelAt(mx, my);
        if (kind == adp.M_MOVE) {
            if (p >= 0) {
                setHot(p, itemAt(p, mx, my));
            } else if (bar != null) {
                int t = bar->titleAtWindow(mx, my);
                if (t >= 0 && t != barIndex) {
                    bar->openMenu(t);
                    return true;
                }
            }
            return true;
        }
        if (kind == adp.M_DOWN) {
            if (p < 0) {
                // a click on the title that is open closes the menu, any other click closes it too
                win->closePopup();
                return true;
            }
            return true;
        }
        if (kind == adp.M_UP && button == 1) {
            if (p >= 0) {
                int idx = itemAt(p, mx, my);
                if (idx >= 0) {
                    activate(p, idx);
                }
            }
            return true;
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) {
            return true;
        }
        int top = depth - 1;
        if (key == adp.KEY_DOWN || key == adp.KEY_UP) {
            int cur = hot[top];
            hot[top] = step(top, cur, key == adp.KEY_DOWN ? 1 : -1);
            invalidate();
            return true;
        }
        if (key == adp.KEY_HOME) { hot[top] = firstEnabled(top); invalidate(); return true; }
        if (key == adp.KEY_RIGHT) {
            int cur = hot[top];
            if (cur >= 0 && menus[top]->items[cur]->sub != null) {
                activate(top, cur);
            } else if (bar != null) {
                bar->openMenu((barIndex + 1) % bar->menuCount());
            }
            return true;
        }
        if (key == adp.KEY_LEFT) {
            if (depth > 1) {
                depth--;
                invalidate();
            } else if (bar != null) {
                bar->openMenu((barIndex + bar->menuCount() - 1) % bar->menuCount());
            }
            return true;
        }
        if (key == adp.KEY_ENTER || key == adp.KEY_SPACE) {
            if (hot[top] >= 0) {
                activate(top, hot[top]);
            }
            return true;
        }
        if (key == adp.KEY_ESCAPE) {
            if (depth > 1) {
                depth--;
                invalidate();
                return true;
            }
            return false;
        }
        return true;
    }

    public virtual void onDismiss() {
        if (bar != null) {
            bar->closed(this);
        }
    }

    public void selectFirst() {
        hot[depth - 1] = firstEnabled(depth - 1);
    }
}

// ---- the row of menu titles at the top of a window ------------------------------------------------------------------------------------------
public class MenuBar : gui.Widget {
    private Menu** menus;
    private char** titles;
    private int* mnem;
    private int count;
    private int openIdx;
    private int hotIdx;
    private MenuStack* current;

    public MenuBar() {
        super();
        menus = (Menu**) calloc(16, 8);
        titles = (char**) calloc(16, 8);
        mnem = (int*) calloc(16, 8);
        openIdx = -1;
        hotIdx = -1;
        h = 26;
        w = 100;
    }

    public virtual void attach(gui.Window* wn) {
        super.attach(wn);
        if (wn != null) {
            wn->keyPreview = this;
        }
    }

    public int menuCount() { return count; }

    // adds a menu; an & in the title marks the key to press together with Alt
    public Menu* addMenu(char* title) {
        if (count >= 16) {
            return menus[15];
        }
        char* t = malloc(strlen(title) + 1);
        int n = 0;
        int m = 0;
        for (int i = 0; title[i] != 0; i++) {
            if (title[i] == '&' && title[i + 1] != 0) {
                m = toLower(title[i + 1]);
                continue;
            }
            t[n] = title[i];
            n++;
        }
        t[n] = 0;
        Menu* menu = new Menu();
        menu->title = t;
        menus[count] = menu;
        titles[count] = t;
        mnem[count] = m;
        count++;
        relayout();
        return menu;
    }

    public virtual int prefW() {
        int total = 4;
        for (int i = 0; i < count; i++) {
            total = total + gfx.textWidth(gfx.sans(), titles[i]) + 20;
        }
        return total;
    }
    public virtual int prefH() { return 26; }

    private int titleX(int i) {
        int x = 4;
        for (int k = 0; k < i; k++) {
            x = x + gfx.textWidth(gfx.sans(), titles[k]) + 20;
        }
        return x;
    }

    private int titleAt(int mx, int my) {
        if (my < 0 || my >= h) {
            return -1;
        }
        for (int i = 0; i < count; i++) {
            int x = titleX(i);
            if (mx >= x && mx < x + gfx.textWidth(gfx.sans(), titles[i]) + 20) {
                return i;
            }
        }
        return -1;
    }

    // the same, for a position given in window coordinates
    public int titleAtWindow(int wx, int wy) {
        return titleAt(wx - absX(), wy - absY());
    }

    public void openMenu(int i) {
        if (i < 0 || i >= count || win == null) {
            return;
        }
        MenuStack* st = new MenuStack(this, i);
        st->w = win->w;
        st->h = win->h;
        st->open(menus[i], absX() + titleX(i), absY() + h, absY());
        win->showPopup(st);
        current = st;
        openIdx = i;
        invalidate();
    }

    // called by the popup when it went away
    public void closed(MenuStack* st) {
        if (current == st) {
            current = null;
            openIdx = -1;
            invalidate();
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, 0xFFE6E8EE);
        s->hline(ox, oy + h - 1, w, gui.cBorder);
        gfx.Font* f = gfx.sans();
        for (int i = 0; i < count; i++) {
            int x = ox + titleX(i);
            int tw = gfx.textWidth(f, titles[i]);
            int fg = gui.cText;
            if (i == openIdx) {
                s->fill(x, oy + 1, tw + 20, h - 2, gui.cAccent);
                fg = gui.cAccentText;
            } else if (i == hotIdx) {
                s->fill(x, oy + 1, tw + 20, h - 2, gui.cButtonHot);
            }
            s->text(f, x + 10, oy + (h - f->height) / 2, titles[i], fg);
            if (mnem[i] != 0) {
                // underline the key of the mnemonic
                for (int k = 0; titles[i][k] != 0; k++) {
                    if (toLower(titles[i][k]) == mnem[i]) {
                        char head[64];
                        int n = k;
                        if (n > 60) { n = 60; }
                        memcpy(&head[0], titles[i], n);
                        head[n] = 0;
                        int ux = x + 10 + gfx.textWidth(f, &head[0]);
                        char one[2];
                        one[0] = titles[i][k];
                        one[1] = 0;
                        s->hline(ux, oy + (h + f->height) / 2 + 1, gfx.textWidth(f, &one[0]), fg);
                        break;
                    }
                }
            }
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int t = titleAt(mx, my);
        if (kind == adp.M_MOVE) {
            if (t != hotIdx) {
                hotIdx = t;
                invalidate();
            }
        } else if (kind == adp.M_DOWN && button == 1 && t >= 0) {
            openMenu(t);
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        if (!inside && hotIdx != -1) {
            hotIdx = -1;
            invalidate();
        }
    }

    // F10, Alt+letter for a title, and the accelerators of the items
    public virtual bool onShortcut(int key, int uni, int mods) {
        if (key == adp.KEY_F1 + 9 && count > 0) {
            openMenu(0);
            if (current != null) {
                current->selectFirst();
            }
            return true;
        }
        if ((mods & adp.MOD_ALT) != 0 && (mods & (adp.MOD_CTRL | adp.MOD_META)) == 0) {
            for (int i = 0; i < count; i++) {
                if (mnem[i] != 0 && mnem[i] == key) {
                    openMenu(i);
                    if (current != null) {
                        current->selectFirst();
                    }
                    return true;
                }
            }
        }
        for (int i = 0; i < count; i++) {
            if (menus[i]->dispatch(key, mods)) {
                return true;
            }
        }
        return false;
    }
}

// =============================================================================
//  ComboBox: a drop-down list
// =============================================================================
const COMBO_ROW = 24;

class DropPopup : gui.Widget {
    private ComboBox* combo;
    private int lx;
    private int ly;
    private int lw;
    private int lh;
    private int hot;
    private int top;
    private int rows;

    public DropPopup(ComboBox* c, int x, int y, int wd, int ht, int rowCount) {
        super();
        combo = c;
        lx = x;
        ly = y;
        lw = wd;
        lh = ht;
        rows = rowCount;
        hot = -1;
    }

    public virtual bool wantsScroll() { return true; }
    public void setHot(int i) { hot = i; keepVisible(); }

    private int total() { return combo->count; }

    private void keepVisible() {
        if (hot < top) { top = hot; }
        if (hot >= top + rows) { top = hot - rows + 1; }
        if (top > total() - rows) { top = total() - rows; }
        if (top < 0) { top = 0; }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        gfx.Font* f = gfx.sans();
        int x = ox + lx;
        int y = oy + ly;
        s->shadow(x, y, lw, lh, 5, 60);
        s->fill(x, y, lw, lh, gui.cField);
        for (int i = 0; i < rows && top + i < total(); i++) {
            int idx = top + i;
            int ry = y + 1 + i * COMBO_ROW;
            int fg = gui.cText;
            if (idx == hot) {
                s->fill(x + 1, ry, lw - 2, COMBO_ROW, gui.cAccent);
                fg = gui.cAccentText;
            } else if (idx == combo->selected) {
                s->fill(x + 1, ry, lw - 2, COMBO_ROW, gui.cSelect);
            }
            s->text(f, x + 8, ry + (COMBO_ROW - f->height) / 2, combo->items[idx], fg);
        }
        if (total() > rows) {
            int trackH = lh - 2;
            int thumbH = trackH * rows / total();
            if (thumbH < 12) { thumbH = 12; }
            int thumbY = (trackH - thumbH) * top / (total() - rows);
            s->fillRoundRect(x + lw - 8, y + 1 + thumbY, 6, thumbH, 3, gui.cBorder);
        }
        s->rect(x, y, lw, lh, gui.cAccent);
    }

    private int rowAt(int mx, int my) {
        if (mx < lx || mx >= lx + lw || my < ly + 1 || my >= ly + lh - 1) {
            return -1;
        }
        int i = top + (my - ly - 1) / COMBO_ROW;
        return (i < total()) ? i : -1;
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_MOVE) {
            int r = rowAt(mx, my);
            if (r >= 0 && r != hot) {
                hot = r;
                invalidate();
            }
        } else if (kind == adp.M_DOWN) {
            if (rowAt(mx, my) < 0 && !(mx >= lx && mx < lx + lw && my >= ly && my < ly + lh)) {
                win->closePopup();
            }
        } else if (kind == adp.M_UP && button == 1) {
            int r = rowAt(mx, my);
            if (r >= 0) {
                gui.Window* wn = win;
                ComboBox* c = combo;
                wn->closePopup();
                c->select(r);
            }
        } else if (kind == adp.M_SCROLL) {
            top = top - button * 2;
            if (top > total() - rows) { top = total() - rows; }
            if (top < 0) { top = 0; }
            invalidate();
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) {
            return true;
        }
        if (key == adp.KEY_DOWN && hot < total() - 1) { hot++; keepVisible(); invalidate(); }
        else if (key == adp.KEY_UP && hot > 0) { hot--; keepVisible(); invalidate(); }
        else if (key == adp.KEY_HOME) { hot = 0; keepVisible(); invalidate(); }
        else if (key == adp.KEY_END) { hot = total() - 1; keepVisible(); invalidate(); }
        else if (key == adp.KEY_ENTER || key == adp.KEY_SPACE) {
            if (hot >= 0) {
                gui.Window* wn = win;
                ComboBox* c = combo;
                int pick = hot;
                wn->closePopup();
                c->select(pick);
            }
        } else if (key == adp.KEY_ESCAPE) {
            return false;
        }
        return true;
    }

    public virtual void onDismiss() {
        combo->popupGone();
    }
}

public class ComboBox : gui.Widget {
    public char** items;
    public int count;
    public int selected;            // -1 = none
    public func onChange;
    private int cap;
    private bool opened;

    public ComboBox() {
        super();
        focusable = true;
        cap = 8;
        items = (char**) calloc(cap, 8);
        selected = -1;
        w = 140;
        h = 28;
    }

    public void addItem(char* t) {
        if (count == cap) {
            cap = cap * 2;
            items = (char**) realloc((char*) items, cap * 8);
        }
        items[count] = strdup(t);
        count++;
        if (selected < 0) {
            selected = 0;
        }
        relayout();
        invalidate();
    }

    public void clear() {
        count = 0;
        selected = -1;
        invalidate();
    }

    public char* item(int i) {
        if (i < 0 || i >= count) {
            return "";
        }
        return items[i];
    }

    public char* text() { return item(selected); }

    public void select(int i) {
        if (i < 0 || i >= count) {
            return;
        }
        bool changed = (i != selected);
        selected = i;
        invalidate();
        if (changed && onChange != null) {
            onChange(this);
        }
    }

    public virtual int prefW() {
        int best = 100;
        for (int i = 0; i < count; i++) {
            int t = gfx.textWidth(gfx.sans(), items[i]) + 44;
            if (t > best) { best = t; }
        }
        return best;
    }
    public virtual int prefH() { return 28; }

    public void open() {
        if (win == null || count == 0 || opened) {
            return;
        }
        int rows = (count < 8) ? count : 8;
        int lh = rows * COMBO_ROW + 2;
        int x = absX();
        int y = absY() + h;
        if (y + lh > win->h) {
            y = absY() - lh;
            if (y < 0) { y = 0; }
        }
        DropPopup* p = new DropPopup(this, x, y, w, lh, rows);
        p->w = win->w;
        p->h = win->h;
        p->setHot(selected);
        opened = true;
        win->showPopup(p);
    }

    public void popupGone() {
        opened = false;
        invalidate();
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        bool focus = (win != null && win->focusWidget == this);
        s->fillRoundRect(ox, oy, w, h, 4, enabled ? gui.cField : gui.cBack);
        s->roundRect(ox, oy, w, h, 4, (focus || opened) ? gui.cAccent : gui.cBorder);
        gfx.Font* f = gfx.sans();
        s->text(f, ox + 8, oy + (h - f->height) / 2, text(), enabled ? gui.cText : gui.cTextDim);
        int ax = ox + w - 18;
        int ay = oy + h / 2 - 2;
        for (int k = 0; k < 5; k++) {
            s->hline(ax + k, ay + k, 10 - 2 * k, enabled ? gui.cText : gui.cTextDim);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (enabled && kind == adp.M_DOWN && button == 1) {
            open();
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        if (key == adp.KEY_DOWN && selected < count - 1) { select(selected + 1); return true; }
        if (key == adp.KEY_UP && selected > 0) { select(selected - 1); return true; }
        if (key == adp.KEY_ENTER || key == adp.KEY_SPACE || key == adp.KEY_F1 + 3) { open(); return true; }
        return false;
    }

    public virtual void onFocus(bool gained) { invalidate(); }
}

// =============================================================================
//  RadioButton and RadioGroup
// =============================================================================
public class RadioGroup {
    public func onChange;           // int f(int group)
    public int userData;
    private RadioButton** members;
    private int count;
    private int cap;

    public RadioGroup() {
        cap = 8;
        members = (RadioButton**) calloc(cap, 8);
    }

    public void add(RadioButton* b) {
        if (count == cap) {
            cap = cap * 2;
            members = (RadioButton**) realloc((char*) members, cap * 8);
        }
        members[count] = b;
        count++;
    }

    public int size() { return count; }
    public RadioButton* member(int i) { return members[i]; }
    public int selectedIndex() {
        for (int i = 0; i < count; i++) {
            if (members[i]->checked) {
                return i;
            }
        }
        return -1;
    }

    public void select(RadioButton* b) { pick(b, true); }
    public void selectIndex(int i) {
        if (i >= 0 && i < count) {
            pick(members[i], true);
        }
    }

    private void pick(RadioButton* b, bool notify) {
        bool changed = !b->checked;
        for (int i = 0; i < count; i++) {
            RadioButton* m = members[i];
            bool want = (m == b);
            if (m->checked != want) {
                m->checked = want;
                m->invalidate();
            }
        }
        if (changed && notify && onChange != null) {
            onChange(this);
        }
    }

    public int stepFrom(RadioButton* b, int dir) {
        for (int i = 0; i < count; i++) {
            if (members[i] == b) {
                return (i + dir + count) % count;
            }
        }
        return 0;
    }
}

public class RadioButton : gui.Widget {
    public char* text;
    public bool checked;
    public RadioGroup* group;

    public RadioButton(char* t, RadioGroup* g) {
        super();
        text = strdup(t);
        group = g;
        focusable = true;
        g->add(this);
    }

    public virtual int prefW() { return gfx.textWidth(gfx.sans(), text) + 26; }
    public virtual int prefH() { return 22; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int cy = oy + h / 2;
        bool focus = (win != null && win->focusWidget == this);
        s->fillCircle(ox + 9, cy, 8, gui.cField);
        s->circle(ox + 9, cy, 8, focus ? gui.cAccent : gui.cBorder);
        if (checked) {
            s->fillCircle(ox + 9, cy, 4, enabled ? gui.cAccent : gui.cTextDim);
        }
        s->text(gfx.sans(), ox + 24, oy + (h - gfx.sans()->height) / 2, text, enabled ? gui.cText : gui.cTextDim);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (enabled && kind == adp.M_UP && button == 1 && mx >= 0 && my >= 0 && mx < w && my < h) {
            group->select(this);
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        if (key == adp.KEY_SPACE) {
            group->select(this);
            return true;
        }
        int dir = 0;
        if (key == adp.KEY_DOWN || key == adp.KEY_RIGHT) { dir = 1; }
        if (key == adp.KEY_UP || key == adp.KEY_LEFT) { dir = -1; }
        if (dir != 0) {
            RadioButton* n = group->member(group->stepFrom(this, dir));
            n->focusMe();
            group->select(n);
            return true;
        }
        return false;
    }

    public virtual void onFocus(bool gained) { invalidate(); }
}

// =============================================================================
//  TabView: pages with a row of tabs
// =============================================================================
const TAB_H = 30;

public class TabView : gui.Widget {
    public int selected;
    public func onChange;           // int f(int tabview)
    public bool closable;           // tabs get a close button
    public func onTabClose;         // int f(int tabview): closedIndex holds the number; return 1 to keep the tab
    public int closedIndex;
    private char** titles;
    private int cap;

    public TabView() {
        super();
        focusable = true;
        cap = 8;
        titles = (char**) calloc(cap, 8);
        selected = -1;
        w = 200;
        h = 150;
    }

    public int tabCount() { return nkids; }

    public void addTab(char* title, gui.Widget* page) {
        if (nkids == cap) {
            cap = cap * 2;
            titles = (char**) realloc((char*) titles, cap * 8);
        }
        titles[nkids] = strdup(title);
        page->visible = false;
        add(page);
        if (selected < 0) {
            select(0);
        }
        invalidate();
    }

    public void setTitle(int i, char* title) {
        if (i >= 0 && i < nkids) {
            titles[i] = strdup(title);
            invalidate();
        }
    }

    public gui.Widget* page(int i) {
        if (i < 0 || i >= nkids) {
            return null;
        }
        return kids[i];
    }

    public void select(int i) {
        if (i < 0 || i >= nkids) {
            return;
        }
        bool changed = (i != selected);
        selected = i;
        for (int k = 0; k < nkids; k++) {
            kids[k]->visible = (k == i);
        }
        relayout();
        if (win != null) {
            win->invalidateAll();
            if (win->focusWidget != null && !win->focusWidget->visible) {
                win->setFocus(this);
            }
        }
        if (changed && onChange != null) {
            onChange(this);
        }
    }

    public void removeTab(int i) {
        if (i < 0 || i >= nkids) {
            return;
        }
        gui.Widget* pg = kids[i];
        for (int k = i; k < nkids - 1; k++) {
            kids[k] = kids[k + 1];
            titles[k] = titles[k + 1];
        }
        nkids--;
        pg->attach(null);
        pg->parent = null;
        if (selected >= nkids) {
            selected = nkids - 1;
        }
        if (selected >= 0) {
            select(selected);
        }
        relayout();
        if (win != null) {
            win->invalidateAll();
        }
    }

    private int tabW(int i) {
        return gfx.textWidth(gfx.sans(), titles[i]) + 28 + (closable ? 18 : 0);
    }

    private int tabX(int i) {
        int x = 2;
        for (int k = 0; k < i; k++) {
            x = x + tabW(k) + 2;
        }
        return x;
    }

    private int tabAt(int mx, int my) {
        if (my < 0 || my >= TAB_H) {
            return -1;
        }
        for (int i = 0; i < nkids; i++) {
            int x = tabX(i);
            if (mx >= x && mx < x + tabW(i)) {
                return i;
            }
        }
        return -1;
    }

    public virtual int prefW() {
        int best = 0;
        for (int i = 0; i < nkids; i++) {
            int pw = kids[i]->prefW();
            if (pw > best) { best = pw; }
        }
        int hdr = tabX(nkids) + 2;
        return ((best + 2) > hdr) ? best + 2 : hdr;
    }

    public virtual int prefH() {
        int best = 0;
        for (int i = 0; i < nkids; i++) {
            int ph = kids[i]->prefH();
            if (ph > best) { best = ph; }
        }
        return best + TAB_H + 2;
    }

    public virtual void layout() {
        for (int i = 0; i < nkids; i++) {
            gui.Widget* k = kids[i];
            k->x = 1;
            k->y = TAB_H + 1;
            k->w = w - 2;
            k->h = h - TAB_H - 2;
            k->layout();
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        gfx.Font* f = gfx.sans();
        s->fill(ox, oy + TAB_H, w, h - TAB_H, gui.cBack);
        s->rect(ox, oy + TAB_H, w, h - TAB_H, gui.cBorder);
        bool focus = (win != null && win->focusWidget == this);
        for (int i = 0; i < nkids; i++) {
            int x = ox + tabX(i);
            int tw = tabW(i);
            if (i == selected) {
                s->fill(x, oy + 2, tw, TAB_H - 1, gui.cBack);
                s->rect(x, oy + 2, tw, TAB_H, gui.cBorder);
                s->fill(x + 1, oy + TAB_H, tw - 2, 1, gui.cBack);
                s->fill(x + 1, oy + 2, tw - 2, 3, focus ? gui.cAccent : gui.cBorder);
            } else {
                s->fill(x, oy + 6, tw, TAB_H - 6, 0xFFDADCE4);
                s->rect(x, oy + 6, tw, TAB_H - 6, gui.cBorder);
            }
            s->text(f, x + 14, oy + 6 + (TAB_H - 6 - f->height) / 2, titles[i], (i == selected) ? gui.cText : gui.cTextDim);
            if (closable) {
                int cx = x + tw - 14;
                int cy = oy + TAB_H / 2 + 2;
                s->line(cx - 3, cy - 3, cx + 3, cy + 3, gui.cTextDim);
                s->line(cx - 3, cy + 3, cx + 3, cy - 3, gui.cTextDim);
            }
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            int t = tabAt(mx, my);
            if (t >= 0) {
                if (closable && mx >= tabX(t) + tabW(t) - 22) {
                    closedIndex = t;
                    if (onTabClose == null || onTabClose(this) == 0) {
                        removeTab(t);
                    }
                    return true;
                }
                select(t);
            }
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        if (key == adp.KEY_LEFT && selected > 0) { select(selected - 1); return true; }
        if (key == adp.KEY_RIGHT && selected < nkids - 1) { select(selected + 1); return true; }
        if (key == adp.KEY_HOME) { select(0); return true; }
        if (key == adp.KEY_END) { select(nkids - 1); return true; }
        return false;
    }

    public virtual void onFocus(bool gained) { invalidate(); }
}

// =============================================================================
//  ScrollBar and ScrollView
// =============================================================================
const SCROLL_W = 14;

public class ScrollBar : gui.Widget {
    public bool vertical;
    public int total;               // size of the whole content
    public int page;                // size of the visible part
    public int value;               // first visible position
    public func onChange;           // int f(int scrollbar)
    private bool dragging;
    private int grab;

    public ScrollBar(bool vert) {
        super();
        vertical = vert;
        total = 1;
        page = 1;
        w = SCROLL_W;
        h = SCROLL_W;
    }

    public virtual int prefW() { return vertical ? SCROLL_W : 60; }
    public virtual int prefH() { return vertical ? 60 : SCROLL_W; }

    public int maxValue() {
        return (total > page) ? total - page : 0;
    }

    private int track() { return vertical ? h : w; }

    private int thumbLen() {
        int t = track();
        if (total <= 0 || total <= page) {
            return t;
        }
        int len = t * page / total;
        if (len < 20) { len = 20; }
        if (len > t) { len = t; }
        return len;
    }

    private int thumbPos() {
        int mv = maxValue();
        if (mv == 0) {
            return 0;
        }
        return (track() - thumbLen()) * value / mv;
    }

    public void setValue(int v) {
        if (v > maxValue()) { v = maxValue(); }
        if (v < 0) { v = 0; }
        if (v != value) {
            value = v;
            invalidate();
            if (onChange != null) {
                onChange(this);
            }
        }
    }

    public void configure(int totalSize, int pageSize) {
        total = totalSize;
        page = pageSize;
        if (value > maxValue()) {
            value = maxValue();
        }
        invalidate();
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, 0xFFE2E4EA);
        int tp = thumbPos();
        int tl = thumbLen();
        int col = dragging ? gui.cTextDim : gui.cBorder;
        if (maxValue() == 0) {
            col = 0xFFD0D2D8;
        }
        if (vertical) {
            s->fillRoundRect(ox + 2, oy + tp + 1, w - 4, tl - 2, 4, col);
        } else {
            s->fillRoundRect(ox + tp + 1, oy + 2, tl - 2, h - 4, 4, col);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int along = vertical ? my : mx;
        if (kind == adp.M_DOWN && button == 1) {
            int tp = thumbPos();
            int tl = thumbLen();
            if (along >= tp && along < tp + tl) {
                dragging = true;
                grab = along - tp;
                invalidate();
            } else if (along < tp) {
                setValue(value - page);
            } else {
                setValue(value + page);
            }
        } else if (kind == adp.M_MOVE && dragging) {
            int range = track() - thumbLen();
            if (range > 0) {
                setValue((along - grab) * maxValue() / range);
            }
        } else if (kind == adp.M_UP) {
            dragging = false;
            invalidate();
        }
        return true;
    }
}

// a plain rectangle (the corner between two scroll bars, the divider of a splitter, ...)
public class Filler : gui.Widget {
    public int color;

    public Filler(int c) {
        super();
        color = c;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, color);
    }
}

// clips the content of a ScrollView
class Viewport : gui.Widget {
    public Viewport() { super(); }
    public virtual void layout() { }
}

int scrollBarMoved(int self);

public class ScrollView : gui.Widget {
    public bool fitWidth;           // the content is as wide as the view (it only scrolls up and down)
    public bool border;
    public int offX;
    public int offY;
    private Viewport* view;
    private ScrollBar* vbar;
    private ScrollBar* hbar;
    private Filler* corner;
    private gui.Widget* content;

    public ScrollView() {
        super();
        view = new Viewport();
        vbar = new ScrollBar(true);
        hbar = new ScrollBar(false);
        corner = new Filler(0xFFE2E4EA);
        vbar->userData = (int) this;
        hbar->userData = (int) this;
        vbar->onChange = scrollBarMoved;
        hbar->onChange = scrollBarMoved;
        add(view);
        add(vbar);
        add(hbar);
        add(corner);
        vbar->visible = false;
        hbar->visible = false;
        corner->visible = false;
        w = 200;
        h = 150;
        flex = 1;
    }

    public virtual bool wantsScroll() { return true; }

    public void setContent(gui.Widget* c) {
        view->removeAll();
        content = c;
        view->add(c);
        offX = 0;
        offY = 0;
        relayout();
    }

    public gui.Widget* getContent() { return content; }

    public virtual int prefW() {
        if (content == null) { return 100; }
        int p = content->prefW() + SCROLL_W + 2;
        return (p > 320) ? 320 : p;
    }

    public virtual int prefH() {
        if (content == null) { return 100; }
        int p = content->prefH() + 2;
        return (p > 240) ? 240 : p;
    }

    public virtual void layout() {
        int bd = border ? 1 : 0;
        int aw = w - bd * 2;
        int ah = h - bd * 2;
        if (content == null) {
            view->x = bd; view->y = bd; view->w = aw; view->h = ah;
            return;
        }
        int cw = content->prefW();
        int ch = content->prefH();
        bool needV = ch > ah;
        bool needH = !fitWidth && cw > aw;
        if (needV && !fitWidth && cw > aw - SCROLL_W) { needH = true; }
        if (needH && ch > ah - SCROLL_W) { needV = true; }
        int vw = aw - (needV ? SCROLL_W : 0);
        int vh = ah - (needH ? SCROLL_W : 0);
        if (fitWidth) {
            cw = vw;
            ch = content->prefH();     // (a content that wraps to its width reports its height for that width after layout)
        }
        int contentW = (cw > vw) ? cw : vw;
        int contentH = (ch > vh) ? ch : vh;
        if (offX > contentW - vw) { offX = contentW - vw; }
        if (offY > contentH - vh) { offY = contentH - vh; }
        if (offX < 0) { offX = 0; }
        if (offY < 0) { offY = 0; }
        view->x = bd;
        view->y = bd;
        view->w = vw;
        view->h = vh;
        content->x = -offX;
        content->y = -offY;
        content->w = contentW;
        content->h = contentH;
        content->layout();
        vbar->visible = needV;
        hbar->visible = needH;
        corner->visible = needV && needH;
        vbar->x = bd + vw;
        vbar->y = bd;
        vbar->w = SCROLL_W;
        vbar->h = vh;
        vbar->configure(contentH, vh);
        vbar->value = offY;
        hbar->x = bd;
        hbar->y = bd + vh;
        hbar->w = vw;
        hbar->h = SCROLL_W;
        hbar->configure(contentW, vw);
        hbar->value = offX;
        corner->x = bd + vw;
        corner->y = bd + vh;
        corner->w = SCROLL_W;
        corner->h = SCROLL_W;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        if (border) {
            s->rect(ox, oy, w, h, gui.cBorder);
        }
    }

    // a scroll bar was moved
    public void barMoved() {
        offX = hbar->value;
        offY = vbar->value;
        if (content != null) {
            content->x = -offX;
            content->y = -offY;
        }
        invalidate();
    }

    public void scrollTo(int x, int y) {
        offX = x;
        offY = y;
        relayout();
        invalidate();
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_SCROLL) {
            if (!vbar->visible && !hbar->visible) {
                return false;
            }
            if (vbar->visible && (mods & adp.MOD_SHIFT) == 0) {
                vbar->setValue(vbar->value - button * 40);
            } else if (hbar->visible) {
                hbar->setValue(hbar->value - button * 40);
            }
            return true;
        }
        return false;
    }

    // a child got the focus: scroll so that it can be seen
    public virtual void reveal(gui.Widget* child) {
        if (content == null || child == content) {
            return;
        }
        int cx = child->absX() - content->absX();
        int cy = child->absY() - content->absY();
        int nx = offX;
        int ny = offY;
        if (cy < ny) { ny = cy; }
        if (cy + child->h > ny + view->h) { ny = cy + child->h - view->h; }
        if (cx < nx) { nx = cx; }
        if (cx + child->w > nx + view->w) { nx = cx + child->w - view->w; }
        if (nx != offX || ny != offY) {
            scrollTo(nx, ny);
        }
    }
}

int scrollBarMoved(int self) {
    ScrollBar* b = (ScrollBar*) self;
    ScrollView* sv = (ScrollView*) b->userData;
    sv->barMoved();
    return 0;
}

// =============================================================================
//  SpinBox: a number with up/down buttons
// =============================================================================
public class SpinBox : gui.Widget {
    public int min;
    public int max;
    public int value;
    public int step;
    public func onChange;
    private char* edit;
    private int editLen;
    private bool editing;

    public SpinBox(int lo, int hi) {
        super();
        min = lo;
        max = hi;
        value = (lo > 0) ? lo : ((hi < 0) ? hi : 0);
        step = 1;
        focusable = true;
        edit = malloc(24);
        w = 90;
        h = 28;
    }

    public virtual int prefW() { return 90; }
    public virtual int prefH() { return 28; }

    public void setValue(int v) {
        if (v < min) { v = min; }
        if (v > max) { v = max; }
        editing = false;
        if (v != value) {
            value = v;
            invalidate();
            if (onChange != null) {
                onChange(this);
            }
        } else {
            invalidate();
        }
    }

    private void commit() {
        if (editing) {
            edit[editLen] = 0;
            int v = 0;
            if (editLen > 0 && !(editLen == 1 && edit[0] == '-')) {
                v = atoi(edit);
            } else {
                v = value;
            }
            setValue(v);
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        bool focus = (win != null && win->focusWidget == this);
        s->fillRoundRect(ox, oy, w, h, 4, enabled ? gui.cField : gui.cBack);
        s->roundRect(ox, oy, w, h, 4, focus ? gui.cAccent : gui.cBorder);
        gfx.Font* f = gfx.sans();
        char num[24];
        char* shown = &num[0];
        if (editing) {
            edit[editLen] = 0;
            shown = edit;
        } else {
            intToStr(value, &num[0]);
        }
        s->text(f, ox + 8, oy + (h - f->height) / 2, shown, enabled ? gui.cText : gui.cTextDim);
        if (editing && focus) {
            int cx = ox + 8 + gfx.textWidth(f, shown) + 1;
            s->vline(cx, oy + 5, h - 10, gui.cText);
        }
        int bx = ox + w - 20;
        s->vline(bx, oy + 2, h - 4, gui.cBorder);
        s->hline(bx + 1, oy + h / 2, 19, gui.cBorder);
        for (int k = 0; k < 4; k++) {
            s->hline(bx + 6 + k, oy + h / 4 + 2 - k, 7 - 2 * k, gui.cText);
            s->hline(bx + 6 + k, oy + h * 3 / 4 - 2 + k, 7 - 2 * k, gui.cText);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (!enabled) { return true; }
        if (kind == adp.M_DOWN && button == 1 && mx >= w - 20) {
            commit();
            setValue(value + ((my < h / 2) ? step : -step));
        } else if (kind == adp.M_SCROLL) {
            commit();
            setValue(value + button * step);
        }
        return true;
    }

    public virtual bool wantsScroll() { return true; }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        if (uni >= '0' && uni <= '9' && (mods & (adp.MOD_CTRL | adp.MOD_ALT)) == 0) {
            if (!editing) { editing = true; editLen = 0; }
            if (editLen < 12) {
                edit[editLen] = uni;
                editLen++;
            }
            invalidate();
            return true;
        }
        if (uni == '-' && min < 0) {
            if (!editing) { editing = true; editLen = 0; }
            if (editLen == 0) {
                edit[0] = '-';
                editLen = 1;
            }
            invalidate();
            return true;
        }
        if (key == adp.KEY_BACKSPACE && editing) {
            if (editLen > 0) { editLen--; }
            invalidate();
            return true;
        }
        if (key == adp.KEY_ENTER) {
            if (editing) {
                commit();
                return true;
            }
            return false;
        }
        if (key == adp.KEY_ESCAPE && editing) {
            editing = false;
            invalidate();
            return true;
        }
        if (key == adp.KEY_UP) { commit(); setValue(value + step); return true; }
        if (key == adp.KEY_DOWN) { commit(); setValue(value - step); return true; }
        if (key == adp.KEY_PGUP) { commit(); setValue(value + step * 10); return true; }
        if (key == adp.KEY_PGDN) { commit(); setValue(value - step * 10); return true; }
        if (key == adp.KEY_HOME) { setValue(min); return true; }
        if (key == adp.KEY_END) { setValue(max); return true; }
        return false;
    }

    public virtual void onFocus(bool gained) {
        if (!gained) {
            commit();
        }
        invalidate();
    }
}

// =============================================================================
//  Splitter: two panes with a divider that can be dragged
// =============================================================================
const SPLIT_GAP = 6;

public class Splitter : gui.Widget {
    public bool sideBySide;         // true: first | second;  false: first above second
    public int pos;                 // size of the first pane
    public int minPane;
    private bool dragging;
    private int grab;
    private int shape;

    public Splitter(bool side, int firstSize) {
        super();
        sideBySide = side;
        pos = firstSize;
        minPane = 40;
        w = 200;
        h = 150;
        flex = 1;
    }

    public virtual int prefW() {
        if (nkids < 2) { return 100; }
        if (sideBySide) { return pos + SPLIT_GAP + kids[1]->prefW(); }
        return (kids[0]->prefW() > kids[1]->prefW()) ? kids[0]->prefW() : kids[1]->prefW();
    }

    public virtual int prefH() {
        if (nkids < 2) { return 100; }
        if (!sideBySide) { return pos + SPLIT_GAP + kids[1]->prefH(); }
        return (kids[0]->prefH() > kids[1]->prefH()) ? kids[0]->prefH() : kids[1]->prefH();
    }

    public virtual void layout() {
        if (nkids < 2) { return; }
        int total = sideBySide ? w : h;
        int limit = total - SPLIT_GAP - minPane;
        if (pos > limit) { pos = limit; }
        if (pos < minPane) { pos = minPane; }
        gui.Widget* a = kids[0];
        gui.Widget* b = kids[1];
        if (sideBySide) {
            a->x = 0; a->y = 0; a->w = pos; a->h = h;
            b->x = pos + SPLIT_GAP; b->y = 0; b->w = w - pos - SPLIT_GAP; b->h = h;
        } else {
            a->x = 0; a->y = 0; a->w = w; a->h = pos;
            b->x = 0; b->y = pos + SPLIT_GAP; b->w = w; b->h = h - pos - SPLIT_GAP;
        }
        a->layout();
        b->layout();
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int c = dragging ? gui.cAccent : gui.cBorder;
        if (sideBySide) {
            s->fill(ox + pos, oy, SPLIT_GAP, h, gui.cBack);
            s->vline(ox + pos + SPLIT_GAP / 2, oy + h / 2 - 12, 24, c);
        } else {
            s->fill(ox, oy + pos, w, SPLIT_GAP, gui.cBack);
            s->hline(ox + w / 2 - 12, oy + pos + SPLIT_GAP / 2, 24, c);
        }
    }

    private void setShape(int sh) {
        if (win != null && sh != shape) {
            shape = sh;
            win->setCursor(sh);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int along = sideBySide ? mx : my;
        if (kind == adp.M_DOWN && button == 1) {
            dragging = true;
            grab = along - pos;
            invalidate();
        } else if (kind == adp.M_MOVE) {
            if (dragging) {
                pos = along - grab;
                relayout();
                invalidate();
            }
            setShape(sideBySide ? adp.CURSOR_SIZE_H : adp.CURSOR_SIZE_V);
        } else if (kind == adp.M_UP) {
            dragging = false;
            invalidate();
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        if (!inside && !dragging) {
            setShape(adp.CURSOR_ARROW);
        }
    }
}

// a coloured rectangle (for colour choosers)
public class Swatch : gui.Widget {
    public int color;

    public Swatch(int c, int wd, int ht) {
        super();
        color = c;
        w = wd;
        h = ht;
    }

    public virtual int prefW() { return w; }
    public virtual int prefH() { return h; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        // a checkerboard shows transparency
        for (int cy = 0; cy < h; cy = cy + 8) {
            for (int cx = 0; cx < w; cx = cx + 8) {
                s->fill(ox + cx, oy + cy, 8, 8, (((cx + cy) / 8) % 2 == 0) ? 0xFFFFFFFF : 0xFFC8C8C8);
            }
        }
        s->fill(ox, oy, w, h, color);
        s->rect(ox, oy, w, h, gui.cBorder);
    }
}

// =============================================================================
//  dialogs: each one opens a window; when it is finished it calls your function  int f(int result)  and closes
// =============================================================================
// an argument that was given to the dialog function is available to your callback in guix.dialogArg
public int dialogArg;

class DialogState {
    public func cb;
    public int arg;
    public bool done;
    public gui.Window* win;
    public gui.TextBox* input;
    public gui.ListBox* list;
    public gui.Label* where;
    public char* dir;
    public char** names;
    public int* kinds;              // 1 = directory
    public int nnames;
    public bool save;
    public bool hidden;
    public char* pending;
    public gui.Slider* sr;
    public gui.Slider* sg;
    public gui.Slider* sb;
    public Swatch* swatch;
    public gui.Label* hex;
    public gui.Display* display;
}

DialogState* stateOfWin(gui.Window* w) {
    return (DialogState*) w->userData;
}

DialogState* stateOf(int widget) {
    gui.Widget* wd = (gui.Widget*) widget;
    return stateOfWin(wd->win);
}

void finish(DialogState* st, int result) {
    if (!st->done) {
        st->done = true;
        dialogArg = st->arg;
        if (st->cb != null) {
            st->cb(result);
        }
    }
    st->win->close();
}

int dialogClosed(int window) {
    gui.Window* w = (gui.Window*) window;
    DialogState* st = stateOfWin(w);
    if (!st->done) {
        st->done = true;
        dialogArg = st->arg;
        if (st->cb != null) {
            st->cb(0);
        }
    }
    return 0;
}

DialogState* newDialog(gui.Display* d, char* title, int wd, int ht, int flags, func cb, int arg) {
    DialogState* st = new DialogState();
    st->cb = cb;
    st->arg = arg;
    st->display = d;
    gui.Window* w = d->createWindow(title, wd, ht, flags);
    st->win = w;
    w->userData = (int) st;
    w->onClose = dialogClosed;
    return st;
}

// a row of buttons aligned to the right
gui.Box* buttonRow(gui.Button* a, gui.Button* b) {
    gui.Box* row = gui.hbox(8, 0);
    gui.Spacer* sp = new gui.Spacer(1);
    sp->flex = 1;
    row->add(sp);
    row->add(a);
    row->add(b);
    return row;
}

// ---- confirm: a question with Yes and No (the callback gets 1 or 0) ------------------------------------------------------------------------
int yesClicked(int self) { finish(stateOf(self), 1); return 0; }
int noClicked(int self) { finish(stateOf(self), 0); return 0; }

public gui.Window* confirmArg(gui.Display* d, char* title, char* text, func cb, int arg) {
    DialogState* st = newDialog(d, title, 320, 120, adp.F_FIXED, cb, arg);
    gui.Box* col = gui.vbox(14, 14);
    col->add(new gui.Label(text));
    gui.Button* yes = new gui.Button("Yes");
    yes->primary = true;
    yes->onClick = yesClicked;
    gui.Button* no = new gui.Button("No");
    no->onClick = noClicked;
    col->add(buttonRow(yes, no));
    st->win->setRoot(col);
    st->win->defaultButton = yes;
    st->win->fit();
    st->win->setFocus(yes);
    return st->win;
}

public gui.Window* confirm(gui.Display* d, char* title, char* text, func cb) {
    return confirmArg(d, title, text, cb, 0);
}

// ---- prompt: asks for a line of text (the callback gets the text as a char*, 0 when cancelled) -----------------------------------------------
int promptOk(int self) {
    DialogState* st = stateOf(self);
    finish(st, (int) strdup(st->input->text()));
    return 0;
}

int promptCancel(int self) { finish(stateOf(self), 0); return 0; }

public gui.Window* promptArg(gui.Display* d, char* title, char* label, char* initial, func cb, int arg) {
    DialogState* st = newDialog(d, title, 340, 130, 0, cb, arg);
    gui.Box* col = gui.vbox(10, 14);
    col->add(new gui.Label(label));
    st->input = new gui.TextBox();
    st->input->setText(initial);
    st->input->onEnter = promptOk;
    col->add(st->input);
    gui.Button* ok = new gui.Button("OK");
    ok->primary = true;
    ok->onClick = promptOk;
    gui.Button* cancel = new gui.Button("Cancel");
    cancel->onClick = promptCancel;
    col->add(buttonRow(ok, cancel));
    st->win->setRoot(col);
    st->win->defaultButton = ok;
    st->win->fit();
    if (st->win->w < 340) { st->win->resize(340, st->win->h); }
    st->win->setFocus(st->input);
    return st->win;
}

public gui.Window* prompt(gui.Display* d, char* title, char* label, char* initial, func cb) {
    return promptArg(d, title, label, initial, cb, 0);
}

// ---- file dialogs (the callback gets the path as a char*, 0 when cancelled) -------------------------------------------------------------------
bool isDirectory(char* p) {
    Stat sb;
    if (stat(p, &sb) != 0) {
        return false;
    }
    return S_ISDIR(sb.st_mode);
}

int nameLess(char* a, char* b) {
    return strcasecmp(a, b) < 0 ? 1 : 0;
}

void fileRefresh(DialogState* st) {
    char* tmp[1024];
    int n = os.listDir(st->dir, &tmp[0], 1024);
    if (n < 0) {
        n = 0;
    }
    // insertion sort, ignoring case
    for (int i = 1; i < n; i++) {
        char* v = tmp[i];
        int j = i - 1;
        while (j >= 0 && nameLess(v, tmp[j]) == 1) {
            tmp[j + 1] = tmp[j];
            j--;
        }
        tmp[j + 1] = v;
    }
    st->list->clear();
    st->nnames = 0;
    if (!streq(st->dir, "/")) {
        st->names[0] = "..";
        st->kinds[0] = 1;
        st->nnames = 1;
        st->list->addItem("..");
    }
    for (int pass = 0; pass < 2; pass++) {
        for (int i = 0; i < n; i++) {
            char* nm = tmp[i];
            if (nm[0] == '.' && !st->hidden) {
                continue;
            }
            bool dir = isDirectory(path.join(st->dir, nm));
            if ((pass == 0) != dir) {
                continue;
            }
            st->names[st->nnames] = nm;
            st->kinds[st->nnames] = dir ? 1 : 0;
            st->nnames++;
            st->list->addItem(dir ? concatSlash(nm) : nm);
        }
    }
    st->where->setText(st->dir);
}

char* concatSlash(char* s) {
    char* r = malloc(strlen(s) + 2);
    strcpy(r, s);
    int n = strlen(s);
    r[n] = '/';
    r[n + 1] = 0;
    return r;
}

void fileEnter(DialogState* st, char* dir) {
    st->dir = path.normalize(dir);
    fileRefresh(st);
}

void fileAccept(DialogState* st) {
    char* name = st->input->text();
    if (strlen(name) == 0) {
        return;
    }
    char* full = path.isAbsolute(name) ? path.normalize(name) : path.join(st->dir, name);
    if (isDirectory(full)) {
        fileEnter(st, full);
        st->input->setText("");
        return;
    }
    if (st->save && fileExists(full)) {
        st->pending = full;
        confirmArg(st->display, "Replace file", "The file exists. Replace it?", overwriteAnswer, (int) st);
        return;
    }
    if (!st->save && !fileExists(full)) {
        st->where->setText("That file does not exist");
        return;
    }
    finish(st, (int) full);
}

int overwriteAnswer(int yes) {
    DialogState* st = (DialogState*) dialogArg;
    if (yes != 0 && !st->done) {
        finish(st, (int) st->pending);
    }
    return 0;
}

int fileSelected(int self) {
    DialogState* st = stateOf(self);
    int i = st->list->selected;
    if (i >= 0 && i < st->nnames && st->kinds[i] == 0) {
        st->input->setText(st->names[i]);
    }
    return 0;
}

int fileActivated(int self) {
    DialogState* st = stateOf(self);
    int i = st->list->selected;
    if (i < 0 || i >= st->nnames) {
        return 0;
    }
    if (st->kinds[i] == 1) {
        fileEnter(st, path.join(st->dir, st->names[i]));
    } else {
        st->input->setText(st->names[i]);
        fileAccept(st);
    }
    return 0;
}

int fileOk(int self) { fileAccept(stateOf(self)); return 0; }
int fileCancel(int self) { finish(stateOf(self), 0); return 0; }

int fileHidden(int self) {
    gui.CheckBox* c = (gui.CheckBox*) self;
    DialogState* st = stateOf(self);
    st->hidden = c->checked;
    fileRefresh(st);
    return 0;
}

gui.Window* fileDialog(gui.Display* d, char* title, char* startDir, char* name, bool save, func cb, int arg) {
    DialogState* st = newDialog(d, title, 480, 430, 0, cb, arg);
    st->save = save;
    st->names = (char**) calloc(1100, 8);
    st->kinds = (int*) calloc(1100, 8);
    gui.Box* col = gui.vbox(8, 12);
    st->where = new gui.Label("");
    col->add(st->where);
    st->list = new gui.ListBox();
    st->list->flex = 1;
    st->list->onSelect = fileSelected;
    st->list->onActivate = fileActivated;
    col->add(st->list);
    gui.CheckBox* hid = new gui.CheckBox("Show hidden files");
    hid->onChange = fileHidden;
    col->add(hid);
    gui.Box* nameRow = gui.hbox(8, 0);
    nameRow->add(new gui.Label("Name:"));
    st->input = new gui.TextBox();
    st->input->flex = 1;
    st->input->setText(name);
    st->input->onEnter = fileOk;
    nameRow->add(st->input);
    col->add(nameRow);
    gui.Button* ok = new gui.Button(save ? "Save" : "Open");
    ok->primary = true;
    ok->onClick = fileOk;
    gui.Button* cancel = new gui.Button("Cancel");
    cancel->onClick = fileCancel;
    col->add(buttonRow(ok, cancel));
    st->win->setRoot(col);
    st->win->defaultButton = ok;
    char* start = startDir;
    if (start == null || strlen(start) == 0) {
        start = os.getCwd();
    }
    fileEnter(st, start);
    st->win->setFocus(st->input);
    return st->win;
}

public gui.Window* openFile(gui.Display* d, char* title, char* startDir, func cb) {
    return fileDialog(d, title, startDir, "", false, cb, 0);
}

public gui.Window* saveFile(gui.Display* d, char* title, char* startDir, char* name, func cb) {
    return fileDialog(d, title, startDir, name, true, cb, 0);
}

public gui.Window* openFileArg(gui.Display* d, char* title, char* startDir, func cb, int arg) {
    return fileDialog(d, title, startDir, "", false, cb, arg);
}

public gui.Window* saveFileArg(gui.Display* d, char* title, char* startDir, char* name, func cb, int arg) {
    return fileDialog(d, title, startDir, name, true, cb, arg);
}

// ---- chooseColor: red, green and blue sliders (the callback gets 0xFFRRGGBB, 0 when cancelled) --------------------------------------------------
int colorOf(DialogState* st) {
    return gfx.rgb(st->sr->value, st->sg->value, st->sb->value);
}

int colorSlid(int self) {
    DialogState* st = stateOf(self);
    int c = colorOf(st);
    st->swatch->color = c;
    st->swatch->invalidate();
    char* hexd = "0123456789ABCDEF";
    char buf[12];
    buf[0] = '#';
    for (int i = 0; i < 6; i++) {
        buf[1 + i] = hexd[(c >> (20 - i * 4)) & 15];
    }
    buf[7] = 0;
    st->hex->setText(&buf[0]);
    return 0;
}

int colorOk(int self) {
    DialogState* st = stateOf(self);
    finish(st, colorOf(st));
    return 0;
}

gui.Box* sliderRow(char* name, gui.Slider* s) {
    gui.Box* row = gui.hbox(8, 0);
    gui.Label* l = new gui.Label(name);
    l->w = 14;
    row->add(l);
    s->flex = 1;
    row->add(s);
    return row;
}

public gui.Window* chooseColor(gui.Display* d, char* title, int initial, func cb) {
    DialogState* st = newDialog(d, title, 320, 220, adp.F_FIXED, cb, 0);
    gui.Box* col = gui.vbox(8, 14);
    st->sr = new gui.Slider(0, 255);
    st->sg = new gui.Slider(0, 255);
    st->sb = new gui.Slider(0, 255);
    st->swatch = new Swatch(initial, 60, 40);
    st->hex = new gui.Label("#000000");
    st->sr->value = gfx.red(initial);
    st->sg->value = gfx.green(initial);
    st->sb->value = gfx.blue(initial);
    st->sr->onChange = colorSlid;
    st->sg->onChange = colorSlid;
    st->sb->onChange = colorSlid;
    gui.Box* top = gui.hbox(12, 0);
    top->add(st->swatch);
    top->add(st->hex);
    col->add(top);
    col->add(sliderRow("R", st->sr));
    col->add(sliderRow("G", st->sg));
    col->add(sliderRow("B", st->sb));
    gui.Button* ok = new gui.Button("OK");
    ok->primary = true;
    ok->onClick = colorOk;
    gui.Button* cancel = new gui.Button("Cancel");
    cancel->onClick = promptCancel;
    col->add(buttonRow(ok, cancel));
    st->win->setRoot(col);
    st->win->defaultButton = ok;
    st->win->fit();
    colorSlid((int) st->sr);
    return st->win;
}

// =============================================================================
//  TableView: rows and columns with a header (click to sort, drag the edge to resize)
// =============================================================================
const TABLE_ROW = 24;
const TABLE_HEAD = 26;

public class TableView : gui.Widget {
    public int selected;            // visible row, -1 = none
    public func onSelect;           // int f(int table)
    public func onActivate;         // double click or Enter
    public func onSort;             // int f(int table): sortColumn / sortAscending say how; if not set the table sorts by text
    public int sortColumn;          // -1 = unsorted
    public bool sortAscending;
    public bool sortable;
    private char** titles;
    private int* widths;
    private int* aligns;            // 0 left, 1 right
    private int ncols;
    private char** cells;           // rows * ncols
    private int nrows;
    private int cap;
    private int top;
    private int lastClick;
    private int resizing;           // column being resized, -1 none
    private int resizeFrom;
    private int resizeWidth;

    public TableView() {
        super();
        focusable = true;
        selected = -1;
        sortColumn = -1;
        sortAscending = true;
        sortable = true;
        resizing = -1;
        titles = (char**) calloc(16, 8);
        widths = (int*) calloc(16, 8);
        aligns = (int*) calloc(16, 8);
        cap = 16;
        cells = (char**) calloc(cap * 16, 8);
        w = 300;
        h = 160;
        flex = 1;
    }

    public virtual bool wantsScroll() { return true; }
    public virtual int prefW() {
        int t = 0;
        for (int i = 0; i < ncols; i++) { t = t + widths[i]; }
        return t + 2;
    }
    public virtual int prefH() { return 160; }

    // columns have to be added before the first row
    public void addColumn(char* title, int width) {
        if (ncols >= 16) {
            return;
        }
        titles[ncols] = strdup(title);
        widths[ncols] = width;
        ncols++;
    }

    public void setAlign(int col, int align) {
        if (col >= 0 && col < ncols) {
            aligns[col] = align;
        }
    }

    public int rowCount() { return nrows; }
    public int columnCount() { return ncols; }

    public void clear() {
        nrows = 0;
        selected = -1;
        top = 0;
        invalidate();
    }

    // adds an empty row; fill it with setCell
    public int addEmptyRow() {
        if (nrows == cap) {
            cap = cap * 2;
            cells = (char**) realloc((char*) cells, cap * 16 * 8);
        }
        for (int c = 0; c < 16; c++) {
            cells[nrows * 16 + c] = "";
        }
        nrows++;
        invalidate();
        return nrows - 1;
    }

    public void setCell(int row, int col, char* text) {
        if (row >= 0 && row < nrows && col >= 0 && col < 16) {
            cells[row * 16 + col] = strdup(text);
            invalidate();
        }
    }

    public char* cell(int row, int col) {
        if (row < 0 || row >= nrows || col < 0 || col >= 16) {
            return "";
        }
        return cells[row * 16 + col];
    }

    // adds a row from a text with the cells separated by tabs
    public int addRow(char* tabbed) {
        int r = addEmptyRow();
        int col = 0;
        int start = 0;
        int n = strlen(tabbed);
        for (int i = 0; i <= n; i++) {
            if (i == n || tabbed[i] == 9) {
                char* piece = malloc(i - start + 1);
                memcpy(piece, &tabbed[start], i - start);
                piece[i - start] = 0;
                setCell(r, col, piece);
                col++;
                start = i + 1;
            }
        }
        return r;
    }

    private bool numeric(char* s) {
        if (s[0] == 0) { return false; }
        for (int i = 0; s[i] != 0; i++) {
            if (!((s[i] >= '0' && s[i] <= '9') || (i == 0 && s[i] == '-'))) {
                return false;
            }
        }
        return true;
    }

    private int compare(int a, int b, int col) {
        char* x = cells[a * 16 + col];
        char* y = cells[b * 16 + col];
        if (numeric(x) && numeric(y)) {
            int d = atoi(x) - atoi(y);
            return (d < 0) ? -1 : ((d > 0) ? 1 : 0);
        }
        return strcasecmp(x, y);
    }

    // sorts the rows by a column (stable)
    public void sortBy(int col, bool ascending) {
        if (col < 0 || col >= ncols) {
            return;
        }
        sortColumn = col;
        sortAscending = ascending;
        int* perm = (int*) malloc(nrows * 8 + 8);
        for (int i = 0; i < nrows; i++) { perm[i] = i; }
        for (int i = 1; i < nrows; i++) {
            int v = perm[i];
            int j = i - 1;
            while (j >= 0) {
                int c = compare(perm[j], v, col);
                if (ascending ? c <= 0 : c >= 0) { break; }
                perm[j + 1] = perm[j];
                j--;
            }
            perm[j + 1] = v;
        }
        char** copy = (char**) malloc(nrows * 16 * 8 + 8);
        for (int i = 0; i < nrows; i++) {
            for (int c = 0; c < 16; c++) {
                copy[i * 16 + c] = cells[perm[i] * 16 + c];
            }
        }
        int sel = -1;
        for (int i = 0; i < nrows; i++) {
            if (perm[i] == selected) { sel = i; }
        }
        for (int i = 0; i < nrows * 16; i++) { cells[i] = copy[i]; }
        selected = sel;
        invalidate();
    }

    private int rowsShown() { return (h - TABLE_HEAD - 2) / TABLE_ROW; }

    private void clampTop() {
        int r = rowsShown();
        if (top > nrows - r) { top = nrows - r; }
        if (top < 0) { top = 0; }
    }

    public void select(int i) {
        if (i < -1 || i >= nrows) {
            return;
        }
        selected = i;
        int r = rowsShown();
        if (i >= 0 && i < top) { top = i; }
        if (i >= top + r) { top = i - r + 1; }
        clampTop();
        invalidate();
        if (onSelect != null) {
            onSelect(this);
        }
    }

    private int colAt(int mx) {
        int x = 1;
        for (int i = 0; i < ncols; i++) {
            if (mx >= x && mx < x + widths[i]) {
                return i;
            }
            x = x + widths[i];
        }
        return -1;
    }

    // the column whose right edge is near mx
    private int edgeAt(int mx) {
        int x = 1;
        for (int i = 0; i < ncols; i++) {
            x = x + widths[i];
            if (mx >= x - 3 && mx <= x + 3) {
                return i;
            }
        }
        return -1;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        gfx.Font* f = gfx.sans();
        s->fill(ox, oy, w, h, gui.cField);
        // the header
        s->gradientV(ox + 1, oy + 1, w - 2, TABLE_HEAD - 1, 0xFFF4F5F8, 0xFFE0E2EA);
        s->hline(ox + 1, oy + TABLE_HEAD, w - 2, gui.cBorder);
        int x = ox + 1;
        for (int c = 0; c < ncols; c++) {
            s->text(f, x + 6, oy + 1 + (TABLE_HEAD - f->height) / 2, titles[c], gui.cText);
            if (c == sortColumn) {
                int ax = x + widths[c] - 14;
                int ay = oy + TABLE_HEAD / 2;
                for (int k = 0; k < 4; k++) {
                    if (sortAscending) {
                        s->hline(ax + k, ay + 2 - k, 7 - 2 * k, gui.cTextDim);
                    } else {
                        s->hline(ax + k, ay - 2 + k, 7 - 2 * k, gui.cTextDim);
                    }
                }
            }
            x = x + widths[c];
            s->vline(x - 1, oy + 4, TABLE_HEAD - 8, gui.cBorder);
        }
        // the rows
        int r = rowsShown();
        bool focus = (win != null && win->focusWidget == this);
        for (int i = 0; i < r + 1 && top + i < nrows; i++) {
            int idx = top + i;
            int ry = oy + TABLE_HEAD + 1 + i * TABLE_ROW;
            if (ry + TABLE_ROW > oy + h - 1) {
                break;
            }
            int fg = gui.cText;
            if (idx == selected) {
                s->fill(ox + 1, ry, w - 2, TABLE_ROW, focus ? gui.cAccent : gui.cSelect);
                if (focus) { fg = gui.cAccentText; }
            } else if (idx % 2 == 1) {
                s->fill(ox + 1, ry, w - 2, TABLE_ROW, 0xFFF6F7FA);
            }
            int cx = ox + 1;
            for (int c = 0; c < ncols; c++) {
                char* t = cells[idx * 16 + c];
                int tw = gfx.textWidth(f, t);
                int tx = cx + 6;
                if (aligns[c] == 1) {
                    tx = cx + widths[c] - tw - 8;
                }
                // a cell is clipped at its column
                int c0 = s->clipX0;
                int c1 = s->clipX1;
                if (cx + 1 > s->clipX0) { s->clipX0 = cx + 1; }
                if (cx + widths[c] - 2 < s->clipX1) { s->clipX1 = cx + widths[c] - 2; }
                s->text(f, tx, ry + (TABLE_ROW - f->height) / 2, t, fg);
                s->clipX0 = c0;
                s->clipX1 = c1;
                cx = cx + widths[c];
            }
        }
        if (nrows > r && r > 0) {
            int trackH = h - TABLE_HEAD - 2;
            int thumbH = trackH * r / nrows;
            if (thumbH < 12) { thumbH = 12; }
            int thumbY = (trackH - thumbH) * top / (nrows - r);
            s->fillRoundRect(ox + w - 8, oy + TABLE_HEAD + 1 + thumbY, 6, thumbH, 3, gui.cBorder);
        }
        s->rect(ox, oy, w, h, focus ? gui.cAccent : gui.cBorder);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_SCROLL) {
            top = top - button * 3;
            clampTop();
            invalidate();
            return true;
        }
        if (kind == adp.M_MOVE && resizing >= 0) {
            int nw = resizeWidth + (mx - resizeFrom);
            if (nw < 24) { nw = 24; }
            widths[resizing] = nw;
            invalidate();
            return true;
        }
        if (kind == adp.M_UP) {
            resizing = -1;
            return true;
        }
        if (kind == adp.M_DOWN && button == 1) {
            if (my < TABLE_HEAD) {
                int e = edgeAt(mx);
                if (e >= 0) {
                    resizing = e;
                    resizeFrom = mx;
                    resizeWidth = widths[e];
                    return true;
                }
                int c = colAt(mx);
                if (c >= 0 && sortable) {
                    bool asc = (c == sortColumn) ? !sortAscending : true;
                    sortColumn = c;
                    sortAscending = asc;
                    if (onSort != null) {
                        onSort(this);
                    } else {
                        sortBy(c, asc);
                    }
                }
                return true;
            }
            int i = top + (my - TABLE_HEAD - 1) / TABLE_ROW;
            if (i >= 0 && i < nrows) {
                select(i);
                int now = millis();
                if (now - lastClick < 400 && onActivate != null) {
                    onActivate(this);
                }
                lastClick = now;
            }
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        int r = rowsShown();
        if (key == adp.KEY_DOWN) { select((selected < nrows - 1) ? selected + 1 : selected); return true; }
        if (key == adp.KEY_UP) { select((selected > 0) ? selected - 1 : selected); return true; }
        if (key == adp.KEY_PGDN) { select((selected + r < nrows) ? selected + r : nrows - 1); return true; }
        if (key == adp.KEY_PGUP) { select((selected - r > 0) ? selected - r : 0); return true; }
        if (key == adp.KEY_HOME && nrows > 0) { select(0); return true; }
        if (key == adp.KEY_END && nrows > 0) { select(nrows - 1); return true; }
        if (key == adp.KEY_ENTER && selected >= 0 && onActivate != null) { onActivate(this); return true; }
        return false;
    }

    public virtual void onFocus(bool gained) { invalidate(); }
}

// =============================================================================
//  TreeView: expandable nodes
// =============================================================================
public class TreeNode {
    public char* text;
    public int userData;
    public bool expanded;
    public bool lazy;               // shows an arrow although it has no children yet (they are added by TreeView.onExpand)
    public TreeNode* parent;
    public TreeNode** kids;
    public int count;
    private int cap;

    public TreeNode(char* t) {
        text = strdup(t);
        cap = 4;
        kids = (TreeNode**) calloc(cap, 8);
    }

    public TreeNode* add(char* t) {
        if (count == cap) {
            cap = cap * 2;
            kids = (TreeNode**) realloc((char*) kids, cap * 8);
        }
        TreeNode* n = new TreeNode(t);
        n->parent = this;
        kids[count] = n;
        count++;
        return n;
    }

    public void clear() {
        count = 0;
    }

    public int depth() {
        int d = 0;
        TreeNode* p = parent;
        while (p != null && p->parent != null) {      // the invisible root does not count
            d++;
            p = p->parent;
        }
        return d;
    }
}

const TREE_ROW = 22;
const TREE_INDENT = 18;

public class TreeView : gui.Widget {
    public TreeNode* root;          // invisible; its children are the top level
    public TreeNode* selected;
    public TreeNode* expandedNode;  // the node onExpand is about
    public func onSelect;           // int f(int tree)
    public func onActivate;         // double click or Enter on a node
    public func onExpand;           // int f(int tree): a node was opened (add its children if they are loaded on demand)
    private TreeNode** vis;
    private int nvis;
    private int capVis;
    private int top;
    private int lastClick;

    public TreeView() {
        super();
        focusable = true;
        root = new TreeNode("");
        root->expanded = true;
        w = 200;
        h = 200;
        flex = 1;
        capVis = 64;
        vis = (TreeNode**) calloc(capVis, 8);
    }

    public virtual bool wantsScroll() { return true; }
    public virtual int prefW() { return 200; }
    public virtual int prefH() { return 200; }

    public TreeNode* addRoot(char* text) {
        TreeNode* n = root->add(text);
        invalidate();
        return n;
    }

    private void flatten(TreeNode* n) {
        for (int i = 0; i < n->count; i++) {
            TreeNode* k = n->kids[i];
            if (nvis == capVis) {
                capVis = capVis * 2;
                vis = (TreeNode**) realloc((char*) vis, capVis * 8);
            }
            vis[nvis] = k;
            nvis++;
            if (k->expanded) {
                flatten(k);
            }
        }
    }

    // the visible nodes in order (rebuilt on every call; trees are small)
    private void rebuild() {
        nvis = 0;
        flatten(root);
        int r = rows();
        if (top > nvis - r) { top = nvis - r; }
        if (top < 0) { top = 0; }
    }

    private int rows() { return (h - 2) / TREE_ROW; }

    private int indexOf(TreeNode* n) {
        for (int i = 0; i < nvis; i++) {
            if (vis[i] == n) { return i; }
        }
        return -1;
    }

    public void select(TreeNode* n) {
        rebuild();
        selected = n;
        int i = indexOf(n);
        int r = rows();
        if (i >= 0 && i < top) { top = i; }
        if (i >= top + r) { top = i - r + 1; }
        invalidate();
        if (onSelect != null) {
            onSelect(this);
        }
    }

    public void expand(TreeNode* n, bool open) {
        if (n->expanded == open) {
            return;
        }
        n->expanded = open;
        if (open && onExpand != null) {
            expandedNode = n;
            onExpand(this);
        }
        if (!open && selected != null) {
            // a selected node inside the closed one moves the selection to it
            TreeNode* p = selected->parent;
            while (p != null) {
                if (p == n) {
                    selected = n;
                    break;
                }
                p = p->parent;
            }
        }
        invalidate();
    }

    private bool hasKids(TreeNode* n) { return n->count > 0 || n->lazy; }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        rebuild();
        gfx.Font* f = gfx.sans();
        s->fill(ox, oy, w, h, gui.cField);
        bool focus = (win != null && win->focusWidget == this);
        int r = rows();
        for (int i = 0; i < r + 1 && top + i < nvis; i++) {
            TreeNode* n = vis[top + i];
            int ry = oy + 1 + i * TREE_ROW;
            if (ry + TREE_ROW > oy + h - 1) {
                break;
            }
            int fg = gui.cText;
            if (n == selected) {
                s->fill(ox + 1, ry, w - 2, TREE_ROW, focus ? gui.cAccent : gui.cSelect);
                if (focus) { fg = gui.cAccentText; }
            }
            int x = ox + 4 + n->depth() * TREE_INDENT;
            if (hasKids(n)) {
                int ay = ry + TREE_ROW / 2;
                for (int k = 0; k < 4; k++) {
                    if (n->expanded) {
                        s->hline(x + 2 + k, ay - 2 + k, 8 - 2 * k, fg);
                    } else {
                        s->vline(x + 3 + k, ay - 4 + k, 9 - 2 * k, fg);
                    }
                }
            }
            s->text(f, x + 16, ry + (TREE_ROW - f->height) / 2, n->text, fg);
        }
        if (nvis > r && r > 0) {
            int trackH = h - 2;
            int thumbH = trackH * r / nvis;
            if (thumbH < 12) { thumbH = 12; }
            int thumbY = (trackH - thumbH) * top / (nvis - r);
            s->fillRoundRect(ox + w - 8, oy + 1 + thumbY, 6, thumbH, 3, gui.cBorder);
        }
        s->rect(ox, oy, w, h, focus ? gui.cAccent : gui.cBorder);
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_SCROLL) {
            top = top - button * 3;
            rebuild();
            invalidate();
            return true;
        }
        if (kind == adp.M_DOWN && button == 1) {
            rebuild();
            int i = top + (my - 1) / TREE_ROW;
            if (i < 0 || i >= nvis) {
                return true;
            }
            TreeNode* n = vis[i];
            int x = 4 + n->depth() * TREE_INDENT;
            if (hasKids(n) && mx >= x && mx < x + 14) {
                expand(n, !n->expanded);
                return true;
            }
            select(n);
            int now = millis();
            if (now - lastClick < 400) {
                if (hasKids(n)) {
                    expand(n, !n->expanded);
                }
                if (onActivate != null) {
                    onActivate(this);
                }
            }
            lastClick = now;
        }
        return true;
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0) { return false; }
        rebuild();
        int i = indexOf(selected);
        if (key == adp.KEY_DOWN) {
            if (i < nvis - 1) { select(vis[i + 1]); } else if (i < 0 && nvis > 0) { select(vis[0]); }
            return true;
        }
        if (key == adp.KEY_UP) {
            if (i > 0) { select(vis[i - 1]); }
            return true;
        }
        if (key == adp.KEY_HOME && nvis > 0) { select(vis[0]); return true; }
        if (key == adp.KEY_END && nvis > 0) { select(vis[nvis - 1]); return true; }
        if (key == adp.KEY_PGDN && nvis > 0) { select(vis[(i + rows() < nvis) ? i + rows() : nvis - 1]); return true; }
        if (key == adp.KEY_PGUP && nvis > 0) { select(vis[(i - rows() > 0) ? i - rows() : 0]); return true; }
        if (selected == null) {
            return false;
        }
        if (key == adp.KEY_RIGHT) {
            if (hasKids(selected) && !selected->expanded) {
                expand(selected, true);
            } else if (selected->count > 0) {
                select(selected->kids[0]);
            }
            return true;
        }
        if (key == adp.KEY_LEFT) {
            if (selected->expanded && hasKids(selected)) {
                expand(selected, false);
            } else if (selected->parent != null && selected->parent != root) {
                select(selected->parent);
            }
            return true;
        }
        if (key == adp.KEY_ENTER) {
            if (hasKids(selected)) {
                expand(selected, !selected->expanded);
            }
            if (onActivate != null) {
                onActivate(this);
            }
            return true;
        }
        return false;
    }

    public virtual void onFocus(bool gained) { invalidate(); }
}
