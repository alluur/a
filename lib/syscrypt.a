// =============================================================================
//  syscrypt - checking system password hashes ($6$ SHA-512 crypt, as in /etc/shadow)       import syscrypt;
//
//    char* h = syscrypt.sha512crypt("secret", "$6$abcdefgh");    // "$6$abcdefgh$ltjgWl65..."
//    bool ok = syscrypt.verify("secret", hashFromShadow);
//
//  Supports the $6$ format with an optional "rounds=N$" (default 5000). Other formats ($1$, $5$, $y$ ...) are not
//  supported: verify() returns false for them. The hashes are the same as those of crypt(3), mkpasswd -m sha-512
//  and "openssl passwd -6".
// =============================================================================
import hash;
import cstdlib;
module syscrypt;

private char* itoa64 = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";

private void emit(char* out, int* pos, int b2, int b1, int b0, int n) {
    int w = (b2 << 16) | (b1 << 8) | b0;
    for (int i = 0; i < n; i++) {
        out[*pos] = itoa64[w & 63];
        *pos = *pos + 1;
        w = w >> 6;
    }
}

// the SHA-512 crypt hash of a password for a setting "$6$[rounds=N$]salt"; null if the setting is not of that kind
public char* sha512crypt(char* password, char* setting) {
    if (setting[0] != '$' || setting[1] != '6' || setting[2] != '$') {
        return null;
    }
    char* p = &setting[3];
    int rounds = 5000;
    bool customRounds = false;
    if (startsWith(p, "rounds=")) {
        int r = atoi(&p[7]);
        char* q = &p[7];
        while (q[0] >= '0' && q[0] <= '9') {
            q++;
        }
        if (q[0] == '$') {
            if (r < 1000) { r = 1000; }
            if (r > 999999999) { r = 999999999; }
            rounds = r;
            customRounds = true;
            p = &q[1];
        }
    }
    int saltLen = 0;
    while (saltLen < 16 && p[saltLen] != 0 && p[saltLen] != '$') {
        saltLen++;
    }
    char* salt = p;
    int pwLen = strlen(password);

    hash.Sha512 ctx();
    char b[64];
    char a[64];
    char dp[64];
    char ds[64];
    char c[64];

    // B = H(password salt password)
    ctx.update(password, pwLen);
    ctx.update(salt, saltLen);
    ctx.update(password, pwLen);
    ctx.final(&b[0]);

    // A = H(password salt  B repeated for the length of the password  bits of the length)
    ctx.update(password, pwLen);
    ctx.update(salt, saltLen);
    int cnt = pwLen;
    while (cnt > 64) {
        ctx.update(&b[0], 64);
        cnt = cnt - 64;
    }
    ctx.update(&b[0], cnt);
    cnt = pwLen;
    while (cnt > 0) {
        if ((cnt & 1) != 0) {
            ctx.update(&b[0], 64);
        } else {
            ctx.update(password, pwLen);
        }
        cnt = cnt >> 1;
    }
    ctx.final(&a[0]);

    // DP = H(password repeated pwLen times), P = DP stretched to pwLen bytes
    for (int i = 0; i < pwLen; i++) {
        ctx.update(password, pwLen);
    }
    ctx.final(&dp[0]);
    char* pseq = malloc(pwLen + 64);
    for (int i = 0; i < pwLen; i++) {
        pseq[i] = dp[i % 64];
    }

    // DS = H(salt repeated 16 + A[0] times), S = DS stretched to saltLen bytes
    for (int i = 0; i < 16 + (a[0] & 255); i++) {
        ctx.update(salt, saltLen);
    }
    ctx.final(&ds[0]);
    char* sseq = malloc(saltLen + 64);
    for (int i = 0; i < saltLen; i++) {
        sseq[i] = ds[i % 64];
    }

    for (int i = 0; i < rounds; i++) {
        if ((i & 1) != 0) {
            ctx.update(pseq, pwLen);
        } else {
            ctx.update(&a[0], 64);
        }
        if (i % 3 != 0) {
            ctx.update(sseq, saltLen);
        }
        if (i % 7 != 0) {
            ctx.update(pseq, pwLen);
        }
        if ((i & 1) != 0) {
            ctx.update(&a[0], 64);
        } else {
            ctx.update(pseq, pwLen);
        }
        ctx.final(&c[0]);
        memcpy(&a[0], &c[0], 64);
    }
    free(pseq);
    free(sseq);

    char* out = malloc(saltLen + 140);
    int pos = 0;
    memcpy(&out[0], "$6$", 3);
    pos = 3;
    if (customRounds) {
        pos = pos + format(&out[pos], 32, "rounds=%d$", rounds);
    }
    memcpy(&out[pos], salt, saltLen);
    pos = pos + saltLen;
    out[pos] = '$';
    pos++;
    emit(out, &pos, a[0], a[21], a[42], 4);
    emit(out, &pos, a[22], a[43], a[1], 4);
    emit(out, &pos, a[44], a[2], a[23], 4);
    emit(out, &pos, a[3], a[24], a[45], 4);
    emit(out, &pos, a[25], a[46], a[4], 4);
    emit(out, &pos, a[47], a[5], a[26], 4);
    emit(out, &pos, a[6], a[27], a[48], 4);
    emit(out, &pos, a[28], a[49], a[7], 4);
    emit(out, &pos, a[50], a[8], a[29], 4);
    emit(out, &pos, a[9], a[30], a[51], 4);
    emit(out, &pos, a[31], a[52], a[10], 4);
    emit(out, &pos, a[53], a[11], a[32], 4);
    emit(out, &pos, a[12], a[33], a[54], 4);
    emit(out, &pos, a[34], a[55], a[13], 4);
    emit(out, &pos, a[56], a[14], a[35], 4);
    emit(out, &pos, a[15], a[36], a[57], 4);
    emit(out, &pos, a[37], a[58], a[16], 4);
    emit(out, &pos, a[59], a[17], a[38], 4);
    emit(out, &pos, a[18], a[39], a[60], 4);
    emit(out, &pos, a[40], a[61], a[19], 4);
    emit(out, &pos, a[62], a[20], a[41], 4);
    emit(out, &pos, 0, 0, a[63], 2);
    out[pos] = 0;
    return out;
}

// true if password matches a hash made by sha512crypt (the whole hash string is the setting)
public bool verify(char* password, char* stored) {
    char* h = sha512crypt(password, stored);
    if (h == null) {
        return false;
    }
    // compare without stopping early
    int n = strlen(stored);
    int hl = strlen(h);
    int diff = n ^ hl;
    for (int i = 0; i < n && i < hl; i++) {
        diff = diff | (stored[i] ^ h[i]);
    }
    return diff == 0;
}
