// =============================================================================
//  encoding - base64, hexadecimal and URL encoding          import encoding;
//  Functions that produce text return NEW heap strings.
// =============================================================================
module encoding;

private int b64char(int v) {
    if (v < 26) return 'A' + v;
    if (v < 52) return 'a' + v - 26;
    if (v < 62) return '0' + v - 52;
    if (v == 62) return '+';
    return '/';
}

private int b64val(int c) {
    if (c >= 'A' && c <= 'Z') return c - 'A';
    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
    if (c >= '0' && c <= '9') return c - '0' + 52;
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1;
}

// base64 text of n bytes
public char* base64Encode(char* data, int n) {
    char* out = alloc((n + 2) / 3 * 4 + 1);
    int o = 0;
    for (int i = 0; i < n; i = i + 3) {
        int b0 = data[i];
        int b1 = 0;
        int b2 = 0;
        if (i + 1 < n) b1 = data[i + 1];
        if (i + 2 < n) b2 = data[i + 2];
        out[o] = b64char(b0 >> 2);
        out[o + 1] = b64char(((b0 & 3) << 4) | (b1 >> 4));
        if (i + 1 < n) out[o + 2] = b64char(((b1 & 15) << 2) | (b2 >> 6)); else out[o + 2] = '=';
        if (i + 2 < n) out[o + 3] = b64char(b2 & 63); else out[o + 3] = '=';
        o = o + 4;
    }
    return out;
}

// decodes base64 text into out (which needs strlen(s) * 3 / 4 bytes); returns the byte count or -1
public int base64Decode(char* s, char* out) {
    int o = 0;
    int acc = 0;
    int bits = 0;
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == '=') {
            break;
        }
        int v = b64val(s[i]);
        if (v < 0) {
            if (isSpace(s[i])) continue;
            return -1;
        }
        acc = (acc << 6) | v;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            out[o] = (acc >> bits) & 255;
            o++;
        }
    }
    return o;
}

// lowercase hexadecimal text of n bytes
public char* hexEncode(char* data, int n) {
    char* out = alloc(n * 2 + 1);
    for (int i = 0; i < n; i++) {
        int hi = data[i] >> 4;
        int lo = data[i] & 15;
        if (hi < 10) out[i * 2] = '0' + hi; else out[i * 2] = 'a' + hi - 10;
        if (lo < 10) out[i * 2 + 1] = '0' + lo; else out[i * 2 + 1] = 'a' + lo - 10;
    }
    return out;
}

private int hexVal(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

// decodes hexadecimal text into out; returns the byte count or -1 if the text is not valid
public int hexDecode(char* s, char* out) {
    int n = strlen(s);
    if (n % 2 != 0) {
        return -1;
    }
    for (int i = 0; i < n; i = i + 2) {
        int hi = hexVal(s[i]);
        int lo = hexVal(s[i + 1]);
        if (hi < 0 || lo < 0) {
            return -1;
        }
        out[i / 2] = hi * 16 + lo;
    }
    return n / 2;
}

// percent-encodes everything except letters, digits and - _ . ~
public char* urlEncode(char* s) {
    char* out = alloc(strlen(s) * 3 + 1);
    int o = 0;
    for (int i = 0; s[i] != 0; i++) {
        int c = s[i];
        if (isAlpha(c) || isDigit(c) || c == '-' || c == '_' || c == '.' || c == '~') {
            out[o] = c;
            o++;
        } else {
            out[o] = '%';
            int hi = c >> 4;
            int lo = c & 15;
            if (hi < 10) out[o + 1] = '0' + hi; else out[o + 1] = 'A' + hi - 10;
            if (lo < 10) out[o + 2] = '0' + lo; else out[o + 2] = 'A' + lo - 10;
            o = o + 3;
        }
    }
    return out;
}

public char* urlDecode(char* s) {
    char* out = alloc(strlen(s) + 1);
    int o = 0;
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == '%' && hexVal(s[i + 1]) >= 0 && hexVal(s[i + 2]) >= 0) {
            out[o] = hexVal(s[i + 1]) * 16 + hexVal(s[i + 2]);
            i = i + 2;
        } else if (s[i] == '+') {
            out[o] = ' ';
        } else {
            out[o] = s[i];
        }
        o++;
    }
    return out;
}
