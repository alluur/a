// =============================================================================
//  gnet - network helpers that keep a gui program responsive                                          import gnet;
//
//    gnet.Fetch* f = new gnet.Fetch();
//    f->onDone = finished;                        // int finished(int fetch) { ... return 0; }
//    f->onProgress = progress;                    // int progress(int fetch)   received / contentLength
//    f->start(display, "http://example.org/index.html", null);
//    ... in finished:  f->status  f->headers  f->body  f->bodyLen  f->error
//
//  Fetch is an HTTP/1.1 GET that does not block: the response is read as it arrives, inside the event loop of the display
//  (gui.Display.watch). Redirects (up to 5), chunked bodies and Content-Length are handled; plain http:// only. Connecting
//  and looking up the name still wait (the time limit is 4 seconds).
//
//    gnet.Scan* s = new gnet.Scan();              a port scanner that tests one port per turn of the event loop
//    s->onFound = found;  s->onDone = scanned;    int found(int scan) { ... s->lastFound ... }
//    s->start(display, "192.168.1.10", 1, 1024, 200);
// =============================================================================
import gui;
import net;
import http;
import netutil;
import cstdlib;
import cstring;
module gnet;

int fetchReadable(int arg);
int scanTick(int arg);

public class Fetch {
    public func onDone;             // int f(int fetch)
    public func onProgress;         // int f(int fetch)
    public int status;              // the HTTP status, 0 until the headers are in
    public char* headers;           // the response headers (text)
    public char* body;              // the body (NUL terminated)
    public int bodyLen;
    public char* error;             // null when it worked
    public char* url;               // the address that was finally fetched
    public int received;            // bytes of the body so far
    public int contentLength;       // -1 when the server did not say
    public int elapsed;             // milliseconds
    public bool done;
    public int maxBytes;
    public int userData;
    private gui.Display* display;
    private int fd;
    private char* buf;
    private int len;
    private int cap;
    private int headEnd;            // offset of the body in buf, -1 until the headers are complete
    private bool chunked;
    private int redirects;
    private int started;
    private char* extra;

    public Fetch() {
        fd = -1;
        headEnd = -1;
        contentLength = -1;
        maxBytes = 8 * 1024 * 1024;
        body = "";
        headers = "";
    }

    public bool running() { return fd >= 0; }

    private void fail(char* why) {
        error = why;
        finish();
    }

    // starts the request; false (and error set) if it could not be started
    public bool start(gui.Display* d, char* address, char* extraHeaders) {
        display = d;
        extra = extraHeaders;
        if (started == 0) {
            started = millis();
        }
        url = strdup(address);
        http.Url u;
        if (!http.parseUrl(address, &u)) {
            error = "not a valid http:// address";
            done = true;
            return false;
        }
        if (streq(&u.scheme[0], "https")) {
            error = "https is not supported (no TLS)";
            done = true;
            return false;
        }
        fd = net.connectTimeout(&u.host[0], u.port, 4000);
        if (fd < 0) {
            error = "cannot connect";
            done = true;
            return false;
        }
        char* req = malloc(strlen(&u.path[0]) + strlen(&u.host[0]) + 300 + ((extraHeaders != null) ? strlen(extraHeaders) : 0));
        strcpy(req, "GET ");
        strcat(req, &u.path[0]);
        strcat(req, " HTTP/1.1\r\nHost: ");
        strcat(req, &u.host[0]);
        strcat(req, "\r\nConnection: close\r\nUser-Agent: A-gnet/1\r\nAccept: */*\r\n");
        if (extraHeaders != null) {
            strcat(req, extraHeaders);
        }
        strcat(req, "\r\n");
        if (net.send(fd, req, strlen(req)) < 0) {
            net.close(fd);
            fd = -1;
            error = "cannot send the request";
            done = true;
            return false;
        }
        cap = 16384;
        buf = malloc(cap);
        len = 0;
        headEnd = -1;
        received = 0;
        contentLength = -1;
        chunked = false;
        status = 0;
        d->watch(fd, fetchReadable, (int) this);
        return true;
    }

    public void cancel() {
        if (fd >= 0) {
            display->unwatch(fd);
            net.close(fd);
            fd = -1;
        }
        if (!done) {
            error = "cancelled";
            done = true;
        }
    }

    // called when the socket has something to read
    public void readable() {
        if (len + 8192 > cap) {
            cap = cap * 2;
            buf = realloc(buf, cap);
        }
        int n = net.recv(fd, &buf[len], 8192);
        if (n < 0) {
            fail("the connection failed");
            return;
        }
        if (n == 0) {
            finish();
            return;
        }
        len = len + n;
        if (len > maxBytes + 65536) {
            fail("the response is too large");
            return;
        }
        if (headEnd < 0) {
            findHeaders();
        }
        if (headEnd >= 0) {
            received = len - headEnd;
            if (onProgress != null) {
                onProgress(this);
            }
        }
    }

    private void findHeaders() {
        for (int i = 3; i < len; i++) {
            if (buf[i - 3] == 13 && buf[i - 2] == 10 && buf[i - 1] == 13 && buf[i] == 10) {
                headEnd = i + 1;
                char* h = malloc(headEnd + 1);
                memcpy(h, buf, headEnd);
                h[headEnd] = 0;
                headers = h;
                // "HTTP/1.1 200 OK"
                int sp = indexOf(h, ' ');
                status = (sp > 0) ? atoi(&h[sp + 1]) : 0;
                char value[64];
                if (http.headerOf(h, "Content-Length", &value[0], 64)) {
                    contentLength = atoi(&value[0]);
                }
                if (http.headerOf(h, "Transfer-Encoding", &value[0], 64) && indexOf(&value[0], 'c') >= 0) {
                    chunked = true;
                }
                return;
            }
        }
    }

    private void finish() {
        if (fd >= 0) {
            display->unwatch(fd);
            net.close(fd);
            fd = -1;
        }
        if (headEnd < 0 && error == null) {
            error = "no response";
        }
        if (headEnd >= 0) {
            // a redirect starts the next request
            if ((status == 301 || status == 302 || status == 303 || status == 307 || status == 308) && redirects < 5 && error == null) {
                char loc[1024];
                if (http.headerOf(headers, "Location", &loc[0], 1024)) {
                    redirects++;
                    char* next = absolute(&loc[0]);
                    if (start(display, next, extra)) {
                        return;
                    }
                    done = true;
                    elapsed = millis() - started;
                    if (onDone != null) { onDone(this); }
                    return;
                }
            }
            int bl = len - headEnd;
            char* raw = &buf[headEnd];
            if (chunked) {
                char* dec = malloc(bl + 1);
                bl = unchunk(raw, bl, dec);
                body = dec;
            } else {
                if (contentLength >= 0 && bl > contentLength) {
                    bl = contentLength;
                }
                char* b = malloc(bl + 1);
                memcpy(b, raw, bl);
                b[bl] = 0;
                body = b;
                if (contentLength >= 0 && bl < contentLength && error == null) {
                    error = "the connection ended before the whole body arrived";
                }
            }
            bodyLen = bl;
            received = bl;
        }
        done = true;
        elapsed = millis() - started;
        if (onDone != null) {
            onDone(this);
        }
    }

    // the absolute address for the value of a Location header
    private char* absolute(char* loc) {
        if (startsWith(loc, "http://") || startsWith(loc, "https://")) {
            return strdup(loc);
        }
        http.Url u;
        http.parseUrl(url, &u);
        char* r = malloc(strlen(loc) + 300);
        strcpy(r, "http://");
        strcat(r, &u.host[0]);
        if (u.port != 80) {
            char p[12];
            format(&p[0], 12, ":%d", u.port);
            strcat(r, &p[0]);
        }
        if (loc[0] != '/') {
            strcat(r, "/");
        }
        strcat(r, loc);
        return r;
    }
}

// decodes a chunked body; returns the length of the data
int unchunk(char* in, int n, char* out) {
    int at = 0;
    int o = 0;
    while (at < n) {
        int size = 0;
        while (at < n && in[at] != 13 && in[at] != 10 && in[at] != ';') {
            int c = in[at];
            int v = -1;
            if (c >= '0' && c <= '9') { v = c - '0'; }
            else if (c >= 'a' && c <= 'f') { v = c - 'a' + 10; }
            else if (c >= 'A' && c <= 'F') { v = c - 'A' + 10; }
            if (v < 0) { break; }
            size = size * 16 + v;
            at++;
        }
        while (at < n && in[at] != 10) { at++; }
        at++;
        if (size == 0 || at > n) {
            break;
        }
        if (at + size > n) {
            size = n - at;
        }
        memcpy(&out[o], &in[at], size);
        o = o + size;
        at = at + size + 2;
    }
    out[o] = 0;
    return o;
}

int fetchReadable(int arg) {
    Fetch* f = (Fetch*) arg;
    f->readable();
    return 0;
}

// =============================================================================
//  Scan: a port scanner that works one port at a time between events
// =============================================================================
public class Scan {
    public func onFound;            // int f(int scan): lastFound is the open port
    public func onProgress;         // int f(int scan): current
    public func onDone;             // int f(int scan)
    public int current;
    public int last;
    public int first;
    public int lastFound;
    public int found;
    public int timeout;
    public bool running;
    private char* host;
    private gui.Display* display;

    public bool start(gui.Display* d, char* hostName, int from, int to, int timeoutMs) {
        if (running || from < 1 || to > 65535 || from > to) {
            return false;
        }
        display = d;
        host = strdup(hostName);
        first = from;
        current = from;
        last = to;
        timeout = timeoutMs;
        found = 0;
        running = true;
        d->after(1, scanTick, (int) this);
        return true;
    }

    public void stop() {
        running = false;
    }

    public void tick() {
        if (!running) {
            return;
        }
        if (current > last) {
            running = false;
            if (onDone != null) { onDone(this); }
            return;
        }
        if (netutil.portOpen(host, current, timeout)) {
            lastFound = current;
            found++;
            if (onFound != null) { onFound(this); }
        }
        current++;
        if (onProgress != null) { onProgress(this); }
        display->after(1, scanTick, (int) this);
    }
}

int scanTick(int arg) {
    Scan* s = (Scan*) arg;
    s->tick();
    return 0;
}

// =============================================================================
//  Conn and Listener: TCP connections inside the event loop
//
//    gnet.Conn* c = new gnet.Conn();
//    c->onLine = gotLine;                         // int gotLine(int conn): c->line is one line (without the newline)
//    c->onClose = closed;
//    c->connect(display, "192.168.1.20", 7788, 3000);
//    c->sendLine("hello");
//
//    gnet.Listener* l = new gnet.Listener();
//    l->onAccept = accepted;                      // int accepted(int listener): l->accepted is the new Conn (set its callbacks)
//    l->start(display, "0.0.0.0", 7788);
//  With onData instead of onLine the raw bytes arrive (c->data, c->dataLen). Sending waits at most one second.
// =============================================================================
int connReadable(int arg);
int listenReadable(int arg);
int beaconReadable(int arg);

public class Conn {
    public func onLine;
    public func onData;
    public func onClose;
    public char* line;
    public char* data;
    public int dataLen;
    public bool open;
    public int userData;
    public int peerIp;
    public int peerPort;
    private gui.Display* display;
    private int fd;
    private char* buf;
    private int len;
    private int cap;

    public Conn() {
        fd = -1;
        line = "";
        data = "";
    }

    // connects (waiting for the connection for at most timeoutMs)
    public bool connect(gui.Display* d, char* host, int port, int timeoutMs) {
        int h = net.connectTimeout(host, port, timeoutMs);
        if (h < 0) {
            return false;
        }
        attach(d, h);
        return true;
    }

    // takes over a connected socket
    public void attach(gui.Display* d, int handle) {
        display = d;
        fd = handle;
        open = true;
        net.setNoDelay(fd, true);
        net.setTimeout(fd, 1000);
        net.peer(fd, &peerIp, &peerPort);
        cap = 8192;
        buf = malloc(cap);
        len = 0;
        d->watch(fd, connReadable, (int) this);
    }

    public bool send(char* bytes, int n) {
        if (!open) {
            return false;
        }
        if (net.send(fd, bytes, n) < 0) {
            close();
            return false;
        }
        return true;
    }

    public bool sendText(char* text) { return send(text, strlen(text)); }

    public bool sendLine(char* text) {
        char* t = malloc(strlen(text) + 2);
        strcpy(t, text);
        t[strlen(text)] = 10;
        t[strlen(text) + 1] = 0;
        return send(t, strlen(t));
    }

    public void close() {
        if (!open) {
            return;
        }
        open = false;
        display->unwatch(fd);
        net.close(fd);
        fd = -1;
        if (onClose != null) {
            onClose(this);
        }
    }

    public void readable() {
        if (len + 4096 > cap) {
            cap = cap * 2;
            buf = realloc(buf, cap);
        }
        int n = net.recv(fd, &buf[len], 4096);
        if (n <= 0) {
            close();
            return;
        }
        if (onData != null) {
            char* d = malloc(n + 1);
            memcpy(d, &buf[len], n);
            d[n] = 0;
            data = d;
            dataLen = n;
            onData(this);
            return;
        }
        len = len + n;
        int start = 0;
        for (int i = 0; i < len && open; i++) {
            if (buf[i] == 10) {
                int e = i;
                if (e > start && buf[e - 1] == 13) { e--; }
                char* l = malloc(e - start + 1);
                memcpy(l, &buf[start], e - start);
                l[e - start] = 0;
                line = l;
                start = i + 1;
                if (onLine != null) {
                    onLine(this);
                }
            }
        }
        if (!open) {
            return;
        }
        if (start > 0) {
            memmove(buf, &buf[start], len - start);
            len = len - start;
        }
        if (len > 65536) {
            close();                // a line this long is not a line
        }
    }
}

public class Listener {
    public func onAccept;
    public Conn* accepted;
    public int port;
    public int userData;
    private gui.Display* display;
    private int fd;

    public Listener() {
        fd = -1;
    }

    public bool start(gui.Display* d, char* host, int portNumber) {
        fd = net.listenOn(host, portNumber, 16);
        if (fd < 0) {
            return false;
        }
        display = d;
        port = net.localPort(fd);
        d->watch(fd, listenReadable, (int) this);
        return true;
    }

    public void stop() {
        if (fd >= 0) {
            display->unwatch(fd);
            net.close(fd);
            fd = -1;
        }
    }

    public void readable() {
        int h = net.accept(fd);
        if (h < 0) {
            return;
        }
        Conn* c = new Conn();
        c->attach(display, h);
        accepted = c;
        if (onAccept != null) {
            onAccept(this);
        }
    }
}

int connReadable(int arg) {
    Conn* c = (Conn*) arg;
    c->readable();
    return 0;
}

int listenReadable(int arg) {
    Listener* l = (Listener*) arg;
    l->readable();
    return 0;
}

// =============================================================================
//  Beacon: UDP datagrams in the event loop (announcements on a LAN)
// =============================================================================
public class Beacon {
    public func onPacket;           // int f(int beacon): text, fromIp, fromPort
    public char* text;
    public int fromIp;
    public int fromPort;
    public int port;
    public int userData;
    private gui.Display* display;
    private int fd;

    public Beacon() {
        fd = -1;
    }

    // listens for datagrams on a UDP port (0: any free port)
    public bool start(gui.Display* d, int portNumber) {
        fd = net.udpBind(portNumber);
        if (fd < 0) {
            return false;
        }
        display = d;
        net.setBroadcast(fd, true);
        port = net.localPort(fd);
        d->watch(fd, beaconReadable, (int) this);
        return true;
    }

    public void stop() {
        if (fd >= 0) {
            display->unwatch(fd);
            net.close(fd);
            fd = -1;
        }
    }

    public bool send(int ip, int portNumber, char* message) {
        return fd >= 0 && net.sendTo(fd, ip, portNumber, message, strlen(message)) >= 0;
    }

    // to every computer on the local network
    public bool broadcast(int portNumber, char* message) {
        return send(0xFFFFFFFF, portNumber, message);
    }

    public void readable() {
        char b[1500];
        int ip = 0;
        int p = 0;
        int n = net.recvFrom(fd, &b[0], 1499, &ip, &p);
        if (n < 0) {
            return;
        }
        b[n] = 0;
        text = strdup(&b[0]);
        fromIp = ip;
        fromPort = p;
        if (onPacket != null) {
            onPacket(this);
        }
    }
}

int beaconReadable(int arg) {
    Beacon* b = (Beacon*) arg;
    b->readable();
    return 0;
}

// =============================================================================
//  Chat: peer-to-peer chat on a network (no server): every program listens, announces itself and connects to the others
//
//    gnet.Chat* chat = new gnet.Chat("anna", 7788, 7788);     // name, TCP port, UDP port for announcements
//    chat->onEvent = event;       // int event(int chat): chat->eventKind (1 joined, 2 left, 3 message, 4 note), eventName, eventText
//    chat->start(display);
//    chat->say("hello");                                      // goes to everybody
//    chat->addTarget(ip, udpPort);                            // also announce to this address (the LAN broadcast is always used)
//    chat->connectTo("192.168.1.20", 7788);                   // connect to a peer by hand
//
//  Announcements are  "ACHAT1 name tcpPort"  datagrams every 3 seconds; of two programs that find each other the one whose
//  "name@ip:port" sorts higher connects. Messages are lines:  HELLO name / MSG text / BYE.  There is no encryption or
//  authentication: use it on a network you trust.
// =============================================================================
int chatListenAccepted(int arg);
int chatBeaconPacket(int arg);
int chatAnnounce(int arg);
int chatLine(int arg);
int chatClosed(int arg);

public class Chat {
    public func onEvent;
    public int eventKind;
    public char* eventName;
    public char* eventText;
    public char* name;
    public int tcpPort;
    public int udpPort;
    public bool running;
    private gui.Display* display;
    private Listener* listener;
    private Beacon* beacon;
    private Conn** conns;
    private char** names;                // the name of the peer on conns[i] (null until its HELLO)
    private int n;
    private int* targetIp;
    private int* targetPort;
    private int ntargets;

    public Chat(char* userName, int tcp, int udp) {
        name = strdup(userName);
        tcpPort = tcp;
        udpPort = udp;
        conns = (Conn**) calloc(32, 8);
        names = (char**) calloc(32, 8);
        targetIp = (int*) calloc(8, 8);
        targetPort = (int*) calloc(8, 8);
    }

    public void rearm() {
        display->after(3000, chatAnnounce, (int) this);
    }

    public bool start(gui.Display* d) {
        display = d;
        listener = new Listener();
        listener->onAccept = chatListenAccepted;
        listener->userData = (int) this;
        if (!listener->start(d, "0.0.0.0", tcpPort)) {
            return false;
        }
        tcpPort = listener->port;
        beacon = new Beacon();
        beacon->onPacket = chatBeaconPacket;
        beacon->userData = (int) this;
        if (!beacon->start(d, udpPort)) {
            listener->stop();
            return false;
        }
        udpPort = beacon->port;
        running = true;
        announce();
        d->after(3000, chatAnnounce, (int) this);
        return true;
    }

    public void stop() {
        if (!running) {
            return;
        }
        running = false;
        for (int i = n - 1; i >= 0; i--) {
            conns[i]->sendLine("BYE");
            conns[i]->close();
        }
        listener->stop();
        beacon->stop();
    }

    public void addTarget(int ip, int port) {
        if (ntargets < 8) {
            targetIp[ntargets] = ip;
            targetPort[ntargets] = port;
            ntargets++;
        }
    }

    public void announce() {
        char msg[120];
        format(&msg[0], 120, "ACHAT1 %s %d", name, tcpPort);
        beacon->broadcast(udpPort, &msg[0]);
        for (int i = 0; i < ntargets; i++) {
            beacon->send(targetIp[i], targetPort[i], &msg[0]);
        }
    }

    public int peerCount() {
        int c = 0;
        for (int i = 0; i < n; i++) {
            if (names[i] != null) { c++; }
        }
        return c;
    }

    public char* peerName(int k) {
        int c = 0;
        for (int i = 0; i < n; i++) {
            if (names[i] != null) {
                if (c == k) { return names[i]; }
                c++;
            }
        }
        return "";
    }

    private void raise(int kind, char* who, char* text) {
        eventKind = kind;
        eventName = who;
        eventText = text;
        if (onEvent != null) {
            onEvent(this);
        }
    }

    private int indexOfConn(Conn* c) {
        for (int i = 0; i < n; i++) {
            if (conns[i] == c) { return i; }
        }
        return -1;
    }

    private int indexOfName(char* who) {
        for (int i = 0; i < n; i++) {
            if (names[i] != null && streq(names[i], who)) { return i; }
        }
        return -1;
    }

    // a connection (made by us or accepted) is part of the chat from now on
    public void adopt(Conn* c) {
        if (n >= 32) {
            c->close();
            return;
        }
        conns[n] = c;
        names[n] = null;
        n++;
        c->onLine = chatLine;
        c->onClose = chatClosed;
        c->userData = (int) this;
        char* hello = malloc(strlen(name) + 8);
        strcpy(hello, "HELLO ");
        strcat(hello, name);
        c->sendLine(hello);
    }

    public bool connectTo(char* host, int port) {
        Conn* c = new Conn();
        if (!c->connect(display, host, port, 2000)) {
            return false;
        }
        adopt(c);
        return true;
    }

    public void say(char* text) {
        char* m = malloc(strlen(text) + 8);
        strcpy(m, "MSG ");
        strcat(m, text);
        for (int i = 0; i < n; i++) {
            if (names[i] != null) {
                conns[i]->sendLine(m);
            }
        }
    }

    public void gotLine(Conn* c) {
        int at = indexOfConn(c);
        if (at < 0) {
            return;
        }
        char* l = c->line;
        if (startsWith(l, "HELLO ")) {
            char* who = strdup(&l[6]);
            if (strlen(who) == 0 || streq(who, name) || indexOfName(who) >= 0) {
                c->sendLine("BYE");
                c->close();
                return;
            }
            names[at] = who;
            raise(1, who, "");
        } else if (startsWith(l, "MSG ") && names[at] != null) {
            raise(3, names[at], &l[4]);
        } else if (streq(l, "BYE")) {
            c->close();
        }
    }

    public void closed(Conn* c) {
        int at = indexOfConn(c);
        if (at < 0) {
            return;
        }
        char* who = names[at];
        for (int i = at; i < n - 1; i++) {
            conns[i] = conns[i + 1];
            names[i] = names[i + 1];
        }
        n--;
        if (who != null) {
            raise(2, who, "");
        }
    }

    public void gotBeacon(Beacon* b) {
        // "ACHAT1 name port"
        char* t = b->text;
        if (!startsWith(t, "ACHAT1 ")) {
            return;
        }
        int sp = indexOf(&t[7], ' ');
        if (sp <= 0) {
            return;
        }
        char* who = malloc(sp + 1);
        memcpy(who, &t[7], sp);
        who[sp] = 0;
        int port = atoi(&t[7 + sp + 1]);
        if (streq(who, name) || indexOfName(who) >= 0 || port <= 0) {
            return;
        }
        // the one with the higher "name@ip:port" connects
        char mine[160];
        char theirs[160];
        format(&mine[0], 160, "%s@%d", name, tcpPort);
        format(&theirs[0], 160, "%s@%d", who, port);
        if (strcmp(&mine[0], &theirs[0]) > 0) {
            for (int i = 0; i < n; i++) {
                if (conns[i]->peerIp == b->fromIp && conns[i]->peerPort == port) {
                    return;
                }
            }
            char* host = malloc(20);
            format(host, 20, "%d.%d.%d.%d", (b->fromIp >> 24) & 255, (b->fromIp >> 16) & 255, (b->fromIp >> 8) & 255, b->fromIp & 255);
            connectTo(host, port);
        }
    }
}

int chatListenAccepted(int arg) {
    Listener* l = (Listener*) arg;
    Chat* chat = (Chat*) l->userData;
    chat->adopt(l->accepted);
    return 0;
}

int chatBeaconPacket(int arg) {
    Beacon* b = (Beacon*) arg;
    Chat* chat = (Chat*) b->userData;
    chat->gotBeacon(b);
    return 0;
}

int chatLine(int arg) {
    Conn* c = (Conn*) arg;
    Chat* chat = (Chat*) c->userData;
    chat->gotLine(c);
    return 0;
}

int chatClosed(int arg) {
    Conn* c = (Conn*) arg;
    Chat* chat = (Chat*) c->userData;
    chat->closed(c);
    return 0;
}

int chatAnnounce(int arg) {
    Chat* chat = (Chat*) arg;
    if (chat->running) {
        chat->announce();
        chat->rearm();
    }
    return 0;
}
