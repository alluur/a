// =============================================================================
//  random - random number generators with their own state     import random;
//
//    random.Random rng(12345);         same seed -> same sequence (xorshift64)
//    rng.range(1, 6)                   a number from 1 to 6, both included
//  (the standard library's rand() / srand() is one shared global generator)
// =============================================================================
module random;

public class Random {
    private int state;

    public Random(int seed) {
        reseed(seed);
    }

    public void reseed(int seed) {
        state = seed;
        if (state == 0) {
            state = 88172645463325252;
        }
        for (int i = 0; i < 4; i++) {
            next();
        }
    }

    // a non-negative 55 bit number
    public int next() {
        int x = state;
        x = x ^ (x << 13);
        x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
        x = x ^ (x << 17);
        state = x;
        return (x >> 8) & 0x7FFFFFFFFFFFFF;
    }

    // from lo to hi, both included
    public int range(int lo, int hi) {
        if (hi <= lo) {
            return lo;
        }
        return lo + next() % (hi - lo + 1);
    }

    public bool nextBool() {
        return (next() & 1) == 1;
    }

    // true with the given probability in percent
    public bool chance(int percent) {
        return next() % 100 < percent;
    }

    public void shuffle(int* a, int n) {
        for (int i = n - 1; i > 0; i--) {
            int j = next() % (i + 1);
            int t = a[i];
            a[i] = a[j];
            a[j] = t;
        }
    }

    // a random element of an array of strings
    public char* pick(char** items, int n) {
        return items[next() % n];
    }

    // n random letters and digits
    public char* token(int n) {
        char* t = alloc(n + 1);
        for (int i = 0; i < n; i++) {
            int v = next() % 62;
            if (v < 10) {
                t[i] = '0' + v;
            } else if (v < 36) {
                t[i] = 'a' + v - 10;
            } else {
                t[i] = 'A' + v - 36;
            }
        }
        return t;
    }
}

// a seed that differs on every run (from the clock)
public int clockSeed() {
    return millis() * 2654435761 + 1;
}
