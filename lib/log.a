// =============================================================================
//  log - leveled logging                                       import log;
//
//    log.info("server started");                    2026-10-11 16:05:09 [INFO ] server started
//    log.errorf("cannot open %s", (int)path, 0, 0, 0);
//    log.setLevel(log.WARN);                        hide DEBUG and INFO
//  Output goes to standard error (setFd changes that); colours only on terminals.
// =============================================================================
module log;
import datetime;

const DEBUG = 0;
const INFO = 1;
const WARN = 2;
const ERROR = 3;
const OFF = 4;

private int level = 1;
private int fd = 2;
private bool stamps = true;
private bool colors = true;

public void setLevel(int l) { level = l; }
public void setFd(int f) { fd = f; }
public void setTimestamps(bool on) { stamps = on; }
public void setColors(bool on) { colors = on; }

private void emit(int lvl, char* tag, char* color, char* msg) {
    if (lvl < level) {
        return;
    }
    char line[2200];
    int o = 0;
    bool paint = colors && isTerminal(fd);
    if (paint) {
        ansiInit();
        o = o + format(&line[o], 2200 - o, "%s", (int)color, 0, 0, 0);
    }
    if (stamps) {
        datetime.DateTime* d = new datetime.DateTime(datetime.now());
        o = o + format(&line[o], 2200 - o, "%s ", (int)d->toString(), 0, 0, 0);
    }
    o = o + format(&line[o], 2200 - o, "[%s] ", (int)tag, 0, 0, 0);
    if (paint) {
        o = o + format(&line[o], 2200 - o, "%s", (int)ANSI_RESET, 0, 0, 0);
    }
    o = o + format(&line[o], 2200 - o, "%s\n", (int)msg, 0, 0, 0);
    __write(fd, &line[0], o);
}

private void emitf(int lvl, char* tag, char* color, char* fmt, int a, int b, int c, int d) {
    if (lvl < level) {
        return;
    }
    char msg[1024];
    format(&msg[0], 1024, fmt, a, b, c, d);
    emit(lvl, tag, color, msg);
}

public void debug(char* msg) { emit(DEBUG, "DEBUG", ANSI_GRAY, msg); }
public void info(char* msg)  { emit(INFO,  "INFO ", ANSI_GREEN, msg); }
public void warn(char* msg)  { emit(WARN,  "WARN ", ANSI_YELLOW, msg); }
public void error(char* msg) { emit(ERROR, "ERROR", ANSI_RED, msg); }

// printf style variants (up to four values, like printf)
public void debugf(char* fmt, int a, int b, int c, int d) { emitf(DEBUG, "DEBUG", ANSI_GRAY, fmt, a, b, c, d); }
public void infof(char* fmt, int a, int b, int c, int d)  { emitf(INFO,  "INFO ", ANSI_GREEN, fmt, a, b, c, d); }
public void warnf(char* fmt, int a, int b, int c, int d)  { emitf(WARN,  "WARN ", ANSI_YELLOW, fmt, a, b, c, d); }
public void errorf(char* fmt, int a, int b, int c, int d) { emitf(ERROR, "ERROR", ANSI_RED, fmt, a, b, c, d); }
