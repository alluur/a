// =============================================================================
//  cunistd - POSIX <unistd.h>, <sys/stat.h>, <dirent.h>, <fcntl.h>, getopt     import cunistd;
//
//  Process, file system and directory functions with the C/POSIX names, working on Linux, Android and Windows:
//    getpid getppid getuid getgid gethostname getcwd chdir mkdir rmdir unlink link symlink readlink realpath
//    access chmod stat lstat fstat (Stat) S_ISDIR S_ISREG S_ISLNK  truncate ftruncate fsync
//    open read write close lseek dup dup2 pipe isatty
//    sleep usleep fork waitpid execv execvp kill raise _exit       (fork, kill ... : Linux and Android only)
//    opendir readdir closedir (DIR, Dirent)         getopt (optarg optind opterr optopt)
//    mkstemp mkdtemp  fnmatch  signal alarm pause (signals: Linux and Android)
//  File descriptors are the plain numbers of the operating system (handles on Windows).
//  Failing calls return -1 (or null) and set errno (see cerrno).
// =============================================================================
import cerrno;
import cstdlib;
import cctype;

const F_OK = 0;
const X_OK = 1;
const W_OK = 2;
const R_OK = 4;

const O_RDONLY = 0;
const O_WRONLY = 1;
const O_RDWR = 2;
const O_CREAT = 64;
const O_EXCL = 128;
const O_TRUNC = 512;
const O_APPEND = 1024;

const S_IFMT = 61440;
const S_IFDIR = 16384;
const S_IFREG = 32768;
const S_IFLNK = 40960;

const SIGHUP = 1;
const SIGINT = 2;
const SIGQUIT = 3;
const SIGABRT = 6;
const SIGKILL = 9;
const SIGUSR1 = 10;
const SIGSEGV = 11;
const SIGUSR2 = 12;
const SIGPIPE = 13;
const SIGALRM = 14;
const SIGTERM = 15;

const STDIN_FILENO = 0;
const STDOUT_FILENO = 1;
const STDERR_FILENO = 2;

// A syscall number for x86-64 and for AArch64 (the second is -1 where AArch64 only has the *at version)
int __sys(int x86, int a64, int a1 = 0, int a2 = 0, int a3 = 0, int a4 = 0, int a5 = 0) {
    int nr = x86;
    if (__ARCH >= 1) {
        nr = a64;
    }
    int r = __syscall(nr, a1, a2, a3, a4, a5, 0);
    if (r < 0 && r > -4096) {
        errno = -r;
        return -1;
    }
    return r;
}

// ---- process information ----------------------------------------------------------------------------------------
int getpid() {
    if (__OS == 1) {
        return __winapi(24, 0, 0, 0, 0) & 0xFFFFFFFF;                  // GetCurrentProcessId
    }
    return __sys(39, 172);
}

int getppid() {
    if (__OS == 1) {
        return 0;
    }
    return __sys(110, 173);
}

int getuid() {
    if (__OS == 1) {
        return 0;
    }
    return __sys(102, 174);
}

int getgid() {
    if (__OS == 1) {
        return 0;
    }
    return __sys(104, 176);
}

int geteuid() {
    return getuid();
}

int getegid() {
    return getgid();
}

int getpagesize() {
    return 4096;
}

// copies the host name into name (at most size bytes); 0 on success
int gethostname(char* name, int size) {
    char* host = null;
    if (__OS == 1) {
        host = getenv("COMPUTERNAME");
    } else {
        char u[400];
        if (__sys(63, 160, (int) &u[0]) == 0) {                         // uname: nodename starts at byte 65
            host = &u[65];
            if (strlen(host) >= size) {
                errno = ENAMETOOLONG;
                return -1;
            }
            strcpy(name, host);
            return 0;
        }
    }
    if (host == null) {
        host = "localhost";
    }
    if (strlen(host) >= size) {
        errno = ENAMETOOLONG;
        return -1;
    }
    strcpy(name, host);
    return 0;
}

// ---- files and directories ---------------------------------------------------------------------------------------------
bool __win_ok(int r) {
    return ((r << 32) >> 32) != 0;
}

// the current directory copied into buf; returns buf, null on failure
char* getcwd(char* buf, int size) {
    if (__OS == 1) {
        int n = (__winapi(16, size, buf, 0, 0) << 32) >> 32;             // GetCurrentDirectoryA
        if (n <= 0 || n >= size) {
            errno = ERANGE;
            return null;
        }
        return buf;
    }
    int r = __sys(79, 17, (int) buf, size);
    if (r < 0) {
        return null;
    }
    return buf;
}

int chdir(char* path) {
    if (__OS == 1) {
        if (!__win_ok(__winapi(22, path, 0, 0, 0))) {                    // SetCurrentDirectoryA
            errno = ENOENT;
            return -1;
        }
        return 0;
    }
    return __sys(80, 49, (int) path);
}

int mkdir(char* path, int mode = 493) {
    if (__OS == 1) {
        if (!__win_ok(__winapi(14, path, 0, 0, 0))) {                    // CreateDirectoryA
            errno = EEXIST;
            return -1;
        }
        return 0;
    }
    if (__ARCH >= 1) {
        return __sys(0, 34, -100, (int) path, mode);                       // mkdirat
    }
    return __sys(83, 0, (int) path, mode);
}

int rmdir(char* path) {
    if (__OS == 1) {
        if (!__win_ok(__winapi(23, path, 0, 0, 0))) {                    // RemoveDirectoryA
            errno = ENOTEMPTY;
            return -1;
        }
        return 0;
    }
    if (__ARCH >= 1) {
        return __sys(0, 35, -100, (int) path, 0x200);                      // unlinkat(AT_REMOVEDIR)
    }
    return __sys(84, 0, (int) path);
}

int unlink(char* path) {
    if (__OS == 1) {
        if (!__win_ok(__winapi(13, path, 0, 0, 0))) {                    // DeleteFileA
            errno = ENOENT;
            return -1;
        }
        return 0;
    }
    if (__ARCH >= 1) {
        return __sys(0, 35, -100, (int) path, 0);                          // unlinkat
    }
    return __sys(87, 0, (int) path);
}

// hard link (Linux and Android)
int link(char* existing, char* newpath) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    if (__ARCH >= 1) {
        return __sys(0, 37, -100, (int) existing, -100, (int) newpath, 0);  // linkat
    }
    return __sys(86, 0, (int) existing, (int) newpath);
}

// symbolic link (Linux and Android)
int symlink(char* target, char* linkpath) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    if (__ARCH >= 1) {
        return __sys(0, 36, (int) target, -100, (int) linkpath);           // symlinkat
    }
    return __sys(88, 0, (int) target, (int) linkpath);
}

// reads the target of a symbolic link into buf (no zero is added); returns its length, -1 on failure
int readlink(char* path, char* buf, int size) {
    if (__OS == 1) {
        errno = EINVAL;
        return -1;
    }
    if (__ARCH >= 1) {
        return __sys(0, 78, -100, (int) path, (int) buf, size);            // readlinkat
    }
    return __sys(89, 0, (int) path, (int) buf, size);
}

// checks whether a file exists (F_OK) and can be read / written / executed (R_OK, W_OK, X_OK; or-ed together)
int access(char* path, int mode) {
    if (__OS == 1) {
        int attr = (__winapi(25, path, 0, 0, 0) << 32) >> 32;           // GetFileAttributesA
        if (attr == -1) {
            errno = ENOENT;
            return -1;
        }
        if ((mode & W_OK) != 0 && (attr & 1) != 0) {
            errno = EACCES;
            return -1;
        }
        return 0;
    }
    if (__ARCH >= 1) {
        return __sys(0, 48, -100, (int) path, mode);                       // faccessat
    }
    return __sys(21, 0, (int) path, mode);
}

int chmod(char* path, int mode) {
    if (__OS == 1) {
        return 0;
    }
    if (__ARCH >= 1) {
        return __sys(0, 53, -100, (int) path, mode);                       // fchmodat
    }
    return __sys(90, 0, (int) path, mode);
}

// the absolute path of a file with symbolic links resolved (the file must exist). buf needs PATH_MAX (4096) bytes.
// Returns buf, null on failure.
char* realpath(char* path, char* buf) {
    if (__OS == 1) {
        int n = (__winapi(35, path, 4096, buf, 0) << 32) >> 32;          // GetFullPathNameA
        if (n <= 0 || n >= 4096) {
            errno = ENOENT;
            return null;
        }
        if (access(path, F_OK) != 0) {
            return null;
        }
        return buf;
    }
    int fd = __sys(2, 0, (int) path, 0x200000);                            // open(O_PATH)
    if (__ARCH >= 1) {
        fd = __sys(0, 56, -100, (int) path, 0x200000, 0);                  // openat(O_PATH)
    }
    if (fd < 0) {
        return null;
    }
    char lnk[40];
    format(&lnk[0], 40, "/proc/self/fd/%d", fd);
    int n = readlink(&lnk[0], buf, 4095);
    __close(fd);
    if (n < 0) {
        return null;
    }
    buf[n] = 0;
    return buf;
}

// ---- stat -----------------------------------------------------------------------------------------------------------
struct Stat {
    int st_size;
    int st_mode;        // S_IFDIR / S_IFREG / S_IFLNK plus permission bits
    int st_mtime;       // seconds since 1970
    int st_atime;
    int st_ctime;
    int st_nlink;
    int st_uid;
    int st_gid;
    int st_ino;
}

bool S_ISDIR(int mode) {
    return (mode & S_IFMT) == S_IFDIR;
}

bool S_ISREG(int mode) {
    return (mode & S_IFMT) == S_IFREG;
}

bool S_ISLNK(int mode) {
    return (mode & S_IFMT) == S_IFLNK;
}

// fills st from the raw kernel structure
void __fill_stat(char* raw, Stat* st) {
    int* w = (int*) raw;
    if (__ARCH >= 1) {
        st->st_ino = w[1];
        st->st_mode = w[2] & 0xFFFFFFFF;
        st->st_nlink = (w[2] >> 32) & 0xFFFFFFFF;
        st->st_uid = w[3] & 0xFFFFFFFF;
        st->st_gid = (w[3] >> 32) & 0xFFFFFFFF;
    } else {
        st->st_ino = w[1];
        st->st_nlink = w[2];
        st->st_mode = w[3] & 0xFFFFFFFF;
        st->st_uid = (w[3] >> 32) & 0xFFFFFFFF;
        st->st_gid = w[4] & 0xFFFFFFFF;
    }
    st->st_size = w[6];
    st->st_atime = w[9];
    st->st_mtime = w[11];
    st->st_ctime = w[13];
}

// reads a little-endian 32-bit value at any offset
int __rd32(char* p, int off) {
    return p[off] | (p[off + 1] << 8) | (p[off + 2] << 16) | (p[off + 3] << 24);
}

int __win_filetime(int ft) {
    return ft / 10000000 - 11644473600;
}

// LoongArch has only statx(): asks for the information and writes it in the layout of the generic struct stat
// (the one RISC-V and AArch64 return), so that __fill_stat works on every system
void __copy_bytes(char* dst, int doff, char* src, int soff, int n) {
    for (int i = 0; i < n; i++) {
        dst[doff + i] = src[soff + i];
    }
}

int __statx_raw(int dirfd, char* path, int flags, char* raw) {
    char sx[256];
    memset(&sx[0], 0, 256);
    int r = __sys(0, 291, dirfd, (int) path, flags, 0x7FF, (int) &sx[0]);
    if (r < 0) {
        return -1;
    }
    __copy_bytes(raw, 8, &sx[0], 32, 8);        // st_ino
    __copy_bytes(raw, 16, &sx[0], 28, 2);       // st_mode
    __copy_bytes(raw, 20, &sx[0], 16, 4);       // st_nlink
    __copy_bytes(raw, 24, &sx[0], 20, 4);       // st_uid
    __copy_bytes(raw, 28, &sx[0], 24, 4);       // st_gid
    __copy_bytes(raw, 48, &sx[0], 40, 8);       // st_size
    __copy_bytes(raw, 56, &sx[0], 4, 4);        // st_blksize
    __copy_bytes(raw, 64, &sx[0], 48, 8);       // st_blocks
    __copy_bytes(raw, 72, &sx[0], 64, 8);       // st_atime
    __copy_bytes(raw, 80, &sx[0], 72, 4);
    __copy_bytes(raw, 88, &sx[0], 112, 8);      // st_mtime
    __copy_bytes(raw, 96, &sx[0], 120, 4);
    __copy_bytes(raw, 104, &sx[0], 96, 8);      // st_ctime
    __copy_bytes(raw, 112, &sx[0], 104, 4);
    return 0;
}

int __stat_common(char* path, Stat* st, bool follow) {
    memset((char*) st, 0, sizeof(Stat));
    if (__OS == 1) {
        char d[40];
        memset(&d[0], 0, 40);
        if (!__win_ok(__winapi(33, path, 0, &d[0], 0))) {               // GetFileAttributesExA
            errno = ENOENT;
            return -1;
        }
        // WIN32_FILE_ATTRIBUTE_DATA: attributes, three FILETIMEs, size high, size low (all 4-byte aligned)
        int attr = __rd32(&d[0], 0);
        if ((attr & 16) != 0) {
            st->st_mode = S_IFDIR | 493;
        } else if ((attr & 1) != 0) {
            st->st_mode = S_IFREG | 292;
        } else {
            st->st_mode = S_IFREG | 420;
        }
        st->st_ctime = __win_filetime(__rd32(&d[0], 4) | (__rd32(&d[0], 8) << 32));
        st->st_atime = __win_filetime(__rd32(&d[0], 12) | (__rd32(&d[0], 16) << 32));
        st->st_mtime = __win_filetime(__rd32(&d[0], 20) | (__rd32(&d[0], 24) << 32));
        st->st_size = (__rd32(&d[0], 28) << 32) | __rd32(&d[0], 32);
        st->st_nlink = 1;
        return 0;
    }
    char raw[160];
    memset(&raw[0], 0, 160);
    int r;
    if (__ARCH == 3) {
        int fl = 0;
        if (!follow) { fl = 0x100; }
        r = __statx_raw(-100, path, fl, &raw[0]);
    } else if (__ARCH >= 1) {
        int fl = 0;
        if (!follow) { fl = 0x100; }
        r = __sys(0, 79, -100, (int) path, (int) &raw[0], fl);             // newfstatat
    } else if (follow) {
        r = __sys(4, 0, (int) path, (int) &raw[0]);
    } else {
        r = __sys(6, 0, (int) path, (int) &raw[0]);
    }
    if (r < 0) {
        return -1;
    }
    __fill_stat(&raw[0], st);
    return 0;
}

// information about a file: size, kind, times. 0 on success, -1 if the file does not exist
int stat(char* path, Stat* st) {
    return __stat_common(path, st, true);
}

// like stat, but a symbolic link is not followed
int lstat(char* path, Stat* st) {
    return __stat_common(path, st, false);
}

int fstat(int fd, Stat* st) {
    memset((char*) st, 0, sizeof(Stat));
    if (__OS == 1) {
        int size = 0;
        if (!__win_ok(__winapi(29, fd, &size, 0, 0))) {                 // GetFileSizeEx
            errno = EBADF;
            return -1;
        }
        st->st_size = size;
        st->st_mode = S_IFREG | 420;
        st->st_nlink = 1;
        return 0;
    }
    char raw[160];
    memset(&raw[0], 0, 160);
    int r;
    if (__ARCH == 3) {
        r = __statx_raw(fd, "", 0x1000, &raw[0]);                             // LoongArch has no fstat: statx(fd, "", AT_EMPTY_PATH)
    } else {
        r = __sys(5, 80, fd, (int) &raw[0]);
    }
    if (r < 0) {
        return -1;
    }
    __fill_stat(&raw[0], st);
    return 0;
}

int __truncate_fd(int fd, int len) {
    if (__OS == 1) {
        int old = 0;
        int np = 0;
        __winapi(21, fd, 0, &old, 1);                                    // remember the position
        if (!__win_ok(__winapi(21, fd, len, &np, 0))) {
            errno = EINVAL;
            return -1;
        }
        if (!__win_ok(__winapi(27, fd, 0, 0, 0))) {                      // SetEndOfFile
            errno = EACCES;
            return -1;
        }
        __winapi(21, fd, old, &np, 0);
        return 0;
    }
    return __sys(77, 46, fd, len);
}

int ftruncate(int fd, int len) {
    return __truncate_fd(fd, len);
}

int truncate(char* path, int len) {
    if (__OS == 1) {
        int fd = open(path, O_WRONLY);
        if (fd < 0) {
            return -1;
        }
        int r = __truncate_fd(fd, len);
        close(fd);
        return r;
    }
    return __sys(76, 45, (int) path, len);
}

int fsync(int fd) {
    if (__OS == 1) {
        if (!__win_ok(__winapi(28, fd, 0, 0, 0))) {                      // FlushFileBuffers
            return -1;
        }
        return 0;
    }
    return __sys(74, 82, fd);
}

// ---- file descriptors --------------------------------------------------------------------------------------------------
// opens a file with the O_* flags (O_RDONLY / O_WRONLY / O_RDWR, or-ed with O_CREAT, O_EXCL, O_TRUNC, O_APPEND)
int open(char* path, int flags, int mode = 420) {
    if (__OS == 1) {
        int acc = 0;
        int rw = flags & 3;
        if (rw == 0 || rw == 2) { acc = acc | 0x80000000; }
        if (rw == 1 || rw == 2) {
            if ((flags & O_APPEND) != 0) {
                acc = acc | 4;
            } else {
                acc = acc | 0x40000000;
            }
        }
        int creation = 3;
        if ((flags & O_CREAT) != 0) {
            if ((flags & O_EXCL) != 0) { creation = 1; }
            else if ((flags & O_TRUNC) != 0) { creation = 2; }
            else { creation = 4; }
        } else if ((flags & O_TRUNC) != 0) {
            creation = 5;
        }
        int h = __winapix(4, path, acc, 3, 0, creation, 0x80, 0, 0, 0, 0);
        if (h == -1) {
            if (access(path, F_OK) != 0) {
                errno = ENOENT;
            } else if ((flags & O_EXCL) != 0) {
                errno = EEXIST;
            } else {
                errno = EACCES;
            }
            return -1;
        }
        return h;
    }
    if (__ARCH >= 1) {
        return __sys(0, 56, -100, (int) path, flags, mode);                // openat
    }
    return __sys(2, 0, (int) path, flags, mode);
}

// reads up to n bytes; returns the count, 0 at the end, -1 on failure
int read(int fd, char* buf, int n) {
    int r = __read(fd, buf, n);
    if (r < 0) {
        errno = -r;
        return -1;
    }
    return r;
}

int write(int fd, char* buf, int n) {
    int r = __write(fd, buf, n);
    if (r < 0) {
        errno = -r;
        return -1;
    }
    return r;
}

int close(int fd) {
    __close(fd);
    return 0;
}

int lseek(int fd, int offset, int whence) {
    if (__OS == 1) {
        int np = 0;
        if (!__win_ok(__winapi(21, fd, offset, &np, whence))) {
            errno = ESPIPE;
            return -1;
        }
        return np;
    }
    return __sys(8, 62, fd, offset, whence);
}

int dup(int fd) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    return __sys(32, 23, fd);
}

int dup2(int old, int nw) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    if (__ARCH >= 1) {
        if (old == nw) {
            return nw;
        }
        return __sys(0, 24, old, nw, 0);
    }
    return __sys(33, 0, old, nw);
}

// creates a pipe: fds[0] is the read end, fds[1] the write end (an array of two ints). 0 on success
int pipe(int* fds) {
    if (__OS == 1) {
        char sa[24];
        memset(&sa[0], 0, 24);
        sa[0] = 24;
        sa[16] = 1;
        int hp[2];
        if (!__win_ok(__winapi(37, &hp[0], &hp[1], &sa[0], 0))) {       // CreatePipe
            errno = EMFILE;
            return -1;
        }
        fds[0] = hp[0];
        fds[1] = hp[1];
        return 0;
    }
    char raw[16];
    memset(&raw[0], 0, 16);
    int r;
    if (__ARCH >= 1) {
        r = __sys(0, 59, (int) &raw[0], 0);
    } else {
        r = __sys(293, 0, (int) &raw[0], 0);
    }
    if (r < 0) {
        return -1;
    }
    int* w = (int*) &raw[0];
    fds[0] = w[0] & 0xFFFFFFFF;
    fds[1] = (w[0] >> 32) & 0xFFFFFFFF;
    return 0;
}

bool isatty(int fd) {
    return isTerminal(fd);
}

// ---- time ---------------------------------------------------------------------------------------------------------------
// waits for the given number of seconds; returns 0
int sleep(int seconds) {
    sleepMs(seconds * 1000);
    return 0;
}

int usleep(int microseconds) {
    sleepMs((microseconds + 999) / 1000);
    return 0;
}

// ---- processes ---------------------------------------------------------------------------------------------------------
void _exit(int code) {
    __exit(code);
}

// creates a copy of the program: returns 0 in the child and the child's process id in the parent (Linux and Android)
int fork() {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    if (__ARCH >= 1) {
        return __sys(0, 220, 17, 0, 0, 0, 0);
    }
    return __sys(57, 0);
}

// waits for the child `pid` (-1 = any); the status is stored in *status (exit code in bits 8-15). Returns the pid, -1 on failure
int waitpid(int pid, int* status, int options = 0) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    char st[8];
    memset(&st[0], 0, 8);
    int r = __sys(61, 260, pid, (int) &st[0], options, 0, 0);
    if (r < 0) {
        return -1;
    }
    if (status != null) {
        *status = st[0] | (st[1] << 8) | (st[2] << 16) | (st[3] << 24);
    }
    return r;
}

// replaces the program with another one: argv is a null-terminated array of strings
int execv(char* path, char** argv) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    char** envp = environ();
    return __sys(59, 221, (int) path, (int) argv, (int) envp);
}

// like execv, but a name without '/' is searched in the directories of PATH
int execvp(char* file, char** argv) {
    if (indexOf(file, '/') >= 0) {
        return execv(file, argv);
    }
    char* path = getenv("PATH");
    if (path == null) {
        path = "/usr/bin:/bin";
    }
    int len = strlen(path);
    int start = 0;
    char cand[1100];
    while (start <= len) {
        int end = start;
        while (end < len && path[end] != ':') {
            end++;
        }
        if (end > start && end - start < 1000) {
            for (int k = 0; k < end - start; k++) {
                cand[k] = path[start + k];
            }
            cand[end - start] = '/';
            strcpy(&cand[end - start + 1], file);
            if (access(&cand[0], X_OK) == 0) {
                execv(&cand[0], argv);
            }
        }
        start = end + 1;
    }
    errno = ENOENT;
    return -1;
}

// sends a signal to a process (Linux and Android)
int kill(int pid, int sig) {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    return __sys(62, 129, pid, sig);
}

int raise(int sig) {
    return kill(getpid(), sig);
}

// ---- directories -------------------------------------------------------------------------------------------------------
struct Dirent {
    int d_type;         // 4 = directory, 8 = regular file, 10 = symbolic link, 0 = unknown
    char d_name[260];
}

struct DIR {
    int fd;             // Linux: descriptor; Windows: search handle
    char* buf;
    int pos;
    int len;
    bool first;
    Dirent ent;
}

// starts reading a directory; null (with errno set) if it cannot be opened
DIR* opendir(char* path) {
    DIR* d = (DIR*) malloc(sizeof(DIR));
    if (__OS == 1) {
        char* pattern = alloc(strlen(path) + 4);
        strcpy(pattern, path);
        int n = strlen(pattern);
        if (n > 0 && pattern[n - 1] != '/' && pattern[n - 1] != 92) {
            pattern[n] = 92;
            n++;
        }
        pattern[n] = '*';
        pattern[n + 1] = 0;
        d->buf = malloc(400);
        int h = __winapi(18, pattern, d->buf, 0, 0);                     // FindFirstFileA
        if (h == -1) {
            errno = ENOENT;
            free(d->buf);
            free((char*) d);
            return null;
        }
        d->fd = h;
        d->first = true;
        return d;
    }
    int dflag = 0x10000;                                                 // O_DIRECTORY (x86-64, RISC-V, LoongArch)
    if (__ARCH == 1) {
        dflag = 0x4000;                                                  // AArch64 uses its own value
    }
    int fd = open(path, dflag);
    if (fd < 0) {
        free((char*) d);
        return null;
    }
    d->fd = fd;
    d->buf = malloc(4096);
    return d;
}

// the next entry (a static record inside the DIR), null at the end
Dirent* readdir(DIR* d) {
    if (__OS == 1) {
        if (d->first) {
            d->first = false;
        } else if (!__win_ok(__winapi(19, d->fd, d->buf, 0, 0))) {       // FindNextFileA
            return null;
        }
        int* w = (int*) d->buf;
        int attr = w[0] & 0xFFFFFFFF;
        d->ent.d_type = 8;
        if ((attr & 16) != 0) {
            d->ent.d_type = 4;
        }
        strcpy(&d->ent.d_name[0], &d->buf[44]);
        return &d->ent;
    }
    for (;;) {
        if (d->pos >= d->len) {
            int got = __sys(217, 61, d->fd, (int) d->buf, 4096);          // getdents64
            if (got <= 0) {
                return null;
            }
            d->len = got;
            d->pos = 0;
        }
        char* rec = &d->buf[d->pos];
        int reclen = rec[16] | (rec[17] << 8);
        d->pos = d->pos + reclen;
        d->ent.d_type = rec[18];
        strcpy(&d->ent.d_name[0], &rec[19]);
        return &d->ent;
    }
    return null;
}

int closedir(DIR* d) {
    if (__OS == 1) {
        __winapi(20, d->fd, 0, 0, 0);                                    // FindClose
    } else {
        __close(d->fd);
    }
    free(d->buf);
    free((char*) d);
    return 0;
}

// ---- getopt ---------------------------------------------------------------------------------------------------------------
char* optarg;
int optind = 1;
int opterr = 1;
int optopt;
int __optpos;

// POSIX option parsing:  while ((c = getopt(argc, argv, "ab:c")) != -1) ...
// Letters followed by ':' take an argument (in optarg). Returns the option letter, '?' for an unknown option,
// ':' for a missing argument if optstring starts with ':', -1 when the options are used up (optind = first other argument).
int getopt(int argc, char** argv, char* optstring) {
    optarg = null;
    if (optind >= argc) {
        return -1;
    }
    char* arg = argv[optind];
    if (__optpos == 0) {
        if (arg[0] != '-' || arg[1] == 0) {
            return -1;
        }
        if (arg[1] == '-' && arg[2] == 0) {
            optind++;
            return -1;
        }
        __optpos = 1;
    }
    int c = arg[__optpos];
    __optpos++;
    bool quiet = optstring[0] == ':';
    int k = indexOf(optstring, c);
    if (c == ':' || k < 0) {
        optopt = c;
        if (arg[__optpos] == 0) {
            optind++;
            __optpos = 0;
        }
        if (opterr != 0 && !quiet) {
            eprint(argv[0]);
            eprint(": invalid option -- '");
            eprint(substr(arg, __optpos == 0 ? strlen(arg) - 1 : __optpos - 1, 1));
            eprintln("'");
        }
        return '?';
    }
    if (optstring[k + 1] == ':') {
        if (arg[__optpos] != 0) {
            optarg = &arg[__optpos];
            optind++;
        } else if (optind + 1 < argc) {
            optarg = argv[optind + 1];
            optind = optind + 2;
        } else {
            optopt = c;
            optind++;
            __optpos = 0;
            if (quiet) {
                return ':';
            }
            if (opterr != 0) {
                eprint(argv[0]);
                eprint(": option requires an argument -- '");
                eprint(substr(arg, __optpos, 1));
                eprintln("'");
            }
            return '?';
        }
        __optpos = 0;
        return c;
    }
    if (arg[__optpos] == 0) {
        optind++;
        __optpos = 0;
    }
    return c;
}

// ---- temporary files and directories ---------------------------------------------------------------------------------
// fills the six X at the end of the template with random letters; false if the template does not end in XXXXXX
bool __fill_template(char* tmpl) {
    int n = strlen(tmpl);
    if (n < 6 || !streq(&tmpl[n - 6], "XXXXXX")) {
        errno = EINVAL;
        return false;
    }
    char* letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    for (int i = 0; i < 6; i++) {
        tmpl[n - 6 + i] = letters[(rand() ^ millis() ^ getpid() * 7919) % 62];
    }
    return true;
}

// creates and opens a new file whose name is the template with its XXXXXX replaced; returns the descriptor, -1 on failure
int mkstemp(char* tmpl) {
    for (int tries = 0; tries < 100; tries++) {
        if (!__fill_template(tmpl)) {
            return -1;
        }
        int fd = open(tmpl, O_RDWR | O_CREAT | O_EXCL, 384);
        if (fd >= 0 || errno != EEXIST) {
            return fd;
        }
    }
    return -1;
}

// creates a new directory from the template; returns the template, null on failure
char* mkdtemp(char* tmpl) {
    for (int tries = 0; tries < 100; tries++) {
        if (!__fill_template(tmpl)) {
            return null;
        }
        if (mkdir(tmpl, 448) == 0) {
            return tmpl;
        }
        if (errno != EEXIST) {
            return null;
        }
    }
    return null;
}

// ---- fnmatch -----------------------------------------------------------------------------------------------------------
const FNM_PATHNAME = 1;
const FNM_NOESCAPE = 2;
const FNM_PERIOD = 4;
const FNM_CASEFOLD = 16;
const FNM_NOMATCH = 1;

int __fn_lower(int c, int flags) {
    if ((flags & FNM_CASEFOLD) != 0 && c >= 'A' && c <= 'Z') {
        return c + 32;
    }
    return c;
}

// matches a bracket expression at p[0] == '[' against c; *next gets the index after it. Returns 1 matched, 0 not, -1 no bracket expression
int __fn_bracket(char* p, int c, int flags, int* next) {
    int i = 1;
    bool neg = false;
    if (p[i] == '!' || p[i] == '^') {
        neg = true;
        i++;
    }
    bool found = false;
    bool first = true;
    c = __fn_lower(c, flags);
    while (p[i] != 0 && (p[i] != ']' || first)) {
        first = false;
        int lo = p[i];
        if (lo == 92 && (flags & FNM_NOESCAPE) == 0 && p[i + 1] != 0) {
            i++;
            lo = p[i];
        }
        int hi = lo;
        if (p[i + 1] == '-' && p[i + 2] != ']' && p[i + 2] != 0) {
            hi = p[i + 2];
            i = i + 2;
        }
        i++;
        if (c >= __fn_lower(lo, flags) && c <= __fn_lower(hi, flags)) {
            found = true;
        }
    }
    if (p[i] != ']') {
        return -1;
    }
    *next = i + 1;
    if (found != neg) {
        return 1;
    }
    return 0;
}

bool __fn_match(char* p, char* s, int flags, bool atStart) {
    for (;;) {
        int pc = p[0];
        if (pc == 0) {
            return s[0] == 0;
        }
        bool leadingDot = (flags & FNM_PERIOD) != 0 && s[0] == '.' && (atStart || ((flags & FNM_PATHNAME) != 0 && s[-1] == '/'));
        if (pc == '*') {
            while (p[0] == '*') {
                p++;
            }
            if (leadingDot) {
                return false;
            }
            if (p[0] == 0) {
                if ((flags & FNM_PATHNAME) != 0) {
                    return indexOf(s, '/') < 0;
                }
                return true;
            }
            for (int i = 0; ; i++) {
                if (__fn_match(p, &s[i], flags, false)) {
                    return true;
                }
                if (s[i] == 0 || (s[i] == '/' && (flags & FNM_PATHNAME) != 0)) {
                    return false;
                }
            }
        }
        if (s[0] == 0) {
            return false;
        }
        if (pc == '?') {
            if (leadingDot || (s[0] == '/' && (flags & FNM_PATHNAME) != 0)) {
                return false;
            }
            p++;
            s++;
            atStart = false;
            continue;
        }
        if (pc == '[') {
            int next = 0;
            int r = __fn_bracket(p, s[0], flags, &next);
            if (r >= 0) {
                if (r == 0 || leadingDot || (s[0] == '/' && (flags & FNM_PATHNAME) != 0)) {
                    return false;
                }
                p = &p[next];
                s++;
                atStart = false;
                continue;
            }
        }
        if (pc == 92 && (flags & FNM_NOESCAPE) == 0 && p[1] != 0) {
            p++;
            pc = p[0];
        }
        if (__fn_lower(pc, flags) != __fn_lower(s[0], flags)) {
            return false;
        }
        p++;
        s++;
        atStart = false;
    }
    return false;
}

// shell style wildcard matching:  * ? [abc] [a-z] [!x]  with backslash escapes. Returns 0 when the name matches, FNM_NOMATCH otherwise.
// flags: FNM_PATHNAME (wildcards do not match '/'), FNM_PERIOD (a leading '.' needs an explicit '.'), FNM_NOESCAPE, FNM_CASEFOLD.
int fnmatch(char* pattern, char* name, int flags = 0) {
    if (__fn_match(pattern, name, flags, true)) {
        return 0;
    }
    return FNM_NOMATCH;
}

// ---- signals (Linux and Android) -------------------------------------------------------------------------------------------
const SIG_DFL = 0;
const SIG_IGN = 1;
const SIG_ERR = -1;

char* __sig_page;
func __sig_handlers[65];

// an executable page with one small thunk per signal that calls the A function with its argument on the stack
// (the kernel calls handlers with the C calling convention of the platform), and the x86-64 signal return code
char* __sig_thunks() {
    if (__sig_page != null) {
        return __sig_page;
    }
    int nr = 9;
    if (__ARCH >= 1) {
        nr = 222;
    }
    int p = __syscall(nr, 0, 4096, 7, 0x22, -1, 0);                   // mmap(RWX, anonymous)
    if (p < 0 && p > -4096) {
        errno = -p;
        return null;
    }
    __sig_page = (char*) p;
    if (__ARCH == 0) {
        // restorer at offset 0: mov eax, 15 ; syscall   (rt_sigreturn)
        char* r = __sig_page;
        r[0] = 0xB8; r[1] = 15; r[2] = 0; r[3] = 0; r[4] = 0; r[5] = 0x0F; r[6] = 0x05;
    }
    return __sig_page;
}

void __put32(char* p, int off, int v) {
    p[off] = v;
    p[off + 1] = v >> 8;
    p[off + 2] = v >> 16;
    p[off + 3] = v >> 24;
}

// code of the thunk of signal `sig` at offset 64 + 48*sig; returns its address
char* __sig_thunk_for(int sig, func handler) {
    char* page = __sig_thunks();
    if (page == null) {
        return null;
    }
    char* t = &page[64 + 48 * sig];
    int* lit = (int*) &t[32];
    lit[0] = (int) handler;
    if (__ARCH == 0) {
        // push rdi ; mov rax, [rip+24] (the literal at +32) ; call rax ; add rsp, 8 ; ret
        t[0] = 0x57;
        t[1] = 0x48; t[2] = 0x8B; t[3] = 0x05; t[4] = 24; t[5] = 0; t[6] = 0; t[7] = 0;
        t[8] = 0xFF; t[9] = 0xD0;
        t[10] = 0x48; t[11] = 0x83; t[12] = 0xC4; t[13] = 0x08;
        t[14] = 0xC3;
    } else if (__ARCH == 2) {
        // RISC-V: mv s1,ra ; addi sp,sp,-16 ; sd a0,0(sp) ; auipc t0,0 ; ld t0,20(t0) (the literal at +32) ;
        //         jalr ra,0(t0) ; addi sp,sp,16 ; jalr x0,0(s1)     (s1 is not used by compiled code)
        __put32(t, 0, 0x00008493);
        __put32(t, 4, 0xFF010113);
        __put32(t, 8, 0x00A13023);
        __put32(t, 12, 0x00000297);
        __put32(t, 16, 0x0142B283);
        __put32(t, 20, 0x000280E7);
        __put32(t, 24, 0x01010113);
        __put32(t, 28, 0x00048067);
    } else if (__ARCH == 3) {
        // LoongArch: move s0,ra ; addi.d sp,sp,-16 ; st.d a0,sp,0 ; pcaddu12i t0,0 ; ld.d t0,t0,20 (the literal at +32) ;
        //            jirl ra,t0,0 ; addi.d sp,sp,16 ; jirl zero,s0,0     (s0 is not used by compiled code)
        __put32(t, 0, 0x00150037);
        __put32(t, 4, 0x02FFC063);
        __put32(t, 8, 0x29C00064);
        __put32(t, 12, 0x1C00000C);
        __put32(t, 16, 0x28C0518C);
        __put32(t, 20, 0x4C000181);
        __put32(t, 24, 0x02C04063);
        __put32(t, 28, 0x4C0002E0);
    } else {
        __put32(t, 0, 0xA9BF7BFD);          // stp x29, x30, [sp, #-16]!
        __put32(t, 4, 0xF81F0FE0);          // str x0, [sp, #-16]!
        __put32(t, 8, 0x580000D0);          // ldr x16, #24  (the literal at +32)
        __put32(t, 12, 0xD63F0200);         // blr x16
        __put32(t, 16, 0x910043FF);         // add sp, sp, #16
        __put32(t, 20, 0xA8C17BFD);         // ldp x29, x30, [sp], #16
        __put32(t, 24, 0xD65F03C0);         // ret
    }
    return t;
}

// installs a signal handler: a function void handler(int sig), or SIG_DFL (the default action) or SIG_IGN (ignore the signal).
// Returns the previous handler, or SIG_ERR (with errno set) on failure. Signals are available on Linux and Android only.
func signal(int sig, func handler) {
    if (__OS == 1 || sig < 1 || sig > 64) {
        errno = ENOSYS;
        if (__OS != 1) {
            errno = EINVAL;
        }
        return (func) SIG_ERR;
    }
    int h = (int) handler;
    char* thunk = null;
    if (h != SIG_DFL && h != SIG_IGN) {
        thunk = __sig_thunk_for(sig, handler);
        if (thunk == null) {
            return (func) SIG_ERR;
        }
        h = (int) thunk;
    }
    int act[4];
    int old[4];
    act[0] = h;
    act[1] = 0x10000000;                         // SA_RESTART
    act[2] = 0;
    act[3] = 0;
    if (__ARCH == 0 && thunk != null) {
        act[1] = act[1] | 0x04000000;            // SA_RESTORER
        act[2] = (int) __sig_page;
    }
    int nr = 13;
    if (__ARCH >= 1) {
        nr = 134;
    }
    int r = __syscall(nr, sig, &act[0], &old[0], 8, 0, 0);       // rt_sigaction
    if (r < 0) {
        errno = -r;
        return (func) SIG_ERR;
    }
    int prev = old[0];
    if (__sig_page != null && prev == (int) &__sig_page[64 + 48 * sig]) {
        int* lit = (int*) &__sig_page[64 + 48 * sig + 32];
        return (func) lit[0];
    }
    return (func) prev;
}

// delivers a SIGALRM to the program after the given number of seconds (0 cancels); returns the seconds that were left
int alarm(int seconds) {
    if (__OS == 1) {
        errno = ENOSYS;
        return 0;
    }
    int itv[4];
    int old[4];
    itv[0] = 0;
    itv[1] = 0;
    itv[2] = seconds;
    itv[3] = 0;
    int nr = 38;
    if (__ARCH >= 1) {
        nr = 103;
    }
    __syscall(nr, 0, &itv[0], &old[0], 0, 0, 0);               // setitimer(ITIMER_REAL)
    int left = old[2];
    if (old[3] > 0) {
        left++;
    }
    return left;
}

// waits until a signal arrives; returns -1 with errno EINTR
int pause() {
    if (__OS == 1) {
        errno = ENOSYS;
        return -1;
    }
    int mask = 0;
    int nr = 130;
    if (__ARCH >= 1) {
        nr = 133;
    }
    __syscall(nr, &mask, 8, 0, 0, 0, 0);                        // rt_sigsuspend with an empty mask
    errno = EINTR;
    return -1;
}
