// =============================================================================
//  regex - small regular expressions                         import regex;
//
//  Supported: literals  .  ^  $  *  +  ?  [abc] [a-z] [^0-9]  \d \D \w \W \s \S  and \. style escapes.
//  Matching is greedy with backtracking. Not supported: groups ( ), alternation |, {n,m}.
//
//    bool regex.matches(pattern, text)            the whole text must match
//    int  regex.search(pattern, text, &len)       start of the first match (or -1), len = its length
//    bool regex.test(pattern, text)               matches anywhere
//    char* regex.replaceAll(pattern, text, repl)  replaces every match
// =============================================================================
module regex;

// index just after the atom (a character, an escape or a [set]) starting at p
private int atomEnd(char* pat, int p) {
    if (pat[p] == 92 && pat[p + 1] != 0) {
        return p + 2;
    }
    if (pat[p] == '[') {
        int i = p + 1;
        if (pat[i] == '^') {
            i++;
        }
        if (pat[i] == ']') {
            i++;
        }
        while (pat[i] != 0 && pat[i] != ']') {
            i++;
        }
        if (pat[i] == ']') {
            i++;
        }
        return i;
    }
    return p + 1;
}

private bool classOf(int e, int c) {
    switch (e) {
        case 'd': return isDigit(c);
        case 'D': return !isDigit(c);
        case 'w': return isAlpha(c) || isDigit(c) || c == '_';
        case 'W': return !(isAlpha(c) || isDigit(c) || c == '_');
        case 's': return isSpace(c);
        case 'S': return !isSpace(c);
        case 'n': return c == 10;
        case 't': return c == 9;
    }
    return c == e;
}

private bool atomMatch(char* pat, int p, int c) {
    if (c == 0) {
        return false;
    }
    if (pat[p] == '.') {
        return true;
    }
    if (pat[p] == 92) {
        return classOf(pat[p + 1], c);
    }
    if (pat[p] == '[') {
        int i = p + 1;
        bool neg = false;
        if (pat[i] == '^') {
            neg = true;
            i++;
        }
        bool found = false;
        bool first = true;
        while (pat[i] != 0 && (pat[i] != ']' || first)) {
            first = false;
            int lo = pat[i];
            if (lo == 92 && pat[i + 1] != 0) {
                i++;
                if (classOf(pat[i], c) && (pat[i] == 'd' || pat[i] == 'w' || pat[i] == 's' || pat[i] == 'D' || pat[i] == 'W' || pat[i] == 'S')) {
                    found = true;
                }
                lo = pat[i];
                if (lo == 'n') lo = 10;
                if (lo == 't') lo = 9;
            }
            if (pat[i + 1] == '-' && pat[i + 2] != ']' && pat[i + 2] != 0) {
                if (c >= lo && c <= pat[i + 2]) {
                    found = true;
                }
                i = i + 3;
            } else {
                if (c == lo) {
                    found = true;
                }
                i++;
            }
        }
        return found != neg;
    }
    return pat[p] == c;
}

// returns the index in s where the match of pat[p..] ends, or -1
private int matchHere(char* pat, int p, char* s, int i) {
    if (pat[p] == 0) {
        return i;
    }
    if (pat[p] == '$' && pat[p + 1] == 0) {
        if (s[i] == 0) {
            return i;
        }
        return -1;
    }
    int e = atomEnd(pat, p);
    int q = pat[e];
    if (q == '*' || q == '+') {
        int n = 0;
        while (atomMatch(pat, p, s[i + n])) {
            n++;
        }
        int least = 0;
        if (q == '+') {
            least = 1;
        }
        while (n >= least) {
            int r = matchHere(pat, e + 1, s, i + n);
            if (r >= 0) {
                return r;
            }
            n--;
        }
        return -1;
    }
    if (q == '?') {
        if (atomMatch(pat, p, s[i])) {
            int r = matchHere(pat, e + 1, s, i + 1);
            if (r >= 0) {
                return r;
            }
        }
        return matchHere(pat, e + 1, s, i);
    }
    if (atomMatch(pat, p, s[i])) {
        return matchHere(pat, e, s, i + 1);
    }
    return -1;
}

// first match at or after position from: returns its start (or -1) and stores its length in *len
private int searchFrom(char* pat, char* s, int from, int* len) {
    if (pat[0] == '^') {
        if (from > 0) {
            return -1;
        }
        int r = matchHere(pat, 1, s, 0);
        if (r < 0) {
            return -1;
        }
        *len = r;
        return 0;
    }
    int i = from;
    for (;;) {
        int r = matchHere(pat, 0, s, i);
        if (r >= 0) {
            *len = r - i;
            return i;
        }
        if (s[i] == 0) {
            return -1;
        }
        i++;
    }
    return -1;
}

public int search(char* pat, char* s, int* len) {
    return searchFrom(pat, s, 0, len);
}

public bool test(char* pat, char* s) {
    int len;
    return searchFrom(pat, s, 0, &len) >= 0;
}

// the whole text must match the pattern
public bool matches(char* pat, char* s) {
    int p = 0;
    if (pat[0] == '^') {
        p = 1;
    }
    // try every possible end by appending an implicit $
    int n = strlen(pat);
    char* full = alloc(n + 2);
    memcpy(full, pat, n);
    if (!(n > 0 && pat[n - 1] == '$' && (n < 2 || pat[n - 2] != 92))) {
        full[n] = '$';
    }
    return matchHere(full, p, s, 0) >= 0;
}

public char* replaceAll(char* pat, char* s, char* repl) {
    int rl = strlen(repl);
    int cap = strlen(s) * (rl + 1) + 16;
    char* out = alloc(cap);
    int o = 0;
    int pos = 0;
    int n = strlen(s);
    while (pos <= n) {
        int len;
        int at = searchFrom(pat, s, pos, &len);
        if (at < 0) {
            break;
        }
        memcpy(&out[o], &s[pos], at - pos);
        o = o + at - pos;
        memcpy(&out[o], repl, rl);
        o = o + rl;
        if (len == 0) {
            if (s[at] == 0) {
                pos = n + 1;
                break;
            }
            out[o] = s[at];
            o++;
            pos = at + 1;
        } else {
            pos = at + len;
        }
    }
    if (pos <= n) {
        memcpy(&out[o], &s[pos], n - pos);
        o = o + n - pos;
    }
    return out;
}
