// =============================================================================
//  os - working directory, files and directories             import os;
//  (basic file functions such as fileExists, fileDelete, makeDir are in the standard library)
// =============================================================================
module os;

// the current working directory as a heap string, null on error
public char* getCwd() {
    char buf[4096];
    if (__OS == 1) {
        int n = (__winapi(16, 4096, &buf[0], 0, 0) << 32) >> 32;       // GetCurrentDirectoryA
        if (n <= 0) {
            return null;
        }
        return strdup(buf);
    }
    int nr = 79;
    if (__ARCH >= 1) {
        nr = 17;
    }
    int r = __syscall(nr, &buf[0], 4096, 0, 0, 0, 0);                  // getcwd
    if (r <= 0) {
        return null;
    }
    return strdup(buf);
}

// renames or moves a file or directory; true on success.
// (Windows refuses to replace an existing destination, Linux replaces it.)
public bool rename(char* from, char* to) {
    if (__OS == 1) {
        return ((__winapi(15, from, to, 0, 0) << 32) >> 32) != 0;      // MoveFileA
    }
    if (__ARCH >= 1) {
        int rn = 38;                                                    // renameat (ARM64)
        if (__ARCH >= 2) {
            rn = 276;                                                   // renameat2 (RISC-V, LoongArch have no renameat)
        }
        return __syscall(rn, -100, from, -100, to, 0, 0) == 0;
    }
    return __syscall(82, from, to, 0, 0, 0, 0) == 0;                   // rename
}

// size of a file in bytes, -1 if it cannot be opened (or is a directory)
public int fileSize(char* path) {
    int h = __open(path, 0);
    if (h < 0) {
        return -1;
    }
    int size;
    if (__OS == 1) {
        size = __winapi(17, h, 0, 0, 0) & 0xFFFFFFFF;                  // GetFileSize
        if (size == 0xFFFFFFFF) {
            size = -1;
        }
    } else {
        int nr = 8;
        if (__ARCH >= 1) {
            nr = 62;
        }
        size = __syscall(nr, h, 0, 2, 0, 0, 0);                        // lseek(h, 0, SEEK_END)
        if (size < 0 || size > 0x3FFFFFFFFFFFFFFF) {
            size = -1;                                                  // directories report a huge value
        }
    }
    __close(h);
    return size;
}

// Lists the names in a directory (without "." and "..") into out, at most max of them, as new
// heap strings, in no particular order. Returns how many were stored, -1 if the directory cannot be read.
public int listDir(char* path, char** out, int max) {
    int count = 0;
    if (__OS == 1) {
        char pattern[1100];
        int n = strlen(path);
        if (n > 1000) {
            return -1;
        }
        strcpy(pattern, path);
        if (n > 0 && path[n - 1] != '/' && path[n - 1] != 92) {
            pattern[n] = 92;
            n++;
        }
        pattern[n] = '*';
        pattern[n + 1] = 0;
        char data[400];
        int h = __winapi(18, &pattern[0], &data[0], 0, 0);              // FindFirstFileA
        if (h == -1) {
            return -1;
        }
        for (;;) {
            char* name = &data[44];                                      // WIN32_FIND_DATA.cFileName
            if (!streq(name, ".") && !streq(name, "..") && count < max) {
                out[count] = strdup(name);
                count++;
            }
            if (((__winapi(19, h, &data[0], 0, 0) << 32) >> 32) == 0) {   // FindNextFileA
                break;
            }
        }
        __winapi(20, h, 0, 0, 0);                                        // FindClose
        return count;
    }
    int fd = __open(path, 0);
    if (fd < 0) {
        return -1;
    }
    char buf[4096];
    int nr = 217;
    if (__ARCH >= 1) {
        nr = 61;
    }
    for (;;) {
        int got = __syscall(nr, fd, &buf[0], 4096, 0, 0, 0);             // getdents64
        if (got <= 0) {
            break;
        }
        int pos = 0;
        while (pos < got) {
            int reclen = buf[pos + 16] | (buf[pos + 17] << 8);
            char* name = &buf[pos + 19];
            if (!streq(name, ".") && !streq(name, "..") && count < max) {
                out[count] = strdup(name);
                count++;
            }
            pos = pos + reclen;
        }
    }
    __close(fd);
    return count;
}
