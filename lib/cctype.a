// =============================================================================
//  cctype - C <ctype.h>                                       import cctype;
//
//  Character classification and conversion with the C names. The functions take an int
//  (a character code) and are ASCII only; see the utf8 module for Unicode.
//  The names go into the global namespace, like the C header.
//  (The standard library itself has the same tests under camelCase names: isDigit, isAlpha ...)
// =============================================================================

bool isalpha(int c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

bool isdigit(int c) {
    return c >= '0' && c <= '9';
}

bool isalnum(int c) {
    return isalpha(c) || isdigit(c);
}

bool isupper(int c) {
    return c >= 'A' && c <= 'Z';
}

bool islower(int c) {
    return c >= 'a' && c <= 'z';
}

// space, \t \n \v \f \r
bool isspace(int c) {
    return c == ' ' || (c >= 9 && c <= 13);
}

// space or tab
bool isblank(int c) {
    return c == ' ' || c == 9;
}

bool iscntrl(int c) {
    return (c >= 0 && c < 32) || c == 127;
}

// printable, but not the space
bool isgraph(int c) {
    return c > 32 && c < 127;
}

// printable including the space
bool isprint(int c) {
    return c >= 32 && c < 127;
}

// printable and neither a letter, a digit nor the space
bool ispunct(int c) {
    return isgraph(c) && !isalnum(c);
}

bool isxdigit(int c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

bool isascii(int c) {
    return c >= 0 && c < 128;
}

int toupper(int c) {
    if (c >= 'a' && c <= 'z') {
        return c - 32;
    }
    return c;
}

int tolower(int c) {
    if (c >= 'A' && c <= 'Z') {
        return c + 32;
    }
    return c;
}

int toascii(int c) {
    return c & 127;
}

// value of a digit in the given base (0-9, a-z, A-Z), -1 if c is not a digit of that base
int digitValue(int c, int base = 36) {
    int v = -1;
    if (c >= '0' && c <= '9') {
        v = c - '0';
    } else if (c >= 'a' && c <= 'z') {
        v = c - 'a' + 10;
    } else if (c >= 'A' && c <= 'Z') {
        v = c - 'A' + 10;
    }
    if (v >= base) {
        return -1;
    }
    return v;
}
