    __stir_h[16] = STIR16_H;
    __stir_l[16] = STIR16_L;
    __stir_h[17] = STIR17_H;
    __stir_l[17] = STIR17_L;
    __stir_h[18] = STIR18_H;
    __stir_l[18] = STIR18_L;
    __stir_h[19] = STIR19_H;
    __stir_l[19] = STIR19_L;
    __stir_h[20] = STIR20_H;
