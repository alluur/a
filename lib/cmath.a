    __zeta_h[13] = DD_ZETA13_H;
    __zeta_l[13] = DD_ZETA13_L;
}

// ---- inverse trigonometric functions -------------------------------------------------------------------------------------------------------
// atan of a non-negative dd (th + tl); result in __dh / __dl
void __atan_dd(int th, int tl) {
    bool inv = false;
    if (dgt(th, 0x3FF0000000000000)) {
        __dd_div(0x3FF0000000000000, 0, th, tl);
        th = __dh;
        tl = __dl;
        inv = true;
    }
    for (int i = 0; i < 4; i++) {
        __dd_mul(th, tl, th, tl);
        __dd_add_d(__dh, __dl, 0x3FF0000000000000);
        __dd_sqrt(__dh, __dl);
        __dd_add_d(__dh, __dl, 0x3FF0000000000000);
        __dd_div(th, tl, __dh, __dl);
        th = __dh;
        tl = __dl;
    }
    __dd_mul(th, tl, th, tl);
    int zh = __dh;
    int zl = __dl;
    // atan(t) = t (1/1 - z/3 + z^2/5 - ...)
    __dd_div_d(0x3FF0000000000000, 0, itod(31));
    int ah = __dh;
    int al = __dl;
    for (int n = 14; n >= 0; n--) {
        __dd_mul(zh, zl, ah, al);
        int ph = __dh;
        int pl = __dl;
        __dd_div_d(0x3FF0000000000000, 0, itod(2 * n + 1));
        __dd_sub(__dh, __dl, ph, pl);
        ah = __dh;
        al = __dl;
    }
    __dd_mul(th, tl, ah, al);
    int rh = scalbn(__dh, 4);
    int rl = scalbn(__dl, 4);
    if (inv) {
        __dd_sub(DD_PI2_H, DD_PI2_L, rh, rl);
    } else {
        __dh = rh;
        __dl = rl;
    }
}

int atan(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    if (ax == 0x7FF0000000000000) { return copysign(0x3FF921FB54442D18, x); }
    __atan_dd(ax, 0);
    return copysign(__dh, x);
}

int atan2(int y, int x) {
    if (isnan(x) || isnan(y)) { return NAN; }
    int ay = y & 0x7FFFFFFFFFFFFFFF;
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    int sy = y & (1 << 63);
    bool xneg = x < 0;
    if (ay == 0) {
        if (xneg) { return sy | 0x400921FB54442D18; }
        return y;
    }
    if (ax == 0) { return sy | 0x3FF921FB54442D18; }
    if (ax == 0x7FF0000000000000) {
        if (ay == 0x7FF0000000000000) {
            if (xneg) { return sy | 0x4002D97C7F3321D2; }
            return sy | 0x3FE921FB54442D18;
        }
        if (xneg) { return sy | 0x400921FB54442D18; }
        return sy;
    }
    if (ay == 0x7FF0000000000000) { return sy | 0x3FF921FB54442D18; }
    int ah;
    int al;
    bool swapped = false;
    if (ay <= ax) {
        if (dlt(ay, dmul(ax, 0x3C30000000000000))) {
            ah = ddiv(ay, ax);
            al = 0;
        } else {
            __dd_div(ay, 0, ax, 0);
            __atan_dd(__dh, __dl);
            ah = __dh;
            al = __dl;
        }
    } else {
        swapped = true;
        if (dlt(ax, dmul(ay, 0x3C30000000000000))) {
            ah = ddiv(ax, ay);
            al = 0;
        } else {
            __dd_div(ax, 0, ay, 0);
            __atan_dd(__dh, __dl);
            ah = __dh;
            al = __dl;
        }
        __dd_sub(DD_PI2_H, DD_PI2_L, ah, al);
        ah = __dh;
        al = __dl;
    }
    if (xneg) {
        __dd_sub(DD_PI_H, DD_PI_L, ah, al);
        ah = __dh;
        al = __dl;
    }
    return sy | ah;
}

int asin(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (dgt(ax, 0x3FF0000000000000)) { return NAN; }
    if (ax < 0x3E40000000000000) { return x; }
    if (ax == 0x3FF0000000000000) { return copysign(0x3FF921FB54442D18, x); }
    __two_sum(0x3FF0000000000000, dneg(ax));
    int ah = __sh;
    int al = __sl;
    __two_sum(0x3FF0000000000000, ax);
    __dd_mul(ah, al, __sh, __sl);
    __dd_sqrt(__dh, __dl);
    __dd_div(ax, 0, __dh, __dl);
    __atan_dd(__dh, __dl);
    return copysign(__dh, x);
}

int acos(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (dgt(ax, 0x3FF0000000000000)) { return NAN; }
    if (x == 0x3FF0000000000000) { return 0; }
    if (x == 0xBFF0000000000000) { return 0x400921FB54442D18; }
    __two_sum(0x3FF0000000000000, dneg(x));
    int ah = __sh;
    int al = __sl;
    __two_sum(0x3FF0000000000000, x);
    __dd_div(ah, al, __sh, __sl);
    __dd_sqrt(__dh, __dl);
    __atan_dd(__dh, __dl);
    return scalbn(__dh, 1);
}

// ---- hyperbolic functions --------------------------------------------------------------------------------------------------------------------
// cosh and sinh: (E +- 1/E) / 2 with E = e^|x| ; sign = +1 / -1
int __cosh_sinh(int x, bool sinh) {
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (dgt(ax, 0x408633CE8FB9F87E)) {
        if (sinh) { return copysign(INFINITY, x); }
        return INFINITY;
    }
    __exp_dd(ax, 0, false);
    int eh = __dh;
    int el = __dl;
    int k = __ek;
    __dd_div(0x3FF0000000000000, 0, eh, el);
    int ih = __dh;
    int il = __dl;
    // E*2^(k-1) and (1/E)*2^(-k-1)
    int ah = scalbn(eh, k - 1);
    int al = scalbn(el, k - 1);
    int bh = scalbn(ih, -k - 1);
    int bl = scalbn(il, -k - 1);
    if (sinh) {
        __dd_sub(ah, al, bh, bl);
    } else {
        __dd_add(ah, al, bh, bl);
    }
    int r = __dd_to_double(__dh, __dl, 0);
    if (sinh && x < 0) {
        return dneg(r);
    }
    return r;
}

int cosh(int x) {
    if (isnan(x)) { return x; }
    return __cosh_sinh(x, false);
}

int sinh(int x) {
    if (isnan(x) || isinf(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    if (ax < 0x3FD6000000000000) {
        __exp_dd(ax, 0, true);
        int eh = __dh;
        int el = __dl;
        __dd_add_d(eh, el, 0x3FF0000000000000);
        __dd_div(eh, el, __dh, __dl);
        __dd_add(eh, el, __dh, __dl);
        int r = __dd_to_double(scalbn(__dh, -1), scalbn(__dl, -1), 0);
        if (x < 0) { return dneg(r); }
        return r;
    }
    return __cosh_sinh(x, true);
}

int tanh(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    if (ax >= 0x4036000000000000) { return copysign(0x3FF0000000000000, x); }
    int r;
    if (ax < 0x3FE0000000000000) {
        __exp_dd(scalbn(ax, 1), 0, true);
        int eh = __dh;
        int el = __dl;
        __dd_add_d(eh, el, 0x4000000000000000);
        __dd_div(eh, el, __dh, __dl);
        r = __dh;
    } else {
        __exp_dd(scalbn(ax, 1), 0, false);
        __dd_scale(__dh, __dl, __ek);
        int eh = __dh;
        int el = __dl;
        __dd_add_d(eh, el, 0xBFF0000000000000);
        int nh = __dh;
        int nl = __dl;
        __dd_add_d(eh, el, 0x3FF0000000000000);
        __dd_div(nh, nl, __dh, __dl);
        r = __dh;
    }
    return copysign(r, x);
}

int asinh(int x) {
    if (isnan(x) || isinf(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return x; }
    int r;
    if (ax > 0x5FE0000000000000) {
        __log_dd(ax, 0);
        __dd_add(__dh, __dl, DD_LN2_H, DD_LN2_L);
        r = __dh;
    } else {
        __two_prod(ax, ax);
        __dd_add_d(__sh, __sl, 0x3FF0000000000000);
        __dd_sqrt(__dh, __dl);
        __dd_add_d(__dh, __dl, ax);
        __log_dd(__dh, __dl);
        r = __dh;
    }
    return copysign(r, x);
}

int acosh(int x) {
    if (isnan(x)) { return x; }
    if (x < 0x3FF0000000000000) { return NAN; }
    if (x == 0x3FF0000000000000) { return 0; }
    if (x == INFINITY) { return x; }
    if (x > 0x5FE0000000000000) {
        __log_dd(x, 0);
        __dd_add(__dh, __dl, DD_LN2_H, DD_LN2_L);
        return __dh;
    }
    __two_sum(x, 0xBFF0000000000000);
    int ah = __sh;
    int al = __sl;
    __two_sum(x, 0x3FF0000000000000);
    __dd_mul(ah, al, __sh, __sl);
    __dd_sqrt(__dh, __dl);
    __dd_add_d(__dh, __dl, x);
    __log_dd(__dh, __dl);
    return __dh;
}

int atanh(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (dgt(ax, 0x3FF0000000000000)) { return NAN; }
    if (ax == 0x3FF0000000000000) { return copysign(INFINITY, x); }
    if (ax < 0x3E40000000000000) { return x; }
    __two_sum(0x3FF0000000000000, ax);
    int ph = __sh;
    int pl = __sl;
    __two_sum(0x3FF0000000000000, dneg(ax));
    __dd_div(ph, pl, __sh, __sl);
    __log_dd(__dh, __dl);
    return copysign(scalbn(__dh, -1), x);
}

// ---- error function ----------------------------------------------------------------------------------------------------------------------------
// erf(x) for 0 <= x <= 6 as dd: 2/sqrt(pi) e^(-x^2) sum 2^n x^(2n+1) / (1*3*5*...*(2n+1))
void __erf_dd(int x) {
    __two_prod(x, x);
    int z2h = scalbn(__sh, 1);
    int z2l = scalbn(__sl, 1);
    int th = x;
    int tl = 0;
    int sh = x;
    int sl = 0;
    for (int n = 0; n < 400; n++) {
        __dd_mul(th, tl, z2h, z2l);
        __dd_div_d(__dh, __dl, itod(2 * n + 3));
        th = __dh;
        tl = __dl;
        __dd_add(sh, sl, th, tl);
        sh = __dh;
        sl = __dl;
        if (dlt(th, dmul(sh, 0x3900000000000000))) {
            break;
        }
    }
    // times 2/sqrt(pi) * e^(-x^2)
    __two_prod(x, x);
    __exp_dd(dneg(__sh), dneg(__sl), false);
    __dd_scale(__dh, __dl, __ek);
    __dd_mul(sh, sl, __dh, __dl);
    __dd_mul(__dh, __dl, DD_2_SQRTPI_H, DD_2_SQRTPI_L);
}

int erf(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax >= 0x4018000000000000) { return copysign(0x3FF0000000000000, x); }
    if (ax < 0x3E40000000000000) {
        if (ax < 0x2000000000000000) {
            return dmul(x, 0x3FF20DD750429B6D);
        }
        __dd_mul(x, 0, DD_2_SQRTPI_H, DD_2_SQRTPI_L);
        return __dh;
    }
    __erf_dd(ax);
    return copysign(__dh, x);
}

// erfc(x) = 1 - erf(x) without losing the small result for large x
int erfc(int x) {
    if (isnan(x)) { return x; }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (x >= 0x403B400000000000) { return 0; }
    if (x < 0 && ax >= 0x4018000000000000) { return 0x4000000000000000; }
    if (ax < 0x3E40000000000000) {
        return dsub(0x3FF0000000000000, x);
    }
    int r;
    if (dlt(ax, 0x4004000000000000)) {
        __erf_dd(ax);
        if (x < 0) {
            __dd_add_d(__dh, __dl, 0x3FF0000000000000);
        } else {
            __dd_sub(0x3FF0000000000000, 0, __dh, __dl);
        }
        return __dd_to_double(__dh, __dl, 0);
    }
    // continued fraction: e^(-x^2) / (sqrt(pi) (x + (1/2)/(x + (2/2)/(x + (3/2)/(x + ...)))))
    int th = ax;
    int tl = 0;
    for (int k = 240; k >= 1; k--) {
        __dd_div(scalbn(itod(k), -1), 0, th, tl);
        __dd_add_d(__dh, __dl, ax);
        th = __dh;
        tl = __dl;
    }
    __dd_mul(th, tl, DD_SQRTPI_H, DD_SQRTPI_L);
    __dd_div(0x3FF0000000000000, 0, __dh, __dl);
    int ch = __dh;
    int cl = __dl;
    __two_prod(ax, ax);
    __exp_dd(dneg(__sh), dneg(__sl), false);
    __dd_mul(__dh, __dl, ch, cl);
    r = __dd_to_double(__dh, __dl, __ek);
    if (x < 0) {
        return dsub(0x4000000000000000, r);
    }
    return r;
}

// ---- gamma functions -------------------------------------------------------------------------------------------------------------------------------
// sin(pi f) for 0 <= f <= 0.5 as dd
void __sinpi_dd(int f) {
    if (dle(f, 0x3FD0000000000000)) {
        __dd_mul_d(DD_PI_H, DD_PI_L, f);
        __sincos_dd(__dh, __dl);
        __dh = __s_h;
        __dl = __s_l;
    } else {
        __dd_mul_d(DD_PI_H, DD_PI_L, dsub(0x3FE0000000000000, f));
        __sincos_dd(__dh, __dl);
        __dh = __c_h;
        __dl = __c_l;
    }
}

// ln(Gamma(x)) for x > 0 as dd
void __lgamma_pos(int xh, int xl) {
    __stir_init();
    __zeta_init();
    // near 1 and 2 the general formula loses digits: use the Taylor series of ln Gamma(1 + t)
    int t1h = dsub(xh, 0x3FF0000000000000);
    int t2h = dsub(xh, 0x4000000000000000);
    if (fabs(t1h) < 0x3F50624DD2F1A9FC || fabs(t2h) < 0x3F50624DD2F1A9FC) {
        // t = x - 1 or x - 2 (exact for doubles close to 1 or 2)
        int th = t1h;
        bool two = false;
        if (fabs(t2h) < 0x3F50624DD2F1A9FC) {
            th = t2h;
            two = true;
        }
        int tl = xl;
        // sum_{k>=2} (-1)^k zeta(k) t^k / k   (+ the -ln(1+t) part for Gamma(2+t))
        int sh = 0;
        int sl = 0;
        __dd_mul(th, tl, th, tl);
        int t2h_ = __dh;
        int t2l_ = __dl;
        int ph = t2h_;
        int pl = t2l_;
        for (int k = 2; k <= 13; k++) {
            int zh = __zeta_h[k];
            int zl = __zeta_l[k];
            if (two) {
                __dd_add_d(zh, zl, 0xBFF0000000000000);
                zh = __dh;
                zl = __dl;
            }
            __dd_mul(zh, zl, ph, pl);
            __dd_div_d(__dh, __dl, itod(k));
            if ((k & 1) == 1) {
                __dd_sub(sh, sl, __dh, __dl);
            } else {
                __dd_add(sh, sl, __dh, __dl);
            }
            sh = __dh;
            sl = __dl;
            __dd_mul(ph, pl, th, tl);
            ph = __dh;
            pl = __dl;
        }
        int ch = DD_EULER_H;
        int cl = DD_EULER_L;
        if (two) {
            __dd_sub(0x3FF0000000000000, 0, ch, cl);
            ch = __dh;
            cl = __dl;
        } else {
            ch = dneg(ch);
            cl = dneg(cl);
        }
        __dd_mul(ch, cl, th, tl);
        __dd_add(__dh, __dl, sh, sl);
        return;
    }
    // shift x up to at least 25, remembering the product x (x+1) ... (x+n-1)
    int ph = 0x3FF0000000000000;
    int pl = 0;
    while (dlt(xh, 0x4039000000000000)) {
        __dd_mul(ph, pl, xh, xl);
        ph = __dh;
        pl = __dl;
        __dd_add_d(xh, xl, 0x3FF0000000000000);
        xh = __dh;
        xl = __dl;
    }
    // Stirling: (x - 1/2) ln x - x + ln(2 pi)/2 + sum c_k / x^(2k-1)
    __log_dd(xh, xl);
    int lh = __dh;
    int ll = __dl;
    __dd_add_d(xh, xl, 0xBFE0000000000000);
    __dd_mul(__dh, __dl, lh, ll);
    __dd_sub(__dh, __dl, xh, xl);
    __dd_add(__dh, __dl, DD_HLN2PI_H, DD_HLN2PI_L);
    int ah = __dh;
    int al = __dl;
    // 1/x and 1/x^2
    __dd_div(0x3FF0000000000000, 0, xh, xl);
    int ih = __dh;
    int il = __dl;
    __dd_mul(ih, il, ih, il);
    int jh = __dh;
    int jl = __dl;
    int sh = 0;
    int sl = 0;
    for (int k = 20; k >= 1; k--) {
        __dd_mul(sh, sl, jh, jl);
        __dd_add(__dh, __dl, __stir_h[k], __stir_l[k]);
        sh = __dh;
        sl = __dl;
    }
    __dd_mul(sh, sl, ih, il);
    __dd_add(ah, al, __dh, __dl);
    int rh = __dh;
    int rl = __dl;
    if (ph != 0x3FF0000000000000) {
        __log_dd(ph, pl);
        __dd_sub(rh, rl, __dh, __dl);
    }
}

// -1 if sin(pi x) is negative, +1 if positive (x not an integer)
int __sinpi_sign(int x) {
    int ax = fabs(x);
    int fl = floor(ax);
    int odd = 0;
    if (ax < 0x4340000000000000 && (dtoi(fl) & 1) == 1) {
        odd = 1;
    }
    int s = 1;
    if (odd == 1) { s = -1; }
    if (x < 0) { s = -s; }
    return s;
}

// ln |Gamma(x)| for a negative non-integer x (dd): ln(pi / |sin(pi x)|) - lnGamma(1 - x)
void __lgamma_neg(int x) {
    int ax = fabs(x);
    int f = dsub(ax, floor(ax));
    if (dgt(f, 0x3FE0000000000000)) {
        f = dsub(0x3FF0000000000000, f);
    }
    __sinpi_dd(f);
    __dd_div(DD_PI_H, DD_PI_L, __dh, __dl);
    __log_dd(__dh, __dl);
    int ah = __dh;
    int al = __dl;
    __two_sum(0x3FF0000000000000, dneg(x));
    __lgamma_pos(__sh, __sl);
    __dd_sub(ah, al, __dh, __dl);
}

int lgamma(int x) {
    if (isnan(x)) { return x; }
    if (isinf(x)) { return INFINITY; }
    if (x == 0 || (x < 0 && trunc(x) == x)) { return INFINITY; }
    if (x == 0x3FF0000000000000 || x == 0x4000000000000000) { return 0; }
    if (dgt(x, 0x7F5754D9278B51A7)) { return INFINITY; }
    if (x < 0) {
        __lgamma_neg(x);
    } else {
        __lgamma_pos(x, 0);
    }
    return __dh;
}

int tgamma(int x) {
    if (isnan(x)) { return x; }
    if (x == INFINITY) { return x; }
    if (x == NEG_INFINITY) { return NAN; }
    if ((x & 0x7FFFFFFFFFFFFFFF) == 0) { return copysign(INFINITY, x); }
    if (x < 0 && trunc(x) == x) { return NAN; }
    if (dgt(x, 0x406573FAE561F647)) { return INFINITY; }
    if (x > 0 && x < 0x3C90000000000000) { return ddiv(0x3FF0000000000000, x); }
    if (x > 0) {
        __lgamma_pos(x, 0);
        __exp_dd(__dh, __dl, false);
        return __dd_to_double(__dh, __dl, __ek);
    }
    __lgamma_neg(x);
    __exp_dd(__dh, __dl, false);
    int r = __dd_to_double(__dh, __dl, __ek);
    if (__sinpi_sign(x) < 0) {
        return dneg(r);
    }
    return r;
}
