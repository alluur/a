void __zeta_init() {
    if (__zeta_ready) {
        return;
    }
    __zeta_ready = true;
    __zeta_h[2] = DD_ZETA2_H;
    __zeta_l[2] = DD_ZETA2_L;
    __zeta_h[3] = DD_ZETA3_H;
    __zeta_l[3] = DD_ZETA3_L;
    __zeta_h[4] = DD_ZETA4_H;
    __zeta_l[4] = DD_ZETA4_L;
    __zeta_h[5] = DD_ZETA5_H;
    __zeta_l[5] = DD_ZETA5_L;
    __zeta_h[6] = DD_ZETA6_H;
    __zeta_l[6] = DD_ZETA6_L;
    __zeta_h[7] = DD_ZETA7_H;
    __zeta_l[7] = DD_ZETA7_L;
    __zeta_h[8] = DD_ZETA8_H;
    __zeta_l[8] = DD_ZETA8_L;
    __zeta_h[9] = DD_ZETA9_H;
    __zeta_l[9] = DD_ZETA9_L;
    __zeta_h[10] = DD_ZETA10_H;
