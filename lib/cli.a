// =============================================================================
//  cli - command line argument parser                          import cli;
//
//    cli.ArgParser p("mytool", "Does useful things");
//    p.addFlag("-v,--verbose", "print more");
//    p.addOption("-o,--output", "output file", "out.txt");
//    if (!p.parse(argc, argv)) return 1;          // prints errors and --help text itself
//    if (p.flag("-v")) ...  char* out = p.option("--output");
//    for (int i = 0; i < p.positionalCount(); i++) println(p.positional(i));
//
//  Understands  -x  -xyz (several flags)  --long  --long=value  -o value  and  --  (everything after it is positional).
//  A flag or option can be asked for with any of its names.
// =============================================================================
module cli;

public class ArgParser {
    private char* prog;
    private char* about;
    private char* specs[32];
    private char* helps[32];
    private int takesValue[32];
    private char* values[32];
    private char* defaults[32];
    private int seen[32];
    private int count;
    private char* rest[64];
    private int nrest;

    public ArgParser(char* name, char* description) {
        prog = name;
        about = description;
    }

    public void addFlag(char* spec, char* help) {
        if (count < 32) {
            specs[count] = spec;
            helps[count] = help;
            count++;
        }
    }

    public void addOption(char* spec, char* help, char* fallback) {
        if (count < 32) {
            specs[count] = spec;
            helps[count] = help;
            takesValue[count] = 1;
            values[count] = fallback;
            defaults[count] = fallback;
            count++;
        }
    }

    // does name appear as one of the comma separated names in spec?
    private bool specHas(char* spec, char* name) {
        int n = strlen(name);
        int i = 0;
        while (spec[i] != 0) {
            int k = 0;
            while (k < n && spec[i + k] == name[k]) {
                k++;
            }
            if (k == n && (spec[i + k] == ',' || spec[i + k] == 0)) {
                return true;
            }
            while (spec[i] != ',' && spec[i] != 0) {
                i++;
            }
            if (spec[i] == ',') {
                i++;
            }
        }
        return false;
    }

    private int indexOfName(char* name) {
        for (int i = 0; i < count; i++) {
            if (specHas(specs[i], name)) {
                return i;
            }
        }
        return -1;
    }

    private bool fail(char* message, char* arg) {
        eprint(prog);
        eprint(": ");
        eprint(message);
        eprint(" ");
        eprintln(arg);
        return false;
    }

    // processes the arguments (argv[0] is skipped). Returns false after an error or --help.
    public bool parse(int argc, char** argv) {
        bool onlyRest = false;
        for (int i = 1; i < argc; i++) {
            char* tok = argv[i];
            if (onlyRest || tok[0] != '-' || tok[1] == 0) {
                if (nrest < 64) {
                    rest[nrest] = tok;
                    nrest++;
                }
                continue;
            }
            if (streq(tok, "--")) {
                onlyRest = true;
                continue;
            }
            if (streq(tok, "-h") || streq(tok, "--help")) {
                printHelp();
                return false;
            }
            // --name=value
            int eq = -1;
            if (tok[1] == '-') {
                eq = indexOf(tok, '=');
            }
            int idx;
            if (eq > 0) {
                char* nm = substr(tok, 0, eq);
                idx = indexOfName(nm);
            } else {
                idx = indexOfName(tok);
            }
            if (idx < 0 && tok[1] != '-' && strlen(tok) > 2) {
                // several short flags in one word: -vc is -v -c
                for (int k = 1; tok[k] != 0; k++) {
                    char one[3];
                    one[0] = '-';
                    one[1] = tok[k];
                    one[2] = 0;
                    int j = indexOfName(one);
                    if (j < 0 || takesValue[j] != 0) {
                        return fail("unknown option", tok);
                    }
                    seen[j] = 1;
                }
                continue;
            }
            if (idx < 0) {
                return fail("unknown option", tok);
            }
            seen[idx] = 1;
            if (takesValue[idx] == 0) {
                if (eq > 0) {
                    return fail("option takes no value:", tok);
                }
                continue;
            }
            if (eq > 0) {
                values[idx] = &tok[eq + 1];
            } else {
                if (i + 1 >= argc) {
                    return fail("option needs a value:", tok);
                }
                i++;
                values[idx] = argv[i];
            }
        }
        return true;
    }

    // was the flag (or option) given on the command line?
    public bool flag(char* name) {
        int idx = indexOfName(name);
        return idx >= 0 && seen[idx] != 0;
    }

    // value of an option, or its default
    public char* option(char* name) {
        int idx = indexOfName(name);
        if (idx < 0) {
            return null;
        }
        return values[idx];
    }

    // option value as a number (the default when the text is not a number)
    public int optionInt(char* name, int fallback) {
        char* v = option(name);
        int n;
        if (v != null && parseInt(v, &n)) {
            return n;
        }
        return fallback;
    }

    public int positionalCount() { return nrest; }

    public char* positional(int i) {
        if (i < 0 || i >= nrest) {
            return null;
        }
        return rest[i];
    }

    public void printHelp() {
        printf("Usage: %s [options] [arguments]\n", (int)prog, 0, 0, 0);
        if (about != null) {
            printf("%s\n", (int)about, 0, 0, 0);
        }
        println("\nOptions:");
        for (int i = 0; i < count; i++) {
            char label[80];
            if (takesValue[i] != 0) {
                format(&label[0], 80, "%s <value>", (int)specs[i], 0, 0, 0);
            } else {
                format(&label[0], 80, "%s", (int)specs[i], 0, 0, 0);
            }
            printf("  %-28s %s", (int)label, (int)helps[i], 0, 0);
            if (takesValue[i] != 0 && defaults[i] != null && defaults[i][0] != 0) {
                printf(" (default: %s)", (int)defaults[i], 0, 0, 0);
            }
            println("");
        }
        printf("  %-28s %s\n", (int)"-h,--help", (int)"show this help", 0, 0);
    }
}
