// =============================================================================
//  csv - comma separated values (RFC 4180 style quoting)     import csv;
// =============================================================================
module csv;

// Splits one line into fields (new heap strings, at most max). A field may be quoted
// with "..." and contain the separator or "" for a quote. Returns the field count.
public int parseLine(char* line, int sep, char** out, int max) {
    int n = 0;
    int i = 0;
    char* buf = alloc(strlen(line) + 1);
    for (;;) {
        int o = 0;
        if (line[i] == '"') {
            i++;
            for (;;) {
                if (line[i] == 0) {
                    break;
                }
                if (line[i] == '"') {
                    if (line[i + 1] == '"') {
                        buf[o] = '"';
                        o++;
                        i = i + 2;
                        continue;
                    }
                    i++;
                    break;
                }
                buf[o] = line[i];
                o++;
                i++;
            }
            // text after the closing quote up to the separator is kept as it is
            while (line[i] != sep && line[i] != 0) {
                buf[o] = line[i];
                o++;
                i++;
            }
        } else {
            while (line[i] != sep && line[i] != 0) {
                buf[o] = line[i];
                o++;
                i++;
            }
        }
        if (n < max) {
            out[n] = substr(buf, 0, o);
            n++;
        }
        if (line[i] == 0) {
            break;
        }
        i++;                      // skip the separator
    }
    return n;
}

// the field in quotes when it needs them (separator, quote, line break), otherwise unchanged
public char* quote(char* field, int sep) {
    bool need = false;
    for (int i = 0; field[i] != 0; i++) {
        if (field[i] == sep || field[i] == '"' || field[i] == 10 || field[i] == 13) {
            need = true;
        }
    }
    if (!need) {
        return strdup(field);
    }
    char* out = alloc(strlen(field) * 2 + 3);
    int o = 0;
    out[o] = '"';
    o++;
    for (int i = 0; field[i] != 0; i++) {
        if (field[i] == '"') {
            out[o] = '"';
            o++;
        }
        out[o] = field[i];
        o++;
    }
    out[o] = '"';
    return out;
}

// builds one line from n fields
public char* joinLine(char** fields, int n, int sep) {
    int total = 1;
    char* q[64];
    if (n > 64) {
        n = 64;
    }
    for (int i = 0; i < n; i++) {
        q[i] = quote(fields[i], sep);
        total = total + strlen(q[i]) + 1;
    }
    char* out = alloc(total);
    int o = 0;
    for (int i = 0; i < n; i++) {
        if (i > 0) {
            out[o] = sep;
            o++;
        }
        int l = strlen(q[i]);
        memcpy(&out[o], q[i], l);
        o = o + l;
    }
    return out;
}
