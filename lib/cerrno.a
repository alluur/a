// =============================================================================
//  cerrno - C <errno.h> and strerror                          import cerrno;
//
//  `errno` is a global variable. The functions of the C modules (cstdio, cstdlib, cunistd ...) set it
//  when they fail, using the Linux error numbers on every platform.
// =============================================================================

int errno;

const EPERM = 1;
const ENOENT = 2;
const ESRCH = 3;
const EINTR = 4;
const EIO = 5;
const ENXIO = 6;
const E2BIG = 7;
const ENOEXEC = 8;
const EBADF = 9;
const ECHILD = 10;
const EAGAIN = 11;
const ENOMEM = 12;
const EACCES = 13;
const EFAULT = 14;
const EBUSY = 16;
const EEXIST = 17;
const EXDEV = 18;
const ENODEV = 19;
const ENOTDIR = 20;
const EISDIR = 21;
const EINVAL = 22;
const ENFILE = 23;
const EMFILE = 24;
const ENOTTY = 25;
const EFBIG = 27;
const ENOSPC = 28;
const ESPIPE = 29;
const EROFS = 30;
const EMLINK = 31;
const EPIPE = 32;
const EDOM = 33;
const ERANGE = 34;
const ENAMETOOLONG = 36;
const ENOSYS = 38;
const ENOTEMPTY = 39;
const EILSEQ = 84;
const ECONNREFUSED = 111;
const EWOULDBLOCK = 11;

// message text for an error number, like C's strerror
char* strerror(int e) {
    if (e == 0) { return "Success"; }
    if (e == EPERM) { return "Operation not permitted"; }
    if (e == ENOENT) { return "No such file or directory"; }
    if (e == ESRCH) { return "No such process"; }
    if (e == EINTR) { return "Interrupted system call"; }
    if (e == EIO) { return "Input/output error"; }
    if (e == ENXIO) { return "No such device or address"; }
    if (e == E2BIG) { return "Argument list too long"; }
    if (e == ENOEXEC) { return "Exec format error"; }
    if (e == EBADF) { return "Bad file descriptor"; }
    if (e == ECHILD) { return "No child processes"; }
    if (e == EAGAIN) { return "Resource temporarily unavailable"; }
    if (e == ENOMEM) { return "Cannot allocate memory"; }
    if (e == EACCES) { return "Permission denied"; }
    if (e == EFAULT) { return "Bad address"; }
    if (e == EBUSY) { return "Device or resource busy"; }
    if (e == EEXIST) { return "File exists"; }
    if (e == EXDEV) { return "Invalid cross-device link"; }
    if (e == ENODEV) { return "No such device"; }
    if (e == ENOTDIR) { return "Not a directory"; }
    if (e == EISDIR) { return "Is a directory"; }
    if (e == EINVAL) { return "Invalid argument"; }
    if (e == ENFILE) { return "Too many open files in system"; }
    if (e == EMFILE) { return "Too many open files"; }
    if (e == ENOTTY) { return "Inappropriate ioctl for device"; }
    if (e == EFBIG) { return "File too large"; }
    if (e == ENOSPC) { return "No space left on device"; }
    if (e == ESPIPE) { return "Illegal seek"; }
    if (e == EROFS) { return "Read-only file system"; }
    if (e == EMLINK) { return "Too many links"; }
    if (e == EPIPE) { return "Broken pipe"; }
    if (e == EDOM) { return "Numerical argument out of domain"; }
    if (e == ERANGE) { return "Numerical result out of range"; }
    if (e == ENAMETOOLONG) { return "File name too long"; }
    if (e == ENOSYS) { return "Function not implemented"; }
    if (e == ENOTEMPTY) { return "Directory not empty"; }
    if (e == EILSEQ) { return "Invalid or incomplete multibyte or wide character"; }
    if (e == ECONNREFUSED) { return "Connection refused"; }
    return "Unknown error";
}

// prints "prefix: message" for the current errno on standard error (C's perror)
void perror(char* prefix) {
    if (prefix != null && prefix[0] != 0) {
        eprint(prefix);
        eprint(": ");
    }
    eprintln(strerror(errno));
}
