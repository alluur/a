// =============================================================================
//  path - file name manipulation (works on text only)        import path;
//  Both '/' and '\' count as separators; results use '/', which Windows accepts too.
// =============================================================================
module path;

private bool isSep(int c) {
    return c == '/' || c == 92;
}

// index of the last separator, -1 if there is none
private int lastSep(char* p) {
    int r = -1;
    for (int i = 0; p[i] != 0; i++) {
        if (isSep(p[i])) {
            r = i;
        }
    }
    return r;
}

// "C:\dir", "C:/dir" or "/dir"
public bool isAbsolute(char* p) {
    if (isSep(p[0])) {
        return true;
    }
    return isAlpha(p[0]) && p[1] == ':' && isSep(p[2]);
}

// joins two parts with exactly one separator; an absolute second part wins
public char* join(char* a, char* b) {
    if (a[0] == 0 || isAbsolute(b)) {
        return strdup(b);
    }
    if (b[0] == 0) {
        return strdup(a);
    }
    int n = strlen(a);
    int m = strlen(b);
    bool sep = isSep(a[n - 1]);
    char* out = alloc(n + m + 2);
    memcpy(out, a, n);
    int o = n;
    if (!sep) {
        out[o] = '/';
        o++;
    }
    int skip = 0;
    while (isSep(b[skip])) {
        skip++;
    }
    memcpy(&out[o], &b[skip], m - skip);
    return out;
}

// the last component: "a/b/c.txt" -> "c.txt"
public char* basename(char* p) {
    int n = strlen(p);
    while (n > 1 && isSep(p[n - 1])) {
        n--;
    }
    int start = 0;
    for (int i = 0; i < n; i++) {
        if (isSep(p[i])) {
            start = i + 1;
        }
    }
    return substr(p, start, n - start);
}

// everything before the last component: "a/b/c.txt" -> "a/b", "c.txt" -> ".", "/c" -> "/"
public char* dirname(char* p) {
    int n = strlen(p);
    while (n > 1 && isSep(p[n - 1])) {
        n--;
    }
    int cut = -1;
    for (int i = 0; i < n; i++) {
        if (isSep(p[i])) {
            cut = i;
        }
    }
    if (cut < 0) {
        return strdup(".");
    }
    if (cut == 0) {
        return strdup("/");
    }
    return substr(p, 0, cut);
}

// ".txt" for "a/b/c.txt", "" when there is no extension (a leading dot does not count)
public char* extension(char* p) {
    char* b = basename(p);
    int dot = -1;
    for (int i = 1; b[i] != 0; i++) {
        if (b[i] == '.') {
            dot = i;
        }
    }
    if (dot < 0) {
        return strdup("");
    }
    return strdup(&b[dot]);
}

// the file name without its extension: "a/b/c.tar.gz" -> "c.tar"
public char* stem(char* p) {
    char* b = basename(p);
    char* e = extension(b);
    return substr(b, 0, strlen(b) - strlen(e));
}

// replaces (or adds) the extension; ext includes the dot, e.g. ".bak"
public char* withExtension(char* p, char* ext) {
    char* e = extension(p);
    int keep = strlen(p) - strlen(e);
    char* out = alloc(keep + strlen(ext) + 1);
    memcpy(out, p, keep);
    memcpy(&out[keep], ext, strlen(ext));
    return out;
}

// removes "." and "x/.." components and doubled separators: "a//b/./c/../d" -> "a/b/d"
public char* normalize(char* p) {
    int n = strlen(p);
    char* out = alloc(n + 2);
    bool abs = isSep(p[0]);
    // stack of component start offsets inside out
    int starts[128];
    int depth = 0;
    int o = 0;
    if (abs) {
        out[0] = '/';
        o = 1;
    }
    int i = 0;
    while (i < n) {
        while (i < n && isSep(p[i])) {
            i++;
        }
        int s = i;
        while (i < n && !isSep(p[i])) {
            i++;
        }
        int len = i - s;
        if (len == 0 || (len == 1 && p[s] == '.')) {
            continue;
        }
        if (len == 2 && p[s] == '.' && p[s + 1] == '.') {
            if (depth > 0 && !(depth > 0 && out[starts[depth - 1]] == '.' && out[starts[depth - 1] + 1] == '.')) {
                depth--;
                o = starts[depth];
                if (o > 0 && out[o - 1] == '/' && (o > 1 || !abs)) {
                    o--;
                }
                continue;
            }
            if (abs) {
                continue;
            }
        }
        if (depth > 0 && o > 0 && out[o - 1] != '/') {
            out[o] = '/';
            o++;
        }
        if (depth < 128) {
            starts[depth] = o;
            depth++;
        }
        memcpy(&out[o], &p[s], len);
        o = o + len;
    }
    if (o == 0) {
        return strdup(".");
    }
    out[o] = 0;
    return out;
}
