// =============================================================================
//  algo - algorithms on arrays, sequences and graphs                                                           import algo;
//
//  Arrays (int* and n elements; a "comparator" is a function  int cmp(int a, int b)  that returns <0, 0 or >0):
//    algo.sortBy(a, n, cmp)            stable merge sort with your own order        algo.sortDesc(a, n)
//    algo.lowerBound(a, n, key)        first index whose element is >= key (n if none; a must be sorted)
//    algo.upperBound(a, n, key)        first index whose element is > key           algo.countEqual(a, n, key)
//    algo.unique(a, n)                 drops repeated neighbours of a sorted array, returns the new length
//    algo.rotate(a, n, k)              moves every element k places to the left     algo.reverse(a, n)
//    algo.nextPermutation(a, n)        the next arrangement in lexicographic order (false after the last: then a is sorted again)
//    algo.kthSmallest(a, n, k)         the element that would be at index k (0 based) after sorting; a is rearranged
//    algo.partition(a, n, pivot)       elements < pivot first; returns how many there are
//    algo.maxSubarray(a, n)            largest sum of consecutive elements (Kadane)
//    algo.lis(a, n)                    length of the longest strictly increasing subsequence
//    algo.indexOfMax(a, n)  indexOfMin(a, n)    algo.sum(a, n)    algo.fill(a, n, v)    algo.iota(a, n, start)
//  Strings:
//    algo.editDistance(a, b)           Levenshtein distance                          algo.lcsLength(a, b)   longest common subsequence
//    algo.kmpFind(text, pattern)       index of the first occurrence or -1 (linear time)    algo.countOccurrences(text, pattern)
//    algo.isSubsequence(small, big)
//  Number sequences:
//    algo.sieve(limit, flags)          flags[i] = 1 for primes; returns how many       algo.knapsack(weights, values, n, capacity)
//  Union-find:       algo.UnionFind* u = new algo.UnionFind(n);  u->unite(a, b);  u->same(a, b);  u->find(a);  u->groups
//  Graphs:           algo.Graph* g = new algo.Graph(n);  g->edge(from, to, weight);  g->undirected(a, b, w);
//                    g->bfs(start, order)  g->dfs(start, order)  (fill order[], return how many nodes)   g->dijkstra(start, dist)
//                    g->topological(order) (false if there is a cycle)    g->components()    g->hasPath(a, b)
// =============================================================================
import cstdlib;
import cstring;
module algo;

// ---- arrays -------------------------------------------------------------------------------------------------------------------------------
private void mergeRuns(int* a, int* tmp, int lo, int mid, int hi, func cmp) {
    int i = lo;
    int j = mid;
    int k = lo;
    while (i < mid && j < hi) {
        if (cmp(a[j], a[i]) < 0) {
            tmp[k] = a[j];
            j++;
        } else {
            tmp[k] = a[i];
            i++;
        }
        k++;
    }
    while (i < mid) { tmp[k] = a[i]; i++; k++; }
    while (j < hi) { tmp[k] = a[j]; j++; k++; }
    for (int x = lo; x < hi; x++) { a[x] = tmp[x]; }
}

public void sortBy(int* a, int n, func cmp) {
    if (n < 2) { return; }
    int* tmp = malloc(n * 8);
    for (int width = 1; width < n; width = width * 2) {
        for (int lo = 0; lo < n; lo = lo + 2 * width) {
            int mid = lo + width;
            if (mid > n) { mid = n; }
            int hi = lo + 2 * width;
            if (hi > n) { hi = n; }
            mergeRuns(a, tmp, lo, mid, hi, cmp);
        }
    }
    free(tmp);
}

private int descending(int x, int y) {
    return y <=> x;
}

public void sortDesc(int* a, int n) {
    sortBy(a, n, descending);
}

public void reverse(int* a, int n) {
    for (int i = 0; i < n / 2; i++) {
        int t = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = t;
    }
}

public int lowerBound(int* a, int n, int key) {
    int lo = 0;
    int hi = n;
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        if (a[mid] < key) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

public int upperBound(int* a, int n, int key) {
    int lo = 0;
    int hi = n;
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        if (a[mid] <= key) { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}

public int countEqual(int* a, int n, int key) {
    return upperBound(a, n, key) - lowerBound(a, n, key);
}

public int unique(int* a, int n) {
    if (n < 2) { return n; }
    int w = 1;
    for (int i = 1; i < n; i++) {
        if (a[i] != a[w - 1]) {
            a[w] = a[i];
            w++;
        }
    }
    return w;
}

public void rotate(int* a, int n, int k) {
    if (n < 2) { return; }
    k = k % n;
    if (k < 0) { k = k + n; }
    if (k == 0) { return; }
    reverse(a, k);
    reverse(&a[k], n - k);
    reverse(a, n);
}

public bool nextPermutation(int* a, int n) {
    int i = n - 2;
    while (i >= 0 && a[i] >= a[i + 1]) { i--; }
    if (i < 0) {
        reverse(a, n);
        return false;
    }
    int j = n - 1;
    while (a[j] <= a[i]) { j--; }
    int t = a[i]; a[i] = a[j]; a[j] = t;
    reverse(&a[i + 1], n - i - 1);
    return true;
}

public int partition(int* a, int n, int pivot) {
    int w = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] < pivot) {
            int t = a[i]; a[i] = a[w]; a[w] = t;
            w++;
        }
    }
    return w;
}

// quickselect: the element that sorted order would put at index k
public int kthSmallest(int* a, int n, int k) {
    int lo = 0;
    int hi = n - 1;
    while (lo < hi) {
        int pivot = a[lo + (hi - lo) / 2];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (a[i] < pivot) { i++; }
            while (a[j] > pivot) { j--; }
            if (i <= j) {
                int t = a[i]; a[i] = a[j]; a[j] = t;
                i++;
                j--;
            }
        }
        if (k <= j) { hi = j; }
        else if (k >= i) { lo = i; }
        else { return a[k]; }
    }
    return a[k];
}

public int maxSubarray(int* a, int n) {
    if (n <= 0) { return 0; }
    int best = a[0];
    int cur = a[0];
    for (int i = 1; i < n; i++) {
        cur = (cur > 0) ? cur + a[i] : a[i];
        if (cur > best) { best = cur; }
    }
    return best;
}

public int lis(int* a, int n) {
    if (n == 0) { return 0; }
    int* tails = malloc(n * 8);
    int len = 0;
    for (int i = 0; i < n; i++) {
        int pos = lowerBound(tails, len, a[i]);
        tails[pos] = a[i];
        if (pos == len) { len++; }
    }
    free(tails);
    return len;
}

public int indexOfMax(int* a, int n) {
    int best = 0;
    for (int i = 1; i < n; i++) { if (a[i] > a[best]) { best = i; } }
    return best;
}

public int indexOfMin(int* a, int n) {
    int best = 0;
    for (int i = 1; i < n; i++) { if (a[i] < a[best]) { best = i; } }
    return best;
}

public int sum(int* a, int n) {
    int s = 0;
    for (int i = 0; i < n; i++) { s = s + a[i]; }
    return s;
}

public void fill(int* a, int n, int v) {
    for (int i = 0; i < n; i++) { a[i] = v; }
}

public void iota(int* a, int n, int start) {
    for (int i = 0; i < n; i++) { a[i] = start + i; }
}

// ---- strings -------------------------------------------------------------------------------------------------------------------------------
public int editDistance(char* a, char* b) {
    int la = strlen(a);
    int lb = strlen(b);
    int* prev = malloc((lb + 1) * 8);
    int* cur = malloc((lb + 1) * 8);
    for (int j = 0; j <= lb; j++) { prev[j] = j; }
    for (int i = 1; i <= la; i++) {
        cur[0] = i;
        for (int j = 1; j <= lb; j++) {
            int cost = (a[i - 1] == b[j - 1]) ? 0 : 1;
            int best = prev[j - 1] + cost;
            if (prev[j] + 1 < best) { best = prev[j] + 1; }
            if (cur[j - 1] + 1 < best) { best = cur[j - 1] + 1; }
            cur[j] = best;
        }
        int* t = prev; prev = cur; cur = t;
    }
    int r = prev[lb];
    free(prev);
    free(cur);
    return r;
}

public int lcsLength(char* a, char* b) {
    int la = strlen(a);
    int lb = strlen(b);
    int* prev = malloc((lb + 1) * 8);
    int* cur = malloc((lb + 1) * 8);
    for (int j = 0; j <= lb; j++) { prev[j] = 0; }
    for (int i = 1; i <= la; i++) {
        cur[0] = 0;
        for (int j = 1; j <= lb; j++) {
            if (a[i - 1] == b[j - 1]) {
                cur[j] = prev[j - 1] + 1;
            } else {
                cur[j] = (prev[j] > cur[j - 1]) ? prev[j] : cur[j - 1];
            }
        }
        int* t = prev; prev = cur; cur = t;
    }
    int r = prev[lb];
    free(prev);
    free(cur);
    return r;
}

// Knuth-Morris-Pratt: index of the first occurrence of pattern in text, or -1
public int kmpFind(char* text, char* pattern) {
    int m = strlen(pattern);
    int n = strlen(text);
    if (m == 0) { return 0; }
    int* fail = malloc(m * 8);
    fail[0] = 0;
    int k = 0;
    for (int i = 1; i < m; i++) {
        while (k > 0 && pattern[i] != pattern[k]) { k = fail[k - 1]; }
        if (pattern[i] == pattern[k]) { k++; }
        fail[i] = k;
    }
    k = 0;
    for (int i = 0; i < n; i++) {
        while (k > 0 && text[i] != pattern[k]) { k = fail[k - 1]; }
        if (text[i] == pattern[k]) { k++; }
        if (k == m) {
            free(fail);
            return i - m + 1;
        }
    }
    free(fail);
    return -1;
}

// how many times pattern occurs in text (overlapping occurrences count)
public int countOccurrences(char* text, char* pattern) {
    int m = strlen(pattern);
    if (m == 0) { return 0; }
    int count = 0;
    int from = 0;
    for (;;) {
        int at = kmpFind(&text[from], pattern);
        if (at < 0) { return count; }
        count++;
        from = from + at + 1;
    }
}

public bool isSubsequence(char* small, char* big) {
    int i = 0;
    for (int j = 0; big[j] != 0 && small[i] != 0; j++) {
        if (small[i] == big[j]) { i++; }
    }
    return small[i] == 0;
}

// ---- number sequences -------------------------------------------------------------------------------------------------------------------
// Sieve of Eratosthenes: flags needs limit + 1 bytes; flags[i] becomes 1 for every prime i <= limit. Returns the number of primes.
public int sieve(int limit, char* flags) {
    if (limit < 2) {
        for (int i = 0; i <= limit; i++) { flags[i] = 0; }
        return 0;
    }
    for (int i = 0; i <= limit; i++) { flags[i] = 1; }
    flags[0] = 0;
    flags[1] = 0;
    for (int i = 2; i * i <= limit; i++) {
        if (flags[i] != 0) {
            for (int j = i * i; j <= limit; j = j + i) { flags[j] = 0; }
        }
    }
    int count = 0;
    for (int i = 0; i <= limit; i++) { count = count + flags[i]; }
    return count;
}

// 0/1 knapsack: the best total value of items (weights[i], values[i]) that fit into capacity
public int knapsack(int* weights, int* values, int n, int capacity) {
    int* best = malloc((capacity + 1) * 8);
    for (int c = 0; c <= capacity; c++) { best[c] = 0; }
    for (int i = 0; i < n; i++) {
        for (int c = capacity; c >= weights[i]; c--) {
            int with = best[c - weights[i]] + values[i];
            if (with > best[c]) { best[c] = with; }
        }
    }
    int r = best[capacity];
    free(best);
    return r;
}

// ---- union-find ----------------------------------------------------------------------------------------------------------------------------
public class UnionFind {
    public int* parent;
    public int* rank;
    public int n;
    public int groups;

    public UnionFind(int count) {
        n = count;
        groups = count;
        parent = malloc(count * 8 + 8);
        rank = malloc(count * 8 + 8);
        for (int i = 0; i < count; i++) {
            parent[i] = i;
            rank[i] = 0;
        }
    }

    public int find(int x) {
        while (parent[x] != x) {
            parent[x] = parent[parent[x]];
            x = parent[x];
        }
        return x;
    }

    // joins the two groups; false when they already were one
    public bool unite(int a, int b) {
        int ra = find(a);
        int rb = find(b);
        if (ra == rb) { return false; }
        if (rank[ra] < rank[rb]) { int t = ra; ra = rb; rb = t; }
        parent[rb] = ra;
        if (rank[ra] == rank[rb]) { rank[ra]++; }
        groups--;
        return true;
    }

    public bool same(int a, int b) {
        return find(a) == find(b);
    }
}

// ---- graphs --------------------------------------------------------------------------------------------------------------------------------
public class Graph {
    public int n;
    public int edges;
    private int* head;          // first edge of every node
    private int* tail;          // last edge of every node (so that the edges of a node stay in the order they were added)
    private int* next;
    private int* to;
    private int* weight;
    private int cap;

    public Graph(int nodes) {
        n = nodes;
        edges = 0;
        cap = 16;
        head = malloc(nodes * 8 + 8);
        tail = malloc(nodes * 8 + 8);
        for (int i = 0; i < nodes; i++) { head[i] = -1; tail[i] = -1; }
        next = malloc(cap * 8);
        to = malloc(cap * 8);
        weight = malloc(cap * 8);
    }

    // a directed edge
    public void edge(int from, int dest, int w) {
        if (edges == cap) {
            cap = cap * 2;
            next = realloc(next, cap * 8);
            to = realloc(to, cap * 8);
            weight = realloc(weight, cap * 8);
        }
        to[edges] = dest;
        weight[edges] = w;
        next[edges] = -1;
        if (head[from] < 0) { head[from] = edges; } else { next[tail[from]] = edges; }
        tail[from] = edges;
        edges++;
    }

    public void undirected(int a, int b, int w) {
        edge(a, b, w);
        edge(b, a, w);
    }

    // breadth first order from start into order[]; returns how many nodes were reached
    public int bfs(int start, int* order) {
        char* seen = malloc(n + 1);
        memset(seen, 0, n + 1);
        int qh = 0;
        int qt = 0;
        order[qt] = start;
        qt++;
        seen[start] = 1;
        while (qh < qt) {
            int u = order[qh];
            qh++;
            int e = head[u];
            while (e >= 0) {
                int v = to[e];
                if (seen[v] == 0) {
                    seen[v] = 1;
                    order[qt] = v;
                    qt++;
                }
                e = next[e];
            }
        }
        free(seen);
        return qt;
    }

    private void visit(int u, char* seen, int* order, int* count) {
        seen[u] = 1;
        order[*count] = u;
        *count = *count + 1;
        int e = head[u];
        while (e >= 0) {
            if (seen[to[e]] == 0) { visit(to[e], seen, order, count); }
            e = next[e];
        }
    }

    // depth first (pre-order) from start; neighbours are visited in the order the edges were added
    public int dfs(int start, int* order) {
        char* seen = malloc(n + 1);
        memset(seen, 0, n + 1);
        int count = 0;
        visit(start, seen, order, &count);
        free(seen);
        return count;
    }

    // shortest distances from start (non-negative weights) into dist[n]; unreachable nodes get -1
    public void dijkstra(int start, int* dist) {
        char* done = malloc(n + 1);
        memset(done, 0, n + 1);
        for (int i = 0; i < n; i++) { dist[i] = -1; }
        dist[start] = 0;
        for (int round = 0; round < n; round++) {
            int u = -1;
            for (int i = 0; i < n; i++) {
                if (done[i] == 0 && dist[i] >= 0 && (u < 0 || dist[i] < dist[u])) { u = i; }
            }
            if (u < 0) { break; }
            done[u] = 1;
            int e = head[u];
            while (e >= 0) {
                int nd = dist[u] + weight[e];
                if (dist[to[e]] < 0 || nd < dist[to[e]]) { dist[to[e]] = nd; }
                e = next[e];
            }
        }
        free(done);
    }

    // Kahn's algorithm: a topological order of all nodes, false if the graph has a cycle
    public bool topological(int* order) {
        int* indeg = malloc(n * 8 + 8);
        for (int i = 0; i < n; i++) { indeg[i] = 0; }
        for (int e = 0; e < edges; e++) { indeg[to[e]]++; }
        int qh = 0;
        int qt = 0;
        for (int i = 0; i < n; i++) {
            if (indeg[i] == 0) { order[qt] = i; qt++; }
        }
        while (qh < qt) {
            int u = order[qh];
            qh++;
            int e = head[u];
            while (e >= 0) {
                indeg[to[e]]--;
                if (indeg[to[e]] == 0) { order[qt] = to[e]; qt++; }
                e = next[e];
            }
        }
        free(indeg);
        return qt == n;
    }

    // number of connected components (edges are followed in both directions)
    public int components() {
        UnionFind* u = new UnionFind(n);
        for (int a = 0; a < n; a++) {
            int e = head[a];
            while (e >= 0) {
                u->unite(a, to[e]);
                e = next[e];
            }
        }
        return u->groups;
    }

    public bool hasPath(int a, int b) {
        int* order = malloc(n * 8 + 8);
        int count = dfs(a, order);
        bool found = false;
        for (int i = 0; i < count; i++) {
            if (order[i] == b) { found = true; }
        }
        free(order);
        return found;
    }
}
