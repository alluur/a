// =============================================================================
//  json - parse and write JSON                                 import json;
//
//    json.Json* doc = json.parse("{\"name\":\"A\",\"tags\":[1,2,3]}");
//    if (doc == null) println(json.errorMessage());
//    println(doc->get("name")->asString());          // A
//    json.Json* tags = doc->get("tags");
//    for (int i = 0; i < tags->size(); i++) printlnInt(tags->at(i)->asInt());
//
//    json.Json* o = json.newObject();
//    o->set("id", json.newInt(7));  o->set("ok", json.newBool(true));
//    println(json.stringify(o));                     // {"id":7,"ok":true}
//    println(json.pretty(o));                        // indented, two spaces
//
//  Numbers: whole numbers are exact ints. Numbers with a fraction or exponent keep their
//  original text (stringify writes it back unchanged) and asInt() truncates them.
//  Strings are UTF-8; \uXXXX escapes (also surrogate pairs) are decoded.
//
//  Memory: values (and the texts that stringify and pretty return) live on the malloc heap, so a long running program can give them back:
//    doc->dispose();           frees the value and everything below it (a value must belong to one parent only; do not assign string literals to .text)
//    free(text);               for the result of stringify / pretty / the strings of asString (cstdlib)
//  A program that never frees them behaves as before.
// =============================================================================
module json;
import utf8;
import cstdlib;

const NULL_KIND = 0;
const BOOL_KIND = 1;
const NUMBER_KIND = 2;
const STRING_KIND = 3;
const ARRAY_KIND = 4;
const OBJECT_KIND = 5;

public class Json {
    public int kind;
    public int num;                // booleans: 0 or 1; numbers: the integer value
    public char* text;             // strings: the contents; numbers: the original text
    private Json** items;
    private char** keys;           // objects only
    private int count;
    private int cap;

    // removes a member of an object WITHOUT freeing it and returns it (null if there is none): the caller owns the value now
    public Json* detach(char* key) {
        int i = indexOfKey(key);
        if (i < 0) return null;
        Json* v = items[i];
        free(keys[i]);
        for (int k = i; k + 1 < count; k++) {
            items[k] = items[k + 1];
            keys[k] = keys[k + 1];
        }
        count--;
        return v;
    }

    // frees this value, its members, their names and texts (and the value itself)
    public void dispose() {
        for (int i = 0; i < count; i++) {
            items[i]->dispose();
            if (keys != null && keys[i] != null) free(keys[i]);
        }
        if (items != null) free(items);
        if (keys != null) free(keys);
        if (text != null) free(text);
        free(this);
    }

    public bool isNull() { return kind == NULL_KIND; }
    public bool isBool() { return kind == BOOL_KIND; }
    public bool isNumber() { return kind == NUMBER_KIND; }
    public bool isString() { return kind == STRING_KIND; }
    public bool isArray() { return kind == ARRAY_KIND; }
    public bool isObject() { return kind == OBJECT_KIND; }

    public int asInt() {
        if (kind == NUMBER_KIND || kind == BOOL_KIND) {
            return num;
        }
        return 0;
    }

    public bool asBool() {
        if (kind == BOOL_KIND || kind == NUMBER_KIND) {
            return num != 0;
        }
        return kind != NULL_KIND;
    }

    // the text of a string value ("" for other kinds)
    public char* asString() {
        if (kind == STRING_KIND) {
            return text;
        }
        return "";
    }

    // number of elements (arrays) or members (objects)
    public int size() { return count; }

    // element i of an array, or the value of member i of an object; null when out of range
    public Json* at(int i) {
        if (i < 0 || i >= count) {
            return null;
        }
        return items[i];
    }

    // name of member i of an object
    public char* keyAt(int i) {
        if (kind != OBJECT_KIND || i < 0 || i >= count) {
            return null;
        }
        return keys[i];
    }

    private int indexOfKey(char* key) {
        if (kind != OBJECT_KIND) {
            return -1;
        }
        for (int i = 0; i < count; i++) {
            if (streq(keys[i], key)) {
                return i;
            }
        }
        return -1;
    }

    // member of an object, null if missing (or if this is not an object)
    public Json* get(char* key) {
        int i = indexOfKey(key);
        if (i < 0) {
            return null;
        }
        return items[i];
    }

    public bool has(char* key) { return indexOfKey(key) >= 0; }

    public int intOr(char* key, int fallback) {
        Json* v = get(key);
        if (v == null || v->kind != NUMBER_KIND) {
            return fallback;
        }
        return v->num;
    }

    public char* stringOr(char* key, char* fallback) {
        Json* v = get(key);
        if (v == null || v->kind != STRING_KIND) {
            return fallback;
        }
        return v->text;
    }

    public bool boolOr(char* key, bool fallback) {
        Json* v = get(key);
        if (v == null || v->kind != BOOL_KIND) {
            return fallback;
        }
        return v->num != 0;
    }

    private void grow() {
        int ncap = 8;
        if (cap > 0) {
            ncap = cap * 2;
        }
        Json** ni = (Json**) malloc(ncap * 8);
        char** nk = (char**) malloc(ncap * 8);
        for (int i = 0; i < count; i++) {
            ni[i] = items[i];
            nk[i] = keys[i];
        }
        if (items != null) free(items);
        if (keys != null) free(keys);
        items = ni;
        keys = nk;
        cap = ncap;
    }

    // appends to an array
    public void push(Json* v) {
        if (kind != ARRAY_KIND) {
            return;
        }
        if (count == cap) {
            grow();
        }
        items[count] = v;
        count++;
    }

    // sets (or replaces) a member of an object; the key text is copied
    public void set(char* key, Json* v) {
        if (kind != OBJECT_KIND) {
            return;
        }
        int i = indexOfKey(key);
        if (i >= 0) {
            if (items[i] != v) items[i]->dispose();
            items[i] = v;
            return;
        }
        if (count == cap) {
            grow();
        }
        items[count] = v;
        keys[count] = dupText(key);
        count++;
    }
}

private char* dupText(char* s) {
    int n = strlen(s);
    char* r = malloc(n + 1);
    memcpy(r, s, n);
    r[n] = 0;
    return r;
}

private Json* mk(int kind) {
    Json* j = (Json*) malloc(sizeof(Json));
    j->kind = kind;
    return j;
}

public Json* newNull() {
    return mk(NULL_KIND);
}

public Json* newBool(bool b) {
    Json* j = mk(BOOL_KIND);
    if (b) {
        j->num = 1;
    }
    return j;
}

public Json* newInt(int n) {
    Json* j = mk(NUMBER_KIND);
    j->num = n;
    return j;
}

// the text is copied
public Json* newString(char* s) {
    Json* j = mk(STRING_KIND);
    j->text = dupText(s);
    return j;
}

public Json* newArray() {
    return mk(ARRAY_KIND);
}

public Json* newObject() {
    return mk(OBJECT_KIND);
}

// a growing text buffer (malloc heap)
private class Out {
    public char* buf;
    public int len;
    public int cap;

    public void reserve(int extra) {
        if (len + extra + 1 <= cap) return;
        int nc = cap * 2;
        if (nc < 64) nc = 64;
        while (nc < len + extra + 1) nc = nc * 2;
        char* nb = realloc(buf, nc);
        buf = nb;
        cap = nc;
    }
    public void append(char* s) {
        int n = strlen(s);
        reserve(n);
        memcpy(&buf[len], s, n);
        len = len + n;
        buf[len] = 0;
    }
    public void appendChar(int c) {
        reserve(1);
        buf[len] = c;
        len++;
        buf[len] = 0;
    }
    public void appendInt(int n) {
        char tmp[24];
        intToStr(n, &tmp[0]);
        append(&tmp[0]);
    }
    // the text (a malloc'ed string; "" if nothing was added)
    public char* toString() {
        if (buf == null) {
            reserve(1);
            buf[0] = 0;
        }
        return buf;
    }
}

// ---- parser ---------------------------------------------------------------------------------
private char* src;
private int pos;
private char* err;

public char* errorMessage() {
    if (err == null) {
        return "";
    }
    return err;
}

private Json* fail(char* message) {
    if (err == null) {
        err = message;
    }
    return null;
}

private void skipSpace() {
    while (src[pos] == ' ' || src[pos] == 9 || src[pos] == 10 || src[pos] == 13) {
        pos++;
    }
}

private int hex4() {
    int v = 0;
    for (int i = 0; i < 4; i++) {
        int c = src[pos + i];
        int d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return -1;
        v = v * 16 + d;
    }
    pos = pos + 4;
    return v;
}

// parses a string literal (current char is the opening quote) into a new heap string, null on error
private char* parseStringText() {
    pos++;
    Out sb;
    for (;;) {
        int c = src[pos];
        if (c == 0) {
            fail("unterminated string");
            if (sb.buf != null) free(sb.buf);
            return null;
        }
        if (c == '"') {
            pos++;
            return sb.toString();
        }
        if (c < 32) {
            fail("control character in string");
            if (sb.buf != null) free(sb.buf);
            return null;
        }
        if (c != 92) {
            sb.appendChar(c);
            pos++;
            continue;
        }
        pos++;
        c = src[pos];
        pos++;
        switch (c) {
            case '"': sb.appendChar('"'); break;
            case 92: sb.appendChar(92); break;
            case '/': sb.appendChar('/'); break;
            case 'b': sb.appendChar(8); break;
            case 'f': sb.appendChar(12); break;
            case 'n': sb.appendChar(10); break;
            case 'r': sb.appendChar(13); break;
            case 't': sb.appendChar(9); break;
            case 'u': {
                int cp = hex4();
                if (cp < 0) {
                    fail("bad \\u escape");
                    if (sb.buf != null) free(sb.buf);
                    return null;
                }
                if (cp >= 0xD800 && cp < 0xDC00 && src[pos] == 92 && src[pos + 1] == 'u') {
                    pos = pos + 2;
                    int lo = hex4();
                    if (lo < 0xDC00 || lo > 0xDFFF) {
                        fail("bad surrogate pair");
                        if (sb.buf != null) free(sb.buf);
                        return null;
                    }
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                char enc[8];
                int n = utf8.encode(cp, enc);
                enc[n] = 0;
                sb.append(enc);
                break;
            }
            default:
                fail("bad escape in string");
                if (sb.buf != null) free(sb.buf);
                return null;
        }
    }
    return null;
}

private bool matchWord(char* w) {
    int n = strlen(w);
    for (int i = 0; i < n; i++) {
        if (src[pos + i] != w[i]) {
            return false;
        }
    }
    pos = pos + n;
    return true;
}

private Json* parseNumber() {
    int start = pos;
    bool neg = false;
    if (src[pos] == '-') {
        neg = true;
        pos++;
    }
    if (!isDigit(src[pos])) {
        return fail("bad number");
    }
    int v = 0;
    while (isDigit(src[pos])) {
        v = v * 10 + (src[pos] - '0');
        pos++;
    }
    bool simple = true;
    if (src[pos] == '.') {
        simple = false;
        pos++;
        if (!isDigit(src[pos])) {
            return fail("bad number");
        }
        while (isDigit(src[pos])) {
            pos++;
        }
    }
    if (src[pos] == 'e' || src[pos] == 'E') {
        simple = false;
        pos++;
        if (src[pos] == '+' || src[pos] == '-') {
            pos++;
        }
        if (!isDigit(src[pos])) {
            return fail("bad number");
        }
        while (isDigit(src[pos])) {
            pos++;
        }
    }
    Json* j = mk(NUMBER_KIND);
    if (neg) {
        v = -v;
    }
    j->num = v;
    if (!simple) {
        int tl = pos - start;
        j->text = malloc(tl + 1);
        memcpy(j->text, &src[start], tl);
        j->text[tl] = 0;
    }
    return j;
}

private Json* parseValue(int depth) {
    if (depth > 200) {
        return fail("nested too deeply");
    }
    skipSpace();
    int c = src[pos];
    if (c == '{') {
        pos++;
        Json* o = newObject();
        skipSpace();
        if (src[pos] == '}') {
            pos++;
            return o;
        }
        for (;;) {
            skipSpace();
            if (src[pos] != '"') {
                o->dispose();
                return fail("expected a string key");
            }
            char* key = parseStringText();
            if (key == null) {
                o->dispose();
                return null;
            }
            skipSpace();
            if (src[pos] != ':') {
                free(key);
                o->dispose();
                return fail("expected ':'");
            }
            pos++;
            Json* v = parseValue(depth + 1);
            if (v == null) {
                free(key);
                o->dispose();
                return null;
            }
            o->set(key, v);
            free(key);
            skipSpace();
            if (src[pos] == ',') {
                pos++;
                continue;
            }
            if (src[pos] == '}') {
                pos++;
                return o;
            }
            o->dispose();
            return fail("expected ',' or '}'");
        }
    }
    if (c == '[') {
        pos++;
        Json* a = newArray();
        skipSpace();
        if (src[pos] == ']') {
            pos++;
            return a;
        }
        for (;;) {
            Json* v = parseValue(depth + 1);
            if (v == null) {
                a->dispose();
                return null;
            }
            a->push(v);
            skipSpace();
            if (src[pos] == ',') {
                pos++;
                continue;
            }
            if (src[pos] == ']') {
                pos++;
                return a;
            }
            a->dispose();
            return fail("expected ',' or ']'");
        }
    }
    if (c == '"') {
        char* s = parseStringText();
        if (s == null) {
            return null;
        }
        Json* j = mk(STRING_KIND);
        j->text = s;
        return j;
    }
    if (c == '-' || isDigit(c)) {
        return parseNumber();
    }
    if (matchWord("true")) {
        return newBool(true);
    }
    if (matchWord("false")) {
        return newBool(false);
    }
    if (matchWord("null")) {
        return newNull();
    }
    if (c == 0) {
        return fail("unexpected end of input");
    }
    return fail("unexpected character");
}

// parses a JSON text; returns null on error (see errorMessage)
public Json* parse(char* text) {
    src = text;
    pos = 0;
    err = null;
    Json* v = parseValue(0);
    if (v == null) {
        return null;
    }
    skipSpace();
    if (src[pos] != 0) {
        v->dispose();
        return fail("unexpected text after the value");
    }
    return v;
}

// ---- writer -----------------------------------------------------------------------------------
private void writeString(Out* sb, char* s) {
    sb->appendChar('"');
    for (int i = 0; s[i] != 0; i++) {
        int c = s[i];
        if (c == '"') {
            sb->append("\\\"");
        } else if (c == 92) {
            sb->append("\\\\");
        } else if (c == 10) {
            sb->append("\\n");
        } else if (c == 13) {
            sb->append("\\r");
        } else if (c == 9) {
            sb->append("\\t");
        } else if (c == 8) {
            sb->append("\\b");
        } else if (c == 12) {
            sb->append("\\f");
        } else if (c < 32) {
            char tmp[8];
            format(&tmp[0], 8, "\\u%04x", c, 0, 0, 0);
            sb->append(tmp);
        } else {
            sb->appendChar(c);
        }
    }
    sb->appendChar('"');
}

private void newline(Out* sb, int indent, int level) {
    if (indent <= 0) {
        return;
    }
    sb->appendChar(10);
    for (int i = 0; i < indent * level; i++) {
        sb->appendChar(' ');
    }
}

private void write(Out* sb, Json* v, int indent, int level) {
    switch (v->kind) {
        case 0: sb->append("null"); break;
        case 1:
            if (v->num != 0) sb->append("true"); else sb->append("false");
            break;
        case 2:
            if (v->text != null) sb->append(v->text); else sb->appendInt(v->num);
            break;
        case 3: writeString(sb, v->text); break;
        case 4:
            if (v->size() == 0) {
                sb->append("[]");
                break;
            }
            sb->appendChar('[');
            for (int i = 0; i < v->size(); i++) {
                if (i > 0) sb->appendChar(',');
                newline(sb, indent, level + 1);
                write(sb, v->at(i), indent, level + 1);
            }
            newline(sb, indent, level);
            sb->appendChar(']');
            break;
        case 5:
            if (v->size() == 0) {
                sb->append("{}");
                break;
            }
            sb->appendChar('{');
            for (int i = 0; i < v->size(); i++) {
                if (i > 0) sb->appendChar(',');
                newline(sb, indent, level + 1);
                writeString(sb, v->keyAt(i));
                sb->appendChar(':');
                if (indent > 0) sb->appendChar(' ');
                write(sb, v->at(i), indent, level + 1);
            }
            newline(sb, indent, level);
            sb->appendChar('}');
            break;
    }
}

// compact JSON text: {"a":1,"b":[true,null]}
public char* stringify(Json* v) {
    Out sb;
    write(&sb, v, 0, 0);
    return sb.toString();
}

// indented JSON text (two spaces per level)
public char* pretty(Json* v) {
    Out sb;
    write(&sb, v, 2, 0);
    return sb.toString();
}
