    0x1F18E, 0x1F19A, 0x1F202, 0x1F23B, 0x1F248, 0x1F251, 0x1F265, 0x1F320, 0x1F335, 0x1F37C, 0x1F393, 0x1F3CA, 0x1F3D3, 0x1F3F0,
    0x1F3F4, 0x1F43E, 0x1F440, 0x1F4FC, 0x1F53D, 0x1F54E, 0x1F567, 0x1F57A, 0x1F596, 0x1F5A4, 0x1F64F, 0x1F6C5, 0x1F6CC, 0x1F6D2,
    0x1F6D7, 0x1F6DF, 0x1F6EC, 0x1F6FC, 0x1F7EB, 0x1F7F0, 0x1F93A, 0x1F945, 0x1F9FF, 0x1FA7C, 0x1FA88, 0x1FABD, 0x1FAC5, 0x1FADB,
    0x1FAE8, 0x1FAF8, 0x2FFFD, 0x3FFFD
};
// END WIDTH TABLES

private bool inTable(int cp, int* lo, int* hi, int n) {
    int a = 0;
    int b = n - 1;
    while (a <= b) {
        int m = (a + b) / 2;
        if (cp < lo[m]) { b = m - 1; }
        else if (cp > hi[m]) { a = m + 1; }
        else { return true; }
    }
    return false;
}

// how many cells a character takes: 0 (controls and combining marks), 1 or 2 (East Asian wide and fullwidth, emoji)
public int runeWidth(int cp) {
    if (cp < 0x300) {
        if (cp < 32 || (cp >= 0x7F && cp < 0xA0)) { return 0; }
        return 1;
    }
    if (inTable(cp, &zeroWLo[0], &zeroWHi[0], ZERO_RANGES)) { return 0; }
    if (cp >= 0x1100 && inTable(cp, &wideWLo[0], &wideWHi[0], WIDE_RANGES)) { return 2; }
    return 1;
}

// the number of cells a UTF-8 text takes
public int textWidth(char* s) {
    int w = 0;
    int pos = 0;
    while (s[pos] != 0) {
        int cp;
        pos = pos + utf8.decode(s, pos, &cp);
        w = w + runeWidth(cp);
    }
    return w;
}

// the same for the first n bytes
public int textWidthN(char* s, int n) {
    int w = 0;
    int pos = 0;
    while (pos < n && s[pos] != 0) {
        int cp;
        pos = pos + utf8.decode(s, pos, &cp);
        w = w + runeWidth(cp);
    }
    return w;
}

// how many bytes of s fit into maxCells cells (the longest prefix that is at most that wide, never cutting a character)
public int fitBytes(char* s, int maxCells) {
    int w = 0;
    int pos = 0;
    while (s[pos] != 0) {
        int cp;
        int l = utf8.decode(s, pos, &cp);
        int cw = runeWidth(cp);
        if (w + cw > maxCells) { break; }
        w = w + cw;
        pos = pos + l;
    }
    return pos;
}

// ---- an output buffer ------------------------------------------------------------------------------------------------------------------
public class Out {
    public char* b;
    public int n;
    public int cap;

    public Out() {
        cap = 16384;
        b = alloc(cap);
    }

    public void clear() { n = 0; b[0] = 0; }

    private void room(int more) {
        if (n + more + 1 <= cap) { return; }
        int nc = cap * 2;
        while (nc < n + more + 1) { nc = nc * 2; }
        char* nb = alloc(nc);
        memcpy(nb, b, n);
        b = nb;
        cap = nc;
    }

    public void putc(int c) { room(1); b[n] = c; n++; b[n] = 0; }

    public void bytes(char* s, int len) {
        room(len);
        memcpy(&b[n], s, len);
        n = n + len;
        b[n] = 0;
    }

    public void str(char* s) { bytes(s, strlen(s)); }

    public void num(int v) {
        char t[24];
        intToStr(v, &t[0]);
        str(&t[0]);
    }

    // a character as UTF-8
    public void rune(int cp) {
        room(4);
        if (cp < 0x80) { b[n] = cp; n++; }
        else if (cp < 0x800) { b[n] = 0xC0 | (cp >> 6); b[n + 1] = 0x80 | (cp & 0x3F); n = n + 2; }
        else if (cp < 0x10000) { b[n] = 0xE0 | (cp >> 12); b[n + 1] = 0x80 | ((cp >> 6) & 0x3F); b[n + 2] = 0x80 | (cp & 0x3F); n = n + 3; }
        else { b[n] = 0xF0 | (cp >> 18); b[n + 1] = 0x80 | ((cp >> 12) & 0x3F); b[n + 2] = 0x80 | ((cp >> 6) & 0x3F); b[n + 3] = 0x80 | (cp & 0x3F); n = n + 4; }
        b[n] = 0;
    }

    // moves the terminal cursor (0 based column and row)
    public void cup(int col, int row) {
        str("\e[");
        num(row + 1);
        putc(';');
        num(col + 1);
        putc('H');
    }
}

// ---- how characters are shown when the terminal has no UTF-8 -------------------------------------------------------------------------
// an ASCII stand-in for a character
private int asciiFor(int cp) {
    if (cp < 128) { return cp; }
    if (cp >= 0x2500 && cp <= 0x257F) {
        if (cp == 0x2500 || cp == 0x2501 || cp == 0x2504 || cp == 0x2505 || cp == 0x2508 || cp == 0x2509 || cp == 0x254C || cp == 0x254D || cp == 0x2550) { return '-'; }
        if (cp == 0x2502 || cp == 0x2503 || cp == 0x2506 || cp == 0x2507 || cp == 0x250A || cp == 0x250B || cp == 0x254E || cp == 0x254F || cp == 0x2551) { return '|'; }
        return '+';
    }
    if (cp >= 0x2580 && cp <= 0x259F) {
        if (cp == 0x2591) { return '.'; }
        if (cp == 0x2592) { return ':'; }
        return '#';
    }
    if (cp == 0x2190 || cp == 0x25C4 || cp == 0x25C0 || cp == 0xAB || cp == 0x2039) { return '<'; }
    if (cp == 0x2192 || cp == 0x25BA || cp == 0x25B6 || cp == 0xBB || cp == 0x203A) { return '>'; }
    if (cp == 0x2191 || cp == 0x25B2) { return '^'; }
    if (cp == 0x2193 || cp == 0x25BC) { return 'v'; }
    if (cp == 0x2022 || cp == 0x25CF || cp == 0x25CB || cp == 0x2219) { return '*'; }
    if (cp == 0xB7 || cp == 0x2026) { return '.'; }
    if (cp == 0x2713 || cp == 0x2714) { return 'x'; }
    if (cp == 0x2261 || cp == 0x2630) { return '='; }
    if (cp == 0xA0) { return ' '; }
    if (cp == 0x2018 || cp == 0x2019) { return '\''; }
    if (cp == 0x201C || cp == 0x201D) { return '"'; }
    if (cp == 0x2013 || cp == 0x2014 || cp == 0x2212) { return '-'; }
    if (cp == 0x25A0 || cp == 0x25A1) { return '#'; }
    return '?';
}

// ---- the screen -------------------------------------------------------------------------------------------------------------------------
const CELL_WIDE = 0x1000000;            // in the flag bits of a cell's first word: the left half of a wide character
const CELL_TAIL = 0x2000000;            // the right half (its character is 0)
const CELL_MASK = 0xFFFFFF;

private int boxRunes[30] = {
    0, 0, 0, 0, 0, 0,
    0x250C, 0x2510, 0x2514, 0x2518, 0x2500, 0x2502,
    0x2554, 0x2557, 0x255A, 0x255D, 0x2550, 0x2551,
    0x256D, 0x256E, 0x2570, 0x256F, 0x2500, 0x2502,
    0x250F, 0x2513, 0x2517, 0x251B, 0x2501, 0x2503
};

public class Screen {
    public int w;
    public int h;
    public int* ch;                 // per cell: character | CELL_WIDE / CELL_TAIL
    public int* st;                 // per cell: style
    public int* ex;                 // per cell: up to three combining characters, 21 bits each
    public int* fch;                // what the terminal shows now (set by render)
    public int* fst;
    public int* fex;
    public int cx0;                 // clip rectangle (x1, y1 exclusive)
    public int cy0;
    public int cx1;
    public int cy1;
    public int curX;                // where the cursor should be after render
    public int curY;
    public bool curShow;
    public int curShape;            // 0 default, 1 block, 2 underline, 3 bar (blinking); 4..6 the same steady
    private int cstack[256];
    private int cn;
    private bool full;
    private int tx;                 // where the terminal's cursor is (-1: unknown)
    private int ty;
    private int tcur;               // the effective style the terminal is in now (-1: unknown)
    private bool tshown;
    private int tshape;
    private int capCells;           // how many cells the six arrays can hold (they are reused by resize() when the new size fits)

    public Screen(int cols, int rows) {
        resize(cols, rows);
    }

    // a new size: everything is blank and the next render redraws the whole screen. The arrays are kept when the new size fits in them
    // (memory from alloc is never freed, so a window that is dragged to and fro must not allocate every time); when it does not fit they
    // grow by at least half, so the total allocated stays under about three times the biggest size ever used.
    public void resize(int cols, int rows) {
        if (cols < 1) { cols = 1; }
        if (rows < 1) { rows = 1; }
        w = cols;
        h = rows;
        int n = w * h;
        if (n > capCells) {
            int nc = capCells + capCells / 2;
            if (nc < n) { nc = n; }
            ch = (int*) alloc(nc * 8);
            st = (int*) alloc(nc * 8);
            ex = (int*) alloc(nc * 8);
            fch = (int*) alloc(nc * 8);
            fst = (int*) alloc(nc * 8);
            fex = (int*) alloc(nc * 8);
            capCells = nc;
        } else {
            for (int i = 0; i < n; i++) { fch[i] = 0; fst[i] = 0; fex[i] = 0; }
        }
        cx0 = 0; cy0 = 0; cx1 = w; cy1 = h;
        cn = 0;
        clear(0);
        invalidate();
    }

    // the next render redraws everything (use after anything else wrote on the terminal)
    public void invalidate() {
        full = true;
        tx = -1;
        ty = -1;
        tcur = -1;
    }

    public void setCursor(int x, int y, int shape = 0) {
        curShow = true;
        curX = x;
        curY = y;
        curShape = shape;
    }

    public void hideCursor() { curShow = false; }

    // ---- clipping ------------------------------------------------------------------------------------------------------------------------
    public void pushClip(int x, int y, int cw, int chh) {
        if (cn < 64) {
            cstack[cn * 4] = cx0; cstack[cn * 4 + 1] = cy0; cstack[cn * 4 + 2] = cx1; cstack[cn * 4 + 3] = cy1;
        }
        cn++;
        int x1 = x + cw;
        int y1 = y + chh;
        if (x > cx0) { cx0 = x; }
        if (y > cy0) { cy0 = y; }
        if (x1 < cx1) { cx1 = x1; }
        if (y1 < cy1) { cy1 = y1; }
        if (cx1 < cx0) { cx1 = cx0; }
        if (cy1 < cy0) { cy1 = cy0; }
    }

    public void popClip() {
        if (cn == 0) { return; }
        cn--;
        if (cn < 64) {
            cx0 = cstack[cn * 4]; cy0 = cstack[cn * 4 + 1]; cx1 = cstack[cn * 4 + 2]; cy1 = cstack[cn * 4 + 3];
        }
    }

    public void resetClip() { cx0 = 0; cy0 = 0; cx1 = w; cy1 = h; cn = 0; }

    public bool visible(int x, int y) { return x >= cx0 && x < cx1 && y >= cy0 && y < cy1; }

    // ---- cells ---------------------------------------------------------------------------------------------------------------------------
    // fills the whole buffer (ignoring the clip) with blanks of that style
    public void clear(int s) {
        int n = w * h;
        for (int i = 0; i < n; i++) { ch[i] = ' '; st[i] = s; ex[i] = 0; }
    }

    // the character, style of a cell (0 / 0 outside the screen)
    public int runeAt(int x, int y) {
        if (x < 0 || y < 0 || x >= w || y >= h) { return 0; }
        return ch[y * w + x] & CELL_MASK;
    }
    public int styleAt(int x, int y) {
        if (x < 0 || y < 0 || x >= w || y >= h) { return 0; }
        return st[y * w + x];
    }

    // when a cell that belongs to a wide character is overwritten, the other half becomes a blank
    private void breakPair(int i) {
        int f = ch[i] & ~CELL_MASK;
        if (f == CELL_WIDE) {
            if (i + 1 < w * h) { ch[i + 1] = ' '; ex[i + 1] = 0; }
        } else if (f == CELL_TAIL) {
            if (i > 0) { ch[i - 1] = ' '; ex[i - 1] = 0; }
        }
    }

    private void combine(int x, int y, int cp) {
        if (x < 0 || y < cy0 || y >= cy1) { return; }
        int i = y * w + x;
        if ((ch[i] & ~CELL_MASK) == CELL_TAIL && x > 0) { i--; }
        if ((ch[i] & CELL_MASK) == 0) { return; }
        int e = ex[i];
        if ((e & 0x1FFFFF) == 0) { e = cp; }
        else if (((e >> 21) & 0x1FFFFF) == 0) { e = e | (cp << 21); }
        else if (((e >> 42) & 0x1FFFFF) == 0) { e = e | (cp << 42); }
        ex[i] = e;
    }

    // puts one character at (x, y); false when it was clipped or is not shown. A background of COL_KEEP keeps the cell's background.
    public bool put(int x, int y, int cp, int s) {
        if (x < cx0 || x >= cx1 || y < cy0 || y >= cy1) { return false; }
        int wd = runeWidth(cp);
        if (wd == 0) {
            if (cp >= 0x300) { combine(x - 1, y, cp); }
            return false;
        }
        int i = y * w + x;
        if (((s >> 26) & 0x3FFFFFF) == COL_KEEP) { s = (s & ~(0x3FFFFFF << 26)) | (st[i] & (0x3FFFFFF << 26)); }
        if (wd == 2 && x + 1 >= cx1) { cp = ' '; wd = 1; }
        breakPair(i);
        if (wd == 2) {
            breakPair(i + 1);
            ch[i] = cp | CELL_WIDE;
            ch[i + 1] = CELL_TAIL;
            st[i] = s;
            st[i + 1] = s;
            ex[i] = 0;
            ex[i + 1] = 0;
        } else {
            ch[i] = cp;
            st[i] = s;
            ex[i] = 0;
        }
        return true;
    }

    // draws UTF-8 text starting at (x, y); returns the column after the last character (even when clipped), so that texts can follow each other
    public int text(int x, int y, char* s, int sty) {
        int pos = 0;
        while (s[pos] != 0) {
            int cp;
            pos = pos + utf8.decode(s, pos, &cp);
            int wd = runeWidth(cp);
            if (wd == 0) { put(x, y, cp, sty); continue; }
            put(x, y, cp, sty);
            x = x + wd;
        }
        return x;
    }

    // like text, but stops before the character that would not fit into maxCells cells; returns the number of cells used
    public int textMax(int x, int y, char* s, int maxCells, int sty) {
        int used = 0;
        int pos = 0;
        while (s[pos] != 0) {
            int cp;
            int l = utf8.decode(s, pos, &cp);
            int wd = runeWidth(cp);
            if (used + wd > maxCells) { break; }
            pos = pos + l;
            put(x + used, y, cp, sty);
            used = used + wd;
        }
        return used;
    }

    // n bytes of text
    public int textn(int x, int y, char* s, int n, int sty) {
        int pos = 0;
        while (pos < n && s[pos] != 0) {
            int cp;
            pos = pos + utf8.decode(s, pos, &cp);
            int wd = runeWidth(cp);
            put(x, y, cp, sty);
            x = x + wd;
        }
        return x;
    }

    // text that is cut with a "…" (or "~" when there is no UTF-8 for it... the renderer replaces it) when it does not fit; returns the cells used
    public int textEllipsis(int x, int y, char* s, int maxCells, int sty) {
        if (maxCells <= 0) { return 0; }
        if (textWidth(s) <= maxCells) { return text(x, y, s, sty) - x; }
        int used = textMax(x, y, s, maxCells - 1, sty);
        put(x + used, y, 0x2026, sty);
        return used + 1;
    }

    public void fill(int x, int y, int fw, int fh, int cp, int sty) {
        int x1 = x + fw;
        int y1 = y + fh;
        if (x < cx0) { x = cx0; }
        if (y < cy0) { y = cy0; }
        if (x1 > cx1) { x1 = cx1; }
        if (y1 > cy1) { y1 = cy1; }
        for (int yy = y; yy < y1; yy++) {
            for (int xx = x; xx < x1; xx++) { put(xx, yy, cp, sty); }
        }
    }

    public void hline(int x, int y, int len, int cp, int sty) {
        for (int i = 0; i < len; i++) { put(x + i, y, cp, sty); }
    }

    public void vline(int x, int y, int len, int cp, int sty) {
        for (int i = 0; i < len; i++) { put(x, y + i, cp, sty); }
    }

    // a border of the given kind (BOX_SINGLE, BOX_DOUBLE, BOX_ROUND, BOX_HEAVY); the inside is not touched
    public void box(int x, int y, int bw, int bh, int kind, int sty) {
        if (bw < 2 || bh < 2 || kind <= 0 || kind > 4) { return; }
        int b = kind * 6;
        put(x, y, boxRunes[b], sty);
        put(x + bw - 1, y, boxRunes[b + 1], sty);
        put(x, y + bh - 1, boxRunes[b + 2], sty);
        put(x + bw - 1, y + bh - 1, boxRunes[b + 3], sty);
        hline(x + 1, y, bw - 2, boxRunes[b + 4], sty);
        hline(x + 1, y + bh - 1, bw - 2, boxRunes[b + 4], sty);
        vline(x, y + 1, bh - 2, boxRunes[b + 5], sty);
        vline(x + bw - 1, y + 1, bh - 2, boxRunes[b + 5], sty);
    }

    // a filled rectangle with a border
    public void panel(int x, int y, int pw, int ph, int kind, int sty) {
        fill(x, y, pw, ph, ' ', sty);
        box(x, y, pw, ph, kind, sty);
    }

    // changes the style of existing cells (the characters stay); a COL_KEEP background keeps the old one
    public void restyle(int x, int y, int rw, int rh, int sty) {
        int x1 = x + rw;
        int y1 = y + rh;
        if (x < cx0) { x = cx0; }
        if (y < cy0) { y = cy0; }
        if (x1 > cx1) { x1 = cx1; }
        if (y1 > cy1) { y1 = cy1; }
        for (int yy = y; yy < y1; yy++) {
            for (int xx = x; xx < x1; xx++) {
                int i = yy * w + xx;
                int s = sty;
                if (((s >> 26) & 0x3FFFFFF) == COL_KEEP) { s = (s & ~(0x3FFFFFF << 26)) | (st[i] & (0x3FFFFFF << 26)); }
                st[i] = s;
            }
        }
    }

    // adds and removes attributes of existing cells
    public void attrs(int x, int y, int rw, int rh, int add, int remove) {
        int x1 = x + rw;
        int y1 = y + rh;
        if (x < cx0) { x = cx0; }
        if (y < cy0) { y = cy0; }
        if (x1 > cx1) { x1 = cx1; }
        if (y1 > cy1) { y1 = cy1; }
        for (int yy = y; yy < y1; yy++) {
            for (int xx = x; xx < x1; xx++) {
                int i = yy * w + xx;
                st[i] = (st[i] | (add << 52)) & ~(remove << 52);
            }
        }
    }

    // a shadow: the cells keep their characters but turn dark gray on black (what a dialog or menu throws on what is below)
    public void shadow(int x, int y, int sw, int sh) {
        restyle(x, y, sw, sh, style(GRAY, BLACK, 0));
    }

    // copies the cells of another screen of any size into this one at (x, y) (clipped)
    public void blit(Screen* o, int x, int y) {
        for (int yy = 0; yy < o->h; yy++) {
            for (int xx = 0; xx < o->w; xx++) {
                int i = yy * o->w + xx;
                int f = o->ch[i] & ~CELL_MASK;
                if (f == CELL_TAIL) { continue; }
                put(x + xx, y + yy, o->ch[i] & CELL_MASK, o->st[i]);
                if (o->ex[i] != 0) {
                    int e = o->ex[i];
                    int wd = (f == CELL_WIDE) ? 2 : 1;
                    for (int k = 0; k < 3; k++) {
                        int cp = (e >> (21 * k)) & 0x1FFFFF;
                        if (cp != 0) { put(x + xx + wd, y + yy, cp, 0); }
                    }
                }
            }
        }
    }

    // ---- text of the screen -------------------------------------------------------------------------------------------------------------
    // row y as UTF-8 text without trailing blanks, written to out (NUL terminated, at most cap bytes); returns the length
    public int rowText(int y, char* out, int cap) {
        int n = 0;
        int lastNonBlank = 0;
        for (int x = 0; x < w; x++) {
            int i = y * w + x;
            int f = ch[i] & ~CELL_MASK;
            if (f == CELL_TAIL) { continue; }
            int cp = ch[i] & CELL_MASK;
            if (cp == 0) { cp = ' '; }
            if (n + 16 >= cap) { break; }
            n = n + utf8.encode(cp, &out[n]);
            int e = ex[i];
            for (int k = 0; k < 3; k++) {
                int c2 = (e >> (21 * k)) & 0x1FFFFF;
                if (c2 != 0) { n = n + utf8.encode(c2, &out[n]); }
            }
            if (cp != ' ') { lastNonBlank = n; }
        }
        out[lastNonBlank] = 0;
        return lastNonBlank;
    }

    // the whole screen as text: rows without trailing blanks, joined by newlines (a heap string)
    public char* dump() {
        char* out = alloc(h * (w * 4 + 16) + 2);
        int n = 0;
        for (int y = 0; y < h; y++) {
            n = n + rowText(y, &out[n], w * 4 + 8);
            out[n] = '\n';
            n++;
        }
        out[n] = 0;
        return out;
    }

    // ---- drawing the difference ------------------------------------------------------------------------------------------------------
    // the style as the terminal will see it: colours downgraded for the colour depth, attributes the terminal lacks removed
    private int effective(int s, term.Caps* caps) {
        int fg = fgOf(s);
        int bg = bgOf(s);
        int at = attrOf(s);
        int depth = caps->colors;
        if (depth == term.COLORS_8 && fg != 0) {
            int f16 = downgrade(fg, term.COLORS_16);
            if ((f16 & 255) >= 8) { at = at | A_BOLD; }
        }
        fg = downgrade(fg, depth);
        bg = downgrade(bg, depth);
        if (!caps->italic) { at = at & ~A_ITALIC; }
        return style(fg, bg, at);
    }

    private void colorParam(Out* o, int c, bool back) {
        int kind = (c >> 24) & 3;
        if (kind == 0) { o->str(back ? "49" : "39"); return; }
        if (kind == 2) {
            int n = c & 255;
            if (n < 8) { o->num((back ? 40 : 30) + n); return; }
            if (n < 16) { o->num((back ? 100 : 90) + n - 8); return; }
            o->str(back ? "48;5;" : "38;5;");
            o->num(n);
            return;
        }
        o->str(back ? "48;2;" : "38;2;");
        o->num((c >> 16) & 255);
        o->putc(';');
        o->num((c >> 8) & 255);
        o->putc(';');
        o->num(c & 255);
    }

    // writes the SGR sequence that changes the terminal from effective style cur (-1 unknown) to nw
    private void sgr(Out* o, int cur, int nw) {
        if (nw == 0) { o->str("\e[0m"); return; }
        int at = attrOf(nw);
        int curAt = 0;
        int curFg = 0;
        int curBg = 0;
        bool reset = cur < 0 || (attrOf(cur) & ~at) != 0;
        o->str("\e[");
        bool first = true;
        if (reset) {
            o->putc('0');
            first = false;
        } else {
            curAt = attrOf(cur);
            curFg = fgOf(cur);
            curBg = bgOf(cur);
        }
        int codes[8] = {1, 2, 3, 4, 7, 5, 9, 0};
        int bits[7] = {A_BOLD, A_DIM, A_ITALIC, A_UNDERLINE, A_REVERSE, A_BLINK, A_STRIKE};
        for (int k = 0; k < 7; k++) {
            if ((at & bits[k]) != 0 && (curAt & bits[k]) == 0) {
                if (!first) { o->putc(';'); }
                o->num(codes[k]);
                first = false;
            }
        }
        if (fgOf(nw) != curFg) {
            if (!first) { o->putc(';'); }
            colorParam(o, fgOf(nw), false);
            first = false;
        }
        if (bgOf(nw) != curBg) {
            if (!first) { o->putc(';'); }
            colorParam(o, bgOf(nw), true);
            first = false;
        }
        o->putc('m');
    }

    private bool differs(int i) {
        return ch[i] != fch[i] || st[i] != fst[i] || ex[i] != fex[i];
    }

    private void moveTo(Out* o, int x, int y) {
        if (tx == x && ty == y) { return; }
        if (tx >= 0 && ty == y && x > tx && x - tx <= 4) {
            o->str("\e[");
            if (x - tx > 1) { o->num(x - tx); }
            o->putc('C');
        } else if (tx >= 0 && ty == y && x == 0) {
            o->putc('\r');
        } else if (tx == x && ty >= 0 && y > ty && y - ty <= 3) {
            o->str("\e[");
            if (y - ty > 1) { o->num(y - ty); }
            o->putc('B');
        } else {
            o->cup(x, y);
        }
        tx = x;
        ty = y;
    }

    // writes cell i (a wide character takes the next cell as well) and records that the terminal shows it now
    private void emitCell(Out* o, term.Caps* caps, int i, int x, int y) {
        int c = ch[i];
        int es = effective(st[i], caps);
        if (es != tcur) {
            sgr(o, tcur, es);
            tcur = es;
        }
        int cp = c & CELL_MASK;
        bool wide = (c & ~CELL_MASK) == CELL_WIDE;
        if (cp == 0) { cp = ' '; }
        if (caps->utf8) {
            o->rune(cp);
            int e = ex[i];
            for (int k = 0; k < 3; k++) {
                int c2 = (e >> (21 * k)) & 0x1FFFFF;
                if (c2 != 0) { o->rune(c2); }
            }
        } else {
            o->putc(asciiFor(cp));
            if (wide) { o->putc('?'); }
        }
        fch[i] = ch[i];
        fst[i] = st[i];
        fex[i] = ex[i];
        int adv = 1;
        if (wide) {
            fch[i + 1] = ch[i + 1];
            fst[i + 1] = st[i + 1];
            fex[i + 1] = ex[i + 1];
            adv = 2;
        }
        tx = tx + adv;
        if (x + adv >= w) { tx = -1; ty = -1; }
    }

    // Brings the terminal up to date: appends to o the bytes that change what the terminal shows into what the screen holds, and
    // remembers that. Writes nothing when nothing changed. After a resize or invalidate() the whole screen is redrawn.
    public int render(Out* o, term.Caps* caps) {
        int start = o->n;
        bool drew = false;
        bool hidden = false;
        if (full) {
            if (caps->syncOutput) { o->str("\e[?2026h"); drew = true; }
            if (tshown) { o->str("\e[?25l"); hidden = true; }
            o->str("\e[0m\e[2J");
            drew = true;
            tcur = 0;
            tx = -1;
            ty = -1;
            int n = w * h;
            for (int i = 0; i < n; i++) { fch[i] = ' '; fst[i] = 0; fex[i] = 0; }
            full = false;
        }
        for (int y = 0; y < h; y++) {
            int row = y * w;
            int x = 0;
            while (x < w && !differs(row + x)) { x++; }
            if (x == w) { continue; }
            int last = w - 1;
            while (last > x && !differs(row + last)) { last--; }
            if (!drew) {
                if (caps->syncOutput) { o->str("\e[?2026h"); }
                drew = true;
            }
            if (tshown && !hidden) { o->str("\e[?25l"); hidden = true; }
            int lastStyle = -1;
            while (x <= last) {
                int i = row + x;
                if (!differs(i)) {
                    int nx = x;
                    while (nx <= last && !differs(row + nx)) { nx++; }
                    if (nx > last) { break; }
                    int gap = nx - x;
                    bool fill = false;
                    if (gap <= 3 && tx == x && ty == y && lastStyle >= 0) {
                        fill = true;
                        for (int k = x; k < nx; k++) {
                            if ((ch[row + k] & ~CELL_MASK) != 0 || ex[row + k] != 0 || st[row + k] != lastStyle) { fill = false; }
                        }
                    }
                    if (fill) {
                        for (int k = x; k < nx; k++) { emitCell(o, caps, row + k, k, y); }
                    }
                    x = nx;
                    continue;
                }
                if ((ch[i] & ~CELL_MASK) == CELL_TAIL && x > 0) { x--; i--; }
                moveTo(o, x, y);
                emitCell(o, caps, i, x, y);
                lastStyle = st[i];
                x = x + (((ch[i] & ~CELL_MASK) == CELL_WIDE) ? 2 : 1);
            }
        }
        // the cursor
        if (curShow) {
            if (tx != curX || ty != curY || drew) {
                if (tx != curX || ty != curY) { o->cup(curX, curY); tx = curX; ty = curY; }
            }
            if (!tshown || hidden) { o->str("\e[?25h"); tshown = true; }
            if (caps->cursorShape && curShape != tshape) {
                o->str("\e[");
                o->num(curShape);
                o->str(" q");
                tshape = curShape;
            }
        } else if (tshown) {
            if (!hidden) { o->str("\e[?25l"); }
            tshown = false;
        } else if (hidden) {
            tshown = false;
        }
        if (drew && caps->syncOutput) { o->str("\e[?2026l"); }
        return o->n - start;
    }
}
