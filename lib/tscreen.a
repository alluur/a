// =============================================================================
//  tscreen - cells, colours, character widths, drawing primitives and the diff renderer          import tscreen;
//
//    tscreen.Screen s(80, 24);               // Screen* s = new tscreen.Screen(80, 24); also works
//    s.clear(0);
//    s.box(2, 1, 30, 5, tscreen.BOX_ROUND, tscreen.style(tscreen.CYAN, 0, 0));
//    s.text(4, 2, "Hello, wide world: \xe4\xb8\x96\xe7\x95\x8c", tscreen.style(tscreen.rgb(255, 200, 0), 0, tscreen.A_BOLD));
//    tscreen.Out out();  term.Caps caps();
//    s.render(&out, &caps);                  // out.b / out.n: the escape sequences that bring the terminal up to date (only what changed)
//    println(s.dump());                      // the screen as plain text (for tests)
//
//  A style is ONE int: foreground colour (26 bits) | background colour << 26 | attributes << 52. A colour is 0 (the terminal's default),
//  rgb(r, g, b), or idx(n) (palette entry n; 0..15 are the ANSI colours: BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE and their
//  BRIGHT_ versions). Colours are downgraded when the terminal cannot show them: truecolor -> 256 -> 16 -> 8 -> none, always to the
//  nearest colour. As a background COL_KEEP means "whatever is there already" (text on top of a panel).
//
//  Everything that draws is clipped to the current clip rectangle (pushClip / popClip). Wide characters (CJK, emoji) take two cells,
//  combining marks are attached to the cell before them (up to three), control characters are ignored. Ambiguous width counts as 1.
// =============================================================================
import term;
import utf8;
module tscreen;

// ---- colours ---------------------------------------------------------------------------------------------------------------------------
public const COL_DEFAULT = 0;
public const COL_KEEP = 0x3000000;

public const BLACK = 0x2000000;
public const RED = 0x2000001;
public const GREEN = 0x2000002;
public const YELLOW = 0x2000003;
public const BLUE = 0x2000004;
public const MAGENTA = 0x2000005;
public const CYAN = 0x2000006;
public const WHITE = 0x2000007;
public const GRAY = 0x2000008;
public const BRIGHT_BLACK = 0x2000008;
public const BRIGHT_RED = 0x2000009;
public const BRIGHT_GREEN = 0x200000A;
public const BRIGHT_YELLOW = 0x200000B;
public const BRIGHT_BLUE = 0x200000C;
public const BRIGHT_MAGENTA = 0x200000D;
public const BRIGHT_CYAN = 0x200000E;
public const BRIGHT_WHITE = 0x200000F;

public const A_BOLD = 1;
public const A_DIM = 2;
public const A_ITALIC = 4;
public const A_UNDERLINE = 8;
public const A_REVERSE = 16;
public const A_BLINK = 32;
public const A_STRIKE = 64;

public const BOX_NONE = 0;
public const BOX_SINGLE = 1;
public const BOX_DOUBLE = 2;
public const BOX_ROUND = 3;
public const BOX_HEAVY = 4;

public int rgb(int r, int g, int b) { return 0x1000000 | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255); }
public int hex(int v) { return 0x1000000 | (v & 0xFFFFFF); }
public int idx(int n) { return 0x2000000 | (n & 255); }

public int style(int fg, int bg, int attr = 0) { return fg | (bg << 26) | (attr << 52); }
public int fgOf(int s) { return s & 0x3FFFFFF; }
public int bgOf(int s) { return (s >> 26) & 0x3FFFFFF; }
public int attrOf(int s) { return (s >> 52) & 255; }
public int withFg(int s, int c) { return (s & ~0x3FFFFFF) | c; }
public int withBg(int s, int c) { return (s & ~(0x3FFFFFF << 26)) | (c << 26); }
public int withAttr(int s, int a) { return (s & ~(255 << 52)) | (a << 52); }
public int addAttr(int s, int a) { return s | (a << 52); }
public int delAttr(int s, int a) { return s & ~(a << 52); }

// the channels of an RGB colour
public int redOf(int c) { return (c >> 16) & 255; }
public int greenOf(int c) { return (c >> 8) & 255; }
public int blueOf(int c) { return c & 255; }

int pal16[16] = {0x000000, 0xCD0000, 0x00CD00, 0xCDCD00, 0x0000EE, 0xCD00CD, 0x00CDCD, 0xE5E5E5,
                 0x7F7F7F, 0xFF0000, 0x00FF00, 0xFFFF00, 0x5C5CFF, 0xFF00FF, 0x00FFFF, 0xFFFFFF};

// 0xRRGGBB of entry n of the xterm 256 colour palette
public int paletteRgb(int n) {
    n = n & 255;
    if (n < 16) { return pal16[n]; }
    if (n < 232) {
        int v = n - 16;
        int r = v / 36;
        int g = (v / 6) % 6;
        int b = v % 6;
        r = (r == 0) ? 0 : 55 + r * 40;
        g = (g == 0) ? 0 : 55 + g * 40;
        b = (b == 0) ? 0 : 55 + b * 40;
        return (r << 16) | (g << 8) | b;
    }
    int gray = 8 + (n - 232) * 10;
    return (gray << 16) | (gray << 8) | gray;
}

// 0xRRGGBB of a colour value; -1 for the default colour (and COL_KEEP)
public int rgbOf(int c) {
    int kind = (c >> 24) & 3;
    if (kind == 1) { return c & 0xFFFFFF; }
    if (kind == 2) { return paletteRgb(c & 255); }
    return -1;
}

// distance between two 0xRRGGBB colours (the "redmean" approximation of perceived difference)
private int dist(int a, int b) {
    int r1 = (a >> 16) & 255;
    int g1 = (a >> 8) & 255;
    int b1 = a & 255;
    int dr = r1 - ((b >> 16) & 255);
    int dg = g1 - ((b >> 8) & 255);
    int db = b1 - (b & 255);
    int rm = (r1 + ((b >> 16) & 255)) / 2;
    return (((512 + rm) * dr * dr) >> 8) + 4 * dg * dg + (((767 - rm) * db * db) >> 8);
}

// the nearest of the 16 ANSI colours (0..15) for a 0xRRGGBB value
public int nearest16(int c) {
    int best = 0;
    int bd = 0x7FFFFFFF;
    for (int i = 0; i < 16; i++) {
        int d = dist(c, pal16[i]);
        if (d < bd) { bd = d; best = i; }
    }
    return best;
}

// the nearest entry (16..255) of the 6x6x6 colour cube or the gray ramp (the cube corners around the colour and the grays near its brightness are tried)
public int nearest256(int c) {
    int levels[6] = {0, 95, 135, 175, 215, 255};
    int ch3[3];
    ch3[0] = (c >> 16) & 255;
    ch3[1] = (c >> 8) & 255;
    ch3[2] = c & 255;
    int lo[3];
    for (int k = 0; k < 3; k++) {
        int i = 0;
        while (i < 4 && levels[i + 1] <= ch3[k]) { i++; }
        lo[k] = i;
    }
    int best = 16;
    int bd = 0x7FFFFFFF;
    for (int m = 0; m < 8; m++) {
        int ri = lo[0] + (m & 1);
        int gi = lo[1] + ((m >> 1) & 1);
        int bi = lo[2] + ((m >> 2) & 1);
        if (ri > 5 || gi > 5 || bi > 5) { continue; }
        int n = 16 + 36 * ri + 6 * gi + bi;
        int d = dist(c, (levels[ri] << 16) | (levels[gi] << 8) | levels[bi]);
        if (d < bd) { bd = d; best = n; }
    }
    int gray = (ch3[0] + ch3[1] + ch3[2]) / 3;
    int g0 = (gray - 8) / 10;
    for (int g = g0 - 1; g <= g0 + 1; g++) {
        if (g < 0 || g > 23) { continue; }
        int d = dist(c, paletteRgb(232 + g));
        if (d < bd) { bd = d; best = 232 + g; }
    }
    return best;
}

// the colour as it will be shown by a terminal with that many colours (term.COLORS_...): a colour value again
public int downgrade(int c, int depth) {
    int kind = (c >> 24) & 3;
    if (kind == 0 || kind == 3) { return c; }
    if (depth == term.COLORS_NONE) { return COL_DEFAULT; }
    if (depth >= term.COLORS_TRUE) { return c; }
    if (kind == 2) {
        int n = c & 255;
        if (depth == term.COLORS_256 || n < 16) {
            if (depth == term.COLORS_8 && n >= 8) { return idx(n - 8); }
            return c;
        }
        c = paletteRgb(n);
    } else {
        c = c & 0xFFFFFF;
    }
    if (depth == term.COLORS_256) { return idx(nearest256(c)); }
    int n16 = nearest16(c);
    if (depth == term.COLORS_8 && n16 >= 8) { n16 = n16 - 8; }
    return idx(n16);
}

