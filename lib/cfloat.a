// =============================================================================
//  cfloat - text <-> double, printf with floating point       import cfloat;   (needs cmath, which it imports)
//
//    strtod atof            text to double (decimal, hexadecimal, inf, nan; correctly rounded)
//    dtostr(x)              shortest text that reads back as exactly x (like Python's repr: "0.1", "1e+22", "1.5")
//    printfd sprintfd snprintfd eprintfd vformatd formatd
//                           printf family that understands %f %F %e %E %g %G %a %A besides everything vformat knows.
//                           A double is passed like any other value: its bit pattern (see cmath).
//
//     printfd("%d squared is %.3f\n", 2, dmul(dlit("1.5"), dlit("1.5")));
//
//  The results are exactly rounded (the digits are computed with big integers), also for %.40f or 1e300.
// =============================================================================
import cmath;

// ---- text to double ---------------------------------------------------------------------------------------------------------------
// builds the double D * 10^e10 (D is a big integer, negative if sign is 1); tail = digits that were dropped were not all zero
int __dec_to_double(int* D, int e10, int sign, bool tail) {
    if (D[0] == 0) {
        return sign << 63;
    }
    if (tail) {
        __bn_mul_small(D, 10);
        __bn_add_small(D, 1);
        e10 = e10 - 1;
    }
    int L = __bn_bitlen(D);
    // magnitude check: log10(D) + e10
    int mag = (L * 30103) / 100000 + e10;
    if (mag > 311) {
        return (sign << 63) | 0x7FF0000000000000;
    }
    if (mag < -345) {
        return sign << 63;
    }
    bool sticky = false;
    int shiftOut = 0;
    if (e10 >= 0) {
        __bn_mul_pow10(D, e10);
    } else {
        int k = -e10;
        int s = 66 + (k * 2322 + 999) / 1000 + 2 - L;
        if (s < 0) {
            s = 0;
        }
        __bn_shl(D, s);
        while (k >= 13) {
            if (__bn_div_small(D, 1220703125) != 0) {
                sticky = true;
            }
            k = k - 13;
        }
        if (k > 0) {
            int p = 1;
            for (int i = 0; i < k; i++) {
                p = p * 5;
            }
            if (__bn_div_small(D, p) != 0) {
                sticky = true;
            }
        }
        shiftOut = -s + e10;                       // value = D * 2^(-s - k), k = -e10
    }
    int L2 = __bn_bitlen(D);
    int e = shiftOut;
    int sig;
    if (L2 > 63) {
        int sh = L2 - 63;
        if (__bn_shr(D, sh)) {
            sticky = true;
        }
        e = e + sh;
        sig = __bn_low(D);
    } else {
        sig = __bn_low(D);
    }
    if (sticky) {
        sig = sig | 1;
    }
    return __fpack(sign, e, sig);
}

bool __ieq(char* s, char* word) {
    int i = 0;
    while (word[i] != 0) {
        int c = s[i];
        if (c >= 'A' && c <= 'Z') {
            c = c + 32;
        }
        if (c != word[i]) {
            return false;
        }
        i++;
    }
    return true;
}

int __hexval(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

// converts the start of s to a double: white space, sign, then a decimal number (123, 1.5, .5e-3), a hexadecimal one
// (0x1.8p3), inf / infinity or nan. *end (if not null) is set to the first unused character; if nothing could be
// converted it is s itself and the result is 0.
int strtod(char* s, char** end) {
    int i = 0;
    while (s[i] == ' ' || (s[i] >= 9 && s[i] <= 13)) {
        i++;
    }
    int sign = 0;
    if (s[i] == '-') {
        sign = 1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    if (__ieq(&s[i], "inf")) {
        i = i + 3;
        if (__ieq(&s[i], "inity")) {
            i = i + 5;
        }
        if (end != null) { *end = &s[i]; }
        return (sign << 63) | 0x7FF0000000000000;
    }
    if (__ieq(&s[i], "nan")) {
        i = i + 3;
        if (s[i] == '(') {
            int j = i + 1;
            while (isalnum_(s[j]) || s[j] == '_') {
                j++;
            }
            if (s[j] == ')') {
                i = j + 1;
            }
        }
        if (end != null) { *end = &s[i]; }
        return (sign << 63) | 0x7FF8000000000000;
    }
    // hexadecimal
    if (s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X') && (__hexval(s[i + 2]) >= 0 || (s[i + 2] == '.' && __hexval(s[i + 3]) >= 0))) {
        i = i + 2;
        int m = 0;
        int nd = 0;
        int e2 = 0;
        bool sticky = false;
        bool dot = false;
        for (;;) {
            int c = s[i];
            if (c == '.' && !dot) {
                dot = true;
                i++;
                continue;
            }
            int h = __hexval(c);
            if (h < 0) {
                break;
            }
            if (nd < 15) {
                m = (m << 4) | h;
                if (m != 0) { nd++; }
                if (dot) { e2 = e2 - 4; }
            } else {
                if (h != 0) { sticky = true; }
                if (!dot) { e2 = e2 + 4; }
            }
            i++;
        }
        if (s[i] == 'p' || s[i] == 'P') {
            int j = i + 1;
            int es = 1;
            if (s[j] == '-') { es = -1; j++; }
            else if (s[j] == '+') { j++; }
            if (s[j] >= '0' && s[j] <= '9') {
                int ev = 0;
                while (s[j] >= '0' && s[j] <= '9') {
                    if (ev < 100000) { ev = ev * 10 + (s[j] - '0'); }
                    j++;
                }
                e2 = e2 + es * ev;
                i = j;
            }
        }
        if (end != null) { *end = &s[i]; }
        if (m == 0) {
            return sign << 63;
        }
        if (sticky) { m = m | 1; }
        return __fpack(sign, e2, m);
    }
    // decimal
    int D[__BN_CAP + 2];
    D[0] = 0;
    int ndig = 0;
    int e10 = 0;
    bool saw = false;
    bool tail = false;
    bool dot = false;
    for (;;) {
        int c = s[i];
        if (c == '.' && !dot) {
            dot = true;
            i++;
            continue;
        }
        if (c < '0' || c > '9') {
            break;
        }
        saw = true;
        int d = c - '0';
        if (ndig < 780) {
            if (D[0] != 0 || d != 0) {
                __bn_mul_small(D, 10);
                __bn_add_small(D, d);
                ndig++;
            }
            if (dot) { e10 = e10 - 1; }
        } else {
            if (d != 0) { tail = true; }
            if (!dot) { e10 = e10 + 1; }
        }
        i++;
    }
    if (!saw) {
        if (end != null) { *end = s; }
        return 0;
    }
    if (s[i] == 'e' || s[i] == 'E') {
        int j = i + 1;
        int es = 1;
        if (s[j] == '-') { es = -1; j++; }
        else if (s[j] == '+') { j++; }
        if (s[j] >= '0' && s[j] <= '9') {
            int ev = 0;
            while (s[j] >= '0' && s[j] <= '9') {
                if (ev < 100000) { ev = ev * 10 + (s[j] - '0'); }
                j++;
            }
            e10 = e10 + es * ev;
            i = j;
        }
    }
    if (end != null) { *end = &s[i]; }
    return __dec_to_double(D, e10, sign, tail);
}

bool isalnum_(int c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

int atof(char* s) {
    return strtod(s, null);
}

// the double that the text means ("2.5", "1e-3", "0x1p4", "inf")
int dlit(char* s) {
    return strtod(s, null);
}

// ---- double to text ---------------------------------------------------------------------------------------------------------------------------
// q = round(m * 2^e * 10^S) (halves to even), exactly
void __scaled_round(int* q, int m, int e, int S) {
    __bn_set(q, m);
    if (S > 0) {
        __bn_mul_pow10(q, S);
    }
    if (e > 0) {
        __bn_shl(q, e);
    }
    int A = 0;
    if (S < 0) {
        A = -S;
    }
    int B = A;
    if (e < 0) {
        B = B - e;
    }
    bool sticky5 = false;
    int k = A;
    while (k >= 13) {
        if (__bn_div_small(q, 1220703125) != 0) {
            sticky5 = true;
        }
        k = k - 13;
    }
    if (k > 0) {
        int p = 1;
        for (int i = 0; i < k; i++) {
            p = p * 5;
        }
        if (__bn_div_small(q, p) != 0) {
            sticky5 = true;
        }
    }
    if (B > 0) {
        bool low = __bn_shr(q, B - 1);
        int half = 0;
        if (q[0] > 0) {
            half = q[1] & 1;
        }
        __bn_shr(q, 1);
        int odd = 0;
        if (q[0] > 0) {
            odd = q[1] & 1;
        }
        if (half == 1 && (low || sticky5 || odd == 1)) {
            __bn_add_small(q, 1);
        }
    }
}

// the decimal digits of a big integer (destroys it); returns the count
int __bn_to_dec(int* a, char* buf) {
    if (a[0] == 0) {
        buf[0] = '0';
        buf[1] = 0;
        return 1;
    }
    char tmp[1700];
    int n = 0;
    while (a[0] > 0) {
        int rem = __bn_div_small(a, 1000000000);
        for (int i = 0; i < 9; i++) {
            tmp[n] = '0' + rem % 10;
            n++;
            rem = rem / 10;
        }
    }
    while (n > 1 && tmp[n - 1] == '0') {
        n--;
    }
    for (int i = 0; i < n; i++) {
        buf[i] = tmp[n - 1 - i];
    }
    buf[n] = 0;
    return n;
}

char __dig[1700];      // digits produced by __dtoa_sci / __dtoa_fixed
int __ndig;
int __d10;             // decimal exponent of the first digit

// x = |x| finite: the prec+1 significant digits of x rounded correctly, in __dig; __d10 = exponent of the first digit
void __dtoa_sci(int x, int prec) {
    if (prec > 700) {
        prec = 700;
    }
    int c = __funpack(x);
    if (c == __F_ZERO) {
        for (int i = 0; i <= prec; i++) {
            __dig[i] = '0';
        }
        __dig[prec + 1] = 0;
        __ndig = prec + 1;
        __d10 = 0;
        return;
    }
    int m = __um;
    int e = __ue;
    // estimate floor(log10(x)) from the binary exponent
    int t = (e + 52) * 30103;
    int d10 = t / 100000;
    if (t < 0 && t % 100000 != 0) {
        d10--;
    }
    int Q[__BN_CAP + 2];
    for (int tries = 0; tries < 5; tries++) {
        __scaled_round(Q, m, e, prec - d10);
        int n = __bn_to_dec(Q, &__dig[0]);
        __ndig = n;
        if (n == prec + 2) {
            d10++;
        } else if (n < prec + 1) {
            d10--;
        } else {
            break;
        }
    }
    __d10 = d10;
}

// x = |x| finite: round(x * 10^prec) as digits in __dig
void __dtoa_fixed(int x, int prec) {
    int c = __funpack(x);
    if (c == __F_ZERO) {
        __dig[0] = '0';
        __dig[1] = 0;
        __ndig = 1;
        return;
    }
    int Q[__BN_CAP + 2];
    __scaled_round(Q, __um, __ue, prec);
    __ndig = __bn_to_dec(Q, &__dig[0]);
}

// appends text to out at pos (limited to max)
int __cat(char* out, int max, int pos, char* s, int n) {
    for (int i = 0; i < n; i++) {
        if (pos < max - 1) {
            out[pos] = s[i];
        }
        pos++;
    }
    return pos;
}

// ---- shortest representation ---------------------------------------------------------------------------------------------------------
// does the n-digit decimal rounding of ax read back as ax ?
bool __roundtrips(int ax, int n) {
    __dtoa_sci(ax, n - 1);
    int D[__BN_CAP + 2];
    D[0] = 0;
    for (int i = 0; i < n; i++) {
        __bn_mul_small(D, 10);
        __bn_add_small(D, __dig[i] - '0');
    }
    return __dec_to_double(D, __d10 - (n - 1), 0, false) == ax;
}

// number of significant digits that make ax (finite, positive) read back exactly
int __shortest_digits(int ax) {
    int lo = 1;
    int hi = 17;
    while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (__roundtrips(ax, mid)) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

// the shortest text that reads back as exactly x, in the style of Python's repr: 0.1  1.5  100.0  1e+22  1.5e-07  nan  inf
char* dtostr(int x) {
    char* out = alloc(40);
    int pos = 0;
    if (isnan(x)) {
        strcpy(out, "nan");
        return out;
    }
    if (x < 0) {
        out[pos] = '-';
        pos++;
    }
    int ax = x & 0x7FFFFFFFFFFFFFFF;
    if (ax == 0x7FF0000000000000) {
        strcpy(&out[pos], "inf");
        return out;
    }
    if (ax == 0) {
        strcpy(&out[pos], "0.0");
        return out;
    }
    int n = __shortest_digits(ax);
    __dtoa_sci(ax, n - 1);
    int d10 = __d10;
    int nd = n;
    while (nd > 1 && __dig[nd - 1] == '0') {
        nd--;
    }
    if (d10 < -4 || d10 >= 16) {
        out[pos] = __dig[0];
        pos++;
        if (nd > 1) {
            out[pos] = '.';
            pos++;
            for (int i = 1; i < nd; i++) {
                out[pos] = __dig[i];
                pos++;
            }
        }
        out[pos] = 'e';
        pos++;
        int ex = d10;
        if (ex < 0) {
            out[pos] = '-';
            ex = -ex;
        } else {
            out[pos] = '+';
        }
        pos++;
        if (ex < 10) {
            out[pos] = '0';
            pos++;
        }
        char tmp[8];
        intToStr(ex, &tmp[0]);
        strcpy(&out[pos], tmp);
        return out;
    }
    if (d10 >= 0) {
        for (int i = 0; i <= d10; i++) {
            if (i < nd) {
                out[pos] = __dig[i];
            } else {
                out[pos] = '0';
            }
            pos++;
        }
        out[pos] = '.';
        pos++;
        if (nd > d10 + 1) {
            for (int i = d10 + 1; i < nd; i++) {
                out[pos] = __dig[i];
                pos++;
            }
        } else {
            out[pos] = '0';
            pos++;
        }
    } else {
        out[pos] = '0';
        out[pos + 1] = '.';
        pos = pos + 2;
        for (int i = 0; i < -d10 - 1; i++) {
            out[pos] = '0';
            pos++;
        }
        for (int i = 0; i < nd; i++) {
            out[pos] = __dig[i];
            pos++;
        }
    }
    out[pos] = 0;
    return out;
}

// ---- printf with floating point --------------------------------------------------------------------------------------------------------------
// the body of one number (without sign) in `body`; returns its length. conv: f e g a (lower case), upper: E / G / A / F
int __float_body(int ax, int conv, int prec, bool alt, bool upper, char* body) {
    int n = 0;
    if (ax > 0x7FF0000000000000) {
        strcpy(body, "nan");
        n = 3;
    } else if (ax == 0x7FF0000000000000) {
        strcpy(body, "inf");
        n = 3;
    } else if (conv == 'a') {
        // hexadecimal
        int c = __funpack(ax);
        int mant;
        int ex;
        if (c == __F_ZERO) {
            mant = 0;
            ex = 0;
        } else {
            mant = ax & 0x000FFFFFFFFFFFFF;
            ex = (__fshr(ax, 52) & 0x7FF) - 1023;
        }
        int lead = 1;
        if (c == __F_ZERO) {
            lead = 0;
        } else if ((__fshr(ax, 52) & 0x7FF) == 0) {
            lead = 0;
            ex = -1022;
        }
        // 13 hex digits of fraction; round to prec digits if requested
        int nd = 13;
        if (prec >= 0 && prec < 13) {
            int drop = (13 - prec) * 4;
            int half = 1 << (drop - 1);
            int low = mant & ((1 << drop) - 1);
            mant = mant >> drop;
            if (low > half || (low == half && ((mant & 1) == 1 || (prec == 0 && lead == 1)))) {
                mant = mant + 1;
                if (mant >> (prec * 4) != 0 && prec * 4 < 52) {
                    // carry into the leading digit
                    mant = mant & ((1 << (prec * 4)) - 1);
                    lead = lead + 1;
                } else if (prec == 0) {
                    mant = 0;
                    lead = lead + 1;
                }
            }
            nd = prec;
        } else {
            // drop trailing zero digits when no precision was given
            if (prec < 0) {
                while (nd > 0 && (mant & 15) == 0) {
                    mant = mant >> 4;
                    nd--;
                }
            }
        }
        body[n] = '0';
        body[n + 1] = 'x';
        body[n + 2] = '0' + lead;
        n = n + 3;
        if (nd > 0 || alt || (prec > 13)) {
            body[n] = '.';
            n++;
        }
        for (int i = nd - 1; i >= 0; i--) {
            int h = (mant >> (i * 4)) & 15;
            if (h < 10) {
                body[n] = '0' + h;
            } else {
                body[n] = 'a' + h - 10;
            }
            n++;
        }
        for (int i = 13; i < prec; i++) {
            body[n] = '0';
            n++;
        }
        body[n] = 'p';
        if (ex < 0) {
            body[n + 1] = '-';
            ex = -ex;
        } else {
            body[n + 1] = '+';
        }
        n = n + 2;
        char tmp[8];
        intToStr(ex, &tmp[0]);
        strcpy(&body[n], tmp);
        n = n + strlen(tmp);
    } else if (conv == 'f') {
        if (prec < 0) { prec = 6; }
        if (prec > 600) { prec = 600; }
        __dtoa_fixed(ax, prec);
        int len = __ndig;
        // make sure there is at least one digit before the point
        int pad = 0;
        if (len <= prec) {
            pad = prec + 1 - len;
        }
        int intlen = len + pad - prec;
        int total = len + pad;
        for (int k = 0; k < total; k++) {
            if (k == intlen && prec > 0) {
                body[n] = '.';
                n++;
            }
            if (k < pad) {
                body[n] = '0';
            } else {
                body[n] = __dig[k - pad];
            }
            n++;
        }
        if (prec == 0 && alt) {
            body[n] = '.';
            n++;
        }
    } else if (conv == 'e') {
        if (prec < 0) { prec = 6; }
        if (prec > 600) { prec = 600; }
        __dtoa_sci(ax, prec);
        body[0] = __dig[0];
        n = 1;
        if (prec > 0 || alt) {
            body[n] = '.';
            n++;
        }
        for (int i = 1; i <= prec; i++) {
            body[n] = __dig[i];
            n++;
        }
        n = n + __exp_text(&body[n], __d10, upper);
    } else {
        // g
        int P = prec;
        if (P < 0) { P = 6; }
        if (P == 0) { P = 1; }
        if (P > 600) { P = 600; }
        __dtoa_sci(ax, P - 1);
        int X = __d10;
        int nd = P;
        if (!alt) {
            while (nd > 1 && __dig[nd - 1] == '0') {
                nd--;
            }
        }
        if (X < -4 || X >= P) {
            body[0] = __dig[0];
            n = 1;
            if (nd > 1 || alt) {
                body[n] = '.';
                n++;
            }
            for (int i = 1; i < nd; i++) {
                body[n] = __dig[i];
                n++;
            }
            n = n + __exp_text(&body[n], X, upper);
        } else if (X >= 0) {
            for (int i = 0; i <= X; i++) {
                body[n] = __dig[i];
                n++;
            }
            if (nd > X + 1 || alt) {
                body[n] = '.';
                n++;
            }
            for (int i = X + 1; i < nd; i++) {
                body[n] = __dig[i];
                n++;
            }
        } else {
            body[0] = '0';
            body[1] = '.';
            n = 2;
            for (int i = 0; i < -X - 1; i++) {
                body[n] = '0';
                n++;
            }
            for (int i = 0; i < nd; i++) {
                body[n] = __dig[i];
                n++;
            }
        }
    }
    body[n] = 0;
    if (upper) {
        for (int i = 0; i < n; i++) {
            if (body[i] >= 'a' && body[i] <= 'z') {
                body[i] = body[i] - 32;
            }
        }
    }
    return n;
}

// writes e+05 style text; returns the length
int __exp_text(char* b, int ex, bool upper) {
    b[0] = 'e';
    int n = 1;
    if (ex < 0) {
        b[n] = '-';
        ex = -ex;
    } else {
        b[n] = '+';
    }
    n++;
    if (ex < 10) {
        b[n] = '0';
        n++;
    }
    char tmp[8];
    intToStr(ex, &tmp[0]);
    int l = strlen(tmp);
    for (int i = 0; i <= l; i++) {
        b[n + i] = tmp[i];
    }
    return n + l;
}

// like vformat (see the standard library) and also %f %F %e %E %g %G %a %A: the matching value is the bit pattern of a double
int vformatd(char* out, int max, char* fmt, int* args, int nargs) {
    int ai = 0;
    int o = 0;
    int i = 0;
    while (fmt[i] != 0) {
        if (fmt[i] != '%') {
            o = __cat(out, max, o, &fmt[i], 1);
            i++;
            continue;
        }
        int start = i;
        i++;
        bool left = false;
        bool zero = false;
        bool plus = false;
        bool space = false;
        bool alt = false;
        bool again = true;
        while (again) {
            int f = fmt[i];
            if (f == '-') { left = true; }
            else if (f == '0') { zero = true; }
            else if (f == '+') { plus = true; }
            else if (f == ' ') { space = true; }
            else if (f == '#') { alt = true; }
            else { again = false; }
            if (again) { i++; }
        }
        int width = -1;
        if (fmt[i] == '*') {
            width = 0;
            if (ai < nargs) { width = args[ai]; }
            ai++;
            i++;
            if (width < 0) {
                left = true;
                width = -width;
            }
        } else if (fmt[i] >= '0' && fmt[i] <= '9') {
            width = 0;
            while (fmt[i] >= '0' && fmt[i] <= '9') {
                width = width * 10 + (fmt[i] - '0');
                i++;
            }
        }
        int prec = -1;
        if (fmt[i] == '.') {
            i++;
            prec = 0;
            if (fmt[i] == '*') {
                if (ai < nargs) { prec = args[ai]; }
                ai++;
                i++;
            } else {
                while (fmt[i] >= '0' && fmt[i] <= '9') {
                    prec = prec * 10 + (fmt[i] - '0');
                    i++;
                }
            }
        }
        int lenStart = i;
        while (fmt[i] == 'h' || fmt[i] == 'l' || fmt[i] == 'L' || fmt[i] == 'z' || fmt[i] == 'j' || fmt[i] == 't' || fmt[i] == 'q') {
            i++;
        }
        int conv = fmt[i];
        if (conv == 0) {
            o = __cat(out, max, o, &fmt[start], i - start);
            break;
        }
        i++;
        bool isfloat = conv == 'f' || conv == 'F' || conv == 'e' || conv == 'E' || conv == 'g' || conv == 'G' || conv == 'a' || conv == 'A';
        if (!isfloat) {
            // build a plain specification with explicit numbers and let vformat do it
            char spec[64];
            int sp = 0;
            spec[sp] = '%';
            sp++;
            if (left) { spec[sp] = '-'; sp++; }
            if (zero) { spec[sp] = '0'; sp++; }
            if (plus) { spec[sp] = '+'; sp++; }
            if (space) { spec[sp] = ' '; sp++; }
            if (alt) { spec[sp] = '#'; sp++; }
            if (width >= 0) { sp = sp + format(&spec[sp], 16, "%d", width); }
            if (prec >= 0) {
                spec[sp] = '.';
                sp++;
                sp = sp + format(&spec[sp], 16, "%d", prec);
            }
            for (int k = lenStart; k < i - 1; k++) {
                spec[sp] = fmt[k];
                sp++;
            }
            spec[sp] = conv;
            spec[sp + 1] = 0;
            int v[1];
            v[0] = 0;
            if (conv == '%') {
                o = __cat(out, max, o, "%", 1);
                continue;
            }
            if (ai < nargs) { v[0] = args[ai]; }
            ai++;
            char piece[1200];
            int pl = vformat(&piece[0], 1200, spec, &v[0], 1);
            if (pl > 1199) { pl = 1199; }
            o = __cat(out, max, o, &piece[0], pl);
            continue;
        }
        int bits = 0;
        if (ai < nargs) { bits = args[ai]; }
        ai++;
        bool upper = conv == 'F' || conv == 'E' || conv == 'G' || conv == 'A';
        int lc = conv;
        if (upper) { lc = conv + 32; }
        int ax = bits & 0x7FFFFFFFFFFFFFFF;
        int bp = prec;
        if (bp > 600) { bp = 600; }
        char* body = alloc(bp + 400);
        int blen = __float_body(ax, lc, bp, alt, upper, body);
        char sign = 0;
        if (bits < 0) { sign = '-'; }
        else if (plus) { sign = '+'; }
        else if (space) { sign = ' '; }
        int pre = 0;
        if (sign != 0) { pre = 1; }
        int hexpre = 0;
        if (lc == 'a' && ax <= 0x7FF0000000000000 && ax != 0x7FF0000000000000) {
            hexpre = 2;
        }
        int pad = width - pre - blen;
        if (pad < 0) { pad = 0; }
        bool finite = ax < 0x7FF0000000000000;
        if (!left && !(zero && finite)) {
            for (int k = 0; k < pad; k++) { o = __cat(out, max, o, " ", 1); }
        }
        if (sign != 0) { o = __cat(out, max, o, &sign, 1); }
        if (hexpre == 2) {
            o = __cat(out, max, o, body, 2);
        }
        if (!left && zero && finite) {
            for (int k = 0; k < pad; k++) { o = __cat(out, max, o, "0", 1); }
        }
        o = __cat(out, max, o, &body[hexpre], blen - hexpre);
        if (left) {
            for (int k = 0; k < pad; k++) { o = __cat(out, max, o, " ", 1); }
        }
    }
    if (max > 0) {
        if (o < max - 1) {
            out[o] = 0;
        } else {
            out[max - 1] = 0;
        }
    }
    return o;
}

int formatd(char* out, int max, char* fmt, int a = 0, int b = 0, int c = 0, int d = 0, int e = 0, int f = 0, int g = 0, int h = 0) {
    int args[8];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    args[4] = e;
    args[5] = f;
    args[6] = g;
    args[7] = h;
    int n = vformatd(out, max, fmt, &args[0], 8);
    if (n > max - 1) {
        n = max - 1;
    }
    return n;
}

int sprintfd(char* out, char* fmt, int a = 0, int b = 0, int c = 0, int d = 0, int e = 0, int f = 0, int g = 0, int h = 0) {
    int args[8];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    args[4] = e;
    args[5] = f;
    args[6] = g;
    args[7] = h;
    return vformatd(out, 0x7FFFFFFFFFFF, fmt, &args[0], 8);
}

int snprintfd(char* out, int size, char* fmt, int a = 0, int b = 0, int c = 0, int d = 0, int e = 0, int f = 0, int g = 0, int h = 0) {
    int args[8];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    args[4] = e;
    args[5] = f;
    args[6] = g;
    args[7] = h;
    return vformatd(out, size, fmt, &args[0], 8);
}

// printf to stdout with floating point support
int printfd(char* fmt, int a = 0, int b = 0, int c = 0, int d = 0, int e = 0, int f = 0, int g = 0, int h = 0) {
    int args[8];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    args[4] = e;
    args[5] = f;
    args[6] = g;
    args[7] = h;
    int len = vformatd(null, 0, fmt, &args[0], 8);
    char* buf = alloc(len + 1);
    vformatd(buf, len + 1, fmt, &args[0], 8);
    print(buf);
    return len;
}

// the same for standard error
int eprintfd(char* fmt, int a = 0, int b = 0, int c = 0, int d = 0, int e = 0, int f = 0, int g = 0, int h = 0) {
    int args[8];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    args[4] = e;
    args[5] = f;
    args[6] = g;
    args[7] = h;
    int len = vformatd(null, 0, fmt, &args[0], 8);
    char* buf = alloc(len + 1);
    vformatd(buf, len + 1, fmt, &args[0], 8);
    eprint(buf);
    return len;
}
