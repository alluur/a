// =============================================================================
//  bigint - arbitrary precision integers                     import bigint;
//
//    bigint.BigInt* f = bigint.factorial(50);
//    println(f->toString());            // 30414093201713378043612608166064768844377641568960512000000000000
//    bigint.BigInt* a = bigint.parse("123456789012345678901234567890");
//    bigint.BigInt* b = bigint.mul(a, a);
//
//  Numbers are immutable: every operation returns a new BigInt.
//  Division is by small numbers (below 2^31); there is no big / big division yet.
// =============================================================================
module bigint;

const BASE = 1000000000;                 // each limb holds 9 decimal digits

public class BigInt {
    public int* limb;                    // little endian limbs
    public int n;                        // number of limbs, at least 1
    public bool neg;

    public bool isZero() { return n == 1 && limb[0] == 0; }

    // number of decimal digits
    public int digits() {
        int d = (n - 1) * 9;
        int top = limb[n - 1];
        while (top > 0) {
            d++;
            top = top / 10;
        }
        if (d == 0) {
            return 1;
        }
        return d;
    }

    public char* toString() {
        char* out = alloc(n * 9 + 3);
        int o = 0;
        if (neg) {
            out[o] = '-';
            o++;
        }
        char tmp[24];
        intToStr(limb[n - 1], tmp);
        int l = strlen(tmp);
        memcpy(&out[o], tmp, l);
        o = o + l;
        for (int i = n - 2; i >= 0; i--) {
            format(&tmp[0], 24, "%09d", limb[i], 0, 0, 0);
            memcpy(&out[o], tmp, 9);
            o = o + 9;
        }
        return out;
    }

    // the value as an int; only meaningful when it fits in 63 bits
    public int toInt() {
        int v = 0;
        for (int i = n - 1; i >= 0; i--) {
            v = v * BASE + limb[i];
        }
        if (neg) {
            return -v;
        }
        return v;
    }
}

private BigInt* make(int limbs) {
    BigInt* r = new BigInt;
    r->limb = (int*) alloc(limbs * 8);
    r->n = limbs;
    return r;
}

// removes leading zero limbs; zero is never negative
private BigInt* trimmed(BigInt* r) {
    while (r->n > 1 && r->limb[r->n - 1] == 0) {
        r->n--;
    }
    if (r->isZero()) {
        r->neg = false;
    }
    return r;
}

public BigInt* fromInt(int v) {
    BigInt* r = make(3);
    bool neg = v < 0;
    // use the negative value so that the smallest int works too
    int m = v;
    if (!neg) {
        m = -v;
    }
    int i = 0;
    while (m != 0) {
        r->limb[i] = -(m % BASE);
        m = m / BASE;
        i++;
    }
    r->neg = neg;
    r->n = 3;
    return trimmed(r);
}

// parses [-]digits, null if the text is not a number
public BigInt* parse(char* s) {
    int i = 0;
    bool neg = false;
    if (s[0] == '-') {
        neg = true;
        i = 1;
    } else if (s[0] == '+') {
        i = 1;
    }
    int len = strlen(s) - i;
    if (len == 0) {
        return null;
    }
    for (int k = 0; k < len; k++) {
        if (!isDigit(s[i + k])) {
            return null;
        }
    }
    int limbs = (len + 8) / 9;
    BigInt* r = make(limbs);
    int end = len;
    for (int l = 0; l < limbs; l++) {
        int start = end - 9;
        if (start < 0) {
            start = 0;
        }
        int v = 0;
        for (int k = start; k < end; k++) {
            v = v * 10 + (s[i + k] - '0');
        }
        r->limb[l] = v;
        end = start;
    }
    r->neg = neg;
    return trimmed(r);
}

// compares absolute values: -1, 0 or 1
private int cmpMag(BigInt* a, BigInt* b) {
    if (a->n != b->n) {
        if (a->n < b->n) {
            return -1;
        }
        return 1;
    }
    for (int i = a->n - 1; i >= 0; i--) {
        if (a->limb[i] != b->limb[i]) {
            if (a->limb[i] < b->limb[i]) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

public int cmp(BigInt* a, BigInt* b) {
    if (a->neg != b->neg) {
        if (a->neg) {
            return -1;
        }
        return 1;
    }
    int c = cmpMag(a, b);
    if (a->neg) {
        return -c;
    }
    return c;
}

private BigInt* addMag(BigInt* a, BigInt* b) {
    int n = a->n;
    if (b->n > n) {
        n = b->n;
    }
    BigInt* r = make(n + 1);
    int carry = 0;
    for (int i = 0; i < n; i++) {
        int s = carry;
        if (i < a->n) {
            s = s + a->limb[i];
        }
        if (i < b->n) {
            s = s + b->limb[i];
        }
        if (s >= BASE) {
            s = s - BASE;
            carry = 1;
        } else {
            carry = 0;
        }
        r->limb[i] = s;
    }
    r->limb[n] = carry;
    return trimmed(r);
}

// |a| - |b| for |a| >= |b|
private BigInt* subMag(BigInt* a, BigInt* b) {
    BigInt* r = make(a->n);
    int borrow = 0;
    for (int i = 0; i < a->n; i++) {
        int d = a->limb[i] - borrow;
        if (i < b->n) {
            d = d - b->limb[i];
        }
        if (d < 0) {
            d = d + BASE;
            borrow = 1;
        } else {
            borrow = 0;
        }
        r->limb[i] = d;
    }
    return trimmed(r);
}

public BigInt* negate(BigInt* a) {
    BigInt* r = make(a->n);
    memcpy((char*) r->limb, (char*) a->limb, a->n * 8);
    r->neg = !a->neg;
    return trimmed(r);
}

public BigInt* add(BigInt* a, BigInt* b) {
    if (a->neg == b->neg) {
        BigInt* r = addMag(a, b);
        r->neg = a->neg;
        return trimmed(r);
    }
    int c = cmpMag(a, b);
    if (c == 0) {
        return fromInt(0);
    }
    if (c > 0) {
        BigInt* r = subMag(a, b);
        r->neg = a->neg;
        return trimmed(r);
    }
    BigInt* r = subMag(b, a);
    r->neg = b->neg;
    return trimmed(r);
}

public BigInt* sub(BigInt* a, BigInt* b) {
    BigInt* nb = negate(b);
    return add(a, nb);
}

public BigInt* mul(BigInt* a, BigInt* b) {
    BigInt* r = make(a->n + b->n);
    for (int i = 0; i < a->n; i++) {
        int carry = 0;
        for (int j = 0; j < b->n; j++) {
            int cur = r->limb[i + j] + a->limb[i] * b->limb[j] + carry;
            carry = cur / BASE;
            r->limb[i + j] = cur % BASE;
        }
        int k = i + b->n;
        while (carry > 0) {
            int cur = r->limb[k] + carry;
            carry = cur / BASE;
            r->limb[k] = cur % BASE;
            k++;
        }
    }
    r->neg = a->neg != b->neg;
    return trimmed(r);
}

// a * m for a small non-negative m (below 2^31)
public BigInt* mulSmall(BigInt* a, int m) {
    BigInt* r = make(a->n + 2);
    int carry = 0;
    for (int i = 0; i < a->n; i++) {
        int cur = a->limb[i] * m + carry;
        r->limb[i] = cur % BASE;
        carry = cur / BASE;
    }
    int k = a->n;
    while (carry > 0) {
        r->limb[k] = carry % BASE;
        carry = carry / BASE;
        k++;
    }
    r->neg = a->neg;
    return trimmed(r);
}

// a / d for a small positive d (below 2^31), rounding toward zero; the remainder goes to *rem
public BigInt* divSmall(BigInt* a, int d, int* rem) {
    BigInt* r = make(a->n);
    int carry = 0;
    for (int i = a->n - 1; i >= 0; i--) {
        int cur = carry * BASE + a->limb[i];
        r->limb[i] = cur / d;
        carry = cur % d;
    }
    r->neg = a->neg;
    *rem = carry;
    return trimmed(r);
}

public BigInt* pow(BigInt* a, int e) {
    BigInt* result = fromInt(1);
    BigInt* base = a;
    while (e > 0) {
        if (e & 1) {
            result = mul(result, base);
        }
        e = e >> 1;
        if (e > 0) {
            base = mul(base, base);
        }
    }
    return result;
}

public BigInt* factorial(int n) {
    BigInt* r = fromInt(1);
    for (int i = 2; i <= n; i++) {
        r = mulSmall(r, i);
    }
    return r;
}

// the n-th Fibonacci number
public BigInt* fibonacci(int n) {
    BigInt* a = fromInt(0);
    BigInt* b = fromInt(1);
    for (int i = 0; i < n; i++) {
        BigInt* t = add(a, b);
        a = b;
        b = t;
    }
    return a;
}
