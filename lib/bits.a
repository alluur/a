// =============================================================================
//  bits - bit tricks on the fixed width integers                                                                import bits;
//
//    bits.popcount(x)        number of 1 bits in a 64-bit value            bits.parity(x)       1 if that number is odd
//    bits.clz(x), bits.ctz(x)  leading / trailing zero bits of 64 bits (64 for 0)   bits.clz32(x), bits.ctz32(x)  the same for 32 bits
//    bits.log2(x)            position of the highest 1 bit (-1 for 0)       bits.isPow2(x)       exactly one bit set
//    bits.nextPow2(x)        smallest power of two >= x (1 for 0)           bits.mask(n)         the n lowest bits set (0..64)
//    bits.rotl32(x, n) rotr32 rotl64 rotr64                                  bits.rev8 rev16 rev32 rev64  reverse the bit order
//    bits.bswap16(x) bswap32(x) bswap64(x)                                   swap the byte order (big endian <-> little endian)
//    bits.get(x, i) set(x, i) clear(x, i) flip(x, i)                         single bits of a value
//    bits.field(x, lo, n)    the n bits starting at bit lo                   bits.insert(x, lo, n, v)  replace them with v
//    bits.signExtend(x, n)   the low n bits of x as a signed number          bits.fitsSigned(x, n)  fitsUnsigned(x, n)
//    bits.udiv(a, b) umod(a, b) ucmp(a, b)  unsigned 64-bit helpers on plain ints (uint64 variables do this by themselves)
//
//  Every function works on exactly the width in its name and ignores higher bits of narrower ones.
// =============================================================================
module bits;

public int popcount(int x) {
    uint64 v = x;
    v = v - ((v >> 1) & 0x5555555555555555);
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333);
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F;
    return (v * 0x0101010101010101) >> 56;
}

public int parity(int x) {
    return popcount(x) & 1;
}

public int clz(int x) {
    uint64 v = x;
    if (v == 0) { return 64; }
    int n = 0;
    if ((v >> 32) == 0) { n = n + 32; v = v << 32; }
    if ((v >> 48) == 0) { n = n + 16; v = v << 16; }
    if ((v >> 56) == 0) { n = n + 8; v = v << 8; }
    if ((v >> 60) == 0) { n = n + 4; v = v << 4; }
    if ((v >> 62) == 0) { n = n + 2; v = v << 2; }
    if ((v >> 63) == 0) { n = n + 1; }
    return n;
}

public int ctz(int x) {
    if (x == 0) { return 64; }
    return 63 - clz(x & -x);
}

public int clz32(int x) {
    uint32 v = x;
    if (v == 0) { return 32; }
    return clz(v) - 32;
}

public int ctz32(int x) {
    uint32 v = x;
    if (v == 0) { return 32; }
    return ctz(v);
}

public int log2(int x) {
    if (x == 0) { return -1; }
    return 63 - clz(x);
}

public bool isPow2(int x) {
    return x != 0 && (x & (x - 1)) == 0;
}

public int nextPow2(int x) {
    uint64 v = x;
    if (v <= 1) { return 1; }
    v = v - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    v = v | (v >> 32);
    return v + 1;
}

public int mask(int n) {
    if (n <= 0) { return 0; }
    if (n >= 64) { return -1; }
    return (1 << n) - 1;
}

public uint32 rotl32(uint32 x, int n) {
    n = n & 31;
    if (n == 0) { return x; }
    return (x << n) | (x >> (32 - n));
}

public uint32 rotr32(uint32 x, int n) {
    n = n & 31;
    if (n == 0) { return x; }
    return (x >> n) | (x << (32 - n));
}

public uint64 rotl64(uint64 x, int n) {
    n = n & 63;
    if (n == 0) { return x; }
    return (x << n) | (x >> (64 - n));
}

public uint64 rotr64(uint64 x, int n) {
    n = n & 63;
    if (n == 0) { return x; }
    return (x >> n) | (x << (64 - n));
}

public uint16 bswap16(uint16 x) {
    return ((x & 255) << 8) | (x >> 8);
}

public uint32 bswap32(uint32 x) {
    return ((x & 0xFF) << 24) | ((x & 0xFF00) << 8) | ((x >> 8) & 0xFF00) | (x >> 24);
}

public uint64 bswap64(uint64 x) {
    uint64 lo = bswap32(x & 0xFFFFFFFF);
    uint64 hi = bswap32(x >> 32);
    return (lo << 32) | hi;
}

public uint8 rev8(uint8 x) {
    int r = 0;
    for (int i = 0; i < 8; i++) {
        r = (r << 1) | ((x >> i) & 1);
    }
    return r;
}

public uint16 rev16(uint16 x) {
    return (rev8(x & 255) << 8) | rev8(x >> 8);
}

public uint32 rev32(uint32 x) {
    return (rev16(x & 0xFFFF) << 16) | rev16(x >> 16);
}

public uint64 rev64(uint64 x) {
    uint64 lo = rev32(x & 0xFFFFFFFF);
    uint64 hi = rev32(x >> 32);
    return (lo << 32) | hi;
}

public int get(int x, int i) {
    return (x >> i) & 1;
}

public int set(int x, int i) {
    return x | (1 << i);
}

public int clear(int x, int i) {
    return x & ~(1 << i);
}

public int flip(int x, int i) {
    return x ^ (1 << i);
}

// the n bits of x starting at bit lo, as a non-negative number
public int field(int x, int lo, int n) {
    uint64 v = x;
    v = v >> lo;
    if (n >= 64) { return v; }
    return v & ((1 << n) - 1);
}

// x with the n bits at lo replaced by the low n bits of v
public int insert(int x, int lo, int n, int v) {
    int m = mask(n);
    return (x & ~(m << lo)) | ((v & m) << lo);
}

// the low n bits of x as a signed number (n = 1 .. 64)
public int signExtend(int x, int n) {
    if (n >= 64) { return x; }
    int shift = 64 - n;
    return (x << shift) >> shift;
}

public bool fitsSigned(int x, int n) {
    if (n >= 64) { return true; }
    int lim = 1 << (n - 1);
    return x >= -lim && x < lim;
}

public bool fitsUnsigned(int x, int n) {
    if (x < 0) { return false; }
    if (n >= 63) { return true; }
    return x < (1 << n);
}

public int udiv(int a, int b) {
    uint64 x = a;
    uint64 y = b;
    return x / y;
}

public int umod(int a, int b) {
    uint64 x = a;
    uint64 y = b;
    return x % y;
}

// -1, 0 or 1 when a is below, equal to or above b as unsigned 64-bit numbers
public int ucmp(int a, int b) {
    uint64 x = a;
    uint64 y = b;
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}
