// =============================================================================
//  secure - secrets: the operating system's random generator, nonces, hex                         import secure;
//
//    char key[32];
//    if (secure.bytes(&key[0], 32)) ...        // from getrandom / /dev/urandom; false when there is none
//    secure.unique(&nonce[0])                   // 16 bytes that do not repeat (secure bytes, or a SHA-256 mix of a counter,
//                                               // the clock and an address when there is no secure generator)
//    char* h = secure.toHex(&key[0], 32);       // 64 hex characters
//    int n = secure.fromHex(h, &out[0], 64);    // bytes, -1 if the text is not hex
// =============================================================================
import hash;
module secure;

// Fills out with n bytes from the operating system's secure random generator (getrandom, or /dev/urandom). Returns false when
// there is none (Windows uses RtlGenRandom). Use it for keys and secrets.
public bool bytes(char* out, int n) {
    if (__OS == 1) {
        // RtlGenRandom (SystemFunction036 in ADVAPI32.DLL, IAT slot 70)
        int off = 0;
        while (off < n) {
            int chunk = n - off;
            if (chunk > 65536) { chunk = 65536; }
            if ((__winapi(70, (int) &out[off], chunk, 0, 0) & 255) == 0) {
                return false;
            }
            off = off + chunk;
        }
        return true;
    }
    int done = 0;
    while (done < n) {
        int got = __syscall(__ARCH == 0 ? 318 : 278, (int) &out[done], n - done, 0, 0, 0, 0);       // getrandom
        if (got <= 0) {
            break;
        }
        done = done + got;
    }
    if (done >= n) {
        return true;
    }
    int fd = __open("/dev/urandom", 0);
    if (fd < 0) {
        return false;
    }
    while (done < n) {
        int got = __syscall(__ARCH == 0 ? 0 : 63, fd, (int) &out[done], n - done, 0, 0, 0);          // read
        if (got <= 0) {
            break;
        }
        done = done + got;
    }
    __close(fd);
    return done >= n;
}

private int counter;

public void unique(char* out) {
    char* r = alloc(64);
    if (bytes(r, 32)) {
        for (int i = 0; i < 16; i++) { out[i] = r[i]; }
        return;
    }
    counter++;
    char seed[40];
    for (int i = 0; i < 40; i++) { seed[i] = 0; }
    int a = millis();
    int b = counter;
    int c = (int) r;
    for (int i = 0; i < 8; i++) {
        seed[i] = (a >> (i * 8)) & 255;
        seed[8 + i] = (b >> (i * 8)) & 255;
        seed[16 + i] = (c >> (i * 8)) & 255;
    }
    char* hex = hash.sha256(&seed[0], 40);
    for (int i = 0; i < 16; i++) { out[i] = hex[i]; }
}

public char* toHex(char* data, int n) {
    char* digits = "0123456789abcdef";
    char* t = alloc(n * 2 + 1);
    for (int i = 0; i < n; i++) {
        t[i * 2] = digits[(data[i] >> 4) & 15];
        t[i * 2 + 1] = digits[data[i] & 15];
    }
    t[n * 2] = 0;
    return t;
}

private int hexOf(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
    return -1;
}

// decodes hex text (trailing spaces and newlines are ignored) into out (at most max bytes); returns the number of bytes, -1 on error
public int fromHex(char* hex, char* out, int max) {
    int n = strlen(hex);
    while (n > 0 && (hex[n - 1] == 10 || hex[n - 1] == 13 || hex[n - 1] == 32)) {
        n--;
    }
    if (n % 2 != 0 || n / 2 > max) {
        return -1;
    }
    for (int i = 0; i < n / 2; i++) {
        int hi = hexOf(hex[i * 2]);
        int lo = hexOf(hex[i * 2 + 1]);
        if (hi < 0 || lo < 0) {
            return -1;
        }
        out[i] = hi * 16 + lo;
    }
    return n / 2;
}
