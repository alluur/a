// =============================================================================
//  clocale - C <locale.h>                                     import clocale;
//
//  A programs always run in the "C" locale (ASCII rules, decimal point '.', no digit grouping). setlocale accepts
//  "", "C", "POSIX" and names that end in ".UTF-8" / ".utf8" (text is UTF-8 anyway) and reports the locale as "C".
// =============================================================================

const LC_CTYPE = 0;
const LC_NUMERIC = 1;
const LC_TIME = 2;
const LC_COLLATE = 3;
const LC_MONETARY = 4;
const LC_MESSAGES = 5;
const LC_ALL = 6;

struct lconv {
    char* decimal_point;
    char* thousands_sep;
    char* grouping;
    char* int_curr_symbol;
    char* currency_symbol;
    char* mon_decimal_point;
    char* mon_thousands_sep;
    char* mon_grouping;
    char* positive_sign;
    char* negative_sign;
    int int_frac_digits;
    int frac_digits;
    int p_cs_precedes;
    int p_sep_by_space;
    int n_cs_precedes;
    int n_sep_by_space;
    int p_sign_posn;
    int n_sign_posn;
}

lconv __lconv_c;
bool __lconv_ready;

// the locale of category `category`; with a name it "sets" it. Returns "C", or null when the name is not known
char* setlocale(int category, char* locale) {
    if (category < 0 || category > 6) {
        return null;
    }
    if (locale == null || locale[0] == 0) {
        return "C";
    }
    if (streq(locale, "C") || streq(locale, "POSIX") || endsWith(locale, ".UTF-8") || endsWith(locale, ".utf8") || endsWith(locale, ".UTF8")) {
        return "C";
    }
    return null;
}

// number formatting conventions of the locale (the "C" ones)
lconv* localeconv() {
    if (!__lconv_ready) {
        __lconv_ready = true;
        __lconv_c.decimal_point = ".";
        __lconv_c.thousands_sep = "";
        __lconv_c.grouping = "";
        __lconv_c.int_curr_symbol = "";
        __lconv_c.currency_symbol = "";
        __lconv_c.mon_decimal_point = "";
        __lconv_c.mon_thousands_sep = "";
        __lconv_c.mon_grouping = "";
        __lconv_c.positive_sign = "";
        __lconv_c.negative_sign = "";
        __lconv_c.int_frac_digits = 255;
        __lconv_c.frac_digits = 255;
        __lconv_c.p_cs_precedes = 255;
        __lconv_c.p_sep_by_space = 255;
        __lconv_c.n_cs_precedes = 255;
        __lconv_c.n_sep_by_space = 255;
        __lconv_c.p_sign_posn = 255;
        __lconv_c.n_sign_posn = 255;
    }
    return &__lconv_c;
}
