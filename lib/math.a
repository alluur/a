// =============================================================================
//  math - integer mathematics                               import math;
//  (A has no floating point yet: everything works on 64-bit integers)
// =============================================================================
module math;

public int gcd(int a, int b) {
    a = abs(a);
    b = abs(b);
    while (b != 0) {
        int t = a % b;
        a = b;
        b = t;
    }
    return a;
}

public int lcm(int a, int b) {
    if (a == 0 || b == 0) {
        return 0;
    }
    return abs(a / gcd(a, b) * b);
}

// base ** exp for exp >= 0
public int pow(int base, int exp) {
    int r = 1;
    while (exp > 0) {
        if (exp & 1) {
            r = r * base;
        }
        base = base * base;
        exp = exp >> 1;
    }
    return r;
}

// (base ** exp) % m without overflow for m < 2^31
public int powMod(int base, int exp, int m) {
    int r = 1;
    base = base % m;
    while (exp > 0) {
        if (exp & 1) {
            r = r * base % m;
        }
        base = base * base % m;
        exp = exp >> 1;
    }
    return r;
}

// floor of the square root (0 for negative numbers)
public int isqrt(int n) {
    if (n <= 0) {
        return 0;
    }
    int lo = 0;
    int hi = 3037000499;               // sqrt of the largest 63 bit number
    if (n < hi) {
        hi = n;
    }
    while (lo < hi) {
        int mid = (lo + hi + 1) / 2;
        if (mid <= n / mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo;
}

public bool isPrime(int n) {
    if (n < 2) {
        return false;
    }
    if (n < 4) {
        return true;
    }
    if (n % 2 == 0 || n % 3 == 0) {
        return false;
    }
    for (int i = 5; i <= n / i; i = i + 6) {
        if (n % i == 0 || n % (i + 2) == 0) {
            return false;
        }
    }
    return true;
}

public int nextPrime(int n) {
    n++;
    while (!isPrime(n)) {
        n++;
    }
    return n;
}

// n! (overflows after 20)
public int factorial(int n) {
    int r = 1;
    for (int i = 2; i <= n; i++) {
        r = r * i;
    }
    return r;
}

// n-th Fibonacci number (fibonacci(0) = 0, fibonacci(1) = 1; fits up to 92)
public int fibonacci(int n) {
    int a = 0;
    int b = 1;
    for (int i = 0; i < n; i++) {
        int t = a + b;
        a = b;
        b = t;
    }
    return a;
}

// n over k
public int binomial(int n, int k) {
    if (k < 0 || k > n) {
        return 0;
    }
    if (k > n - k) {
        k = n - k;
    }
    int r = 1;
    for (int i = 1; i <= k; i++) {
        r = r * (n - k + i) / i;
    }
    return r;
}

public int clamp(int v, int lo, int hi) {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

public int sign(int x) {
    if (x < 0) {
        return -1;
    }
    if (x > 0) {
        return 1;
    }
    return 0;
}

// mathematical modulo: the result is always 0 .. m-1 for m > 0
public int mod(int a, int m) {
    int r = a % m;
    if (r < 0) {
        r = r + m;
    }
    return r;
}

// floor division (rounds toward minus infinity)
public int floorDiv(int a, int b) {
    int q = a / b;
    if (a % b != 0 && ((a < 0) != (b < 0))) {
        q--;
    }
    return q;
}

// number of set bits
public int popcount(int x) {
    int n = 0;
    while (x != 0) {
        x = x & (x - 1);
        n++;
    }
    return n;
}

// position of the highest set bit (ilog2(8) = 3), -1 for 0
public int ilog2(int x) {
    int n = -1;
    while (x > 0) {
        x = x >> 1;
        n++;
    }
    return n;
}

public int digitSum(int n) {
    n = abs(n);
    int s = 0;
    while (n > 0) {
        s = s + n % 10;
        n = n / 10;
    }
    return s;
}

// ---- arrays ------------------------------------------------------------------------------
public int sum(int* a, int n) {
    int s = 0;
    for (int i = 0; i < n; i++) {
        s = s + a[i];
    }
    return s;
}

public int minOf(int* a, int n) {
    int m = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < m) {
            m = a[i];
        }
    }
    return m;
}

public int maxOf(int* a, int n) {
    int m = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > m) {
            m = a[i];
        }
    }
    return m;
}

// ---- random numbers (uses std rand / srand) ----------------------------------------------------
// a number from lo to hi, both included
public int randRange(int lo, int hi) {
    return lo + rand() % (hi - lo + 1);
}

// shuffles an array in place
public void shuffle(int* a, int n) {
    for (int i = n - 1; i > 0; i--) {
        int j = rand() % (i + 1);
        int t = a[i];
        a[i] = a[j];
        a[j] = t;
    }
}
