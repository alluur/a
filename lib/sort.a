// =============================================================================
//  sort - sorting and searching                              import sort;
// =============================================================================
module sort;

private void insertion(int* a, int lo, int hi) {
    for (int i = lo + 1; i <= hi; i++) {
        int v = a[i];
        int j = i - 1;
        while (j >= lo && a[j] > v) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = v;
    }
}

private void quick(int* a, int lo, int hi) {
    while (hi - lo > 16) {
        // median of three pivot
        int mid = lo + (hi - lo) / 2;
        if (a[mid] < a[lo]) { int t = a[mid]; a[mid] = a[lo]; a[lo] = t; }
        if (a[hi] < a[lo]) { int t = a[hi]; a[hi] = a[lo]; a[lo] = t; }
        if (a[hi] < a[mid]) { int t = a[hi]; a[hi] = a[mid]; a[mid] = t; }
        int pivot = a[mid];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (a[i] < pivot) i++;
            while (a[j] > pivot) j--;
            if (i <= j) {
                int t = a[i]; a[i] = a[j]; a[j] = t;
                i++;
                j--;
            }
        }
        // recurse into the smaller part, loop on the bigger one (bounded stack depth)
        if (j - lo < hi - i) {
            quick(a, lo, j);
            lo = i;
        } else {
            quick(a, i, hi);
            hi = j;
        }
    }
    insertion(a, lo, hi);
}

// sorts n numbers in ascending order
public void sortInts(int* a, int n) {
    if (n > 1) {
        quick(a, 0, n - 1);
    }
}

public void reverseInts(int* a, int n) {
    for (int i = 0; i < n / 2; i++) {
        int t = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = t;
    }
}

public bool isSorted(int* a, int n) {
    for (int i = 1; i < n; i++) {
        if (a[i - 1] > a[i]) {
            return false;
        }
    }
    return true;
}

// index of key in a sorted array, or -1
public int binarySearch(int* a, int n, int key) {
    int lo = 0;
    int hi = n - 1;
    while (lo <= hi) {
        int mid = lo + (hi - lo) / 2;
        if (a[mid] == key) {
            return mid;
        }
        if (a[mid] < key) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

// sorts n strings alphabetically (by byte value); the strings themselves are not copied
public void sortStrings(char** a, int n) {
    for (int i = 1; i < n; i++) {
        char* v = a[i];
        int j = i - 1;
        while (j >= 0 && strcmp(a[j], v) > 0) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = v;
    }
}
