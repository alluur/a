// =============================================================================
//  net - TCP networking for A (IPv4)                       import net;
//
//  Works on Linux, Android and Windows with the same code:
//    * Linux / Android: socket system calls (numbers differ between x86-64 and ARM64)
//    * Windows: Winsock (ws2_32.dll) through the compiler's __winapi built-in
//
//  Handles are plain ints. Functions return a negative number on error.
//  Host names can be IPv4 addresses ("192.168.1.10"), "localhost" or real names ("example.org"): names are
//  resolved by resolve() (the system resolver on Windows, /etc/hosts and a DNS query over UDP on Linux/Android).
//
//    int  net.connect(host, port)          connect to a server
//    int  net.listen(port, backlog)        listen on all interfaces
//    int  net.listenOn(host, port, backlog)
//    int  net.accept(server)               wait for a client
//    int  net.send(h, buf, n)              sends all n bytes, returns n
//    bool net.sendText(h, text)
//    int  net.recv(h, buf, max)            bytes received, 0 = connection closed
//    int  net.recvLine(h, buf, max)        one line without the newline, -1 = closed
//    void net.close(h)
//    (a socket that tls.wrap() / tls.wrapServer() made secure sends and receives through TLS with the same calls;
//     rawSend / rawRecv / rawClose / rawWaitReadable bypass that)
//    char* net.httpGet(host, port, path)   very small HTTP/1.0 client, returns the body
//    int  net.parseIp(text)                "1.2.3.4" -> 0x01020304, -1 if invalid
//    int  net.resolve(host)                host name or address -> IPv4 address, -1 if unknown
//    void net.setTimeout(h, ms)            receive / send time limit of a socket (0 = none)
//    int  net.localPort(h)                 the port a socket is bound to
//    int  net.udpSocket()                  UDP datagram socket
//    int  net.udpBind(port)                UDP socket bound to a port (0 = pick a free one)
//    int  net.sendTo(h, ip, port, buf, n)  one datagram
//    int  net.recvFrom(h, buf, max, int* ip, int* port)   one datagram, -1 on error / timeout
//    int  net.dnsBuildQuery(name, id, buf) / net.dnsParseReply(buf, n, id)   the DNS packets themselves
//    void net.setDns(ip, port)             use this DNS server instead of the system's
//    int  net.poll(handles, events, revents, n, ms)   wait for several sockets at once (READABLE / WRITABLE)
//    bool net.waitReadable(h, ms) / waitWritable(h, ms)
//    int  net.connectTimeout(host, port, ms)          connect with a time limit
//    void net.shutdown(h, how)             0 = stop reading, 1 = stop writing, 2 = both
//    bool net.peer(h, &ip, &port)          address of the other side of a connection
//    void net.setNoDelay / setKeepAlive / setBroadcast / setReuse (h, on)    socket options
//    bool net.joinMulticast(h, group)      receive datagrams sent to a multicast group
//    char* net.hostName()                  name of this computer
// =============================================================================
module net;

const AF_INET = 2;
const SOCK_STREAM = 1;
const MSG_NOSIGNAL = 0x4000;

// import address table slots of the Windows ws2_32 functions
const WS_STARTUP = 40;
const WS_SOCKET = 41;
const WS_CONNECT = 42;
const WS_BIND = 43;
const WS_LISTEN = 44;
const WS_ACCEPT = 45;
const WS_SEND = 46;
const WS_RECV = 47;
const WS_CLOSE = 48;
const WS_SENDTO = 49;
const WS_RECVFROM = 50;
const WS_SETSOCKOPT = 51;
const WS_GETHOSTBYNAME = 52;
const WS_GETSOCKNAME = 53;
const SOCK_DGRAM = 2;
const WS_SHUTDOWN = 54;
const WS_GETPEERNAME = 55;
const WS_WSAPOLL = 56;
const WS_IOCTLSOCKET = 57;
const WS_GETSOCKOPT = 58;
const WS_GETHOSTNAME = 59;

// poll() events (the same numbers on every system, translated for Windows)
public const READABLE = 1;
public const WRITABLE = 4;
public const FAILED = 8;
public const HUNGUP = 16;

private bool started;
private char wsadata[512];

// system call number for the current CPU: x86-64 or ARM64
private int nr(int x64, int a64) {
    if (__ARCH >= 1) {
        return a64;
    }
    return x64;
}

// Winsock functions return a 32 bit int in eax: sign extend it
private int i32(int x) {
    return (x << 32) >> 32;
}

private bool windows() {
    return __OS == 1;
}

// starts Winsock on Windows (called automatically by the functions below)
public int init() {
    if (windows() && !started) {
        started = true;
        return i32(__winapi(WS_STARTUP, 0x202, &wsadata[0], 0, 0));
    }
    return 0;
}

// "127.0.0.1" -> 0x7F000001 (host order), "localhost" too; -1 if the text is not valid
public int parseIp(char* s) {
    if (streq(s, "localhost")) {
        return 0x7F000001;
    }
    int ip = 0;
    int parts = 0;
    int i = 0;
    while (parts < 4) {
        if (!isDigit(s[i])) {
            return -1;
        }
        int v = 0;
        while (isDigit(s[i])) {
            v = v * 10 + (s[i] - '0');
            if (v > 255) {
                return -1;
            }
            i++;
        }
        ip = ip * 256 + v;
        parts++;
        if (parts < 4) {
            if (s[i] != '.') {
                return -1;
            }
            i++;
        }
    }
    if (s[i] != 0) {
        return -1;
    }
    return ip;
}

// builds a struct sockaddr_in (16 bytes) for an IPv4 address and a port
private void fillAddr(char* sa, int ip, int port) {
    for (int i = 0; i < 16; i++) {
        sa[i] = 0;
    }
    sa[0] = AF_INET;
    sa[2] = (port >> 8) & 255;
    sa[3] = port & 255;
    sa[4] = (ip >> 24) & 255;
    sa[5] = (ip >> 16) & 255;
    sa[6] = (ip >> 8) & 255;
    sa[7] = ip & 255;
}

private int newSock(int type, int proto) {
    init();
    if (windows()) {
        int s = __winapi(WS_SOCKET, AF_INET, type, proto, 0);
        if (s == -1) {
            return -1;
        }
        return s;
    }
    return __syscall(nr(41, 198), AF_INET, type, 0, 0, 0, 0);
}

private int newSocket() {
    return newSock(SOCK_STREAM, 6);
}

// ---- secure handles: tls.wrap() registers a socket here, then send / recv / close / waitReadable go through TLS --------------------
private func secSend;
private func secRecv;
private func secClose;
private func secReadable;
private int secHandles[32];
private int secStreams[32];

// installed by the tls module (the hooks get the stream and the usual arguments)
public void secureHooks(func sendFn, func recvFn, func closeFn, func readableFn) {
    secSend = sendFn;
    secRecv = recvFn;
    secClose = closeFn;
    secReadable = readableFn;
}

// h now talks TLS through the stream (an opaque number the hooks understand)
public void secureAttach(int h, int stream) {
    for (int i = 0; i < 32; i++) {
        if (secStreams[i] == 0) {
            secHandles[i] = h;
            secStreams[i] = stream;
            return;
        }
    }
}

// the stream number tls.wrap gave to a handle, 0 for an ordinary socket
public int secureStream(int h) {
    return secureOf(h);
}

private int secureOf(int h) {
    for (int i = 0; i < 32; i++) {
        if (secStreams[i] != 0 && secHandles[i] == h) { return secStreams[i]; }
    }
    return 0;
}

private int secureDetach(int h) {
    for (int i = 0; i < 32; i++) {
        if (secStreams[i] != 0 && secHandles[i] == h) {
            int st = secStreams[i];
            secStreams[i] = 0;
            return st;
        }
    }
    return 0;
}

public void close(int h) {
    int st = secureDetach(h);
    if (st != 0) {
        secClose(st);
    }
    rawClose(h);
}

public void rawClose(int h) {
    if (windows()) {
        __winapi(WS_CLOSE, h, 0, 0, 0);
    } else {
        __syscall(nr(3, 57), h, 0, 0, 0, 0, 0);
    }
}

// connects to host:port, returns a handle or a negative number
public int connect(char* host, int port) {
    int ip = resolve(host);
    if (ip < 0) {
        return -1;
    }
    int s = newSocket();
    if (s < 0) {
        return s;
    }
    char sa[16];
    fillAddr(&sa[0], ip, port);
    int r;
    if (windows()) {
        r = i32(__winapi(WS_CONNECT, s, &sa[0], 16, 0));
    } else {
        r = __syscall(nr(42, 203), s, &sa[0], 16, 0, 0, 0);
    }
    if (r < 0) {
        close(s);
        return -1;
    }
    return s;
}

// starts a server on host:port ("0.0.0.0" = every interface)
public int listenOn(char* host, int port, int backlog) {
    int ip = parseIp(host);
    if (ip < 0) {
        return -1;
    }
    int s = newSocket();
    if (s < 0) {
        return s;
    }
    if (!windows()) {
        int one = 1;
        __syscall(nr(54, 208), s, 1, 2, &one, 4, 0);          // SOL_SOCKET, SO_REUSEADDR
    }
    char sa[16];
    fillAddr(&sa[0], ip, port);
    int r;
    if (windows()) {
        r = i32(__winapi(WS_BIND, s, &sa[0], 16, 0));
    } else {
        r = __syscall(nr(49, 200), s, &sa[0], 16, 0, 0, 0);
    }
    if (r < 0) {
        close(s);
        return -1;
    }
    if (windows()) {
        r = i32(__winapi(WS_LISTEN, s, backlog, 0, 0));
    } else {
        r = __syscall(nr(50, 201), s, backlog, 0, 0, 0, 0);
    }
    if (r < 0) {
        close(s);
        return -1;
    }
    return s;
}

public int listen(int port, int backlog) {
    return listenOn("0.0.0.0", port, backlog);
}

// waits for a client, returns its handle or a negative number
public int accept(int server) {
    if (windows()) {
        int c = __winapi(WS_ACCEPT, server, 0, 0, 0);
        if (c == -1) {
            return -1;
        }
        return c;
    }
    return __syscall(nr(43, 202), server, 0, 0, 0, 0, 0);
}

// sends exactly n bytes; returns n, or a negative number on error
public int send(int h, char* buf, int n) {
    int st = secureOf(h);
    if (st != 0) { return secSend(st, buf, n); }
    return rawSend(h, buf, n);
}

// the same without TLS (what the tls module itself uses)
public int rawSend(int h, char* buf, int n) {
    int done = 0;
    while (done < n) {
        int r;
        if (windows()) {
            r = i32(__winapi(WS_SEND, h, buf + done, n - done, 0));
        } else {
            r = __syscall(nr(44, 206), h, buf + done, n - done, MSG_NOSIGNAL, 0, 0);
        }
        if (r <= 0) {
            return -1;
        }
        done = done + r;
    }
    return n;
}

public bool sendText(int h, char* text) {
    int n = strlen(text);
    return send(h, text, n) == n;
}

// receives up to max bytes: >0 bytes, 0 when the other side closed, <0 on error
public int recv(int h, char* buf, int max) {
    int st = secureOf(h);
    if (st != 0) { return secRecv(st, buf, max); }
    return rawRecv(h, buf, max);
}

public int rawRecv(int h, char* buf, int max) {
    if (windows()) {
        return i32(__winapi(WS_RECV, h, buf, max, 0));
    }
    return __syscall(nr(45, 207), h, buf, max, 0, 0, 0);
}

// reads one line (the "\r\n" or "\n" is removed). Returns its length, -1 if closed before any byte
public int recvLine(int h, char* buf, int max) {
    int n = 0;
    char c;
    while (n < max - 1) {
        int r = recv(h, &c, 1);
        if (r <= 0) {
            if (n == 0) {
                return -1;
            }
            break;
        }
        if (c == 10) {
            break;
        }
        if (c != 13) {
            buf[n] = c;
            n++;
        }
    }
    buf[n] = 0;
    return n;
}

// minimal HTTP/1.0 GET: returns the response body as a heap string, or null on error
public char* httpGet(char* host, int port, char* path) {
    int h = connect(host, port);
    if (h < 0) {
        return null;
    }
    sendText(h, "GET ");
    sendText(h, path);
    sendText(h, " HTTP/1.0\r\nHost: ");
    sendText(h, host);
    sendText(h, "\r\nConnection: close\r\n\r\n");
    char* start = &__heap[__heap_pos];
    int len = 0;
    int room = 64 * 1024 * 1024 - __heap_pos - 16;
    for (;;) {
        int r = recv(h, &start[len], room - len);
        if (r <= 0) {
            break;
        }
        len = len + r;
    }
    close(h);
    start[len] = 0;
    __heap_pos = (__heap_pos + len + 16) & ~15;
    // skip the headers
    for (int i = 0; i + 3 < len; i++) {
        if (start[i] == 13 && start[i + 1] == 10 && start[i + 2] == 13 && start[i + 3] == 10) {
            return &start[i + 4];
        }
    }
    return start;
}


// ---- sockets: time limits, port, UDP ---------------------------------------------------------------------------------------
// receive and send time limit in milliseconds (0 = wait forever)
public void setTimeout(int h, int ms) {
    if (windows()) {
        int v = ms;
        __winapix(WS_SETSOCKOPT, h, 0xFFFF, 0x1006, &v, 4, 0, 0, 0, 0, 0);   // SO_RCVTIMEO (a DWORD in ms)
        __winapix(WS_SETSOCKOPT, h, 0xFFFF, 0x1005, &v, 4, 0, 0, 0, 0, 0);
        return;
    }
    int tv[2];
    tv[0] = ms / 1000;
    tv[1] = (ms % 1000) * 1000;
    __syscall(nr(54, 208), h, 1, 20, &tv[0], 16, 0);               // SOL_SOCKET, SO_RCVTIMEO
    __syscall(nr(54, 208), h, 1, 21, &tv[0], 16, 0);               // SO_SNDTIMEO
}

// the local port of a socket (useful after udpBind(0) / listen on port 0), -1 on error
public int localPort(int h) {
    char sa[16];
    int len = 16;
    int r;
    if (windows()) {
        r = i32(__winapi(WS_GETSOCKNAME, h, &sa[0], &len, 0));
    } else {
        r = __syscall(nr(51, 204), h, &sa[0], &len, 0, 0, 0);
    }
    if (r < 0) {
        return -1;
    }
    return sa[2] * 256 + sa[3];
}

public int udpSocket() {
    return newSock(SOCK_DGRAM, 17);
}

// a UDP socket that receives on every interface at the port (0 = a free port, see localPort)
public int udpBind(int port) {
    int s = udpSocket();
    if (s < 0) {
        return s;
    }
    char sa[16];
    fillAddr(&sa[0], 0, port);
    int r;
    if (windows()) {
        r = i32(__winapi(WS_BIND, s, &sa[0], 16, 0));
    } else {
        r = __syscall(nr(49, 200), s, &sa[0], 16, 0, 0, 0);
    }
    if (r < 0) {
        close(s);
        return -1;
    }
    return s;
}

// sends one datagram to ip:port ("1.2.3.4" parsed by parseIp / resolve). Returns the bytes sent or -1
public int sendTo(int h, int ip, int port, char* buf, int n) {
    char sa[16];
    fillAddr(&sa[0], ip, port);
    if (windows()) {
        return i32(__winapix(WS_SENDTO, h, buf, n, 0, &sa[0], 16, 0, 0, 0, 0));
    }
    return __syscall(nr(44, 206), h, buf, n, 0, &sa[0], 16);
}

// receives one datagram (max bytes at most); the sender's address goes to *ip and *port (either can be null).
// Returns its length or -1 on error / time out
public int recvFrom(int h, char* buf, int max, int* ip, int* port) {
    char sa[16];
    int len = 16;
    int r;
    if (windows()) {
        r = i32(__winapix(WS_RECVFROM, h, buf, max, 0, &sa[0], &len, 0, 0, 0, 0));
    } else {
        r = __syscall(nr(45, 207), h, buf, max, 0, &sa[0], &len);
    }
    if (r < 0) {
        return -1;
    }
    if (ip != null) {
        *ip = (sa[4] << 24) | (sa[5] << 16) | (sa[6] << 8) | sa[7];
    }
    if (port != null) {
        *port = sa[2] * 256 + sa[3];
    }
    return r;
}

// ---- DNS ------------------------------------------------------------------------------------------------------------------------
private int dnsServerIp;
private int dnsServerPort = 53;
private int dnsNextId = 4711;

// uses this DNS server ("8.8.8.8", 53) for names instead of the servers of the system
public void setDns(char* ip, int port) {
    dnsServerIp = parseIp(ip);
    dnsServerPort = port;
}

// builds a DNS query for the A record of a name. Returns the packet length, -1 if the name is not valid
public int dnsBuildQuery(char* name, int id, char* buf) {
    for (int i = 0; i < 12; i++) {
        buf[i] = 0;
    }
    buf[0] = (id >> 8) & 255;
    buf[1] = id & 255;
    buf[2] = 1;                                // recursion desired
    buf[5] = 1;                                // one question
    int pos = 12;
    int labelAt = pos;
    pos++;
    int len = 0;
    int i = 0;
    for (;;) {
        char c = name[i];
        if (c == '.' || c == 0) {
            if (len == 0 || len > 63) {
                return -1;
            }
            buf[labelAt] = len;
            if (c == 0) {
                break;
            }
            labelAt = pos;
            pos++;
            len = 0;
        } else {
            if (pos > 500) {
                return -1;
            }
            buf[pos] = c;
            pos++;
            len++;
        }
        i++;
    }
    buf[pos] = 0;
    buf[pos + 1] = 0;
    buf[pos + 2] = 1;                          // type A
    buf[pos + 3] = 0;
    buf[pos + 4] = 1;                          // class IN
    return pos + 5;
}

// skips a (possibly compressed) name at pos, returns the position after it or -1
private int dnsSkipName(char* b, int n, int pos) {
    while (pos < n) {
        int l = b[pos];
        if (l == 0) {
            return pos + 1;
        }
        if ((l & 0xC0) == 0xC0) {
            return pos + 2;
        }
        pos = pos + l + 1;
    }
    return -1;
}

// finds the first A record of a reply. Returns the address (host order) or -1
public int dnsParseReply(char* b, int n, int id) {
    if (n < 12) {
        return -1;
    }
    if (b[0] * 256 + b[1] != id) {
        return -1;
    }
    if ((b[2] & 0x80) == 0 || (b[3] & 15) != 0) {
        return -1;
    }
    int qd = b[4] * 256 + b[5];
    int an = b[6] * 256 + b[7];
    int pos = 12;
    for (int i = 0; i < qd; i++) {
        pos = dnsSkipName(b, n, pos);
        if (pos < 0) {
            return -1;
        }
        pos = pos + 4;
    }
    for (int i = 0; i < an; i++) {
        pos = dnsSkipName(b, n, pos);
        if (pos < 0 || pos + 10 > n) {
            return -1;
        }
        int type = b[pos] * 256 + b[pos + 1];
        int cls = b[pos + 2] * 256 + b[pos + 3];
        int rd = b[pos + 8] * 256 + b[pos + 9];
        pos = pos + 10;
        if (pos + rd > n) {
            return -1;
        }
        if (type == 1 && cls == 1 && rd == 4) {
            return (b[pos] << 24) | (b[pos + 1] << 16) | (b[pos + 2] << 8) | b[pos + 3];
        }
        pos = pos + rd;
    }
    return -1;
}

// asks one DNS server, returns the address or -1
private int dnsAsk(int server, int port, char* name) {
    int s = udpSocket();
    if (s < 0) {
        return -1;
    }
    setTimeout(s, 2000);
    char q[600];
    dnsNextId = (dnsNextId * 75 + 74) & 0xFFFF;
    int id = dnsNextId;
    int n = dnsBuildQuery(name, id, &q[0]);
    if (n < 0) {
        close(s);
        return -1;
    }
    int ip = -1;
    for (int attempt = 0; attempt < 2 && ip < 0; attempt++) {
        if (sendTo(s, server, port, &q[0], n) == n) {
            char r[600];
            int got = recvFrom(s, &r[0], 600, null, null);
            if (got > 0) {
                ip = dnsParseReply(&r[0], got, id);
            }
        }
    }
    close(s);
    return ip;
}

// looks a name up in /etc/hosts (Linux / Android)
private int hostsLookup(char* name) {
    char* text = readFile("/etc/hosts");
    if (text == null) {
        return -1;
    }
    int i = 0;
    while (text[i] != 0) {
        // one line: address, then names, '#' starts a comment
        int ls = i;
        while (text[i] != 0 && text[i] != 10) {
            i++;
        }
        int le = i;
        if (text[i] == 10) {
            i++;
        }
        int j = ls;
        while (j < le && (text[j] == ' ' || text[j] == 9)) {
            j++;
        }
        if (j >= le || text[j] == '#') {
            continue;
        }
        char addr[64];
        int k = 0;
        while (j < le && text[j] != ' ' && text[j] != 9 && k < 63) {
            addr[k] = text[j];
            k++;
            j++;
        }
        addr[k] = 0;
        int ip = parseIp(&addr[0]);
        if (ip < 0) {
            continue;
        }
        while (j < le && text[j] != '#') {
            while (j < le && (text[j] == ' ' || text[j] == 9)) {
                j++;
            }
            char nm[256];
            k = 0;
            while (j < le && text[j] != ' ' && text[j] != 9 && text[j] != '#' && k < 255) {
                nm[k] = text[j];
                k++;
                j++;
            }
            nm[k] = 0;
            if (k > 0 && streq(&nm[0], name)) {
                return ip;
            }
        }
    }
    return -1;
}

// the host name or address as an IPv4 address (host order), -1 if it cannot be found
public int resolve(char* host) {
    int ip = parseIp(host);
    if (ip >= 0) {
        return ip;
    }
    if (windows()) {
        init();
        int p = __winapi(WS_GETHOSTBYNAME, host, 0, 0, 0);
        if (p == 0) {
            return -1;
        }
        char* ent = p;
        int* lp = &ent[24];                            // h_addr_list
        int lst = *lp;
        if (lst == 0) {
            return -1;
        }
        int* ep = lst;
        int a0 = *ep;
        if (a0 == 0) {
            return -1;
        }
        char* b = a0;
        return (b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3];
    }
    ip = hostsLookup(host);
    if (ip >= 0) {
        return ip;
    }
    if (dnsServerIp != 0) {
        return dnsAsk(dnsServerIp, dnsServerPort, host);
    }
    // the name servers of the system (resolv.conf), then two public ones
    char* conf = readFile("/etc/resolv.conf");
    if (conf != null) {
        int i = 0;
        while (conf[i] != 0) {
            if (startsWith(&conf[i], "nameserver")) {
                int j = i + 10;
                while (conf[j] == ' ' || conf[j] == 9) {
                    j++;
                }
                char a[64];
                int k = 0;
                while (conf[j] != 0 && conf[j] != 10 && conf[j] != ' ' && k < 63) {
                    a[k] = conf[j];
                    k++;
                    j++;
                }
                a[k] = 0;
                int srv = parseIp(&a[0]);
                if (srv >= 0) {
                    ip = dnsAsk(srv, 53, host);
                    if (ip >= 0) {
                        return ip;
                    }
                }
            }
            while (conf[i] != 0 && conf[i] != 10) {
                i++;
            }
            if (conf[i] == 10) {
                i++;
            }
        }
    }
    ip = dnsAsk(0x08080808, 53, host);
    if (ip >= 0) {
        return ip;
    }
    return dnsAsk(0x01010101, 53, host);
}


// ---- waiting for many sockets, connection details, options ------------------------------------------------------------------
// Waits until one of the n sockets in handles[] is ready for what events[] asks (READABLE, WRITABLE, or both added).
// revents[] receives what happened (READABLE / WRITABLE / FAILED / HUNGUP). ms < 0 waits forever.
// Returns the number of ready sockets, 0 on time out, negative on error.
char pollBuf[4112];

public int poll(int* handles, int* events, int* revents, int n, int ms) {
    if (n <= 0) {
        return 0;
    }
    init();
    int stride = 8;
    if (windows()) {
        stride = 16;
    }
    if (n > 256) {
        n = 256;
    }
    char* fds = &pollBuf[0];                       // a static buffer: a server polls many times a second
    for (int i = 0; i < n; i++) {
        char* f = &fds[i * stride];
        int ev = 0;
        if (windows()) {
            f[0] = handles[i] & 255;
            f[1] = (handles[i] >> 8) & 255;
            f[2] = (handles[i] >> 16) & 255;
            f[3] = (handles[i] >> 24) & 255;
            if ((events[i] & READABLE) != 0) ev = ev | 0x100;           // POLLRDNORM
            if ((events[i] & WRITABLE) != 0) ev = ev | 0x10;            // POLLWRNORM
            f[8] = ev & 255;
            f[9] = (ev >> 8) & 255;
        } else {
            f[0] = handles[i] & 255;
            f[1] = (handles[i] >> 8) & 255;
            f[2] = (handles[i] >> 16) & 255;
            f[3] = (handles[i] >> 24) & 255;
            if ((events[i] & READABLE) != 0) ev = ev | 1;
            if ((events[i] & WRITABLE) != 0) ev = ev | 4;
            f[4] = ev & 255;
            f[5] = (ev >> 8) & 255;
        }
    }
    int r;
    if (windows()) {
        r = i32(__winapi(WS_WSAPOLL, fds, n, ms, 0));
    } else {
        int ts[2];
        int* tp = null;
        if (ms >= 0) {
            ts[0] = ms / 1000;
            ts[1] = (ms % 1000) * 1000000;
            tp = &ts[0];
        }
        r = __syscall(nr(271, 73), fds, n, tp, 0, 0, 0);          // ppoll
    }
    if (r < 0) {
        return -1;
    }
    for (int i = 0; i < n; i++) {
        char* f = &fds[i * stride];
        int re;
        int out = 0;
        if (windows()) {
            re = f[10] | (f[11] << 8);
            if ((re & 0x300) != 0) out = out | READABLE;                // POLLRDNORM | POLLRDBAND
            if ((re & 0x30) != 0) out = out | WRITABLE;
            if ((re & 1) != 0) out = out | FAILED;                      // POLLERR
            if ((re & 2) != 0) out = out | HUNGUP;                      // POLLHUP
        } else {
            re = f[6] | (f[7] << 8);
            if ((re & 1) != 0) out = out | READABLE;
            if ((re & 4) != 0) out = out | WRITABLE;
            if ((re & 8) != 0) out = out | FAILED;
            if ((re & 16) != 0) out = out | HUNGUP;
        }
        revents[i] = out;
    }
    return r;
}

// true if the socket has data (or a pending connection / a closed peer) within ms milliseconds
public bool waitReadable(int h, int ms) {
    int st = secureOf(h);
    if (st != 0 && secReadable(st) != 0) { return true; }
    return rawWaitReadable(h, ms);
}

public bool rawWaitReadable(int h, int ms) {
    int hh[1]; int ev[1]; int re[1];
    hh[0] = h; ev[0] = READABLE;
    return poll(&hh[0], &ev[0], &re[0], 1, ms) > 0;
}

public bool waitWritable(int h, int ms) {
    int hh[1]; int ev[1]; int re[1];
    hh[0] = h; ev[0] = WRITABLE;
    return poll(&hh[0], &ev[0], &re[0], 1, ms) > 0;
}

// how = 0: no more reading, 1: no more writing (the other side sees the end of the data), 2: both
public void shutdown(int h, int how) {
    if (windows()) {
        __winapi(WS_SHUTDOWN, h, how, 0, 0);
    } else {
        __syscall(nr(48, 210), h, how, 0, 0, 0, 0);
    }
}

// the address and port of the other side of a connected socket
public bool peer(int h, int* ip, int* port) {
    char sa[16];
    int len = 16;
    int r;
    if (windows()) {
        r = i32(__winapi(WS_GETPEERNAME, h, &sa[0], &len, 0));
    } else {
        r = __syscall(nr(52, 205), h, &sa[0], &len, 0, 0, 0);
    }
    if (r < 0) {
        return false;
    }
    if (ip != null) {
        *ip = (sa[4] << 24) | (sa[5] << 16) | (sa[6] << 8) | sa[7];
    }
    if (port != null) {
        *port = sa[2] * 256 + sa[3];
    }
    return true;
}

// the local address of a connected socket (the interface the connection uses)
public int localIp(int h) {
    char sa[16];
    int len = 16;
    int r;
    if (windows()) {
        r = i32(__winapi(WS_GETSOCKNAME, h, &sa[0], &len, 0));
    } else {
        r = __syscall(nr(51, 204), h, &sa[0], &len, 0, 0, 0);
    }
    if (r < 0) {
        return -1;
    }
    return (sa[4] << 24) | (sa[5] << 16) | (sa[6] << 8) | sa[7];
}

private bool setOpt(int h, int levelLinux, int levelWin, int optLinux, int optWin, int value) {
    int v = value;
    int r;
    if (windows()) {
        r = i32(__winapix(WS_SETSOCKOPT, h, levelWin, optWin, &v, 4, 0, 0, 0, 0, 0));
    } else {
        r = __syscall(nr(54, 208), h, levelLinux, optLinux, &v, 4, 0);
    }
    return r >= 0;
}

public bool setNoDelay(int h, bool on) {                  // TCP_NODELAY: send small packets at once
    return setOpt(h, 6, 6, 1, 1, on ? 1 : 0);
}

public bool setKeepAlive(int h, bool on) {
    return setOpt(h, 1, 0xFFFF, 9, 8, on ? 1 : 0);
}

public bool setBroadcast(int h, bool on) {                // UDP: allow sending to 255.255.255.255
    return setOpt(h, 1, 0xFFFF, 6, 0x20, on ? 1 : 0);
}

public bool setReuse(int h, bool on) {                    // SO_REUSEADDR
    return setOpt(h, 1, 0xFFFF, 2, 4, on ? 1 : 0);
}

// receive datagrams that are sent to a multicast group address (224.0.0.0 .. 239.255.255.255) on any interface
public bool joinMulticast(int h, int group) {
    char mreq[8];
    mreq[0] = (group >> 24) & 255;
    mreq[1] = (group >> 16) & 255;
    mreq[2] = (group >> 8) & 255;
    mreq[3] = group & 255;
    mreq[4] = 0; mreq[5] = 0; mreq[6] = 0; mreq[7] = 0;
    int r;
    if (windows()) {
        r = i32(__winapix(WS_SETSOCKOPT, h, 0, 12, &mreq[0], 8, 0, 0, 0, 0, 0));
    } else {
        r = __syscall(nr(54, 208), h, 0, 35, &mreq[0], 8, 0);
    }
    return r >= 0;
}

// the name of this computer
public char* hostName() {
    char* buf = alloc(260);
    if (windows()) {
        init();
        __winapi(WS_GETHOSTNAME, buf, 255, 0, 0);
        return buf;
    }
    char* u = alloc(400);                                      // struct utsname: 6 fields of 65 bytes
    __syscall(nr(63, 160), u, 0, 0, 0, 0, 0);
    for (int i = 0; i < 64; i++) {
        buf[i] = u[65 + i];
    }
    return buf;
}

private void setBlocking(int s, bool blocking) {
    if (windows()) {
        int mode = 0;
        if (!blocking) {
            mode = 1;
        }
        __winapi(WS_IOCTLSOCKET, s, 0x8004667E, &mode, 0);            // FIONBIO
        return;
    }
    int flags = __syscall(nr(72, 25), s, 3, 0, 0, 0, 0);              // F_GETFL
    if (blocking) {
        flags = flags & ~0x800;
    } else {
        flags = flags | 0x800;                                        // O_NONBLOCK
    }
    __syscall(nr(72, 25), s, 4, flags, 0, 0, 0);                      // F_SETFL
}

// like connect, but gives up after ms milliseconds (-1 on failure or time out)
public int connectTimeout(char* host, int port, int ms) {
    int ip = resolve(host);
    if (ip < 0) {
        return -1;
    }
    int s = newSocket();
    if (s < 0) {
        return s;
    }
    setBlocking(s, false);
    char sa[16];
    fillAddr(&sa[0], ip, port);
    int r;
    if (windows()) {
        r = i32(__winapi(WS_CONNECT, s, &sa[0], 16, 0));
    } else {
        r = __syscall(nr(42, 203), s, &sa[0], 16, 0, 0, 0);
    }
    if (r < 0) {
        // in progress? (Linux: -115 EINPROGRESS, Windows: -1 with WSAEWOULDBLOCK)
        if (!windows() && r != -115) {
            close(s);
            return -1;
        }
        if (!waitWritable(s, ms)) {
            close(s);
            return -1;
        }
        int err = 0;
        int len = 4;
        if (windows()) {
            __winapix(WS_GETSOCKOPT, s, 0xFFFF, 0x1007, &err, &len, 0, 0, 0, 0, 0);     // SO_ERROR
        } else {
            __syscall(nr(55, 209), s, 1, 4, &err, &len, 0);
        }
        err = err & 0xFFFFFFFF;
        if (err != 0) {
            close(s);
            return -1;
        }
    }
    setBlocking(s, true);
    return s;
}
