// =============================================================================
//  ds - data structures                                                                                     import ds;
//
//  Containers (all hold ints; texts and pointers fit in an int, see the text variants)
//    ds.Deque            double ended queue:          d.pushBack(v) pushFront popBack popFront front back get(i) set insertAt(i, v) removeAt(i) indexOf
//    ds.RingBuffer       fixed capacity FIFO:         r.push(v) (overwrites the oldest when full, or refuses) pop peek get(i) fromNewest(i) overwritten
//    ds.ByteRing         fixed capacity byte FIFO:    b.write(p, n) read(p, n) peek skip available space dropped
//    ds.BinaryHeap       priority queue with handles: h.push(key, value) -> handle, peek pop popValue update(handle, newKey) remove(handle) merge(other)
//    ds.PriorityQueue    the same with enqueue(priority, value) / dequeue()
//    ds.OrderedMap       AVL tree map: put get has remove find floorNode ceilNode lowerNode higherNode rank select range countRange forEach
//    ds.OrderedSet       the same for keys only (foreach works);   ds.OrderedTextMap / ds.OrderedTextSet: text keys
//    ds.HashMap          open addressing hash map, int keys:  put get has remove add(key, delta) first/next iteration, shrink;  ds.TextHashMap text keys
//    ds.HashSet / ds.TextHashSet
//    ds.Trie             text keys: put get remove countPrefix walkPrefix collect longestPrefixOf walkWildcard / countWildcard (? and *)
//    ds.DisjointSet      union-find: find unite same sizeOf labels add
//    ds.BitSet           packed bits: set get flip setRange count nextSet nextClear prevSet orWith andWith xorWith andNotWith
//    ds.Fenwick          prefix sums: add(i, d) prefix(i) sum(l, r) lowerBound(target) build;  ds.RangeFenwick: range add, range sum
//    ds.SegTree          sum / min / max over ranges with lazy add and assign:  ds.SegTree t(n, ds.SEG_MAX); t.add(l, r, v); t.assign(l, r, v); t.query(l, r)
//    ds.IntervalSet      merged integer intervals: add(lo, hi) remove(lo, hi) contains covers overlaps indexOf lowAt highAt nextFree length
//    ds.LruCache         least recently used cache: put get peek remove setCapacity setEvictHandler;  ds.TextLruCache: text keys
//    ds.BloomFilter      "maybe in the set" in a few bits per key (integer arithmetic only):  f = ds.BloomFilter(expected, oneIn); add mightContain merge
//    ds.CountMinSketch   approximate frequencies: add(key, n) estimate(key) merge
//  Functions: cmpAsc cmpDesc cmpText (comparators for BinaryHeap and OrderedMap), mix64 hashInt hashText hashBytes randomSeed, freeTexts
//
//  Examples
//    ds.Deque d(16);   d.pushBack(1); d.pushFront(0); int x = d.popBack();          // d.size(), d.get(i); foreach (int v in d) works
//    ds.BinaryHeap h;  int hd = h.push(40, 7); h.push(10, 8); h.update(hd, 5); int v = h.popValue();   // 7: key 5 is the smallest now
//    ds.OrderedMap m;  m.put(10, 1); m.put(20, 2); int n = m.floorNode(15); int k = m.keyAt(n);        // 10
//                      int cnt = m.countRange(5, 25); int r = m.rank(20); int i3 = m.select(0);        // 2, 1, node of the smallest key
//    ds.OrderedTextMap words;  words.put("pear", 1); char* nextWord = words.higher("apple");       // "pear"
//    ds.HashMap hm;    hm.add(42, 1); hm.add(42, 1); int c = hm.get(42, 0);                               // 2
//                      for (int e = hm.first(); e >= 0; e = hm.next(e)) { use(hm.keyAt(e), hm.valueAt(e)); }
//    ds.Trie t;        t.put("car", 1); t.put("cat", 2); int n2 = t.countPrefix("ca"); int w = t.countWildcard("c?t");   // 2, 1
//    ds.IntervalSet s; s.add(1, 5); s.add(6, 9); s.remove(3, 4);                                             // [1,2] [5,9]
//    ds.LruCache c(100);  c.put(1, 10); int got = c.get(1, -1);
//    ds.BloomFilter bf(10000, 100);  bf.addText("alice"); bool maybe = bf.mightContainText("alice");        // never a false "no"
//
//  Rules for all classes
//    * Declare an object on the stack WITH parentheses (ds.Deque d(16);  ds.Trie t();): without them the constructor does not run. Every class
//      also works when it was only zeroed (no constructor): it is an empty container that grows on first use.
//    * Memory comes from asys.alloc and goes back with dispose(), which frees every block (also text keys) and leaves an empty container that can
//      be used again. An object made with  new  is never freed (A has no delete): prefer stack objects, or reuse the object after dispose().
//    * An operation that has to allocate returns false / -1 / null when memory ran out and leaves the container as it was.
//    * Bad indexes and empty containers give 0 / -1 / false / null (documented per method), never a crash. Counts and sums wrap around on overflow.
//    * Nothing here is thread safe.
// =============================================================================
import asys;
import bits;
module ds;

// ---- helpers ---------------------------------------------------------------------------------------------------------------------------
private const BIGCAP = 0x20000000000;              // 2^41 bytes: asys refuses more anyway

private int* newInts(int n) {
    if (n < 0 || n > 0x1000000000) { return null; }
    return (int*) asys.alloc(n * 8);
}

private int* growInts(int* p, int n) {
    if (n < 0 || n > 0x1000000000) { return null; }
    return (int*) asys.realloc((char*) p, n * 8);
}

private void freeMem(void* p) {
    if (p != null) { asys.free((char*) p); }
}

// ---- comparators and hashes --------------------------------------------------------------------------------------------------------
// ready made comparators for BinaryHeap, OrderedMap, sorting with algo.sortBy ...: a function  int cmp(int a, int b)
public int cmpAsc(int a, int b) {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}

public int cmpDesc(int a, int b) {
    if (a < b) { return 1; }
    if (a > b) { return -1; }
    return 0;
}

// the keys are char* (as ints): byte order, like strcmp
public int cmpText(int a, int b) {
    return strcmp((char*) a, (char*) b);
}

// a 64 bit mixer (the finalizer of MurmurHash3): every input bit changes about half of the output bits
public int mix64(int x) {
    uint64 z = x;
    z = (z ^ (z >> 33)) * 0xFF51AFD7ED558CCD;
    z = (z ^ (z >> 33)) * 0xC4CEB9FE1A85EC53;
    z = z ^ (z >> 33);
    return z;
}

public int hashInt(int x, int seed = 0) {
    return mix64(x + seed * 0x1E3779B97F4A7C15 + 0x632BE59BD9B4E019);
}

// FNV-1a over n bytes (seeded), then mixed
public int hashBytes(char* p, int n, int seed = 0) {
    uint64 h = 0xCBF29CE484222325 ^ mix64(seed);
    for (int i = 0; i < n; i++) {
        h = (h ^ p[i]) * 0x100000001B3;
    }
    return mix64(h);
}

public int hashText(char* s, int seed = 0) {
    uint64 h = 0xCBF29CE484222325 ^ mix64(seed);
    int i = 0;
    while (s[i] != 0) {
        h = (h ^ s[i]) * 0x100000001B3;
        i++;
    }
    return mix64(h);
}

// a seed from the operating system, for hash tables that must resist crafted keys
public int randomSeed() {
    char b[8];
    asys.randomBytes(&b[0], 8);
    int v = 0;
    for (int i = 0; i < 8; i++) { v = (v << 8) | b[i]; }
    return v;
}

// frees the texts that Trie.collect and similar functions hand out
public void freeTexts(char** a, int n) {
    for (int i = 0; i < n; i++) { freeMem(a[i]); a[i] = null; }
}

// =============================================================================================================================================
//  Deque - a double ended queue of ints (growable ring buffer)
// =============================================================================================================================================
public class Deque {
    private int* buf;
    private int cap;                       // 0 or a power of two
    private int head;
    private int len;

    public Deque(int capacity = 8) {
        int c = 8;
        while (c < capacity && c < 0x10000000000) { c = c * 2; }
        buf = (int*) asys.alloc(c * 8);
        if (buf != null) { cap = c; }
    }

    private bool grow() {
        int ncap = (cap == 0) ? 8 : cap * 2;
        if (ncap > 0x10000000000) { return false; }
        int* nb = (int*) asys.alloc(ncap * 8);
        if (nb == null) { return false; }
        for (int i = 0; i < len; i++) { nb[i] = buf[(head + i) & (cap - 1)]; }
        freeMem(buf);
        buf = nb;
        cap = ncap;
        head = 0;
        return true;
    }

    private int at(int i) { return buf[(head + i) & (cap - 1)]; }
    private void setAt(int i, int v) { buf[(head + i) & (cap - 1)] = v; }

    public int size() { return len; }
    public bool isEmpty() { return len == 0; }
    public int capacity() { return cap; }

    // false only when memory ran out
    public bool pushBack(int v) {
        if (len == cap && !grow()) { return false; }
        buf[(head + len) & (cap - 1)] = v;
        len++;
        return true;
    }

    public bool pushFront(int v) {
        if (len == cap && !grow()) { return false; }
        head = (head - 1) & (cap - 1);
        buf[head] = v;
        len++;
        return true;
    }

    // removes and returns the last / first element (0 when empty)
    public int popBack() {
        if (len == 0) { return 0; }
        len--;
        return buf[(head + len) & (cap - 1)];
    }

    public int popFront() {
        if (len == 0) { return 0; }
        int v = buf[head];
        head = (head + 1) & (cap - 1);
        len--;
        return v;
    }

    public int front() { return (len == 0) ? 0 : buf[head]; }
    public int back() { return (len == 0) ? 0 : at(len - 1); }

    // element i (0 = front), 0 when the index is out of range
    public int get(int i) {
        if (i < 0 || i >= len) { return 0; }
        return at(i);
    }

    public void set(int i, int v) {
        if (i >= 0 && i < len) { setAt(i, v); }
    }

    // inserts before index i (i == size() appends); moves the shorter side
    public bool insertAt(int i, int v) {
        if (i < 0 || i > len) { return false; }
        if (len == cap && !grow()) { return false; }
        if (i <= len / 2) {
            head = (head - 1) & (cap - 1);
            len++;
            for (int j = 0; j < i; j++) { setAt(j, at(j + 1)); }
        } else {
            len++;
            for (int j = len - 1; j > i; j--) { setAt(j, at(j - 1)); }
        }
        setAt(i, v);
        return true;
    }

    // removes and returns element i (0 when out of range)
    public int removeAt(int i) {
        if (i < 0 || i >= len) { return 0; }
        int v = at(i);
        if (i < len / 2) {
            for (int j = i; j > 0; j--) { setAt(j, at(j - 1)); }
            head = (head + 1) & (cap - 1);
            len--;
        } else {
            for (int j = i; j < len - 1; j++) { setAt(j, at(j + 1)); }
            len--;
        }
        return v;
    }

    public int indexOf(int v) {
        for (int i = 0; i < len; i++) { if (at(i) == v) { return i; } }
        return -1;
    }

    public bool has(int v) { return indexOf(v) >= 0; }

    public void clear() {
        head = 0;
        len = 0;
    }

    // copies the elements, front first, into out (room for size() ints); returns how many
    public int copyTo(int* out) {
        for (int i = 0; i < len; i++) { out[i] = at(i); }
        return len;
    }

    // gives the storage back; the deque is empty afterwards and can be used again
    public void dispose() {
        freeMem(buf);
        buf = null;
        cap = 0;
        head = 0;
        len = 0;
    }
}

// =============================================================================================================================================
//  RingBuffer - a queue of ints with a fixed capacity; when it is full a new element replaces the oldest one (or is refused)
// =============================================================================================================================================
public class RingBuffer {
    private int* buf;
    private int cap;
    private int head;
    private int len;
    private bool over;
    public int overwritten;                // how many elements were pushed out by newer ones
    public int rejected;                   // how many pushes were refused (only when overwriting is off)

    public RingBuffer(int capacity, bool overwriteOldest = true) {
        over = overwriteOldest;
        if (capacity > 0 && capacity <= 0x1000000000) {
            buf = (int*) asys.alloc(capacity * 8);
            if (buf != null) { cap = capacity; }
        }
    }

    public int size() { return len; }
    public int capacity() { return cap; }
    public bool isEmpty() { return len == 0; }
    public bool isFull() { return len == cap; }

    // true when the value was stored; false when the buffer is full and overwriting is off (or its capacity is 0)
    public bool push(int v) {
        if (cap == 0) { rejected++; return false; }
        if (len == cap) {
            if (!over) { rejected++; return false; }
            buf[head] = v;
            head++;
            if (head == cap) { head = 0; }
            overwritten++;
            return true;
        }
        int at = head + len;
        if (at >= cap) { at = at - cap; }
        buf[at] = v;
        len++;
        return true;
    }

    // removes and returns the oldest element (0 when empty)
    public int pop() {
        if (len == 0) { return 0; }
        int v = buf[head];
        head++;
        if (head == cap) { head = 0; }
        len--;
        return v;
    }

    public int peek() { return (len == 0) ? 0 : buf[head]; }

    // element i counted from the oldest (0), 0 when out of range
    public int get(int i) {
        if (i < 0 || i >= len) { return 0; }
        int at = head + i;
        if (at >= cap) { at = at - cap; }
        return buf[at];
    }

    // element i counted from the newest (0)
    public int fromNewest(int i) { return get(len - 1 - i); }

    public void clear() {
        head = 0;
        len = 0;
    }

    public int copyTo(int* out) {
        for (int i = 0; i < len; i++) { out[i] = get(i); }
        return len;
    }

    public void dispose() {
        freeMem(buf);
        buf = null;
        cap = 0;
        head = 0;
        len = 0;
    }
}

// =============================================================================================================================================
//  ByteRing - a FIFO of bytes with a fixed capacity (for network and serial buffers)
// =============================================================================================================================================
public class ByteRing {
    private char* buf;
    private int cap;
    private int head;
    private int len;
    private bool over;
    public int dropped;                    // bytes lost: pushed out by newer ones, or refused

    public ByteRing(int capacity, bool overwriteOldest = false) {
        over = overwriteOldest;
        if (capacity > 0 && capacity <= 0x100000000000) {
            buf = asys.alloc(capacity);
            if (buf != null) { cap = capacity; }
        }
    }

    public int available() { return len; }
    public int space() { return cap - len; }
    public int capacity() { return cap; }

    // Stores up to n bytes. Without overwriting the bytes that do not fit are refused (the number stored is returned);
    // with overwriting everything is stored and the oldest bytes are dropped (if n > capacity only the last capacity bytes stay).
    public int write(char* p, int n) {
        if (n <= 0 || cap == 0) { return 0; }
        int take = n;
        if (!over) {
            if (take > cap - len) { take = cap - len; }
            dropped = dropped + (n - take);
        } else {
            if (take > cap) {
                dropped = dropped + (take - cap);
                p = &p[take - cap];
                take = cap;
            }
            if (len + take > cap) {
                int drop = len + take - cap;
                dropped = dropped + drop;
                head = (head + drop) % cap;
                len = len - drop;
            }
        }
        int at = (head + len) % cap;
        int first = cap - at;
        if (first > take) { first = take; }
        memcpy(&buf[at], p, first);
        if (take > first) { memcpy(buf, &p[first], take - first); }
        len = len + take;
        return take;
    }

    // copies up to n bytes (the oldest first) without removing them
    public int peek(char* out, int n) {
        if (n > len) { n = len; }
        if (n <= 0) { return 0; }
        int first = cap - head;
        if (first > n) { first = n; }
        memcpy(out, &buf[head], first);
        if (n > first) { memcpy(&out[first], buf, n - first); }
        return n;
    }

    // reads and removes up to n bytes
    public int read(char* out, int n) {
        int got = peek(out, n);
        skip(got);
        return got;
    }

    // removes up to n bytes; returns how many
    public int skip(int n) {
        if (n > len) { n = len; }
        if (n <= 0) { return 0; }
        head = (head + n) % cap;
        len = len - n;
        return n;
    }

    // byte i counted from the oldest, -1 when out of range
    public int byteAt(int i) {
        if (i < 0 || i >= len) { return -1; }
        return buf[(head + i) % cap] & 255;
    }

    public void clear() {
        head = 0;
        len = 0;
    }

    public void dispose() {
        freeMem(buf);
        buf = null;
        cap = 0;
        head = 0;
        len = 0;
    }
}

// =============================================================================================================================================
//  BinaryHeap - a priority queue of (key, value) pairs with handles: update(handle, newKey) is decrease-key, remove(handle) deletes
//  anywhere, merge(other) moves all elements of another heap in. cmp(a, b) < 0 means that key a comes out before key b
//  (null: the smallest int first). Elements with equal keys come out in no particular order.
// =============================================================================================================================================
public class BinaryHeap {
    private int* key;                      // by heap slot
    private int* val;
    private int* hid;                      // the handle of the element in a slot
    private int* pos;                      // by handle: the slot, or a link in the list of free handles: -2 - next (-1 ends it)
    private int cap;
    private int len;
    private int nextNew;                   // handles below this number have been handed out at least once
    private int freeHandle;                // first free handle, -1 when none... stored as freeHandle + 1 (0 = none)
    private func cmp;

    public BinaryHeap(func compare = null) {
        cmp = compare;
    }

    private bool before(int a, int b) {
        if (cmp == null) { return a < b; }
        return cmp(a, b) < 0;
    }

    private bool growTo(int ncap) {
        if (ncap <= cap) { return true; }
        int* nk = growInts(key, ncap);
        if (nk == null) { return false; }
        key = nk;
        int* nv = growInts(val, ncap);
        if (nv == null) { return false; }
        val = nv;
        int* nh = growInts(hid, ncap);
        if (nh == null) { return false; }
        hid = nh;
        int* np = growInts(pos, ncap);
        if (np == null) { return false; }
        pos = np;
        cap = ncap;
        return true;
    }

    private bool grow() {
        return growTo((cap == 0) ? 16 : cap * 2);
    }

    private int newHandle() {
        if (freeHandle > 0) {
            int h = freeHandle - 1;
            int nxt = -2 - pos[h];
            freeHandle = nxt + 1;
            return h;
        }
        int h = nextNew;
        nextNew++;
        return h;
    }

    private void releaseHandle(int h) {
        pos[h] = -2 - (freeHandle - 1);
        freeHandle = h + 1;
    }

    private void siftUp(int i) {
        int k = key[i];
        int v = val[i];
        int h = hid[i];
        while (i > 0) {
            int p = (i - 1) >> 1;
            if (!before(k, key[p])) { break; }
            key[i] = key[p];
            val[i] = val[p];
            hid[i] = hid[p];
            pos[hid[i]] = i;
            i = p;
        }
        key[i] = k;
        val[i] = v;
        hid[i] = h;
        pos[h] = i;
    }

    private void siftDown(int i) {
        int k = key[i];
        int v = val[i];
        int h = hid[i];
        for (;;) {
            int c = 2 * i + 1;
            if (c >= len) { break; }
            if (c + 1 < len && before(key[c + 1], key[c])) { c++; }
            if (!before(key[c], k)) { break; }
            key[i] = key[c];
            val[i] = val[c];
            hid[i] = hid[c];
            pos[hid[i]] = i;
            i = c;
        }
        key[i] = k;
        val[i] = v;
        hid[i] = h;
        pos[h] = i;
    }

    public int size() { return len; }
    public bool isEmpty() { return len == 0; }

    // adds an element; returns its handle (valid until the element leaves the heap), -1 when memory ran out
    public int push(int k, int v = 0) {
        if (len == cap && !grow()) { return -1; }
        int h = newHandle();
        int i = len;
        len++;
        key[i] = k;
        val[i] = v;
        hid[i] = h;
        pos[h] = i;
        siftUp(i);
        return h;
    }

    // the element that comes first (0 / -1 when empty)
    public int peek() { return (len == 0) ? 0 : key[0]; }
    public int peekValue() { return (len == 0) ? 0 : val[0]; }
    public int peekHandle() { return (len == 0) ? -1 : hid[0]; }

    // removes the first element (handle h from the slot)
    private void removeSlot(int i) {
        int h = hid[i];
        len--;
        if (i != len) {
            key[i] = key[len];
            val[i] = val[len];
            hid[i] = hid[len];
            pos[hid[i]] = i;
            // the moved element may have to go either way
            if (i > 0 && before(key[i], key[(i - 1) >> 1])) { siftUp(i); } else { siftDown(i); }
        }
        releaseHandle(h);
    }

    // removes the first element and returns its key (0 when empty)
    public int pop() {
        if (len == 0) { return 0; }
        int k = key[0];
        removeSlot(0);
        return k;
    }

    // removes the first element and returns its value (0 when empty)
    public int popValue() {
        if (len == 0) { return 0; }
        int v = val[0];
        removeSlot(0);
        return v;
    }

    public bool contains(int h) {
        return h >= 0 && h < nextNew && pos[h] >= 0;
    }

    public int keyOf(int h) { return contains(h) ? key[pos[h]] : 0; }
    public int valueOf(int h) { return contains(h) ? val[pos[h]] : 0; }

    public bool setValue(int h, int v) {
        if (!contains(h)) { return false; }
        val[pos[h]] = v;
        return true;
    }

    // gives the element a new key (smaller or larger: decrease-key and increase-key); false for a stale handle
    public bool update(int h, int newKey) {
        if (!contains(h)) { return false; }
        int i = pos[h];
        int old = key[i];
        key[i] = newKey;
        if (before(newKey, old)) { siftUp(i); } else if (before(old, newKey)) { siftDown(i); }
        return true;
    }

    // removes the element with this handle; false for a stale handle
    public bool remove(int h) {
        if (!contains(h)) { return false; }
        removeSlot(pos[h]);
        return true;
    }

    // Moves every element of other into this heap (other is empty afterwards; its handles are invalid, the elements get new
    // handles here). The order of this heap is used. False when memory ran out (nothing changed) or other is this heap.
    public bool merge(BinaryHeap* other) {
        if (other == this) { return false; }
        int m = other.len;
        if (m == 0) { return true; }
        int n0 = len;
        if (!growTo(n0 + m)) { return false; }
        for (int j = 0; j < m; j++) {
            int h = newHandle();
            int i = len;
            len++;
            key[i] = other.key[j];
            val[i] = other.val[j];
            hid[i] = h;
            pos[h] = i;
        }
        if (m * 4 >= n0) {
            for (int i = len / 2 - 1; i >= 0; i--) { siftDown(i); }
        } else {
            for (int i = n0; i < len; i++) { siftUp(i); }
        }
        other.clear();
        return true;
    }

    public void clear() {
        len = 0;
        nextNew = 0;
        freeHandle = 0;
    }

    // pops everything in order into keys[] and values[] (room for size() ints each; either may be null); returns how many
    public int drain(int* keys, int* vals) {
        int n = 0;
        while (len > 0) {
            if (keys != null) { keys[n] = key[0]; }
            if (vals != null) { vals[n] = val[0]; }
            n++;
            removeSlot(0);
        }
        return n;
    }

    // checks the heap property and the handle table (for tests)
    public bool verify() {
        for (int i = 1; i < len; i++) {
            if (before(key[i], key[(i - 1) >> 1])) { return false; }
        }
        for (int i = 0; i < len; i++) {
            if (pos[hid[i]] != i) { return false; }
        }
        return true;
    }

    public void dispose() {
        freeMem(key);
        freeMem(val);
        freeMem(hid);
        freeMem(pos);
        key = null;
        val = null;
        hid = null;
        pos = null;
        cap = 0;
        len = 0;
        nextNew = 0;
        freeHandle = 0;
    }
}

// a BinaryHeap with the names of a priority queue: enqueue(priority, value), dequeue() gives the value
public class PriorityQueue : BinaryHeap {
    public PriorityQueue(func compare = null) {
        super(compare);
    }
    public int enqueue(int priority, int value) { return push(priority, value); }
    public int dequeue() { return popValue(); }
    public int peekPriority() { return peek(); }
}

// =============================================================================================================================================
//  OrderedMap - a map from int keys (or keys of your own type, ordered by a comparator) to int values, kept sorted in an AVL tree:
//  ordered traversal, floor / ceil / lower / higher, range queries, rank / select (counted by the tree), deletion. All in O(log n).
//  Entries live in arrays and are addressed by a node number (find() and friends give it, keyAt() / valueAt() read it): a node
//  number stays valid until that key is removed, whatever else is inserted or removed.
//  Declare it with parentheses (ds.OrderedMap m();), or the constructor does not run (a zeroed map is a valid map of int keys).
// =============================================================================================================================================
public class OrderedMap {
    private int* keys;
    private int* vals;                     // null when the map keeps no values (OrderedSet)
    private int32* lc;                     // left child, -1 for none
    private int32* rc;
    private int32* cn;                     // number of nodes in the subtree
    private char* ht;                      // height of the subtree (a leaf has 1); 0 marks a free slot
    private int cap;
    private int used;                      // slots in use or on the free list
    private int freeHead;                  // free slots, linked through lc, stored + 1 (0 = none)
    private int root;                      // valid when n > 0
    private int n;
    private func cmp;
    private bool textKeys;
    private bool noValues;
    private bool inserted;
    private bool removed;

    public OrderedMap(func compare = null, bool storeValues = true) {
        init(compare, storeValues, false);
    }

    // Sets how keys are ordered and stored; only while the map is empty. compare(a, b) < 0 puts a first (null: the ints
    // themselves). text: the keys are char*, they are compared like strcmp, copied on insert and freed when removed.
    public bool init(func compare, bool storeValues, bool text) {
        if (n != 0) { return false; }
        cmp = compare;
        noValues = !storeValues;
        textKeys = text;
        return true;
    }

    private int cmpKeys(int a, int b) {
        if (textKeys) { return strcmp((char*) a, (char*) b); }
        if (cmp != null) { return cmp(a, b); }
        if (a < b) { return -1; }
        if (a > b) { return 1; }
        return 0;
    }

    private int rootNode() { return (n == 0) ? -1 : root; }
    private int hgt(int t) { return (t < 0) ? 0 : ht[t]; }
    private int sz(int t) { return (t < 0) ? 0 : cn[t]; }

    private void upd(int t) {
        int a = hgt(lc[t]);
        int b = hgt(rc[t]);
        ht[t] = 1 + ((a > b) ? a : b);
        cn[t] = 1 + sz(lc[t]) + sz(rc[t]);
    }

    private int rotRight(int t) {
        int l = lc[t];
        lc[t] = rc[l];
        rc[l] = t;
        upd(t);
        upd(l);
        return l;
    }

    private int rotLeft(int t) {
        int r = rc[t];
        rc[t] = lc[r];
        lc[r] = t;
        upd(t);
        upd(r);
        return r;
    }

    private int rebalance(int t) {
        upd(t);
        int b = hgt(lc[t]) - hgt(rc[t]);
        if (b > 1) {
            if (hgt(lc[lc[t]]) < hgt(rc[lc[t]])) { lc[t] = rotLeft(lc[t]); }
            return rotRight(t);
        }
        if (b < -1) {
            if (hgt(rc[rc[t]]) < hgt(lc[rc[t]])) { rc[t] = rotRight(rc[t]); }
            return rotLeft(t);
        }
        return t;
    }

    // makes sure that one more node fits
    private bool reserve() {
        if (freeHead != 0 || used < cap) { return true; }
        int ncap = (cap == 0) ? 16 : cap * 2;
        if (ncap > 0x7FFFFFF0) { return false; }
        int* nk = growInts(keys, ncap);
        if (nk == null) { return false; }
        keys = nk;
        if (!noValues) {
            int* nv = growInts(vals, ncap);
            if (nv == null) { return false; }
            vals = nv;
        }
        int32* nl = (int32*) asys.realloc((char*) lc, ncap * 4);
        if (nl == null) { return false; }
        lc = nl;
        int32* nr = (int32*) asys.realloc((char*) rc, ncap * 4);
        if (nr == null) { return false; }
        rc = nr;
        int32* nc = (int32*) asys.realloc((char*) cn, ncap * 4);
        if (nc == null) { return false; }
        cn = nc;
        char* nh = asys.realloc(ht, ncap);
        if (nh == null) { return false; }
        ht = nh;
        cap = ncap;
        return true;
    }

    private int newNode(int key, int val) {
        int t;
        if (freeHead != 0) {
            t = freeHead - 1;
            freeHead = lc[t];
        } else {
            t = used;
            used++;
        }
        keys[t] = key;
        if (!noValues) { vals[t] = val; }
        lc[t] = -1;
        rc[t] = -1;
        cn[t] = 1;
        ht[t] = 1;
        n++;
        inserted = true;
        return t;
    }

    private void freeNode(int t) {
        if (textKeys) { freeMem((char*) keys[t]); }
        keys[t] = 0;
        ht[t] = 0;
        lc[t] = freeHead;
        freeHead = t + 1;
        n--;
    }

    private int insertRec(int t, int key, int val) {
        if (t < 0) { return newNode(key, val); }
        int c = cmpKeys(key, keys[t]);
        if (c == 0) {
            if (!noValues) { vals[t] = val; }
            return t;
        }
        if (c < 0) {
            lc[t] = insertRec(lc[t], key, val);
        } else {
            rc[t] = insertRec(rc[t], key, val);
        }
        if (!inserted) { return t; }
        return rebalance(t);
    }

    // removes the smallest node of the subtree t: returns the new subtree, the node in *out (not freed)
    private int detachMin(int t, int* out) {
        if (lc[t] < 0) {
            *out = t;
            return rc[t];
        }
        lc[t] = detachMin(lc[t], out);
        return rebalance(t);
    }

    private int removeRec(int t, int key) {
        if (t < 0) { return -1; }
        int c = cmpKeys(key, keys[t]);
        if (c < 0) {
            lc[t] = removeRec(lc[t], key);
        } else if (c > 0) {
            rc[t] = removeRec(rc[t], key);
        } else {
            removed = true;
            int l = lc[t];
            int r = rc[t];
            freeNode(t);
            if (l < 0) { return r; }
            if (r < 0) { return l; }
            int m = -1;
            int nr = detachMin(r, &m);
            lc[m] = l;
            rc[m] = nr;
            return rebalance(m);
        }
        if (!removed) { return t; }
        return rebalance(t);
    }

    // ---- basic operations -------------------------------------------------------------------------------------------
    public int size() { return n; }
    public bool isEmpty() { return n == 0; }

    // node number of the key, -1 when it is not there
    public int find(int key) {
        int t = rootNode();
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c == 0) { return t; }
            t = (c < 0) ? lc[t] : rc[t];
        }
        return -1;
    }

    public bool has(int key) { return find(key) >= 0; }

    // the value of the key, or fallback
    public int get(int key, int fallback = 0) {
        int t = find(key);
        if (t < 0 || noValues) { return fallback; }
        return vals[t];
    }

    // Inserts the key or replaces its value. Returns 1 for a new key, 0 when the key was there, -1 when memory ran out.
    public int put(int key, int val = 0) {
        if (textKeys) {
            int f = find(key);
            if (f >= 0) {
                if (!noValues) { vals[f] = val; }
                return 0;
            }
            char* copy = asys.strDup((char*) key);
            if (copy == null) { return -1; }
            if (!reserve()) {
                freeMem(copy);
                return -1;
            }
            inserted = false;
            root = insertRec(rootNode(), (int) copy, val);
            return 1;
        }
        if (!reserve()) {
            int f = find(key);
            if (f < 0) { return -1; }
            if (!noValues) { vals[f] = val; }
            return 0;
        }
        inserted = false;
        root = insertRec(rootNode(), key, val);
        return inserted ? 1 : 0;
    }

    // true when the key was there
    public bool remove(int key) {
        removed = false;
        root = removeRec(rootNode(), key);
        return removed;
    }

    public bool removeFirst() {
        int t = firstNode();
        if (t < 0) { return false; }
        return remove(keys[t]);
    }

    public bool removeLast() {
        int t = lastNode();
        if (t < 0) { return false; }
        return remove(keys[t]);
    }

    // ---- nodes -----------------------------------------------------------------------------------------------------------
    public bool isNode(int t) { return t >= 0 && t < used && ht[t] != 0; }
    public int keyAt(int t) { return isNode(t) ? keys[t] : 0; }
    public int valueAt(int t) { return (isNode(t) && !noValues) ? vals[t] : 0; }

    public bool setValueAt(int t, int v) {
        if (!isNode(t) || noValues) { return false; }
        vals[t] = v;
        return true;
    }

    public int firstNode() {
        int t = rootNode();
        if (t < 0) { return -1; }
        while (lc[t] >= 0) { t = lc[t]; }
        return t;
    }

    public int lastNode() {
        int t = rootNode();
        if (t < 0) { return -1; }
        while (rc[t] >= 0) { t = rc[t]; }
        return t;
    }

    // the node with the greatest key <= key (floor), < key (lower), the least key >= key (ceil), > key (higher); -1 when none
    public int floorNode(int key) {
        int t = rootNode();
        int best = -1;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c == 0) { return t; }
            if (c < 0) { t = lc[t]; } else { best = t; t = rc[t]; }
        }
        return best;
    }

    public int lowerNode(int key) {
        int t = rootNode();
        int best = -1;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c <= 0) { t = lc[t]; } else { best = t; t = rc[t]; }
        }
        return best;
    }

    public int ceilNode(int key) {
        int t = rootNode();
        int best = -1;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c == 0) { return t; }
            if (c < 0) { best = t; t = lc[t]; } else { t = rc[t]; }
        }
        return best;
    }

    public int higherNode(int key) {
        int t = rootNode();
        int best = -1;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c < 0) { best = t; t = lc[t]; } else { t = rc[t]; }
        }
        return best;
    }

    // the node after / before a node in key order (-1 at the end); O(log n) each, so a whole walk costs O(n log n):
    // use range() or forEach() to visit many entries
    public int nextNode(int t) { return isNode(t) ? higherNode(keys[t]) : -1; }
    public int prevNode(int t) { return isNode(t) ? lowerNode(keys[t]) : -1; }

    // keys and values with a fallback for "none"
    public int firstKey(int fallback = 0) { int t = firstNode(); return (t < 0) ? fallback : keys[t]; }
    public int lastKey(int fallback = 0) { int t = lastNode(); return (t < 0) ? fallback : keys[t]; }
    public int floorKey(int key, int fallback = 0) { int t = floorNode(key); return (t < 0) ? fallback : keys[t]; }
    public int lowerKey(int key, int fallback = 0) { int t = lowerNode(key); return (t < 0) ? fallback : keys[t]; }
    public int ceilKey(int key, int fallback = 0) { int t = ceilNode(key); return (t < 0) ? fallback : keys[t]; }
    public int higherKey(int key, int fallback = 0) { int t = higherNode(key); return (t < 0) ? fallback : keys[t]; }

    // ---- rank and select -----------------------------------------------------------------------------------------------
    // how many keys are smaller than key (key need not be in the map)
    public int rank(int key) {
        int t = rootNode();
        int r = 0;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c <= 0) {
                t = lc[t];
            } else {
                r = r + sz(lc[t]) + 1;
                t = rc[t];
            }
        }
        return r;
    }

    // how many keys are smaller than or equal to key
    public int rankUpTo(int key) {
        int t = rootNode();
        int r = 0;
        while (t >= 0) {
            int c = cmpKeys(key, keys[t]);
            if (c < 0) {
                t = lc[t];
            } else {
                r = r + sz(lc[t]) + 1;
                t = rc[t];
            }
        }
        return r;
    }

    // the node of the i-th smallest key (0 is the smallest), -1 when i is out of range
    public int select(int i) {
        if (i < 0 || i >= n) { return -1; }
        int t = rootNode();
        while (t >= 0) {
            int ls = sz(lc[t]);
            if (i < ls) {
                t = lc[t];
            } else if (i == ls) {
                return t;
            } else {
                i = i - ls - 1;
                t = rc[t];
            }
        }
        return -1;
    }

    // how many keys lie in lo ... hi (both included)
    public int countRange(int lo, int hi) {
        if (cmpKeys(lo, hi) > 0) { return 0; }
        return rankUpTo(hi) - rank(lo);
    }

    // ---- traversal --------------------------------------------------------------------------------------------------------
    // Copies the entries with lo <= key <= hi in ascending order into keysOut[] / valsOut[] (either may be null), at most max;
    // returns how many. O(log n + count).
    public int range(int lo, int hi, int* keysOut, int* valsOut, int max) {
        int stack[72];
        int sp = 0;
        int t = rootNode();
        int out = 0;
        if (cmpKeys(lo, hi) > 0) { return 0; }
        while ((t >= 0 || sp > 0) && out < max) {
            while (t >= 0) {
                if (cmpKeys(keys[t], lo) < 0) {
                    t = rc[t];
                } else {
                    stack[sp] = t;
                    sp++;
                    t = lc[t];
                }
            }
            if (sp == 0) { break; }
            sp--;
            t = stack[sp];
            if (cmpKeys(keys[t], hi) > 0) { break; }
            if (keysOut != null) { keysOut[out] = keys[t]; }
            if (valsOut != null && !noValues) { valsOut[out] = vals[t]; }
            out++;
            t = rc[t];
        }
        return out;
    }

    // all entries in ascending order (room for size() ints in each array)
    public int toArrays(int* keysOut, int* valsOut) {
        return rangeAll(keysOut, valsOut, n);
    }

    private int rangeAll(int* keysOut, int* valsOut, int max) {
        int stack[72];
        int sp = 0;
        int t = rootNode();
        int out = 0;
        while ((t >= 0 || sp > 0) && out < max) {
            while (t >= 0) {
                stack[sp] = t;
                sp++;
                t = lc[t];
            }
            sp--;
            t = stack[sp];
            if (keysOut != null) { keysOut[out] = keys[t]; }
            if (valsOut != null && !noValues) { valsOut[out] = vals[t]; }
            out++;
            t = rc[t];
        }
        return out;
    }

    // Calls f(key, value, ctx) for every entry with lo <= key <= hi in ascending order, until f returns something other than 0
    // (that value is returned; 0 when f never stopped it). f must not insert or remove entries.
    public int forEachRange(int lo, int hi, func f, int ctx) {
        int stack[72];
        int sp = 0;
        int t = rootNode();
        if (cmpKeys(lo, hi) > 0) { return 0; }
        while (t >= 0 || sp > 0) {
            while (t >= 0) {
                if (cmpKeys(keys[t], lo) < 0) {
                    t = rc[t];
                } else {
                    stack[sp] = t;
                    sp++;
                    t = lc[t];
                }
            }
            if (sp == 0) { break; }
            sp--;
            t = stack[sp];
            if (cmpKeys(keys[t], hi) > 0) { break; }
            int r = f(keys[t], noValues ? 0 : vals[t], ctx);
            if (r != 0) { return r; }
            t = rc[t];
        }
        return 0;
    }

    public int forEach(func f, int ctx) {
        int stack[72];
        int sp = 0;
        int t = rootNode();
        while (t >= 0 || sp > 0) {
            while (t >= 0) {
                stack[sp] = t;
                sp++;
                t = lc[t];
            }
            sp--;
            t = stack[sp];
            int r = f(keys[t], noValues ? 0 : vals[t], ctx);
            if (r != 0) { return r; }
            t = rc[t];
        }
        return 0;
    }

    // ---- housekeeping --------------------------------------------------------------------------------------------------
    public int height() { return hgt(rootNode()); }

    private int checkRec(int t, int* st) {
        if (t < 0) { return 0; }
        int hl = checkRec(lc[t], st);
        if (hl < 0) { return -1; }
        if (st[1] != 0 && cmpKeys(st[0], keys[t]) >= 0) { return -1; }
        st[0] = keys[t];
        st[1] = 1;
        st[2]++;
        int hr = checkRec(rc[t], st);
        if (hr < 0) { return -1; }
        int d = hl - hr;
        if (d > 1 || d < -1) { return -1; }
        int hh = 1 + ((hl > hr) ? hl : hr);
        if (ht[t] != hh) { return -1; }
        if (cn[t] != 1 + sz(lc[t]) + sz(rc[t])) { return -1; }
        return hh;
    }

    // checks every invariant (order, balance, heights, counts, free list); for tests
    public bool verify() {
        int st[3];
        st[0] = 0;
        st[1] = 0;
        st[2] = 0;
        int r = checkRec(rootNode(), &st[0]);
        if (r < 0 || st[2] != n) { return false; }
        int free = 0;
        int f = freeHead;
        while (f != 0 && free <= used) {
            if (ht[f - 1] != 0) { return false; }
            f = lc[f - 1];
            free++;
        }
        return used - free == n;
    }

    private void freeTextKeys() {
        if (!textKeys) { return; }
        for (int i = 0; i < used; i++) {
            if (ht[i] != 0) { freeMem((char*) keys[i]); }
        }
    }

    public void clear() {
        freeTextKeys();
        n = 0;
        used = 0;
        freeHead = 0;
        root = 0;
    }

    // gives all storage back; the map is empty afterwards and can be used again (with the same ordering)
    public void dispose() {
        clear();
        freeMem(keys);
        freeMem(vals);
        freeMem(lc);
        freeMem(rc);
        freeMem(cn);
        freeMem(ht);
        keys = null;
        vals = null;
        lc = null;
        rc = null;
        cn = null;
        ht = null;
        cap = 0;
    }
}

// =============================================================================================================================================
//  OrderedSet - the keys of an OrderedMap alone (no value array). get(i) is the i-th smallest key, so foreach works.
// =============================================================================================================================================
public class OrderedSet {
    private OrderedMap m;

    public OrderedSet(func compare = null) {
        m.init(compare, false, false);
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }

    // 1 when the key is new, 0 when it was there, -1 when memory ran out
    public int add(int key) { return m.put(key, 0); }
    public bool has(int key) { return m.has(key); }
    public bool contains(int key) { return m.has(key); }
    public bool remove(int key) { return m.remove(key); }
    public bool removeFirst() { return m.removeFirst(); }
    public bool removeLast() { return m.removeLast(); }

    public int first(int fallback = 0) { return m.firstKey(fallback); }
    public int last(int fallback = 0) { return m.lastKey(fallback); }
    public int floor(int key, int fallback = 0) { return m.floorKey(key, fallback); }
    public int lower(int key, int fallback = 0) { return m.lowerKey(key, fallback); }
    public int ceil(int key, int fallback = 0) { return m.ceilKey(key, fallback); }
    public int higher(int key, int fallback = 0) { return m.higherKey(key, fallback); }

    public int rank(int key) { return m.rank(key); }
    public int countRange(int lo, int hi) { return m.countRange(lo, hi); }

    // the i-th smallest key (0 for an index out of range)
    public int get(int i) {
        int t = m.select(i);
        return (t < 0) ? 0 : m.keyAt(t);
    }
    public int at(int i, int fallback) {
        int t = m.select(i);
        return (t < 0) ? fallback : m.keyAt(t);
    }

    public int range(int lo, int hi, int* out, int max) { return m.range(lo, hi, out, null, max); }
    public int toArray(int* out) { return m.toArrays(out, null); }
    public int forEach(func f, int ctx) { return m.forEach(f, ctx); }
    public int forEachRange(int lo, int hi, func f, int ctx) { return m.forEachRange(lo, hi, f, ctx); }

    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public void dispose() { m.dispose(); }
}

// =============================================================================================================================================
//  OrderedTextMap / OrderedTextSet - the same with text keys (byte order, like strcmp). The keys are copied; null means "none".
// =============================================================================================================================================
public class OrderedTextMap {
    private OrderedMap m;

    public OrderedTextMap() {
        m.init(null, true, true);
    }

    private void ensure() {
        m.init(null, true, true);                      // a no-op once there are entries; makes a zeroed map a text map
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }

    public int put(char* key, int val) {
        ensure();
        return m.put((int) key, val);
    }
    public int get(char* key, int fallback = 0) { return m.get((int) key, fallback); }
    public bool has(char* key) { return m.has((int) key); }
    public bool remove(char* key) { return m.remove((int) key); }
    public bool removeFirst() { return m.removeFirst(); }
    public bool removeLast() { return m.removeLast(); }

    private char* textOf(int node) { return (node < 0) ? null : (char*) m.keyAt(node); }

    // the stored keys: they stay valid until that key is removed
    public char* first() { return textOf(m.firstNode()); }
    public char* last() { return textOf(m.lastNode()); }
    public char* floor(char* key) { return textOf(m.floorNode((int) key)); }
    public char* lower(char* key) { return textOf(m.lowerNode((int) key)); }
    public char* ceil(char* key) { return textOf(m.ceilNode((int) key)); }
    public char* higher(char* key) { return textOf(m.higherNode((int) key)); }

    public int rank(char* key) { return m.rank((int) key); }
    public int countRange(char* lo, char* hi) { return m.countRange((int) lo, (int) hi); }
    public char* select(int i) { return textOf(m.select(i)); }
    public int valueOfRank(int i) { int t = m.select(i); return (t < 0) ? 0 : m.valueAt(t); }

    // entries lo <= key <= hi into keysOut[] (the stored texts) and valsOut[]
    public int range(char* lo, char* hi, char** keysOut, int* valsOut, int max) {
        return m.range((int) lo, (int) hi, (int*) keysOut, valsOut, max);
    }
    public int toArrays(char** keysOut, int* valsOut) { return m.toArrays((int*) keysOut, valsOut); }
    public int forEach(func f, int ctx) { return m.forEach(f, ctx); }
    public int forEachRange(char* lo, char* hi, func f, int ctx) { return m.forEachRange((int) lo, (int) hi, f, ctx); }

    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public void dispose() { m.dispose(); }
}

public class OrderedTextSet {
    private OrderedMap m;

    public OrderedTextSet() {
        m.init(null, false, true);
    }

    private void ensure() {
        m.init(null, false, true);
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }

    public int add(char* key) {
        ensure();
        return m.put((int) key, 0);
    }
    public bool has(char* key) { return m.has((int) key); }
    public bool contains(char* key) { return m.has((int) key); }
    public bool remove(char* key) { return m.remove((int) key); }
    public bool removeFirst() { return m.removeFirst(); }
    public bool removeLast() { return m.removeLast(); }

    private char* textOf(int node) { return (node < 0) ? null : (char*) m.keyAt(node); }

    public char* first() { return textOf(m.firstNode()); }
    public char* last() { return textOf(m.lastNode()); }
    public char* floor(char* key) { return textOf(m.floorNode((int) key)); }
    public char* lower(char* key) { return textOf(m.lowerNode((int) key)); }
    public char* ceil(char* key) { return textOf(m.ceilNode((int) key)); }
    public char* higher(char* key) { return textOf(m.higherNode((int) key)); }

    public int rank(char* key) { return m.rank((int) key); }
    public int countRange(char* lo, char* hi) { return m.countRange((int) lo, (int) hi); }
    public char* get(int i) { return textOf(m.select(i)); }

    public int range(char* lo, char* hi, char** out, int max) { return m.range((int) lo, (int) hi, (int*) out, null, max); }
    public int toArray(char** out) { return m.toArrays((int*) out, null); }

    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public void dispose() { m.dispose(); }
}

// =============================================================================================================================================
//  HashMap - a hash map from int keys to int values (open addressing, linear probing, power of two table, tombstones).
//  The entries are kept in insertion order in arrays and the table only holds their numbers (like the dict of Python), so
//  iteration is fast and in a fixed order, and the table never gets more than half full. Removing leaves a hole in the entry
//  array and a tombstone in the table; they disappear when the entry array fills up and is compacted (or grown, or shrunk to fit).
//  Entry numbers (find, first / next, keyAt) are valid until the next insert of a new key, shrink(), clear() or dispose(); remove() never
//  moves entries, so removing while iterating is fine.
//  The hash is a mixer with a seed: pass ds.randomSeed() when the keys come from an attacker (hash flooding).
//  Declare it with parentheses (ds.HashMap m();), or the constructor does not run (the zeroed map is a valid map).
// =============================================================================================================================================
public class HashMap {
    private int32* index;                  // -1 empty, -2 deleted, else an entry number
    private int icap;                      // 0 or a power of two, always 2 * ecap
    private int* keys;
    private int* vals;
    private int* hashes;                   // >= 0 for a live entry, -1 for a deleted one
    private int ecap;                      // 0 or a power of two
    private int used;                      // entries in use, the deleted ones included
    private int live;
    private int seed;
    private bool textKeys;

    public HashMap(int hashSeed = 0) {
        seed = hashSeed;
    }

    // for the text wrappers: keys are char*, copied on insert and freed when removed (only while the map is empty)
    public bool init(int hashSeed, bool text) {
        if (used != 0) { return false; }
        seed = hashSeed;
        textKeys = text;
        return true;
    }

    private int hashKey(int key) {
        int h = textKeys ? hashText((char*) key, seed) : hashInt(key, seed);
        return h & 0x7FFFFFFFFFFFFFFF;
    }

    private bool sameKey(int a, int b) {
        if (textKeys) { return streq((char*) a, (char*) b); }
        return a == b;
    }

    public int size() { return live; }
    public bool isEmpty() { return live == 0; }
    public int capacity() { return ecap; }

    // the table slot of a key, -1 when it is not there
    private int slotOf(int key, int h) {
        if (live == 0) { return -1; }
        int mask = icap - 1;
        int i = h & mask;
        for (;;) {
            int e = index[i];
            if (e == -1) { return -1; }
            if (e >= 0 && hashes[e] == h && sameKey(keys[e], key)) { return i; }
            i = (i + 1) & mask;
        }
        return -1;
    }

    // the entry number of the key, -1 when it is not there
    public int find(int key) {
        if (live == 0) { return -1; }
        int h = hashKey(key);
        int mask = icap - 1;
        int i = h & mask;
        for (;;) {
            int e = index[i];
            if (e == -1) { return -1; }
            if (e >= 0 && hashes[e] == h && sameKey(keys[e], key)) { return e; }
            i = (i + 1) & mask;
        }
        return -1;
    }

    public bool has(int key) { return find(key) >= 0; }

    public int get(int key, int fallback = 0) {
        int e = find(key);
        return (e < 0) ? fallback : vals[e];
    }

    // Rebuilds the arrays for the live entries (in their order): the capacity becomes the power of two that leaves room to grow.
    // minSlots: at least this many entries must fit. False when memory ran out (nothing changed).
    private bool rebuild(int minSlots) {
        int want = (live + 1) * 3 / 2;
        if (want < minSlots) { want = minSlots; }
        int ne = 8;
        while (ne < want && ne < 0x100000000) { ne = ne * 2; }
        if (ne < want) { return false; }
        int ni = ne * 2;
        int* nk = (int*) asys.alloc(ne * 8);
        int* nv = (int*) asys.alloc(ne * 8);
        int* nh = (int*) asys.alloc(ne * 8);
        int32* nx = (int32*) asys.alloc(ni * 4);
        if (nk == null || nv == null || nh == null || nx == null) {
            freeMem(nk);
            freeMem(nv);
            freeMem(nh);
            freeMem(nx);
            return false;
        }
        for (int i = 0; i < ni; i++) { nx[i] = -1; }
        int mask = ni - 1;
        int w = 0;
        for (int e = 0; e < used; e++) {
            int h = hashes[e];
            if (h < 0) { continue; }
            nk[w] = keys[e];
            nv[w] = vals[e];
            nh[w] = h;
            int i = h & mask;
            while (nx[i] != -1) { i = (i + 1) & mask; }
            nx[i] = w;
            w++;
        }
        freeMem(keys);
        freeMem(vals);
        freeMem(hashes);
        freeMem(index);
        keys = nk;
        vals = nv;
        hashes = nh;
        index = nx;
        ecap = ne;
        icap = ni;
        used = w;
        return true;
    }

    // Stores the value for the key. Returns 1 for a new key, 0 when the key was there, -1 when memory ran out.
    public int put(int key, int val) {
        int h = hashKey(key);
        int tomb = -1;
        int slot = -1;
        if (icap > 0) {
            int mask = icap - 1;
            int i = h & mask;
            for (;;) {
                int e = index[i];
                if (e == -1) { break; }
                if (e == -2) {
                    if (tomb < 0) { tomb = i; }
                } else if (hashes[e] == h && sameKey(keys[e], key)) {
                    vals[e] = val;
                    return 0;
                }
                i = (i + 1) & mask;
            }
            slot = (tomb >= 0) ? tomb : i;
        }
        int stored = key;
        if (textKeys) {
            stored = (int) asys.strDup((char*) key);
            if (stored == 0) { return -1; }
        }
        if (used == ecap) {
            if (!rebuild(0)) {
                if (textKeys) { freeMem((char*) stored); }
                return -1;
            }
            int mask = icap - 1;
            int i = h & mask;
            while (index[i] != -1) { i = (i + 1) & mask; }
            slot = i;
        }
        int e = used;
        used++;
        live++;
        keys[e] = stored;
        vals[e] = val;
        hashes[e] = h;
        index[slot] = e;
        return 1;
    }

    // stores the value only when the key is new; true when it was stored
    public bool putIfAbsent(int key, int val) {
        if (find(key) >= 0) { return false; }
        return put(key, val) == 1;
    }

    // adds delta to the value (a missing key counts as 0) and returns the new value; for counting things
    public int add(int key, int delta = 1) {
        int e = find(key);
        if (e >= 0) {
            vals[e] = vals[e] + delta;
            return vals[e];
        }
        put(key, delta);
        return delta;
    }

    // true when the key was there
    public bool remove(int key) {
        if (live == 0) { return false; }
        int h = hashKey(key);
        int i = slotOf(key, h);
        if (i < 0) { return false; }
        int mask = icap - 1;
        int e = index[i];
        if (textKeys) { freeMem((char*) keys[e]); }
        keys[e] = 0;
        vals[e] = 0;
        hashes[e] = -1;
        live--;
        if (index[(i + 1) & mask] == -1) {
            // the end of a probe chain: this slot and the tombstones in front of it can become empty slots
            index[i] = -1;
            int j = (i - 1) & mask;
            while (index[j] == -2) {
                index[j] = -1;
                j = (j - 1) & mask;
            }
        } else {
            index[i] = -2;
        }
        return true;
    }

    // ---- entries ---------------------------------------------------------------------------------------------------------
    public bool isEntry(int e) { return e >= 0 && e < used && hashes[e] >= 0; }
    public int keyAt(int e) { return isEntry(e) ? keys[e] : 0; }
    public int valueAt(int e) { return isEntry(e) ? vals[e] : 0; }

    public bool setValueAt(int e, int v) {
        if (!isEntry(e)) { return false; }
        vals[e] = v;
        return true;
    }

    // iteration in insertion order:  for (int e = m.first(); e >= 0; e = m.next(e)) { ... m.keyAt(e) ... m.valueAt(e) ... }
    public int first() { return next(-1); }

    public int next(int e) {
        e++;
        while (e < used) {
            if (hashes[e] >= 0) { return e; }
            e++;
        }
        return -1;
    }

    // all keys and values in insertion order (room for size() ints each; either may be null)
    public int toArrays(int* keysOut, int* valsOut) {
        int w = 0;
        for (int e = 0; e < used; e++) {
            if (hashes[e] < 0) { continue; }
            if (keysOut != null) { keysOut[w] = keys[e]; }
            if (valsOut != null) { valsOut[w] = vals[e]; }
            w++;
        }
        return w;
    }

    // ---- housekeeping --------------------------------------------------------------------------------------------------
    private void freeTextKeys() {
        if (!textKeys) { return; }
        for (int e = 0; e < used; e++) {
            if (hashes[e] >= 0) { freeMem((char*) keys[e]); }
        }
    }

    // removes everything, keeps the capacity
    public void clear() {
        freeTextKeys();
        for (int i = 0; i < icap; i++) { index[i] = -1; }
        for (int e = 0; e < used; e++) { hashes[e] = -1; keys[e] = 0; vals[e] = 0; }
        used = 0;
        live = 0;
    }

    // squeezes out the holes and gives back unused capacity (entry numbers change)
    public bool shrink() {
        if (live == 0) {
            dispose();
            return true;
        }
        return rebuild(0);
    }

    // checks the table against the entries (for tests)
    public bool verify() {
        int cnt = 0;
        for (int e = 0; e < used; e++) {
            if (hashes[e] < 0) { continue; }
            cnt++;
            if (hashes[e] != hashKey(keys[e])) { return false; }
            if (find(keys[e]) != e) { return false; }
        }
        if (cnt != live) { return false; }
        int slots = 0;
        for (int i = 0; i < icap; i++) {
            if (index[i] >= 0) { slots++; }
            if (index[i] >= used) { return false; }
        }
        return slots == live && (icap == 0 || used <= ecap);
    }

    public void dispose() {
        freeTextKeys();
        freeMem(index);
        freeMem(keys);
        freeMem(vals);
        freeMem(hashes);
        index = null;
        keys = null;
        vals = null;
        hashes = null;
        icap = 0;
        ecap = 0;
        used = 0;
        live = 0;
    }
}

// =============================================================================================================================================
//  TextHashMap - a hash map from text to int. The keys are copied (and freed again when removed or disposed).
// =============================================================================================================================================
public class TextHashMap {
    private HashMap m;

    public TextHashMap(int hashSeed = 0) {
        m.init(hashSeed, true);
    }

    private void ensure() {
        m.init(0, true);                               // makes a zeroed map a text map (does nothing once there are entries)
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }
    public int put(char* key, int val) {
        ensure();
        return m.put((int) key, val);
    }
    public bool putIfAbsent(char* key, int val) {
        ensure();
        return m.putIfAbsent((int) key, val);
    }
    public int add(char* key, int delta = 1) {
        ensure();
        return m.add((int) key, delta);
    }
    public int get(char* key, int fallback = 0) { return m.get((int) key, fallback); }
    public bool has(char* key) { return m.has((int) key); }
    public int find(char* key) { return m.find((int) key); }
    public bool remove(char* key) { return m.remove((int) key); }

    public char* keyAt(int e) { return (char*) m.keyAt(e); }
    public int valueAt(int e) { return m.valueAt(e); }
    public bool setValueAt(int e, int v) { return m.setValueAt(e, v); }
    public int first() { return m.first(); }
    public int next(int e) { return m.next(e); }

    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public bool shrink() { return m.shrink(); }
    public void dispose() { m.dispose(); }
}

// =============================================================================================================================================
//  HashSet / TextHashSet - sets of ints / of texts
// =============================================================================================================================================
public class HashSet {
    private HashMap m;

    public HashSet(int hashSeed = 0) {
        m.init(hashSeed, false);
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }
    // 1 for a new key, 0 when it was there, -1 when memory ran out
    public int add(int key) { return m.put(key, 0); }
    public bool has(int key) { return m.has(key); }
    public bool contains(int key) { return m.has(key); }
    public bool remove(int key) { return m.remove(key); }
    public int first() { return m.first(); }
    public int next(int e) { return m.next(e); }
    public int keyAt(int e) { return m.keyAt(e); }
    public int toArray(int* out) { return m.toArrays(out, null); }
    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public void dispose() { m.dispose(); }
}

public class TextHashSet {
    private HashMap m;

    public TextHashSet(int hashSeed = 0) {
        m.init(hashSeed, true);
    }

    private void ensure() {
        m.init(0, true);
    }

    public int size() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }
    public int add(char* key) {
        ensure();
        return m.put((int) key, 0);
    }
    public bool has(char* key) { return m.has((int) key); }
    public bool contains(char* key) { return m.has((int) key); }
    public bool remove(char* key) { return m.remove((int) key); }
    public int first() { return m.first(); }
    public int next(int e) { return m.next(e); }
    public char* keyAt(int e) { return (char*) m.keyAt(e); }
    public bool verify() { return m.verify(); }
    public void clear() { m.clear(); }
    public void dispose() { m.dispose(); }
}

// =============================================================================================================================================
//  Trie - a map from texts (byte strings) to ints with prefix search and wildcard search. Nodes are kept in arrays; the children of
//  a node form a list sorted by byte, so the keys come out in byte order. countPrefix is O(length of the prefix).
// =============================================================================================================================================
// the state of a collect() walk
struct TrieCollect {
    char** out;
    int count;
    int max;
}

private int trieCollectCb(char* key, int val, int ctx) {
    TrieCollect* c = (TrieCollect*) ctx;
    if (c->count >= c->max) { return 1; }
    char* copy = asys.strDup(key);
    if (copy == null) { return 1; }
    c->out[c->count] = copy;
    c->count++;
    return 0;
}

public class Trie {
    private int32* child;                  // first child, -1 for none
    private int32* sib;                    // next sibling (bigger byte), -1 for none
    private int32* par;                    // parent, -1 for the root
    private int32* cnt;                    // number of keys in the subtree
    private char* ch;                      // the byte of the edge into the node
    private char* term;                    // 1 when a key ends here
    private int* val;
    private int cap;
    private int used;
    private int freeHead;                  // free nodes linked through sib, stored + 1
    private int nodes;                     // live nodes, the root included (0 until the first insert)

    public Trie() { }

    // node 0 is the root and is created by the first insert
    private bool reserve() {
        if (freeHead != 0 || used < cap) { return true; }
        int ncap = (cap == 0) ? 32 : cap * 2;
        if (ncap > 0x7FFFFFF0) { return false; }
        int32* a = (int32*) asys.realloc((char*) child, ncap * 4);
        if (a == null) { return false; }
        child = a;
        a = (int32*) asys.realloc((char*) sib, ncap * 4);
        if (a == null) { return false; }
        sib = a;
        a = (int32*) asys.realloc((char*) par, ncap * 4);
        if (a == null) { return false; }
        par = a;
        a = (int32*) asys.realloc((char*) cnt, ncap * 4);
        if (a == null) { return false; }
        cnt = a;
        char* c = asys.realloc(ch, ncap);
        if (c == null) { return false; }
        ch = c;
        c = asys.realloc(term, ncap);
        if (c == null) { return false; }
        term = c;
        int* v = growInts(val, ncap);
        if (v == null) { return false; }
        val = v;
        cap = ncap;
        return true;
    }

    private int newNode(int parent, int c) {
        int t;
        if (freeHead != 0) {
            t = freeHead - 1;
            freeHead = sib[t];
        } else {
            t = used;
            used++;
        }
        child[t] = -1;
        sib[t] = -1;
        par[t] = parent;
        cnt[t] = 0;
        ch[t] = c;
        term[t] = 0;
        val[t] = 0;
        nodes++;
        return t;
    }

    private void freeNode(int t) {
        sib[t] = freeHead;
        freeHead = t + 1;
        par[t] = -2;                           // marks a free node
        nodes--;
    }

    private int childOf(int t, int c) {
        int x = child[t];
        while (x >= 0 && ch[x] < c) { x = sib[x]; }
        if (x >= 0 && ch[x] == c) { return x; }
        return -1;
    }

    // the node of a text, -1 when it is not in the trie (as a key or as the beginning of one)
    private int nodeOf(char* s) {
        if (nodes == 0) { return -1; }
        int t = 0;
        for (int i = 0; s[i] != 0; i++) {
            t = childOf(t, s[i]);
            if (t < 0) { return -1; }
        }
        return t;
    }

    // removes the nodes from t upward that carry no key and have no children
    private void prune(int t) {
        while (t > 0 && term[t] == 0 && child[t] < 0) {
            int p = par[t];
            // unlink t from the sibling list of p
            if (child[p] == t) {
                child[p] = sib[t];
            } else {
                int x = child[p];
                while (sib[x] != t) { x = sib[x]; }
                sib[x] = sib[t];
            }
            freeNode(t);
            t = p;
        }
    }

    public int size() { return (nodes == 0) ? 0 : cnt[0]; }
    public bool isEmpty() { return size() == 0; }
    public int nodeCount() { return nodes; }

    // Adds a key (any bytes but NUL) with a value. Returns 1 for a new key, 0 when the key was there (its value is replaced),
    // -1 when memory ran out (the trie is unchanged).
    public int put(char* key, int value) {
        if (nodes == 0) {
            if (!reserve()) { return -1; }
            newNode(-1, 0);
        }
        int t = 0;
        int created = -1;                      // the first node that was created by this call
        for (int i = 0; key[i] != 0; i++) {
            int c = key[i];
            int prev = -1;
            int x = child[t];
            while (x >= 0 && ch[x] < c) { prev = x; x = sib[x]; }
            if (x >= 0 && ch[x] == c) {
                t = x;
                continue;
            }
            if (!reserve()) {
                if (created >= 0) { prune(t); }
                return -1;
            }
            int nn = newNode(t, c);
            sib[nn] = x;
            if (prev < 0) { child[t] = nn; } else { sib[prev] = nn; }
            if (created < 0) { created = nn; }
            t = nn;
        }
        val[t] = value;
        if (term[t] != 0) { return 0; }
        term[t] = 1;
        int a = t;
        while (a >= 0) {
            cnt[a]++;
            a = par[a];
        }
        return 1;
    }

    public bool has(char* key) {
        int t = nodeOf(key);
        return t >= 0 && term[t] != 0;
    }

    public int get(char* key, int fallback = 0) {
        int t = nodeOf(key);
        if (t < 0 || term[t] == 0) { return fallback; }
        return val[t];
    }

    // true when the key was there
    public bool remove(char* key) {
        int t = nodeOf(key);
        if (t < 0 || term[t] == 0) { return false; }
        term[t] = 0;
        val[t] = 0;
        int a = t;
        while (a >= 0) {
            cnt[a]--;
            a = par[a];
        }
        prune(t);
        return true;
    }

    // how many keys begin with prefix (the prefix itself counts when it is a key); "" counts all
    public int countPrefix(char* prefix) {
        int t = nodeOf(prefix);
        return (t < 0) ? 0 : cnt[t];
    }

    public bool hasPrefix(char* prefix) { return countPrefix(prefix) > 0; }

    // the length of the longest key that is a beginning of text, -1 when there is none; *value gets its value (if not null)
    public int longestPrefixOf(char* text, int* value) {
        if (nodes == 0) { return -1; }
        int t = 0;
        int best = -1;
        if (term[0] != 0) {
            best = 0;
            if (value != null) { *value = val[0]; }
        }
        for (int i = 0; text[i] != 0; i++) {
            t = childOf(t, text[i]);
            if (t < 0) { break; }
            if (term[t] != 0) {
                best = i + 1;
                if (value != null) { *value = val[t]; }
            }
        }
        return best;
    }

    // Walks the subtree below start in key order. buf holds the text of start (length depth); returns what f returned last.
    private int walk(int start, char* prefix, func f, int ctx) {
        int plen = strlen(prefix);
        int bcap = plen + 64;
        char* buf = asys.alloc(bcap + 1);
        if (buf == null) { return -1; }
        memcpy(buf, prefix, plen);
        int depth = plen;
        int t = start;
        int result = 0;
        bool descend = true;
        for (;;) {
            if (descend && term[t] != 0) {
                buf[depth] = 0;
                result = f(buf, val[t], ctx);
                if (result != 0) { break; }
            }
            if (descend && child[t] >= 0) {
                t = child[t];
                if (depth + 1 >= bcap) {
                    bcap = bcap * 2;
                    char* nb = asys.realloc(buf, bcap + 1);
                    if (nb == null) { result = -1; break; }
                    buf = nb;
                }
                buf[depth] = ch[t];
                depth++;
                continue;
            }
            // go to the next sibling, or up
            while (t != start && sib[t] < 0) {
                t = par[t];
                depth--;
            }
            if (t == start) { break; }
            t = sib[t];
            buf[depth - 1] = ch[t];
            descend = true;
        }
        asys.free(buf);
        return result;
    }

    // Calls f(key, value, ctx) for every key that begins with prefix, in byte order, until f returns non-zero (that value is
    // returned). The key text is only valid during the call. f must not change the trie.
    public int walkPrefix(char* prefix, func f, int ctx) {
        int t = nodeOf(prefix);
        if (t < 0 || cnt[t] == 0) { return 0; }
        return walk(t, prefix, f, ctx);
    }

    public int forEach(func f, int ctx) { return walkPrefix("", f, ctx); }

    // Copies up to max keys that begin with prefix into out[] (texts you free with asys.free or ds.freeTexts); returns how many.
    public int collect(char* prefix, char** out, int max) {
        TrieCollect c;
        c.out = out;
        c.count = 0;
        c.max = max;
        walkPrefix(prefix, trieCollectCb, (int) &c);
        return c.count;
    }

    // ---- wildcards --------------------------------------------------------------------------------------------------------
    // Searches with a pattern: ? is any one byte, * any run of bytes (also none), \ takes the next byte literally. The pattern may have
    // at most 62 items besides stars. Calls f(key, value, ctx) for every key that matches the whole pattern, in byte order, until
    // f returns non-zero. Returns how many keys matched (what f returned if it stopped the search); -1 when the pattern is too long.
    // Time: one step per trie node that can still match, so patterns without a leading * are cheap.
    public int walkWildcard(char* pattern, func f, int ctx) {
        if (nodes == 0) { return 0; }
        int masks[256];
        int m = 0;
        int loop = 0;                          // bit i: a star stands in front of item i
        for (int i = 0; i < 256; i++) { masks[i] = 0; }
        int i = 0;
        while (pattern[i] != 0) {
            int c = pattern[i];
            if (c == '*') {
                loop = loop | (1 << m);
                i++;
                continue;
            }
            if (m >= 62) { return -1; }
            if (c == '?') {
                for (int k = 0; k < 256; k++) { masks[k] = masks[k] | (1 << m); }
            } else {
                if (c == '\\' && pattern[i + 1] != 0) {
                    i++;
                    c = pattern[i];
                }
                masks[c] = masks[c] | (1 << m);
            }
            m++;
            i++;
        }
        int accept = 1 << m;
        // iterative walk over the whole trie with the set of live pattern positions per depth
        int bcap = 64;
        char* buf = asys.alloc(bcap + 1);
        int* st = (int*) asys.alloc((bcap + 1) * 8);
        if (buf == null || st == null) {
            freeMem(buf);
            freeMem(st);
            return -1;
        }
        int depth = 0;
        int t = 0;
        st[0] = 1;
        int matched = 0;
        int result = 0;
        bool descend = true;
        for (;;) {
            int s = st[depth];
            if (descend && term[t] != 0 && (s & accept) != 0) {
                buf[depth] = 0;
                matched++;
                result = f(buf, val[t], ctx);
                if (result != 0) { break; }
            }
            if (descend && s != 0 && child[t] >= 0) {
                t = child[t];
                if (depth + 2 >= bcap) {
                    bcap = bcap * 2;
                    char* nb = asys.realloc(buf, bcap + 1);
                    if (nb == null) { result = -1; break; }
                    buf = nb;
                    int* ns = (int*) asys.realloc((char*) st, (bcap + 1) * 8);
                    if (ns == null) { result = -1; break; }
                    st = ns;
                }
                int c = ch[t];
                buf[depth] = c;
                st[depth + 1] = ((s & masks[c]) << 1) | (s & loop);
                depth++;
                continue;
            }
            while (t != 0 && sib[t] < 0) {
                t = par[t];
                depth--;
            }
            if (t == 0) { break; }
            t = sib[t];
            int ps = st[depth - 1];
            int c = ch[t];
            buf[depth - 1] = c;
            st[depth] = ((ps & masks[c]) << 1) | (ps & loop);
            descend = true;
        }
        asys.free(buf);
        asys.free((char*) st);
        if (result != 0) { return result; }
        return matched;
    }

    public int countWildcard(char* pattern) {
        return walkWildcard(pattern, trieCountDummy, 0);
    }

    // copies up to max matching keys (see walkWildcard) into out[]; returns how many
    public int collectWildcard(char* pattern, char** out, int max) {
        TrieCollect c;
        c.out = out;
        c.count = 0;
        c.max = max;
        int r = walkWildcard(pattern, trieCollectCb, (int) &c);
        if (r < 0) { return 0; }
        return c.count;
    }

    // ---- housekeeping --------------------------------------------------------------------------------------------------
    public void clear() {
        used = 0;
        freeHead = 0;
        nodes = 0;
    }

    // checks counts and links (for tests)
    public bool verify() {
        if (nodes == 0) { return true; }
        int live = 0;
        int keys = 0;
        for (int t = 0; t < used; t++) {
            if (t > 0 && par[t] == -2) { continue; }
            live++;
            if (term[t] != 0) { keys++; }
            int sum = (term[t] != 0) ? 1 : 0;
            int last = -1;
            for (int x = child[t]; x >= 0; x = sib[x]) {
                if (par[x] != t || ch[x] <= last) { return false; }
                last = ch[x];
                sum = sum + cnt[x];
            }
            if (sum != cnt[t]) { return false; }
            if (t > 0 && term[t] == 0 && child[t] < 0) { return false; }
        }
        int free = 0;
        int f = freeHead;
        while (f != 0 && free <= used) {
            free++;
            f = sib[f - 1];
        }
        return live == nodes && keys == cnt[0] && used - free == nodes;
    }

    public void dispose() {
        freeMem(child);
        freeMem(sib);
        freeMem(par);
        freeMem(cnt);
        freeMem(ch);
        freeMem(term);
        freeMem(val);
        child = null;
        sib = null;
        par = null;
        cnt = null;
        ch = null;
        term = null;
        val = null;
        cap = 0;
        used = 0;
        freeHead = 0;
        nodes = 0;
    }
}

private int trieCountDummy(char* key, int val, int ctx) {
    return 0;
}

// =============================================================================================================================================
//  DisjointSet - union-find with path compression and union by size; elements are 0 ... count()-1 and more can be added
// =============================================================================================================================================
public class DisjointSet {
    private int* parent;
    private int* sz;
    private int n;
    private int cap;
    public int groups;                     // number of sets

    public DisjointSet(int count = 0) {
        if (count > 0 && count <= 0x1000000000) {
            parent = (int*) asys.alloc(count * 8);
            sz = (int*) asys.alloc(count * 8);
            if (parent == null || sz == null) {
                freeMem(parent);
                freeMem(sz);
                parent = null;
                sz = null;
                return;
            }
            cap = count;
            n = count;
            groups = count;
            for (int i = 0; i < count; i++) {
                parent[i] = i;
                sz[i] = 1;
            }
        }
    }

    public int count() { return n; }

    // adds a new element in a set of its own; returns its number, -1 when memory ran out
    public int add() {
        if (n == cap) {
            int ncap = (cap == 0) ? 16 : cap * 2;
            if (ncap > 0x1000000000) { return -1; }
            int* np = growInts(parent, ncap);
            if (np == null) { return -1; }
            parent = np;
            int* ns = growInts(sz, ncap);
            if (ns == null) { return -1; }
            sz = ns;
            cap = ncap;
        }
        parent[n] = n;
        sz[n] = 1;
        n++;
        groups++;
        return n - 1;
    }

    // the representative of the set of x, -1 for a number that is not an element
    public int find(int x) {
        if (x < 0 || x >= n) { return -1; }
        int r = x;
        while (parent[r] != r) { r = parent[r]; }
        while (parent[x] != r) {
            int nx = parent[x];
            parent[x] = r;
            x = nx;
        }
        return r;
    }

    // joins the sets of a and b; false when they already were one set (or a number is not an element)
    public bool unite(int a, int b) {
        int ra = find(a);
        int rb = find(b);
        if (ra < 0 || rb < 0 || ra == rb) { return false; }
        if (sz[ra] < sz[rb]) {
            int t = ra;
            ra = rb;
            rb = t;
        }
        parent[rb] = ra;
        sz[ra] = sz[ra] + sz[rb];
        groups--;
        return true;
    }

    public bool same(int a, int b) {
        int ra = find(a);
        return ra >= 0 && ra == find(b);
    }

    // the number of elements in the set of x (0 for a bad number)
    public int sizeOf(int x) {
        int r = find(x);
        return (r < 0) ? 0 : sz[r];
    }

    // numbers the sets 0 ... groups - 1 in the order of their first element: out[x] = the number of the set of x
    public int labels(int* out) {
        int* lab = (int*) asys.alloc((n + 1) * 8);
        if (lab == null) { return -1; }
        for (int i = 0; i < n; i++) { lab[i] = -1; }
        int next = 0;
        for (int i = 0; i < n; i++) {
            int r = find(i);
            if (lab[r] < 0) {
                lab[r] = next;
                next++;
            }
            out[i] = lab[r];
        }
        freeMem(lab);
        return next;
    }

    public void dispose() {
        freeMem(parent);
        freeMem(sz);
        parent = null;
        sz = null;
        n = 0;
        cap = 0;
        groups = 0;
    }
}

// =============================================================================================================================================
//  BitSet - a set of the numbers 0 ... size()-1 in a packed array of 64 bit words
// =============================================================================================================================================
public class BitSet {
    private int* w;
    private int nbits;
    private int nwords;

    public BitSet(int count = 0) {
        if (count > 0 && count <= 0x4000000000000) {
            nwords = (count + 63) >> 6;
            w = (int*) asys.alloc(nwords * 8);
            if (w == null) {
                nwords = 0;
            } else {
                nbits = count;
            }
        }
    }

    public int size() { return nbits; }

    // the bits of the last word beyond nbits are kept at 0
    private void trim() {
        int r = nbits & 63;
        if (r != 0 && nwords > 0) { w[nwords - 1] = w[nwords - 1] & ((1 << r) - 1); }
    }

    // Changes the number of bits; new bits are 0. False when memory ran out.
    public bool resize(int count) {
        if (count < 0 || count > 0x4000000000000) { return false; }
        int nw = (count + 63) >> 6;
        if (nw != nwords) {
            if (nw == 0) {
                freeMem(w);
                w = null;
            } else {
                int* nwp = growInts(w, nw);
                if (nwp == null) { return false; }
                w = nwp;
                if (nw < nwords) {
                    // the block keeps its size when it shrinks inside the allocator's class: clear what went out
                    for (int i = nw; i < nwords; i++) { w[i] = 0; }
                }
            }
            nwords = nw;
        }
        nbits = count;
        trim();
        return true;
    }

    public bool get(int i) {
        if (i < 0 || i >= nbits) { return false; }
        return ((w[i >> 6] >> (i & 63)) & 1) != 0;
    }

    // sets bit i to 1 (or to v); out of range is ignored
    public void set(int i, bool v = true) {
        if (i < 0 || i >= nbits) { return; }
        if (v) { w[i >> 6] = w[i >> 6] | (1 << (i & 63)); } else { w[i >> 6] = w[i >> 6] & ~(1 << (i & 63)); }
    }

    public void unset(int i) { set(i, false); }

    public void flip(int i) {
        if (i < 0 || i >= nbits) { return; }
        w[i >> 6] = w[i >> 6] ^ (1 << (i & 63));
    }

    public void clearAll() {
        for (int i = 0; i < nwords; i++) { w[i] = 0; }
    }

    public void setAll() {
        for (int i = 0; i < nwords; i++) { w[i] = -1; }
        trim();
    }

    // bits lo ... hi-1 set to v
    public void setRange(int lo, int hi, bool v = true) {
        if (lo < 0) { lo = 0; }
        if (hi > nbits) { hi = nbits; }
        if (lo >= hi) { return; }
        int fw = lo >> 6;
        int lw = (hi - 1) >> 6;
        int fm = -1 << (lo & 63);
        int lm = -1;
        int tail = hi & 63;
        if (tail != 0) { lm = (1 << tail) - 1; }
        if (fw == lw) {
            int m = fm & lm;
            if (v) { w[fw] = w[fw] | m; } else { w[fw] = w[fw] & ~m; }
            return;
        }
        if (v) { w[fw] = w[fw] | fm; } else { w[fw] = w[fw] & ~fm; }
        for (int i = fw + 1; i < lw; i++) { w[i] = v ? -1 : 0; }
        if (v) { w[lw] = w[lw] | lm; } else { w[lw] = w[lw] & ~lm; }
    }

    public void clearRange(int lo, int hi) { setRange(lo, hi, false); }

    // the number of 1 bits
    public int count() {
        int c = 0;
        for (int i = 0; i < nwords; i++) { c = c + bits.popcount(w[i]); }
        return c;
    }

    public int countRange(int lo, int hi) {
        if (lo < 0) { lo = 0; }
        if (hi > nbits) { hi = nbits; }
        if (lo >= hi) { return 0; }
        int fw = lo >> 6;
        int lw = (hi - 1) >> 6;
        int fm = -1 << (lo & 63);
        int lm = -1;
        int tail = hi & 63;
        if (tail != 0) { lm = (1 << tail) - 1; }
        if (fw == lw) { return bits.popcount(w[fw] & fm & lm); }
        int c = bits.popcount(w[fw] & fm) + bits.popcount(w[lw] & lm);
        for (int i = fw + 1; i < lw; i++) { c = c + bits.popcount(w[i]); }
        return c;
    }

    public bool isEmpty() {
        for (int i = 0; i < nwords; i++) { if (w[i] != 0) { return false; } }
        return true;
    }

    // the first set bit at or after i, -1 when there is none
    public int nextSet(int i) {
        if (i < 0) { i = 0; }
        if (i >= nbits) { return -1; }
        int k = i >> 6;
        int x = w[k] & (-1 << (i & 63));
        for (;;) {
            if (x != 0) { return (k << 6) + bits.ctz(x); }
            k++;
            if (k >= nwords) { return -1; }
            x = w[k];
        }
        return -1;
    }

    // the first clear bit at or after i, -1 when there is none
    public int nextClear(int i) {
        if (i < 0) { i = 0; }
        if (i >= nbits) { return -1; }
        int k = i >> 6;
        int x = ~w[k] & (-1 << (i & 63));
        for (;;) {
            if (x != 0) {
                int r = (k << 6) + bits.ctz(x);
                return (r < nbits) ? r : -1;
            }
            k++;
            if (k >= nwords) { return -1; }
            x = ~w[k];
        }
        return -1;
    }

    // the last set bit at or before i, -1 when there is none
    public int prevSet(int i) {
        if (i >= nbits) { i = nbits - 1; }
        if (i < 0) { return -1; }
        int k = i >> 6;
        int sh = 63 - (i & 63);
        uint64 x = w[k];
        x = (x << sh) >> sh;                  // bits above i dropped
        for (;;) {
            if (x != 0) { return (k << 6) + bits.log2(x); }
            k--;
            if (k < 0) { return -1; }
            x = w[k];
        }
        return -1;
    }

    // ---- set operations (the size of this set stays; bits of other beyond it are ignored, missing bits count as 0) ---------
    private int wordOf(BitSet* o, int k) { return (k < o.nwords) ? o.w[k] : 0; }

    public void orWith(BitSet* o) {
        for (int k = 0; k < nwords; k++) { w[k] = w[k] | wordOf(o, k); }
        trim();
    }

    public void andWith(BitSet* o) {
        for (int k = 0; k < nwords; k++) { w[k] = w[k] & wordOf(o, k); }
    }

    public void xorWith(BitSet* o) {
        for (int k = 0; k < nwords; k++) { w[k] = w[k] ^ wordOf(o, k); }
        trim();
    }

    public void andNotWith(BitSet* o) {
        for (int k = 0; k < nwords; k++) { w[k] = w[k] & ~wordOf(o, k); }
    }

    // every bit of this set is also in o
    public bool isSubsetOf(BitSet* o) {
        for (int k = 0; k < nwords; k++) { if ((w[k] & ~wordOf(o, k)) != 0) { return false; } }
        return true;
    }

    public bool intersects(BitSet* o) {
        for (int k = 0; k < nwords; k++) { if ((w[k] & wordOf(o, k)) != 0) { return true; } }
        return false;
    }

    // same size and same bits
    public bool equals(BitSet* o) {
        if (nbits != o.nbits) { return false; }
        for (int k = 0; k < nwords; k++) { if (w[k] != o.w[k]) { return false; } }
        return true;
    }

    // becomes a copy of o (size included); false when memory ran out
    public bool copyFrom(BitSet* o) {
        if (!resize(o.nbits)) { return false; }
        for (int k = 0; k < nwords; k++) { w[k] = o.w[k]; }
        return true;
    }

    // the numbers of the set bits in ascending order into out[] (at most max); returns how many were stored
    public int toArray(int* out, int max) {
        int c = 0;
        int i = nextSet(0);
        while (i >= 0 && c < max) {
            out[c] = i;
            c++;
            i = nextSet(i + 1);
        }
        return c;
    }

    public void dispose() {
        freeMem(w);
        w = null;
        nbits = 0;
        nwords = 0;
    }
}

// =============================================================================================================================================
//  Fenwick - a binary indexed tree: point update and prefix / range sums in O(log n). Indexes are 0 ... size()-1, sums wrap on overflow.
// =============================================================================================================================================
public class Fenwick {
    private int* t;
    private int n;

    public Fenwick(int size = 0) {
        if (size > 0 && size <= 0x1000000000) {
            t = (int*) asys.alloc((size + 1) * 8);
            if (t != null) { n = size; }
        }
    }

    public int size() { return n; }

    // adds delta to element i (out of range is ignored)
    public void add(int i, int delta) {
        if (i < 0 || i >= n) { return; }
        i++;
        while (i <= n) {
            t[i] = t[i] + delta;
            i = i + (i & -i);
        }
    }

    // the sum of elements 0 ... i (0 for i < 0, everything for i >= size)
    public int prefix(int i) {
        if (i >= n) { i = n - 1; }
        int s = 0;
        i++;
        while (i > 0) {
            s = s + t[i];
            i = i - (i & -i);
        }
        return s;
    }

    // the sum of elements l ... r, both included
    public int sum(int l, int r) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return 0; }
        return prefix(r) - prefix(l - 1);
    }

    public int total() { return prefix(n - 1); }
    public int get(int i) { return sum(i, i); }

    public void set(int i, int v) {
        if (i < 0 || i >= n) { return; }
        add(i, v - get(i));
    }

    // sets all elements from an array in O(n)
    public void build(int* values, int count) {
        int m = (count < n) ? count : n;
        for (int i = 1; i <= n; i++) { t[i] = (i <= m) ? values[i - 1] : 0; }
        for (int i = 1; i <= n; i++) {
            int j = i + (i & -i);
            if (j <= n) { t[j] = t[j] + t[i]; }
        }
    }

    // The smallest index i with prefix(i) >= target, for elements that are never negative; size() when even the total is smaller.
    public int lowerBound(int target) {
        if (target <= 0) { return 0; }
        int pos = 0;
        int pw = 1;
        while (pw * 2 <= n) { pw = pw * 2; }
        while (pw > 0) {
            if (pos + pw <= n && t[pos + pw] < target) {
                pos = pos + pw;
                target = target - t[pos];
            }
            pw = pw >> 1;
        }
        return pos;
    }

    public void clear() {
        for (int i = 0; i <= n; i++) { t[i] = 0; }
    }

    public void dispose() {
        freeMem(t);
        t = null;
        n = 0;
    }
}

// range update, range sum: add(l, r, v) adds v to every element in l ... r, sum(l, r) adds them up (two Fenwick trees)
public class RangeFenwick {
    private int* b1;
    private int* b2;
    private int n;

    public RangeFenwick(int size = 0) {
        if (size > 0 && size <= 0x1000000000) {
            b1 = (int*) asys.alloc((size + 2) * 8);
            b2 = (int*) asys.alloc((size + 2) * 8);
            if (b1 == null || b2 == null) {
                freeMem(b1);
                freeMem(b2);
                b1 = null;
                b2 = null;
            } else {
                n = size;
            }
        }
    }

    public int size() { return n; }

    private void upd(int* b, int i, int v) {
        while (i <= n) {
            b[i] = b[i] + v;
            i = i + (i & -i);
        }
    }

    private int pre(int* b, int i) {
        int s = 0;
        while (i > 0) {
            s = s + b[i];
            i = i - (i & -i);
        }
        return s;
    }

    // adds v to the elements l ... r (clipped to the valid range)
    public void add(int l, int r, int v) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return; }
        int lo = l + 1;
        int hi = r + 1;
        upd(b1, lo, v);
        upd(b1, hi + 1, -v);
        upd(b2, lo, v * (lo - 1));
        upd(b2, hi + 1, -v * hi);
    }

    // the sum of elements 0 ... i
    public int prefix(int i) {
        if (i >= n) { i = n - 1; }
        if (i < 0) { return 0; }
        int p = i + 1;
        return pre(b1, p) * p - pre(b2, p);
    }

    public int sum(int l, int r) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return 0; }
        return prefix(r) - prefix(l - 1);
    }

    public int get(int i) { return sum(i, i); }

    public void dispose() {
        freeMem(b1);
        freeMem(b2);
        b1 = null;
        b2 = null;
        n = 0;
    }
}

// =============================================================================================================================================
//  SegTree - a segment tree over n ints: range sum, minimum or maximum, with lazy range add and range assign, all in O(log n).
//  SEG_SUM / SEG_MIN / SEG_MAX is chosen when it is made. Elements start as 0. Indexes are 0 ... size()-1; ranges are clipped.
//  A query on an empty range gives 0 (sum), the largest int (min) or the smallest int (max). Sums wrap on overflow.
// =============================================================================================================================================
public const SEG_SUM = 0;
public const SEG_MIN = 1;
public const SEG_MAX = 2;

public class SegTree {
    private int* agg;
    private int* lzAdd;
    private int* lzSet;
    private char* hasSet;
    private int n;
    private int leaves;                    // a power of two >= n
    private int op;

    public SegTree(int count = 0, int operation = 0) {
        op = operation;
        if (count > 0 && count <= 0x400000000) {
            int s = 1;
            while (s < count) { s = s * 2; }
            agg = (int*) asys.alloc(2 * s * 8);
            lzAdd = (int*) asys.alloc(2 * s * 8);
            lzSet = (int*) asys.alloc(2 * s * 8);
            hasSet = asys.alloc(2 * s);
            if (agg == null || lzAdd == null || lzSet == null || hasSet == null) {
                dispose();
                return;
            }
            n = count;
            leaves = s;
            initAgg();
        }
    }

    private int identity() {
        if (op == 1) { return 0x7FFFFFFFFFFFFFFF; }
        if (op == 2) { return -0x7FFFFFFFFFFFFFFF - 1; }
        return 0;
    }

    private int combine(int a, int b) {
        if (op == 1) { return (a < b) ? a : b; }
        if (op == 2) { return (a > b) ? a : b; }
        return a + b;
    }

    // leaves 0 for the real elements and the identity for the padding, inner nodes combined
    private void initAgg() {
        for (int i = 0; i < 2 * leaves; i++) {
            agg[i] = 0;
            lzAdd[i] = 0;
            lzSet[i] = 0;
            hasSet[i] = 0;
        }
        if (op != 0) {
            for (int i = n; i < leaves; i++) { agg[leaves + i] = identity(); }
        }
        for (int i = leaves - 1; i >= 1; i--) { agg[i] = combine(agg[2 * i], agg[2 * i + 1]); }
    }

    public int size() { return n; }

    // sets every element from an array (missing ones become 0)
    public void build(int* values, int count) {
        for (int i = 0; i < 2 * leaves; i++) {
            lzAdd[i] = 0;
            lzSet[i] = 0;
            hasSet[i] = 0;
        }
        for (int i = 0; i < leaves; i++) {
            if (i < n) { agg[leaves + i] = (i < count) ? values[i] : 0; } else { agg[leaves + i] = (op == 0) ? 0 : identity(); }
        }
        for (int i = leaves - 1; i >= 1; i--) { agg[i] = combine(agg[2 * i], agg[2 * i + 1]); }
    }

    // applies "assign" (when setFlag) and then "add" to a node that covers len elements
    private void apply(int node, int len, bool setFlag, int setVal, int addVal) {
        if (setFlag) {
            agg[node] = (op == 0) ? setVal * len : setVal;
            lzSet[node] = setVal;
            hasSet[node] = 1;
            lzAdd[node] = 0;
        }
        if (addVal != 0) {
            agg[node] = (op == 0) ? agg[node] + addVal * len : agg[node] + addVal;
            if (hasSet[node] != 0) { lzSet[node] = lzSet[node] + addVal; } else { lzAdd[node] = lzAdd[node] + addVal; }
        }
    }

    private void push(int node, int len) {
        if (hasSet[node] == 0 && lzAdd[node] == 0) { return; }
        int h = len >> 1;
        apply(2 * node, h, hasSet[node] != 0, lzSet[node], lzAdd[node]);
        apply(2 * node + 1, h, hasSet[node] != 0, lzSet[node], lzAdd[node]);
        hasSet[node] = 0;
        lzSet[node] = 0;
        lzAdd[node] = 0;
    }

    // mode 0: add v, 1: assign v
    private void update(int node, int nl, int nr, int l, int r, int mode, int v) {
        if (r < nl || nr < l) { return; }
        if (l <= nl && nr <= r) {
            if (mode == 1) { apply(node, nr - nl + 1, true, v, 0); } else { apply(node, nr - nl + 1, false, 0, v); }
            return;
        }
        push(node, nr - nl + 1);
        int mid = (nl + nr) >> 1;
        update(2 * node, nl, mid, l, r, mode, v);
        update(2 * node + 1, mid + 1, nr, l, r, mode, v);
        agg[node] = combine(agg[2 * node], agg[2 * node + 1]);
    }

    private int queryRec(int node, int nl, int nr, int l, int r) {
        if (r < nl || nr < l) { return identity(); }
        if (l <= nl && nr <= r) { return agg[node]; }
        push(node, nr - nl + 1);
        int mid = (nl + nr) >> 1;
        return combine(queryRec(2 * node, nl, mid, l, r), queryRec(2 * node + 1, mid + 1, nr, l, r));
    }

    // adds v to elements l ... r
    public void add(int l, int r, int v) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return; }
        update(1, 0, leaves - 1, l, r, 0, v);
    }

    // sets elements l ... r to v
    public void assign(int l, int r, int v) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return; }
        update(1, 0, leaves - 1, l, r, 1, v);
    }

    public void set(int i, int v) { assign(i, i, v); }

    // the sum / minimum / maximum of elements l ... r
    public int query(int l, int r) {
        if (l < 0) { l = 0; }
        if (r >= n) { r = n - 1; }
        if (l > r) { return identity(); }
        return queryRec(1, 0, leaves - 1, l, r);
    }

    public int get(int i) {
        if (i < 0 || i >= n) { return 0; }
        return queryRec(1, 0, leaves - 1, i, i);
    }

    // the whole range
    public int total() { return (n == 0) ? identity() : query(0, n - 1); }

    public void dispose() {
        freeMem(agg);
        freeMem(lzAdd);
        freeMem(lzSet);
        freeMem(hasSet);
        agg = null;
        lzAdd = null;
        lzSet = null;
        hasSet = null;
        n = 0;
        leaves = 0;
    }
}

// =============================================================================================================================================
//  IntervalSet - a set of integers kept as sorted, disjoint, closed intervals [lo, hi] (touching intervals are merged).
//  add / remove of a range cost O(log n) plus one step for every interval that is merged or cut away.
// =============================================================================================================================================
public class IntervalSet {
    private OrderedMap m;                  // lo -> hi
    private int total;                     // the number of integers covered (exact unless it reaches 2^63, then it wraps)

    public IntervalSet() { }

    // the number of intervals
    public int count() { return m.size(); }
    public bool isEmpty() { return m.size() == 0; }

    // the number of integers in the set
    public int length() { return total; }

    // a is the end of an interval, b the start of one: they overlap or touch
    private bool touches(int aHi, int bLo) {
        return aHi >= bLo || aHi + 1 == bLo;
    }

    // adds the integers lo ... hi; false when lo > hi or memory ran out
    public bool add(int lo, int hi) {
        if (lo > hi) { return false; }
        int newLo = lo;
        int newHi = hi;
        int p = m.floorNode(lo);
        if (p >= 0 && touches(m.valueAt(p), lo)) {
            newLo = m.keyAt(p);
            if (m.valueAt(p) > newHi) { newHi = m.valueAt(p); }
            total = total - (m.valueAt(p) - m.keyAt(p) + 1);
            m.remove(newLo);
        }
        for (;;) {
            int q = m.ceilNode(lo);
            if (q < 0) { break; }
            int qlo = m.keyAt(q);
            if (!(newHi >= qlo || newHi + 1 == qlo)) { break; }
            int qhi = m.valueAt(q);
            if (qhi > newHi) { newHi = qhi; }
            total = total - (qhi - qlo + 1);
            m.remove(qlo);
        }
        if (m.put(newLo, newHi) < 0) { return false; }
        total = total + (newHi - newLo + 1);
        return true;
    }

    // removes the integers lo ... hi; false when lo > hi or memory ran out (then nothing was changed)
    public bool remove(int lo, int hi) {
        if (lo > hi) { return false; }
        int p = m.floorNode(lo);
        if (p >= 0 && m.valueAt(p) >= lo) {
            int plo = m.keyAt(p);
            int phi = m.valueAt(p);
            if (phi > hi) {
                // the range lies inside this interval: cut a piece out of it
                if (plo < lo) {
                    if (m.put(hi + 1, phi) < 0) { return false; }
                    m.setValueAt(p, lo - 1);
                } else {
                    m.remove(plo);
                    m.put(hi + 1, phi);                // cannot fail: the node of plo was just freed
                }
                total = total - (hi - lo + 1);
                return true;
            }
            if (plo < lo) {
                m.setValueAt(p, lo - 1);
                total = total - (phi - lo + 1);
            } else {
                m.remove(plo);
                total = total - (phi - plo + 1);
            }
        }
        for (;;) {
            int q = m.higherNode(lo);
            if (q < 0) { break; }
            int qlo = m.keyAt(q);
            if (qlo > hi) { break; }
            int qhi = m.valueAt(q);
            m.remove(qlo);
            if (qhi > hi) {
                m.put(hi + 1, qhi);                    // cannot fail: the node of qlo was just freed
                total = total - (hi - qlo + 1);
                break;
            }
            total = total - (qhi - qlo + 1);
        }
        return true;
    }

    public bool contains(int x) {
        int p = m.floorNode(x);
        return p >= 0 && m.valueAt(p) >= x;
    }

    // every integer of lo ... hi is in the set
    public bool covers(int lo, int hi) {
        if (lo > hi) { return false; }
        int p = m.floorNode(lo);
        return p >= 0 && m.valueAt(p) >= hi;
    }

    // some integer of lo ... hi is in the set
    public bool overlaps(int lo, int hi) {
        if (lo > hi) { return false; }
        int p = m.floorNode(lo);
        if (p >= 0 && m.valueAt(p) >= lo) { return true; }
        int q = m.ceilNode(lo);
        return q >= 0 && m.keyAt(q) <= hi;
    }

    // the index (0 ...) of the interval that holds x, -1 when x is not in the set
    public int indexOf(int x) {
        int p = m.floorNode(x);
        if (p < 0 || m.valueAt(p) < x) { return -1; }
        return m.rank(m.keyAt(p));
    }

    // the i-th interval: lowAt(i) .. highAt(i); i is out of range -> 0
    public int lowAt(int i) {
        int t = m.select(i);
        return (t < 0) ? 0 : m.keyAt(t);
    }

    public int highAt(int i) {
        int t = m.select(i);
        return (t < 0) ? 0 : m.valueAt(t);
    }

    // the smallest integer >= x that is not in the set; false (and *out unchanged) when every integer from x up to the largest int is in it
    public bool nextFree(int x, int* out) {
        int p = m.floorNode(x);
        if (p >= 0 && m.valueAt(p) >= x) {
            int hi = m.valueAt(p);
            if (hi == 0x7FFFFFFFFFFFFFFF) { return false; }
            *out = hi + 1;
            return true;
        }
        *out = x;
        return true;
    }

    // the smallest integer of the set that is >= x; false when there is none
    public bool nextMember(int x, int* out) {
        int p = m.floorNode(x);
        if (p >= 0 && m.valueAt(p) >= x) {
            *out = x;
            return true;
        }
        int q = m.ceilNode(x);
        if (q < 0) { return false; }
        *out = m.keyAt(q);
        return true;
    }

    public void clear() {
        m.clear();
        total = 0;
    }

    // checks that the intervals are sorted, disjoint and not touching, and that the total is right (for tests)
    public bool verify() {
        if (!m.verify()) { return false; }
        int sum = 0;
        int prevHi = 0;
        bool have = false;
        for (int t = m.firstNode(); t >= 0; t = m.nextNode(t)) {
            int lo = m.keyAt(t);
            int hi = m.valueAt(t);
            if (lo > hi) { return false; }
            if (have && touches(prevHi, lo)) { return false; }
            have = true;
            prevHi = hi;
            sum = sum + (hi - lo + 1);
        }
        return sum == total;
    }

    public void dispose() {
        m.dispose();
        total = 0;
    }
}

// =============================================================================================================================================
//  LruCache - a cache of at most capacity entries (int key -> int value): when it is full, the entry that was used longest ago is dropped.
//  A hash map finds the entries, a doubly linked list orders them by use. get() and put() make an entry the newest.
//  setEvictHandler(f, ctx): f(key, value, ctx) is called for every entry that leaves the cache (evicted, removed, clear, dispose).
//  Texts as keys: ds.TextLruCache.
// =============================================================================================================================================
public class LruCache {
    private HashMap idx;                   // key -> node
    private int* nkey;
    private int* nval;
    private int32* newer;
    private int32* older;
    private int ncap;                      // node slots allocated
    private int nused;                     // slots handed out so far
    private int freeHead;                  // free slots linked through newer, stored + 1
    private int head;                      // newest node, valid when count > 0
    private int tail;                      // oldest
    private int count;
    private int limit;
    private func onEvict;
    private int evictCtx;
    public int hits;
    public int misses;
    public int evictions;                  // entries dropped because the cache was full

    public LruCache(int capacity = 16) {
        limit = capacity;
    }

    // for TextLruCache: the keys are texts (while the cache is empty)
    public bool init(int capacity, bool text) {
        if (count != 0) { return false; }
        limit = capacity;
        return idx.init(0, text);
    }

    public int capacity() { return limit; }
    public int size() { return count; }
    public bool isEmpty() { return count == 0; }

    public void setEvictHandler(func f, int ctx) {
        onEvict = f;
        evictCtx = ctx;
    }

    private bool reserve() {
        if (freeHead != 0 || nused < ncap) { return true; }
        int nc = (ncap == 0) ? 16 : ncap * 2;
        if (nc > limit) { nc = limit; }
        if (nc <= ncap || nc > 0x7FFFFFF0) { return false; }
        int* a = growInts(nkey, nc);
        if (a == null) { return false; }
        nkey = a;
        a = growInts(nval, nc);
        if (a == null) { return false; }
        nval = a;
        int32* b = (int32*) asys.realloc((char*) newer, nc * 4);
        if (b == null) { return false; }
        newer = b;
        b = (int32*) asys.realloc((char*) older, nc * 4);
        if (b == null) { return false; }
        older = b;
        ncap = nc;
        return true;
    }

    private void unlink(int t) {
        int nw = newer[t];
        int od = older[t];
        if (nw >= 0) { older[nw] = od; } else { head = od; }
        if (od >= 0) { newer[od] = nw; } else { tail = nw; }
    }

    private void linkFront(int t) {
        newer[t] = -1;
        older[t] = (count > 0) ? head : -1;
        if (count > 0) { newer[head] = t; } else { tail = t; }
        head = t;
    }

    private void touch(int t) {
        if (t == head && count > 0) { return; }
        unlink(t);
        // linkFront counts on count > 0 meaning "there is a head"; here the list still has the other entries
        newer[t] = -1;
        older[t] = head;
        newer[head] = t;
        head = t;
    }

    // drops node t: handler, hash entry, slot
    private void drop(int t) {
        if (onEvict != null) { onEvict(nkey[t], nval[t], evictCtx); }
        unlink(t);
        idx.remove(nkey[t]);
        newer[t] = freeHead;
        freeHead = t + 1;
        count--;
    }

    // the value of the key, or fallback; a hit makes the entry the newest
    public int get(int key, int fallback = 0) {
        int e = idx.find(key);
        if (e < 0) {
            misses++;
            return fallback;
        }
        int t = idx.valueAt(e);
        hits++;
        touch(t);
        return nval[t];
    }

    // like get, but the entry keeps its place and the statistics stay as they are
    public int peek(int key, int fallback = 0) {
        int e = idx.find(key);
        return (e < 0) ? fallback : nval[idx.valueAt(e)];
    }

    public bool has(int key) { return idx.find(key) >= 0; }

    // Stores the value and makes the entry the newest; drops the oldest entry first when the cache is full.
    // Returns false when the capacity is 0 or memory ran out.
    public bool put(int key, int val) {
        if (limit <= 0) { return false; }
        int e = idx.find(key);
        if (e >= 0) {
            int t = idx.valueAt(e);
            nval[t] = val;
            touch(t);
            return true;
        }
        if (count >= limit) {
            drop(tail);
            evictions++;
        }
        if (!reserve()) { return false; }
        int t;
        if (freeHead != 0) {
            t = freeHead - 1;
            freeHead = newer[t];
        } else {
            t = nused;
            nused++;
        }
        if (idx.put(key, t) < 0) {
            newer[t] = freeHead;
            freeHead = t + 1;
            return false;
        }
        int e2 = idx.find(key);
        nkey[t] = idx.keyAt(e2);               // for texts: the copy that the hash map owns
        nval[t] = val;
        linkFront(t);
        count++;
        return true;
    }

    // true when the key was there
    public bool remove(int key) {
        int e = idx.find(key);
        if (e < 0) { return false; }
        drop(idx.valueAt(e));
        return true;
    }

    // changes the capacity; entries beyond it are dropped, oldest first (they count as evictions)
    public void setCapacity(int capacity) {
        limit = capacity;
        while (count > limit && count > 0) {
            drop(tail);
            evictions++;
        }
    }

    // iteration from the newest to the oldest entry:  for (int t = c.newest(); t >= 0; t = c.olderThan(t)) { c.keyAt(t) ... }
    public int newest() { return (count == 0) ? -1 : head; }
    public int oldest() { return (count == 0) ? -1 : tail; }
    public int olderThan(int t) { return (t < 0 || t >= nused) ? -1 : older[t]; }
    public int keyAt(int t) { return (t < 0 || t >= nused) ? 0 : nkey[t]; }
    public int valueAt(int t) { return (t < 0 || t >= nused) ? 0 : nval[t]; }

    public void clear() {
        while (count > 0) { drop(head); }
        nused = 0;
        freeHead = 0;
    }

    // checks the list against the hash map (for tests)
    public bool verify() {
        if (!idx.verify() || idx.size() != count) { return false; }
        int seen = 0;
        int t = (count == 0) ? -1 : head;
        int prev = -1;
        while (t >= 0 && seen <= count) {
            if (newer[t] != prev) { return false; }
            if (idx.get(nkey[t], -1) != t) { return false; }
            seen++;
            prev = t;
            t = older[t];
        }
        return seen == count && (count == 0 || prev == tail) && count <= limit;
    }

    public void dispose() {
        clear();
        idx.dispose();
        freeMem(nkey);
        freeMem(nval);
        freeMem(newer);
        freeMem(older);
        nkey = null;
        nval = null;
        newer = null;
        older = null;
        ncap = 0;
        nused = 0;
        freeHead = 0;
        count = 0;
    }
}

public class TextLruCache {
    private LruCache c;

    public TextLruCache(int capacity = 16) {
        c.init(capacity, true);
    }

    private void ensure() {
        c.init(c.capacity(), true);
    }

    public int capacity() { return c.capacity(); }
    public int size() { return c.size(); }
    public int hits() { return c.hits; }
    public int misses() { return c.misses; }
    public int evictions() { return c.evictions; }
    public void setEvictHandler(func f, int ctx) { c.setEvictHandler(f, ctx); }
    public int get(char* key, int fallback = 0) { return c.get((int) key, fallback); }
    public int peek(char* key, int fallback = 0) { return c.peek((int) key, fallback); }
    public bool has(char* key) { return c.has((int) key); }
    public bool put(char* key, int val) {
        ensure();
        return c.put((int) key, val);
    }
    public bool remove(char* key) { return c.remove((int) key); }
    public void setCapacity(int capacity) { c.setCapacity(capacity); }
    public int newest() { return c.newest(); }
    public int oldest() { return c.oldest(); }
    public int olderThan(int t) { return c.olderThan(t); }
    public char* keyAt(int t) { return (char*) c.keyAt(t); }
    public int valueAt(int t) { return c.valueAt(t); }
    public bool verify() { return c.verify(); }
    public void clear() { c.clear(); }
    public void dispose() { c.dispose(); }
}

// =============================================================================================================================================
//  BloomFilter - "maybe in the set" for a very large number of keys in a few bits each. add() never fails; mightContain() never says
//  "no" for a key that was added, and says "yes" for a key that was not with a probability of about 1 / oneIn (when no more than
//  `expected` keys were added). Keys: ints, texts or byte strings. No floating point is used, so the bits are the same on every target.
// =============================================================================================================================================
public class BloomFilter {
    private int* w;
    private int m;                         // bits
    private int k;                         // hash functions
    private int added;
    private int seed;

    public BloomFilter(int expected = 1000, int oneIn = 100, int hashSeed = 0) {
        if (expected < 1) { expected = 1; }
        if (oneIn < 2) { oneIn = 2; }
        seed = hashSeed;
        // l2 = log2(oneIn) in thousandths: the exponent plus x * (1.3466 - 0.3466 * x) for the fraction x of the next power of two
        int lg = bits.log2(oneIn);
        int xp = (oneIn - (1 << lg)) * 1000 / (1 << lg);
        int l2 = lg * 1000 + xp * (13466 - 3466 * xp / 1000) / 10000;
        k = (l2 + 500) / 1000;                 // the optimal number of hash functions is log2(1 / p)
        if (k < 1) { k = 1; }
        int perKey = (l2 * 14427 / 10000 + 999) / 1000;        // l2 / ln 2 bits per key, rounded up
        if (perKey < 1) { perKey = 1; }
        if (expected > 0x100000000000 / perKey) { return; }
        int bitsWanted = expected * perKey;
        if (bitsWanted < 64) { bitsWanted = 64; }
        int words = (bitsWanted + 63) >> 6;
        w = (int*) asys.alloc(words * 8);
        if (w == null) {
            k = 0;
            return;
        }
        m = words * 64;
    }

    public int bitCount() { return m; }
    public int hashCount() { return k; }

    // how many add() calls were made (a key added twice counts twice)
    public int count() { return added; }

    private void setBits(uint64 h1) {
        uint64 h2 = mix64(h1 ^ 0x9E3779B97F4A7C15) | 1;
        uint64 mm = m;
        for (int i = 0; i < k; i++) {
            uint64 b = (h1 + i * h2) % mm;
            w[b >> 6] = w[b >> 6] | (1 << (b & 63));
        }
        added++;
    }

    private bool testBits(uint64 h1) {
        if (m == 0) { return false; }
        uint64 h2 = mix64(h1 ^ 0x9E3779B97F4A7C15) | 1;
        uint64 mm = m;
        for (int i = 0; i < k; i++) {
            uint64 b = (h1 + i * h2) % mm;
            if (((w[b >> 6] >> (b & 63)) & 1) == 0) { return false; }
        }
        return true;
    }

    public void add(int key) { if (m > 0) { setBits(hashInt(key, seed)); } }
    public void addText(char* s) { if (m > 0) { setBits(hashText(s, seed)); } }
    public void addBytes(char* p, int n) { if (m > 0) { setBits(hashBytes(p, n, seed)); } }
    public bool mightContain(int key) { return testBits(hashInt(key, seed)); }
    public bool mightContainText(char* s) { return testBits(hashText(s, seed)); }
    public bool mightContainBytes(char* p, int n) { return testBits(hashBytes(p, n, seed)); }

    // the share of bits that are 1, in parts per thousand
    public int fillPermille() {
        if (m == 0) { return 0; }
        int ones = 0;
        for (int i = 0; i < m / 64; i++) { ones = ones + bits.popcount(w[i]); }
        return ones * 1000 / m;
    }

    // the false positive probability right now, estimated from the fill (fill ^ k), in parts per million
    public int falsePositivePpm() {
        if (m == 0) { return 0; }
        int ones = 0;
        for (int i = 0; i < m / 64; i++) { ones = ones + bits.popcount(w[i]); }
        int p = 1000000;
        for (int i = 0; i < k; i++) { p = p * (ones * 1000 / m) / 1000; }
        return p;
    }

    // adds the keys of other (same size, hash count and seed); false when they do not fit
    public bool merge(BloomFilter* other) {
        if (other.m != m || other.k != k || other.seed != seed || m == 0) { return false; }
        for (int i = 0; i < m / 64; i++) { w[i] = w[i] | other.w[i]; }
        added = added + other.added;
        return true;
    }

    public void clear() {
        for (int i = 0; i < m / 64; i++) { w[i] = 0; }
        added = 0;
    }

    public void dispose() {
        freeMem(w);
        w = null;
        m = 0;
        k = 0;
        added = 0;
    }
}

// =============================================================================================================================================
//  CountMinSketch - approximate counts of keys in a fixed table of width * depth counters. estimate(key) is never smaller than the
//  true count and, with probability 1 - exp(-depth), at most the true count + e / width * total().
//  (width = ceil(e / error), depth = ceil(ln(1 / failure probability)): width 272 and depth 5 give an error of 1 % of the total
//  with probability 99.3 %.) With setConservative(true) only the smallest counters of a key are raised, which keeps the estimates lower.
// =============================================================================================================================================
public class CountMinSketch {
    private int* t;
    private int width;
    private int depth;
    private int seed;
    private int sum;
    private bool conservative;

    public CountMinSketch(int w = 272, int d = 5, int hashSeed = 0) {
        if (w < 1 || d < 1 || w > 0x100000000 || d > 64) { return; }
        t = (int*) asys.alloc(w * d * 8);
        if (t == null) { return; }
        width = w;
        depth = d;
        seed = hashSeed;
    }

    public int widthOf() { return width; }
    public int depthOf() { return depth; }

    // the sum of everything added
    public int total() { return sum; }

    public void setConservative(bool on) { conservative = on; }

    private int cell(int row, int h) {
        uint64 x = mix64(h + row * 0x9E3779B97F4A7C15);
        uint64 ww = width;
        return row * width + (x % ww);
    }

    private void addHash(int h, int amount) {
        if (width == 0 || amount <= 0) { return; }
        sum = sum + amount;
        if (conservative) {
            int est = estimateHash(h) + amount;
            for (int r = 0; r < depth; r++) {
                int c = cell(r, h);
                if (t[c] < est) { t[c] = est; }
            }
            return;
        }
        for (int r = 0; r < depth; r++) {
            int c = cell(r, h);
            t[c] = t[c] + amount;
        }
    }

    private int estimateHash(int h) {
        if (width == 0) { return 0; }
        int best = t[cell(0, h)];
        for (int r = 1; r < depth; r++) {
            int v = t[cell(r, h)];
            if (v < best) { best = v; }
        }
        return best;
    }

    // adds amount (> 0) to the count of the key
    public void add(int key, int amount = 1) { addHash(hashInt(key, seed), amount); }
    public void addText(char* s, int amount = 1) { addHash(hashText(s, seed), amount); }
    public void addBytes(char* p, int n, int amount = 1) { addHash(hashBytes(p, n, seed), amount); }
    public int estimate(int key) { return estimateHash(hashInt(key, seed)); }
    public int estimateText(char* s) { return estimateHash(hashText(s, seed)); }
    public int estimateBytes(char* p, int n) { return estimateHash(hashBytes(p, n, seed)); }

    // adds the counts of other (same width, depth and seed); false when they do not fit
    public bool merge(CountMinSketch* other) {
        if (other.width != width || other.depth != depth || other.seed != seed || width == 0) { return false; }
        for (int i = 0; i < width * depth; i++) { t[i] = t[i] + other.t[i]; }
        sum = sum + other.sum;
        return true;
    }

    public void clear() {
        for (int i = 0; i < width * depth; i++) { t[i] = 0; }
        sum = 0;
    }

    public void dispose() {
        freeMem(t);
        t = null;
        width = 0;
        depth = 0;
        sum = 0;
    }
}
