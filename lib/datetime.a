// =============================================================================
//  datetime - dates and times (UTC)                         import datetime;
//
//    int  datetime.now()                  seconds since 1970-01-01 00:00:00 UTC
//    int  datetime.nowMillis()
//    datetime.DateTime* d = new datetime.DateTime(datetime.now());
//    d->year d->month d->day d->hour d->minute d->second d->weekday (0 = Sunday)
//    d->toString()  -> "2026-10-11 16:05:09"
// =============================================================================
module datetime;

// current time in seconds since the Unix epoch
public int now() {
    if (__OS == 1) {
        int ft[1];
        __winapi(11, &ft[0], 0, 0, 0);                // GetSystemTimeAsFileTime (100 ns since 1601)
        return ft[0] / 10000000 - 11644473600;
    }
    int ts[2];
    int nr = 228;
    if (__ARCH >= 1) {
        nr = 113;
    }
    __syscall(nr, 0, &ts[0], 0, 0, 0, 0);             // clock_gettime(CLOCK_REALTIME)
    return ts[0];
}

public int nowMillis() {
    if (__OS == 1) {
        int ft[1];
        __winapi(11, &ft[0], 0, 0, 0);
        return ft[0] / 10000 - 11644473600000;
    }
    int ts[2];
    int nr = 228;
    if (__ARCH >= 1) {
        nr = 113;
    }
    __syscall(nr, 0, &ts[0], 0, 0, 0, 0);
    return ts[0] * 1000 + ts[1] / 1000000;
}

public bool isLeapYear(int y) {
    return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
}

public int daysInMonth(int y, int m) {
    if (m == 2) {
        if (isLeapYear(y)) {
            return 29;
        }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) {
        return 30;
    }
    return 31;
}

private int floorDiv(int a, int b) {
    int q = a / b;
    if (a % b != 0 && ((a < 0) != (b < 0))) {
        q--;
    }
    return q;
}

// days since 1970-01-01 for a calendar date
public int daysFromCivil(int y, int m, int d) {
    if (m <= 2) {
        y--;
    }
    int era = floorDiv(y, 400);
    int yoe = y - era * 400;
    int mp = m + 9;
    if (m > 2) {
        mp = m - 3;
    }
    int doy = (153 * mp + 2) / 5 + d - 1;
    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

// 0 = Sunday ... 6 = Saturday
public int dayOfWeek(int y, int m, int d) {
    int w = (daysFromCivil(y, m, d) + 4) % 7;
    if (w < 0) {
        w = w + 7;
    }
    return w;
}

// seconds since the epoch for a UTC date and time
public int toUnix(int y, int m, int d, int h, int mi, int s) {
    return daysFromCivil(y, m, d) * 86400 + h * 3600 + mi * 60 + s;
}

public char* weekdayName(int w) {
    switch (w) {
        case 0: return "Sunday";
        case 1: return "Monday";
        case 2: return "Tuesday";
        case 3: return "Wednesday";
        case 4: return "Thursday";
        case 5: return "Friday";
        case 6: return "Saturday";
    }
    return "?";
}

public char* monthName(int m) {
    switch (m) {
        case 1: return "January";
        case 2: return "February";
        case 3: return "March";
        case 4: return "April";
        case 5: return "May";
        case 6: return "June";
        case 7: return "July";
        case 8: return "August";
        case 9: return "September";
        case 10: return "October";
        case 11: return "November";
        case 12: return "December";
    }
    return "?";
}

public class DateTime {
    public int year;
    public int month;
    public int day;
    public int hour;
    public int minute;
    public int second;
    public int weekday;
    public int yearDay;                 // 1 .. 366

    public DateTime(int unix) {
        set(unix);
    }

    // sets all fields from seconds since the epoch
    public void set(int unix) {
        int days = floorDiv(unix, 86400);
        int rem = unix - days * 86400;
        hour = rem / 3600;
        minute = rem % 3600 / 60;
        second = rem % 60;
        weekday = (days + 4) % 7;
        if (weekday < 0) {
            weekday = weekday + 7;
        }
        int z = days + 719468;
        int era = floorDiv(z, 146097);
        int doe = z - era * 146097;
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int mp = (5 * doy + 2) / 153;
        day = doy - (153 * mp + 2) / 5 + 1;
        if (mp < 10) {
            month = mp + 3;
        } else {
            month = mp - 9;
        }
        if (month <= 2) {
            y++;
        }
        year = y;
        yearDay = daysFromCivil(year, month, day) - daysFromCivil(year, 1, 1) + 1;
    }

    public int toUnix() {
        return datetime.toUnix(year, month, day, hour, minute, second);
    }

    // "2026-10-11"
    public char* dateString() {
        char buf[32];
        format(&buf[0], 32, "%04d-%02d-%02d", year, month, day, 0);
        return strdup(buf);
    }

    // "16:05:09"
    public char* timeString() {
        char buf[32];
        format(&buf[0], 32, "%02d:%02d:%02d", hour, minute, second, 0);
        return strdup(buf);
    }

    // "2026-10-11 16:05:09"
    public char* toString() {
        char buf[48];
        format(&buf[0], 48, "%04d-%02d-%02d %02d:", year, month, day, hour);
        char tail[16];
        format(&tail[0], 16, "%02d:%02d", minute, second, 0, 0);
        strcat(buf, tail);
        return strdup(buf);
    }
}
