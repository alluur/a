// the page of the web display backend (generated by docs/gen_wweb_page.py from docs/web/index.html; do not edit)
module wwebpage;

public char* html() {
    return
    "<!doctype html>\n"
    "<html lang=\"en\">\n"
    "<head>\n"
    "<meta charset=\"utf-8\">\n"
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    "<title>A display</title>\n"
    "<style>\n"
    "html, body { margin: 0; height: 100%; background: #10141c; overflow: hidden; font-family: sans-serif; }\n"
    "#wrap { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; }\n"
    "canvas { cursor: none; outline: none; image-rendering: auto; max-width: 100%; max-height: 100%; background: #000; }\n"
    "#status { position: fixed; left: 12px; bottom: 10px; padding: 4px 10px; border-radius: 6px; background: #0008; color: #fff; font-size: 13px; display: none; }\n"
    "</style>\n"
    "</head>\n"
    "<body>\n"
    "<div id=\"wrap\"><canvas id=\"c\" tabindex=\"0\"></canvas></div>\n"
    "<div id=\"status\"></div>\n"
    "<script>\n"
    "(function () {\n"
    "  var token = \"@TOKEN@\";\n"
    "  var cv = document.getElementById(\"c\"), cx = cv.getContext(\"2d\");\n"
    "  var st = document.getElementById(\"status\");\n"
    "  var ws = null, W = 0, H = 0, retry = null;\n"
    "  var named = { Enter: 13, Backspace: 8, Tab: 9, Escape: 27, Delete: 127, ArrowLeft: 300, ArrowRight: 301, ArrowUp: 302, ArrowDown: 303,\n"
    "                Home: 304, End: 305, PageUp: 306, PageDown: 307, Insert: 308, Shift: 340, Control: 341, Alt: 342, Meta: 343, CapsLock: 344 };\n"
    "  for (var i = 1; i <= 12; i++) { named[\"F\" + i] = 319 + i; }\n"
    "\n"
    "  function status(t) { st.textContent = t; st.style.display = t ? \"block\" : \"none\"; }\n"
    "\n"
    "  function connect() {\n"
    "    var url = (location.protocol === \"https:\" ? \"wss://\" : \"ws://\") + location.host + \"/ws?t=\" + encodeURIComponent(token);\n"
    "    ws = new WebSocket(url);\n"
    "    ws.binaryType = \"arraybuffer\";\n"
    "    ws.onopen = function () { status(\"\"); cv.focus(); };\n"
    "    ws.onmessage = function (e) {\n"
    "      var d = new DataView(e.data), t = d.getUint8(0);\n"
    "      if (t === 1) { W = d.getUint16(1); H = d.getUint16(3); cv.width = W; cv.height = H; }\n"
    "      else if (t === 2) { rect(d); }\n"
    "    };\n"
    "    ws.onclose = function () { status(\"disconnected, trying again\"); clearTimeout(retry); retry = setTimeout(connect, 1500); };\n"
    "  }\n"
    "\n"
    "  function rect(d) {\n"
    "    var x = d.getUint16(1), y = d.getUint16(3), w = d.getUint16(5), h = d.getUint16(7);\n"
    "    var im = cx.createImageData(w, h), o = im.data, p = 9, n = w * h, i = 0, len = d.byteLength, q, j, k;\n"
    "    while (i < n && p < len) {\n"
    "      var c = d.getUint8(p++);\n"
    "      if (c < 128) {\n"
    "        k = c + 1;\n"
    "        for (j = 0; j < k && i < n; j++) { q = i * 4; o[q] = d.getUint8(p); o[q + 1] = d.getUint8(p + 1); o[q + 2] = d.getUint8(p + 2); o[q + 3] = 255; p += 3; i++; }\n"
    "      } else {\n"
    "        k = c - 125;\n"
    "        var r = d.getUint8(p), g = d.getUint8(p + 1), b = d.getUint8(p + 2);\n"
    "        p += 3;\n"
    "        for (j = 0; j < k && i < n; j++) { q = i * 4; o[q] = r; o[q + 1] = g; o[q + 2] = b; o[q + 3] = 255; i++; }\n"
    "      }\n"
    "    }\n"
    "    cx.putImageData(im, x, y);\n"
    "  }\n"
    "\n"
    "  function send(bytes) { if (ws && ws.readyState === 1) { ws.send(new Uint8Array(bytes)); } }\n"
    "  function u16(v) { return [(v >> 8) & 255, v & 255]; }\n"
    "  function pos(e) {\n"
    "    var r = cv.getBoundingClientRect();\n"
    "    var x = Math.round((e.clientX - r.left) * W / r.width), y = Math.round((e.clientY - r.top) * H / r.height);\n"
    "    return [Math.max(0, Math.min(W - 1, x)), Math.max(0, Math.min(H - 1, y))];\n"
    "  }\n"
    "  function button(e) { return e.button === 0 ? 1 : (e.button === 1 ? 2 : 3); }\n"
    "\n"
    "  cv.addEventListener(\"mousemove\", function (e) { var p = pos(e); send([1].concat(u16(p[0]), u16(p[1]))); });\n"
    "  cv.addEventListener(\"mousedown\", function (e) { var p = pos(e); send([1].concat(u16(p[0]), u16(p[1]))); send([2, button(e)]); cv.focus(); e.preventDefault(); });\n"
    "  cv.addEventListener(\"mouseup\", function (e) { send([3, button(e)]); e.preventDefault(); });\n"
    "  cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n"
    "  cv.addEventListener(\"wheel\", function (e) { send([4, e.deltaY < 0 ? 1 : 255]); e.preventDefault(); }, { passive: false });\n"
    "\n"
    "  function code(e) {\n"
    "    var k = e.key;\n"
    "    if (named[k] !== undefined) { return [named[k], 0]; }\n"
    "    if (k.length === 0) { return null; }\n"
    "    var cp = k.codePointAt(0);\n"
    "    if (k.length > 2 || (k.length === 2 && cp < 65536)) { return null; }       // names such as \"Dead\" or \"Unidentified\"\n"
    "    var lower = k.toLowerCase();\n"
    "    var key = (lower.length === k.length && lower.codePointAt(0) < 65536) ? lower.codePointAt(0) : cp;\n"
    "    return [key & 0xFFFF, cp];\n"
    "  }\n"
    "  function key(e, down) {\n"
    "    var c = code(e);\n"
    "    if (!c) { return; }\n"
    "    if (down) { send([5].concat(u16(c[0]), [(c[1] >>> 24) & 255, (c[1] >> 16) & 255, (c[1] >> 8) & 255, c[1] & 255])); }\n"
    "    else { send([6].concat(u16(c[0]))); }\n"
    "    e.preventDefault();\n"
    "  }\n"
    "  cv.addEventListener(\"keydown\", function (e) { key(e, true); });\n"
    "  cv.addEventListener(\"keyup\", function (e) { key(e, false); });\n"
    "  cv.addEventListener(\"blur\", function () { [340, 341, 342, 343].forEach(function (k) { send([6].concat(u16(k))); }); });\n"
    "\n"
    "  connect();\n"
    "})();\n"
    "</script>\n"
    "</body>\n"
    "</html>\n"
    "\n";
}

// the page with the token put in (the token has only letters and digits)
public char* withToken(char* page, char* token) {
    int n = strlen(page);
    int tn = strlen(token);
    char* out = alloc(n + tn + 16);
    int o = 0;
    for (int i = 0; i < n; i++) {
        if (page[i] == '@' && page[i + 1] == 'T' && page[i + 2] == 'O' && page[i + 3] == 'K' && page[i + 4] == 'E' && page[i + 5] == 'N' && page[i + 6] == '@') {
            for (int k = 0; k < tn; k++) { out[o] = token[k]; o++; }
            i = i + 6;
        } else {
            out[o] = page[i];
            o++;
        }
    }
    out[o] = 0;
    return out;
}
