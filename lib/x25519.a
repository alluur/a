// =============================================================================
//  x25519 - elliptic curve Diffie-Hellman on Curve25519 (RFC 7748)                                   import x25519;
//
//    char priv[32]; secure.bytes(&priv[0], 32);
//    char pub[32];  x25519.base(&pub[0], &priv[0]);                  // public key
//    char shared[32]; x25519.scalarmult(&shared[0], &priv[0], &peerPub[0]);   // false if the result is all zeros
//
//  Keys, points and results are 32 bytes in the little-endian order of the RFC. The field arithmetic is bn's Montgomery code.
// =============================================================================
import bn;
module x25519;

private bn.Mont* fp = null;
private bn.Num* a24 = null;

private void init() {
    if (fp != null) { return; }
    char p[32];
    for (int i = 0; i < 32; i++) { p[i] = 255; }
    p[0] = 127;
    p[31] = 237;                        // 2^255 - 19, big-endian
    fp = bn.mont(bn.fromBytes(&p[0], 32, 9));
    a24 = bn.toMont(fp, bn.fromInt(121665, 9));
}

private bn.Num* fromLE(char* b) {
    char r[32];
    for (int i = 0; i < 32; i++) { r[i] = b[31 - i]; }
    r[0] = r[0] & 127;                  // the top bit of u is ignored
    return bn.fromBytes(&r[0], 32, 9);
}

// out = k * u; false if the result is the all zero point (a small order input)
public bool scalarmult(char* out, char* k, char* u) {
    init();
    char kk[32];
    for (int i = 0; i < 32; i++) { kk[i] = k[i]; }
    kk[0] = kk[0] & 248;
    kk[31] = (kk[31] & 127) | 64;
    bn.Num* x1 = bn.toMont(fp, fromLE(u));
    bn.Num* x2 = bn.copy(fp->one);
    bn.Num* z2 = bn.make(9);
    bn.Num* x3 = bn.copy(x1);
    bn.Num* z3 = bn.copy(fp->one);
    bn.Num* a = bn.make(9);
    bn.Num* aa = bn.make(9);
    bn.Num* b = bn.make(9);
    bn.Num* bb = bn.make(9);
    bn.Num* e = bn.make(9);
    bn.Num* c = bn.make(9);
    bn.Num* d = bn.make(9);
    bn.Num* da = bn.make(9);
    bn.Num* cb = bn.make(9);
    bn.Num* t = bn.make(9);
    int swap = 0;
    for (int i = 254; i >= 0; i--) {
        int kt = (kk[i / 8] >> (i % 8)) & 1;
        if ((swap ^ kt) != 0) {
            bn.Num* s1 = x2; x2 = x3; x3 = s1;
            bn.Num* s2 = z2; z2 = z3; z3 = s2;
        }
        swap = kt;
        bn.addMod(fp, a, x2, z2);
        bn.mulInto(fp, aa, a, a);
        bn.subMod(fp, b, x2, z2);
        bn.mulInto(fp, bb, b, b);
        bn.subMod(fp, e, aa, bb);
        bn.addMod(fp, c, x3, z3);
        bn.subMod(fp, d, x3, z3);
        bn.mulInto(fp, da, d, a);
        bn.mulInto(fp, cb, c, b);
        bn.addMod(fp, t, da, cb);
        bn.mulInto(fp, x3, t, t);
        bn.subMod(fp, t, da, cb);
        bn.mulInto(fp, t, t, t);
        bn.mulInto(fp, z3, x1, t);
        bn.mulInto(fp, x2, aa, bb);
        bn.mulInto(fp, t, a24, e);
        bn.addMod(fp, t, aa, t);
        bn.mulInto(fp, z2, e, t);
    }
    if (swap != 0) {
        bn.Num* s1 = x2; x2 = x3; x3 = s1;
        bn.Num* s2 = z2; z2 = z3; z3 = s2;
    }
    bn.Num* r = bn.fromMont(fp, bn.mul(fp, x2, bn.invMont(fp, z2)));
    char be[32];
    bn.toBytes(r, &be[0], 32);
    int acc = 0;
    for (int i = 0; i < 32; i++) {
        out[i] = be[31 - i];
        acc = acc | (be[i] & 255);
    }
    return acc != 0;
}

public void base(char* out, char* k) {
    char nine[32];
    for (int i = 0; i < 32; i++) { nine[i] = 0; }
    nine[0] = 9;
    scalarmult(out, k, &nine[0]);
}
