// =============================================================================
//  testing - a tiny unit test helper                          import testing;
//
//    testing.assertEq(4, add(2, 2), "add works");
//    testing.assertStrEq("abc", upper("abc"), "upper keeps case");
//    return testing.summary();            // prints the totals, exit code = number of failures
// =============================================================================
module testing;

private int passed;
private int failed;

public void reset() {
    passed = 0;
    failed = 0;
}

public void check(bool condition, char* name) {
    if (condition) {
        passed++;
    } else {
        failed++;
        printf("FAIL  %s\n", (int)name, 0, 0, 0);
    }
}

public void assertEq(int expected, int actual, char* name) {
    if (expected == actual) {
        passed++;
    } else {
        failed++;
        printf("FAIL  %s: expected %d but got %d\n", (int)name, expected, actual, 0);
    }
}

public void assertStrEq(char* expected, char* actual, char* name) {
    if (actual != null && streq(expected, actual)) {
        passed++;
    } else {
        failed++;
        if (actual == null) {
            actual = "(null)";
        }
        printf("FAIL  %s: expected \"%s\" but got \"%s\"\n", (int)name, (int)expected, (int)actual, 0);
    }
}

public int passedCount() { return passed; }
public int failedCount() { return failed; }

// prints "N passed, M failed" and returns M (use it as the exit code of main)
public int summary() {
    printf("%d passed, %d failed\n", passed, failed, 0, 0);
    return failed;
}
