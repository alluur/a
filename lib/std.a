// =============================================================================
//  A standard library (prelude) - compiled into every program automatically.
//  Written in A itself on top of the compiler's built-in runtime calls:
//    __write(fd, buf, len)  __read(fd, buf, len)  __exit(code)
//  (and __syscall(nr, a1..a6) on Linux/Android).
// =============================================================================

// ---- strings ----------------------------------------------------------------
int strlen(char* s) {
    int n = 0;
    while (s[n] != 0) {
        n++;
    }
    return n;
}

bool streq(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] == b[i];
}

// returns <0, 0 or >0 like C strcmp
int strcmp(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] - b[i];
}

void memcpy(char* dst, char* src, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = src[i];
    }
}

void memset(char* dst, int value, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = value;
    }
}

// ---- process ------------------------------------------------------------------
void exit(int code) {
    __exit(code);
}

// ---- output (stdout) ------------------------------------------------------------
void printChar(char c) {
    char b = c;
    __write(1, &b, 1);
}

void print(char* s) {
    __write(1, s, strlen(s));
}

void println(char* s) {
    __write(1, s, strlen(s));
    printChar(10);
}

void printInt(int n) {
    char buf[24];
    int i = 24;
    if (n == 0) {
        printChar('0');
        return;
    }
    bool neg = n < 0;
    while (n != 0) {
        int d = n % 10;
        if (d < 0) {
            d = -d;
        }
        i--;
        buf[i] = '0' + d;
        n = n / 10;
    }
    if (neg) {
        i--;
        buf[i] = '-';
    }
    __write(1, &buf[i], 24 - i);
}

void printlnInt(int n) {
    printInt(n);
    printChar(10);
}

void printBool(bool b) {
    if (b) {
        print("true");
    } else {
        print("false");
    }
}

// ---- output (stderr) ---------------------------------------------------------------
void eprint(char* s) {
    __write(2, s, strlen(s));
}

void eprintln(char* s) {
    __write(2, s, strlen(s));
    char nl = 10;
    __write(2, &nl, 1);
}

// ---- input (stdin) -------------------------------------------------------------------
// reads one byte, returns -1 at end of input
int readChar() {
    char b;
    int n = __read(0, &b, 1);
    if (n <= 0) {
        return -1;
    }
    return b;
}

// reads a line (without the newline) into buf, returns its length (-1 at EOF)
int readLine(char* buf, int max) {
    int n = 0;
    while (n < max - 1) {
        int c = readChar();
        if (c < 0) {
            if (n == 0) {
                return -1;
            }
            break;
        }
        if (c == 10) {
            break;
        }
        buf[n] = c;
        n++;
    }
    buf[n] = 0;
    return n;
}

int atoi(char* s) {
    int i = 0;
    int sign = 1;
    int v = 0;
    if (s[0] == '-') {
        sign = -1;
        i = 1;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    return v * sign;
}

// ---- math helpers -----------------------------------------------------------------------
int abs(int x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

int min(int a, int b) {
    if (a < b) {
        return a;
    }
    return b;
}

int max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

// ---- memory: a simple bump allocator over a 64 MiB static heap ------------------------------
char __heap[64 * 1024 * 1024];
int __heap_pos;

// returns zeroed memory; it is never freed
char* alloc(int size) {
    size = (size + 15) & ~15;
    if (__heap_pos + size > 64 * 1024 * 1024) {
        eprintln("fatal: out of memory");
        exit(1);
    }
    char* p = &__heap[__heap_pos];
    __heap_pos = __heap_pos + size;
    return p;
}

// ---- Windows command line -> argc / argv ------------------------------------------------------
// (used by the program entry code on Windows; __cmdline() returns null elsewhere)
char** __win_argv;

char** __win_argv_get() {
    return __win_argv;
}

int __win_init_args() {
    char* cmd = __cmdline();
    if (cmd == null) {
        return 0;
    }
    int len = strlen(cmd);
    char* buf = alloc(len + 2);
    char** argv = (char**) alloc(8 * (len / 2 + 2));
    int argc = 0;
    int i = 0;
    int o = 0;
    for (;;) {
        while (cmd[i] == ' ' || cmd[i] == 9) {
            i++;
        }
        if (cmd[i] == 0) {
            break;
        }
        argv[argc] = &buf[o];
        argc++;
        bool inq = false;
        while (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
            int bs = 0;
            while (cmd[i] == 92) {
                bs++;
                i++;
            }
            if (cmd[i] == 34) {
                for (int k = 0; k < bs / 2; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (bs % 2 == 1) {
                    buf[o] = 34;
                    o++;
                } else {
                    inq = !inq;
                }
                i++;
            } else {
                for (int k = 0; k < bs; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
                    buf[o] = cmd[i];
                    o++;
                    i++;
                }
            }
        }
        buf[o] = 0;
        o++;
    }
    argv[argc] = null;
    __win_argv = argv;
    return argc;
}
