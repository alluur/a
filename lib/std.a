// =============================================================================
//  A standard library (prelude) - compiled into every program automatically.
//  Written in A itself on top of the compiler's built-in runtime calls:
//    __write(fd, buf, len)  __read(fd, buf, len)  __exit(code)
//  (and __syscall(nr, a1..a6) on Linux/Android).
// =============================================================================

// ---- strings ----------------------------------------------------------------
int strlen(char* s) {
    int n = 0;
    while (s[n] != 0) {
        n++;
    }
    return n;
}

bool streq(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] == b[i];
}

// returns <0, 0 or >0 like C strcmp
int strcmp(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] - b[i];
}

void memcpy(char* dst, char* src, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = src[i];
    }
}

void memset(char* dst, int value, int n) {
    for (int i = 0; i < n; i++) {
        dst[i] = value;
    }
}

// ---- process ------------------------------------------------------------------
void exit(int code) {
    __exit(code);
}

// ---- output (stdout) ------------------------------------------------------------
void printChar(char c) {
    char b = c;
    __write(1, &b, 1);
}

void print(char* s) {
    __write(1, s, strlen(s));
}

void println(char* s) {
    __write(1, s, strlen(s));
    printChar(10);
}

void printInt(int n) {
    char buf[24];
    int i = 24;
    if (n == 0) {
        printChar('0');
        return;
    }
    bool neg = n < 0;
    while (n != 0) {
        int d = n % 10;
        if (d < 0) {
            d = -d;
        }
        i--;
        buf[i] = '0' + d;
        n = n / 10;
    }
    if (neg) {
        i--;
        buf[i] = '-';
    }
    __write(1, &buf[i], 24 - i);
}

void printlnInt(int n) {
    printInt(n);
    printChar(10);
}

void printBool(bool b) {
    if (b) {
        print("true");
    } else {
        print("false");
    }
}

// ---- output (stderr) ---------------------------------------------------------------
void eprint(char* s) {
    __write(2, s, strlen(s));
}

void eprintln(char* s) {
    __write(2, s, strlen(s));
    char nl = 10;
    __write(2, &nl, 1);
}

// ---- input (stdin, buffered) ---------------------------------------------------------------------
char __inbuf[4096];
int __inpos;
int __inlen;

// reads one byte, returns -1 at the end of the input
int readChar() {
    if (__inpos >= __inlen) {
        __inlen = __read(0, &__inbuf[0], 4096);
        __inpos = 0;
        if (__inlen <= 0) {
            __inlen = 0;
            return -1;
        }
    }
    int c = __inbuf[__inpos];
    __inpos++;
    return c;
}

// reads a line (without "\n" / "\r\n") into buf, returns its length (-1 at the end of the input)
int readLine(char* buf, int max) {
    int n = 0;
    while (n < max - 1) {
        int c = readChar();
        if (c < 0) {
            if (n == 0) {
                return -1;
            }
            break;
        }
        if (c == 10) {
            break;
        }
        if (c != 13) {
            buf[n] = c;
            n++;
        }
    }
    buf[n] = 0;
    return n;
}

// prints a prompt, reads a line and returns it as a new heap string (null at the end of input)
char* input(char* prompt) {
    print(prompt);
    char line[1024];
    if (readLine(line, 1024) < 0) {
        return null;
    }
    return strdup(line);
}

// the rest of standard input as one heap string
char* readAll() {
    char* start = &__heap[__heap_pos];
    int len = 0;
    int room = 64 * 1024 * 1024 - __heap_pos - 16;
    for (;;) {
        int c = readChar();
        if (c < 0 || len >= room) {
            break;
        }
        start[len] = c;
        len++;
    }
    start[len] = 0;
    __heap_pos = (__heap_pos + len + 16) & ~15;
    return start;
}

// parses a decimal number with an optional sign; false if the text is not a number
bool parseInt(char* s, int* out) {
    int i = 0;
    int sign = 1;
    while (isSpace(s[i])) {
        i++;
    }
    if (s[i] == '-') {
        sign = -1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    if (!isDigit(s[i])) {
        return false;
    }
    int v = 0;
    while (isDigit(s[i])) {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    while (isSpace(s[i])) {
        i++;
    }
    if (s[i] != 0) {
        return false;
    }
    *out = v * sign;
    return true;
}

// asks until the user types a number (returns 0 at the end of the input)
int askInt(char* prompt) {
    for (;;) {
        char* s = input(prompt);
        if (s == null) {
            return 0;
        }
        int v;
        if (parseInt(s, &v)) {
            return v;
        }
        println("Please enter a whole number.");
    }
}

// asks a yes / no question
bool confirm(char* prompt) {
    char* s = input(prompt);
    if (s == null) {
        return false;
    }
    return s[0] == 'y' || s[0] == 'Y';
}

int atoi(char* s) {
    int i = 0;
    int sign = 1;
    int v = 0;
    if (s[0] == '-') {
        sign = -1;
        i = 1;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    return v * sign;
}

// ---- math helpers -----------------------------------------------------------------------
int abs(int x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

int min(int a, int b) {
    if (a < b) {
        return a;
    }
    return b;
}

int max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

// ---- character classes ------------------------------------------------------------------------
bool isDigit(int c) { return c >= '0' && c <= '9'; }
bool isUpper(int c) { return c >= 'A' && c <= 'Z'; }
bool isLower(int c) { return c >= 'a' && c <= 'z'; }
bool isAlpha(int c) { return isUpper(c) || isLower(c); }
bool isSpace(int c) { return c == ' ' || c == 9 || c == 10 || c == 13; }
int toUpper(int c) { if (isLower(c)) return c - 32; return c; }
int toLower(int c) { if (isUpper(c)) return c + 32; return c; }

// ---- more string helpers --------------------------------------------------------------------------
char* strcpy(char* dst, char* src) {
    int i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return dst;
}

char* strcat(char* dst, char* src) {
    strcpy(&dst[strlen(dst)], src);
    return dst;
}

// duplicates a string on the heap
char* strdup(char* s) {
    char* p = alloc(strlen(s) + 1);
    strcpy(p, s);
    return p;
}

// index of the first occurrence of c in s, or -1
int indexOf(char* s, int c) {
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == c) {
            return i;
        }
    }
    return -1;
}

// true if s starts with prefix
bool startsWith(char* s, char* prefix) {
    int i = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i++;
    }
    return true;
}

// writes the decimal form of n into buf (at least 21 bytes), returns buf
char* intToStr(int n, char* buf) {
    char tmp[24];
    int i = 24;
    int pos = 0;
    bool neg = n < 0;
    if (n == 0) {
        buf[0] = '0';
        buf[1] = 0;
        return buf;
    }
    while (n != 0) {
        int d = n % 10;
        if (d < 0) {
            d = -d;
        }
        i--;
        tmp[i] = '0' + d;
        n = n / 10;
    }
    if (neg) {
        buf[pos] = '-';
        pos++;
    }
    while (i < 24) {
        buf[pos] = tmp[i];
        pos++;
        i++;
    }
    buf[pos] = 0;
    return buf;
}

void printHex(int n) {
    char buf[20];
    int i = 20;
    if (n == 0) {
        printChar('0');
        return;
    }
    while (n != 0) {
        int d = n & 15;
        i--;
        if (d < 10) {
            buf[i] = '0' + d;
        } else {
            buf[i] = 'a' + d - 10;
        }
        n = (n >> 4) & 0x0FFFFFFFFFFFFFFF;
    }
    __write(1, &buf[i], 20 - i);
}

// ---- pseudo random numbers (xorshift) -------------------------------------------------------------------
int __rand_state = 88172645463325252;

void srand(int seed) {
    if (seed == 0) {
        seed = 88172645463325252;
    }
    __rand_state = seed;
}

// returns a value in 0 .. 2^31-1
int rand() {
    int x = __rand_state;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    __rand_state = x;
    return (x >> 8) & 0x7FFFFFFF;
}

// ---- files ----------------------------------------------------------------------------------------------------
// fileOpen modes
const FILE_READ = 0;
const FILE_WRITE = 1;       // create or truncate
const FILE_APPEND = 2;

// returns a handle (>= 0) or a negative number on error
int fileOpen(char* path, int mode) {
    return __open(path, mode);
}

void fileClose(int handle) {
    __close(handle);
}

int fileRead(int handle, char* buf, int n) {
    return __read(handle, buf, n);
}

int fileWrite(int handle, char* buf, int n) {
    return __write(handle, buf, n);
}

// reads a whole file into the heap as a NUL terminated string, null if it cannot be opened
char* readFile(char* path) {
    int h = __open(path, 0);
    if (h < 0) {
        return null;
    }
    char* start = &__heap[__heap_pos];
    int len = 0;
    int room = 64 * 1024 * 1024 - __heap_pos - 16;
    for (;;) {
        int n = __read(h, &start[len], room - len);
        if (n <= 0) {
            break;
        }
        len = len + n;
    }
    __close(h);
    start[len] = 0;
    __heap_pos = (__heap_pos + len + 16) & ~15;
    return start;
}

// writes text to a file (created / truncated). Returns true on success
bool writeFile(char* path, char* text) {
    int h = __open(path, 1);
    if (h < 0) {
        return false;
    }
    int n = strlen(text);
    int done = __write(h, text, n);
    __close(h);
    return done == n;
}

// ---- more strings -----------------------------------------------------------------------------------
bool endsWith(char* s, char* suffix) {
    int n = strlen(s);
    int m = strlen(suffix);
    if (m > n) {
        return false;
    }
    return streq(&s[n - m], suffix);
}

// index of the first occurrence of sub in s, or -1
int find(char* s, char* sub) {
    int n = strlen(s);
    int m = strlen(sub);
    for (int i = 0; i + m <= n; i++) {
        int k = 0;
        while (k < m && s[i + k] == sub[k]) {
            k++;
        }
        if (k == m) {
            return i;
        }
    }
    return -1;
}

bool contains(char* s, char* sub) {
    return find(s, sub) >= 0;
}

// new heap string with len characters of s starting at start
char* substr(char* s, int start, int len) {
    char* p = alloc(len + 1);
    memcpy(p, &s[start], len);
    return p;
}

// removes spaces at both ends in place, returns the (possibly advanced) pointer
char* trim(char* s) {
    while (isSpace(s[0])) {
        s = &s[1];
    }
    int n = strlen(s);
    while (n > 0 && isSpace(s[n - 1])) {
        n--;
        s[n] = 0;
    }
    return s;
}

void strUpper(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        s[i] = toUpper(s[i]);
    }
}

void strLower(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        s[i] = toLower(s[i]);
    }
}

// equal ignoring upper / lower case
bool streqi(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && toLower(a[i]) == toLower(b[i])) {
        i++;
    }
    return a[i] == b[i];
}

void hexToStr(int n, char* buf) {
    char tmp[20];
    int i = 20;
    int pos = 0;
    if (n == 0) {
        buf[0] = '0';
        buf[1] = 0;
        return;
    }
    while (n != 0) {
        int d = n & 15;
        i--;
        if (d < 10) {
            tmp[i] = '0' + d;
        } else {
            tmp[i] = 'a' + d - 10;
        }
        n = (n >> 4) & 0x0FFFFFFFFFFFFFFF;
    }
    while (i < 20) {
        buf[pos] = tmp[i];
        pos++;
        i++;
    }
    buf[pos] = 0;
}

// ---- formatted output -------------------------------------------------------------------------------------
// format(out, max, fmt, a, b, c, d): printf style formatting into a buffer, returns the length.
//   %d  number    %x  hex    %c  character    %s  string    %%  percent sign
//   a width such as %5d or %-8s pads with spaces, %05d pads numbers with zeros
// Up to four values; pass 0 for unused ones (text arguments are passed as they are).
int format(char* out, int max, char* fmt, int a, int b, int c, int d) {
    int args[4];
    args[0] = a;
    args[1] = b;
    args[2] = c;
    args[3] = d;
    int ai = 0;
    int o = 0;
    int i = 0;
    char tmp[24];
    while (fmt[i] != 0 && o < max - 1) {
        if (fmt[i] != '%') {
            out[o] = fmt[i];
            o++;
            i++;
            continue;
        }
        i++;
        if (fmt[i] == '%') {
            out[o] = '%';
            o++;
            i++;
            continue;
        }
        bool left = false;
        bool zero = false;
        int width = 0;
        if (fmt[i] == '-') {
            left = true;
            i++;
        }
        if (fmt[i] == '0') {
            zero = true;
            i++;
        }
        while (isDigit(fmt[i])) {
            width = width * 10 + (fmt[i] - '0');
            i++;
        }
        char t = fmt[i];
        if (t == 0) {
            break;
        }
        i++;
        int v = 0;
        if (ai < 4) {
            v = args[ai];
        }
        ai++;
        char* s = tmp;
        if (t == 'd') {
            intToStr(v, tmp);
        } else if (t == 'x') {
            hexToStr(v, tmp);
        } else if (t == 'c') {
            tmp[0] = v;
            tmp[1] = 0;
        } else if (t == 's') {
            s = (char*) v;
            if (v == 0) {
                s = "(null)";
            }
        } else {
            tmp[0] = '%';
            tmp[1] = t;
            tmp[2] = 0;
            ai--;
        }
        int len = strlen(s);
        int pad = width - len;
        if (pad < 0) {
            pad = 0;
        }
        if (!left) {
            while (pad > 0 && o < max - 1) {
                if (zero) {
                    out[o] = '0';
                } else {
                    out[o] = ' ';
                }
                o++;
                pad--;
            }
        }
        for (int k = 0; k < len && o < max - 1; k++) {
            out[o] = s[k];
            o++;
        }
        while (pad > 0 && o < max - 1) {
            out[o] = ' ';
            o++;
            pad--;
        }
    }
    out[o] = 0;
    return o;
}

// printf("%s is %d years old\n", name, age, 0, 0)
void printf(char* fmt, int a, int b, int c, int d) {
    char buf[2048];
    format(&buf[0], 2048, fmt, a, b, c, d);
    print(buf);
}

// writes ch n times
void printRepeat(char ch, int n) {
    for (int i = 0; i < n; i++) {
        printChar(ch);
    }
}

// ---- terminal: colours and cursor ----------------------------------------------------------------------------
const ANSI_RESET = "\e[0m";
const ANSI_BOLD = "\e[1m";
const ANSI_RED = "\e[31m";
const ANSI_GREEN = "\e[32m";
const ANSI_YELLOW = "\e[33m";
const ANSI_BLUE = "\e[34m";
const ANSI_MAGENTA = "\e[35m";
const ANSI_CYAN = "\e[36m";
const ANSI_GRAY = "\e[90m";

bool __ansi_ready;

// call once before using colours: turns on ANSI escape handling in the Windows console
void ansiInit() {
    if (__OS == 1 && !__ansi_ready) {
        int h = __winapi(0, -11, 0, 0, 0);           // GetStdHandle(STD_OUTPUT_HANDLE)
        __winapi(7, h, 7, 0, 0);                      // SetConsoleMode(PROCESSED | WRAP | VT)
    }
    __ansi_ready = true;
}

// true if the file descriptor (0 input, 1 output, 2 error) is a terminal, not a file or pipe
bool isTerminal(int fd) {
    if (__OS == 1) {
        int h = __winapi(0, -10 - fd, 0, 0, 0);       // GetStdHandle
        return ((__winapi(10, h, 0, 0, 0) << 32) >> 32) == 2;   // GetFileType == FILE_TYPE_CHAR
    }
    char termios[64];
    int nr = 16;
    if (__ARCH == 1) {
        nr = 29;
    }
    return __syscall(nr, fd, 0x5401, &termios[0], 0, 0, 0) == 0;
}

// prints text in a colour (one of the ANSI_ constants) when standard output is a terminal
void printColor(char* color, char* text) {
    if (isTerminal(1)) {
        ansiInit();
        print(color);
        print(text);
        print(ANSI_RESET);
    } else {
        print(text);
    }
}

void clearScreen() {
    ansiInit();
    print("\e[2J\e[H");
}

// moves the cursor (rows and columns start at 1)
void cursorTo(int row, int col) {
    ansiInit();
    printf("\e[%d;%dH", row, col, 0, 0);
}

// ---- command line arguments ------------------------------------------------------------------------------------
// index of the argument equal to flag (searching from 1), or -1
int argIndex(int argc, char** argv, char* flag) {
    for (int i = 1; i < argc; i++) {
        if (streq(argv[i], flag)) {
            return i;
        }
    }
    return -1;
}

bool hasArg(int argc, char** argv, char* flag) {
    return argIndex(argc, argv, flag) >= 0;
}

// the argument that follows flag ("-o file" -> "file"), or fallback
char* argValue(int argc, char** argv, char* flag, char* fallback) {
    int i = argIndex(argc, argv, flag);
    if (i < 0 || i + 1 >= argc) {
        return fallback;
    }
    return argv[i + 1];
}

// ---- time ---------------------------------------------------------------------------------------------------------
// milliseconds since an arbitrary start (use differences)
int millis() {
    if (__OS == 1) {
        return __winapi(9, 0, 0, 0, 0);               // GetTickCount64
    }
    int ts[2];
    int nr = 228;
    if (__ARCH == 1) {
        nr = 113;
    }
    __syscall(nr, 1, &ts[0], 0, 0, 0, 0);             // clock_gettime(CLOCK_MONOTONIC)
    return ts[0] * 1000 + ts[1] / 1000000;
}

void sleepMs(int ms) {
    if (__OS == 1) {
        __winapi(8, ms, 0, 0, 0);                     // Sleep
        return;
    }
    int ts[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int nr = 35;
    if (__ARCH == 1) {
        nr = 101;
    }
    __syscall(nr, &ts[0], 0, 0, 0, 0, 0);             // nanosleep
}

// ---- memory: a simple bump allocator over a 64 MiB static heap ------------------------------
char __heap[64 * 1024 * 1024];
int __heap_pos;

// returns zeroed memory; it is never freed
char* alloc(int size) {
    size = (size + 15) & ~15;
    if (__heap_pos + size > 64 * 1024 * 1024) {
        eprintln("fatal: out of memory");
        exit(1);
    }
    char* p = &__heap[__heap_pos];
    __heap_pos = __heap_pos + size;
    return p;
}

// ---- Windows command line -> argc / argv ------------------------------------------------------
// (used by the program entry code on Windows; __cmdline() returns null elsewhere)
char** __win_argv;

char** __win_argv_get() {
    return __win_argv;
}

int __win_init_args() {
    char* cmd = __cmdline();
    if (cmd == null) {
        return 0;
    }
    int len = strlen(cmd);
    char* buf = alloc(len + 2);
    char** argv = (char**) alloc(8 * (len / 2 + 2));
    int argc = 0;
    int i = 0;
    int o = 0;
    for (;;) {
        while (cmd[i] == ' ' || cmd[i] == 9) {
            i++;
        }
        if (cmd[i] == 0) {
            break;
        }
        argv[argc] = &buf[o];
        argc++;
        bool inq = false;
        while (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
            int bs = 0;
            while (cmd[i] == 92) {
                bs++;
                i++;
            }
            if (cmd[i] == 34) {
                for (int k = 0; k < bs / 2; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (bs % 2 == 1) {
                    buf[o] = 34;
                    o++;
                } else {
                    inq = !inq;
                }
                i++;
            } else {
                for (int k = 0; k < bs; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
                    buf[o] = cmd[i];
                    o++;
                    i++;
                }
            }
        }
        buf[o] = 0;
        o++;
    }
    argv[argc] = null;
    __win_argv = argv;
    return argc;
}
