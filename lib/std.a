// =============================================================================
//  A standard library (prelude) - compiled into every program automatically.
//  Written in A itself on top of the compiler's built-in runtime calls:
//    __write(fd, buf, len)  __read(fd, buf, len)  __exit(code)
//  (and __syscall(nr, a1..a6) on Linux/Android).
// =============================================================================

// ---- strings ----------------------------------------------------------------
// the x86-64 versions of strlen, memcpy and memset use word-at-a-time scanning / rep movsb / rep stosb (machine code from docs/memfast.asm, assembled with
// nasm); small copies take a plain byte loop because the start-up of "rep" is slower than a few loop rounds. Every other target uses
// the portable loops.
static if (__ARCH == 0) {
    int strlen(char* s) {
        return asm(s) {
            x64: 0x48, 0x89, 0xC6, 0x48, 0x89, 0xC7, 0x48, 0x83, 0xE7, 0xF8, 0x49, 0xBA, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x49, 0xBB, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x4C, 0x8B, 0x07, 0x89, 0xF1, 0x83, 0xE1, 0x07, 0xC1, 0xE1, 0x03, 0x41, 0xB9, 0x01, 0x00, 0x00, 0x00, 0x49, 0xD3, 0xE1, 0x49, 0xFF, 0xC9, 0x4D, 0x09, 0xC8, 0x4C, 0x89, 0xC0, 0x4C, 0x29, 0xD0, 0x4D, 0x89, 0xC1, 0x49, 0xF7, 0xD1, 0x4C, 0x21, 0xC8, 0x4C, 0x21, 0xD8, 0x75, 0x09, 0x48, 0x83, 0xC7, 0x08, 0x4C, 0x8B, 0x07, 0xEB, 0xE3, 0x48, 0x0F, 0xBC, 0xC0, 0x48, 0xC1, 0xE8, 0x03, 0x48, 0x01, 0xF8, 0x48, 0x29, 0xF0;
            arm64: 0xD503201F;
            riscv64: 0x00000013;
            loongarch64: 0x03400000;
        };
    }
} else {
    int strlen(char* s) {
        int n = 0;
        while (s[n] != 0) {
            n++;
        }
        return n;
    }
}

// ---- enum reflection: the tables are built by the compiler (Color.name(v), Color.parse("Red"), Color.has(v)) -------------------------
// a table is  { count, value0, name0, value1, name1, ... }
char* __enum_name(int* t, int v) {
    int n = t[0];
    for (int i = 0; i < n; i++) {
        if (t[1 + i * 2] == v) {
            return (char*) t[2 + i * 2];
        }
    }
    return "?";
}

bool __enum_has(int* t, int v) {
    int n = t[0];
    for (int i = 0; i < n; i++) {
        if (t[1 + i * 2] == v) {
            return true;
        }
    }
    return false;
}

int __enum_parse(int* t, char* s, int fallback) {
    int n = t[0];
    for (int i = 0; i < n; i++) {
        if (streq((char*) t[2 + i * 2], s)) {
            return t[1 + i * 2];
        }
    }
    return fallback;
}

bool streq(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] == b[i];
}

// returns <0, 0 or >0 like C strcmp
int strcmp(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) {
        i++;
    }
    return a[i] - b[i];
}

// the hash that switch on text uses for its labels (FNV-1a over the bytes up to the NUL, 32 bits); the compiler computes the
// same function for the case labels (sw_hash in src/switch.asm). The product of a 32 bit value and 16777619 fits an int.
int __swhash(char* s) {
    int h = 2166136261;
    int i = 0;
    while (s[i] != 0) {
        h = ((h ^ s[i]) * 16777619) & 0xFFFFFFFF;
        i++;
    }
    return h;
}

// x is Class / x as Class: does the object at obj (whose vtable pointer is at byte offset off) belong to the class that owns the
// vtable vt, or to a class derived from it? A vtable has two header words before its first slot: the address of the text that names
// its class ("module.Class"), two words before the slot, and the address of the vtable of the base class (0 if none), one word before it.
// Every translation unit that includes a class from a header has its own copy of the vtable of that class, so the vtable addresses of
// an object made in another unit differ: the class is then recognised by its name text.
bool __isa(char* obj, int off, int* vt) {
    if (obj == null) {
        return false;
    }
    int* v = (int*) *((int*) (obj + off));
    char* want = (char*) vt[-2];
    while (v != null) {
        if (v == vt) {
            return true;
        }
        char* have = (char*) v[-2];
        int i = 0;
        while (have[i] == want[i]) {
            if (have[i] == 0) {
                return true;
            }
            i++;
        }
        v = (int*) v[-1];
    }
    return false;
}

static if (__ARCH == 0) {
    void memcpy(char* dst, char* src, int n) {
        asm(dst, src, n) {
            x64: 0x48, 0x89, 0xC7, 0x48, 0x89, 0xCE, 0x48, 0x89, 0xD1, 0x48, 0x85, 0xC9, 0x7E, 0x19, 0x48, 0x83, 0xF9, 0x20, 0x73, 0x11, 0x8A, 0x06, 0x88, 0x07, 0x48, 0xFF, 0xC6, 0x48, 0xFF, 0xC7, 0x48, 0xFF, 0xC9, 0x75, 0xF1, 0xEB, 0x02, 0xF3, 0xA4;
            arm64: 0xD503201F;
            riscv64: 0x00000013;
            loongarch64: 0x03400000;
        }
    }

    void memset(char* dst, int value, int n) {
        asm(dst, value, n) {
            x64: 0x48, 0x89, 0xC7, 0x48, 0x89, 0xC8, 0x48, 0x89, 0xD1, 0x48, 0x85, 0xC9, 0x7E, 0x14, 0x48, 0x83, 0xF9, 0x20, 0x73, 0x0C, 0x88, 0x07, 0x48, 0xFF, 0xC7, 0x48, 0xFF, 0xC9, 0x75, 0xF6, 0xEB, 0x02, 0xF3, 0xAA;
            arm64: 0xD503201F;
            riscv64: 0x00000013;
            loongarch64: 0x03400000;
        }
    }

    // stores `count` copies of an 8 byte value (pixel rows of gfx)
    void __fill64(int* dst, int value, int count) {
        asm(dst, value, count) {
            x64: 0x48, 0x89, 0xC7, 0x48, 0x89, 0xC8, 0x48, 0x89, 0xD1, 0x48, 0x85, 0xC9, 0x7E, 0x03, 0xF3, 0x48, 0xAB;
            arm64: 0xD503201F;
            riscv64: 0x00000013;
            loongarch64: 0x03400000;
        }
    }
} else {
    void memcpy(char* dst, char* src, int n) {
        for (int i = 0; i < n; i++) {
            dst[i] = src[i];
        }
    }

    void memset(char* dst, int value, int n) {
        for (int i = 0; i < n; i++) {
            dst[i] = value;
        }
    }

    void __fill64(int* dst, int value, int count) {
        for (int i = 0; i < count; i++) {
            dst[i] = value;
        }
    }
}

// ---- process ------------------------------------------------------------------
// Output streams with a write buffer (see the cstdio module) register themselves here: the first three
// words of each record are { handle, buffer address, bytes waiting }. exit writes out what is still waiting.
int* __wreg[64];

// functions registered with atexit (cstdlib module), run by exit in reverse order
func __atexit_fn[32];
int __atexit_n;

void exit(int code) {
    while (__atexit_n > 0) {
        __atexit_n--;
        func f = __atexit_fn[__atexit_n];
        f();
    }
    for (int i = 0; i < 64; i++) {
        int* r = __wreg[i];
        if (r != null && r[2] > 0) {
            __write(r[0], (char*) r[1], r[2]);
            r[2] = 0;
        }
    }
    __exit(code);
}

// ---- output (stdout) ------------------------------------------------------------
void printChar(char c) {
    char b = c;
    __write(1, &b, 1);
}

void print(char* s) {
    __write(1, s, strlen(s));
}

void println(char* s) {
    __write(1, s, strlen(s));
    printChar(10);
}

void printInt(int n) {
    char buf[24];
    int i = 24;
    if (n == 0) {
        printChar('0');
        return;
    }
    bool neg = n < 0;
    while (n != 0) {
        int d = n % 10;
        if (d < 0) {
            d = -d;
        }
        i--;
        buf[i] = '0' + d;
        n = n / 10;
    }
    if (neg) {
        i--;
        buf[i] = '-';
    }
    __write(1, &buf[i], 24 - i);
}

void printlnInt(int n) {
    printInt(n);
    printChar(10);
}

void printBool(bool b) {
    if (b) {
        print("true");
    } else {
        print("false");
    }
}

// ---- output (stderr) ---------------------------------------------------------------
void eprint(char* s) {
    __write(2, s, strlen(s));
}

void eprintln(char* s) {
    __write(2, s, strlen(s));
    char nl = 10;
    __write(2, &nl, 1);
}

// ---- input (stdin, buffered) ---------------------------------------------------------------------
char __inbuf[4096];
int __inpos;
int __inlen;

// reads one byte, returns -1 at the end of the input
int readChar() {
    if (__inpos >= __inlen) {
        __inlen = __read(0, &__inbuf[0], 4096);
        __inpos = 0;
        if (__inlen <= 0) {
            __inlen = 0;
            return -1;
        }
    }
    int c = __inbuf[__inpos];
    __inpos++;
    return c;
}

// reads a line (without "\n" / "\r\n") into buf, returns its length (-1 at the end of the input)
int readLine(char* buf, int max) {
    int n = 0;
    while (n < max - 1) {
        int c = readChar();
        if (c < 0) {
            if (n == 0) {
                return -1;
            }
            break;
        }
        if (c == 10) {
            break;
        }
        if (c != 13) {
            buf[n] = c;
            n++;
        }
    }
    buf[n] = 0;
    return n;
}

// prints a prompt, reads a line and returns it as a new heap string (null at the end of input)
char* input(char* prompt) {
    print(prompt);
    char line[1024];
    if (readLine(line, 1024) < 0) {
        return null;
    }
    return strdup(line);
}

// the rest of standard input as one heap string
char* readAll() {
    char* start = &__heap[__heap_pos];
    int len = 0;
    int room = 64 * 1024 * 1024 - __heap_pos - 16;
    for (;;) {
        int c = readChar();
        if (c < 0 || len >= room) {
            break;
        }
        start[len] = c;
        len++;
    }
    start[len] = 0;
    __heap_pos = (__heap_pos + len + 16) & ~15;
    return start;
}

// parses a decimal number with an optional sign; false if the text is not a number
bool parseInt(char* s, int* out) {
    int i = 0;
    int sign = 1;
    while (isSpace(s[i])) {
        i++;
    }
    if (s[i] == '-') {
        sign = -1;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    if (!isDigit(s[i])) {
        return false;
    }
    int v = 0;
    while (isDigit(s[i])) {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    while (isSpace(s[i])) {
        i++;
    }
    if (s[i] != 0) {
        return false;
    }
    *out = v * sign;
    return true;
}

// asks until the user types a number (returns 0 at the end of the input)
int askInt(char* prompt) {
    for (;;) {
        char* s = input(prompt);
        if (s == null) {
            return 0;
        }
        int v;
        if (parseInt(s, &v)) {
            return v;
        }
        println("Please enter a whole number.");
    }
}

// asks a yes / no question
bool confirm(char* prompt) {
    char* s = input(prompt);
    if (s == null) {
        return false;
    }
    return s[0] == 'y' || s[0] == 'Y';
}

int atoi(char* s) {
    int i = 0;
    int sign = 1;
    int v = 0;
    if (s[0] == '-') {
        sign = -1;
        i = 1;
    }
    while (s[i] >= '0' && s[i] <= '9') {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    return v * sign;
}

// ---- math helpers -----------------------------------------------------------------------
int abs(int x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

int min(int a, int b) {
    if (a < b) {
        return a;
    }
    return b;
}

int max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

// ---- character classes ------------------------------------------------------------------------
bool isDigit(int c) { return c >= '0' && c <= '9'; }
bool isUpper(int c) { return c >= 'A' && c <= 'Z'; }
bool isLower(int c) { return c >= 'a' && c <= 'z'; }
bool isAlpha(int c) { return isUpper(c) || isLower(c); }
bool isSpace(int c) { return c == ' ' || c == 9 || c == 10 || c == 13; }
int toUpper(int c) { if (isLower(c)) return c - 32; return c; }
int toLower(int c) { if (isUpper(c)) return c + 32; return c; }

// ---- more string helpers --------------------------------------------------------------------------
char* strcpy(char* dst, char* src) {
    int i = 0;
    while (src[i] != 0) {
        dst[i] = src[i];
        i++;
    }
    dst[i] = 0;
    return dst;
}

char* strcat(char* dst, char* src) {
    strcpy(&dst[strlen(dst)], src);
    return dst;
}

// duplicates a string on the heap
char* strdup(char* s) {
    char* p = alloc(strlen(s) + 1);
    strcpy(p, s);
    return p;
}

// index of the first occurrence of c in s, or -1
int indexOf(char* s, int c) {
    for (int i = 0; s[i] != 0; i++) {
        if (s[i] == c) {
            return i;
        }
    }
    return -1;
}

// true if s starts with prefix
bool startsWith(char* s, char* prefix) {
    int i = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i++;
    }
    return true;
}

// writes the decimal form of n into buf (at least 21 bytes), returns buf
char* intToStr(int n, char* buf) {
    char tmp[24];
    int i = 24;
    int pos = 0;
    bool neg = n < 0;
    if (n == 0) {
        buf[0] = '0';
        buf[1] = 0;
        return buf;
    }
    while (n != 0) {
        int d = n % 10;
        if (d < 0) {
            d = -d;
        }
        i--;
        tmp[i] = '0' + d;
        n = n / 10;
    }
    if (neg) {
        buf[pos] = '-';
        pos++;
    }
    while (i < 24) {
        buf[pos] = tmp[i];
        pos++;
        i++;
    }
    buf[pos] = 0;
    return buf;
}

void printHex(int n) {
    char buf[20];
    int i = 20;
    if (n == 0) {
        printChar('0');
        return;
    }
    while (n != 0) {
        int d = n & 15;
        i--;
        if (d < 10) {
            buf[i] = '0' + d;
        } else {
            buf[i] = 'a' + d - 10;
        }
        n = (n >> 4) & 0x0FFFFFFFFFFFFFFF;
    }
    __write(1, &buf[i], 20 - i);
}

// ---- pseudo random numbers (xorshift) -------------------------------------------------------------------
int __rand_state = 88172645463325252;

void srand(int seed) {
    if (seed == 0) {
        seed = 88172645463325252;
    }
    __rand_state = seed;
}

// returns a value in 0 .. 2^31-1
int rand() {
    int x = __rand_state;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    __rand_state = x;
    return (x >> 8) & 0x7FFFFFFF;
}

// ---- files ----------------------------------------------------------------------------------------------------
// fileOpen modes
const FILE_READ = 0;
const FILE_WRITE = 1;       // create or truncate
const FILE_APPEND = 2;

// returns a handle (>= 0) or a negative number on error
int fileOpen(char* path, int mode) {
    return __open(path, mode);
}

void fileClose(int handle) {
    __close(handle);
}

int fileRead(int handle, char* buf, int n) {
    return __read(handle, buf, n);
}

int fileWrite(int handle, char* buf, int n) {
    return __write(handle, buf, n);
}

// reads a whole file into the heap as a NUL terminated string, null if it cannot be opened
char* readFile(char* path) {
    int h = __open(path, 0);
    if (h < 0) {
        return null;
    }
    char* start = &__heap[__heap_pos];
    int len = 0;
    int room = 64 * 1024 * 1024 - __heap_pos - 16;
    for (;;) {
        int n = __read(h, &start[len], room - len);
        if (n <= 0) {
            break;
        }
        len = len + n;
    }
    __close(h);
    start[len] = 0;
    __heap_pos = (__heap_pos + len + 16) & ~15;
    return start;
}

// writes text to a file (created / truncated). Returns true on success
bool writeFile(char* path, char* text) {
    int h = __open(path, 1);
    if (h < 0) {
        return false;
    }
    int n = strlen(text);
    int done = __write(h, text, n);
    __close(h);
    return done == n;
}

// ---- more strings -----------------------------------------------------------------------------------
bool endsWith(char* s, char* suffix) {
    int n = strlen(s);
    int m = strlen(suffix);
    if (m > n) {
        return false;
    }
    return streq(&s[n - m], suffix);
}

// index of the first occurrence of sub in s, or -1
int find(char* s, char* sub) {
    int n = strlen(s);
    int m = strlen(sub);
    for (int i = 0; i + m <= n; i++) {
        int k = 0;
        while (k < m && s[i + k] == sub[k]) {
            k++;
        }
        if (k == m) {
            return i;
        }
    }
    return -1;
}

bool contains(char* s, char* sub) {
    return find(s, sub) >= 0;
}

// new heap string with len characters of s starting at start
char* substr(char* s, int start, int len) {
    char* p = alloc(len + 1);
    memcpy(p, &s[start], len);
    return p;
}

// removes spaces at both ends in place, returns the (possibly advanced) pointer
char* trim(char* s) {
    while (isSpace(s[0])) {
        s = &s[1];
    }
    int n = strlen(s);
    while (n > 0 && isSpace(s[n - 1])) {
        n--;
        s[n] = 0;
    }
    return s;
}

void strUpper(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        s[i] = toUpper(s[i]);
    }
}

void strLower(char* s) {
    for (int i = 0; s[i] != 0; i++) {
        s[i] = toLower(s[i]);
    }
}

// equal ignoring upper / lower case
bool streqi(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && toLower(a[i]) == toLower(b[i])) {
        i++;
    }
    return a[i] == b[i];
}

void hexToStr(int n, char* buf) {
    char tmp[20];
    int i = 20;
    int pos = 0;
    if (n == 0) {
        buf[0] = '0';
        buf[1] = 0;
        return;
    }
    while (n != 0) {
        int d = n & 15;
        i--;
        if (d < 10) {
            tmp[i] = '0' + d;
        } else {
            tmp[i] = 'a' + d - 10;
        }
        n = (n >> 4) & 0x0FFFFFFFFFFFFFFF;
    }
    while (i < 20) {
        buf[pos] = tmp[i];
        pos++;
        i++;
    }
    buf[pos] = 0;
}

// ---- formatted output -------------------------------------------------------------------------------------
// vformat(out, max, fmt, args, nargs): printf style formatting of an array of values into a buffer.
// Returns the length the complete text has (like C's snprintf); at most max-1 characters are stored
// and the text is always NUL terminated.
//   flags       -  left-align   0  zero padding   +  always a sign   space  space for positive   #  0x / 0 / 0b prefix, decimal point
//   width       digits or *     precision  .digits or .*  (minimum digits for integers, digits after the point for %f %e,
//                               significant digits for %g, maximum length for %s)
//   length      h hh l ll z j t q L are accepted; h and hh narrow the integer, everything else is 64 bits
//   conversions d i  signed decimal     u  unsigned decimal     x X  hex     o  octal     b  binary
//               c  character    s  string    p  pointer    %  percent sign
//               e E f F g G  a double (its 64 bits are the value in args), printed correctly rounded (exactly: the digits of
//                            the binary value are computed with big numbers, halves go to even), also denormals, -0.0, inf, nan
//               v  a double as the shortest text that reads back as the same number (1e+22  0.1  1.5e-07), no forced .0
// Every value is one 64-bit slot of args (text and pointers are passed as their address, a double as its bits: a double
// that is passed through the ... of printf / format arrives as its bits).
void __fmt_put(char* out, int max, int pos, int ch) {
    if (pos < max - 1) {
        out[pos] = ch;
    }
}

// n copies of ch at out[pos...] (n >= 0): only the part that fits is stored, the rest is just counted, so a huge width costs
// nothing when the buffer is full. Returns pos + n.
int __fmt_fill(char* out, int max, int pos, int ch, int n) {
    int room = max - 1 - pos;
    if (room > n) {
        room = n;
    }
    for (int i = 0; i < room; i++) {
        out[pos + i] = ch;
    }
    return pos + n;
}

// A width or a precision is at most this (a larger one, written in the format or given through *, is cut to it)
const __FMT_LIMIT = 100000000;

// the 64 bits of the double that is closest to the unsigned 64-bit number n (ties to even), with integer arithmetic only: the
// integer of  $"{n:.2f}"  and of a uint64 converted to double. __i2f is the same for a signed integer.
int __u2f(int n) {
    if (n == 0) {
        return 0;
    }
    int e = 63;
    while (((n >> e) & 1) == 0) {
        e--;
    }
    int m;
    if (e <= 52) {
        m = n << (52 - e);
    } else {
        int sh = e - 52;
        uint64 u = n;
        m = u >> sh;
        int low = n & ((1 << sh) - 1);
        int half = 1 << (sh - 1);
        if (low > half || (low == half && (m & 1) != 0)) {
            m++;
            if (m == (1 << 53)) {
                m = m >> 1;
                e++;
            }
        }
    }
    return ((e + 1023) << 52) | (m & 0xFFFFFFFFFFFFF);
}

int __i2f(int n) {
    if (n < 0) {
        return (1 << 63) | __u2f(-n);
    }
    return __u2f(n);
}

// digits of v (taken as an unsigned 64-bit number) written backwards so that the last digit is buf[end-1];
// returns the index of the first digit
int __fmt_digits(char* buf, int end, int v, int base, bool upper) {
    int i = end;
    if (v == 0) {
        i--;
        buf[i] = '0';
        return i;
    }
    while (v != 0) {
        int q;
        int r;
        if (v > 0) {
            q = v / base;
            r = v - q * base;
        } else {
            q = (((v >> 1) & 0x7FFFFFFFFFFFFFFF) / base) << 1;
            r = v - q * base;
            if (r >= base) {
                q++;
                r = r - base;
            }
        }
        i--;
        if (r < 10) {
            buf[i] = '0' + r;
        } else if (upper) {
            buf[i] = 'A' + r - 10;
        } else {
            buf[i] = 'a' + r - 10;
        }
        v = q;
    }
    return i;
}

// ---- doubles: exact decimal digits ---------------------------------------------------------------------------------
// A big number is an array of base 10^9 limbs, least significant first; a[0] is the number of limbs.

// a = a * x   (0 < x < 2^31)
void __fmt_bmul(int* a, int x) {
    int carry = 0;
    int n = a[0];
    for (int i = 1; i <= n; i++) {
        int v = a[i] * x + carry;
        carry = v / 1000000000;
        a[i] = v - carry * 1000000000;
    }
    while (carry != 0) {
        n++;
        a[n] = carry % 1000000000;
        carry = carry / 1000000000;
    }
    a[0] = n;
}

// The exact decimal digits of m * 2^k (0 < m < 2^60, -1100 < k < 1030) into digs (800 bytes, no leading zeros, the last
// digits may be zeros); returns their number. *pp = the number of digits before the decimal point (zero or negative when
// zeros follow the point before the first digit), so the value is 0.d1d2d3... * 10^pp.
int __fmt_exact(char* digs, int m, int k, int* pp) {
    int a[100];
    a[1] = m % 1000000000;
    int hi = m / 1000000000;
    a[2] = hi % 1000000000;
    a[3] = hi / 1000000000;
    a[0] = 3;
    while (a[0] > 1 && a[a[0]] == 0) {
        a[0] = a[0] - 1;
    }
    if (k >= 0) {
        int n = k;
        while (n >= 29) {
            __fmt_bmul(&a[0], 536870912);
            n = n - 29;
        }
        if (n > 0) {
            __fmt_bmul(&a[0], 1 << n);
        }
    } else {
        // m * 2^k = m * 5^-k / 10^-k
        int n = -k;
        while (n >= 13) {
            __fmt_bmul(&a[0], 1220703125);
            n = n - 13;
        }
        if (n > 0) {
            int p = 1;
            for (int i = 0; i < n; i++) {
                p = p * 5;
            }
            __fmt_bmul(&a[0], p);
        }
    }
    int len = 0;
    for (int i = a[0]; i >= 1; i--) {
        int v = a[i];
        for (int j = 8; j >= 0; j--) {
            digs[len + j] = '0' + v % 10;
            v = v / 10;
        }
        len = len + 9;
    }
    int lz = 0;
    while (lz < len - 1 && digs[lz] == '0') {
        lz++;
    }
    if (lz > 0) {
        for (int i = 0; i + lz < len; i++) {
            digs[i] = digs[i + lz];
        }
        len = len - lz;
    }
    if (k >= 0) {
        *pp = len;
    } else {
        *pp = len + k;
    }
    return len;
}

// does rounding d[0..nd) to keep digits (0 <= keep < nd) go up?  Nearest, an exact half goes to the even neighbour.
bool __fmt_roundup(char* d, int nd, int keep) {
    int c = d[keep] - '0';
    if (c > 5) {
        return true;
    }
    if (c < 5) {
        return false;
    }
    for (int i = keep + 1; i < nd; i++) {
        if (d[i] != '0') {
            return true;
        }
    }
    int prev = 0;
    if (keep > 0) {
        prev = d[keep - 1] - '0';
    }
    return (prev & 1) == 1;
}

// adds one unit in the last place of d[0..keep): returns 1 when it carries out of the first digit (all digits become 0)
int __fmt_incr(char* d, int keep) {
    int i = keep - 1;
    while (i >= 0) {
        if (d[i] == '9') {
            d[i] = '0';
            i--;
        } else {
            d[i] = d[i] + 1;
            return 0;
        }
    }
    return 1;
}

// Rounds d[0..nd) (value 0.d1d2... * 10^*pp) to keep digits. Returns the number of digits that matter afterwards: the digits at
// d[n] and beyond are zeros. keep < 0 gives 0 (the value rounds to zero); a carry out of the first digit makes it 1 followed by zeros
// and raises *pp.
int __fmt_roundto(char* d, int nd, int* pp, int keep) {
    if (keep < 0) {
        return 0;
    }
    if (keep >= nd) {
        return nd;
    }
    if (__fmt_roundup(d, nd, keep)) {
        if (__fmt_incr(d, keep) != 0) {
            d[0] = '1';
            *pp = *pp + 1;
            if (keep == 0) {
                return 1;
            }
        }
    }
    return keep;
}

// 1 when the decimal  c (cn digits, point position cp)  is greater than b, 0 when equal, -1 when smaller (both are positive,
// the first digit is not 0)
int __fmt_cmp(char* c, int cn, int cp, char* b, int bn, int bp) {
    if (cp != bp) {
        if (cp > bp) {
            return 1;
        }
        return -1;
    }
    int n = cn;
    if (bn > n) {
        n = bn;
    }
    for (int i = 0; i < n; i++) {
        int x = '0';
        int y = '0';
        if (i < cn) {
            x = c[i];
        }
        if (i < bn) {
            y = b[i];
        }
        if (x != y) {
            if (x > y) {
                return 1;
            }
            return -1;
        }
    }
    return 0;
}

// is the p digit decimal c (point position cp) inside the interval between the neighbours of the double (dl / du: the
// midpoints to the next smaller / larger double; the ends belong to it when the mantissa is even)?
bool __fmt_inside(char* c, int p, int cp, char* dl, int nl, int pl, char* du, int nu, int pu, bool incl) {
    int lo = __fmt_cmp(c, p, cp, dl, nl, pl);
    int hi = __fmt_cmp(c, p, cp, du, nu, pu);
    if (incl) {
        return lo >= 0 && hi <= 0;
    }
    return lo > 0 && hi < 0;
}

// The shortest digits that read back as the same double (m * 2^k; tight: the next smaller double is closer, because m is a power of 2).
// The digits go to d (at least 20 bytes), the count is returned, *pp = the point position. Where several shortest texts exist the
// one nearest to the value is taken.
int __fmt_shortest(char* d, int m, int k, bool tight, int* pp) {
    char dv[800];
    char dl[800];
    char du[800];
    int pv = 0;
    int pl = 0;
    int pu = 0;
    int nv = __fmt_exact(&dv[0], m, k, &pv);
    int nu = __fmt_exact(&du[0], 2 * m + 1, k - 1, &pu);
    int nl;
    if (tight) {
        nl = __fmt_exact(&dl[0], 4 * m - 1, k - 2, &pl);
    } else {
        nl = __fmt_exact(&dl[0], 2 * m - 1, k - 1, &pl);
    }
    bool incl = (m & 1) == 0;
    char down[24];
    char up[24];
    int p = 1;
    while (p <= 17) {
        for (int i = 0; i < p; i++) {
            if (i < nv) {
                down[i] = dv[i];
            } else {
                down[i] = '0';
            }
            up[i] = down[i];
        }
        int pup = pv;
        if (__fmt_incr(&up[0], p) != 0) {
            up[0] = '1';
            pup = pv + 1;
        }
        bool nearUp = false;
        if (p < nv) {
            nearUp = __fmt_roundup(&dv[0], nv, p);
        }
        for (int pass = 0; pass < 2; pass++) {
            bool useUp = nearUp;
            if (pass == 1) {
                useUp = !nearUp;
            }
            char* c = &down[0];
            int cp = pv;
            if (useUp) {
                c = &up[0];
                cp = pup;
            }
            if (__fmt_inside(c, p, cp, &dl[0], nl, pl, &du[0], nu, pu, incl)) {
                int n = p;
                while (n > 1 && c[n - 1] == '0') {
                    n--;
                }
                for (int i = 0; i < n; i++) {
                    d[i] = c[i];
                }
                *pp = cp;
                return n;
            }
        }
        p++;
    }
    for (int i = 0; i < 17; i++) {
        d[i] = down[i];
    }
    *pp = pv;
    return 17;
}

// ---- doubles: the text of the number --------------------------------------------------------------------------------
// d[0..nr) are the digits (d[n] for n >= nr are zeros), the value is 0.d1d2... * 10^pp. Each function writes the unsigned text into b
// and returns its length.

// %f: the integer part, then p digits after the point (the point itself only when p > 0 or alt)
int __fmt_emit_f(char* b, char* d, int nr, int pp, int p, bool alt) {
    int n = 0;
    if (pp <= 0) {
        b[n] = '0';
        n++;
    } else {
        for (int i = 0; i < pp; i++) {
            if (i < nr) {
                b[n] = d[i];
            } else {
                b[n] = '0';
            }
            n++;
        }
    }
    if (p > 0 || alt) {
        b[n] = '.';
        n++;
    }
    for (int j = 0; j < p; j++) {
        int idx = pp + j;
        if (idx >= 0 && idx < nr) {
            b[n] = d[idx];
        } else {
            b[n] = '0';
        }
        n++;
    }
    return n;
}

// the exponent part  e+05  e-123  of x
int __fmt_emit_x(char* b, int n, int x, bool upper) {
    if (upper) {
        b[n] = 'E';
    } else {
        b[n] = 'e';
    }
    n++;
    if (x < 0) {
        b[n] = '-';
        x = -x;
    } else {
        b[n] = '+';
    }
    n++;
    if (x >= 100) {
        b[n] = '0' + x / 100;
        n++;
        x = x % 100;
    }
    b[n] = '0' + x / 10;
    b[n + 1] = '0' + x % 10;
    return n + 2;
}

// %e: one digit, the point, p more digits, the exponent
int __fmt_emit_e(char* b, char* d, int nr, int pp, int p, bool alt, bool upper) {
    int n = 0;
    if (nr > 0) {
        b[n] = d[0];
    } else {
        b[n] = '0';
    }
    n++;
    if (p > 0 || alt) {
        b[n] = '.';
        n++;
    }
    for (int j = 1; j <= p; j++) {
        if (j < nr) {
            b[n] = d[j];
        } else {
            b[n] = '0';
        }
        n++;
    }
    int x = pp - 1;
    if (nr == 0) {
        x = 0;
    }
    return __fmt_emit_x(b, n, x, upper);
}

// removes the zeros at the end of the fraction of  123.4500  (and the point); in an exponent form the zeros in front of the e
int __fmt_strip(char* b, int n) {
    int e = n;
    for (int i = 0; i < n; i++) {
        if (b[i] == 'e' || b[i] == 'E') {
            e = i;
            break;
        }
    }
    int pt = -1;
    for (int i = 0; i < e; i++) {
        if (b[i] == '.') {
            pt = i;
            break;
        }
    }
    if (pt < 0) {
        return n;
    }
    int z = e;
    while (z > pt + 1 && b[z - 1] == '0') {
        z--;
    }
    if (z == pt + 1) {
        z = pt;
    }
    int t = n - e;
    for (int i = 0; i < t; i++) {
        b[z + i] = b[e + i];
    }
    return z + t;
}

// %v: the shortest digits
int __fmt_emit_v(char* b, char* d, int nr, int pp) {
    int n = 0;
    int x = pp - 1;
    if (x < -4 || x >= 16) {
        b[n] = d[0];
        n++;
        if (nr > 1) {
            b[n] = '.';
            n++;
            for (int i = 1; i < nr; i++) {
                b[n] = d[i];
                n++;
            }
        }
        return __fmt_emit_x(b, n, x, false);
    }
    if (pp <= 0) {
        b[n] = '0';
        b[n + 1] = '.';
        n = n + 2;
        for (int i = 0; i < -pp; i++) {
            b[n] = '0';
            n++;
        }
        for (int i = 0; i < nr; i++) {
            b[n] = d[i];
            n++;
        }
        return n;
    }
    for (int i = 0; i < pp; i++) {
        if (i < nr) {
            b[n] = d[i];
        } else {
            b[n] = '0';
        }
        n++;
    }
    if (nr > pp) {
        b[n] = '.';
        n++;
        for (int i = pp; i < nr; i++) {
            b[n] = d[i];
            n++;
        }
    }
    return n;
}

// One floating point conversion: the number bits (a double's 64 bits) with the conversion e E f F g G v, the precision prec (-1: not
// given), the width and flags. Writes the whole field at out[o...] (see __fmt_put) and returns the new position.
int __fmt_float_field(char* out, int max, int o, int bits, int conv, int prec, int width, bool left, bool zero, bool plus, bool space, bool alt) {
    char body[2300];
    char digs[800];
    int bl = 0;
    bool neg = bits < 0;
    int ex = (bits >> 52) & 0x7FF;
    int frac = bits & 0xFFFFFFFFFFFFF;
    bool upper = conv == 'E' || conv == 'F' || conv == 'G';
    bool special = false;
    if (ex == 0x7FF) {
        special = true;
        char* txt = "inf";
        if (frac != 0) {
            txt = "nan";
            neg = false;
        }
        if (upper) {
            if (frac != 0) { txt = "NAN"; } else { txt = "INF"; }
        }
        for (int i = 0; i < 3; i++) {
            body[i] = txt[i];
        }
        bl = 3;
    } else {
        int c = conv | 32;
        if (prec > 1800) {
            prec = 1800;
        }
        int m = frac;
        int k = -1074;
        if (ex != 0) {
            m = frac | 0x10000000000000;
            k = ex - 1075;
        }
        int nd = 0;
        int pp = 1;
        if (m != 0) {
            nd = __fmt_exact(&digs[0], m, k, &pp);
        }
        if (c == 'v') {
            char sd[24];
            if (m == 0) {
                sd[0] = '0';
                body[0] = '0';
                bl = 1;
            } else {
                int sp = 0;
                int sn = __fmt_shortest(&sd[0], m, k, frac == 0 && ex > 1, &sp);
                bl = __fmt_emit_v(&body[0], &sd[0], sn, sp);
            }
        } else if (c == 'f') {
            int p = prec;
            if (p < 0) { p = 6; }
            int nr = __fmt_roundto(&digs[0], nd, &pp, pp + p);
            bl = __fmt_emit_f(&body[0], &digs[0], nr, pp, p, alt);
        } else if (c == 'e') {
            int p = prec;
            if (p < 0) { p = 6; }
            int nr = __fmt_roundto(&digs[0], nd, &pp, p + 1);
            bl = __fmt_emit_e(&body[0], &digs[0], nr, pp, p, alt, upper);
        } else {
            int p = prec;
            if (p < 0) { p = 6; }
            if (p == 0) { p = 1; }
            int nr = __fmt_roundto(&digs[0], nd, &pp, p);
            int x = pp - 1;
            if (nr == 0) {
                x = 0;
            }
            if (x < -4 || x >= p) {
                bl = __fmt_emit_e(&body[0], &digs[0], nr, pp, p - 1, alt, upper);
            } else {
                bl = __fmt_emit_f(&body[0], &digs[0], nr, pp, p - 1 - x, alt);
            }
            if (!alt) {
                bl = __fmt_strip(&body[0], bl);
            }
        }
    }
    int sgn = 0;
    if (neg) {
        sgn = '-';
    } else if (plus) {
        sgn = '+';
    } else if (space) {
        sgn = ' ';
    }
    int len = bl;
    if (sgn != 0) {
        len++;
    }
    int pad = width - len;
    if (pad < 0) {
        pad = 0;
    }
    bool zpad = zero && !left && !special;
    if (!left && !zpad) {
        o = __fmt_fill(out, max, o, ' ', pad);
        pad = 0;
    }
    if (sgn != 0) {
        __fmt_put(out, max, o, sgn);
        o++;
    }
    if (zpad) {
        o = __fmt_fill(out, max, o, '0', pad);
        pad = 0;
    }
    for (int i = 0; i < bl; i++) {
        __fmt_put(out, max, o, body[i]);
        o++;
    }
    o = __fmt_fill(out, max, o, ' ', pad);
    return o;
}

int vformat(char* out, int max, char* fmt, int* args, int nargs) {
    int ai = 0;
    int o = 0;
    int i = 0;
    char dig[72];
    while (fmt[i] != 0) {
        if (fmt[i] != '%') {
            __fmt_put(out, max, o, fmt[i]);
            o++;
            i++;
            continue;
        }
        int start = i;
        i++;
        bool left = false;
        bool zero = false;
        bool plus = false;
        bool space = false;
        bool alt = false;
        bool again = true;
        while (again) {
            char f = fmt[i];
            if (f == '-') { left = true; }
            else if (f == '0') { zero = true; }
            else if (f == '+') { plus = true; }
            else if (f == ' ') { space = true; }
            else if (f == '#') { alt = true; }
            else { again = false; }
            if (again) { i++; }
        }
        int width = 0;
        if (fmt[i] == '*') {
            if (ai < nargs) { width = args[ai]; }
            ai++;
            i++;
            if (width < 0) {
                left = true;
                if (width < -__FMT_LIMIT) {         // (also the smallest int, which -width cannot make positive)
                    width = __FMT_LIMIT;
                } else {
                    width = -width;
                }
            }
        } else {
            while (isDigit(fmt[i])) {
                if (width < __FMT_LIMIT) { width = width * 10 + (fmt[i] - '0'); }
                i++;
            }
        }
        if (width > __FMT_LIMIT) {
            width = __FMT_LIMIT;
        }
        int prec = -1;
        if (fmt[i] == '.') {
            i++;
            prec = 0;
            if (fmt[i] == '*') {
                if (ai < nargs) { prec = args[ai]; }
                ai++;
                i++;
                if (prec < 0) { prec = -1; }        // a negative precision is the same as none
            } else {
                while (isDigit(fmt[i])) {
                    if (prec < __FMT_LIMIT) { prec = prec * 10 + (fmt[i] - '0'); }
                    i++;
                }
            }
        }
        if (prec > __FMT_LIMIT) {
            prec = __FMT_LIMIT;
        }
        int narrow = 0;
        again = true;
        while (again) {
            char m = fmt[i];
            if (m == 'h') { narrow = narrow + 1; }
            else if (m == 'l' || m == 'L' || m == 'z' || m == 'j' || m == 't' || m == 'q') { narrow = 0; }
            else { again = false; }
            if (again) { i++; }
        }
        char t = fmt[i];
        if (t == 0) {
            // incomplete specification at the end: print it as it is
            for (int k = start; k < i; k++) {
                __fmt_put(out, max, o, fmt[k]);
                o++;
            }
            break;
        }
        i++;
        if (t == '%') {
            __fmt_put(out, max, o, '%');
            o++;
            continue;
        }
        if (t == 'e' || t == 'E' || t == 'f' || t == 'F' || t == 'g' || t == 'G' || t == 'v') {
            int bits = 0;
            if (ai < nargs) { bits = args[ai]; }
            ai++;
            o = __fmt_float_field(out, max, o, bits, t, prec, width, left, zero, plus, space, alt);
            continue;
        }
        int v = 0;
        if (t == 'd' || t == 'i' || t == 'u' || t == 'x' || t == 'X' || t == 'o' || t == 'b' || t == 'c' || t == 's' || t == 'p') {
            if (ai < nargs) { v = args[ai]; }
            ai++;
        }
        // ---- pieces of the field: sign/prefix, zeros, body ----
        char sgn[4];
        int nsgn = 0;
        int nzero = 0;
        char* body = &dig[0];
        int blen = 0;
        bool numeric = false;
        bool octfix = false;
        if (t == 'd' || t == 'i') {
            numeric = true;
            if (narrow >= 2) { v = (v << 56) >> 56; }
            else if (narrow == 1) { v = (v << 48) >> 48; }
            bool neg = v < 0;
            if (neg) { v = -v; }
            if (neg) { sgn[nsgn] = '-'; nsgn++; }
            else if (plus) { sgn[nsgn] = '+'; nsgn++; }
            else if (space) { sgn[nsgn] = ' '; nsgn++; }
            int st = __fmt_digits(&dig[0], 72, v, 10, false);
            body = &dig[st];
            blen = 72 - st;
            if (prec == 0 && v == 0) { blen = 0; }
        } else if (t == 'u' || t == 'x' || t == 'X' || t == 'o' || t == 'b' || t == 'p') {
            numeric = true;
            if (narrow >= 2) { v = v & 0xFF; }
            else if (narrow == 1) { v = v & 0xFFFF; }
            int base = 10;
            if (t == 'x' || t == 'X' || t == 'p') { base = 16; }
            else if (t == 'o') { base = 8; }
            else if (t == 'b') { base = 2; }
            if (t == 'p') {
                alt = true;
                if (v == 0) {
                    numeric = false;
                    body = "(nil)";
                    blen = 5;
                }
            }
            if (numeric) {
                int st = __fmt_digits(&dig[0], 72, v, base, t == 'X');
                body = &dig[st];
                blen = 72 - st;
                if (prec == 0 && v == 0) { blen = 0; }
                if (alt && v != 0 && base == 16) {
                    sgn[nsgn] = '0'; nsgn++;
                    if (t == 'X') { sgn[nsgn] = 'X'; } else { sgn[nsgn] = 'x'; }
                    nsgn++;
                } else if (alt && v != 0 && base == 2) {
                    sgn[nsgn] = '0'; nsgn++;
                    sgn[nsgn] = 'b'; nsgn++;
                } else if (alt && base == 8 && (blen == 0 || body[0] != '0')) {
                    octfix = true;
                }
            }
        } else if (t == 'c') {
            dig[0] = v;
            body = &dig[0];
            blen = 1;
        } else if (t == 's') {
            body = (char*) v;
            if (v == 0) {
                body = "(null)";
            }
            blen = 0;
            while (body[blen] != 0 && (prec < 0 || blen < prec)) {
                blen++;
            }
        } else {
            // unknown conversion: print the specification unchanged
            for (int k = start; k < i; k++) {
                __fmt_put(out, max, o, fmt[k]);
                o++;
            }
            continue;
        }
        if (numeric && prec > blen) {
            nzero = prec - blen;
        }
        if (octfix && nzero == 0) {
            nzero = 1;
        }
        int len = nsgn + nzero + blen;
        int pad = width - len;
        if (pad < 0) { pad = 0; }
        if (!left && !(zero && numeric && prec < 0)) {
            o = __fmt_fill(out, max, o, ' ', pad);
            pad = 0;
        }
        for (int k = 0; k < nsgn; k++) {
            __fmt_put(out, max, o, sgn[k]);
            o++;
        }
        if (!left && zero && numeric && prec < 0) {
            o = __fmt_fill(out, max, o, '0', pad);
            pad = 0;
        }
        o = __fmt_fill(out, max, o, '0', nzero);
        for (int k = 0; k < blen; k++) {
            __fmt_put(out, max, o, body[k]);
            o++;
        }
        o = __fmt_fill(out, max, o, ' ', pad);
    }
    if (max > 0) {
        if (o < max - 1) {
            out[o] = 0;
        } else {
            out[max - 1] = 0;
        }
    }
    return o;
}

// The values of a call with more than 32 of them are collected in one buffer that is kept and only grows (it is not allocated
// again for every call, so a loop of such calls does not use more and more memory). While it is in use another call
// (a signal handler, a thread) gets a buffer of its own from alloc, which is not freed.
int* __fmt_argbuf;
int __fmt_argcap;
bool __fmt_argbusy;

int* __fmt_args_take(int n) {
    if (__fmt_argbusy) {
        return (int*) alloc(n * 8);
    }
    if (n > __fmt_argcap) {
        int c = __fmt_argcap * 2;
        if (c < n) {
            c = n;
        }
        __fmt_argbuf = (int*) alloc(c * 8);
        __fmt_argcap = c;
    }
    __fmt_argbusy = true;
    return __fmt_argbuf;
}

void __fmt_args_release(int* a) {
    if (a == __fmt_argbuf) {
        __fmt_argbusy = false;
    }
}

// format(out, max, fmt, ...): vformat with any number of values (more than 32 are collected in the heap);
// returns the number of characters stored.
int format(char* out, int max, char* fmt, ...) {
    int n = va_count();
    int small[32];
    int* args = &small[0];
    if (n > 32) {
        args = __fmt_args_take(n);
    }
    for (int i = 0; i < n; i++) {
        args[i] = va_arg(i);
    }
    int r = vformat(out, max, fmt, args, n);
    if (n > 32) {
        __fmt_args_release(args);
    }
    if (r > max - 1) {
        r = max - 1;
    }
    return r;
}

// printf("%s is %d years old\n", name, age)   - any number of values, text is passed as it is, a double as it is
void printf(char* fmt, ...) {
    int n = va_count();
    int small[32];
    int* args = &small[0];
    if (n > 32) {
        args = __fmt_args_take(n);
    }
    for (int i = 0; i < n; i++) {
        args[i] = va_arg(i);
    }
    char buf[1024];
    int len = vformat(&buf[0], 1024, fmt, args, n);
    if (len < 1024) {
        if (n > 32) {
            __fmt_args_release(args);
        }
        __write(1, &buf[0], len);
        return;
    }
    char* big = alloc(len + 1);
    vformat(big, len + 1, fmt, args, n);
    if (n > 32) {
        __fmt_args_release(args);
    }
    __write(1, big, len);
}

// the text true / false (used by interpolated strings)
char* __boolstr(int b) {
    if (b != 0) {
        return "true";
    }
    return "false";
}

// $"..." is lowered to this: the same formatter as format and printf, the result is a new text from alloc (it lives until the program ends)
char* __interp(char* fmt, ...) {
    int n = va_count();
    int small[32];
    int* args = &small[0];
    if (n > 32) {
        args = __fmt_args_take(n);
    }
    for (int i = 0; i < n; i++) {
        args[i] = va_arg(i);
    }
    int len = vformat(null, 0, fmt, args, n);
    char* s = alloc(len + 1);
    vformat(s, len + 1, fmt, args, n);
    if (n > 32) {
        __fmt_args_release(args);
    }
    return s;
}

// writes ch n times
void printRepeat(char ch, int n) {
    for (int i = 0; i < n; i++) {
        printChar(ch);
    }
}

// ---- terminal: colours and cursor ----------------------------------------------------------------------------
const ANSI_RESET = "\e[0m";
const ANSI_BOLD = "\e[1m";
const ANSI_RED = "\e[31m";
const ANSI_GREEN = "\e[32m";
const ANSI_YELLOW = "\e[33m";
const ANSI_BLUE = "\e[34m";
const ANSI_MAGENTA = "\e[35m";
const ANSI_CYAN = "\e[36m";
const ANSI_GRAY = "\e[90m";

bool __ansi_ready;

// call once before using colours: turns on ANSI escape handling in the Windows console
void ansiInit() {
    if (__OS == 1 && !__ansi_ready) {
        int h = __winapi(0, -11, 0, 0, 0);           // GetStdHandle(STD_OUTPUT_HANDLE)
        __winapi(7, h, 7, 0, 0);                      // SetConsoleMode(PROCESSED | WRAP | VT)
    }
    __ansi_ready = true;
}

// true if the file descriptor (0 input, 1 output, 2 error) is a terminal, not a file or pipe
bool isTerminal(int fd) {
    if (__OS == 1) {
        int h = __winapi(0, -10 - fd, 0, 0, 0);       // GetStdHandle
        return ((__winapi(10, h, 0, 0, 0) << 32) >> 32) == 2;   // GetFileType == FILE_TYPE_CHAR
    }
    char termios[64];
    int nr = 16;
    if (__ARCH >= 1) {
        nr = 29;
    }
    return __syscall(nr, fd, 0x5401, &termios[0], 0, 0, 0) == 0;
}

// prints text in a colour (one of the ANSI_ constants) when standard output is a terminal
void printColor(char* color, char* text) {
    if (isTerminal(1)) {
        ansiInit();
        print(color);
        print(text);
        print(ANSI_RESET);
    } else {
        print(text);
    }
}

void clearScreen() {
    ansiInit();
    print("\e[2J\e[H");
}

// moves the cursor (rows and columns start at 1)
void cursorTo(int row, int col) {
    ansiInit();
    printf("\e[%d;%dH", row, col, 0, 0);
}

// ---- command line arguments ------------------------------------------------------------------------------------
// index of the argument equal to flag (searching from 1), or -1
int argIndex(int argc, char** argv, char* flag) {
    for (int i = 1; i < argc; i++) {
        if (streq(argv[i], flag)) {
            return i;
        }
    }
    return -1;
}

bool hasArg(int argc, char** argv, char* flag) {
    return argIndex(argc, argv, flag) >= 0;
}

// the argument that follows flag ("-o file" -> "file"), or fallback
char* argValue(int argc, char** argv, char* flag, char* fallback) {
    int i = argIndex(argc, argv, flag);
    if (i < 0 || i + 1 >= argc) {
        return fallback;
    }
    return argv[i + 1];
}

// ---- time ---------------------------------------------------------------------------------------------------------
// milliseconds since an arbitrary start (use differences)
int millis() {
    if (__OS == 1) {
        return __winapi(9, 0, 0, 0, 0);               // GetTickCount64
    }
    int ts[2];
    int nr = 228;
    if (__ARCH >= 1) {
        nr = 113;
    }
    __syscall(nr, 1, &ts[0], 0, 0, 0, 0);             // clock_gettime(CLOCK_MONOTONIC)
    return ts[0] * 1000 + ts[1] / 1000000;
}

void sleepMs(int ms) {
    if (__OS == 1) {
        __winapi(8, ms, 0, 0, 0);                     // Sleep
        return;
    }
    int ts[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int nr = 35;
    if (__ARCH >= 1) {
        nr = 101;
    }
    __syscall(nr, &ts[0], 0, 0, 0, 0, 0);             // nanosleep
}

// ---- environment and file system ------------------------------------------------------------------------
// value of an environment variable as a heap string, null if it is not set.
// Pass main's argc and argv (on Linux / Android the environment follows argv in memory).
char* getEnv(int argc, char** argv, char* name) {
    if (__OS == 1) {
        char tmp[2048];
        int n = __winapi(12, name, &tmp[0], 2048, 0);       // GetEnvironmentVariableA
        n = (n << 32) >> 32;
        if (n <= 0 || n >= 2048) {
            return null;
        }
        return strdup(tmp);
    }
    char** env = &argv[argc + 1];
    int len = strlen(name);
    for (int i = 0; env[i] != null; i++) {
        char* e = env[i];
        int k = 0;
        while (k < len && e[k] == name[k]) {
            k++;
        }
        if (k == len && e[len] == '=') {
            return strdup(&e[len + 1]);
        }
    }
    return null;
}

bool fileExists(char* path) {
    int h = __open(path, 0);
    if (h < 0) {
        return false;
    }
    __close(h);
    return true;
}

// deletes a file, true on success
bool fileDelete(char* path) {
    if (__OS == 1) {
        return ((__winapi(13, path, 0, 0, 0) << 32) >> 32) != 0;     // DeleteFileA
    }
    if (__ARCH >= 1) {
        return __syscall(35, -100, path, 0, 0, 0, 0) == 0;             // unlinkat
    }
    return __syscall(87, path, 0, 0, 0, 0, 0) == 0;                    // unlink
}

// creates a directory, true on success
bool makeDir(char* path) {
    if (__OS == 1) {
        return ((__winapi(14, path, 0, 0, 0) << 32) >> 32) != 0;     // CreateDirectoryA
    }
    if (__ARCH >= 1) {
        return __syscall(34, -100, path, 493, 0, 0, 0) == 0;           // mkdirat, mode 0755
    }
    return __syscall(83, path, 493, 0, 0, 0, 0) == 0;                  // mkdir
}

// ---- memory: a simple bump allocator over a 64 MiB static heap ------------------------------
char __heap[64 * 1024 * 1024];
int __heap_pos;

// Memory beyond the built-in 64 MiB region comes from the operating system (mmap / VirtualAlloc) in big chunks.
char* __heap_extra;
int __heap_extra_left;

char* __alloc_more(int size) {
    if (size < 0 || size > 0x3FFFFFFFFFFF) {
        eprintln("fatal: out of memory");
        exit(1);
    }
    if (size > __heap_extra_left) {
        int chunk = 64 * 1024 * 1024;
        if (size > chunk) {
            chunk = (size + 0xFFFFF) & ~0xFFFFF;
        }
        int p;
        if (__OS == 1) {
            p = __winapi(34, 0, chunk, 0x3000, 4);        // VirtualAlloc(MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)
        } else {
            int nr = 9;
            if (__ARCH >= 1) {
                nr = 222;
            }
            p = __syscall(nr, 0, chunk, 3, 0x22, -1, 0);  // mmap(PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS)
            if (p < 0 && p > -4096) {
                p = 0;
            }
        }
        if (p == 0) {
            eprintln("fatal: out of memory");
            exit(1);
        }
        __heap_extra = (char*) p;
        __heap_extra_left = chunk;
    }
    char* r = __heap_extra;
    __heap_extra = &r[size];
    __heap_extra_left = __heap_extra_left - size;
    return r;
}

// returns zeroed memory; it is never freed (the cstdlib module has malloc / free)
char* alloc(int size) {
    size = (size + 15) & ~15;
    if (size < 0 || __heap_pos + size > 64 * 1024 * 1024) {
        return __alloc_more(size);
    }
    char* p = &__heap[__heap_pos];
    __heap_pos = __heap_pos + size;
    return p;
}

// ---- Windows command line -> argc / argv ------------------------------------------------------
// (used by the program entry code on Windows; __cmdline() returns null elsewhere)
char** __win_argv;

char** __win_argv_get() {
    return __win_argv;
}

int __win_init_args() {
    char* cmd = __cmdline();
    if (cmd == null) {
        return 0;
    }
    int len = strlen(cmd);
    char* buf = alloc(len + 2);
    char** argv = (char**) alloc(8 * (len / 2 + 2));
    int argc = 0;
    int i = 0;
    int o = 0;
    for (;;) {
        while (cmd[i] == ' ' || cmd[i] == 9) {
            i++;
        }
        if (cmd[i] == 0) {
            break;
        }
        argv[argc] = &buf[o];
        argc++;
        bool inq = false;
        while (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
            int bs = 0;
            while (cmd[i] == 92) {
                bs++;
                i++;
            }
            if (cmd[i] == 34) {
                for (int k = 0; k < bs / 2; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (bs % 2 == 1) {
                    buf[o] = 34;
                    o++;
                } else {
                    inq = !inq;
                }
                i++;
            } else {
                for (int k = 0; k < bs; k++) {
                    buf[o] = 92;
                    o++;
                }
                if (cmd[i] != 0 && (inq || (cmd[i] != ' ' && cmd[i] != 9))) {
                    buf[o] = cmd[i];
                    o++;
                    i++;
                }
            }
        }
        buf[o] = 0;
        o++;
    }
    argv[argc] = null;
    __win_argv = argv;
    return argc;
}
