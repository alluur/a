// =============================================================================
//  hash - checksums and cryptographic hashes                import hash;
//  Every function takes a pointer and a byte count (strings: use strlen(s)).
// =============================================================================
module hash;

// 32 bit FNV-1a
public int fnv1a(char* data, int n) {
    int h = 0x811C9DC5;
    for (int i = 0; i < n; i++) {
        h = ((h ^ data[i]) * 16777619) & 0xFFFFFFFF;
    }
    return h;
}

// 32 bit djb2
public int djb2(char* data, int n) {
    int h = 5381;
    for (int i = 0; i < n; i++) {
        h = (h * 33 + data[i]) & 0xFFFFFFFF;
    }
    return h;
}

// Adler-32 (as used by zlib)
public int adler32(char* data, int n) {
    int a = 1;
    int b = 0;
    for (int i = 0; i < n; i++) {
        a = (a + data[i]) % 65521;
        b = (b + a) % 65521;
    }
    return (b << 16) | a;
}

// CRC-32 (as used by zip, gzip and PNG)
public int crc32(char* data, int n) {
    int crc = 0xFFFFFFFF;
    for (int i = 0; i < n; i++) {
        crc = crc ^ data[i];
        for (int k = 0; k < 8; k++) {
            if (crc & 1) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
        }
    }
    return crc ^ 0xFFFFFFFF;
}

private int rotr(int x, int n) {
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;
}

// SHA-256 as 64 lowercase hex characters (a new heap string)
public char* sha256(char* data, int n) {
    int h[8];
    int k[64];
    int w[64];
    k[0] = 0x428a2f98;
    k[1] = 0x71374491;
    k[2] = 0xb5c0fbcf;
    k[3] = 0xe9b5dba5;
    k[4] = 0x3956c25b;
    k[5] = 0x59f111f1;
    k[6] = 0x923f82a4;
    k[7] = 0xab1c5ed5;
    k[8] = 0xd807aa98;
    k[9] = 0x12835b01;
    k[10] = 0x243185be;
    k[11] = 0x550c7dc3;
    k[12] = 0x72be5d74;
    k[13] = 0x80deb1fe;
    k[14] = 0x9bdc06a7;
    k[15] = 0xc19bf174;
    k[16] = 0xe49b69c1;
    k[17] = 0xefbe4786;
    k[18] = 0x0fc19dc6;
    k[19] = 0x240ca1cc;
    k[20] = 0x2de92c6f;
    k[21] = 0x4a7484aa;
    k[22] = 0x5cb0a9dc;
    k[23] = 0x76f988da;
    k[24] = 0x983e5152;
    k[25] = 0xa831c66d;
    k[26] = 0xb00327c8;
    k[27] = 0xbf597fc7;
    k[28] = 0xc6e00bf3;
    k[29] = 0xd5a79147;
    k[30] = 0x06ca6351;
    k[31] = 0x14292967;
    k[32] = 0x27b70a85;
    k[33] = 0x2e1b2138;
    k[34] = 0x4d2c6dfc;
    k[35] = 0x53380d13;
    k[36] = 0x650a7354;
    k[37] = 0x766a0abb;
    k[38] = 0x81c2c92e;
    k[39] = 0x92722c85;
    k[40] = 0xa2bfe8a1;
    k[41] = 0xa81a664b;
    k[42] = 0xc24b8b70;
    k[43] = 0xc76c51a3;
    k[44] = 0xd192e819;
    k[45] = 0xd6990624;
    k[46] = 0xf40e3585;
    k[47] = 0x106aa070;
    k[48] = 0x19a4c116;
    k[49] = 0x1e376c08;
    k[50] = 0x2748774c;
    k[51] = 0x34b0bcb5;
    k[52] = 0x391c0cb3;
    k[53] = 0x4ed8aa4a;
    k[54] = 0x5b9cca4f;
    k[55] = 0x682e6ff3;
    k[56] = 0x748f82ee;
    k[57] = 0x78a5636f;
    k[58] = 0x84c87814;
    k[59] = 0x8cc70208;
    k[60] = 0x90befffa;
    k[61] = 0xa4506ceb;
    k[62] = 0xbef9a3f7;
    k[63] = 0xc67178f2;
    h[0] = 0x6a09e667;
    h[1] = 0xbb67ae85;
    h[2] = 0x3c6ef372;
    h[3] = 0xa54ff53a;
    h[4] = 0x510e527f;
    h[5] = 0x9b05688c;
    h[6] = 0x1f83d9ab;
    h[7] = 0x5be0cd19;
    int total = ((n + 8) / 64 + 1) * 64;
    char* m = alloc(total);
    memcpy(m, data, n);
    m[n] = 0x80;
    int bits = n * 8;
    for (int i = 0; i < 8; i++) {
        m[total - 1 - i] = (bits >> (8 * i)) & 255;
    }
    int M = 0xFFFFFFFF;
    for (int off = 0; off < total; off = off + 64) {
        for (int t = 0; t < 16; t++) {
            w[t] = (m[off + 4 * t] << 24) | (m[off + 4 * t + 1] << 16) | (m[off + 4 * t + 2] << 8) | m[off + 4 * t + 3];
        }
        for (int t = 16; t < 64; t++) {
            int s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
            int s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & M;
        }
        int a = h[0]; int b = h[1]; int c = h[2]; int d = h[3];
        int e = h[4]; int f = h[5]; int g = h[6]; int hh = h[7];
        for (int t = 0; t < 64; t++) {
            int S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            int ch = (e & f) ^ ((~e) & g);
            int t1 = (hh + S1 + ch + k[t] + w[t]) & M;
            int S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            int maj = (a & b) ^ (a & c) ^ (b & c);
            int t2 = (S0 + maj) & M;
            hh = g; g = f; f = e;
            e = (d + t1) & M;
            d = c; c = b; b = a;
            a = (t1 + t2) & M;
        }
        h[0] = (h[0] + a) & M; h[1] = (h[1] + b) & M; h[2] = (h[2] + c) & M; h[3] = (h[3] + d) & M;
        h[4] = (h[4] + e) & M; h[5] = (h[5] + f) & M; h[6] = (h[6] + g) & M; h[7] = (h[7] + hh) & M;
    }
    char* out = alloc(65);
    for (int i = 0; i < 8; i++) {
        for (int j = 0; j < 8; j++) {
            int nib = (h[i] >> (28 - 4 * j)) & 15;
            if (nib < 10) {
                out[i * 8 + j] = '0' + nib;
            } else {
                out[i * 8 + j] = 'a' + nib - 10;
            }
        }
    }
    return out;
}

// ---- SHA-1 (needed by WebSocket handshakes; do not use it for security) -----------------------------------------------------------
private int rotl32(int x, int n) {
    x = x & 0xFFFFFFFF;
    return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF;
}

// the 20 byte SHA-1 digest of n bytes, written to out
public void sha1Raw(char* data, int n, char* out) {
    int h0 = 0x67452301;
    int h1 = 0xEFCDAB89;
    int h2 = 0x98BADCFE;
    int h3 = 0x10325476;
    int h4 = 0xC3D2E1F0;
    int total = ((n + 8) / 64 + 1) * 64;
    char* msg = alloc(total + 8);
    memcpy(msg, data, n);
    msg[n] = 0x80;
    int bits = n * 8;
    for (int i = 0; i < 8; i++) msg[total - 1 - i] = (bits >> (8 * i)) & 255;
    int w[80];
    for (int blk = 0; blk < total; blk = blk + 64) {
        for (int t = 0; t < 16; t++) {
            w[t] = (msg[blk + t * 4] << 24) | (msg[blk + t * 4 + 1] << 16) | (msg[blk + t * 4 + 2] << 8) | msg[blk + t * 4 + 3];
        }
        for (int t = 16; t < 80; t++) {
            w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
        }
        int a = h0;
        int b = h1;
        int c = h2;
        int d = h3;
        int e = h4;
        for (int t = 0; t < 80; t++) {
            int f;
            int k;
            if (t < 20) { f = (b & c) | ((~b & 0xFFFFFFFF) & d); k = 0x5A827999; }
            else if (t < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1; }
            else if (t < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC; }
            else { f = b ^ c ^ d; k = 0xCA62C1D6; }
            int tmp = (rotl32(a, 5) + f + e + k + w[t]) & 0xFFFFFFFF;
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = tmp;
        }
        h0 = (h0 + a) & 0xFFFFFFFF;
        h1 = (h1 + b) & 0xFFFFFFFF;
        h2 = (h2 + c) & 0xFFFFFFFF;
        h3 = (h3 + d) & 0xFFFFFFFF;
        h4 = (h4 + e) & 0xFFFFFFFF;
    }
    int hv[5];
    hv[0] = h0; hv[1] = h1; hv[2] = h2; hv[3] = h3; hv[4] = h4;
    for (int i = 0; i < 5; i++) {
        out[i * 4] = (hv[i] >> 24) & 255;
        out[i * 4 + 1] = (hv[i] >> 16) & 255;
        out[i * 4 + 2] = (hv[i] >> 8) & 255;
        out[i * 4 + 3] = hv[i] & 255;
    }
}

// SHA-1 as 40 lowercase hex characters (a new heap string)
public char* sha1(char* data, int n) {
    char raw[20];
    sha1Raw(data, n, raw);
    char* out = alloc(41);
    for (int i = 0; i < 20; i++) {
        format(&out[i * 2], 3, "%02x", raw[i]);
    }
    return out;
}

