// one 64 byte block: h holds the eight 32 bit state words, w is scratch space of 64 words. The words are kept in the low 32 bits of
    // 64 bit ints; a rotation is written out with shifts, and the bits above bit 31 that it leaves are cut off once per sum.
        private void sha256Block(int* h, char* p, int* w) {
        int M = 0xFFFFFFFF;
        for (int t = 0; t < 16; t++) {
            int o = t * 4;
            w[t] = (p[o] << 24) | (p[o + 1] << 16) | (p[o + 2] << 8) | p[o + 3];
        }
        for (int t = 16; t < 64; t++) {
            int x = w[t - 15];
            int y = w[t - 2];
            int s0 = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3);
            int s1 = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10);
            w[t] = (w[t - 16] + (s0 & M) + w[t - 7] + (s1 & M)) & M;
        }
        int a = h[0]; int b = h[1]; int c = h[2]; int d = h[3];
        int e = h[4]; int f = h[5]; int g = h[6]; int hh = h[7];
        for (int t = 0; t < 64; t++) {
            int S1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & M;
            int ch = (e & f) ^ ((~e) & g);
            int t1 = (hh + S1 + ch + sha256K[t] + w[t]) & M;
            int S0 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & M;
            int maj = (a & b) ^ (a & c) ^ (b & c);
            hh = g; g = f; f = e;
            e = (d + t1) & M;
            d = c; c = b; b = a;
            a = (t1 + S0 + maj) & M;
        }
        h[0] = (h[0] + a) & M; h[1] = (h[1] + b) & M; h[2] = (h[2] + c) & M; h[3] = (h[3] + d) & M;
        h[4] = (h[4] + e) & M; h[5] = (h[5] + f) & M; h[6] = (h[6] + g) & M; h[7] = (h[7] + hh) & M;
    }
}

// SHA-256 as 32 raw bytes into out. The data is read where it is (nothing is copied or allocated)
public void sha256Raw(char* data, int n, char* out) {
    int h[8];
    int w[64];
    h[0] = 0x6a09e667; h[1] = 0xbb67ae85; h[2] = 0x3c6ef372; h[3] = 0xa54ff53a;
    h[4] = 0x510e527f; h[5] = 0x9b05688c; h[6] = 0x1f83d9ab; h[7] = 0x5be0cd19;
    int full = n / 64;
    for (int i = 0; i < full; i++) {
        sha256Block(&h[0], &data[i * 64], &w[0]);
    }
    char tail[128];
    int rest = n - full * 64;
    memcpy(&tail[0], &data[full * 64], rest);
    tail[rest] = 0x80;
    int tl = (rest + 9 <= 64) ? 64 : 128;
    memset(&tail[rest + 1], 0, tl - rest - 1);
    int bits = n * 8;
    for (int i = 0; i < 8; i++) {
        tail[tl - 1 - i] = (bits >> (8 * i)) & 255;
    }
    sha256Block(&h[0], &tail[0], &w[0]);
    if (tl == 128) {
        sha256Block(&h[0], &tail[64], &w[0]);
    }
    for (int i = 0; i < 8; i++) {
        out[i * 4] = (h[i] >> 24) & 255;
        out[i * 4 + 1] = (h[i] >> 16) & 255;
        out[i * 4 + 2] = (h[i] >> 8) & 255;
        out[i * 4 + 3] = h[i] & 255;
    }
}

// SHA-256 as 64 lowercase hex characters (a new heap string)
public char* sha256(char* data, int n) {
    char raw[32];
    sha256Raw(data, n, &raw[0]);
    char* out = alloc(65);
    char* digits = "0123456789abcdef";
    for (int i = 0; i < 32; i++) {
        out[i * 2] = digits[(raw[i] >> 4) & 15];
        out[i * 2 + 1] = digits[raw[i] & 15];
    }
    out[64] = 0;
    return out;
}

// ---- SHA-1 (needed by WebSocket handshakes; do not use it for security) -----------------------------------------------------------
private int rotl32(int x, int n) {
    x = x & 0xFFFFFFFF;
    return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF;
}

// the 20 byte SHA-1 digest of n bytes, written to out
public void sha1Raw(char* data, int n, char* out) {
    int h0 = 0x67452301;
    int h1 = 0xEFCDAB89;
    int h2 = 0x98BADCFE;
    int h3 = 0x10325476;
    int h4 = 0xC3D2E1F0;
    int total = ((n + 8) / 64 + 1) * 64;
    char* msg = alloc(total + 8);
    memcpy(msg, data, n);
    msg[n] = 0x80;
    int bits = n * 8;
    for (int i = 0; i < 8; i++) msg[total - 1 - i] = (bits >> (8 * i)) & 255;
    int w[80];
    for (int blk = 0; blk < total; blk = blk + 64) {
        for (int t = 0; t < 16; t++) {
            w[t] = (msg[blk + t * 4] << 24) | (msg[blk + t * 4 + 1] << 16) | (msg[blk + t * 4 + 2] << 8) | msg[blk + t * 4 + 3];
        }
        for (int t = 16; t < 80; t++) {
            w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
        }
        int a = h0;
        int b = h1;
        int c = h2;
        int d = h3;
        int e = h4;
        for (int t = 0; t < 80; t++) {
            int f;
            int k;
            if (t < 20) { f = (b & c) | ((~b & 0xFFFFFFFF) & d); k = 0x5A827999; }
            else if (t < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1; }
            else if (t < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC; }
            else { f = b ^ c ^ d; k = 0xCA62C1D6; }
            int tmp = (rotl32(a, 5) + f + e + k + w[t]) & 0xFFFFFFFF;
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = tmp;
        }
        h0 = (h0 + a) & 0xFFFFFFFF;
        h1 = (h1 + b) & 0xFFFFFFFF;
        h2 = (h2 + c) & 0xFFFFFFFF;
        h3 = (h3 + d) & 0xFFFFFFFF;
        h4 = (h4 + e) & 0xFFFFFFFF;
    }
    int hv[5];
    hv[0] = h0; hv[1] = h1; hv[2] = h2; hv[3] = h3; hv[4] = h4;
    for (int i = 0; i < 5; i++) {
        out[i * 4] = (hv[i] >> 24) & 255;
        out[i * 4 + 1] = (hv[i] >> 16) & 255;
        out[i * 4 + 2] = (hv[i] >> 8) & 255;
        out[i * 4 + 3] = hv[i] & 255;
    }
}

// SHA-1 as 40 lowercase hex characters (a new heap string)
public char* sha1(char* data, int n) {
    char raw[20];
    sha1Raw(data, n, raw);
    char* out = alloc(41);
    for (int i = 0; i < 20; i++) {
        format(&out[i * 2], 3, "%02x", raw[i]);
    }
    return out;
}

