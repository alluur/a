// =============================================================================
//  hash - checksums and cryptographic hashes                import hash;
//  Every function takes a pointer and a byte count (strings: use strlen(s)).
// =============================================================================
module hash;

// 32 bit FNV-1a
public int fnv1a(char* data, int n) {
    int h = 0x811C9DC5;
    for (int i = 0; i < n; i++) {
        h = ((h ^ data[i]) * 16777619) & 0xFFFFFFFF;
    }
    return h;
}

// 32 bit djb2
public int djb2(char* data, int n) {
    int h = 5381;
    for (int i = 0; i < n; i++) {
        h = (h * 33 + data[i]) & 0xFFFFFFFF;
    }
    return h;
}

// Adler-32 (as used by zlib)
public int adler32(char* data, int n) {
    int a = 1;
    int b = 0;
    for (int i = 0; i < n; i++) {
        a = (a + data[i]) % 65521;
        b = (b + a) % 65521;
    }
    return (b << 16) | a;
}

// CRC-32 (as used by zip, gzip and PNG): "slicing by 8", eight table look-ups per eight bytes (tables made on first use)
int crcTab[2048];
bool crcReady;

private void crcInit() {
    for (int i = 0; i < 256; i++) {
        int c = i;
        for (int k = 0; k < 8; k++) {
            if (c & 1) {
                c = (c >> 1) ^ 0xEDB88320;
            } else {
                c = c >> 1;
            }
        }
        crcTab[i] = c;
    }
    for (int i = 0; i < 256; i++) {
        int c = crcTab[i];
        for (int k = 1; k < 8; k++) {
            c = (c >> 8) ^ crcTab[c & 255];
            crcTab[k * 256 + i] = c;
        }
    }
    crcReady = true;
}

// the CRC-32 of n bytes continued from a previous value (0 to start): crc32Update(crc32Update(0, a, na), b, nb) == crc32(a ++ b)
public int crc32Update(int crc, char* data, int n) {
    if (!crcReady) { crcInit(); }
    crc = crc ^ 0xFFFFFFFF;
    int i = 0;
    while (i + 8 <= n) {
        int lo = crc ^ (data[i] | (data[i + 1] << 8) | (data[i + 2] << 16) | (data[i + 3] << 24));
        int hi = data[i + 4] | (data[i + 5] << 8) | (data[i + 6] << 16) | (data[i + 7] << 24);
        crc = crcTab[1792 + (lo & 255)] ^ crcTab[1536 + ((lo >> 8) & 255)] ^ crcTab[1280 + ((lo >> 16) & 255)] ^ crcTab[1024 + ((lo >> 24) & 255)]
            ^ crcTab[768 + (hi & 255)] ^ crcTab[512 + ((hi >> 8) & 255)] ^ crcTab[256 + ((hi >> 16) & 255)] ^ crcTab[(hi >> 24) & 255];
        i = i + 8;
    }
    while (i < n) {
        crc = (crc >> 8) ^ crcTab[(crc ^ data[i]) & 255];
        i++;
    }
    return crc ^ 0xFFFFFFFF;
}

public int crc32(char* data, int n) {
    return crc32Update(0, data, n);
}

private int rotr(int x, int n) {
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;
}

