private int rotr64(int x, int n) {
    return ((x >> n) & ((1 << (64 - n)) - 1)) | (x << (64 - n));
}

private int shr64(int x, int n) {
    return (x >> n) & ((1 << (64 - n)) - 1);
}

// an incremental SHA-512:  Sha512 s;  s.update(data, n);  s.final(out64)
public class Sha512 {
    private int hh[8];
    private int w[80];
    private char blk[128];
    private int fill;
    private int total;
    private bool is384;

    public Sha512() {
        reset();
    }

    // makes this a SHA-384 (the same function with other start values and a 48 byte result)
    public void use384() {
        is384 = true;
        reset();
    }

    public void reset() {
        for (int i = 0; i < 8; i++) {
            hh[i] = is384 ? SHA384_H[i] : SHA512_H[i];
        }
        fill = 0;
        total = 0;
    }

    private void compress() {
        for (int t = 0; t < 16; t++) {
            int v = 0;
            for (int k = 0; k < 8; k++) {
                v = (v << 8) | blk[t * 8 + k];
            }
            w[t] = v;
        }
        for (int t = 16; t < 80; t++) {
            int s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ shr64(w[t - 15], 7);
            int s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ shr64(w[t - 2], 6);
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }
        int a = hh[0];
        int b = hh[1];
        int c = hh[2];
        int d = hh[3];
        int e = hh[4];
        int f = hh[5];
        int g = hh[6];
        int h = hh[7];
        for (int t = 0; t < 80; t++) {
            int S1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            int ch = (e & f) ^ (~e & g);
            int t1 = h + S1 + ch + SHA512_K[t] + w[t];
            int S0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            int maj = (a & b) ^ (a & c) ^ (b & c);
            int t2 = S0 + maj;
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        hh[0] = hh[0] + a;
        hh[1] = hh[1] + b;
        hh[2] = hh[2] + c;
        hh[3] = hh[3] + d;
        hh[4] = hh[4] + e;
        hh[5] = hh[5] + f;
        hh[6] = hh[6] + g;
        hh[7] = hh[7] + h;
    }

    public void update(char* data, int n) {
        for (int i = 0; i < n; i++) {
            blk[fill] = data[i];
            fill++;
            if (fill == 128) {
                compress();
                fill = 0;
            }
        }
        total = total + n;
    }

    // the 64 byte digest; the object is reset afterwards
    public void final(char* out) {
        int bits = total * 8;
        blk[fill] = 0x80;
        fill++;
        if (fill > 112) {
            while (fill < 128) {
                blk[fill] = 0;
                fill++;
            }
            compress();
            fill = 0;
        }
        while (fill < 120) {
            blk[fill] = 0;
            fill++;
        }
        for (int i = 0; i < 8; i++) {
            blk[120 + i] = (bits >> (56 - 8 * i)) & 255;
        }
        compress();
        int words = is384 ? 6 : 8;
        for (int i = 0; i < words; i++) {
            for (int k = 0; k < 8; k++) {
                out[i * 8 + k] = (hh[i] >> (56 - 8 * k)) & 255;
            }
        }
        reset();
    }
}

// the 64 byte SHA-512 digest of n bytes
public void sha512Raw(char* data, int n, char* out) {
    Sha512 s();
    s.update(data, n);
    s.final(out);
}

// the 48 byte SHA-384 digest of n bytes
public void sha384Raw(char* data, int n, char* out) {
    Sha512 s();
    s.use384();
    s.update(data, n);
    s.final(out);
}

// SHA-512 as 128 lowercase hex characters (a new heap string)
public char* sha512(char* data, int n) {
    char raw[64];
    sha512Raw(data, n, raw);
    char* out = alloc(129);
    for (int i = 0; i < 64; i++) {
        format(&out[i * 2], 3, "%02x", raw[i]);
    }
    return out;
}

// ---- HMAC-SHA256 --------------------------------------------------------------------------------------------------------------------
private int hexDigit(int c) {
    if (c >= 'a') { return c - 'a' + 10; }
    return c - '0';
}

// SHA-256 as 32 raw bytes into out
public void sha256Raw(char* data, int n, char* out) {
    char* hex = sha256(data, n);
    for (int i = 0; i < 32; i++) {
        out[i] = hexDigit(hex[i * 2]) * 16 + hexDigit(hex[i * 2 + 1]);
    }
}

// HMAC-SHA256 (RFC 2104) of data with key, 32 raw bytes into out
public void hmacSha256(char* key, int klen, char* data, int dlen, char* out) {
    char k[64];
    for (int i = 0; i < 64; i++) { k[i] = 0; }
    if (klen > 64) {
        sha256Raw(key, klen, &k[0]);
    } else {
        for (int i = 0; i < klen; i++) { k[i] = key[i]; }
    }
    char* inner = alloc(64 + dlen);
    for (int i = 0; i < 64; i++) { inner[i] = k[i] ^ 0x36; }
    for (int i = 0; i < dlen; i++) { inner[64 + i] = data[i]; }
    char ih[32];
    sha256Raw(inner, 64 + dlen, &ih[0]);
    char outer[96];
    for (int i = 0; i < 64; i++) { outer[i] = k[i] ^ 0x5C; }
    for (int i = 0; i < 32; i++) { outer[64 + i] = ih[i]; }
    sha256Raw(&outer[0], 96, out);
}

// compares two byte strings without stopping at the first difference (for secrets)
public bool equalConstantTime(char* a, char* b, int n) {
    int diff = 0;
    for (int i = 0; i < n; i++) {
        diff = diff | ((a[i] ^ b[i]) & 255);
    }
    return diff == 0;
}

// the digest of n bytes by size: 160 (SHA-1), 256, 384 or 512 bits; returns the length in bytes (0 for an unknown size)
public int digest(int bits, char* data, int n, char* out) {
    if (bits == 160) { sha1Raw(data, n, out); return 20; }
    if (bits == 256) { sha256Raw(data, n, out); return 32; }
    if (bits == 384) { sha384Raw(data, n, out); return 48; }
    if (bits == 512) { sha512Raw(data, n, out); return 64; }
    return 0;
}

// HMAC with any of those hashes (block size 64 bytes for SHA-1 and SHA-256, 128 for SHA-384 and SHA-512)
public int hmac(int bits, char* key, int klen, char* data, int dlen, char* out) {
    int block = (bits >= 384) ? 128 : 64;
    int hl = (bits == 160) ? 20 : bits / 8;
    char* k = alloc(block + 8);
    for (int i = 0; i < block; i++) { k[i] = 0; }
    if (klen > block) {
        digest(bits, key, klen, k);
    } else {
        for (int i = 0; i < klen; i++) { k[i] = key[i]; }
    }
    char* inner = alloc(block + dlen + 8);
    for (int i = 0; i < block; i++) { inner[i] = k[i] ^ 0x36; }
    for (int i = 0; i < dlen; i++) { inner[block + i] = data[i]; }
    char ih[64];
    digest(bits, inner, block + dlen, &ih[0]);
    char* outer = alloc(block + hl + 8);
    for (int i = 0; i < block; i++) { outer[i] = k[i] ^ 0x5C; }
    for (int i = 0; i < hl; i++) { outer[block + i] = ih[i]; }
    digest(bits, outer, block + hl, out);
    return hl;
}
