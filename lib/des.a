// =============================================================================
//  des - the DES block cipher (FIPS 46-3), for VNC passwords                                       import des;
//
//    char block[8];
//    des.encryptBlock(key8, in8, &block[0]);          // 8-byte key (parity bits are ignored), one 8-byte block
//    des.decryptBlock(key8, in8, &block[0]);
//    des.vncResponse("secret", challenge16, &out[0]); // the answer of a VNC viewer to the 16 byte challenge of a server
//
//  DES is weak by today's standards (56 bit key); it is here because the VNC password scheme uses it. Do not use it for new
//  designs; the display protocol's cookie authentication uses HMAC-SHA256 (hash.hmacSha256).
// =============================================================================
module des;

