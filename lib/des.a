// the bits of a byte string, most significant first
private void toBits(char* b, int n, int* out) {
    for (int i = 0; i < n * 8; i++) {
        out[i] = (b[i / 8] >> (7 - i % 8)) & 1;
    }
}

private void permute(int* src, int* table, int n, int* dst) {
    for (int i = 0; i < n; i++) {
        dst[i] = src[table[i] - 1];
    }
}

// the sixteen 48 bit round keys
private void makeKeys(char* key, int* keys) {
    int kb[64];
    int k56[56];
    toBits(key, 8, &kb[0]);
    permute(&kb[0], &pc1[0], 56, &k56[0]);
    int cd[56];
    for (int i = 0; i < 56; i++) { cd[i] = k56[i]; }
    for (int round = 0; round < 16; round++) {
        for (int s = 0; s < shifts[round]; s++) {
            int c0 = cd[0];
            for (int i = 0; i < 27; i++) { cd[i] = cd[i + 1]; }
            cd[27] = c0;
            int d0 = cd[28];
            for (int i = 28; i < 55; i++) { cd[i] = cd[i + 1]; }
            cd[55] = d0;
        }
        permute(&cd[0], &pc2[0], 48, &keys[round * 48]);
    }
}

private void feistel(int* r, int* k, int* out) {
    int e[48];
    permute(r, &ex[0], 48, &e[0]);
    int o[32];
    for (int i = 0; i < 8; i++) {
        int b0 = e[i * 6] ^ k[i * 6];
        int b1 = e[i * 6 + 1] ^ k[i * 6 + 1];
        int b2 = e[i * 6 + 2] ^ k[i * 6 + 2];
        int b3 = e[i * 6 + 3] ^ k[i * 6 + 3];
        int b4 = e[i * 6 + 4] ^ k[i * 6 + 4];
        int b5 = e[i * 6 + 5] ^ k[i * 6 + 5];
        int row = b0 * 2 + b5;
        int col = b1 * 8 + b2 * 4 + b3 * 2 + b4;
        int v = sbox[i * 64 + row * 16 + col];
        o[i * 4] = (v >> 3) & 1;
        o[i * 4 + 1] = (v >> 2) & 1;
        o[i * 4 + 2] = (v >> 1) & 1;
        o[i * 4 + 3] = v & 1;
    }
    permute(&o[0], &pp[0], 32, out);
}

private void crypt(char* key, char* in, char* out, bool decrypt) {
    int keys[768];
    makeKeys(key, &keys[0]);
    int bits[64];
    int b[64];
    toBits(in, 8, &bits[0]);
    permute(&bits[0], &ip[0], 64, &b[0]);
    int l[32];
    int r[32];
    for (int i = 0; i < 32; i++) { l[i] = b[i]; r[i] = b[32 + i]; }
    for (int round = 0; round < 16; round++) {
        int kr = decrypt ? 15 - round : round;
        int f[32];
        feistel(&r[0], &keys[kr * 48], &f[0]);
        int nr[32];
        for (int i = 0; i < 32; i++) { nr[i] = l[i] ^ f[i]; }
        for (int i = 0; i < 32; i++) { l[i] = r[i]; r[i] = nr[i]; }
    }
    int pre[64];
    for (int i = 0; i < 32; i++) { pre[i] = r[i]; pre[32 + i] = l[i]; }
    int res[64];
    permute(&pre[0], &fp[0], 64, &res[0]);
    for (int i = 0; i < 8; i++) {
        int v = 0;
        for (int j = 0; j < 8; j++) { v = v * 2 + res[i * 8 + j]; }
        out[i] = v;
    }
}

public void encryptBlock(char* key, char* in, char* out) {
    crypt(key, in, out, false);
}

public void decryptBlock(char* key, char* in, char* out) {
    crypt(key, in, out, true);
}

// the VNC authentication answer: the password (at most 8 characters, padded with zeros) is the key with the bits of every
// byte reversed; the 16 byte challenge is encrypted as two blocks
public void vncResponse(char* password, char* challenge, char* out) {
    char key[8];
    for (int i = 0; i < 8; i++) {
        int c = (i < strlen(password)) ? (password[i] & 255) : 0;
        int r = 0;
        for (int k = 0; k < 8; k++) {
            r = (r << 1) | ((c >> k) & 1);
        }
        key[i] = r;
    }
    encryptBlock(&key[0], challenge, out);
    encryptBlock(&key[0], &challenge[8], &out[8]);
}
