// =============================================================================
//  dfloat - the runtime of the types double and float          (loaded automatically)
//
//  A program that mentions `double`, `float` or a floating point literal gets the soft-float functions of cmath
//  (dadd dsub dmul ddiv dcmp itod dtoi dneg ...: every operation is done in software, exactly rounded like on a CPU, so the
//  results are the same on every CPU) when it is compiled with --soft-float (otherwise the compiler emits FPU instructions
//  for the arithmetic), cfloat (text conversion), plus the helpers below.
//
//     double x = 2.5;   double y = x * 3 + 0.25;       // int and double mix, ints are converted
//     printlnDouble(y);                                 // 7.75
//     int n = (int) y;                                  // 7: converting a double to int truncates
//
//     printDouble(d)  printlnDouble(d)       the shortest text that reads back as exactly d ("0.1", "1e+22", "7.75")
//     doubleToText(d)                        the same as a new heap string
//     doubleToFixed(d, decimals)             "3.142" (rounded exactly)
//     doubleToSci(d, decimals)               "3.142e+00"
//     parseDouble("2.5e3")                   text to double (0.0 if there are no digits)
//     isNaN(d)  isInf(d)  isFinite(d)
//     __bits(d) / __dbl(i)                   the 64 bits of a double as an int / an int's bits taken as a double
//  The functions of math.h with typed arguments (sqrt, sin, pow ...) are in the dmath module.
// =============================================================================
import cfloat;

void printDouble(double d) {
    print(dtostr(__bits(d)));
}

void printlnDouble(double d) {
    println(dtostr(__bits(d)));
}

char* doubleToText(double d) {
    return dtostr(__bits(d));
}

char* doubleToFixed(double d, int decimals) {
    char* buf = alloc(420);
    sprintfd(buf, "%.*f", decimals, __bits(d));
    return buf;
}

char* doubleToSci(double d, int decimals) {
    char* buf = alloc(420);
    sprintfd(buf, "%.*e", decimals, __bits(d));
    return buf;
}

double parseDouble(char* s) {
    return __dbl(strtod(s, null));
}

bool isNaN(double d) {
    int b = __bits(d);
    return ((b >> 52) & 0x7FF) == 0x7FF && (b & 0xFFFFFFFFFFFFF) != 0;
}

bool isInf(double d) {
    int b = __bits(d);
    return ((b >> 52) & 0x7FF) == 0x7FF && (b & 0xFFFFFFFFFFFFF) == 0;
}

bool isFinite(double d) {
    return ((__bits(d) >> 52) & 0x7FF) != 0x7FF;
}

// uint64_t <-> double with --soft-float (the compiler calls these; with the FPU it emits the instructions instead).
// A double here is its bit pattern in an int.
int __utod(int u) {
    if (u >= 0) return itod(u);
    int h = itod(((u >> 1) & 0x7FFFFFFFFFFFFFFF) | (u & 1));    // halved, the lost bit kept as a sticky bit for rounding
    return dadd(h, h);
}

int __dtou(int d) {
    int two63 = 0x43E0000000000000;                              // 2^63
    if (dcmp(d, two63) < 0) return dtoi(d);
    return dtoi(dsub(d, two63)) ^ (1 << 63);
}
