// =============================================================================
//  gcode - the widgets of the AIDE code editor (umbrella module: import gcode; gives you all of them)
//
//    import gui;  import gcode;
//    gcode.CodeEditor* e = new gcode.CodeEditor();            // an editor with a document of its own
//    e->open("main.a");                                       // or e->setDoc(doc) to show another gcode.Doc
//    gcode.FindBar* find = new gcode.FindBar(e);              // find / replace; follows the document the editor shows
//    gcode.TabBar* tabs = new gcode.TabBar();                 // the tabs of an IDE: one gcode.Doc per tab
//    gcode.FileTree* files = new gcode.FileTree();            // the project explorer
//    gcode.Dock* dock = new gcode.Dock();                     // sidebar | centre / bottom panel with draggable dividers
//    gcode.theLook()->setThemeName("monokai");                // every widget repaints with the new theme
//
//  The parts (each is a file of its own and is imported by this one):
//    gcode_core     Look (theme, font, preferences shared by all widgets), RowList, FlatButton, LineEdit, small helpers
//    gcode_doc      Doc: the text of one tab with its editor state, markers and bookmarks
//    gcode_editor   CodeEditor
//    gcode_bars     TabBar, FindBar, GotoBar, StatusBar, EditorStatus, Outline
//    gcode_panes    FileTree, OutputPane (ANSI colours, problems), TerminalPane
//    gcode_dock     Dock, PanelTabs, Commands (keys), Palette (command / file / symbol picker)
//    gcode_dialogs  ColorPicker, ThemeEditor, SettingsDialog
//    gcode_ide      SearchPane (find in files), RunPane (program output and input), DocView (the documentation as pages)
//  See docs/GUI.md (the code editor widgets) and examples/gui/codedemo.a (all of them together).
// =============================================================================
import gcode_core;
import gcode_doc;
import gcode_editor;
import gcode_bars;
import gcode_panes;
import gcode_dock;
import gcode_dialogs;
import gcode_ide;
module gcode;
