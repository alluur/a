// =============================================================================
//  gcode_core - shared parts of the gcode widgets: the Look (theme, font, preferences), key specifications, small helpers
//  (this file is part of the module gcode: do not import it by itself, use  import gcode;)
//
//    gcode.Look* look = gcode.theLook();          // the one Look every gcode widget uses unless it is given another one
//    look->setThemeName("solarized-dark");        // every registered widget repaints at once
//    look->setFontIndex(1);                       // 0 mono, 1 sans, 2 sans bold: editors measure their cells again
//    int bg = look->col(atheme.Col.Background);   // colours come out as 0xFFRRGGBB, ready for gfx
// =============================================================================
import gui;
import gfx;
import adp;
import asys;
import atheme;
import asyntax;
import cstdlib;
module gcode;

public const SEV_ERROR = 0;                 // marker and problem severities (the same numbers as aproject.SEV_*)
public const SEV_WARNING = 1;
public const SEV_NOTE = 2;
public const SEV_INFO = 3;

public const FONT_MONO = 0;
public const FONT_SANS = 1;
public const FONT_SANS_BOLD = 2;

public int imin(int a, int b) {
    if (a < b) { return a; }
    return b;
}

public int imax(int a, int b) {
    if (a > b) { return a; }
    return b;
}

// a 0xRRGGBB theme colour as the opaque 0xFFRRGGBB that gfx draws with
public int argb(int c) {
    return 0xFF000000 | (c & 0xFFFFFF);
}

// the colour that is readable on a background: white or black text
public int textOn(int bg) {
    int l = atheme.luminance(bg & 0xFFFFFF);
    return (l > 179000) ? 0xFF101418 : 0xFFFFFFFF;
}

// =============================================================================
//  key specifications:  "ctrl+shift+p"  "F5"  "alt+left"  (case does not matter)
// =============================================================================
private bool eqNoCase(char* a, char* b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        int x = a[i];
        int y = b[i];
        if (x >= 'A' && x <= 'Z') { x = x + 32; }
        if (y >= 'A' && y <= 'Z') { y = y + 32; }
        if (x != y) { return false; }
        i++;
    }
    return a[i] == 0 && b[i] == 0;
}

// the key code of a key name ("enter", "esc", "f5", "pgdn", "a", "/"), or 0
public int keyFromName(char* name) {
    int n = strlen(name);
    if (n == 0) { return 0; }
    if (n == 1) {
        int c = name[0];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        return c;
    }
    if (eqNoCase(name, "enter") || eqNoCase(name, "return")) { return adp.KEY_ENTER; }
    if (eqNoCase(name, "esc") || eqNoCase(name, "escape")) { return adp.KEY_ESCAPE; }
    if (eqNoCase(name, "tab")) { return adp.KEY_TAB; }
    if (eqNoCase(name, "space")) { return adp.KEY_SPACE; }
    if (eqNoCase(name, "backspace")) { return adp.KEY_BACKSPACE; }
    if (eqNoCase(name, "del") || eqNoCase(name, "delete")) { return adp.KEY_DELETE; }
    if (eqNoCase(name, "ins") || eqNoCase(name, "insert")) { return adp.KEY_INSERT; }
    if (eqNoCase(name, "home")) { return adp.KEY_HOME; }
    if (eqNoCase(name, "end")) { return adp.KEY_END; }
    if (eqNoCase(name, "up")) { return adp.KEY_UP; }
    if (eqNoCase(name, "down")) { return adp.KEY_DOWN; }
    if (eqNoCase(name, "left")) { return adp.KEY_LEFT; }
    if (eqNoCase(name, "right")) { return adp.KEY_RIGHT; }
    if (eqNoCase(name, "pgup") || eqNoCase(name, "pageup")) { return adp.KEY_PGUP; }
    if (eqNoCase(name, "pgdn") || eqNoCase(name, "pagedown")) { return adp.KEY_PGDN; }
    if ((name[0] == 'f' || name[0] == 'F') && name[1] >= '0' && name[1] <= '9') {
        int v = 0;
        for (int i = 1; name[i] != 0; i++) {
            if (name[i] < '0' || name[i] > '9') { return 0; }
            v = v * 10 + (name[i] - '0');
        }
        if (v >= 1 && v <= 12) { return adp.KEY_F1 + v - 1; }
    }
    return 0;
}

// Reads "ctrl+shift+p", "Alt+Left", "F5": returns false when the text is not a key (key and mods are then 0)
public bool parseKeys(char* spec, int* key, int* mods) {
    *key = 0;
    *mods = 0;
    int n = strlen(spec);
    if (n == 0 || n > 60) { return false; }
    char part[64];
    int pl = 0;
    int m = 0;
    int k = 0;
    for (int i = 0; i <= n; i++) {
        bool last = (i == n);
        // a '+' is a separator unless it is the key itself ("ctrl++" is not supported: write "ctrl+plus")
        if (last || spec[i] == '+') {
            part[pl] = 0;
            if (pl == 0) { return false; }
            if (eqNoCase(&part[0], "ctrl") || eqNoCase(&part[0], "control")) { m = m | adp.MOD_CTRL; }
            else if (eqNoCase(&part[0], "shift")) { m = m | adp.MOD_SHIFT; }
            else if (eqNoCase(&part[0], "alt")) { m = m | adp.MOD_ALT; }
            else if (eqNoCase(&part[0], "meta") || eqNoCase(&part[0], "super") || eqNoCase(&part[0], "cmd")) { m = m | adp.MOD_META; }
            else if (last) {
                if (eqNoCase(&part[0], "plus")) { k = '+'; } else { k = keyFromName(&part[0]); }
            } else { return false; }
            pl = 0;
        } else {
            if (pl < 60) { part[pl] = spec[i]; pl++; }
        }
    }
    if (k == 0) { return false; }
    *key = k;
    *mods = m;
    return true;
}

// the name of a key: "Enter", "F5", "A"
public char* keyName(int key, char* out) {
    if (key == adp.KEY_ENTER) { strcpy(out, "Enter"); }
    else if (key == adp.KEY_ESCAPE) { strcpy(out, "Esc"); }
    else if (key == adp.KEY_TAB) { strcpy(out, "Tab"); }
    else if (key == adp.KEY_SPACE) { strcpy(out, "Space"); }
    else if (key == adp.KEY_BACKSPACE) { strcpy(out, "Backspace"); }
    else if (key == adp.KEY_DELETE) { strcpy(out, "Del"); }
    else if (key == adp.KEY_INSERT) { strcpy(out, "Ins"); }
    else if (key == adp.KEY_HOME) { strcpy(out, "Home"); }
    else if (key == adp.KEY_END) { strcpy(out, "End"); }
    else if (key == adp.KEY_UP) { strcpy(out, "Up"); }
    else if (key == adp.KEY_DOWN) { strcpy(out, "Down"); }
    else if (key == adp.KEY_LEFT) { strcpy(out, "Left"); }
    else if (key == adp.KEY_RIGHT) { strcpy(out, "Right"); }
    else if (key == adp.KEY_PGUP) { strcpy(out, "PgUp"); }
    else if (key == adp.KEY_PGDN) { strcpy(out, "PgDn"); }
    else if (key >= adp.KEY_F1 && key <= adp.KEY_F1 + 11) { format(out, 8, "F%d", key - adp.KEY_F1 + 1); }
    else if (key >= 'a' && key <= 'z') { out[0] = key - 32; out[1] = 0; }
    else if (key > 32 && key < 127) { out[0] = key; out[1] = 0; }
    else { strcpy(out, "?"); }
    return out;
}

// "Ctrl+Shift+P" (Ctrl, Alt, Shift, Meta, then the key); out needs 48 bytes
public char* formatKeys(int key, int mods, char* out) {
    int o = 0;
    if ((mods & adp.MOD_CTRL) != 0) { strcpy(&out[o], "Ctrl+"); o = o + 5; }
    if ((mods & adp.MOD_ALT) != 0) { strcpy(&out[o], "Alt+"); o = o + 4; }
    if ((mods & adp.MOD_SHIFT) != 0) { strcpy(&out[o], "Shift+"); o = o + 6; }
    if ((mods & adp.MOD_META) != 0) { strcpy(&out[o], "Meta+"); o = o + 5; }
    char nm[16];
    keyName(key, &nm[0]);
    strcpy(&out[o], &nm[0]);
    return out;
}

// =============================================================================
//  Look: the colours, the font and the preferences that the widgets share
// =============================================================================
public class Look {
    public atheme.Theme* theme;             // the theme in use (a copy that this Look owns)
    public int c[24];                       // atheme.Col -> 0xFFRRGGBB
    public int tc[24];                      // asyntax.Tok -> 0xFFRRGGBB
    public int ts[24];                      // asyntax.Tok -> atheme.STYLE_* bits
    public gfx.Font* font;                  // the font of the code (a fixed pitch cell grid)
    public int fontIndex;                   // FONT_MONO, FONT_SANS, FONT_SANS_BOLD (or 3 for a font from a file)
    public int cellW;                       // width of one column in pixels
    public int lineH;                       // height of one text line (font height + lineGap)
    public int lineGap;                     // extra pixels between lines
    public bool monoFont;                   // all glyphs have the width of a cell (else every glyph is centred in its cell)
    public int version;                     // grows with every change (colours, font, preferences)
    public int prefsVersion;                // grows when the preferences below change (editors copy them again then)
    // preferences of the editors (SettingsDialog changes them, applySettings copies them from atheme.Settings)
    public int tabWidth;
    public bool insertSpaces;
    public bool lineNumbers;
    public bool wordWrap;
    public bool autoIndent;
    public bool trimOnSave;
    public bool finalNewline;
    public bool showWhitespace;
    public bool indentGuides;
    public bool highlightLine;
    public bool highlightWord;
    public bool matchBrackets;
    public bool blink;
    public bool autoComplete;
    private gui.Widget** users;
    private func* userFn;
    private int nusers;
    private int cap;

    public Look() {
        cap = 16;
        users = (gui.Widget**) calloc(cap, 8);
        userFn = (func*) calloc(cap, 8);
        tabWidth = 4;
        insertSpaces = true;
        lineNumbers = true;
        autoIndent = true;
        highlightLine = true;
        highlightWord = true;
        matchBrackets = true;
        indentGuides = true;
        blink = true;
        autoComplete = true;
        theme = atheme.builtin("dark");
        setFontIndex(FONT_MONO);
        refresh();
    }

    // Registers a widget: f(widget) is called (or, with f == null, the widget is laid out and repainted) when the theme, the font
    // or the preferences change.
    public void use(gui.Widget* w, func f) {
        for (int i = 0; i < nusers; i++) {
            if (users[i] == w) { userFn[i] = f; return; }
        }
        if (nusers == cap) {
            cap = cap * 2;
            users = (gui.Widget**) realloc((char*) users, cap * 8);
            userFn = (func*) realloc((char*) userFn, cap * 8);
        }
        users[nusers] = w;
        userFn[nusers] = f;
        nusers++;
    }

    public void unuse(gui.Widget* w) {
        for (int i = 0; i < nusers; i++) {
            if (users[i] == w) {
                for (int j = i; j < nusers - 1; j++) {
                    users[j] = users[j + 1];
                    userFn[j] = userFn[j + 1];
                }
                nusers--;
                return;
            }
        }
    }

    public int userCount() { return nusers; }

    // the 0xFFRRGGBB colour of an atheme.Col
    public int col(int which) {
        if (which < 0 || which >= 24) { return 0xFFFF00FF; }
        return c[which];
    }

    public int tokColor(int kind) {
        if (kind < 0 || kind >= 24) { return c[atheme.Col.Foreground]; }
        return tc[kind];
    }

    public int tokStyle(int kind) {
        if (kind < 0 || kind >= 24) { return 0; }
        return ts[kind];
    }

    // reads the colours out of the theme (call it after changing look->theme directly) and tells every registered widget
    public void refresh() {
        for (int i = 0; i < 24; i++) {
            c[i] = argb(theme->colors[i]);
            tc[i] = argb(theme->tokColor[i]);
            ts[i] = theme->tokStyle[i];
        }
        version++;
        notify();
    }

    // a copy of the theme becomes the current one
    public void setTheme(atheme.Theme* t) {
        if (t == null) { return; }
        if (t != theme) { theme->copyFrom(t); }
        refresh();
    }

    // a built-in theme by name ("dark", "light", ...), else a theme file NAME.ini in the themes directory of the configuration;
    // false (and nothing changes) when there is no such theme
    public bool setThemeName(char* name) {
        atheme.Theme* t = findTheme(name);
        if (t == null) { return false; }
        setTheme(t);
        return true;
    }

    public void setFontIndex(int idx) {
        if (idx == FONT_SANS) { font = gfx.sans(); }
        else if (idx == FONT_SANS_BOLD) { font = gfx.sansBold(); }
        else { font = gfx.mono(); idx = FONT_MONO; }
        fontIndex = idx;
        measure();
    }

    // a font from a file (see gfx.loadFont); false when it cannot be read
    public bool setFontFile(char* path) {
        gfx.Font* f = gfx.loadFont(path);
        if (f == null) { return false; }
        font = f;
        fontIndex = 3;
        measure();
        return true;
    }

    // "mono", "sans", "sansbold" or the path of a font file
    public void setFontName(char* name) {
        if (streq(name, "sans")) { setFontIndex(FONT_SANS); }
        else if (streq(name, "sansbold")) { setFontIndex(FONT_SANS_BOLD); }
        else if (streq(name, "mono") || name[0] == 0) { setFontIndex(FONT_MONO); }
        else if (!setFontFile(name)) { setFontIndex(FONT_MONO); }
    }

    public void setLineGap(int g) {
        lineGap = imax(0, imin(g, 12));
        lineH = font->height + lineGap;
        version++;
        notify();
    }

    private void measure() {
        int a = font->advance('M');
        int b = font->advance('W');
        int d = font->advance('i');
        cellW = imax(a, b);
        if (cellW < 1) { cellW = 8; }
        monoFont = (a == d && b == d);
        lineH = font->height + lineGap;
        version++;
        notify();
    }

    // copies the editor settings (tab width, spaces, line numbers, wrap, auto indent, trim, final newline, font, theme)
    public void applySettings(atheme.Settings* st) {
        tabWidth = st->tabWidth;
        insertSpaces = st->insertSpaces;
        lineNumbers = st->lineNumbers;
        wordWrap = st->wordWrap;
        autoIndent = st->autoIndent;
        trimOnSave = st->trimOnSave;
        finalNewline = st->finalNewline;
        if (st->font != null) { setFontName(st->font); }
        if (st->theme != null && st->theme[0] != 0) { setThemeName(st->theme); }
        version++;
        prefsVersion++;
        notify();
    }

    // writes the preferences back into a settings object (the theme name is the name of the current theme)
    public void storeSettings(atheme.Settings* st) {
        st->tabWidth = tabWidth;
        st->insertSpaces = insertSpaces;
        st->lineNumbers = lineNumbers;
        st->wordWrap = wordWrap;
        st->autoIndent = autoIndent;
        st->trimOnSave = trimOnSave;
        st->finalNewline = finalNewline;
        asys.free(st->font);
        if (fontIndex == FONT_SANS) { st->font = asys.strDup("sans"); }
        else if (fontIndex == FONT_SANS_BOLD) { st->font = asys.strDup("sansbold"); }
        else { st->font = asys.strDup("mono"); }
        asys.free(st->theme);
        st->theme = asys.strDup(theme->name);
    }

    // tells the registered widgets that something changed
    public void notify() {
        for (int i = 0; i < nusers; i++) {
            gui.Widget* w = users[i];
            func f = userFn[i];
            if (f != null) {
                f((int) w);
            } else {
                w->relayout();
                w->invalidate();
            }
        }
    }

    // a changed preference: bump the version and notify
    public void changed() {
        version++;
        prefsVersion++;
        notify();
    }
}

// the theme with this name: a built-in one, or NAME.ini in the themes directory of the configuration (a new Theme, or null)
public atheme.Theme* findTheme(char* name) {
    atheme.Theme* t = atheme.builtin(name);
    if (t != null) { return t; }
    if (name[0] == 0 || strlen(name) > 60) { return null; }
    for (int i = 0; name[i] != 0; i++) {
        if (name[i] == '/' || name[i] == '\\' || name[i] == '.' && name[i + 1] == '.') { return null; }
    }
    char* dir = atheme.configDir();
    char file[300];
    format(&file[0], 300, "%s/themes/%s.ini", dir, name);
    asys.free(dir);
    if (!asys.exists(&file[0])) { return null; }
    atheme.Warnings w();
    t = atheme.loadTheme(&file[0], &w);
    w.dispose();
    return t;
}

Look* theLookPtr;

// the Look that widgets use when they are not given another one
public Look* theLook() {
    if (theLookPtr == null) {
        theLookPtr = new Look();
    }
    return theLookPtr;
}

// replaces the shared Look (before any widget was made)
public void setLook(Look* l) {
    theLookPtr = l;
}

// =============================================================================
//  small drawing helpers shared by the widgets
// =============================================================================
// the number of bytes of a UTF-8 sequence from its lead byte
public int utf8Len(int lead) {
    if (lead < 0xC0) { return 1; }
    if (lead < 0xE0) { return 2; }
    if (lead < 0xF0) { return 3; }
    return 4;
}

// a filled triangle pointing right (open == false) or down (open == true): for tree arrows
public void drawArrow(gfx.Surface* s, int x, int y, int size, bool open, int color) {
    int xs[3];
    int ys[3];
    if (open) {
        xs[0] = x; ys[0] = y;
        xs[1] = x + size; ys[1] = y;
        xs[2] = x + size / 2; ys[2] = y + size / 2 + 1;
    } else {
        xs[0] = x; ys[0] = y;
        xs[1] = x; ys[1] = y + size;
        xs[2] = x + size / 2 + 1; ys[2] = y + size / 2;
    }
    s->fillPolygon(&xs[0], &ys[0], 3, color);
}

// draws text cut off with "..." when it is wider than maxW; returns the x after it
public int drawClipped(gfx.Surface* s, gfx.Font* f, int x, int y, char* text, int color, int maxW) {
    int tw = gfx.textWidth(f, text);
    if (tw <= maxW) {
        return s->text(f, x, y, text, color);
    }
    int c0 = s->clipX1;
    if (x + maxW < s->clipX1) { s->clipX1 = x + maxW; }
    s->text(f, x, y, text, color);
    s->clipX1 = c0;
    return x + maxW;
}

// =============================================================================
//  a themed single line text field (a gui.TextBox that takes its colours from a Look); Esc, Up, Down, Tab and Enter can be
//  intercepted through onSpecial(box): special holds the key
// =============================================================================
public class LineEdit : gui.TextBox {
    public Look* look;
    public func onSpecial;              // int f(int box): a key the field does not use; LineEdit.special tells which one
    public int special;
    public int specialMods;

    public LineEdit() {
        super();
        look = theLook();
        look->use(this, null);
        applyLook();
    }

    public void applyLook() {
        colBack = look->col(atheme.Col.Background);
        colText = look->col(atheme.Col.Foreground);
        colSel = look->col(atheme.Col.Selection);
        colBorder = look->col(atheme.Col.Border);
        colAccent = look->col(atheme.Col.Info);
        colDim = look->col(atheme.Col.Whitespace);
    }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn != 0 && onSpecial != null) {
            bool sp = (((mods & adp.MOD_ALT) != 0 && key >= 'a' && key <= 'z') || key == adp.KEY_ESCAPE || key == adp.KEY_UP || key == adp.KEY_DOWN || key == adp.KEY_PGUP || key == adp.KEY_PGDN ||
                       (key == adp.KEY_TAB) || (key == adp.KEY_ENTER && (mods & (adp.MOD_SHIFT | adp.MOD_CTRL)) != 0));
            if (sp) {
                special = key;
                specialMods = mods;
                if (onSpecial(this) != 0) { return true; }
            }
        }
        return super.onKey(dn, key, uni, mods);
    }
}
