// =============================================================================
//  file icons drawn with gfx primitives
// =============================================================================
public const IC_FILE = 0;
public const IC_DIR = 1;
public const IC_DIR_OPEN = 2;
public const IC_LINK = 3;
public const IC_SOURCE_A = 4;
public const IC_SOURCE_C = 5;
public const IC_SCRIPT = 6;
public const IC_DATA = 7;
public const IC_TEXT = 8;
public const IC_MARKUP = 9;
public const IC_IMAGE = 10;
public const IC_ARCHIVE = 11;
public const IC_CONFIG = 12;
public const IC_BINARY = 13;
public const IC_BUILD = 14;

private bool hasExt(char* name, char* ext) {
    int n = strlen(name);
    int e = strlen(ext);
    if (e + 1 > n) { return false; }
    for (int i = 0; i < e; i++) {
        int a = name[n - e + i];
        if (a >= 'A' && a <= 'Z') { a = a + 32; }
        if (a != ext[i]) { return false; }
    }
    return name[n - e - 1] == '.';
}

// the kind of icon for a name
public int iconKindOf(char* name, int kind, bool open) {
    if (kind == asys.K_DIR) { return open ? IC_DIR_OPEN : IC_DIR; }
    if (kind == asys.K_LINK) { return IC_LINK; }
    if (streq(name, "Makefile") || streq(name, "makefile") || hasExt(name, "mk")) { return IC_BUILD; }
    if (hasExt(name, "a") || hasExt(name, "am")) { return IC_SOURCE_A; }
    if (hasExt(name, "c") || hasExt(name, "h") || hasExt(name, "cpp") || hasExt(name, "hpp") || hasExt(name, "cc") || hasExt(name, "rs") || hasExt(name, "go") || hasExt(name, "java")) { return IC_SOURCE_C; }
    if (hasExt(name, "py") || hasExt(name, "sh") || hasExt(name, "js") || hasExt(name, "ts") || hasExt(name, "rb") || hasExt(name, "pl") || hasExt(name, "lua")) { return IC_SCRIPT; }
    if (hasExt(name, "json") || hasExt(name, "csv") || hasExt(name, "yaml") || hasExt(name, "yml")) { return IC_DATA; }
    if (hasExt(name, "md") || hasExt(name, "txt") || hasExt(name, "rst")) { return IC_TEXT; }
    if (hasExt(name, "html") || hasExt(name, "htm") || hasExt(name, "xml") || hasExt(name, "css") || hasExt(name, "svg")) { return IC_MARKUP; }
    if (hasExt(name, "png") || hasExt(name, "jpg") || hasExt(name, "jpeg") || hasExt(name, "bmp") || hasExt(name, "ppm") || hasExt(name, "gif") || hasExt(name, "pgm")) { return IC_IMAGE; }
    if (hasExt(name, "zip") || hasExt(name, "tar") || hasExt(name, "gz") || hasExt(name, "tgz") || hasExt(name, "xz") || hasExt(name, "bz2")) { return IC_ARCHIVE; }
    if (hasExt(name, "ini") || hasExt(name, "toml") || hasExt(name, "conf") || hasExt(name, "cfg")) { return IC_CONFIG; }
    if (hasExt(name, "o") || hasExt(name, "ao") || hasExt(name, "bin") || hasExt(name, "exe") || hasExt(name, "elf") || hasExt(name, "img") || hasExt(name, "so") || hasExt(name, "asm")) { return IC_BINARY; }
    return IC_FILE;
}

// draws a 16 x 16 icon; page is the colour of the paper, edge the outline colour
public void drawFileIcon(gfx.Surface* s, int kind, int x, int y, int page, int edge) {
    if (kind == IC_DIR || kind == IC_DIR_OPEN) {
        int c = (kind == IC_DIR) ? 0xFFE0B040 : 0xFFF0C860;
        s->fillRoundRect(x + 1, y + 3, 6, 4, 1, c);
        s->fillRoundRect(x + 1, y + 5, 14, 9, 2, c);
        if (kind == IC_DIR_OPEN) {
            s->fillRoundRect(x + 3, y + 8, 13, 6, 2, 0xFFFFE08A);
        }
        s->hline(x + 2, y + 5, 12, 0xFFFFE9A8);
        return;
    }
    if (kind == IC_LINK) {
        s->rect(x + 3, y + 1, 10, 14, edge);
        s->fill(x + 4, y + 2, 8, 12, page);
        s->line(x + 5, y + 11, x + 11, y + 5, 0xFF4F9DE0);
        s->line(x + 6, y + 5, x + 11, y + 5, 0xFF4F9DE0);
        s->line(x + 11, y + 5, x + 11, y + 10, 0xFF4F9DE0);
        return;
    }
    // a page with a folded corner
    int xs[5];
    int ys[5];
    xs[0] = x + 3; ys[0] = y + 1;
    xs[1] = x + 10; ys[1] = y + 1;
    xs[2] = x + 13; ys[2] = y + 4;
    xs[3] = x + 13; ys[3] = y + 15;
    xs[4] = x + 3; ys[4] = y + 15;
    s->fillPolygon(&xs[0], &ys[0], 5, page);
    s->rect(x + 3, y + 1, 11, 15, edge);
    s->fill(x + 10, y + 1, 4, 1, page);
    s->line(x + 10, y + 1, x + 13, y + 4, edge);
    s->vline(x + 10, y + 1, 4, edge);
    s->hline(x + 10, y + 4, 4, edge);
    int tint = 0xFF9AA0A8;
    if (kind == IC_SOURCE_A) {
        tint = 0xFF3C78D8;
        s->fill(x + 5, y + 6, 7, 2, tint);
        s->fill(x + 5, y + 10, 2, 4, tint);
        s->fill(x + 10, y + 10, 2, 4, tint);
        s->fill(x + 5, y + 9, 7, 2, tint);
    } else if (kind == IC_SOURCE_C) {
        tint = 0xFF4E9A90;
        s->line(x + 7, y + 7, x + 5, y + 10, tint);
        s->line(x + 5, y + 10, x + 7, y + 13, tint);
        s->line(x + 10, y + 7, x + 12, y + 10, tint);
        s->line(x + 12, y + 10, x + 10, y + 13, tint);
    } else if (kind == IC_SCRIPT) {
        tint = 0xFF58A63A;
        s->fill(x + 5, y + 7, 3, 2, tint);
        s->fill(x + 5, y + 10, 6, 2, tint);
        s->fill(x + 5, y + 13, 4, 1, tint);
    } else if (kind == IC_DATA) {
        tint = 0xFFD08A20;
        s->fill(x + 6, y + 6, 1, 8, tint);
        s->fill(x + 6, y + 6, 3, 1, tint);
        s->fill(x + 6, y + 13, 3, 1, tint);
        s->fill(x + 11, y + 6, 1, 8, tint);
        s->fill(x + 9, y + 6, 3, 1, tint);
        s->fill(x + 9, y + 13, 3, 1, tint);
    } else if (kind == IC_TEXT) {
        tint = 0xFF808890;
        s->hline(x + 5, y + 7, 7, tint);
        s->hline(x + 5, y + 9, 7, tint);
        s->hline(x + 5, y + 11, 7, tint);
        s->hline(x + 5, y + 13, 4, tint);
    } else if (kind == IC_MARKUP) {
        tint = 0xFFE06A30;
        s->line(x + 8, y + 7, x + 5, y + 10, tint);
        s->line(x + 5, y + 10, x + 8, y + 13, tint);
        s->line(x + 9, y + 7, x + 12, y + 10, tint);
        s->line(x + 12, y + 10, x + 9, y + 13, tint);
    } else if (kind == IC_IMAGE) {
        tint = 0xFF9A5CC8;
        s->fill(x + 5, y + 7, 7, 7, 0xFFC8D8F0);
        int tx[3];
        int ty[3];
        tx[0] = x + 5; ty[0] = y + 14;
        tx[1] = x + 8; ty[1] = y + 9;
        tx[2] = x + 12; ty[2] = y + 14;
        s->fillPolygon(&tx[0], &ty[0], 3, tint);
        s->fillCircle(x + 10, y + 9, 1, 0xFFF0C040);
    } else if (kind == IC_ARCHIVE) {
        tint = 0xFFA06838;
        s->fill(x + 7, y + 2, 3, 13, 0xFFC89868);
        s->fill(x + 8, y + 4, 1, 2, tint);
        s->fill(x + 8, y + 8, 1, 2, tint);
        s->fill(x + 8, y + 12, 1, 2, tint);
    } else if (kind == IC_CONFIG) {
        tint = 0xFF70788A;
        s->circle(x + 8, y + 10, 3, tint);
        s->fill(x + 8, y + 6, 1, 8, tint);
        s->fill(x + 4, y + 10, 9, 1, tint);
    } else if (kind == IC_BINARY) {
        tint = 0xFF505868;
        s->fill(x + 5, y + 6, 2, 3, tint);
        s->fill(x + 9, y + 6, 1, 3, tint);
        s->fill(x + 5, y + 11, 1, 3, tint);
        s->fill(x + 8, y + 11, 3, 3, tint);
    } else if (kind == IC_BUILD) {
        tint = 0xFFB05050;
        s->fill(x + 5, y + 7, 7, 2, tint);
        s->fill(x + 7, y + 9, 3, 5, tint);
    } else {
        s->hline(x + 5, y + 8, 7, tint);
        s->hline(x + 5, y + 11, 5, tint);
    }
}

// =============================================================================
//  FileTree
// =============================================================================
public class FileTree : RowList {
    public aproject.FileTree* tree;
    public aproject.Ignore* ignore;
    public char* root;                      // the project directory
    public func onOpen;                     // int f(int tree): a file was opened (double click or Enter): openedPath
    public func onError;                    // int f(int tree): an operation failed: errorText
    public func onTreeChanged;              // int f(int tree): files were created, renamed or deleted (also found by polling)
    public char* openedPath;
    public char* errorText;
    public bool openOnSingleClick;
    public bool confirmDelete;              // ask before deleting (true)
    public int pollMs;                      // how often the directories are looked at (1500)
    public LineEdit* filterBox;
    public LineEdit* editBox;
    public int editMode;                    // 0 none, 1 renaming, 2 new file, 3 new folder
    public guix.Menu* menu;
    public int deleted;                     // how many deletions were confirmed and done (for tests)
    private aproject.TreeNode** rows;       // the visible rows; null is the place where a new name is being typed
    private int nrows;
    private int rowCap;
    private char* selRel;                   // the selected path below the root (survives refreshes)
    private char* editRel;                  // the node that is renamed / the directory that gets a new entry
    private aproject.Watcher* watcher;
    private int timer;
    private char* pendingDelete;
    private guix.MenuItem* miOpen;
    private guix.MenuItem* miRename;
    private guix.MenuItem* miDelete;

    public FileTree() {
        super();
        rowH = 22;
        headerH = 30;
        confirmDelete = true;
        pollMs = 1500;
        emptyText = "No folder open";
        selRel = asys.strDup("");
        editRel = asys.strDup("");
        openedPath = asys.strDup("");
        errorText = asys.strDup("");
        rowCap = 256;
        rows = (aproject.TreeNode**) calloc(rowCap, 8);
        filterBox = new LineEdit();
        filterBox->placeholder = "Filter files";
        filterBox->onChange = fileFilterChanged;
        filterBox->onEnter = fileFilterEnter;
        filterBox->onSpecial = fileFilterSpecial;
        filterBox->userData = (int) this;
        add(filterBox);
        editBox = new LineEdit();
        editBox->visible = false;
        editBox->onEnter = fileEditEnter;
        editBox->onSpecial = fileEditSpecial;
        editBox->userData = (int) this;
        add(editBox);
        onContext = fileTreeContext;
        buildMenu();
    }

    public virtual int prefW() { return 240; }

    public virtual void layout() {
        filterBox->x = 3;
        filterBox->y = 3;
        filterBox->w = w - 6;
        filterBox->h = 24;
    }

    // ---- the project -----------------------------------------------------------------------------------------------------------------
    // opens a directory: false when it cannot be read
    public bool setRoot(char* path) {
        if (!asys.isDir(path)) { return false; }
        if (tree != null) { tree->dispose(); }
        if (watcher != null) { watcher->dispose(); }
        ignore = new aproject.Ignore();
        ignore->addBuiltin();
        char* gi = asys.join(path, ".gitignore");
        ignore->loadFile(gi, "");
        asys.free(gi);
        tree = new aproject.FileTree(path, ignore);
        asys.free(root);
        root = asys.strDup(tree->root->path);
        tree->load(tree->root);
        watcher = new aproject.Watcher();
        watcher->watch(root);
        asys.free(selRel);
        selRel = asys.strDup("");
        selected = -1;
        top = 0;
        editMode = 0;
        editBox->visible = false;
        rebuildRows();
        emptyText = "Empty folder";
        invalidate();
        return true;
    }

    public virtual int rowCount() { return nrows; }

    public int visibleCount() { return nrows; }

    private bool nameHas(char* name, char* flt) {
        int n = strlen(name);
        int m = strlen(flt);
        for (int i = 0; i + m <= n; i++) {
            bool same = true;
            for (int k = 0; k < m; k++) {
                int a = name[i + k];
                int b = flt[k];
                if (a >= 'A' && a <= 'Z') { a = a + 32; }
                if (b >= 'A' && b <= 'Z') { b = b + 32; }
                if (a != b) { same = false; break; }
            }
            if (same) { return true; }
        }
        return false;
    }

    private void pushRow(aproject.TreeNode* n) {
        if (nrows == rowCap) {
            rowCap = rowCap * 2;
            rows = (aproject.TreeNode**) realloc((char*) rows, rowCap * 8);
        }
        rows[nrows] = n;
        nrows++;
    }

    // adds the nodes of a directory that match the filter (or have a descendant that does); true when anything was added
    private bool collect(aproject.TreeNode* dir, char* flt, int* budget) {
        bool any = false;
        if (dir->kind == asys.K_DIR && !dir->loaded && *budget > 0) {
            *budget = *budget - 1;
            tree->load(dir);
        }
        for (int i = 0; i < dir->nkids; i++) {
            aproject.TreeNode* k = dir->kids[i];
            int mark = nrows;
            bool self = nameHas(k->name, flt);
            if (k->kind == asys.K_DIR) {
                pushRow(k);
                bool sub = collect(k, flt, budget);
                if (self || sub) {
                    any = true;
                    k->expanded = true;
                } else {
                    nrows = mark;
                }
            } else if (self) {
                pushRow(k);
                any = true;
            }
        }
        return any;
    }

    private void flattenInto(aproject.TreeNode* d) {
        for (int i = 0; i < d->nkids; i++) {
            aproject.TreeNode* k = d->kids[i];
            pushRow(k);
            if (k->kind == asys.K_DIR && k->expanded && k->loaded) { flattenInto(k); }
        }
    }

    // builds the visible rows from the tree; keeps the selection (by path)
    public void rebuildRows() {
        nrows = 0;
        if (tree == null) { selected = -1; return; }
        char* flt = filterBox->text();
        if (flt[0] != 0) {
            int budget = 400;
            collect(tree->root, flt, &budget);
        } else if (editMode >= 2) {
            buildWithPlaceholder(tree->root);
        } else {
            flattenInto(tree->root);
        }
        // restore the selection
        int sel = -1;
        if (editMode >= 2) {
            for (int i = 0; i < nrows; i++) { if (rows[i] == null) { sel = i; } }
        } else if (selRel[0] != 0) {
            for (int i = 0; i < nrows; i++) {
                if (rows[i] != null && streq(rows[i]->rel, selRel)) { sel = i; break; }
            }
        }
        selected = sel;
        clampTop();
        if (sel >= 0) { ensureVisible(sel); }
        if (watcher != null) { watchOpen(tree->root); }
        invalidate();
    }

    private void buildWithPlaceholder(aproject.TreeNode* d) {
        for (int i = 0; i < d->nkids; i++) {
            aproject.TreeNode* k = d->kids[i];
            pushRow(k);
            if (k->kind == asys.K_DIR && k->expanded && k->loaded) {
                if (streq(k->rel, editRel)) { pushRow(null); }
                buildWithPlaceholder(k);
            }
        }
        if (d == tree->root && editRel[0] == 0) {
            // a new entry in the project directory itself goes to the top
            for (int i = nrows; i > 0; i--) { rows[i] = rows[i - 1]; }
            rows[0] = null;
            nrows++;
        }
    }

    // the directories that are open are watched (idempotent: a path that is watched already is skipped)
    private void watchOpen(aproject.TreeNode* d) {
        if (d->kind != asys.K_DIR || !d->expanded || !d->loaded) { return; }
        watcher->watch(d->path);
        for (int i = 0; i < d->nkids; i++) { watchOpen(d->kids[i]); }
    }

    // remembers the selected path: call before the tree is changed
    private void captureSelection() {
        if (selected >= 0 && selected < nrows && rows[selected] != null) {
            asys.free(selRel);
            selRel = asys.strDup(rows[selected]->rel);
        }
    }

    public aproject.TreeNode* nodeAt(int i) {
        if (i < 0 || i >= nrows) { return null; }
        return rows[i];
    }

    public char* nameAt(int i) {
        aproject.TreeNode* n = nodeAt(i);
        return (n == null) ? "" : n->name;
    }

    public int depthAt(int i) {
        aproject.TreeNode* n = nodeAt(i);
        return (n == null) ? 0 : n->depth;
    }

    public bool isDirAt(int i) {
        aproject.TreeNode* n = nodeAt(i);
        return n != null && n->kind == asys.K_DIR;
    }

    public bool isExpandedAt(int i) {
        aproject.TreeNode* n = nodeAt(i);
        return n != null && n->kind == asys.K_DIR && n->expanded;
    }

    public int indexOfPath(char* rel) {
        for (int i = 0; i < nrows; i++) {
            if (rows[i] != null && streq(rows[i]->rel, rel)) { return i; }
        }
        return -1;
    }

    // the full path of the selected entry ("" when nothing is selected)
    public char* selectedPath() {
        aproject.TreeNode* n = nodeAt(selected);
        return (n == null) ? "" : n->path;
    }

    public char* selectedRel() {
        aproject.TreeNode* n = nodeAt(selected);
        return (n == null) ? "" : n->rel;
    }

    // ---- opening and closing directories -------------------------------------------------------------------------------------------------
    public void toggle(int i) {
        aproject.TreeNode* n = nodeAt(i);
        if (n == null || n->kind != asys.K_DIR) { return; }
        captureSelection();
        if (n->expanded) {
            tree->collapse(n);
            watcher->unwatch(n->path);
        } else {
            tree->expand(n);
            watcher->watch(n->path);
        }
        rebuildRows();
    }

    public void expandRow(int i) {
        aproject.TreeNode* n = nodeAt(i);
        if (n != null && n->kind == asys.K_DIR && !n->expanded) { toggle(i); }
    }

    public void collapseAll() {
        if (tree == null) { return; }
        captureSelection();
        for (int i = 0; i < nrows; i++) {
            if (rows[i] != null && rows[i]->kind == asys.K_DIR && rows[i]->expanded) {
                watcher->unwatch(rows[i]->path);
                rows[i]->expanded = false;
            }
        }
        rebuildRows();
    }

    // opens the folders above a path (below the root) and selects it; false when it is not in the tree
    public bool revealRel(char* rel) {
        if (tree == null) { return false; }
        int len = strlen(rel);
        int s = 0;
        aproject.TreeNode* cur = tree->root;
        char* part = asys.alloc(len + 2);
        int plen = 0;
        for (int i = 0; i <= len; i++) {
            if (i == len || rel[i] == '/') {
                if (plen > 0) {
                    part[plen] = 0;
                    tree->load(cur);
                    aproject.TreeNode* next = null;
                    for (int k = 0; k < cur->nkids; k++) {
                        if (streq(cur->kids[k]->name, part)) { next = cur->kids[k]; break; }
                    }
                    if (next == null) { asys.free(part); return false; }
                    if (next->kind == asys.K_DIR && i < len) {
                        if (!next->expanded) { tree->expand(next); watcher->watch(next->path); }
                    }
                    cur = next;
                    plen = 0;
                }
            } else {
                part[plen] = rel[i];
                plen++;
            }
        }
        asys.free(part);
        asys.free(selRel);
        selRel = asys.strDup(cur->rel);
        rebuildRows();
        return indexOfPath(rel) >= 0;
    }

    // ---- painting -----------------------------------------------------------------------------------------------------------------------
    public virtual void paintItem(gfx.Surface* s, int x, int y, int rw, int i, bool sel) {
        aproject.TreeNode* n = rows[i];
        int bg = look->col(bgCol);
        gfx.Font* f = gfx.sans();
        if (n == null) {
            int d = 1;
            aproject.TreeNode* pe = (editRel[0] == 0) ? null : tree->find(editRel);
            if (pe != null) { d = pe->depth + 1; }
            drawFileIcon(s, (editMode == 3) ? IC_DIR : IC_FILE, x + 6 + (d - 1) * 14 + 16, y + 3, 0xFFDDE1E6, 0xFF7A808A);
            return;
        }
        int ind = 6 + (n->depth - 1) * 14;
        if (n->kind == asys.K_DIR) {
            drawArrow(s, x + ind + 2, y + 6, 8, n->expanded, look->col(atheme.Col.SidebarText));
        }
        int kindIcon = iconKindOf(n->name, n->kind, n->expanded);
        drawFileIcon(s, kindIcon, x + ind + 14, y + 3, 0xFFDDE1E6, 0xFF7A808A);
        int tx = x + ind + 34;
        int fg = look->col(fgCol);
        if (n->loop) { fg = look->col(atheme.Col.Whitespace); }
        if (editMode == 1 && sel) { return; }
        drawClipped(s, f, tx, y + (rowH - f->height) / 2, n->name, fg, x + rw - tx - 4);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        if (timer == 0 && win != null && tree != null) {
            timer = win->display->after(pollMs, fileTreePollTick, (int) this);
        }
        super.paint(s, ox, oy);
        s->fill(ox, oy, w, headerH, look->col(bgCol));
        s->hline(ox, oy + headerH - 1, w, look->col(atheme.Col.Border));
        placeEditBox();
    }

    // puts the name field over the row that is being edited
    private void placeEditBox() {
        if (editMode == 0) { return; }
        int row = selected;
        if (row < 0 || row >= nrows || row < top || row >= top + visibleRows()) {
            editBox->visible = false;
            return;
        }
        int d = 1;
        if (rows[row] != null) { d = rows[row]->depth; }
        else {
            aproject.TreeNode* pe = (editRel[0] == 0) ? null : tree->find(editRel);
            if (pe != null) { d = pe->depth + 1; }
        }
        int tx = 6 + (d - 1) * 14 + 32;
        editBox->x = tx;
        editBox->y = headerH + (row - top) * rowH + 1;
        editBox->w = w - tx - 12;
        editBox->h = rowH - 2;
        editBox->visible = true;
    }

    // ---- mouse and keys ---------------------------------------------------------------------------------------------------------------------
    public virtual void clicked(int i, int button, int mx, int mods, bool dbl) {
        if (editMode != 0) { cancelEdit(); }
        aproject.TreeNode* n = nodeAt(i);
        if (n == null) { return; }
        int ind = 6 + (n->depth - 1) * 14;
        if (button == 1 && n->kind == asys.K_DIR && mx >= ind - 2 && mx < ind + 14) {
            select(i);
            toggle(i);
            return;
        }
        select(i);
        if (dbl || (openOnSingleClick && n->kind != asys.K_DIR)) { activate(i); }
    }

    public virtual void activate(int i) {
        aproject.TreeNode* n = nodeAt(i);
        if (n == null) { return; }
        if (n->kind == asys.K_DIR) {
            toggle(i);
            return;
        }
        asys.free(openedPath);
        openedPath = asys.strDup(n->path);
        if (onOpen != null) { onOpen(this); }
    }

    public virtual bool listKey(int key, int uni, int mods) {
        if ((mods & (adp.MOD_CTRL | adp.MOD_ALT)) != 0) { return false; }
        aproject.TreeNode* n = nodeAt(selected);
        if (key == adp.KEY_RIGHT && n != null && n->kind == asys.K_DIR) {
            if (!n->expanded) { toggle(selected); }
            else if (n->nkids > 0) { select(selected + 1); }
            return true;
        }
        if (key == adp.KEY_LEFT && n != null) {
            if (n->kind == asys.K_DIR && n->expanded) { toggle(selected); return true; }
            if (n->parent != null && n->parent != tree->root) {
                int pi = indexOfPath(n->parent->rel);
                if (pi >= 0) { select(pi); }
            }
            return true;
        }
        if (key == adp.KEY_F1 + 1) { startRename(); return true; }
        if (key == adp.KEY_DELETE) { requestDelete(); return true; }
        if (key == adp.KEY_F1 + 4) { refreshAll(); return true; }
        if (key == adp.KEY_ESCAPE && editMode != 0) { cancelEdit(); return true; }
        if (uni >= 'A' && uni <= 'z' && (mods & adp.MOD_SHIFT) == 0 && nrows > 0) {
            // type ahead: the next row whose name starts with the letter
            int c = uni;
            if (c >= 'A' && c <= 'Z') { c = c + 32; }
            for (int k = 1; k <= nrows; k++) {
                int idx = (selected + k) % nrows;
                if (rows[idx] != null) {
                    int f0 = rows[idx]->name[0];
                    if (f0 >= 'A' && f0 <= 'Z') { f0 = f0 + 32; }
                    if (f0 == c) { select(idx); return true; }
                }
            }
        }
        return false;
    }

    // ---- changing files ------------------------------------------------------------------------------------------------------------------
    private void fail(int code) {
        asys.free(errorText);
        errorText = asys.strDup(asys.errText(code));
        if (onError != null) { onError(this); }
    }

    private void changed() {
        if (onTreeChanged != null) { onTreeChanged(this); }
    }

    // opens the name field on the selected entry
    public void startRename() {
        aproject.TreeNode* n = nodeAt(selected);
        if (n == null || n->parent == null) { return; }
        editMode = 1;
        asys.free(editRel);
        editRel = asys.strDup(n->rel);
        editBox->setText(n->name);
        editBox->selectAll();
        placeEditBox();
        invalidate();
        editBox->focusMe();
    }

    // makes room for a new file (or folder) in the selected directory (or the directory of the selected file)
    public void startNew(bool folder) {
        if (tree == null) { return; }
        aproject.TreeNode* n = nodeAt(selected);
        aproject.TreeNode* dir = tree->root;
        if (n != null) { dir = (n->kind == asys.K_DIR) ? n : n->parent; }
        captureSelection();
        if (dir != tree->root && !dir->expanded) {
            tree->expand(dir);
            watcher->watch(dir->path);
        }
        editMode = folder ? 3 : 2;
        asys.free(editRel);
        editRel = asys.strDup(dir->rel);
        editBox->setText("");
        rebuildRows();
        placeEditBox();
        invalidate();
        editBox->focusMe();
    }

    public void cancelEdit() {
        if (editMode == 0) { return; }
        editMode = 0;
        editBox->visible = false;
        rebuildRows();
        focusMe();
    }

    // the Enter key in the name field
    public void commitEdit() {
        if (editMode == 0) { return; }
        char* name = asys.strDup(editBox->text());
        int mode = editMode;
        char* rel = asys.strDup(editRel);
        editMode = 0;
        editBox->visible = false;
        captureSelection();
        int r = 0;
        char* newRel = null;
        if (mode == 1) {
            aproject.TreeNode* n = tree->find(rel);
            if (n != null) {
                if (!streq(n->name, name)) {
                    r = tree->rename(n, name);
                    if (r == 0) {
                        newRel = (n->parent == null || n->parent->rel[0] == 0) ? asys.strDup(name) : joinRel(n->parent->rel, name);
                    }
                }
            }
        } else {
            aproject.TreeNode* d = (rel[0] == 0) ? tree->root : tree->find(rel);
            if (d != null) {
                r = tree->create(d, name, mode == 3);
                if (r == 0) { newRel = (d->rel[0] == 0) ? asys.strDup(name) : joinRel(d->rel, name); }
            }
        }
        if (r < 0) {
            fail(r);
        } else if (newRel != null) {
            asys.free(selRel);
            selRel = newRel;
            changed();
        }
        asys.free(name);
        asys.free(rel);
        rebuildRows();
        focusMe();
    }

    private char* joinRel(char* a, char* b) {
        int la = strlen(a);
        int lb = strlen(b);
        char* r = asys.alloc(la + lb + 2);
        memcpy(r, a, la);
        r[la] = '/';
        memcpy(&r[la + 1], b, lb);
        r[la + lb + 1] = 0;
        return r;
    }

    // deletes the selected file or (empty) folder, after asking when confirmDelete is set
    public void requestDelete() {
        aproject.TreeNode* n = nodeAt(selected);
        if (n == null || n->parent == null) { return; }
        asys.free(pendingDelete);
        pendingDelete = asys.strDup(n->rel);
        if (!confirmDelete || win == null) {
            doDelete();
            return;
        }
        char msg[300];
        format(&msg[0], 300, "Delete \"%s\"?", n->name);
        guix.confirmArg(win->display, "Delete", &msg[0], fileDeleteAnswer, (int) this);
    }

    public void doDelete() {
        if (pendingDelete == null || tree == null) { return; }
        aproject.TreeNode* n = tree->find(pendingDelete);
        asys.free(pendingDelete);
        pendingDelete = null;
        if (n == null || n->parent == null) { return; }
        captureSelection();
        char* parentRel = asys.strDup(n->parent->rel);
        int r = tree->remove(n);
        if (r < 0) {
            fail(r);
        } else {
            deleted++;
            asys.free(selRel);
            selRel = parentRel;
            changed();
        }
        rebuildRows();
        if (selected < 0 && nrows > 0) { selected = 0; }
        invalidate();
    }

    // reads every open directory again
    public void refreshAll() {
        if (tree == null) { return; }
        captureSelection();
        tree->refresh(tree->root);
        rebuildRows();
    }

    // Looks at the open directories (the timer does this every pollMs). True when something changed on disk.
    public bool pollNow() {
        if (tree == null || watcher == null) { return false; }
        aproject.WatchEvent ev[64];
        int n = watcher->poll(&ev[0], 64);
        bool structural = false;
        for (int i = 0; i < n; i++) {
            if (ev[i].kind != aproject.WATCH_MODIFIED) { structural = true; }
        }
        if (structural) {
            refreshAll();
            changed();
        }
        return structural;
    }

    public void pollTick() {
        timer = 0;
        pollNow();
        invalidate();
    }

    // ---- the context menu ---------------------------------------------------------------------------------------------------------------------
    private void buildMenu() {
        menu = new guix.Menu();
        miOpen = menu->add("Open", fmOpen);
        menu->addSeparator();
        menu->add("New File", fmNewFile);
        menu->add("New Folder", fmNewFolder);
        miRename = menu->add("Rename", fmRename)->accel("F2");
        miDelete = menu->add("Delete", fmDelete)->accel("Del");
        menu->addSeparator();
        menu->add("Refresh", fmRefresh)->accel("F5");
        menu->add("Collapse All", fmCollapse);
        menu->add("Copy Path", fmCopyPath);
        for (int i = 0; i < menu->count; i++) { menu->items[i]->userData = (int) this; }
    }

    public void showContextMenu() {
        if (win == null || tree == null) { return; }
        int my = win->lastMouseY - absY();
        int row = rowAtY(my);
        if (row >= 0) { select(row); }
        aproject.TreeNode* n = nodeAt(selected);
        miOpen->enabled = n != null;
        miRename->enabled = n != null && n->parent != null;
        miDelete->enabled = n != null && n->parent != null;
        menu->popup(win, win->lastMouseX, win->lastMouseY);
    }

    public void copyPath() {
        if (win != null && selectedPath()[0] != 0) { win->display->setClipboard(selectedPath()); }
    }
}

int fileTreeContext(int self) {
    FileTree* t = (FileTree*) self;
    t->showContextMenu();
    return 0;
}

int fileTreePollTick(int self) {
    FileTree* t = (FileTree*) self;
    t->pollTick();
    return 0;
}

int fileFilterChanged(int box) {
    LineEdit* e = (LineEdit*) box;
    FileTree* t = (FileTree*) e->userData;
    t->rebuildRows();
    return 0;
}

int fileFilterEnter(int box) {
    LineEdit* e = (LineEdit*) box;
    FileTree* t = (FileTree*) e->userData;
    t->activate(t->selected);
    return 0;
}

int fileFilterSpecial(int box) {
    LineEdit* e = (LineEdit*) box;
    FileTree* t = (FileTree*) e->userData;
    if (e->special == adp.KEY_DOWN) { t->select(t->selected + 1); return 1; }
    if (e->special == adp.KEY_UP) { t->select(t->selected - 1); return 1; }
    if (e->special == adp.KEY_ENTER) { t->activate(t->selected); return 1; }
    if (e->special == adp.KEY_ESCAPE) { e->setText(""); t->rebuildRows(); t->focusMe(); return 1; }
    return 0;
}

int fileEditEnter(int box) {
    LineEdit* e = (LineEdit*) box;
    FileTree* t = (FileTree*) e->userData;
    t->commitEdit();
    return 0;
}

int fileEditSpecial(int box) {
    LineEdit* e = (LineEdit*) box;
    FileTree* t = (FileTree*) e->userData;
    if (e->special == adp.KEY_ESCAPE) { t->cancelEdit(); return 1; }
    return 0;
}

int fileDeleteAnswer(int yes) {
    FileTree* t = (FileTree*) guix.dialogArg;
    if (yes != 0) { t->doDelete(); }
    return 0;
}

FileTree* menuTree(int item) {
    guix.MenuItem* it = (guix.MenuItem*) item;
    return (FileTree*) it->userData;
}

int fmOpen(int item) { FileTree* t = menuTree(item); t->activate(t->selected); return 0; }
int fmNewFile(int item) { menuTree(item)->startNew(false); return 0; }
int fmNewFolder(int item) { menuTree(item)->startNew(true); return 0; }
int fmRename(int item) { menuTree(item)->startRename(); return 0; }
int fmDelete(int item) { menuTree(item)->requestDelete(); return 0; }
int fmRefresh(int item) { menuTree(item)->refreshAll(); return 0; }
int fmCollapse(int item) { menuTree(item)->collapseAll(); return 0; }
int fmCopyPath(int item) { menuTree(item)->copyPath(); return 0; }

// =============================================================================
//  OutputView: lines of text with ANSI colours (the build output)
// =============================================================================
public struct OutRun {
    int start;                  // byte offset in the line
    int color;                  // 0 default, 0x1000 + n (n = 1..7: ANSI colour 30 + n, 8..15 bright), or 0xFFRRGGBB
    int bold;
}

public class OutLine {
    public char* text;
    public OutRun* runs;
    public int nruns;
    public int sev;             // -1: not a diagnostic, else SEV_*
}

public class OutputView : RowList {
    public func onJump;         // int f(int view): a line with file:line was activated; jumpPath / jumpLine / jumpCol
    public char* jumpPath;
    public int jumpLine;
    public int jumpCol;
    public int maxLines;
    public bool follow;         // stay at the end while text arrives
    private OutLine** lines;
    private int nlines;
    private int cap;
    // the parser
    private char* pend;         // the line that is being received
    private int pendLen;
    private int pendCap;
    private OutRun* pendRuns;
    private int pendNRuns;
    private int pendRunCap;
    private int curColor;
    private int curBold;
    private int escState;       // 0 text, 1 after ESC, 2 inside a CSI sequence
    private char esc[48];
    private int escLen;

    public OutputView() {
        super();
        bgCol = atheme.Col.Background;
        fgCol = atheme.Col.Foreground;
        rowH = 18;
        maxLines = 5000;
        follow = true;
        emptyText = "";
        cap = 256;
        lines = (OutLine**) calloc(cap, 8);
        pendCap = 256;
        pend = (char*) malloc(pendCap);
        pendRunCap = 16;
        pendRuns = (OutRun*) malloc(pendRunCap * sizeof(OutRun));
        jumpPath = asys.strDup("");
    }

    public virtual int rowCount() { return nlines; }
    public int lineCount() { return nlines; }
    public char* lineText(int i) { return (i >= 0 && i < nlines) ? lines[i]->text : ""; }
    public int lineSeverity(int i) { return (i >= 0 && i < nlines) ? lines[i]->sev : -1; }

    public void clear() {
        for (int i = 0; i < nlines; i++) {
            asys.free(lines[i]->text);
            free((char*) lines[i]->runs);
        }
        nlines = 0;
        pendLen = 0;
        pendNRuns = 0;
        escState = 0;
        curColor = 0;
        curBold = 0;
        selected = -1;
        top = 0;
        invalidate();
    }

    private void addRun(int start) {
        if (pendNRuns > 0 && pendRuns[pendNRuns - 1].start == start) {
            pendNRuns--;
        }
        if (pendNRuns == pendRunCap) {
            pendRunCap = pendRunCap * 2;
            pendRuns = (OutRun*) realloc((char*) pendRuns, pendRunCap * sizeof(OutRun));
        }
        pendRuns[pendNRuns].start = start;
        pendRuns[pendNRuns].color = curColor;
        pendRuns[pendNRuns].bold = curBold;
        pendNRuns++;
    }

    private void sgr(char* params) {
        // params is "0;31" and so on
        int vals[16];
        int n = 0;
        int v = 0;
        bool have = false;
        for (int i = 0; ; i++) {
            int c = params[i];
            if (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); have = true; }
            else if (c == ';' || c == 0) {
                if (n < 16) { vals[n] = have ? v : 0; n++; }
                v = 0;
                have = false;
                if (c == 0) { break; }
            }
        }
        for (int i = 0; i < n; i++) {
            int p = vals[i];
            if (p == 0) { curColor = 0; curBold = 0; }
            else if (p == 1) { curBold = 1; }
            else if (p == 22) { curBold = 0; }
            else if (p >= 30 && p <= 37) { curColor = 0x1000 + (p - 30); }
            else if (p >= 90 && p <= 97) { curColor = 0x1000 + (p - 90) + 8; }
            else if (p == 39) { curColor = 0; }
            else if (p == 38 && i + 2 < n && vals[i + 1] == 5) {
                int idx = vals[i + 2];
                curColor = 0xFF000000 | gterm.paletteColor(idx & 255);
                i = i + 2;
            } else if (p == 38 && i + 4 < n && vals[i + 1] == 2) {
                curColor = 0xFF000000 | ((vals[i + 2] & 255) << 16) | ((vals[i + 3] & 255) << 8) | (vals[i + 4] & 255);
                i = i + 4;
            }
        }
        addRun(pendLen);
    }

    private void endLine() {
        pend[pendLen] = 0;
        OutLine* ln = new OutLine();
        ln->text = asys.strDupN(pend, pendLen);
        ln->nruns = pendNRuns;
        ln->runs = (OutRun*) malloc((pendNRuns + 1) * sizeof(OutRun));
        for (int i = 0; i < pendNRuns; i++) { ln->runs[i] = pendRuns[i]; }
        ln->sev = -1;
        aproject.Problem p;
        if (aproject.parseDiagnostic(pend, pendLen, &p)) {
            ln->sev = p.severity;
            asys.free(p.path);
            asys.free(p.message);
        }
        bool atEnd = (top + visibleRows() >= nlines);
        if (nlines == cap) {
            cap = cap * 2;
            lines = (OutLine**) realloc((char*) lines, cap * 8);
        }
        lines[nlines] = ln;
        nlines++;
        if (nlines > maxLines) {
            int drop = nlines - maxLines + maxLines / 10;
            for (int i = 0; i < drop; i++) {
                asys.free(lines[i]->text);
                free((char*) lines[i]->runs);
            }
            for (int i = drop; i < nlines; i++) { lines[i - drop] = lines[i]; }
            nlines = nlines - drop;
            top = top - drop;
            if (top < 0) { top = 0; }
            selected = selected - drop;
            if (selected < -1) { selected = -1; }
        }
        pendLen = 0;
        pendNRuns = 0;
        if (curColor != 0 || curBold != 0) { addRun(0); }
        if (follow && atEnd) {
            top = nlines;
            clampTop();
        }
    }

    // Adds text (any amount; a line that is not finished waits for its end). ANSI colour sequences are understood.
    public void append(char* text) {
        appendBytes(text, strlen(text));
    }

    public void appendBytes(char* text, int n) {
        for (int i = 0; i < n; i++) {
            int c = text[i] & 255;
            if (escState == 1) {
                if (c == '[') { escState = 2; escLen = 0; }
                else { escState = 0; }
                continue;
            }
            if (escState == 2) {
                if ((c >= '0' && c <= '9') || c == ';' || c == '?') {
                    if (escLen < 40) { esc[escLen] = c; escLen++; }
                } else {
                    esc[escLen] = 0;
                    if (c == 'm') { sgr(&esc[0]); }
                    escState = 0;
                }
                continue;
            }
            if (c == 27) { escState = 1; continue; }
            if (c == 10) { endLine(); continue; }
            if (c == 13) {
                if (i + 1 < n && text[i + 1] == 10) { continue; }
                pendLen = 0;                        // a carriage return alone: the line is written over
                pendNRuns = 0;
                continue;
            }
            if (pendLen + 10 >= pendCap) {
                pendCap = pendCap * 2;
                pend = (char*) realloc(pend, pendCap);
            }
            if (c == 9) {
                int sp = 8 - (pendLen % 8);
                for (int k = 0; k < sp; k++) { pend[pendLen] = ' '; pendLen++; }
                continue;
            }
            if (c < 32 && c != 0) { continue; }
            if (c == 0) { continue; }
            if (pendNRuns == 0 && (curColor != 0 || curBold != 0)) { addRun(pendLen); }
            pend[pendLen] = c;
            pendLen++;
        }
        invalidate();
    }

    private int ansiColor(int code) {
        if (code == 0) { return look->col(fgCol); }
        if ((code & 0xFF000000) != 0) { return code; }
        int idx = code - 0x1000;
        int n = idx & 7;
        if (n == 1) { return look->col(atheme.Col.Error); }
        if (n == 2) { return look->tc[asyntax.Tok.String]; }
        if (n == 3) { return look->col(atheme.Col.Warning); }
        if (n == 4) { return look->col(atheme.Col.Info); }
        if (n == 5) { return look->tc[asyntax.Tok.Preproc]; }
        if (n == 6) { return look->tc[asyntax.Tok.Type]; }
        if (n == 7 && idx < 8) { return look->col(fgCol); }
        if (n == 0) { return look->col(atheme.Col.LineNumber); }
        return look->col(fgCol);
    }

    public virtual void paintItem(gfx.Surface* s, int x, int y, int rw, int i, bool sel) {
        OutLine* ln = lines[i];
        gfx.Font* f = gfx.mono();
        int cw = f->advance('M');
        int maxChars = rw / cw + 2;
        int n = strlen(ln->text);
        if (n > maxChars) { n = maxChars; }
        int ty = y + (rowH - f->height) / 2;
        int base = look->col(fgCol);
        if (ln->sev == SEV_ERROR) { base = look->col(atheme.Col.Error); }
        else if (ln->sev == SEV_WARNING) { base = look->col(atheme.Col.Warning); }
        else if (ln->sev == SEV_NOTE) { base = look->col(atheme.Col.Info); }
        char seg[600];
        int pos = 0;
        int ri = 0;
        // runs: the colour in force at the start of the line is the default unless the first run starts at 0
        int color = 0;
        int bold = 0;
        int segStart = 0;
        while (segStart < n) {
            int segEnd = n;
            // the run that is active at segStart
            while (ri < ln->nruns && ln->runs[ri].start <= segStart) {
                color = ln->runs[ri].color;
                bold = ln->runs[ri].bold;
                ri++;
            }
            if (ri < ln->nruns && ln->runs[ri].start < segEnd) { segEnd = ln->runs[ri].start; }
            int len = segEnd - segStart;
            if (len > 590) { len = 590; }
            memcpy(&seg[0], &ln->text[segStart], len);
            seg[len] = 0;
            int c = (color == 0) ? base : ansiColor(color);
            int px = x + 8 + segStart * cw;
            s->text(f, px, ty, &seg[0], c);
            if (bold != 0) { s->text(f, px + 1, ty, &seg[0], c); }
            segStart = segEnd;
            if (len == 0) { break; }
        }
    }

    // the diagnostic in a line (file:line:col: error: message) as a jump target; false when the line is not one
    public bool jumpFor(int i) {
        if (i < 0 || i >= nlines) { return false; }
        aproject.Problem p;
        char* t = lines[i]->text;
        if (!aproject.parseDiagnostic(t, strlen(t), &p)) { return false; }
        asys.free(jumpPath);
        jumpPath = p.path;
        jumpLine = p.line;
        jumpCol = p.col;
        asys.free(p.message);
        return true;
    }

    public virtual void activate(int i) {
        if (jumpFor(i) && onJump != null) { onJump(this); }
    }

    public virtual bool listKey(int key, int uni, int mods) {
        if ((mods & adp.MOD_CTRL) != 0 && key == 'c' && selected >= 0) {
            if (win != null) { win->display->setClipboard(lines[selected]->text); }
            return true;
        }
        return false;
    }

    // all the text (a new asys string)
    public char* allText() {
        int total = 0;
        for (int i = 0; i < nlines; i++) { total = total + strlen(lines[i]->text) + 1; }
        char* r = asys.alloc(total + 1);
        int o = 0;
        for (int i = 0; i < nlines; i++) {
            int l = strlen(lines[i]->text);
            memcpy(&r[o], lines[i]->text, l);
            o = o + l;
            r[o] = 10;
            o++;
        }
        r[o] = 0;
        return r;
    }
}

// =============================================================================
//  ProblemsView: the list of problems; a click jumps to the place
// =============================================================================
public class ProblemsView : RowList {
    public func onJump;         // int f(int view): jumpPath / jumpLine (1 based) / jumpCol (1 based, 0 unknown)
    public char* jumpPath;
    public int jumpLine;
    public int jumpCol;
    private aproject.Problem* items;
    private int count;
    private int cap;

    public ProblemsView() {
        super();
        bgCol = atheme.Col.Background;
        fgCol = atheme.Col.Foreground;
        rowH = 22;
        emptyText = "No problems";
        jumpPath = asys.strDup("");
    }

    public virtual int rowCount() { return count; }
    public int problemCount() { return count; }

    public void clear() {
        for (int i = 0; i < count; i++) {
            asys.free(items[i].path);
            asys.free(items[i].message);
        }
        count = 0;
        selected = -1;
        top = 0;
        invalidate();
    }

    public void add(char* path, int line, int col, int severity, char* message) {
        if (count == cap) {
            cap = (cap == 0) ? 32 : cap * 2;
            items = (aproject.Problem*) realloc((char*) items, cap * sizeof(aproject.Problem));
        }
        items[count].path = asys.strDup(path);
        items[count].line = line;
        items[count].col = col;
        items[count].severity = severity;
        items[count].message = asys.strDup(message);
        count++;
        invalidate();
    }

    public int countOf(int severity) {
        int n = 0;
        for (int i = 0; i < count; i++) { if (items[i].severity == severity) { n++; } }
        return n;
    }

    public char* messageAt(int i) { return (i >= 0 && i < count) ? items[i].message : ""; }
    public char* pathAt(int i) { return (i >= 0 && i < count) ? items[i].path : ""; }
    public int lineAt(int i) { return (i >= 0 && i < count) ? items[i].line : 0; }
    public int severityAt(int i) { return (i >= 0 && i < count) ? items[i].severity : -1; }

    public virtual void paintItem(gfx.Surface* s, int x, int y, int rw, int i, bool sel) {
        aproject.Problem* p = &items[i];
        int c = look->col(atheme.Col.Info);
        if (p->severity == SEV_ERROR) { c = look->col(atheme.Col.Error); }
        else if (p->severity == SEV_WARNING) { c = look->col(atheme.Col.Warning); }
        int cy = y + rowH / 2;
        if (p->severity == SEV_ERROR) {
            s->fillCircle(x + 14, cy, 5, c);
            s->line(x + 12, cy - 2, x + 16, cy + 2, 0xFFFFFFFF);
            s->line(x + 12, cy + 2, x + 16, cy - 2, 0xFFFFFFFF);
        } else if (p->severity == SEV_WARNING) {
            int xs[3];
            int ys[3];
            xs[0] = x + 14; ys[0] = cy - 5;
            xs[1] = x + 20; ys[1] = cy + 5;
            xs[2] = x + 8; ys[2] = cy + 5;
            s->fillPolygon(&xs[0], &ys[0], 3, c);
            s->fill(x + 14, cy - 2, 1, 4, 0xFF202020);
        } else {
            s->fillCircle(x + 14, cy, 5, c);
            s->fill(x + 14, cy - 1, 1, 4, 0xFFFFFFFF);
            s->fill(x + 14, cy - 3, 1, 1, 0xFFFFFFFF);
        }
        gfx.Font* f = gfx.sans();
        char where[300];
        format(&where[0], 300, "%s:%d", baseName(p->path), p->line);
        int ww = gfx.textWidth(f, &where[0]);
        s->text(f, x + rw - ww - 10, y + (rowH - f->height) / 2, &where[0], look->col(atheme.Col.Whitespace));
        drawClipped(s, f, x + 30, y + (rowH - f->height) / 2, p->message, look->col(fgCol), rw - 30 - ww - 22);
    }

    public virtual void activate(int i) {
        if (i < 0 || i >= count) { return; }
        asys.free(jumpPath);
        jumpPath = asys.strDup(items[i].path);
        jumpLine = items[i].line;
        jumpCol = items[i].col;
        if (onJump != null) { onJump(this); }
    }

    public virtual void clicked(int i, int button, int mx, int mods, bool dbl) {
        select(i);
        activate(i);
    }
}

// =============================================================================
//  OutputPane: the header with the tabs "Output" and "Problems", the two views and a running build
// =============================================================================
public class OutputPane : BarBox {
    public OutputView* output;
    public ProblemsView* problems;
    public func onJump;                     // int f(int pane): jumpPath / jumpLine (1 based) / jumpCol
    public func onFinished;                 // int f(int pane): the job ended (exitCode)
    public char* jumpPath;
    public int jumpLine;
    public int jumpCol;
    public int exitCode;
    public bool jobRunning;
    public FlatButton* bOut;
    public FlatButton* bProb;
    public FlatButton* bStop;
    public FlatButton* bClear;
    public BarLabel* status;
    private aproject.Job* job;
    private aproject.BuildJob* build;
    private int synced;
    private int timer;

    public OutputPane() {
        super(true, 0, 0);
        flex = 1;
        bgCol = atheme.Col.Background;
        jumpPath = asys.strDup("");
        BarBox* head = new BarBox(false, 4, 3);
        head->lineTop = true;
        head->lineBottom = true;
        bOut = new FlatButton("Output");
        bOut->toggle = true;
        bOut->checked = true;
        bOut->onClick = paneTab;
        bOut->userData = (int) this;
        bProb = new FlatButton("Problems");
        bProb->toggle = true;
        bProb->onClick = paneTab;
        bProb->userData = (int) this;
        head->add(bOut);
        head->add(bProb);
        status = new BarLabel("");
        status->flex = 1;
        head->add(status);
        bStop = new FlatButton("Stop");
        bStop->onClick = paneStop;
        bStop->userData = (int) this;
        bStop->enabled = false;
        bClear = new FlatButton("Clear");
        bClear->onClick = paneClear;
        bClear->userData = (int) this;
        head->add(bStop);
        head->add(bClear);
        add(head);
        output = new OutputView();
        output->onJump = paneJumpFromOutput;
        output->userData = (int) this;
        problems = new ProblemsView();
        problems->onJump = paneJumpFromProblems;
        problems->userData = (int) this;
        problems->visible = false;
        add(output);
        add(problems);
    }

    public virtual int prefH() { return 200; }

    public void showOutput() {
        bOut->checked = true;
        bProb->checked = false;
        output->visible = true;
        problems->visible = false;
        relayout();
        if (win != null) { win->invalidateAll(); }
    }

    public void showProblems() {
        bOut->checked = false;
        bProb->checked = true;
        output->visible = false;
        problems->visible = true;
        relayout();
        if (win != null) { win->invalidateAll(); }
    }

    public bool problemsShown() { return problems->visible; }

    public void clear() {
        output->clear();
        problems->clear();
        updateStatus();
    }

    public void append(char* text) { output->append(text); }
    public void appendLine(char* text) { output->append(text); output->append("\n"); }

    public void addProblem(char* path, int line, int col, int severity, char* message) {
        problems->add(path, line, col, severity, message);
        updateStatus();
    }

    public int errorCount() { return problems->countOf(SEV_ERROR); }
    public int warningCount() { return problems->countOf(SEV_WARNING); }

    public void updateStatus() {
        char t[120];
        int e = errorCount();
        int wn = warningCount();
        bProb->setText("Problems");
        if (e + wn > 0) { format(&t[0], 120, "Problems (%d)", e + wn); bProb->setText(&t[0]); }
        t[0] = 0;
        if (jobRunning) { format(&t[0], 120, "running ..."); }
        else if (job != null) { format(&t[0], 120, "%d error%s, %d warning%s", e, (e == 1) ? "" : "s", wn, (wn == 1) ? "" : "s"); }
        status->setText(&t[0]);
        bStop->enabled = jobRunning;
        bStop->invalidate();
    }

    // follows a job: its output goes to the pane (a timer reads it)
    public void attachJob(aproject.Job* j) {
        job = j;
        build = null;
        synced = 0;
        jobRunning = true;
        updateStatus();
        armTimer();
    }

    // follows a build: like attachJob, and the diagnostics go to the problems list
    public void attachBuild(aproject.BuildJob* b) {
        job = b;
        build = b;
        synced = 0;
        jobRunning = true;
        updateStatus();
        armTimer();
    }

    private void armTimer() {
        if (timer == 0 && win != null) {
            timer = win->display->after(40, paneTimerTick, (int) this);
        }
    }

    public void stop() {
        if (job != null && jobRunning) { job->kill(); }
    }

    // forgets the job that was followed (its output and problems stay)
    public void detachJob() {
        job = null;
        build = null;
        jobRunning = false;
        updateStatus();
    }

    // reads what the job wrote and notices its end; returns true while it still runs
    public bool pollJob() {
        if (job == null || !jobRunning) { return false; }
        bool more = job->poll();
        char buf[4096];
        int total = 0;
        for (;;) {
            int n = job->read(&buf[0], 4096);
            if (n <= 0) { break; }
            output->appendBytes(&buf[0], n);
            total = total + n;
            if (total > 262144) { break; }
        }
        if (build != null) {
            while (synced < build->problemCount) {
                aproject.Problem* p = &build->problems[synced];
                problems->add(p->path, p->line, p->col, p->severity, p->message);
                synced++;
            }
        }
        if (!more && job->available() == 0) {
            jobRunning = false;
            if (job->exited) { exitCode = job->exitCode; }
            else { exitCode = -1; }
            char t[100];
            if (job->timedOut) { format(&t[0], 100, "[timed out]\n"); }
            else if (job->exited) { format(&t[0], 100, "[finished with exit code %d]\n", job->exitCode); }
            else { format(&t[0], 100, "[ended by signal %d]\n", job->termSignal); }
            output->append(&t[0]);
            updateStatus();
            if (onFinished != null) { onFinished(this); }
            return false;
        }
        updateStatus();
        return true;
    }

    public void timerTick() {
        timer = 0;
        if (pollJob()) { armTimer(); }
    }

    public void tabClicked(FlatButton* b) {
        if (b == bOut) { showOutput(); } else { showProblems(); }
    }

    public void jumped(int fromProblems) {
        if (fromProblems != 0) {
            asys.free(jumpPath);
            jumpPath = asys.strDup(problems->jumpPath);
            jumpLine = problems->jumpLine;
            jumpCol = problems->jumpCol;
        } else {
            asys.free(jumpPath);
            jumpPath = asys.strDup(output->jumpPath);
            jumpLine = output->jumpLine;
            jumpCol = output->jumpCol;
        }
        if (onJump != null) { onJump(this); }
    }
}

int paneTab(int btn) {
    FlatButton* b = (FlatButton*) btn;
    OutputPane* p = (OutputPane*) b->userData;
    p->tabClicked(b);
    return 0;
}

int paneStop(int btn) {
    FlatButton* b = (FlatButton*) btn;
    OutputPane* p = (OutputPane*) b->userData;
    p->stop();
    return 0;
}

int paneClear(int btn) {
    FlatButton* b = (FlatButton*) btn;
    OutputPane* p = (OutputPane*) b->userData;
    p->clear();
    return 0;
}

int paneTimerTick(int self) {
    OutputPane* p = (OutputPane*) self;
    p->timerTick();
    return 0;
}

int paneJumpFromOutput(int view) {
    OutputView* v = (OutputView*) view;
    OutputPane* p = (OutputPane*) v->userData;
    p->jumped(0);
    return 0;
}

int paneJumpFromProblems(int view) {
    ProblemsView* v = (ProblemsView*) view;
    OutputPane* p = (OutputPane*) v->userData;
    p->jumped(1);
    return 0;
}

// =============================================================================
//  TerminalPane: a gterm.Terminal in the colours of the theme
// =============================================================================
public class TerminalPane : BarBox {
    public gterm.Terminal* term;
    public func onExit;                     // int f(int pane): the program ended
    public bool started;

    public TerminalPane() {
        super(true, 0, 0);
        flex = 1;
        bgCol = atheme.Col.Background;
        term = new gterm.Terminal();
        term->flex = 1;
        term->onExit = paneTermExit;
        term->userData = (int) this;
        add(term);
        look->use(this, termLookChanged);
        applyLook();
    }

    public virtual int prefH() { return 200; }

    // the colours of the theme (the terminal draws its default colours from these)
    public void applyLook() {
        gterm.defaultFg = look->col(atheme.Col.Foreground);
        gterm.defaultBg = look->col(atheme.Col.Background);
        gterm.selectionBg = look->col(atheme.Col.Selection);
    }

    // starts a shell (command null) or runs a command through /bin/sh -c; false when it cannot (Windows, no pty)
    public bool start(gui.Display* d, char* command) {
        applyLook();
        started = term->start(d, command);
        return started;
    }

    public void stop() { term->stop(); }
    public bool running() { return term->running; }
    public void feed(char* text) { term->feed(text); }
    public void send(char* text) { term->send(text); }
    public char* lineText(int row) { return term->lineText(row); }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        applyLook();
        super.paint(s, ox, oy);
    }
}

int termLookChanged(int self) {
    TerminalPane* t = (TerminalPane*) self;
    t->applyLook();
    t->invalidate();
    return 0;
}

int paneTermExit(int term) {
    gterm.Terminal* t = (gterm.Terminal*) term;
    TerminalPane* p = (TerminalPane*) t->userData;
    if (p->onExit != null) { p->onExit(p); }
    return 0;
}
