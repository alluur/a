//  gcode_panes - the project explorer, the build output / problems pane and the terminal pane
//  (part of the module gcode: use  import gcode;)
//
//    gcode.FileTree* tree = new gcode.FileTree();        // project explorer on aproject: lazy, icons, rename / new / delete
//    tree->setRoot("/home/me/project");   tree->onOpen = openFile;      // int openFile(int tree): tree->openedPath
//    gcode.OutputPane* out = new gcode.OutputPane();     // build output with colours + the list of problems
//    out->attachBuild(buildJob);  out->onJump = jump;                   // int jump(int pane): jumpPath / jumpLine / jumpCol
