// =============================================================================
//  gcode_bars - buttons, lists, tab bar, status bar, find bar, go to line bar and the symbol outline
//  (part of the module gcode: use  import gcode;)
//
//    gcode.TabBar* tabs = new gcode.TabBar();           // tabs with modified markers, close buttons, overflow arrows
//    int i = tabs->addTab("main.a", (int) doc);  tabs->setModified(i, true);  tabs->onSelect = tabChanged;
//    gcode.FindBar* find = new gcode.FindBar(editor);   // find / replace with count and regex / case / word toggles
//    find->open(false);
//    gcode.GotoBar* go = new gcode.GotoBar(editor);     go->open();
//    gcode.StatusBar* st = new gcode.StatusBar();       // sections with text (and clicks)
//    gcode.EditorStatus* es = new gcode.EditorStatus(editor);    // position, selection, indentation, encoding, line ends, language
//    gcode.Outline* outline = new gcode.Outline(editor);          // the symbols of the document; a click jumps to one
//
//  Every widget takes its colours from the Look (the theme), so a theme change repaints them all.
// =============================================================================
import gui;
import gfx;
import adp;
import asys;
import acode;
import asyntax;
import atheme;
import afind;
import guix;
import cstdlib;
import gcode_core;
import gcode_doc;
import gcode_editor;
module gcode;

const BIGDOC = 200000;          // a buffer of this many bytes: the find count waits for a pause in the typing

// =============================================================================
//  FlatButton: a themed push or toggle button for bars
// =============================================================================
public class FlatButton : gui.Widget {
    public Look* look;
    public char* text;
    public int icon;                        // a guix.ICON_* (0: none)
    public bool toggle;                     // stays down after a click
    public bool checked;
    public func onClick;                    // int f(int button)
    public bool accent;                     // drawn as a call to action
    private bool hot;
    private bool down;

    public FlatButton(char* t) {
        super();
        look = theLook();
        look->use(this, null);
        text = asys.strDup(t);
    }

    public void setText(char* t) {
        asys.free(text);
        text = asys.strDup(t);
        relayout();
        invalidate();
    }

    public void setChecked(bool v) {
        checked = v;
        invalidate();
    }

    public virtual int prefW() {
        int tw = gfx.textWidth(gfx.sans(), text);
        int iw = (icon != 0) ? 20 : 0;
        int total = tw + iw + 14;
        if (total < 26) { total = 26; }
        return total;
    }

    public virtual int prefH() { return 24; }

    public void click() {
        if (!enabled) { return; }
        if (toggle) { checked = !checked; }
        invalidate();
        if (onClick != null) { onClick(this); }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        int bg = look->col(atheme.Col.Sidebar);
        int fg = look->col(atheme.Col.Foreground);
        int fill = bg;
        if (checked) { fill = gfx.mix(bg, look->col(atheme.Col.Selection), 255); }
        else if (accent) { fill = look->col(atheme.Col.StatusBar); fg = look->col(atheme.Col.StatusBarText); }
        else if (down) { fill = gfx.mix(bg, fg, 60); }
        else if (hot && enabled) { fill = gfx.mix(bg, fg, 30); }
        s->fillRoundRect(ox + 1, oy + 1, w - 2, h - 2, 3, fill);
        if (checked) { s->roundRect(ox + 1, oy + 1, w - 2, h - 2, 3, look->col(atheme.Col.Info)); }
        if (!enabled) { fg = look->col(atheme.Col.Whitespace); }
        gfx.Font* f = gfx.sans();
        int tw = gfx.textWidth(f, text);
        int iw = (icon != 0) ? 20 : 0;
        int x = ox + (w - tw - iw) / 2;
        if (icon != 0) {
            guix.drawIcon(s, icon, x, oy + (h - 16) / 2, fg);
            x = x + 20;
        }
        if (tw > 0) { s->text(f, x, oy + (h - f->height) / 2, text, fg); }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (!enabled) { return true; }
        if (kind == adp.M_DOWN && button == 1) {
            down = true;
            invalidate();
        } else if (kind == adp.M_UP && down) {
            down = false;
            invalidate();
            if (mx >= 0 && my >= 0 && mx < w && my < h) { click(); }
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        hot = inside;
        if (!inside) { down = false; }
        invalidate();
    }
}

// =============================================================================
//  BarBox: a box that paints a themed background (the base of the bars and panel headers)
// =============================================================================
public class BarBox : gui.Box {
    public Look* look;
    public int bgCol;                       // an atheme.Col
    public bool lineTop;                    // a thin line at the top edge
    public bool lineBottom;

    public BarBox(bool vert, int space, int pad) {
        super(vert, space, pad);
        look = theLook();
        bgCol = atheme.Col.Sidebar;
        look->use(this, null);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, look->col(bgCol));
        if (lineTop) { s->hline(ox, oy, w, look->col(atheme.Col.Border)); }
        if (lineBottom) { s->hline(ox, oy + h - 1, w, look->col(atheme.Col.Border)); }
    }
}

// a label that takes its colour from the theme
public class BarLabel : gui.Label {
    public Look* look;
    public int colCol;                      // an atheme.Col
    public int minW;                        // the label is at least this wide

    public BarLabel(char* t) {
        super(t);
        look = theLook();
        colCol = atheme.Col.SidebarText;
        look->use(this, null);
    }

    public virtual int prefW() {
        int pw = gfx.textWidth(font, text) + 2;
        return (pw < minW) ? minW : pw;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        color = look->col(colCol);
        super.paint(s, ox, oy);
    }
}

// =============================================================================
//  RowList: a themed list of rows of one height with a scroll bar, keyboard and mouse (the base of FileTree, Outline ...)
// =============================================================================
const RL_SB = 10;

public class RowList : gui.Widget {
    public Look* look;
    public int rowH;
    public int selected;                    // the selected row or -1
    public int top;                         // the first visible row
    public int headerH;                     // space above the rows that a derived widget uses for its own children
    public int bgCol;                       // atheme.Col of the background
    public int fgCol;                       // atheme.Col of the text
    public func onSelect;                   // int f(int list): the selection changed (selected)
    public func onActivate;                 // int f(int list): double click or Enter on a row
    public int dblMs;                       // two clicks within this time are a double click
    public char* emptyText;                 // shown when there are no rows
    private int lastClickMs;
    private int lastClickRow;
    private int barGrab;
    private bool barDrag;

    public RowList() {
        super();
        look = theLook();
        look->use(this, null);
        focusable = true;
        flex = 1;
        rowH = 22;
        selected = -1;
        dblMs = 400;
        bgCol = atheme.Col.Sidebar;
        fgCol = atheme.Col.SidebarText;
        emptyText = "";
        w = 200;
        h = 200;
        lastClickRow = -1;
    }

    public virtual int rowCount() { return 0; }
    public virtual void paintItem(gfx.Surface* s, int x, int y, int rw, int i, bool sel) { }
    // a row was clicked (dbl: the second click of a double click); the default selects it and activates on a double click
    public virtual void clicked(int i, int button, int mx, int mods, bool dbl) {
        select(i);
        if (dbl) { activate(i); }
    }
    // keys the derived widget wants before the standard navigation
    public virtual bool listKey(int key, int uni, int mods) { return false; }
    public virtual void activate(int i) {
        if (onActivate != null) { onActivate(this); }
    }

    public virtual int prefW() { return 200; }
    public virtual int prefH() { return 200; }
    public virtual bool wantsScroll() { return true; }

    public int visibleRows() {
        int n = (h - headerH) / rowH;
        return (n < 1) ? 1 : n;
    }

    public int rowAtY(int my) {
        if (my < headerH) { return -1; }
        int i = top + (my - headerH) / rowH;
        if (i >= rowCount()) { return -1; }
        return i;
    }

    public void ensureVisible(int i) {
        int n = visibleRows();
        if (i < top) { top = i; }
        if (i >= top + n) { top = i - n + 1; }
        clampTop();
    }

    public void clampTop() {
        int mx = rowCount() - visibleRows();
        if (top > mx) { top = mx; }
        if (top < 0) { top = 0; }
    }

    public void scrollTo(int t) {
        top = t;
        clampTop();
        invalidate();
    }

    // selects a row (scrolls to it) and tells onSelect
    public void select(int i) {
        int n = rowCount();
        if (i >= n) { i = n - 1; }
        if (i < -1) { i = -1; }
        bool changed = (i != selected);
        selected = i;
        if (i >= 0) { ensureVisible(i); }
        invalidate();
        if (changed && onSelect != null) { onSelect(this); }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, look->col(bgCol));
        clampTop();
        int n = rowCount();
        int vis = visibleRows();
        bool focused = (win != null && win->focusWidget == this);
        int rw = (n > vis) ? w - RL_SB : w;
        if (n == 0 && emptyText[0] != 0) {
            s->text(gfx.sans(), ox + 10, oy + headerH + 8, emptyText, look->col(atheme.Col.Whitespace));
        }
        for (int r = 0; r <= vis; r++) {
            int i = top + r;
            if (i >= n) { break; }
            int y = oy + headerH + r * rowH;
            bool sel = (i == selected);
            if (sel) {
                int c = look->col(atheme.Col.Selection);
                if (!focused) { c = gfx.mix(look->col(bgCol), c, 150); }
                s->fill(ox, y, rw, rowH, c);
            }
            paintItem(s, ox, y, rw, i, sel);
        }
        if (n > vis) {
            int track = h - headerH;
            int sx = ox + w - RL_SB;
            s->fill(sx, oy + headerH, RL_SB, track, gfx.mix(look->col(bgCol), look->col(atheme.Col.Foreground), 14));
            int len = track * vis / n;
            if (len < 20) { len = 20; }
            int pos = (track - len) * top / (n - vis);
            s->fillRoundRect(sx + 2, oy + headerH + pos, RL_SB - 4, len, 3, gfx.mix(look->col(bgCol), look->col(atheme.Col.Foreground), barDrag ? 140 : 80));
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int n = rowCount();
        int vis = visibleRows();
        if (kind == adp.M_SCROLL) {
            top = top - button * 3;
            clampTop();
            invalidate();
            return true;
        }
        if (kind == adp.M_UP) {
            barDrag = false;
            invalidate();
            return true;
        }
        if (kind == adp.M_MOVE && barDrag) {
            int track = h - headerH;
            int len = track * vis / n;
            if (len < 20) { len = 20; }
            int range = track - len;
            if (range > 0) { scrollTo((my - headerH - barGrab) * (n - vis) / range); }
            return true;
        }
        if (kind != adp.M_DOWN) { return true; }
        if (n > vis && mx >= w - RL_SB && my >= headerH) {
            if (button == 1) {
                int track = h - headerH;
                int len = track * vis / n;
                if (len < 20) { len = 20; }
                int pos = (track - len) * top / (n - vis);
                int along = my - headerH;
                if (along >= pos && along < pos + len) {
                    barDrag = true;
                    barGrab = along - pos;
                } else if (along < pos) {
                    scrollTo(top - vis + 1);
                } else {
                    scrollTo(top + vis - 1);
                }
                invalidate();
            }
            return true;
        }
        int row = rowAtY(my);
        if (row < 0) { return true; }
        int now = asys.monoMs();
        bool dbl = (button == 1 && dblMs > 0 && row == lastClickRow && now - lastClickMs <= dblMs);
        lastClickMs = dbl ? 0 : now;
        lastClickRow = dbl ? -1 : row;
        clicked(row, button, mx, mods, dbl);
        return true;
    }

    public virtual void onFocus(bool gained) { invalidate(); }

    public virtual bool onKey(int dn, int key, int uni, int mods) {
        if (dn == 0 || !enabled) { return false; }
        if (listKey(key, uni, mods)) { return true; }
        int n = rowCount();
        int vis = visibleRows();
        if (key == adp.KEY_DOWN) { select(selected < 0 ? 0 : selected + 1); }
        else if (key == adp.KEY_UP) { select(selected < 0 ? n - 1 : selected - 1); }
        else if (key == adp.KEY_PGDN) { select(selected + vis - 1); }
        else if (key == adp.KEY_PGUP) { select(selected - vis + 1); }
        else if (key == adp.KEY_HOME) { select(0); }
        else if (key == adp.KEY_END) { select(n - 1); }
        else if (key == adp.KEY_ENTER && selected >= 0) { activate(selected); }
        else { return false; }
        return true;
    }
}

// =============================================================================
//  TabBar
// =============================================================================
const TAB_H = 28;
const TAB_ARROW = 18;
const TAB_CLOSE = 16;

public class TabBar : gui.Widget {
    public Look* look;
    public int selected;                    // the selected tab, -1 when there is none
    public bool closable;                   // tabs have close buttons
    public func onSelect;                   // int f(int bar): the selected tab changed
    public func onClose;                    // int f(int bar): closeIndex is closing; return nonzero to keep it (and close it yourself later)
    public func onTabContext;               // int f(int bar): right click on tab contextIndex
    public func onMove;                     // int f(int bar): a tab was dragged to another place (movedTo)
    public int closeIndex;
    public int contextIndex;
    public int movedTo;
    public int scrollX;                     // pixels the tabs are shifted left (overflow)
    private char** titles;
    private int* flags;
    private int* udata;
    private int count;
    private int cap;
    private int hotTab;
    private bool hotClose;
    private int dragTab;
    private int dragX;
    private bool dragMoved;

    public TabBar() {
        super();
        look = theLook();
        look->use(this, null);
        closable = true;
        selected = -1;
        hotTab = -1;
        dragTab = -1;
        h = TAB_H;
        w = 300;
        cap = 8;
        titles = (char**) calloc(cap, 8);
        flags = (int*) calloc(cap, 8);
        udata = (int*) calloc(cap, 8);
    }

    public virtual int prefW() { return 200; }
    public virtual int prefH() { return TAB_H; }

    public int tabCount() { return count; }
    public char* titleOf(int i) { return (i >= 0 && i < count) ? titles[i] : ""; }
    public bool isModified(int i) { return i >= 0 && i < count && (flags[i] & 1) != 0; }
    public int dataOf(int i) { return (i >= 0 && i < count) ? udata[i] : 0; }
    public int indexOfData(int d) {
        for (int i = 0; i < count; i++) { if (udata[i] == d) { return i; } }
        return -1;
    }

    // adds a tab at the end; the first tab becomes selected. Returns its index.
    public int addTab(char* title, int userData) {
        if (count == cap) {
            cap = cap * 2;
            titles = (char**) realloc((char*) titles, cap * 8);
            flags = (int*) realloc((char*) flags, cap * 8);
            udata = (int*) realloc((char*) udata, cap * 8);
        }
        titles[count] = asys.strDup(title);
        flags[count] = 0;
        udata[count] = userData;
        count++;
        if (selected < 0) { selected = 0; }
        invalidate();
        return count - 1;
    }

    public void setTitle(int i, char* t) {
        if (i < 0 || i >= count) { return; }
        asys.free(titles[i]);
        titles[i] = asys.strDup(t);
        invalidate();
    }

    public void setModified(int i, bool m) {
        if (i < 0 || i >= count) { return; }
        flags[i] = m ? (flags[i] | 1) : (flags[i] & ~1);
        invalidate();
    }

    public int tabWidth(int i) {
        int tw = gfx.textWidth(gfx.sans(), titles[i]) + 24 + (closable ? TAB_CLOSE + 4 : 0);
        if (tw < 70) { tw = 70; }
        if (tw > 200) { tw = 200; }
        return tw;
    }

    public int tabLeft(int i) {
        int x = 0;
        for (int k = 0; k < i && k < count; k++) { x = x + tabWidth(k); }
        return x;
    }

    public int contentWidth() { return tabLeft(count); }
    public bool overflowing() { return contentWidth() > w; }
    private int viewWidth() { return overflowing() ? w - TAB_ARROW * 3 : w; }

    private void clampScroll() {
        int mx = contentWidth() - viewWidth();
        if (scrollX > mx) { scrollX = mx; }
        if (scrollX < 0) { scrollX = 0; }
    }

    public void ensureVisible(int i) {
        if (i < 0 || i >= count) { return; }
        int l = tabLeft(i);
        int r = l + tabWidth(i);
        int vw = viewWidth();
        if (l < scrollX) { scrollX = l; }
        if (r > scrollX + vw) { scrollX = r - vw; }
        clampScroll();
    }

    // the tab at an x position of the widget (-1: none); onClose is set when the close button is hit
    public int tabAt(int mx, bool* onCloseBtn) {
        *onCloseBtn = false;
        if (mx >= viewWidth()) { return -1; }
        int x = -scrollX;
        for (int i = 0; i < count; i++) {
            int tw = tabWidth(i);
            if (mx >= x && mx < x + tw) {
                if (closable && mx >= x + tw - TAB_CLOSE - 6 && mx < x + tw - 4) { *onCloseBtn = true; }
                return i;
            }
            x = x + tw;
        }
        return -1;
    }

    // the x of the middle of the close button of a tab and the middle of the tab, in widget coordinates (for tests)
    public int closeButtonX(int i) { return tabLeft(i) - scrollX + tabWidth(i) - TAB_CLOSE / 2 - 5; }
    public int tabMiddleX(int i) { return tabLeft(i) - scrollX + (tabWidth(i) - (closable ? TAB_CLOSE : 0)) / 2; }
    public int arrowX(int which) { return viewWidth() + which * TAB_ARROW + TAB_ARROW / 2; }

    public void select(int i) {
        if (i < -1 || i >= count) { return; }
        if (i == selected) {
            ensureVisible(i);
            return;
        }
        selected = i;
        ensureVisible(i);
        invalidate();
        if (onSelect != null) { onSelect(this); }
    }

    // takes a tab away (no questions asked); the selection moves to a neighbour
    public void removeTab(int i) {
        if (i < 0 || i >= count) { return; }
        asys.free(titles[i]);
        for (int k = i; k < count - 1; k++) {
            titles[k] = titles[k + 1];
            flags[k] = flags[k + 1];
            udata[k] = udata[k + 1];
        }
        count--;
        bool wasSel = (i == selected);
        if (i < selected) { selected--; }
        if (wasSel) {
            selected = (count == 0) ? -1 : imin(i, count - 1);
        }
        clampScroll();
        if (selected >= 0) { ensureVisible(selected); }
        invalidate();
        if (wasSel && onSelect != null) { onSelect(this); }
    }

    // the user closes a tab: onClose may refuse (it returns nonzero)
    public void closeTab(int i) {
        if (i < 0 || i >= count) { return; }
        closeIndex = i;
        if (onClose != null && onClose(this) != 0) { return; }
        removeTab(i);
    }

    // moves a tab to another place (the selection follows the tab)
    public void moveTab(int from, int to) {
        if (from < 0 || from >= count || to < 0 || to >= count || from == to) { return; }
        char* t = titles[from];
        int f = flags[from];
        int u = udata[from];
        if (from < to) {
            for (int k = from; k < to; k++) { titles[k] = titles[k + 1]; flags[k] = flags[k + 1]; udata[k] = udata[k + 1]; }
        } else {
            for (int k = from; k > to; k--) { titles[k] = titles[k - 1]; flags[k] = flags[k - 1]; udata[k] = udata[k - 1]; }
        }
        titles[to] = t;
        flags[to] = f;
        udata[to] = u;
        if (selected == from) { selected = to; }
        else if (from < selected && to >= selected) { selected--; }
        else if (from > selected && to <= selected) { selected++; }
        movedTo = to;
        invalidate();
        if (onMove != null) { onMove(this); }
    }

    public virtual void layout() { clampScroll(); }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        clampScroll();
        int bar = look->col(atheme.Col.TabBar);
        int act = look->col(atheme.Col.TabActive);
        int txt = look->col(atheme.Col.TabBarText);
        int fg = look->col(atheme.Col.Foreground);
        s->fill(ox, oy, w, h, bar);
        s->hline(ox, oy + h - 1, w, look->col(atheme.Col.Border));
        gfx.Font* f = gfx.sans();
        int c0 = s->clipX1;
        int vw = viewWidth();
        if (ox + vw < s->clipX1) { s->clipX1 = ox + vw; }
        int x = ox - scrollX;
        for (int i = 0; i < count; i++) {
            int tw = tabWidth(i);
            if (x + tw > ox && x < ox + vw) {
                bool isSel = (i == selected);
                if (isSel) {
                    s->fill(x, oy, tw, h, act);
                    s->fill(x, oy, tw, 2, look->col(atheme.Col.Info));
                } else if (i == hotTab) {
                    s->fill(x, oy, tw, h - 1, gfx.mix(bar, act, 120));
                }
                s->vline(x + tw - 1, oy + 5, h - 10, look->col(atheme.Col.Guide));
                int textW = tw - 24 - (closable ? TAB_CLOSE + 4 : 0);
                drawClipped(s, f, x + 12, oy + (h - f->height) / 2 + 1, titles[i], isSel ? fg : txt, textW);
                if (closable) {
                    int cx = x + tw - TAB_CLOSE / 2 - 5;
                    int cy = oy + h / 2 + 1;
                    bool showX = isSel || i == hotTab;
                    if ((flags[i] & 1) != 0 && !(i == hotTab && hotClose)) {
                        s->fillCircle(cx, cy, 4, isSel ? fg : txt);
                    } else if (showX) {
                        if (i == hotTab && hotClose) {
                            s->fillRoundRect(cx - 7, cy - 7, 14, 14, 3, gfx.mix(bar, fg, 70));
                        }
                        int cc = isSel ? fg : txt;
                        s->line(cx - 3, cy - 3, cx + 3, cy + 3, cc);
                        s->line(cx - 3, cy + 3, cx + 3, cy - 3, cc);
                        s->line(cx - 2, cy - 3, cx + 4, cy + 3, cc);
                        s->line(cx - 2, cy + 3, cx + 4, cy - 3, cc);
                    }
                }
            }
            x = x + tw;
        }
        s->clipX1 = c0;
        if (overflowing()) {
            int ax = ox + vw;
            s->fill(ax, oy, TAB_ARROW * 3, h - 1, bar);
            s->vline(ax, oy + 4, h - 8, look->col(atheme.Col.Guide));
            drawArrow(s, ax + 6, oy + h / 2 - 4, 7, false, scrollX > 0 ? fg : look->col(atheme.Col.Whitespace));
            // the left arrow points left: draw it by hand
            s->fill(ax + 4, oy + 6, TAB_ARROW - 8, h - 14, bar);
            int lx[3];
            int ly[3];
            lx[0] = ax + 12; ly[0] = oy + h / 2 - 5;
            lx[1] = ax + 12; ly[1] = oy + h / 2 + 5;
            lx[2] = ax + 6; ly[2] = oy + h / 2;
            s->fillPolygon(&lx[0], &ly[0], 3, scrollX > 0 ? fg : look->col(atheme.Col.Whitespace));
            int rx[3];
            int ry[3];
            bool more = scrollX < contentWidth() - vw;
            rx[0] = ax + TAB_ARROW + 6; ry[0] = oy + h / 2 - 5;
            rx[1] = ax + TAB_ARROW + 6; ry[1] = oy + h / 2 + 5;
            rx[2] = ax + TAB_ARROW + 12; ry[2] = oy + h / 2;
            s->fillPolygon(&rx[0], &ry[0], 3, more ? fg : look->col(atheme.Col.Whitespace));
            drawArrow(s, ax + TAB_ARROW * 2 + 5, oy + h / 2 - 3, 8, true, fg);
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_SCROLL) {
            scrollX = scrollX - button * 60;
            clampScroll();
            invalidate();
            return true;
        }
        if (kind == adp.M_MOVE) {
            bool oc = false;
            int t = tabAt(mx, &oc);
            if (t != hotTab || oc != hotClose) {
                hotTab = t;
                hotClose = oc;
                invalidate();
            }
            if (dragTab >= 0) {
                int dx = mx - dragX;
                if (dx < 0) { dx = -dx; }
                if (dx > 5) { dragMoved = true; }
                if (dragMoved) {
                    bool dummy = false;
                    int target = tabAt(mx, &dummy);
                    if (target < 0 && mx >= viewWidth() - 4) { target = count - 1; }
                    if (target >= 0 && target != dragTab) {
                        moveTab(dragTab, target);
                        dragTab = target;
                    }
                }
            }
            return true;
        }
        if (kind == adp.M_UP) {
            dragTab = -1;
            dragMoved = false;
            return true;
        }
        if (kind != adp.M_DOWN) { return true; }
        if (overflowing() && mx >= viewWidth()) {
            int which = (mx - viewWidth()) / TAB_ARROW;
            if (which == 0) { scrollX = scrollX - 120; clampScroll(); invalidate(); }
            else if (which == 1) { scrollX = scrollX + 120; clampScroll(); invalidate(); }
            else { showList(); }
            return true;
        }
        bool onX = false;
        int t = tabAt(mx, &onX);
        if (t < 0) { return true; }
        if (button == 2) { closeTab(t); return true; }
        if (button == 3) {
            contextIndex = t;
            select(t);
            if (onTabContext != null) { onTabContext(this); }
            return true;
        }
        if (button != 1) { return true; }
        if (onX) {
            closeTab(t);
            return true;
        }
        select(t);
        dragTab = t;
        dragX = mx;
        dragMoved = false;
        return true;
    }

    // the drop-down list of all tabs (when they do not fit)
    private void showList() {
        if (win == null) { return; }
        guix.Menu* m = new guix.Menu();
        for (int i = 0; i < count; i++) {
            guix.MenuItem* it = m->add(titles[i], tabListPicked);
            it->userData = (int) this;
            it->setId(i + 1);
        }
        m->popup(win, absX() + w - TAB_ARROW * 3, absY() + h);
    }

    public virtual void onHover(bool inside) {
        if (!inside) {
            hotTab = -1;
            hotClose = false;
            invalidate();
        }
    }
}

int tabListPicked(int item) {
    guix.MenuItem* it = (guix.MenuItem*) item;
    TabBar* t = (TabBar*) it->userData;
    t->select(it->id - 1);
    return 0;
}

// =============================================================================
//  StatusBar and EditorStatus
// =============================================================================
public const ST_MESSAGE = 0;
public const ST_POS = 1;
public const ST_SEL = 2;
public const ST_INDENT = 3;
public const ST_ENC = 4;
public const ST_EOL = 5;
public const ST_LANG = 6;

public class StatusBar : gui.Widget {
    public Look* look;
    public func onSection;                  // int f(int bar): section `clickedSection` was clicked
    public int clickedSection;
    private char** texts;
    private int* widths;                    // 0: takes the rest of the space
    private bool* clickable;
    private int count;
    private int hot;

    public StatusBar() {
        super();
        look = theLook();
        look->use(this, null);
        texts = (char**) calloc(16, 8);
        widths = (int*) calloc(16, 8);
        clickable = (bool*) calloc(16, 8);
        hot = -1;
        h = 24;
        w = 200;
    }

    public virtual int prefW() { return 200; }
    public virtual int prefH() { return 24; }

    // a section of a fixed width (0: it takes the space that is left); returns its index
    public int addSection(int width, bool canClick) {
        if (count >= 16) { return count - 1; }
        texts[count] = asys.strDup("");
        widths[count] = width;
        clickable[count] = canClick;
        count++;
        relayout();
        return count - 1;
    }

    public int sectionCount() { return count; }

    public void setText(int i, char* t) {
        if (i < 0 || i >= count) { return; }
        if (streq(texts[i], t)) { return; }
        asys.free(texts[i]);
        texts[i] = asys.strDup(t);
        invalidate();
    }

    public char* text(int i) { return (i >= 0 && i < count) ? texts[i] : ""; }

    private int sectionWidth(int i, int each) { return (widths[i] > 0) ? widths[i] : each; }

    private int eachFlex() {
        int fixed = 0;
        int flex = 0;
        for (int i = 0; i < count; i++) {
            if (widths[i] > 0) { fixed = fixed + widths[i]; } else { flex++; }
        }
        return (flex > 0 && w > fixed) ? (w - fixed) / flex : 0;
    }

    // the x of the middle of a section (widget coordinates)
    public int sectionX(int i) {
        int each = eachFlex();
        int x = 0;
        for (int k = 0; k < i; k++) { x = x + sectionWidth(k, each); }
        return x + sectionWidth(i, each) / 2;
    }

    private int sectionAt(int mx) {
        int each = eachFlex();
        int x = 0;
        for (int i = 0; i < count; i++) {
            int sw = sectionWidth(i, each);
            if (mx >= x && mx < x + sw) { return i; }
            x = x + sw;
        }
        return -1;
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fill(ox, oy, w, h, look->col(atheme.Col.StatusBar));
        int tc = look->col(atheme.Col.StatusBarText);
        gfx.Font* f = gfx.sans();
        int each = eachFlex();
        int x = ox;
        for (int i = 0; i < count; i++) {
            int sw = sectionWidth(i, each);
            if (i == hot && clickable[i]) {
                s->fill(x, oy, sw, h, gfx.mix(look->col(atheme.Col.StatusBar), tc, 45));
            }
            int c0 = s->clipX1;
            if (x + sw - 4 < s->clipX1) { s->clipX1 = x + sw - 4; }
            s->text(f, x + 8, oy + (h - f->height) / 2, texts[i], tc);
            s->clipX1 = c0;
            x = x + sw;
        }
    }

    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        int i = sectionAt(mx);
        if (kind == adp.M_MOVE) {
            if (i != hot) { hot = i; invalidate(); }
        } else if (kind == adp.M_DOWN && button == 1 && i >= 0 && clickable[i]) {
            clickedSection = i;
            if (onSection != null) { onSection(this); }
        }
        return true;
    }

    public virtual void onHover(bool inside) {
        if (!inside) { hot = -1; invalidate(); }
    }
}

// A status bar for an editor: message, position, selection, indentation, encoding, line ends, language. It follows the editor.
// Clicking the indentation section switches between spaces and tabs, the line ends section cycles LF / CRLF / CR.
public class EditorStatus {
    public StatusBar* bar;
    public CodeEditor* editor;

    public EditorStatus(CodeEditor* e) {
        editor = e;
        bar = new StatusBar();
        bar->addSection(0, false);
        bar->addSection(130, false);
        bar->addSection(110, false);
        bar->addSection(110, true);
        bar->addSection(100, false);
        bar->addSection(72, true);
        bar->addSection(100, false);
        bar->onSection = editorStatusClick;
        bar->userData = (int) this;
        e->observe(editorStatusEvent, (int) this);
        update();
    }

    public void setEditor(CodeEditor* e) {
        editor->unobserve((int) this);
        editor = e;
        e->observe(editorStatusEvent, (int) this);
        update();
    }

    public void setMessage(char* m) { bar->setText(ST_MESSAGE, m); }

    public void update() {
        acode.Buffer* b = editor->buf;
        acode.Editor* ed = editor->ed;
        char t[64];
        format(&t[0], 64, "Ln %d, Col %d", ed->caretLine() + 1, ed->caretCol() + 1);
        bar->setText(ST_POS, &t[0]);
        t[0] = 0;
        if (ed->ncur > 1) {
            format(&t[0], 64, "%d cursors", ed->ncur);
        } else if (ed->anySelection()) {
            format(&t[0], 64, "%d selected", b->countChars(ed->selStart(0), ed->selEnd(0)));
        }
        bar->setText(ST_SEL, &t[0]);
        int tw = ed->tabWidth;
        if (tw < 1) { tw = 4; }
        if (ed->useTabs) { format(&t[0], 64, "Tabs: %d", tw); } else { format(&t[0], 64, "Spaces: %d", ed->indentWidth < 1 ? 4 : ed->indentWidth); }
        bar->setText(ST_INDENT, &t[0]);
        if (b->binary) { strcpy(&t[0], "Binary"); }
        else if (b->hasBom) { strcpy(&t[0], "UTF-8 BOM"); }
        else { strcpy(&t[0], "UTF-8"); }
        bar->setText(ST_ENC, &t[0]);
        if (b->eol == acode.EOL_CRLF) { strcpy(&t[0], "CRLF"); }
        else if (b->eol == acode.EOL_CR) { strcpy(&t[0], "CR"); }
        else { strcpy(&t[0], "LF"); }
        if (b->eolMixed) { strcat(&t[0], "*"); }
        bar->setText(ST_EOL, &t[0]);
        char* ln = asyntax.languageName(editor->doc->lang);
        format(&t[0], 64, "%s%s", ln, b->readOnly ? " (read only)" : "");
        bar->setText(ST_LANG, &t[0]);
    }

    public void clicked(int section) {
        acode.Buffer* b = editor->buf;
        acode.Editor* ed = editor->ed;
        if (section == ST_INDENT) {
            ed->useTabs = !ed->useTabs;
        } else if (section == ST_EOL) {
            b->eol = (b->eol + 1) % 3;
            b->eolMixed = false;
        }
        update();
    }
}

int editorStatusEvent(int user, int editor, int event) {
    EditorStatus* es = (EditorStatus*) user;
    es->update();
    return 0;
}

int editorStatusClick(int bar) {
    StatusBar* b = (StatusBar*) bar;
    EditorStatus* es = (EditorStatus*) b->userData;
    es->clicked(b->clickedSection);
    return 0;
}

// =============================================================================
//  GotoBar: "go to line" with  12  12:5  +10  -3
// =============================================================================
// reads a go to line text: line, line:col, +n, -n (relative to the current line). line and col come back 0 based. False when
// the text is not understood; the line is clamped into the document.
public bool parseGoto(char* text, int currentLine, int lineCount, int* line, int* col) {
    int i = 0;
    while (text[i] == ' ') { i++; }
    int sign = 0;
    if (text[i] == '+') { sign = 1; i++; }
    else if (text[i] == '-') { sign = -1; i++; }
    if (text[i] < '0' || text[i] > '9') { return false; }
    int v = 0;
    while (text[i] >= '0' && text[i] <= '9') {
        if (v < 100000000) { v = v * 10 + (text[i] - '0'); }
        i++;
    }
    int c = 1;
    if (text[i] == ':' || text[i] == ',') {
        i++;
        if (text[i] < '0' || text[i] > '9') { return false; }
        c = 0;
        while (text[i] >= '0' && text[i] <= '9') {
            if (c < 100000000) { c = c * 10 + (text[i] - '0'); }
            i++;
        }
    }
    while (text[i] == ' ') { i++; }
    if (text[i] != 0) { return false; }
    int l = 0;
    if (sign == 0) { l = v - 1; }
    else { l = currentLine + sign * v; }
    if (l < 0) { l = 0; }
    if (l >= lineCount) { l = lineCount - 1; }
    if (l < 0) { l = 0; }
    *line = l;
    *col = (c > 0) ? c - 1 : 0;
    return true;
}

public class GotoBar : BarBox {
    public CodeEditor* target;
    public LineEdit* box;
    public func onClose;                    // int f(int bar)
    private BarLabel* label;
    private BarLabel* hint;

    public GotoBar(CodeEditor* e) {
        super(false, 8, 6);
        target = e;
        lineTop = true;
        label = new BarLabel("Go to line:");
        add(label);
        box = new LineEdit();
        box->w = 140;
        box->onEnter = gotoEnter;
        box->onChange = gotoChanged;
        box->onSpecial = gotoSpecial;
        box->userData = (int) this;
        add(box);
        hint = new BarLabel("");
        hint->flex = 1;
        add(hint);
        visible = false;
    }

    public virtual int prefH() { return visible ? 38 : 0; }

    public void open() {
        visible = true;
        relayout();
        invalidate();
        if (win != null) { box->setText(""); box->focusMe(); }
        updateHint();
    }

    public void close() {
        visible = false;
        relayout();
        if (win != null) { win->invalidateAll(); }
        if (target != null) { target->focusMe(); }
        if (onClose != null) { onClose(this); }
    }

    public void setTarget(CodeEditor* e) { target = e; }

    // checks the text, shows what it means
    public void updateHint() {
        int l = 0;
        int c = 0;
        char t[80];
        int n = target->buf->lineCount();
        if (box->text()[0] == 0) {
            format(&t[0], 80, "current line %d of %d", target->ed->caretLine() + 1, n);
            box->colText = look->col(atheme.Col.Foreground);
        } else if (parseGoto(box->text(), target->ed->caretLine(), n, &l, &c)) {
            format(&t[0], 80, "line %d, column %d", l + 1, c + 1);
            box->colText = look->col(atheme.Col.Foreground);
        } else {
            format(&t[0], 80, "type a line number between 1 and %d", n);
            box->colText = look->col(atheme.Col.Error);
        }
        hint->setText(&t[0]);
    }

    // jumps; returns false when the text is not a line number
    public bool go() {
        int l = 0;
        int c = 0;
        if (!parseGoto(box->text(), target->ed->caretLine(), target->buf->lineCount(), &l, &c)) { return false; }
        target->gotoLine(l, c);
        close();
        return true;
    }
}

int gotoEnter(int b) {
    LineEdit* e = (LineEdit*) b;
    GotoBar* g = (GotoBar*) e->userData;
    g->go();
    return 0;
}

int gotoChanged(int b) {
    LineEdit* e = (LineEdit*) b;
    GotoBar* g = (GotoBar*) e->userData;
    g->updateHint();
    return 0;
}

int gotoSpecial(int b) {
    LineEdit* e = (LineEdit*) b;
    GotoBar* g = (GotoBar*) e->userData;
    if (e->special == adp.KEY_ESCAPE) {
        g->close();
        return 1;
    }
    return 0;
}

// =============================================================================
//  FindBar: find and replace
// =============================================================================
public class FindBar : BarBox {
    public CodeEditor* target;
    public LineEdit* findBox;
    public LineEdit* replBox;
    public func onClose;                    // int f(int bar)
    public int matchCount;                  // matches of the pattern (at most 10000)
    public int matchIndex;                  // 1 based index of the match that is selected, 0 when none
    public bool replaceVisible;
    public bool inSelection;
    public int replaced;                    // how many the last "replace all" replaced
    private BarLabel* info;
    private FlatButton* bCase;
    private FlatButton* bWord;
    private FlatButton* bRegex;
    private FlatButton* bSel;
    private FlatButton* bPrev;
    private FlatButton* bNext;
    private FlatButton* bClose;
    private FlatButton* bRepl;
    private FlatButton* bAll;
    private FlatButton* bToggle;
    private gui.Box* row1;
    private gui.Box* row2;
    private afind.Finder* f;
    private int startPos;
    private int rangeFrom;
    private int rangeTo;
    private int seenVersion;
    private int seenGen;
    private int seenSerial;
    private int gen;
    private int countTimer;

    public FindBar(CodeEditor* e) {
        super(true, 4, 6);
        target = e;
        e->observe(findEditorEvent, (int) this);
        lineTop = true;
        row1 = gui.hbox(4, 0);
        row2 = gui.hbox(4, 0);
        bToggle = new FlatButton(">");
        bToggle->toggle = true;
        bToggle->tooltip = "Show replace";
        bToggle->onClick = findToggleReplace;
        bToggle->userData = (int) this;
        row1->add(bToggle);
        findBox = new LineEdit();
        findBox->flex = 1;
        findBox->placeholder = "Find";
        findBox->onChange = findTextChanged;
        findBox->onEnter = findEnter;
        findBox->onSpecial = findSpecial;
        findBox->userData = (int) this;
        row1->add(findBox);
        info = new BarLabel("");
        info->minW = 110;
        row1->add(info);
        bCase = mkBtn("Aa", "Match case (Alt+C)", true);
        bWord = mkBtn("W", "Whole word (Alt+W)", true);
        bRegex = mkBtn(".*", "Regular expression (Alt+R)", true);
        bSel = mkBtn("[ ]", "Only in the selection (Alt+S)", true);
        bPrev = mkBtn("", "Previous (Shift+Enter)", false);
        bPrev->icon = guix.ICON_UP;
        bNext = mkBtn("", "Next (Enter)", false);
        bNext->icon = guix.ICON_DOWN;
        bClose = mkBtn("", "Close (Esc)", false);
        bClose->icon = guix.ICON_CLOSE;
        row1->add(bCase);
        row1->add(bWord);
        row1->add(bRegex);
        row1->add(bSel);
        row1->add(bPrev);
        row1->add(bNext);
        row1->add(bClose);
        gui.Spacer* sp = new gui.Spacer(1);
        sp->w = 26;
        row2->add(sp);
        replBox = new LineEdit();
        replBox->flex = 1;
        replBox->placeholder = "Replace";
        replBox->onEnter = replEnter;
        replBox->onSpecial = findSpecial;
        replBox->userData = (int) this;
        row2->add(replBox);
        bRepl = mkBtn("Replace", "Replace the match (Enter)", false);
        bAll = mkBtn("All", "Replace all matches", false);
        row2->add(bRepl);
        row2->add(bAll);
        row2->visible = false;
        add(row1);
        add(row2);
        visible = false;
        f = new afind.Finder(target->buf);
        look->use(this, findLookChanged);
        findLookChanged((int) this);
    }

    private FlatButton* mkBtn(char* t, char* tip, bool tog) {
        FlatButton* b = new FlatButton(t);
        b->tooltip = tip;
        b->toggle = tog;
        b->onClick = findButton;
        b->userData = (int) this;
        return b;
    }

    public virtual int prefH() { return visible ? (replaceVisible ? 66 : 38) : 0; }

    public void setTarget(CodeEditor* e) {
        target->unobserve((int) this);
        target->clearFindHighlight();
        target = e;
        e->observe(findEditorEvent, (int) this);
        seenSerial = -1;                    // swapBuffer sees a new document
        refresh(false);
    }

    // The editor may show another document now (a tab switch): the finder has to work on the buffer that is shown. True when it
    // changed; the finder is pointed at the new buffer and the "in selection" range is forgotten (the pattern is not applied yet).
    private bool swapBuffer() {
        if (f->buf == target->buf && seenSerial == target->docSerial) { return false; }
        f->buf = target->buf;
        f->clearCurrent();
        seenSerial = target->docSerial;
        seenVersion = -1;
        rangeFrom = -1;
        rangeTo = -1;
        inSelection = false;
        bSel->checked = false;
        startPos = target->ed->selStart(0);
        return true;
    }

    // follows the editor to another document: the pattern is applied to its text again (without moving the selection). The
    // count of a big document follows after a pause, as for edits.
    private void syncTarget() {
        if (swapBuffer()) { applyPattern(false, true); }
    }

    public int options() {
        int o = 0;
        if (!bCase->checked) { o = o | afind.OPT_ICASE; }
        if (bWord->checked) { o = o | afind.OPT_WORD; }
        if (bRegex->checked) { o = o | afind.OPT_REGEX; }
        return o;
    }

    public void setOptions(bool matchCase, bool wholeWord, bool regex) {
        bCase->checked = matchCase;
        bWord->checked = wholeWord;
        bRegex->checked = regex;
        refresh(true);
    }

    public char* pattern() { return findBox->text(); }
    public void setPattern(char* p) {
        findBox->setText(p);
        refresh(true);
    }
    public void setReplacement(char* r) { replBox->setText(r); }

    // shows the bar (with the replace row when replace is true) and focuses the find field; a one line selection becomes the pattern
    public void open(bool replace) {
        syncTarget();
        visible = true;
        showReplace(replace);
        if (target->ed->ncur == 1 && target->ed->hasSelection(0)) {
            int a = target->ed->selStart(0);
            int b = target->ed->selEnd(0);
            if (b - a <= 200 && target->buf->lineAt(a) == target->buf->lineAt(b)) {
                char* t = target->buf->getText(a, b);
                findBox->setText(t);
                asys.free(t);
            }
        }
        startPos = target->ed->selStart(0);
        relayout();
        invalidate();
        if (win != null) {
            win->invalidateAll();
            findBox->selectAll();
            findBox->focusMe();
        }
        refresh(true);
    }

    public void showReplace(bool v) {
        replaceVisible = v;
        row2->visible = v;
        bToggle->checked = v;
        bToggle->text = v ? "v" : ">";
        relayout();
        invalidate();
    }

    public void close() {
        visible = false;
        relayout();
        target->clearFindHighlight();
        if (win != null) { win->invalidateAll(); }
        target->focusMe();
        if (onClose != null) { onClose(this); }
    }

    public bool isOpen() { return visible; }

    // set the pattern in the finder and the editor's highlighter, count the matches, optionally jump to the first one
    public void refresh(bool jump) {
        swapBuffer();
        applyPattern(jump, false);
    }

    // fromSync: the document changed under the bar; nothing is highlighted while the bar is closed and a big document is not
    // counted at once (paint starts the timer)
    private void applyPattern(bool jump, bool fromSync) {
        gen++;
        char* p = findBox->text();
        if (inSelection && rangeFrom >= 0 && rangeTo > rangeFrom) { f->setRange(rangeFrom, rangeTo); } else { f->setRange(-1, -1); }
        if (p[0] == 0) {
            target->clearFindHighlight();
            f->setPattern("", 0);
            matchCount = 0;
            matchIndex = 0;
            info->setText("");
            info->colCol = atheme.Col.SidebarText;
            return;
        }
        bool ok = f->setPattern(p, options());
        if (fromSync && !visible) { return; }
        target->setFindHighlight(p, options());
        if (!ok) {
            matchCount = 0;
            matchIndex = 0;
            info->setText(f->error);
            info->colCol = atheme.Col.Error;
            return;
        }
        if (jump) {
            if (f->findNext(startPos)) {
                target->select(f->curStart, f->curEnd);
            }
        }
        if (fromSync && target->buf->length() >= BIGDOC) {
            matchCount = 0;
            matchIndex = 0;
            info->setText("");
            seenVersion = -1;
            invalidate();
            return;
        }
        updateCount();
    }

    // the text "3 of 12" / "No results"
    public void updateCount() {
        seenVersion = target->buf->version;
        seenGen = gen;
        char t[40];
        if (!f->ok) { return; }
        int n = f->count(10000);
        matchCount = n;
        matchIndex = 0;
        if (n > 0 && target->ed->ncur == 1 && target->ed->hasSelection(0)) {
            int a = target->ed->selStart(0);
            int b = target->ed->selEnd(0);
            afind.Match* ms = (afind.Match*) asys.alloc(n * sizeof(afind.Match) + 16);
            int k = f->matches(ms, n);
            for (int i = 0; i < k; i++) {
                if (ms[i].start == a && ms[i].end == b) { matchIndex = i + 1; break; }
            }
            asys.free((char*) ms);
        }
        if (n == 0) { strcpy(&t[0], "No results"); info->colCol = atheme.Col.Error; }
        else {
            info->colCol = atheme.Col.SidebarText;
            if (n >= 10000) { format(&t[0], 40, "%d+", n); }
            else if (matchIndex > 0) { format(&t[0], 40, "%d of %d", matchIndex, n); }
            else { format(&t[0], 40, "%d found", n); }
        }
        if (f->exceeded) { strcpy(&t[0], "too slow: incomplete"); }
        info->setText(&t[0]);
    }

    private int searchFrom(bool forward) {
        int a = target->ed->selStart(target->ed->primary);
        int b = target->ed->selEnd(target->ed->primary);
        return forward ? b : a;
    }

    public bool findNext() {
        syncTarget();
        if (!f->ok) { return false; }
        bool r = f->findNext(searchFrom(true));
        if (r) {
            target->select(f->curStart, f->curEnd);
            startPos = f->curStart;
        }
        updateCount();
        return r;
    }

    public bool findPrev() {
        syncTarget();
        if (!f->ok) { return false; }
        bool r = f->findPrev(searchFrom(false));
        if (r) {
            target->select(f->curStart, f->curEnd);
            startPos = f->curStart;
        }
        updateCount();
        return r;
    }

    // Replaces the selected match (when the selection is not a match, the next match is selected first). True when something
    // was replaced.
    public bool replaceCurrent() {
        syncTarget();
        if (!f->ok || target->buf->readOnly) { return false; }
        int a = target->ed->selStart(target->ed->primary);
        int b = target->ed->selEnd(target->ed->primary);
        if (!f->findNext(a)) { updateCount(); return false; }
        if (f->curStart != a || f->curEnd != b) {
            target->select(f->curStart, f->curEnd);
            updateCount();
            return false;
        }
        bool r = f->replaceCurrent(target->ed, replBox->text());
        target->touch();
        if (r) {
            if (f->findNext(target->ed->caret())) { target->select(f->curStart, f->curEnd); }
        }
        updateCount();
        return r;
    }

    // replaces every match (one undo step); returns how many
    public int replaceAll() {
        syncTarget();
        if (!f->ok || target->buf->readOnly) { return 0; }
        int n = f->replaceAll(target->ed, replBox->text());
        replaced = n;
        target->touch();
        updateCount();
        char t[40];
        format(&t[0], 40, "%d replaced", n);
        info->setText(&t[0]);
        return n;
    }

    // "in selection": remembers the selection the search is limited to
    public void setInSelection(bool v) {
        inSelection = v;
        bSel->checked = v;
        if (v && target->ed->hasSelection(target->ed->primary)) {
            rangeFrom = target->ed->selStart(target->ed->primary);
            rangeTo = target->ed->selEnd(target->ed->primary);
        } else {
            rangeFrom = -1;
            rangeTo = -1;
            if (v) { inSelection = false; bSel->checked = false; }
        }
        refresh(false);
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        syncTarget();
        // the count follows the text while the bar is open; in a big document it waits for a pause in the typing
        if (visible && (seenVersion != target->buf->version) && f->ok) {
            if (target->buf->length() < BIGDOC || win == null) {
                updateCount();
            } else if (countTimer == 0) {
                int t = win->display->after(200, findCountTick, (int) this);
                if (t > 0) { countTimer = t; } else { updateCount(); }
            }
        }
        super.paint(s, ox, oy);
    }

    public void countStep() {
        countTimer = 0;
        syncTarget();
        if (visible && f->ok) {
            updateCount();
            invalidate();
        }
    }

    // the editor tells: a document switch is noticed here, before the old document can be disposed
    public void editorEvent(int event) {
        syncTarget();
        if (event == EV_CHANGE && visible) { invalidate(); }
    }

    public void buttonClicked(FlatButton* b) {
        if (b == bToggle) { showReplace(b->checked); }
        else if (b == bCase || b == bWord || b == bRegex) { refresh(true); }
        else if (b == bSel) { setInSelection(b->checked); }
        else if (b == bPrev) { findPrev(); }
        else if (b == bNext) { findNext(); }
        else if (b == bClose) { close(); }
        else if (b == bRepl) { replaceCurrent(); }
        else if (b == bAll) { replaceAll(); }
    }

    public void lookChanged() {
        info->colCol = atheme.Col.SidebarText;
    }

    // 0 match case, 1 whole word, 2 regular expression
    public FlatButton* toggleOf(int which) {
        if (which == 0) { return bCase; }
        if (which == 1) { return bWord; }
        return bRegex;
    }
}

// the editor changed its text or shows another document: the bar follows it and repaints (that is where the count follows the text)
int findEditorEvent(int user, int editor, int event) {
    FindBar* b = (FindBar*) user;
    b->editorEvent(event);
    return 0;
}

int findCountTick(int self) {
    FindBar* b = (FindBar*) self;
    b->countStep();
    return 0;
}

int findLookChanged(int self) {
    FindBar* b = (FindBar*) self;
    b->lookChanged();
    b->relayout();
    b->invalidate();
    return 0;
}

int findButton(int btn) {
    FlatButton* b = (FlatButton*) btn;
    FindBar* fb = (FindBar*) b->userData;
    fb->buttonClicked(b);
    return 0;
}

int findToggleReplace(int btn) {
    FlatButton* b = (FlatButton*) btn;
    FindBar* fb = (FindBar*) b->userData;
    fb->showReplace(b->checked);
    return 0;
}

int findTextChanged(int box) {
    LineEdit* e = (LineEdit*) box;
    FindBar* fb = (FindBar*) e->userData;
    fb->refresh(true);
    return 0;
}

int findEnter(int box) {
    LineEdit* e = (LineEdit*) box;
    FindBar* fb = (FindBar*) e->userData;
    fb->findNext();
    return 0;
}

int replEnter(int box) {
    LineEdit* e = (LineEdit*) box;
    FindBar* fb = (FindBar*) e->userData;
    fb->replaceCurrent();
    return 0;
}

int findSpecial(int box) {
    LineEdit* e = (LineEdit*) box;
    FindBar* fb = (FindBar*) e->userData;
    int k = e->special;
    int m = e->specialMods;
    if (k == adp.KEY_ESCAPE) { fb->close(); return 1; }
    if (k == adp.KEY_ENTER && (m & adp.MOD_SHIFT) != 0) { fb->findPrev(); return 1; }
    if ((m & adp.MOD_ALT) != 0) {
        if (k == 'c' || k == 'w' || k == 'r') {
            FlatButton* tb = fb->toggleOf((k == 'c') ? 0 : (k == 'w') ? 1 : 2);
            tb->checked = !tb->checked;
            fb->buttonClicked(tb);
            return 1;
        }
    }
    if (k == adp.KEY_DOWN) { fb->findNext(); return 1; }
    if (k == adp.KEY_UP) { fb->findPrev(); return 1; }
    return 0;
}

// =============================================================================
//  Outline: the symbols of the document
// =============================================================================
public class Outline : RowList {
    public CodeEditor* target;
    public LineEdit* filterBox;
    public func onJump;                     // int f(int outline): jumpLine / jumpCol (0 based) were selected
    public int jumpLine;
    public int jumpCol;
    public bool followCaret;                // the symbol that contains the caret is selected while the caret moves
    public bool jumpOnSelect;               // a click selects and jumps (else it needs a double click or Enter)
    private asyntax.SymbolList* syms;
    private Doc* seenDoc;                   // the document the symbols belong to
    private int* shown;                     // indexes into syms of the rows that match the filter
    private int nshown;
    private int shownCap;
    private int seenVersion;
    private int seenLang;
    private int timer;
    private bool needRefresh;

    public Outline(CodeEditor* e) {
        super();
        target = e;
        followCaret = true;
        jumpOnSelect = true;
        syms = new asyntax.SymbolList();
        shownCap = 64;
        shown = (int*) calloc(shownCap, 8);
        headerH = 30;
        rowH = 20;
        emptyText = "No symbols";
        filterBox = new LineEdit();
        filterBox->placeholder = "Filter";
        filterBox->onChange = outlineFilterChanged;
        filterBox->onEnter = outlineFilterEnter;
        filterBox->onSpecial = outlineFilterSpecial;
        filterBox->userData = (int) this;
        filterBox->x = 3;
        filterBox->y = 3;
        filterBox->h = 24;
        add(filterBox);
        e->observe(outlineEvent, (int) this);
        seenVersion = -1;
        rebuild();
    }

    public void setTarget(CodeEditor* e) {
        target->unobserve((int) this);
        target = e;
        e->observe(outlineEvent, (int) this);
        seenVersion = -1;
        rebuild();
    }

    public virtual int prefW() { return 220; }

    public virtual void layout() {
        filterBox->x = 3;
        filterBox->y = 3;
        filterBox->w = w - 6;
        filterBox->h = 24;
    }

    // reads the symbols again (cheap for ordinary files; called by a timer after edits)
    public void rebuild() {
        seenVersion = target->buf->version;
        seenLang = target->doc->lang;
        seenDoc = target->doc;
        syms->dispose();
        asyntax.symbols(target->buf, target->doc->lang, syms);
        applyFilter();
        needRefresh = false;
    }

    // makes the symbols match the text if something changed since they were read (the timer does this too)
    public void ensureFresh() {
        if (seenVersion != target->buf->version || seenLang != target->doc->lang || seenDoc != target->doc) { rebuild(); }
    }

    public int symbolCount() {
        ensureFresh();
        return syms->count;
    }

    private bool nameMatches(char* name, char* filter) {
        if (filter[0] == 0) { return true; }
        int n = strlen(name);
        int m = strlen(filter);
        for (int i = 0; i + m <= n; i++) {
            bool same = true;
            for (int k = 0; k < m; k++) {
                int a = name[i + k];
                int b = filter[k];
                if (a >= 'A' && a <= 'Z') { a = a + 32; }
                if (b >= 'A' && b <= 'Z') { b = b + 32; }
                if (a != b) { same = false; break; }
            }
            if (same) { return true; }
        }
        return false;
    }

    public void applyFilter() {
        char* flt = filterBox->text();
        if (syms->count > shownCap) {
            shownCap = syms->count * 2;
            shown = (int*) realloc((char*) shown, shownCap * 8);
        }
        nshown = 0;
        for (int i = 0; i < syms->count; i++) {
            if (nameMatches(syms->items[i].name, flt)) {
                shown[nshown] = i;
                nshown++;
            }
        }
        if (selected >= nshown) { selected = nshown - 1; }
        clampTop();
        invalidate();
    }

    public virtual int rowCount() {
        ensureFresh();
        return nshown;
    }

    // the text of row i ("Class.name" for members)
    public char* rowText(int i, char* out) {
        asyntax.Symbol* s = &syms->items[shown[i]];
        if (s->parent != null && s->parent[0] != 0) { format(out, 200, "%s.%s", s->parent, s->name); }
        else { format(out, 200, "%s", s->name); }
        return out;
    }

    public int rowLine(int i) { return (i >= 0 && i < nshown) ? syms->items[shown[i]].line : -1; }
    public int rowKind(int i) { return (i >= 0 && i < nshown) ? syms->items[shown[i]].kind : -1; }

    private int kindColor(int kind) {
        if (kind == asyntax.SymKind.Class || kind == asyntax.SymKind.Struct || kind == asyntax.SymKind.Enum || kind == asyntax.SymKind.Union || kind == asyntax.SymKind.Typedef) { return look->tc[asyntax.Tok.Type]; }
        if (kind == asyntax.SymKind.Function || kind == asyntax.SymKind.Method) { return look->tc[asyntax.Tok.Function]; }
        if (kind == asyntax.SymKind.Const || kind == asyntax.SymKind.Variable) { return look->tc[asyntax.Tok.Constant]; }
        if (kind == asyntax.SymKind.Module) { return look->tc[asyntax.Tok.Keyword]; }
        return look->tc[asyntax.Tok.Heading];
    }

    public virtual void paintItem(gfx.Surface* s, int x, int y, int rw, int i, bool sel) {
        asyntax.Symbol* sy = &syms->items[shown[i]];
        int indent = 6 + ((sy->level > 0) ? (sy->level - 1) * 10 : 0);
        if (sy->parent != null && sy->parent[0] != 0 && sy->level < 1) { indent = indent + 10; }
        int kc = kindColor(sy->kind);
        s->fillRoundRect(x + indent, y + 3, 14, 14, 3, gfx.mix(look->col(bgCol), kc, 70));
        char badge[2];
        char* kn = asyntax.symKindName(sy->kind);
        badge[0] = kn[0];
        if (badge[0] >= 'a' && badge[0] <= 'z') { badge[0] = badge[0] - 32; }
        badge[1] = 0;
        gfx.Font* f = gfx.sans();
        s->text(f, x + indent + 3, y + 2, &badge[0], kc);
        int tx = x + indent + 20;
        int fg = look->col(fgCol);
        if (sy->parent != null && sy->parent[0] != 0 && sy->kind != asyntax.SymKind.Heading) {
            tx = s->text(f, tx, y + (rowH - f->height) / 2, sy->parent, look->col(atheme.Col.Whitespace));
            tx = s->text(f, tx, y + (rowH - f->height) / 2, ".", look->col(atheme.Col.Whitespace));
        }
        drawClipped(s, f, tx, y + (rowH - f->height) / 2, sy->name, fg, x + rw - tx - 4);
    }

    public virtual void clicked(int i, int button, int mx, int mods, bool dbl) {
        select(i);
        if (jumpOnSelect || dbl) { activate(i); }
    }

    public virtual void activate(int i) {
        if (i < 0 || i >= nshown) { return; }
        asyntax.Symbol* sy = &syms->items[shown[i]];
        jumpLine = sy->line;
        jumpCol = 0;
        // the column of the name in the line (the symbol col is a byte offset)
        target->gotoLine(sy->line, target->buf->visualCol(sy->line, target->buf->lineStart(sy->line) + sy->col, target->ed->tabWidth));
        target->focusMe();
        if (onJump != null) { onJump(this); }
    }

    // selects the last symbol that starts at or before the caret line
    public void followCaretLine() {
        if (!followCaret || nshown == 0) { return; }
        int cl = target->ed->caretLine();
        int best = -1;
        for (int i = 0; i < nshown; i++) {
            if (syms->items[shown[i]].line <= cl) { best = i; } else { break; }
        }
        if (best != selected) {
            selected = best;
            if (best >= 0) { ensureVisible(best); }
            invalidate();
        }
    }

    public void eventFromEditor(int ev) {
        if (ev == EV_CHANGE || ev == EV_DOC) {
            needRefresh = true;
            if (timer == 0 && win != null) {
                int t = win->display->after(250, outlineTick, (int) this);
                if (t > 0) { timer = t; }
            }
        } else if (ev == EV_CURSOR) {
            if (target->buf->version != seenVersion) {
                needRefresh = true;
            }
            followCaretLine();
        }
    }

    public void tick() {
        timer = 0;
        if (needRefresh || seenVersion != target->buf->version || seenLang != target->doc->lang || seenDoc != target->doc) {
            rebuild();
            followCaretLine();
        }
    }

    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        if (seenVersion != target->buf->version || seenLang != target->doc->lang || seenDoc != target->doc) { rebuild(); }
        super.paint(s, ox, oy);
        s->fill(ox, oy, w, headerH, look->col(bgCol));
        s->hline(ox, oy + headerH - 1, w, look->col(atheme.Col.Border));
    }
}

int outlineEvent(int user, int editor, int event) {
    Outline* o = (Outline*) user;
    o->eventFromEditor(event);
    return 0;
}

int outlineTick(int self) {
    Outline* o = (Outline*) self;
    o->tick();
    return 0;
}

int outlineFilterChanged(int box) {
    LineEdit* e = (LineEdit*) box;
    Outline* o = (Outline*) e->userData;
    o->applyFilter();
    return 0;
}

int outlineFilterEnter(int box) {
    LineEdit* e = (LineEdit*) box;
    Outline* o = (Outline*) e->userData;
    o->activate(o->selected);
    return 0;
}

int outlineFilterSpecial(int box) {
    LineEdit* e = (LineEdit*) box;
    Outline* o = (Outline*) e->userData;
    if (e->special == adp.KEY_DOWN) { o->select(o->selected + 1); return 1; }
    if (e->special == adp.KEY_UP) { o->select(o->selected - 1); return 1; }
    if (e->special == adp.KEY_ENTER) { o->activate(o->selected); return 1; }
    return 0;
}
