// =============================================================================
//  bytebuf - byte buffers, endian-aware reading and writing, sizes in bytes                                  import bytebuf;
//
//    // plain functions on a pointer (no range checks): the number says the width in bits, le / be the byte order
//    bytebuf.putU32be(p, 0xCAFEBABE);   int v = bytebuf.getU16le(p);   uint64 w = bytebuf.getU64be(p);
//    getU8 getI8 getU16le getU16be getI16le getI16be getU32le getU32be getI32le getI32be getU64le getU64be
//    putU8 putU16le putU16be putU32le putU32be putU64le putU64be
//
//    // a growing buffer
//    bytebuf.Buf* b = new bytebuf.Buf();
//    b->u8(1); b->u16be(0x1234); b->u32le(7); b->u64be(1); b->varint(300); b->cstr("name"); b->text("raw"); b->bytes(p, n);
//    int at = b->size(); b->u32be(0); ... b->patch32be(at, b->size());      // fill in a length afterwards
//    b->data  b->len                                                          // the bytes (b->data is always NUL terminated)
//
//    // reading, with range checks: past the end every read gives 0 and sets r->bad
//    bytebuf.Reader* r = new bytebuf.Reader(data, len);
//    int kind = r->u8(); int n = r->u16be(); int id = r->u32le(); int v = r->varint(); char* s = r->cstr();
//    if (r->bad) { /* the data was too short */ }
//
//    bytebuf.humanSize(1536)          "1.50 KiB"  (powers of 1024)     bytebuf.humanSizeSI(1500)   "1.50 kB"  (powers of 1000)
//    bytebuf.parseSize("10MB")        10000000   ("10M" and "10MiB" are 10485760; B, K, KB, KiB, M, G, T; -1 when it is not a size)
//    bytebuf.hexdump(data, len)       the classic  "00000000  48 65 6c 6c ...  |Hello...|"  listing (a new string)
//    bytebuf.hex(data, len)           "48656c6c6f"                             bytebuf.fromHex("48656c6c6f", &n)
// =============================================================================
import cstdio;
import cstdlib;
import cstring;
module bytebuf;

// ---- plain reads and writes ------------------------------------------------------------------------------------------------------------
public int getU8(char* p) { return p[0] & 255; }
public int getI8(char* p) { int8 v = p[0]; return v; }
public int getU16le(char* p) { return (p[0] & 255) | ((p[1] & 255) << 8); }
public int getU16be(char* p) { return ((p[0] & 255) << 8) | (p[1] & 255); }
public int getI16le(char* p) { int16 v = getU16le(p); return v; }
public int getI16be(char* p) { int16 v = getU16be(p); return v; }
public int getU32le(char* p) { return (p[0] & 255) | ((p[1] & 255) << 8) | ((p[2] & 255) << 16) | ((p[3] & 255) << 24); }
public int getU32be(char* p) { return ((p[0] & 255) << 24) | ((p[1] & 255) << 16) | ((p[2] & 255) << 8) | (p[3] & 255); }
public int getI32le(char* p) { int32 v = getU32le(p); return v; }
public int getI32be(char* p) { int32 v = getU32be(p); return v; }
public uint64 getU64le(char* p) {
    uint64 lo = getU32le(p);
    uint64 hi = getU32le(&p[4]);
    return (hi << 32) | lo;
}
public uint64 getU64be(char* p) {
    uint64 hi = getU32be(p);
    uint64 lo = getU32be(&p[4]);
    return (hi << 32) | lo;
}

public void putU8(char* p, int v) { p[0] = v; }
public void putU16le(char* p, int v) { p[0] = v; p[1] = v >> 8; }
public void putU16be(char* p, int v) { p[0] = v >> 8; p[1] = v; }
public void putU32le(char* p, int v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
public void putU32be(char* p, int v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
public void putU64le(char* p, uint64 v) { putU32le(p, v & 0xFFFFFFFF); putU32le(&p[4], v >> 32); }
public void putU64be(char* p, uint64 v) { putU32be(p, v >> 32); putU32be(&p[4], v & 0xFFFFFFFF); }

// ---- a growing buffer ------------------------------------------------------------------------------------------------------------------
public class Buf {
    public char* data;
    public int len;
    public int cap;

    public Buf() {
        cap = 64;
        len = 0;
        data = malloc(cap + 1);
        data[0] = 0;
    }

    private void room(int more) {
        if (len + more > cap) {
            while (len + more > cap) { cap = cap * 2; }
            data = realloc(data, cap + 1);
        }
    }

    public int size() { return len; }

    public void clear() {
        len = 0;
        data[0] = 0;
    }

    private void end() { data[len] = 0; }

    public void u8(int v) {
        room(1);
        data[len] = v;
        len++;
        end();
    }
    public void u16le(int v) { room(2); putU16le(&data[len], v); len = len + 2; end(); }
    public void u16be(int v) { room(2); putU16be(&data[len], v); len = len + 2; end(); }
    public void u32le(int v) { room(4); putU32le(&data[len], v); len = len + 4; end(); }
    public void u32be(int v) { room(4); putU32be(&data[len], v); len = len + 4; end(); }
    public void u64le(uint64 v) { room(8); putU64le(&data[len], v); len = len + 8; end(); }
    public void u64be(uint64 v) { room(8); putU64be(&data[len], v); len = len + 8; end(); }

    // LEB128: 7 bits per byte, the high bit says that more follow (protobuf, WebAssembly, DWARF)
    public void varint(uint64 v) {
        for (;;) {
            int part = v & 127;
            v = v >> 7;
            if (v == 0) {
                u8(part);
                return;
            }
            u8(part | 128);
        }
    }

    // a signed number, zig-zag coded (small magnitudes stay short) and written as a varint
    public void svarint(int v) {
        uint64 z = (v << 1) ^ (v >> 63);
        varint(z);
    }

    public void bytes(char* p, int n) {
        if (n <= 0) { return; }
        room(n);
        memcpy(&data[len], p, n);
        len = len + n;
        end();
    }

    // the characters of a string without its terminating zero
    public void text(char* s) { bytes(s, strlen(s)); }

    // a string with its terminating zero
    public void cstr(char* s) { bytes(s, strlen(s) + 1); }

    public void fill(int value, int n) {
        for (int i = 0; i < n; i++) { u8(value); }
    }

    // zero bytes up to the next multiple of n
    public void align(int n) {
        while (len % n != 0) { u8(0); }
    }

    // overwrite earlier bytes (for lengths that are only known at the end)
    public void patch16be(int at, int v) { putU16be(&data[at], v); }
    public void patch16le(int at, int v) { putU16le(&data[at], v); }
    public void patch32be(int at, int v) { putU32be(&data[at], v); }
    public void patch32le(int at, int v) { putU32le(&data[at], v); }
}

// ---- reading with range checks ----------------------------------------------------------------------------------------------------------
public class Reader {
    public char* data;
    public int len;
    public int pos;
    public bool bad;

    public Reader(char* d, int n) {
        data = d;
        len = n;
        pos = 0;
        bad = false;
    }

    public int remaining() { return len - pos; }
    public bool eof() { return pos >= len; }

    private bool need(int n) {
        if (n < 0 || pos + n > len) {
            bad = true;
            pos = len;
            return false;
        }
        return true;
    }

    public void seek(int p) {
        if (p < 0 || p > len) { bad = true; return; }
        pos = p;
    }

    public void skip(int n) {
        if (need(n)) { pos = pos + n; }
    }

    public int u8() {
        if (!need(1)) { return 0; }
        pos++;
        return data[pos - 1] & 255;
    }
    public int i8() { int8 v = u8(); return v; }
    public int u16le() { if (!need(2)) { return 0; } pos = pos + 2; return getU16le(&data[pos - 2]); }
    public int u16be() { if (!need(2)) { return 0; } pos = pos + 2; return getU16be(&data[pos - 2]); }
    public int i16le() { int16 v = u16le(); return v; }
    public int i16be() { int16 v = u16be(); return v; }
    public int u32le() { if (!need(4)) { return 0; } pos = pos + 4; return getU32le(&data[pos - 4]); }
    public int u32be() { if (!need(4)) { return 0; } pos = pos + 4; return getU32be(&data[pos - 4]); }
    public int i32le() { int32 v = u32le(); return v; }
    public int i32be() { int32 v = u32be(); return v; }
    public uint64 u64le() { if (!need(8)) { return 0; } pos = pos + 8; return getU64le(&data[pos - 8]); }
    public uint64 u64be() { if (!need(8)) { return 0; } pos = pos + 8; return getU64be(&data[pos - 8]); }

    public uint64 varint() {
        uint64 v = 0;
        int shift = 0;
        for (;;) {
            if (shift > 63) {
                bad = true;
                return 0;
            }
            if (!need(1)) { return 0; }
            int b = data[pos] & 255;
            pos++;
            uint64 part = b & 127;
            v = v | (part << shift);
            if ((b & 128) == 0) { return v; }
            shift = shift + 7;
        }
    }

    public int svarint() {
        uint64 z = varint();
        return (z >> 1) ^ -(z & 1);
    }

    // a pointer to the next n bytes inside the data (not a copy); null when there are not that many
    public char* take(int n) {
        if (!need(n)) { return null; }
        pos = pos + n;
        return &data[pos - n];
    }

    // a new string from a zero terminated text; null when the terminator is missing
    public char* cstr() {
        int e = pos;
        while (e < len && data[e] != 0) { e++; }
        if (e >= len) {
            bad = true;
            pos = len;
            return null;
        }
        char* s = malloc(e - pos + 1);
        memcpy(s, &data[pos], e - pos + 1);
        pos = e + 1;
        return s;
    }
}

// ---- sizes in bytes --------------------------------------------------------------------------------------------------------------------
// "1.50 KiB": n in units of 1024 (B, KiB, MiB, GiB, TiB, PiB, EiB), two decimals above one KiB
public char* humanSize(uint64 n) {
    char* units = "BKMGTPE";
    char* out = malloc(32);
    if (n < 1024) {
        sprintf(out, "%d B", n);
        return out;
    }
    int u = 0;
    uint64 whole = n;
    uint64 rest = 0;
    while (whole >= 1024 && u < 6) {
        rest = whole % 1024;
        whole = whole / 1024;
        u++;
    }
    int hundredths = rest * 100 / 1024;
    sprintf(out, "%d.%02d %ciB", whole, hundredths, units[u]);
    return out;
}

// "1.50 kB": n in units of 1000
public char* humanSizeSI(uint64 n) {
    char* units = "BkMGTPE";
    char* out = malloc(32);
    if (n < 1000) {
        sprintf(out, "%d B", n);
        return out;
    }
    int u = 0;
    uint64 whole = n;
    uint64 rest = 0;
    while (whole >= 1000 && u < 6) {
        rest = whole % 1000;
        whole = whole / 1000;
        u++;
    }
    int hundredths = rest / 10;
    sprintf(out, "%d.%02d %cB", whole, hundredths, units[u]);
    return out;
}

// "512", "10K", "1.5MiB", "2 GB" -> bytes. K, M, G, T and the IEC names (KiB ...) are powers of 1024; KB, MB ... are powers of 1000.
// -1 when the text is not a size.
public int parseSize(char* s) {
    int i = 0;
    while (s[i] == ' ') { i++; }
    if (s[i] < '0' || s[i] > '9') { return -1; }
    int whole = 0;
    while (s[i] >= '0' && s[i] <= '9') {
        whole = whole * 10 + (s[i] - '0');
        i++;
    }
    int frac = 0;
    int fracDiv = 1;
    if (s[i] == '.') {
        i++;
        while (s[i] >= '0' && s[i] <= '9') {
            if (fracDiv < 1000000000) {
                frac = frac * 10 + (s[i] - '0');
                fracDiv = fracDiv * 10;
            }
            i++;
        }
    }
    while (s[i] == ' ') { i++; }
    int unit = 1;
    int base = 1024;
    int c = s[i] | 0x20;
    int power = 0;
    if (c == 'k') { power = 1; }
    else if (c == 'm') { power = 2; }
    else if (c == 'g') { power = 3; }
    else if (c == 't') { power = 4; }
    else if (c == 'b' || s[i] == 0) { power = 0; }
    else { return -1; }
    if (power > 0) {
        i++;
        int c2 = s[i] | 0x20;
        if (c2 == 'i') {
            i++;
            if ((s[i] | 0x20) != 'b') { return -1; }
            i++;
        } else if (c2 == 'b') {
            base = 1000;
            i++;
        }
    } else if (s[i] != 0) {
        i++;
    }
    while (s[i] == ' ') { i++; }
    if (s[i] != 0) { return -1; }
    for (int k = 0; k < power; k++) { unit = unit * base; }
    return whole * unit + frac * unit / fracDiv;
}

// ---- hex ---------------------------------------------------------------------------------------------------------------------------------
public char* hex(char* data, int n) {
    char* digits = "0123456789abcdef";
    char* out = malloc(n * 2 + 1);
    for (int i = 0; i < n; i++) {
        out[i * 2] = digits[(data[i] >> 4) & 15];
        out[i * 2 + 1] = digits[data[i] & 15];
    }
    out[n * 2] = 0;
    return out;
}

private int hexDigit(int c) {
    if (c >= '0' && c <= '9') { return c - '0'; }
    c = c | 0x20;
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return -1;
}

// the bytes of a hex string (spaces are skipped); null when it has a bad character or an odd number of digits
public char* fromHex(char* s, int* n) {
    int len = strlen(s);
    char* out = malloc(len / 2 + 1);
    int o = 0;
    int half = -1;
    for (int i = 0; i < len; i++) {
        if (s[i] == ' ') { continue; }
        int d = hexDigit(s[i]);
        if (d < 0) { free(out); return null; }
        if (half < 0) {
            half = d;
        } else {
            out[o] = (half << 4) | d;
            o++;
            half = -1;
        }
    }
    if (half >= 0) { free(out); return null; }
    out[o] = 0;
    *n = o;
    return out;
}

// the usual listing: offset, 16 bytes in hex, then the printable characters
public char* hexdump(char* data, int n) {
    int lines = (n + 15) / 16;
    char* out = malloc(lines * 80 + 1);
    int o = 0;
    for (int off = 0; off < n; off += 16) {
        o = o + sprintf(&out[o], "%08x ", off);
        for (int i = 0; i < 16; i++) {
            if (i == 8) { out[o] = ' '; o++; }
            if (off + i < n) {
                o = o + sprintf(&out[o], " %02x", data[off + i] & 255);
            } else {
                out[o] = ' '; out[o + 1] = ' '; out[o + 2] = ' ';
                o = o + 3;
            }
        }
        out[o] = ' '; out[o + 1] = ' '; out[o + 2] = '|';
        o = o + 3;
        for (int i = 0; i < 16 && off + i < n; i++) {
            int c = data[off + i] & 255;
            out[o] = (c >= 32 && c < 127) ? c : '.';
            o++;
        }
        out[o] = '|'; out[o + 1] = '\n';
        o = o + 2;
    }
    out[o] = 0;
    return out;
}
