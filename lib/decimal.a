// =============================================================================
//  decimal - fixed point decimal numbers on integers           import decimal;
//
//  A value is an int that counts units of 10^-scale: with scale 2, 1234 means 12.34.
//  Use it for money and anything else that needs exact decimals (A has no float yet).
//    int price = decimal.parse("19.99", 2);          // 1999
//    decimal.format(price * 3, 2)                    // "59.97"
//    decimal.formatMoney(123456789)                  // "1,234,567.89"
// =============================================================================
module decimal;

// 10 to the power n (n <= 18)
public int pow10(int n) {
    int r = 1;
    for (int i = 0; i < n; i++) {
        r = r * 10;
    }
    return r;
}

// true if the text is [sign]digits[.digits]
public bool isValid(char* s) {
    int i = 0;
    if (s[i] == '-' || s[i] == '+') {
        i++;
    }
    int digits = 0;
    while (isDigit(s[i])) {
        i++;
        digits++;
    }
    if (s[i] == '.') {
        i++;
        while (isDigit(s[i])) {
            i++;
            digits++;
        }
    }
    return digits > 0 && s[i] == 0;
}

// "12.345" with scale 2 -> 1235 (extra digits are rounded half away from zero); invalid text gives 0
public int parse(char* s, int scale) {
    if (!isValid(s)) {
        return 0;
    }
    int i = 0;
    bool neg = false;
    if (s[i] == '-') {
        neg = true;
        i++;
    } else if (s[i] == '+') {
        i++;
    }
    int v = 0;
    while (isDigit(s[i])) {
        v = v * 10 + (s[i] - '0');
        i++;
    }
    int got = 0;
    int roundUp = 0;
    if (s[i] == '.') {
        i++;
        while (isDigit(s[i])) {
            if (got < scale) {
                v = v * 10 + (s[i] - '0');
                got++;
            } else if (got == scale && s[i] >= '5') {
                roundUp = 1;
                got++;
            }
            i++;
        }
    }
    while (got < scale) {
        v = v * 10;
        got++;
    }
    v = v + roundUp;
    if (neg) {
        return -v;
    }
    return v;
}

// 1234 with scale 2 -> "12.34" (scale 0 gives a plain integer)
public char* format(int v, int scale) {
    char* out = alloc(48);
    int o = 0;
    bool neg = v < 0;
    if (neg) {
        out[o] = '-';
        o++;
    }
    // work with the negative number so that the smallest int does not overflow
    int m = v;
    if (!neg) {
        m = -v;
    }
    int p = pow10(scale);
    int whole = -(m / p);
    int frac = -(m % p);
    char tmp[24];
    intToStr(whole, tmp);
    int l = strlen(tmp);
    memcpy(&out[o], tmp, l);
    o = o + l;
    if (scale > 0) {
        out[o] = '.';
        o++;
        intToStr(frac, tmp);
        l = strlen(tmp);
        for (int i = l; i < scale; i++) {
            out[o] = '0';
            o++;
        }
        memcpy(&out[o], tmp, l);
        o = o + l;
    }
    return out;
}

// a / b rounded half away from zero
private int divRound(int a, int b) {
    int q = a / b;
    int r = a % b;
    if (r < 0) {
        r = -r;
    }
    int bb = b;
    if (bb < 0) {
        bb = -bb;
    }
    if (r * 2 >= bb) {
        if ((a < 0) != (b < 0)) {
            q--;
        } else {
            q++;
        }
    }
    return q;
}

// a * b for two values of the same scale (a * b must fit in 63 bits)
public int mul(int a, int b, int scale) {
    return divRound(a * b, pow10(scale));
}

// a / b for two values of the same scale
public int div(int a, int b, int scale) {
    if (b == 0) {
        return 0;
    }
    return divRound(a * pow10(scale), b);
}

// converts a value from one scale to another with rounding
public int rescale(int v, int fromScale, int toScale) {
    if (toScale >= fromScale) {
        return v * pow10(toScale - fromScale);
    }
    return divRound(v, pow10(fromScale - toScale));
}

// v * percent / 100 rounded (percent may have decimals: percent 250 with percentScale 1 = 25.0 %)
public int percentOf(int v, int percent, int percentScale) {
    return divRound(v * percent, 100 * pow10(percentScale));
}

// cents as money text with thousands separators: 123456789 -> "1,234,567.89"
public char* formatMoney(int cents) {
    char* plain = format(cents, 2);
    int start = 0;
    if (plain[0] == '-') {
        start = 1;
    }
    int dot = indexOf(plain, '.');
    int intDigits = dot - start;
    char* out = alloc(strlen(plain) + intDigits / 3 + 2);
    int o = 0;
    if (start == 1) {
        out[o] = '-';
        o++;
    }
    for (int i = 0; i < intDigits; i++) {
        if (i > 0 && (intDigits - i) % 3 == 0) {
            out[o] = ',';
            o++;
        }
        out[o] = plain[start + i];
        o++;
    }
    memcpy(&out[o], &plain[dot], strlen(plain) - dot);
    return out;
}
