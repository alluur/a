// =============================================================================
//  ccomplex - C <complex.h>                                    import ccomplex;
//
//  A complex number is a pointer to a `Complex` record with two doubles (bit patterns, see cmath). Functions that make
//  a number return a new one on the heap, so expressions can be nested:
//
//      Complex* z = cmplx(dlit("3"), dlit("4"));
//      printfd("|z| = %g, z*z = %s\n", cabs(z), cstr(cmul(z, z)));     // |z| = 5, z*z = -7+24i
//
//  creal cimag conj cabs carg cproj  cadd csub cmul cdiv cneg  cexp clog csqrt cpow  csin ccos ctan csinh ccosh ctanh
//  casin cacos catan  cpolar  cstr. Results are accurate to a few ulp (they are built from the correctly rounded functions
//  of cmath).
// =============================================================================
import cfloat;

struct Complex {
    int re;
    int im;
}

const CMPLX_ONE = 0x3FF0000000000000;

Complex* cmplx(int re, int im) {
    Complex* z = new Complex;
    z->re = re;
    z->im = im;
    return z;
}

// r * (cos theta + i sin theta)
Complex* cpolar(int r, int theta) {
    return cmplx(dmul(r, cos(theta)), dmul(r, sin(theta)));
}

int creal(Complex* z) {
    return z->re;
}

int cimag(Complex* z) {
    return z->im;
}

Complex* conj(Complex* z) {
    return cmplx(z->re, dneg(z->im));
}

Complex* cneg(Complex* z) {
    return cmplx(dneg(z->re), dneg(z->im));
}

// the modulus |z|
int cabs(Complex* z) {
    return hypot(z->re, z->im);
}

// the argument (angle) in -pi ... pi
int carg(Complex* z) {
    return atan2(z->im, z->re);
}

Complex* cproj(Complex* z) {
    if (isinf(z->re) || isinf(z->im)) {
        return cmplx(INFINITY, copysign(0, z->im));
    }
    return z;
}

Complex* cadd(Complex* a, Complex* b) {
    return cmplx(dadd(a->re, b->re), dadd(a->im, b->im));
}

Complex* csub(Complex* a, Complex* b) {
    return cmplx(dsub(a->re, b->re), dsub(a->im, b->im));
}

Complex* cmul(Complex* a, Complex* b) {
    int re = dsub(dmul(a->re, b->re), dmul(a->im, b->im));
    int im = dadd(dmul(a->re, b->im), dmul(a->im, b->re));
    return cmplx(re, im);
}

// a / b (scaled to avoid overflow, Smith's algorithm)
Complex* cdiv(Complex* a, Complex* b) {
    if (dlt(fabs(b->re), fabs(b->im))) {
        int ratio = ddiv(b->re, b->im);
        int den = dadd(b->im, dmul(b->re, ratio));
        int re = ddiv(dadd(dmul(a->re, ratio), a->im), den);
        int im = ddiv(dsub(dmul(a->im, ratio), a->re), den);
        return cmplx(re, im);
    }
    int ratio = ddiv(b->im, b->re);
    int den = dadd(b->re, dmul(b->im, ratio));
    int re = ddiv(dadd(a->re, dmul(a->im, ratio)), den);
    int im = ddiv(dsub(a->im, dmul(a->re, ratio)), den);
    return cmplx(re, im);
}

Complex* cexp(Complex* z) {
    int m = exp(z->re);
    return cmplx(dmul(m, cos(z->im)), dmul(m, sin(z->im)));
}

// the principal natural logarithm
Complex* clog(Complex* z) {
    return cmplx(log(cabs(z)), carg(z));
}

// the principal square root
Complex* csqrt(Complex* z) {
    if (z->re == 0 && z->im == 0) {
        return cmplx(0, z->im);
    }
    int r = cabs(z);
    int re = sqrt(scalbn(dadd(r, fabs(z->re)), -1));
    int im = ddiv(fabs(z->im), dmul(re, 0x4000000000000000));
    if (z->re >= 0) {
        // right half plane: the real part is the larger one
        return cmplx(re, copysign(im, z->im));
    }
    return cmplx(im, copysign(re, z->im));
}

Complex* cpow(Complex* a, Complex* b) {
    if (a->re == 0 && a->im == 0) {
        if (b->re == 0 && b->im == 0) {
            return cmplx(CMPLX_ONE, 0);
        }
        return cmplx(0, 0);
    }
    // small integer exponents: repeated multiplication (exact for exact operands)
    if ((b->im & 0x7FFFFFFFFFFFFFFF) == 0 && trunc(b->re) == b->re && dle(fabs(b->re), 0x4059000000000000)) {
        int n = dtoi(b->re);
        bool negative = n < 0;
        if (negative) {
            n = -n;
        }
        Complex* result = cmplx(CMPLX_ONE, 0);
        Complex* base = a;
        while (n > 0) {
            if ((n & 1) == 1) {
                result = cmul(result, base);
            }
            base = cmul(base, base);
            n = n >> 1;
        }
        if (negative) {
            return cdiv(cmplx(CMPLX_ONE, 0), result);
        }
        return result;
    }
    return cexp(cmul(b, clog(a)));
}

Complex* csinh(Complex* z) {
    return cmplx(dmul(sinh(z->re), cos(z->im)), dmul(cosh(z->re), sin(z->im)));
}

Complex* ccosh(Complex* z) {
    return cmplx(dmul(cosh(z->re), cos(z->im)), dmul(sinh(z->re), sin(z->im)));
}

// tanh(x+iy) = (sinh 2x + i sin 2y) / (cosh 2x + cos 2y)
Complex* ctanh(Complex* z) {
    int x2 = scalbn(z->re, 1);
    int y2 = scalbn(z->im, 1);
    int den = dadd(cosh(x2), cos(y2));
    return cmplx(ddiv(sinh(x2), den), ddiv(sin(y2), den));
}

Complex* csin(Complex* z) {
    return cmplx(dmul(sin(z->re), cosh(z->im)), dmul(cos(z->re), sinh(z->im)));
}

Complex* ccos(Complex* z) {
    return cmplx(dmul(cos(z->re), cosh(z->im)), dneg(dmul(sin(z->re), sinh(z->im))));
}

// tan(x+iy) = (sin 2x + i sinh 2y) / (cos 2x + cosh 2y)
Complex* ctan(Complex* z) {
    int x2 = scalbn(z->re, 1);
    int y2 = scalbn(z->im, 1);
    int den = dadd(cos(x2), cosh(y2));
    return cmplx(ddiv(sin(x2), den), ddiv(sinh(y2), den));
}

// asin(z) = asin(B) + i sign(y) acosh(A) with A = (|z+1| + |z-1|) / 2 and B = x / A
Complex* casin(Complex* z) {
    int one = CMPLX_ONE;
    int r = hypot(dadd(z->re, one), z->im);
    int s = hypot(dsub(z->re, one), z->im);
    int A = scalbn(dadd(r, s), -1);
    int B = ddiv(z->re, A);
    if (dgt(fabs(B), one)) {
        B = copysign(one, B);
    }
    return cmplx(asin(B), copysign(acosh(dmax_(A, one)), z->im));
}

// acos(z) = acos(B) - i sign(y) acosh(A)
Complex* cacos(Complex* z) {
    int one = CMPLX_ONE;
    int r = hypot(dadd(z->re, one), z->im);
    int s = hypot(dsub(z->re, one), z->im);
    int A = scalbn(dadd(r, s), -1);
    int B = ddiv(z->re, A);
    if (dgt(fabs(B), one)) {
        B = copysign(one, B);
    }
    return cmplx(acos(B), dneg(copysign(acosh(dmax_(A, one)), z->im)));
}

int dmax_(int a, int b) {
    if (dgt(a, b)) {
        return a;
    }
    return b;
}

// atan(x+iy) = atan2(2x, 1 - x^2 - y^2) / 2 + i/4 ln((x^2 + (y+1)^2) / (x^2 + (y-1)^2))
Complex* catan(Complex* z) {
    int one = CMPLX_ONE;
    int x2 = dmul(z->re, z->re);
    int y2 = dmul(z->im, z->im);
    int re = scalbn(atan2(scalbn(z->re, 1), dsub(dsub(one, x2), y2)), -1);
    int ym = dsub(z->im, one);
    int den = dadd(x2, dmul(ym, ym));
    int num = dmul(scalbn(z->im, 2), one);
    int im = scalbn(log1p(ddiv(num, den)), -2);
    return cmplx(re, im);
}

// "3+4i" (shortest exact representation of both parts)
char* cstr(Complex* z) {
    char* re = dtostr(z->re);
    char* im = dtostr(z->im);
    char* out = alloc(strlen(re) + strlen(im) + 4);
    strcpy(out, re);
    if (z->im >= 0 && !isnan(z->im)) {
        strcat(out, "+");
    }
    strcat(out, im);
    strcat(out, "i");
    return out;
}
