## Nano syntax highlighting for the A language (https://aytict.fi)
## Install:  cp a.nanorc ~/.nanorc.d/   and add to ~/.nanorc:   include "~/.nanorc.d/a.nanorc"
## (or:  include "/path/to/a.nanorc")

syntax "A" "\.a$"
comment "//"

## numbers and constants
color brightmagenta "\<[0-9][0-9_]*\>" "\<0[xX][0-9a-fA-F_]+\>" "\<0[bB][01_]+\>"
color brightmagenta "\<(true|false|null|FILE_READ|FILE_WRITE|FILE_APPEND|stdin|stdout|stderr|EOF|NULL|errno|M_PI|M_E|INFINITY|NAN)\>"

## types and storage
color brightyellow "\<(int|long|char|byte|bool|void|func)\>"
color brightmagenta "\<(const|struct|class|enum|union|typedef|static)\>"
color yellow "\<(class|struct|enum)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*"

## control flow, access, modules
color brightblue "\<(if|else|while|do|for|switch|case|default|break|continue|return)\>"
color brightred "\<(public|private|protected|virtual|super)\>"
color brightcyan "\<(module|import|a_module|a_import|new|this|sizeof)\>"

## function calls and the standard library
color green "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("
color cyan "\<(print|println|printInt|printlnInt|printChar|printBool|printHex|eprint|eprintln|readChar|readLine|atoi|strlen|streq|strcmp|strcpy|strcat|strdup|memcpy|memset|indexOf|startsWith|intToStr|isDigit|isAlpha|isUpper|isLower|isSpace|toUpper|toLower|abs|min|max|srand|rand|exit|alloc|fileOpen|fileRead|fileWrite|fileClose|readFile|writeFile|malloc|calloc|realloc|free|qsort|bsearch|atexit|strtol|strtod|getenv|system|fopen|fclose|fgets|fputs|fprintf|sprintf|snprintf|sscanf|strchr|strstr|strtok|memmove|time|strftime|sqrt|sin|cos|pow|exp|log|floor|ceil|printfd)[[:space:]]*\("
color brightyellow "\<__(write|read|exit|open|close|syscall|cmdline|winapi|winapix)\>" "\<(setjmp|longjmp)\>"

## operators
color brightcyan "[-+*/%&|^~!<>=?:]"

## strings and characters with escapes
color brightgreen ""([^"\\]|\\.)*"" "'([^'\\]|\\.|\\x[0-9a-fA-F]{2})'"
color brightcyan "\\([ntre0\\\"']|x[0-9a-fA-F]{2})"

## comments (last, so they win)
color brightblack "//.*"
color brightblack start="/\*" end="\*/"

## trailing whitespace and TODO markers
color ,red "[[:space:]]+$"
color brightwhite,yellow "\<(TODO|FIXME|XXX|NOTE)\>"
