{
  "case_sensitive": true,
  "numbers": true,
  "indent": {
    "width": 4,
    "expand_tabs": true
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "name": "A",
  "extensions": [
    "a",
    "am"
  ],
  "comments": [
    {
      "start": "/*",
      "end": "*/",
      "token": "comment",
      "multiline": true
    },
    {
      "start": "//",
      "token": "comment"
    }
  ],
  "strings": [
    {
      "start": "$\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "start": "\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "start": "'",
      "end": "'",
      "escape": "\\"
    }
  ],
  "keywords": {
    "keyword": [
      "if",
      "else",
      "for",
      "while",
      "do",
      "switch",
      "case",
      "default",
      "break",
      "continue",
      "return",
      "goto",
      "foreach",
      "in",
      "rev",
      "defer",
      "static",
      "static_assert",
      "typedef",
      "struct",
      "union",
      "enum",
      "class",
      "const",
      "var",
      "extern",
      "sizeof",
      "asm",
      "module",
      "import",
      "a_module",
      "a_import",
      "public",
      "private",
      "protected",
      "virtual",
      "override",
      "final",
      "abstract",
      "super",
      "this",
      "new",
      "is",
      "as",
      "operator",
      "and",
      "or",
      "not",
      "xor"
    ],
    "type": [
      "int",
      "char",
      "bool",
      "void",
      "long",
      "byte",
      "double",
      "float",
      "func",
      "int8",
      "int16",
      "int32",
      "int64",
      "uint8",
      "uint16",
      "uint32",
      "uint64",
      "size_t",
      "uintptr_t",
      "ssize_t",
      "intptr_t",
      "ptrdiff_t",
      "short",
      "signed",
      "unsigned"
    ],
    "constant": [
      "true",
      "false",
      "null",
      "__ARCH",
      "__OS",
      "__ARCH__",
      "__OS__",
      "__A__",
      "__FILE__",
      "__LINE__",
      "__VA_ARGS__"
    ],
    "builtin": [
      "print",
      "println",
      "printInt",
      "printlnInt",
      "printChar",
      "printBool",
      "printHex",
      "eprint",
      "eprintln",
      "readChar",
      "readLine",
      "input",
      "askInt",
      "confirm",
      "readAll",
      "parseInt",
      "atoi",
      "format",
      "printf",
      "vformat",
      "sprintf",
      "snprintf",
      "fprintf",
      "dprintf",
      "asprintf",
      "printRepeat",
      "printColor",
      "clearScreen",
      "cursorTo",
      "isTerminal",
      "ansiInit",
      "hasArg",
      "argIndex",
      "argValue",
      "millis",
      "sleepMs",
      "strlen",
      "streq",
      "strcmp",
      "strcpy",
      "strcat",
      "strdup",
      "memcpy",
      "memset",
      "indexOf",
      "startsWith",
      "intToStr",
      "hexToStr",
      "isDigit",
      "isAlpha",
      "isUpper",
      "isLower",
      "isSpace",
      "toUpper",
      "toLower",
      "endsWith",
      "find",
      "contains",
      "substr",
      "trim",
      "strUpper",
      "strLower",
      "streqi",
      "abs",
      "min",
      "max",
      "srand",
      "rand",
      "fileOpen",
      "fileRead",
      "fileWrite",
      "fileClose",
      "readFile",
      "writeFile",
      "getEnv",
      "fileExists",
      "fileDelete",
      "makeDir",
      "exit",
      "alloc",
      "malloc",
      "calloc",
      "realloc",
      "free",
      "va_arg",
      "va_count"
    ]
  },
  "operators": [
    "<<=",
    ">>=",
    "||=",
    "&&=",
    "??=",
    "<=>",
    "..=",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "^^",
    "??",
    "++",
    "--",
    "->",
    "=>",
    "::",
    "..",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "&=",
    "|=",
    "^=",
    "<<",
    ">>",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "=",
    "!",
    "&",
    "|",
    "^",
    "~",
    "?",
    ":"
  ],
  "rules": [
    {
      "match": "^[ \\t]*#[ \\t]*[a-z_]+",
      "token": "preproc"
    },
    {
      "match": "^[ \\t]*[A-Za-z_][A-Za-z0-9_]*(?=:(?!:))",
      "token": "label"
    },
    {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?=[ \\t]*\\()",
      "token": "function"
    },
    {
      "match": "[A-Z][A-Z0-9_]{2,}\\b",
      "token": "constant"
    },
    {
      "match": "[A-Z][A-Za-z0-9_]*\\b",
      "token": "type"
    }
  ]
}
