# bash completion for ac, the compiler of the A language (Aytict, https://aytict.fi)
_ac() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    case "$prev" in
        -t)
            COMPREPLY=( $(compgen -W "linux linux-x64 linux-arm64 linux-riscv64 linux-rv64 linux-loongarch64 linux-la64 windows win win64 android android-arm64 android-x64 android-riscv64 android-rv64 android-loongarch64" -- "$cur") )
            return ;;
        -r)
            COMPREPLY=( $(compgen -W "debug release" -- "$cur") )
            return ;;
        -o)
            compopt -o filenames 2>/dev/null
            COMPREPLY=( $(compgen -f -- "$cur") )
            return ;;
        -v|-D)
            return ;;
    esac
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "-o -t -c -D -E -v -r -h --version" -- "$cur") )
    else
        compopt -o filenames 2>/dev/null
        COMPREPLY=( $(compgen -f -X '!*.@(a|ao|am)' -- "$cur") $(compgen -d -- "$cur") )
    fi
}
complete -F _ac ac
