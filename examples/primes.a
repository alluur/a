// Number theory with the math module:   ./primes 100
import math;

int main(int argc, char** argv) {
    int limit = 50;
    if (argc > 1) {
        limit = atoi(argv[1]);
    }
    printf("primes up to %d:", limit, 0, 0, 0);
    for (int n = 2; n <= limit; n++) {
        if (math.isPrime(n)) printf(" %d", n, 0, 0, 0);
    }
    println("");
    printf("gcd(84, 36) = %d, lcm(84, 36) = %d\n", math.gcd(84, 36), math.lcm(84, 36), 0, 0);
    printf("2^40 = %d, 20! = %d, fib(50) = %d\n", math.pow(2, 40), math.factorial(20), math.fibonacci(50), 0);
    printf("sqrt(1000000) = %d\n", math.isqrt(1000000), 0, 0, 0);
    return 0;
}
