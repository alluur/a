// ping HOST [count]
import netutil;
import net;

int main(int argc, char** argv) {
    if (argc < 2) { println("usage: ping HOST [count]"); return 1; }
    int count = 4;
    if (argc > 2) count = atoi(argv[2]);
    int ip = net.resolve(argv[1]);
    if (ip < 0) { print("cannot resolve "); println(argv[1]); return 1; }
    int lost = 0;
    for (int i = 0; i < count; i++) {
        int ms = netutil.ping(argv[1], 1000);
        if (ms == -2) { println("pinging is not allowed here; trying a TCP connection to port 80 instead");
                        ms = netutil.tcpPing(argv[1], 80, 1000); }
        if (ms < 0) { println("no answer"); lost++; }
        else { print("reply from "); print(argv[1]); print(": time="); printInt(ms); println(" ms"); }
        sleepMs(500);
    }
    printInt(count - lost); print(" of "); printInt(count); println(" answered");
    return 0;
}
