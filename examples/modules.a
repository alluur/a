// Using a module with import. The compiler finds modules/shapes.a next to this file.
import modules.shapes;

int main() {
    print("square 7x7 = ");  printlnInt(shapes.squareArea(7));
    print("rect 3x5   = ");  printlnInt(shapes.rectArea(3, 5));
    print("sides      = ");  printlnInt(shapes.SIDES_OF_SQUARE);
    print("secret     = ");  printlnInt(shapes.reveal());
    return 0;
}
