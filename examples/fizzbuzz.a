// FizzBuzz - loops, conditionals and the standard library
int main() {
    for (int i = 1; i <= 30; i++) {
        if (i % 15 == 0) {
            println("FizzBuzz");
        } else if (i % 3 == 0) {
            println("Fizz");
        } else if (i % 5 == 0) {
            println("Buzz");
        } else {
            printlnInt(i);
        }
    }
    return 0;
}
