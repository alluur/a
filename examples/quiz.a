// A multiplication quiz using random, log and the interactive input functions.   ./quiz
import random;
import log;

int main() {
    random.Random rng(random.clockSeed());
    int score = 0;
    int rounds = 5;
    log.setTimestamps(false);
    log.info("answer 5 questions - an empty line ends the quiz early");
    for (int i = 1; i <= rounds; i++) {
        int a = rng.range(2, 12);
        int b = rng.range(2, 12);
        char question[64];
        format(&question[0], 64, "Question %d: %d x %d = ", i, a, b, 0);
        char* answer = input(question);
        if (answer == null || strlen(answer) == 0) {
            break;
        }
        int v;
        if (parseInt(answer, &v) && v == a * b) {
            printColor(ANSI_GREEN, "correct!\n");
            score++;
        } else {
            printf("no, it is %d\n", a * b, 0, 0, 0);
        }
    }
    printf("score: %d of %d\n", score, rounds, 0, 0);
    return 0;
}
