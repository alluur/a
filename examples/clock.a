// Dates and times with the datetime module (UTC).
import datetime;

int main() {
    datetime.DateTime* now = new datetime.DateTime(datetime.now());
    printf("Today is %s, %d %s %d\n", (int)datetime.weekdayName(now->weekday), now->day,
           (int)datetime.monthName(now->month), now->year);
    println(now->toString());
    int ts = datetime.toUnix(2000, 1, 1, 0, 0, 0);
    printf("2000-01-01 00:00:00 UTC is %d seconds after 1970\n", ts, 0, 0, 0);
    int days = (datetime.now() - ts) / 86400;
    printf("That was %d days ago.\n", days, 0, 0, 0);
    return 0;
}
