// A to-do list stored in todo.txt.
//   ./todo add Buy milk      ./todo list      ./todo done 2      ./todo clear
const FILE = "todo.txt";

void usage() {
    println("usage: todo add <text> | list | done <number> | clear");
}

int main(int argc, char** argv) {
    if (argc < 2) {
        usage();
        return 1;
    }
    char* cmd = argv[1];
    char* text = readFile(FILE);
    if (text == null) {
        text = "";
    }
    if (streq(cmd, "add") && argc > 2) {
        int h = fileOpen(FILE, FILE_APPEND);
        for (int i = 2; i < argc; i++) {
            if (i > 2) fileWrite(h, " ", 1);
            fileWrite(h, argv[i], strlen(argv[i]));
        }
        fileWrite(h, "\n", 1);
        fileClose(h);
        println("added");
    } else if (streq(cmd, "list")) {
        int n = 1;
        int start = 0;
        for (int i = 0; ; i++) {
            if (text[i] == 10 || text[i] == 0) {
                if (i > start) {
                    printf("%3d. ", n, 0, 0, 0);
                    __write(1, &text[start], i - start);
                    println("");
                    n++;
                }
                start = i + 1;
                if (text[i] == 0) break;
            }
        }
        if (n == 1) println("nothing to do!");
    } else if (streq(cmd, "done") && argc > 2) {
        int target = atoi(argv[2]);
        char* out = alloc(strlen(text) + 1);
        int o = 0;
        int n = 1;
        int start = 0;
        for (int i = 0; ; i++) {
            if (text[i] == 10 || text[i] == 0) {
                if (i > start) {
                    if (n != target) {
                        memcpy(&out[o], &text[start], i - start + 1);
                        o = o + i - start + 1;
                    }
                    n++;
                }
                start = i + 1;
                if (text[i] == 0) break;
            }
        }
        writeFile(FILE, out);
        println("done");
    } else if (streq(cmd, "clear")) {
        writeFile(FILE, "");
        println("cleared");
    } else {
        usage();
        return 1;
    }
    return 0;
}
