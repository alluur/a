// Builds an ARP request, a UDP datagram and a TCP SYN, prints them like tcpdump and saves a capture file
// that Wireshark can open (packets.pcap)
import packet;
import netaddr;

int main() {
    char me[6];    netaddr.macParse("02:00:00:00:00:01", me);
    char peer[6];  netaddr.macParse("02:00:00:00:00:02", peer);
    int a = netaddr.ipParse("192.168.1.10");
    int b = netaddr.ipParse("192.168.1.1");
    packet.PcapWriter* pcap = new packet.PcapWriter("packets.pcap");
    char frame[200];
    char l4[100];
    char ip[200];

    int n = packet.arpRequestFrame(me, a, b, frame);
    println(packet.describe(frame, n));
    print(packet.hexdump(frame, n));
    pcap->write(frame, n, 1, 0);

    n = packet.arpReplyFrame(peer, b, me, a, frame);
    println(packet.describe(frame, n));
    pcap->write(frame, n, 1, 1000);

    int u = packet.udpBuild(a, b, 40000, 53, "query", 5, l4);
    int i = packet.ipBuild(a, b, packet.PROTO_UDP, 64, 1, l4, u, ip);
    n = packet.ethBuild(peer, me, packet.ETH_IPV4, ip, i, frame);
    println(packet.describe(frame, n));
    pcap->write(frame, n, 1, 2000);

    int t = packet.tcpBuild(a, b, 50000, 80, 1, 0, packet.TCP_SYN, 64240, 1460, "", 0, l4);
    i = packet.ipBuild(a, b, packet.PROTO_TCP, 64, 2, l4, t, ip);
    n = packet.ethBuild(peer, me, packet.ETH_IPV4, ip, i, frame);
    println(packet.describe(frame, n));
    pcap->write(frame, n, 1, 3000);
    pcap->close();
    println("saved packets.pcap");
    return 0;
}
