// Like cat: prints the files named on the command line (or standard input with no arguments).
//   ./cat file1 file2        ./cat -n file      (-n numbers the lines)
int main(int argc, char** argv) {
    bool numbered = hasArg(argc, argv, "-n");
    int count = 0;
    int lineNo = 1;
    for (int i = 1; i < argc; i++) {
        if (argv[i][0] == '-') {
            continue;
        }
        char* text = readFile(argv[i]);
        if (text == null) {
            eprint("cat: cannot read ");
            eprintln(argv[i]);
            return 1;
        }
        count++;
        if (!numbered) {
            print(text);
            continue;
        }
        bool atStart = true;
        for (int k = 0; text[k] != 0; k++) {
            if (atStart) {
                printf("%5d  ", lineNo, 0, 0, 0);
                lineNo++;
                atStart = false;
            }
            printChar(text[k]);
            if (text[k] == 10) {
                atStart = true;
            }
        }
    }
    if (count == 0) {
        print(readAll());
    }
    return 0;
}
