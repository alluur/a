// Arbitrary precision arithmetic:   ./bignum 100      prints 100! and the 100th Fibonacci number
import bigint;

int main(int argc, char** argv) {
    int n = 50;
    if (argc > 1) {
        n = atoi(argv[1]);
    }
    bigint.BigInt* f = bigint.factorial(n);
    printf("%d! has %d digits:\n", n, f->digits(), 0, 0);
    println(f->toString());
    printf("fibonacci(%d) =\n", n, 0, 0, 0);
    println(bigint.fibonacci(n)->toString());
    println("2^256 =");
    println(bigint.pow(bigint.fromInt(2), 256)->toString());
    return 0;
}
