// arping INTERFACE ADDRESS: asks the local network who has an address (needs root / CAP_NET_RAW, Linux and Android)
import rawnet;
import netaddr;

int main(int argc, char** argv) {
    if (argc < 3) { println("usage: arping INTERFACE ADDRESS"); return 1; }
    int ip = netaddr.ipParse(argv[2]);
    if (ip < 0) { println("bad address"); return 1; }
    char mac[6];
    if (rawnet.arping(argv[1], ip, 2000, mac)) {
        print(argv[2]); print(" is at "); println(netaddr.macToText(mac));
        return 0;
    }
    println("no answer (or no permission to open packet sockets)");
    return 1;
}
