// A small FTP server (ftpd): a user with a password and a directory (the jail), read-only anonymous access to another one.
//   ftpd_demo [PORT [DIRECTORY [PASSWORD [CERTIFICATE.pem KEY.pem]]]]
//   ftp://ann:PASSWORD@localhost:PORT/   (any FTP client; the A client is  import ftp;  ftp.connect("ftp://...")); the password is not sent in the clear by the A client: use authTls NEVER for a test
// With a certificate and a key (PEM files, ECDSA P-256 or RSA) the server offers AUTH TLS (FTPS, RFC 4217) with encrypted data connections (PROT P).
import ftpd;
import tls;
import asys;

int main(int argc, char** argv) {
    int port = 2121;
    char* dir = "/tmp/ftp";
    char* password = "secret";
    if (argc > 1) port = atoi(argv[1]);
    if (argc > 2) dir = argv[2];
    if (argc > 3) password = argv[3];
    ftpd.Server* s = ftpd.newServer();
    if (argc > 5) {
        int cn = 0;
        int kn = 0;
        char* cert = asys.readFile(argv[4], &cn, 1000000, null);
        char* key = asys.readFile(argv[5], &kn, 1000000, null);
        if (cert == null || key == null) {
            println("cannot read the certificate or the key");
            return 1;
        }
        s->tlsConfig = tls.loadConfig(cert, key);
        if (s->tlsConfig == null) {
            println("the certificate or the key is not usable");
            return 1;
        }
    }
    s->addUser("ann", password, dir, ftpd.P_ALL);
    s->addAnonymous(dir, ftpd.P_READ | ftpd.P_LIST);
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("FTP server on port %d, directory %s\n", s->port, dir);
    s->run();
    return 0;
}
