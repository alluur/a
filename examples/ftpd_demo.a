// A small FTP server (ftpd): a user with a password and a directory (the jail), read-only anonymous access to another one.
//   ftpd_demo [PORT [DIRECTORY [PASSWORD]]]
//   ftp://ann:PASSWORD@localhost:PORT/   (any FTP client; the A client is  import ftp;  ftp.connect("ftp://...")); the password is not sent in the clear by the A client: use authTls NEVER for a test
import ftpd;

int main(int argc, char** argv) {
    int port = 2121;
    char* dir = "/tmp/ftp";
    char* password = "secret";
    if (argc > 1) port = atoi(argv[1]);
    if (argc > 2) dir = argv[2];
    if (argc > 3) password = argv[3];
    ftpd.Server* s = ftpd.newServer();
    s->addUser("ann", password, dir, ftpd.P_ALL);
    s->addAnonymous(dir, ftpd.P_READ | ftpd.P_LIST);
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("FTP server on port %d, directory %s\n", s->port, dir);
    s->run();
    return 0;
}
