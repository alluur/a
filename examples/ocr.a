// text -> picture -> binary -> picture -> text, and a neural network that reads the picture
import codec;
import nn;
import fixed;

nn.Network* net;
char* alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

int recognise(int* glyph) {
    return alphabet[net->predict(glyph)];
}

int main() {
    char* message = "HELLO A 2025";
    println(codec.textToBinary(message, " "));

    codec.Image* page = codec.textToImage(message, 2);
    print(codec.toAscii(page, 2));
    println(codec.imageToText(page, 0));

    // the picture as rows of 0 and 1 and back
    char* rows = codec.imageToBinary(page, 128);
    codec.Image* again = codec.binaryToImage(rows);
    println(codec.imageToText(again, 2));

    // teach a network the letters and digits of the font, then let it read the picture
    int n = strlen(alphabet);
    int* x = nn.vec(n * 40);
    int* t = nn.vec(n * n);
    codec.fontSet(alphabet, x, t);
    int sizes[3]; sizes[0] = 40; sizes[1] = 32; sizes[2] = n;
    net = new nn.Network(3, sizes, nn.ACT_TANH, nn.ACT_SOFTMAX);
    net->fit(x, t, n, 400, fixed.fromText("0.2"), 0);
    print("accuracy on the font: "); printInt(net->accuracy(x, t, n)); println("%");
    println(codec.imageToTextWith(page, 2, recognise));
    return 0;
}
