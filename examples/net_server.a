// A tiny TCP echo server:  ./net_server   then in another terminal:  ./net_client
import net;

int main() {
    int server = net.listen(9000, 8);
    if (server < 0) {
        println("cannot listen on port 9000");
        return 1;
    }
    println("echo server on port 9000 (stop with Ctrl+C)");
    char line[256];
    for (;;) {
        int client = net.accept(server);
        if (client < 0) {
            continue;
        }
        while (net.recvLine(client, line, 256) >= 0) {
            print("got: "); println(line);
            net.sendText(client, "echo: ");
            net.sendText(client, line);
            net.sendText(client, "\n");
        }
        net.close(client);
    }
    return 0;
}
