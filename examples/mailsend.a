// Sends one mail through an SMTP server (smtp and mail): the text of the message is read from standard input.
//   mailsend smtp://user:password@host:587 from@example.org to@example.org "Subject" < body.txt
import smtp;
import mail;

int main(int argc, char** argv) {
    if (argc < 5) {
        println("usage: mailsend URL FROM TO SUBJECT < body");
        return 2;
    }
    smtp.Client* c = smtp.connect(argv[1]);
    if (c == null) {
        printf("cannot send: %s\n", smtp.error());
        return 1;
    }
    mail.Message* m = mail.newMessage();
    if (!m->from(argv[2]) || !m->to(argv[3]) || !m->subject(argv[4])) {
        println("a bad address or subject");
        return 2;
    }
    char* body = readAll();
    m->text(body == null ? "" : body);
    smtp.Result* r = c->sendMessage(m);
    int rc = 0;
    if (r == null || !r->ok) {
        printf("not sent: %s\n", r == null ? smtp.error() : r->why());
        rc = 1;
    } else {
        printf("sent: %s\n", r->why());
    }
    c->quit();
    c->dispose();
    return rc;
}
