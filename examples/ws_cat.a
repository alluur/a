// A WebSocket client for the shell:  ws_cat URL [--deflate] [--insecure] [--protocol P] [--origin O] [--cookie C] [message ...]
// Sends every message as a text frame, prints each answer on a line, closes with 1000 and prints "closed CODE".
import websocket;

int main(int argc, char** argv) {
    if (argc < 2) { println("usage: ws_cat URL [--deflate] [--insecure] [--protocol P] [--origin O] [--cookie C] [message ...]"); return 1; }
    websocket.Options* o = new websocket.Options();
    int first = argc;
    for (int i = 2; i < argc; i++) {
        if (streq(argv[i], "--deflate")) o->deflate = true;
        else if (streq(argv[i], "--insecure")) o->verify = false;
        else if (streq(argv[i], "--protocol") && i + 1 < argc) { i++; o->protocols = argv[i]; }
        else if (streq(argv[i], "--origin") && i + 1 < argc) { i++; o->origin = argv[i]; }
        else if (streq(argv[i], "--cookie") && i + 1 < argc) { i++; o->cookie = argv[i]; }
        else { first = i; break; }
    }
    websocket.WebSocket* ws = websocket.connectWith(argv[1], o);
    if (ws == null) {
        printf("connect failed: %s (status %d)\n", websocket.error(), websocket.status());
        return 2;
    }
    printf("connected protocol=[%s] deflate=%d\n", ws->protocol, ws->deflate ? 1 : 0);
    for (int i = first; i < argc; i++) {
        ws->sendText(argv[i]);
        websocket.Message* m = ws->receiveMessage();
        if (m == null) { printf("closed %d\n", ws->closeCode); return 0; }
        println(m->data);
        m->dispose();
    }
    ws->closeWith(1000, "done");
    printf("closed %d\n", ws->closeCode);
    return 0;
}
