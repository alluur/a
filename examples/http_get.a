// Fetches a web page: http_get http://example.org/
import http;

int main(int argc, char** argv) {
    char* url = "http://example.org/";
    if (argc > 1) url = argv[1];
    http.Response* r = http.get(url);
    if (r == null) {
        print("error: "); println(http.error());
        return 1;
    }
    print("status "); printlnInt(r->status);
    println(r->body);
    return 0;
}
