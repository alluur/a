// Fetches a web page (http:// or https://):   http_get https://example.org/
// With --insecure the server certificate is not checked.
import http;

int main(int argc, char** argv) {
    char* url = "http://example.org/";
    for (int i = 1; i < argc; i++) {
        if (streq(argv[i], "--insecure")) {
            http.setVerify(false);
        } else {
            url = argv[i];
        }
    }
    http.Response* r = http.get(url);
    if (r == null) {
        print("error: "); println(http.error());
        return 1;
    }
    print("status "); printlnInt(r->status);
    println(r->body);
    return 0;
}
