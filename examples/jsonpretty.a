// Reformats JSON from standard input.   echo '{"a":[1,2,{"b":null}]}' | ./jsonpretty        (use -c for compact output)
import json;
import cli;

int main(int argc, char** argv) {
    cli.ArgParser p("jsonpretty", "Pretty prints or compacts JSON read from standard input");
    p.addFlag("-c,--compact", "write compact JSON instead of indented");
    if (!p.parse(argc, argv)) {
        return 1;
    }
    json.Json* doc = json.parse(readAll());
    if (doc == null) {
        eprint("invalid JSON: ");
        eprintln(json.errorMessage());
        return 1;
    }
    if (p.flag("-c")) {
        println(json.stringify(doc));
    } else {
        println(json.pretty(doc));
    }
    return 0;
}
