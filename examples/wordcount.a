// Like wc: counts lines, words and bytes of standard input.   cat file | ./wordcount
int main() {
    int lines = 0;
    int words = 0;
    int bytes = 0;
    bool inWord = false;
    for (;;) {
        int c = readChar();
        if (c < 0) {
            break;
        }
        bytes++;
        if (c == 10) {
            lines++;
        }
        if (isSpace(c)) {
            inWord = false;
        } else if (!inWord) {
            inWord = true;
            words++;
        }
    }
    printf("%7d lines %7d words %7d bytes\n", lines, words, bytes, 0);
    return 0;
}
