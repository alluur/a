// Interactive input: asks questions and answers back.   ./greet
int main() {
    char* name = input("What is your name? ");
    if (name == null) {
        return 1;
    }
    int age = askInt("How old are you? ");
    printf("Nice to meet you, %s! Next year you will be %d.\n", (int)name, age + 1, 0, 0);
    if (confirm("Do you like A so far? (y/n) ")) {
        println("Wonderful!");
    } else {
        println("We will try harder.");
    }
    return 0;
}
