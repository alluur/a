// Classes, constructors, public / private members and enums

enum Kind { Checking, Savings }

class Account {
    private int balance;
    private Kind kind;
    public char* owner;

    public Account(char* owner, Kind kind, int opening) {
        this.owner = owner;
        this.kind = kind;
        balance = opening;
    }

    public bool withdraw(int amount) {
        if (amount > balance) {
            return false;
        }
        balance -= amount;
        return true;
    }

    public void deposit(int amount) { balance += amount; }
    public int getBalance() { return balance; }

    public void report() {
        print(owner);
        print(": ");
        printInt(balance);
        if (kind == Kind.Savings) {
            print(" (savings)");
        }
        println("");
    }
}

int main() {
    Account* a = new Account("Alice", Kind.Checking, 100);
    Account* b = new Account("Bob", Kind.Savings, 5000);
    a->deposit(50);
    if (!a->withdraw(500)) {
        println("Alice: insufficient funds");
    }
    b->withdraw(1200);
    a->report();
    b->report();
    // a->balance = 1;   // error: member is private to its class
    return 0;
}
