// A small MQTT 3.1.1 broker (mqttd): many clients in one thread, QoS 0 / 1 / 2, wildcards, retained messages, persistent sessions, wills, $SYS counters.
//   mqttd_demo [PORT [USER PASSWORD]]
//   mosquitto_sub -p PORT -t '#' -v        (or any MQTT client; the A client is  import mqtt;  mqtt.connect("mqtt://localhost:PORT"))
// With USER and PASSWORD anonymous clients are refused.
import mqttd;

int main(int argc, char** argv) {
    int port = 1883;
    if (argc > 1) {
        port = atoi(argv[1]);
    }
    mqttd.Server* s = mqttd.newServer();
    if (argc > 3) {
        s->broker->addUser(argv[2], argv[3]);
        s->broker->allowAnonymous = false;
    }
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("MQTT broker on port %d\n", s->port);
    s->run();
    return 0;
}
