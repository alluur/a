// Reads numbers from stdin and gives hints - run it as:  echo "50 25 37" | ./guess
const SECRET = 37;

int main() {
    char line[64];
    int tries = 0;
    while (readLine(line, 64) >= 0) {
        int guess = atoi(line);
        tries++;
        if (guess < SECRET) {
            println("higher");
        } else if (guess > SECRET) {
            println("lower");
        } else {
            print("correct after ");
            printInt(tries);
            println(" tries");
            return 0;
        }
    }
    println("out of input");
    return 1;
}
