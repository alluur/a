// algo2_bench: measures the speed of the matrix, stats and optim modules (operations per second on this machine). Usage:  ac examples/algo2_bench.a -o algo2_bench && ./algo2_bench
// The numbers in docs/ALGO.md come from this program (native x86-64, one run on a shared machine: expect +-20 percent). Doubles are soft float in A, so everything here
// is far slower than the same code on a CPU with a floating point unit; a "flop" below is one multiply-add.
import cstdio;
import asys;
import matrix;
import stats;
import optim;
import rng;
import dmath;

double sink = 0.0;

void report(char* name, double ops, int ms) {
    if (ms < 1) { ms = 1; }
    printf("| %-62s | %12d |\n", name, (int) (ops * 1000.0 / (double) ms));
}

rng.Xoshiro256* g;                    // set in main (a global cannot have constructor arguments)

double* randomArray(int n) {
    double* a = (double*) asys.alloc(n * 8);
    for (int i = 0; i < n; i++) { a[i] = g->nextDouble() * 2.0 - 1.0; }
    return a;
}

matrix.Matrix randomMatrix(int r, int c) {
    matrix.Matrix m(r, c);
    for (int i = 0; i < r * c; i++) { m.d[i] = g->nextDouble() * 2.0 - 1.0; }
    return m;
}

matrix.Matrix randomSpd(int n) {
    matrix.Matrix a = randomMatrix(n, n);
    matrix.Matrix at = a.transpose();
    matrix.Matrix p = at.mul(&a);
    for (int i = 0; i < n; i++) { p.d[i * n + i] += (double) n; }
    a.dispose();
    at.dispose();
    return p;
}

// ---- callbacks -----------------------------------------------------------------------------------------------------------------------------
double fCos(double x, void* c) { return dmath.cos(x) - x; }
double fExp(double x, void* c) { return dmath.exp(-x * x); }
double rosen(double* x, int n, void* c) { double a = 1.0 - x[0]; double b = x[1] - x[0] * x[0]; return a * a + 100.0 * b * b; }
void decay(double t, double* y, double* dy, int n, void* c) { dy[0] = -y[0]; dy[1] = y[0] - 0.5 * y[1]; }

void benchMatrix() {
    int t0 = millis();
    matrix.Matrix a = randomMatrix(100, 100);
    matrix.Matrix b = randomMatrix(100, 100);
    matrix.Matrix c(100, 100);
    int reps = 3;
    for (int r = 0; r < reps; r++) { a.mulInto(&b, &c); }
    report("Matrix.mulInto 100 x 100: flops", 1.0e6 * (double) reps, millis() - t0);
    a.dispose();
    b.dispose();
    c.dispose();

    matrix.Matrix m = randomMatrix(150, 150);
    t0 = millis();
    int n = 0;
    for (int r = 0; r < 3; r++) { matrix.LU f(&m); n++; sink += f.det(); f.dispose(); }
    report("LU factorization 150 x 150: flops (n^3 / 3)", 150.0 * 150.0 * 150.0 / 3.0 * (double) n, millis() - t0);
    matrix.LU f(&m);
    double* rhs = randomArray(150);
    double* x = randomArray(150);
    t0 = millis();
    for (int r = 0; r < 200; r++) { f.solve(rhs, x); }
    report("LU.solve of one right hand side (150 x 150): solves", 200.0, millis() - t0);
    f.dispose();
    m.dispose();

    matrix.Matrix s = randomSpd(120);
    t0 = millis();
    for (int r = 0; r < 3; r++) { matrix.Cholesky ch(&s); sink += ch.logDet(); ch.dispose(); }
    report("Cholesky 120 x 120: flops (n^3 / 3)", 120.0 * 120.0 * 120.0 / 3.0 * 3.0, millis() - t0);

    matrix.Matrix q = randomMatrix(120, 60);
    t0 = millis();
    for (int r = 0; r < 3; r++) { matrix.QR qr(&q); sink += qr.diagRatio(); qr.dispose(); }
    report("QR (Householder) 120 x 60: flops (2 m n^2)", 2.0 * 120.0 * 60.0 * 60.0 * 3.0, millis() - t0);
    q.dispose();

    t0 = millis();
    matrix.Matrix e = randomSpd(40);
    int ne = 0;
    for (int r = 0; r < 2; r++) { matrix.SymEigen se(&e); sink += se.values[0]; se.dispose(); ne++; }
    report("SymEigen (Jacobi) of a 40 x 40 matrix: decompositions", (double) ne, millis() - t0);
    e.dispose();
    s.dispose();

    matrix.Matrix w = randomMatrix(50, 30);
    t0 = millis();
    int nsv = 0;
    for (int r = 0; r < 2; r++) { matrix.SVD sv(&w); sink += sv.s[0]; sv.dispose(); nsv++; }
    report("SVD (one sided Jacobi) of a 50 x 30 matrix: decompositions", (double) nsv, millis() - t0);
    w.dispose();

    // sparse: a tridiagonal matrix of 20000 rows (about 60000 entries)
    int sn = 20000;
    matrix.CooBuilder cb(sn, sn);
    for (int i = 0; i < sn; i++) {
        cb.add(i, i, 4.0);
        if (i > 0) { cb.add(i, i - 1, -1.0); }
        if (i + 1 < sn) { cb.add(i, i + 1, -1.0); }
    }
    matrix.CsrMatrix sp = cb.build();
    cb.dispose();
    double* sx = randomArray(sn);
    double* sy = randomArray(sn);
    t0 = millis();
    for (int r = 0; r < 10; r++) { sp.mulVec(sx, sy); }
    report("CsrMatrix.mulVec (60000 entries): entries", 10.0 * (double) sp.nnz, millis() - t0);
    double* xs = (double*) asys.alloc(sn * 8);
    int iters = 0;
    t0 = millis();
    matrix.cg(&sp, sx, xs, 1000, 1.0e-10, &iters, true);
    report("cg on the 20000 x 20000 tridiagonal system: iterations", (double) iters, millis() - t0);
    asys.free((char*) xs);
    asys.free((char*) sx);
    asys.free((char*) sy);
    asys.free((char*) rhs);
    asys.free((char*) x);
    sp.dispose();
}

void benchStats() {
    int n = 200000;
    double* x = randomArray(n);
    double* y = randomArray(n);
    int t0 = millis();
    sink += stats.mean(x, n) + stats.variance(x, n, 1);
    report("mean + variance: numbers", (double) n * 2.0, millis() - t0);
    t0 = millis();
    sink += stats.median(x, n);
    report("median (sorts a copy): numbers", (double) n, millis() - t0);
    t0 = millis();
    sink += stats.correlation(x, y, n) + stats.skewness(x, n) + stats.kurtosis(x, n);
    report("correlation + skewness + kurtosis: numbers", (double) n * 3.0, millis() - t0);
    t0 = millis();
    sink += stats.spearman(x, y, 50000);
    report("spearman: numbers", 50000.0, millis() - t0);
    t0 = millis();
    stats.Welford w;
    w.addAll(x, n);
    sink += w.variance(1);
    report("Welford.add (4 moments): numbers", (double) n, millis() - t0);
    t0 = millis();
    stats.RollingStats rs(100);
    for (int i = 0; i < 50000; i++) { rs.add(x[i]); sink += rs.mean() + rs.median(); }
    report("RollingStats(100).add + mean + median: numbers", 50000.0, millis() - t0);
    rs.dispose();

    t0 = millis();
    for (int i = 0; i < 2000; i++) { sink += stats.normalCdf((double) (i % 7) * 0.5 - 1.5, 0.0, 1.0); }
    report("normalCdf", 2000.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 2000; i++) { sink += stats.tCdf((double) (i % 7) * 0.5 - 1.5, 9.0); }
    report("tCdf (9 degrees of freedom)", 2000.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 300; i++) { sink += stats.tQuantile(0.9 + (double) (i % 9) * 0.01, 9.0); }
    report("tQuantile", 300.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 500; i++) { sink += stats.gamma(1.5 + (double) (i % 9) * 0.37) + stats.lgamma(7.0 + (double) i); }
    report("gamma + lgamma", 1000.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 1000; i++) { sink += stats.incBeta(0.3 + (double) (i % 5) * 0.1, 2.5, 4.0); }
    report("incBeta", 1000.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 1000; i++) { sink += stats.binomPmf((double) (i % 50), 100.0, 0.3) + stats.poissonCdf((double) (i % 20), 8.0); }
    report("binomPmf + poissonCdf", 2000.0, millis() - t0);

    t0 = millis();
    matrix.Matrix X(2000, 4);
    double* yy = randomArray(2000);
    for (int i = 0; i < 8000; i++) { X.d[i] = g->nextDouble(); }
    stats.Regression r = stats.olsFit(&X, yy, true, null);
    sink += r.r2;
    r.dispose();
    report("olsFit with 2000 observations and 4 variables: fits", 1.0, millis() - t0);
    X.dispose();
    asys.free((char*) yy);

    t0 = millis();
    stats.TestResult tr = stats.ttestTwoSample(x, 20000, y, 20000, false, stats.TAIL_TWO);
    sink += tr.pvalue;
    report("ttestTwoSample of 2 x 20000 numbers: numbers", 40000.0, millis() - t0);
    t0 = millis();
    tr = stats.mannWhitney(x, 5000, y, 5000, stats.TAIL_TWO);
    sink += tr.pvalue;
    report("mannWhitney of 2 x 5000 numbers: numbers", 10000.0, millis() - t0);

    double* pts = randomArray(2 * 2000);
    t0 = millis();
    stats.KMeans km = stats.kmeans(pts, 2000, 2, 4, g, 100, 2);
    sink += km.inertia;
    report("kmeans (2000 points, k = 4, 2 restarts): points x restarts", 4000.0, millis() - t0);
    km.dispose();
    asys.free((char*) pts);
    asys.free((char*) x);
    asys.free((char*) y);
}

void benchOptim() {
    int t0 = millis();
    for (int i = 0; i < 300; i++) { optim.Result r = optim.brent(fCos, null, 0.0, 1.0, 1.0e-12, 100); sink += r.x; }
    report("brent: roots of cos(x) - x to 1e-12", 300.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 20; i++) { optim.Integral r = optim.gaussKronrod(fExp, null, -4.0, 4.0, 1.0e-12, 1.0e-12, 500); sink += r.value; }
    report("gaussKronrod: integrals of exp(-x^2) over [-4, 4] to 1e-12", 20.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 20; i++) { optim.Integral r = optim.romberg(fExp, null, -4.0, 4.0, 1.0e-12, 20); sink += r.value; }
    report("romberg: integrals of exp(-x^2) over [-4, 4] to 1e-12", 20.0, millis() - t0);
    double y0[2] = {1.0, 0.0};
    t0 = millis();
    int steps = 0;
    for (int i = 0; i < 20; i++) {
        optim.Rk45 s(decay, null, 2, 0.0, y0, 1.0e-9, 1.0e-12);
        s.solveTo(10.0, 100000);
        steps += s.nsteps;
        s.dispose();
    }
    report("Rk45: accepted steps of y' = f(t, y) (2 equations, to 1e-9)", (double) steps, millis() - t0);
    double p[2] = {-1.2, 1.0};
    t0 = millis();
    for (int i = 0; i < 5; i++) { p[0] = -1.2; p[1] = 1.0; optim.Result r = optim.bfgs(rosen, null, null, p, 2, 1.0e-6, 200); sink += r.fx; }
    report("bfgs with numerical gradient: Rosenbrock minimizations", 5.0, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 5; i++) { p[0] = -1.2; p[1] = 1.0; optim.Result r = optim.nelderMead(rosen, null, p, 2, 0.5, 1.0e-10, 20000); sink += r.fx; }
    report("nelderMead: Rosenbrock minimizations", 5.0, millis() - t0);

    int sizes[4] = {1024, 4096, 1000, 4099};
    for (int k = 0; k < 4; k++) {
        int n = sizes[k];
        double* re = randomArray(n);
        double* im = randomArray(n);
        optim.FftPlan plan(n);
        t0 = millis();
        int reps = 8;
        for (int r = 0; r < reps; r++) { plan.forward(re, im); plan.inverse(re, im); }
        char name[96];
        sprintf(name, "FftPlan: transforms of length %d (%s)", n, (n & (n - 1)) == 0 ? "radix 2" : "Bluestein");
        report(name, (double) (2 * reps), millis() - t0);
        plan.dispose();
        asys.free((char*) re);
        asys.free((char*) im);
    }
    double* ca = randomArray(2000);
    double* cb2 = randomArray(2000);
    double* co = (double*) asys.alloc(4000 * 8);
    t0 = millis();
    optim.convolve(ca, 2000, cb2, 2000, co);
    report("convolve of two 2000 number arrays (FFT): convolutions", 1.0, millis() - t0);
    asys.free((char*) ca);
    asys.free((char*) cb2);
    asys.free((char*) co);

    double coef[21];
    for (int i = 0; i <= 20; i++) { coef[i] = g->nextDouble() * 2.0 - 1.0; }
    coef[20] = 1.0;
    double re[20];
    double im[20];
    t0 = millis();
    for (int i = 0; i < 5; i++) { optim.polyRoots(coef, 20, re, im); }
    report("polyRoots of a polynomial of degree 20", 5.0, millis() - t0);

    // a dense linear program: maximize sum x_j subject to 30 random rows with positive entries <= 1
    int n = 30;
    int m = 30;
    double c[30];
    double A[900];
    double b[30];
    int kinds[30];
    double xs[30];
    for (int j = 0; j < n; j++) { c[j] = 1.0; }
    for (int i = 0; i < m; i++) { b[i] = 1.0; kinds[i] = optim.LE; for (int j = 0; j < n; j++) { A[i * n + j] = g->nextDouble() + 0.1; } }
    t0 = millis();
    double obj = 0.0;
    int st = 0;
    for (int i = 0; i < 5; i++) { st = optim.linprog(c, n, A, m, b, kinds, true, xs, &obj, null); sink += obj; }
    report("linprog (simplex): 30 variables and 30 constraints", 5.0, millis() - t0);
}

int main() {
    rng.Xoshiro256 generator(2024);
    g = &generator;
    printf("| operation (soft float, native x86-64)                          |   per second |\n");
    printf("|----------------------------------------------------------------|-------------:|\n");
    printf("| **matrix**\n");
    benchMatrix();
    printf("| **stats**\n");
    benchStats();
    printf("| **optim**\n");
    benchOptim();
    if (sink == 12345.678) { printf("never\n"); }
    return 0;
}
