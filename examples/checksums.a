// Hashes and encodings:   ./checksums "some text"
import hash;
import encoding;

int main(int argc, char** argv) {
    char* text = "hello world";
    if (argc > 1) {
        text = argv[1];
    }
    int n = strlen(text);
    printf("text    : %s\n", (int)text, 0, 0, 0);
    printf("crc32   : %x\n", hash.crc32(text, n), 0, 0, 0);
    printf("fnv1a   : %x\n", hash.fnv1a(text, n), 0, 0, 0);
    printf("sha256  : %s\n", (int)hash.sha256(text, n), 0, 0, 0);
    printf("base64  : %s\n", (int)encoding.base64Encode(text, n), 0, 0, 0);
    printf("hex     : %s\n", (int)encoding.hexEncode(text, n), 0, 0, 0);
    printf("url     : %s\n", (int)encoding.urlEncode(text), 0, 0, 0);
    return 0;
}
