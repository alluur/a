// A small calculator REPL:  type  "12 + 30"  or  "7 * 6"  (operators + - * / %), "quit" to leave.
int main() {
    char line[256];
    println("A calculator - type: number operator number, or quit");
    for (;;) {
        print("> ");
        if (readLine(line, 256) < 0) {
            break;
        }
        char* s = trim(line);
        if (s[0] == 0) {
            continue;
        }
        if (streqi(s, "quit")) {
            break;
        }
        // split "a op b" at the operator
        int pos = -1;
        for (int i = 1; s[i] != 0; i++) {
            char c = s[i];
            if (c == '+' || c == '-' || c == '*' || c == '/' || c == '%') {
                pos = i;
                break;
            }
        }
        if (pos < 0) {
            printColor(ANSI_RED, "expected: number operator number\n");
            continue;
        }
        char op = s[pos];
        s[pos] = 0;
        int a;
        int b;
        if (!parseInt(s, &a) || !parseInt(&s[pos + 1], &b)) {
            printColor(ANSI_RED, "those are not numbers\n");
            continue;
        }
        int r = 0;
        if (op == '+') r = a + b;
        else if (op == '-') r = a - b;
        else if (op == '*') r = a * b;
        else if (b == 0) {
            printColor(ANSI_YELLOW, "cannot divide by zero\n");
            continue;
        } else if (op == '/') r = a / b;
        else r = a % b;
        printColor(ANSI_GREEN, "= ");
        printlnInt(r);
    }
    println("bye");
    return 0;
}
