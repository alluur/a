// Statistics of the numbers on standard input (any whitespace or commas between them).
//   build:  ac -o stats stats.a        run:  echo "3 1 4 1 5 9 2 6" | ./stats
import clib;

int compare(char* a, char* b) {
    int x = ((int*) a)[0];
    int y = ((int*) b)[0];
    if (dlt(x, y)) {
        return -1;
    }
    if (dgt(x, y)) {
        return 1;
    }
    return 0;
}

// the value at fraction p (0 ... 1) of a sorted array, with linear interpolation
int percentile(int* v, int n, int p) {
    int rank = dmul(p, itod(n - 1));
    int lo = dtoi(floor(rank));
    int hi = lo + 1;
    if (hi >= n) {
        hi = n - 1;
    }
    int frac = dsub(rank, itod(lo));
    return dadd(v[lo], dmul(frac, dsub(v[hi], v[lo])));
}

int main() {
    char* text = readAll();
    int cap = 1024;
    int* v = (int*) malloc(cap * 8);
    int n = 0;
    char* p = text;
    for (;;) {
        while (*p == ' ' || *p == ',' || *p == 9 || *p == 10 || *p == 13) {
            p++;
        }
        if (*p == 0) {
            break;
        }
        char* end;
        int x = strtod(p, &end);
        if (end == p) {
            eprint("not a number: ");
            eprintln(substr(p, 0, 10));
            return 1;
        }
        p = end;
        if (n == cap) {
            cap = cap * 2;
            v = (int*) realloc((char*) v, cap * 8);
        }
        v[n] = x;
        n++;
    }
    if (n == 0) {
        println("no numbers");
        return 1;
    }
    qsort((char*) v, n, 8, compare);
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum = dadd(sum, v[i]);
    }
    int mean = ddiv(sum, itod(n));
    int sq = 0;
    for (int i = 0; i < n; i++) {
        int d = dsub(v[i], mean);
        sq = dadd(sq, dmul(d, d));
    }
    int variance = 0;
    if (n > 1) {
        variance = ddiv(sq, itod(n - 1));
    }
    printf("count    %d\n", n);
    printfd("sum      %.10g\n", sum);
    printfd("mean     %.10g\n", mean);
    printfd("stddev   %.10g\n", sqrt(variance));
    printfd("min      %.10g\n", v[0]);
    printfd("q1       %.10g\n", percentile(v, n, dlit("0.25")));
    printfd("median   %.10g\n", percentile(v, n, dlit("0.5")));
    printfd("q3       %.10g\n", percentile(v, n, dlit("0.75")));
    printfd("max      %.10g\n", v[n - 1]);
    return 0;
}
