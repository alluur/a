// A small Redis server (redisd): strings, lists, hashes, sets, sorted sets, expiry, pub/sub, transactions, 16 databases, over RESP2.
//   redisd_demo [PORT [PASSWORD]]
//   redis-cli -p PORT      (or any Redis client; the A client is  import redis;  redis.connect("redis://localhost:PORT"))
import redisd;

int main(int argc, char** argv) {
    int port = 6379;
    if (argc > 1) {
        port = atoi(argv[1]);
    }
    redisd.Server* s = redisd.newServer();
    if (argc > 2) {
        s->store->requirepass = argv[2];
    }
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("Redis server on port %d\n", s->port);
    s->run();
    return 0;
}
