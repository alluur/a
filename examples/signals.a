// Signal handlers (Linux and Android): press Ctrl-C up to three times; the fourth time ends the program.
// SIGALRM fires every second in between.     build:  ac -o signals signals.a
import clib;

int interrupts;
int ticks;

void onInterrupt(int sig) {
    interrupts++;
}

void onAlarm(int sig) {
    ticks++;
    alarm(1);
}

int main() {
    if (__OS == 1) {
        println("signals are not available on Windows");
        return 0;
    }
    signal(SIGINT, onInterrupt);
    signal(SIGALRM, onAlarm);
    alarm(1);
    println("press Ctrl-C ... (or wait 5 seconds)");
    int shown = 0;
    int ticksSeen = 0;
    while (interrupts < 4 && ticks < 5) {
        pause();
        if (interrupts != shown) {
            shown = interrupts;
            printf("interrupt %d\n", interrupts);
        }
        if (ticks != ticksSeen) {
            ticksSeen = ticks;
            printf("tick %d\n", ticks);
        }
    }
    println("bye");
    return 0;
}
