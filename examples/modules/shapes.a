// A module: everything declared in this file lives in the "shapes" namespace.
module shapes;

const SIDES_OF_SQUARE = 4;

public int squareArea(int side) { return side * side; }
public int rectArea(int w, int h) { return w * h; }

// private: only usable inside this file
private int secret() { return 42; }
public int reveal() { return secret(); }
