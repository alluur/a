// A drawing program.   ADISPLAY=0 ./paint
import gui;
import gfx;
import adp;

gui.Canvas* canvas;
gui.Slider* sizeSlider;
int ink = 0xFF202020;
int lastX = -1;
int lastY = -1;

// a colour swatch
class Swatch : gui.Widget {
    public int color;
    public Swatch(int c) {
        super();
        color = c;
        w = 26;
        h = 26;
    }
    public virtual int prefW() { return 26; }
    public virtual int prefH() { return 26; }
    public virtual void paint(gfx.Surface* s, int ox, int oy) {
        s->fillRoundRect(ox + 1, oy + 1, 24, 24, 4, color);
        s->roundRect(ox + 1, oy + 1, 24, 24, 4, (ink == color) ? gui.cAccent : gui.cBorder);
        if (ink == color) {
            s->roundRect(ox, oy, 26, 26, 5, gui.cAccent);
        }
    }
    public virtual bool onMouse(int kind, int button, int mx, int my, int mods) {
        if (kind == adp.M_DOWN && button == 1) {
            ink = color;
            if (win != null) {
                win->invalidateAll();
            }
        }
        return true;
    }
}

int mouse(int self) {
    gui.Canvas* c = (gui.Canvas*) self;
    int r = sizeSlider->value;
    if (c->lastKind == adp.M_DOWN && c->lastButton == 1) {
        canvas->surf->fillCircle(c->lastX, c->lastY, r, ink);
        lastX = c->lastX;
        lastY = c->lastY;
        c->invalidate();
    } else if (c->lastKind == adp.M_MOVE && lastX >= 0) {
        // fill the gap between the last and the new position with circles
        int dx = c->lastX - lastX;
        int dy = c->lastY - lastY;
        int steps = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
        if (steps < 1) { steps = 1; }
        for (int i = 1; i <= steps; i++) {
            canvas->surf->fillCircle(lastX + dx * i / steps, lastY + dy * i / steps, r, ink);
        }
        lastX = c->lastX;
        lastY = c->lastY;
        c->invalidate();
    } else if (c->lastKind == adp.M_UP) {
        lastX = -1;
    }
    return 0;
}

int clearClicked(int self) {
    canvas->surf->clear(0xFFFFFFFF);
    canvas->invalidate();
    return 0;
}

int saveClicked(int self) {
    canvas->surf->savePPM("painting.ppm");
    return 0;
}

int main() {
    gui.Display* d = gui.connectAs(null, "paint");
    if (d == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    gui.Window* w = d->createWindow("Paint", 520, 420, 0);
    gui.Box* col = gui.vbox(8, 8);
    gui.Box* bar = gui.hbox(6, 0);
    int colors[8] = {0xFF202020, 0xFFD03030, 0xFFE08020, 0xFFE0C820, 0xFF30A040, 0xFF3070D8, 0xFF8040C0, 0xFFFFFFFF};
    for (int i = 0; i < 8; i++) {
        bar->add(new Swatch(colors[i]));
    }
    bar->add(new gui.Label("Size"));
    sizeSlider = new gui.Slider(1, 24);
    sizeSlider->value = 4;
    bar->add(sizeSlider);
    gui.Button* clear = new gui.Button("Clear");
    clear->onClick = clearClicked;
    bar->add(clear);
    gui.Button* save = new gui.Button("Save");
    save->onClick = saveClicked;
    bar->add(save);
    col->add(bar);
    canvas = new gui.Canvas(480, 330);
    canvas->onMouseEvent = mouse;
    canvas->flex = 0;
    col->add(canvas);
    w->setRoot(col);
    w->fit();
    d->run();
    return 0;
}
