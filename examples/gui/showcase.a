// showcase - every widget of gui and guix in one window.   ADISPLAY=0 ./showcase
import gui;
import guix;
import adp;
import gfx;

gui.Display* disp;
gui.Label* info;
guix.StatusBar* status;
gui.ProgressBar* busyBar;

void say(char* s) {
    info->setText(s);
    status->setText(0, s);
}

int gotConfirm(int yes) { say(yes != 0 ? "You said yes" : "You said no"); return 0; }
int gotPrompt(int t) { if (t == 0) { say("Cancelled"); } else { say((char*) t); } return 0; }
int gotFile(int p) { if (p == 0) { say("No file chosen"); } else { say((char*) p); } return 0; }
int gotColor(int c) {
    char text[40];
    format(&text[0], 40, "Colour %06X", c & 0xFFFFFF);
    say(&text[0]);
    return 0;
}

int toolClicked(int self) {
    guix.IconButton* b = (guix.IconButton*) self;
    say(b->tooltip);
    return 0;
}
int doNotify(int self) { guix.notify(disp, "Hello", "This card goes away by itself after a few seconds (or click it).", 0, 4000); return 0; }
int doWarn(int self) { guix.notify(disp, "Careful", "Something needs your attention soon.", 1, 4000); return 0; }
int busyClicked(int self) {
    if (busyBar->busy) { busyBar->stop(); } else { busyBar->start(); }
    return 0;
}
int dateChosen(int self) {
    guix.Calendar* c = (guix.Calendar*) self;
    char text[40];
    format(&text[0], 40, "Date %04d-%02d-%02d", c->year, c->month, c->day);
    say(&text[0]);
    return 0;
}
int gotDate(int packed) {
    char text[40];
    format(&text[0], 40, "Chosen: %d", packed);
    say(&text[0]);
    return 0;
}
int askDate(int item) { guix.chooseDate(disp, "Choose a date", 0, 0, 0, gotDate); return 0; }
int askConfirm(int item) { guix.confirm(disp, "Question", "Do you like menus?", gotConfirm); return 0; }
int askText(int item) { guix.prompt(disp, "Name", "What is your name?", "", gotPrompt); return 0; }
int askOpen(int item) { guix.openFile(disp, "Open a file", ".", gotFile); return 0; }
int askSave(int item) { guix.saveFile(disp, "Save a file", ".", "file.txt", gotFile); return 0; }
int askColor(int item) { guix.chooseColor(disp, "Pick a colour", 0xFF3C78D8, gotColor); return 0; }
int quit(int item) { disp->quit = true; return 0; }
int checked(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    say(m->checked ? "Option on" : "Option off");
    return 0;
}
int picked(int self) {
    guix.ComboBox* c = (guix.ComboBox*) self;
    char text[80];
    format(&text[0], 80, "Combo: %s", c->text());
    say(&text[0]);
    return 0;
}
int radio(int self) {
    guix.RadioGroup* g = (guix.RadioGroup*) self;
    char text[80];
    format(&text[0], 80, "Radio %d", g->selectedIndex() + 1);
    say(&text[0]);
    return 0;
}
int spun(int self) {
    guix.SpinBox* s = (guix.SpinBox*) self;
    char text[80];
    format(&text[0], 80, "Spin %d", s->value);
    say(&text[0]);
    return 0;
}

gui.Box* choicesPage() {
    gui.Box* p = gui.vbox(8, 12);
    p->add(new gui.Label("Combo box"));
    guix.ComboBox* c = new guix.ComboBox();
    c->addItem("Apple");
    c->addItem("Banana");
    c->addItem("Cherry");
    c->addItem("Date");
    c->onChange = picked;
    c->tooltip = "Choose a fruit";
    p->add(c);
    p->add(new gui.Label("Radio buttons"));
    guix.RadioGroup* g = new guix.RadioGroup();
    g->onChange = radio;
    gui.Box* row = gui.hbox(12, 0);
    for (int i = 1; i <= 3; i++) {
        char t[16];
        format(&t[0], 16, "Option %d", i);
        row->add(new guix.RadioButton(&t[0], g));
    }
    g->selectIndex(0);
    p->add(row);
    p->add(new gui.Label("Spin box"));
    guix.SpinBox* s = new guix.SpinBox(-50, 50);
    s->onChange = spun;
    p->add(s);
    return p;
}

gui.Box* listPage() {
    // a list on the left, details on the right, with a divider that can be moved
    guix.Splitter* sp = new guix.Splitter(true, 130);
    gui.ListBox* list = new gui.ListBox();
    for (int i = 1; i <= 12; i++) {
        char t[24];
        format(&t[0], 24, "Item %d", i);
        list->addItem(&t[0]);
    }
    sp->add(list);
    gui.Box* many = gui.vbox(4, 8);
    for (int i = 1; i <= 40; i++) {
        char t[48];
        format(&t[0], 48, "A line of the scrolling view, number %d", i);
        many->add(new gui.Label(&t[0]));
    }
    guix.ScrollView* sv = new guix.ScrollView();
    sv->fitWidth = true;
    sv->setContent(many);
    sp->add(sv);
    gui.Box* p = gui.vbox(0, 4);
    sp->flex = 1;
    p->add(sp);
    return p;
}

gui.Box* morePage() {
    gui.Box* p = gui.vbox(8, 12);
    guix.TextBlock* t = new guix.TextBlock("A TextBlock wraps its text at the width of the window, so long explanations need no manual line breaks. Make the window narrower and the lines flow again.\nA new line starts after a newline.");
    p->add(t);
    gui.Box* row = gui.hbox(8, 0);
    gui.Button* n = new gui.Button("Notify");
    n->onClick = doNotify;
    row->add(n);
    gui.Button* wn = new gui.Button("Warn");
    wn->onClick = doWarn;
    row->add(wn);
    gui.Button* bz = new gui.Button("Busy on/off");
    bz->onClick = busyClicked;
    row->add(bz);
    p->add(row);
    busyBar = new gui.ProgressBar();
    p->add(busyBar);
    guix.Calendar* cal = new guix.Calendar();
    cal->onChange = dateChosen;
    p->add(cal);
    return p;
}

gui.Box* basicsPage() {
    gui.Box* p = gui.vbox(8, 12);
    p->add(new gui.Label("Hover the button for a tooltip"));
    gui.Button* b = new gui.Button("A button");
    b->tooltip = "Buttons can have tips";
    p->add(b);
    p->add(new gui.CheckBox("A check box"));
    gui.Slider* s = new gui.Slider(0, 100);
    s->tooltip = "Drag me";
    p->add(s);
    gui.ProgressBar* pb = new gui.ProgressBar();
    pb->setValue(60);
    p->add(pb);
    gui.TextBox* tb = new gui.TextBox();
    tb->placeholder = "Type here";
    p->add(tb);
    return p;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "showcase");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    info = new gui.Label("Ready");
    status = new guix.StatusBar();
    status->addSection(0);
    status->addSection(120);
    status->setText(0, "Ready");
    status->setText(1, "guix showcase");
    info->color = gui.cTextDim;
    gui.Window* w = disp->createWindow("Showcase", 520, 500, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Open...", askOpen)->accel("Ctrl+O");
    file->add("Save as...", askSave)->accel("Ctrl+S");
    file->addSeparator();
    file->add("Quit", quit)->accel("Ctrl+Q");
    guix.Menu* dialogs = bar->addMenu("&Dialogs");
    dialogs->add("Choose a date...", askDate);
    dialogs->add("Question...", askConfirm);
    dialogs->add("Ask for text...", askText);
    dialogs->add("Choose a colour...", askColor);
    guix.Menu* options = bar->addMenu("&Options");
    options->addCheck("Show something", true, checked);
    guix.Menu* sub = new guix.Menu();
    sub->addCheck("Fast", false, checked);
    sub->addCheck("Careful", true, checked);
    options->addSub("Mode", sub);
    col->add(bar);
    guix.Toolbar* tb = new guix.Toolbar();
    tb->addButton(guix.ICON_NEW, "New", toolClicked);
    tb->addButton(guix.ICON_OPEN, "Open", toolClicked);
    tb->addButton(guix.ICON_SAVE, "Save", toolClicked);
    tb->addSeparator();
    tb->addButton(guix.ICON_CUT, "Cut", toolClicked);
    tb->addButton(guix.ICON_COPY, "Copy", toolClicked);
    tb->addButton(guix.ICON_PASTE, "Paste", toolClicked);
    tb->addSeparator();
    tb->addButton(guix.ICON_UNDO, "Undo", toolClicked);
    tb->addButton(guix.ICON_REDO, "Redo", toolClicked);
    tb->addButton(guix.ICON_SEARCH, "Search", toolClicked);
    tb->addButton(guix.ICON_REFRESH, "Refresh", toolClicked);
    tb->addButton(guix.ICON_SETTINGS, "Settings", toolClicked);
    guix.IconButton* star = tb->addButton(guix.ICON_STAR, "Favourite (toggle)", toolClicked);
    star->toggle = true;
    col->add(tb);

    guix.TabView* tabs = new guix.TabView();
    tabs->flex = 1;
    tabs->addTab("Basics", basicsPage());
    tabs->addTab("Choices", choicesPage());
    tabs->addTab("Lists", listPage());
    tabs->addTab("More", morePage());
    gui.Box* body = gui.vbox(6, 8);
    body->flex = 1;
    body->add(tabs);
    col->add(body);
    col->add(status);
    w->setRoot(col);
    disp->run();
    return 0;
}
