// showcase - every widget of gui and guix in one window.   ADISPLAY=0 ./showcase
import gui;
import guix;
import adp;
import gfx;

gui.Display* disp;
gui.Label* info;

void say(char* s) {
    info->setText(s);
}

int gotConfirm(int yes) { say(yes != 0 ? "You said yes" : "You said no"); return 0; }
int gotPrompt(int t) { if (t == 0) { say("Cancelled"); } else { say((char*) t); } return 0; }
int gotFile(int p) { if (p == 0) { say("No file chosen"); } else { say((char*) p); } return 0; }
int gotColor(int c) {
    char text[40];
    format(&text[0], 40, "Colour %06X", c & 0xFFFFFF);
    say(&text[0]);
    return 0;
}

int askConfirm(int item) { guix.confirm(disp, "Question", "Do you like menus?", gotConfirm); return 0; }
int askText(int item) { guix.prompt(disp, "Name", "What is your name?", "", gotPrompt); return 0; }
int askOpen(int item) { guix.openFile(disp, "Open a file", ".", gotFile); return 0; }
int askSave(int item) { guix.saveFile(disp, "Save a file", ".", "file.txt", gotFile); return 0; }
int askColor(int item) { guix.chooseColor(disp, "Pick a colour", 0xFF3C78D8, gotColor); return 0; }
int quit(int item) { disp->quit = true; return 0; }
int checked(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    say(m->checked ? "Option on" : "Option off");
    return 0;
}
int picked(int self) {
    guix.ComboBox* c = (guix.ComboBox*) self;
    char text[80];
    format(&text[0], 80, "Combo: %s", c->text());
    say(&text[0]);
    return 0;
}
int radio(int self) {
    guix.RadioGroup* g = (guix.RadioGroup*) self;
    char text[80];
    format(&text[0], 80, "Radio %d", g->selectedIndex() + 1);
    say(&text[0]);
    return 0;
}
int spun(int self) {
    guix.SpinBox* s = (guix.SpinBox*) self;
    char text[80];
    format(&text[0], 80, "Spin %d", s->value);
    say(&text[0]);
    return 0;
}

gui.Box* choicesPage() {
    gui.Box* p = gui.vbox(8, 12);
    p->add(new gui.Label("Combo box"));
    guix.ComboBox* c = new guix.ComboBox();
    c->addItem("Apple");
    c->addItem("Banana");
    c->addItem("Cherry");
    c->addItem("Date");
    c->onChange = picked;
    c->tooltip = "Choose a fruit";
    p->add(c);
    p->add(new gui.Label("Radio buttons"));
    guix.RadioGroup* g = new guix.RadioGroup();
    g->onChange = radio;
    gui.Box* row = gui.hbox(12, 0);
    for (int i = 1; i <= 3; i++) {
        char t[16];
        format(&t[0], 16, "Option %d", i);
        row->add(new guix.RadioButton(&t[0], g));
    }
    g->selectIndex(0);
    p->add(row);
    p->add(new gui.Label("Spin box"));
    guix.SpinBox* s = new guix.SpinBox(-50, 50);
    s->onChange = spun;
    p->add(s);
    return p;
}

gui.Box* listPage() {
    // a list on the left, details on the right, with a divider that can be moved
    guix.Splitter* sp = new guix.Splitter(true, 130);
    gui.ListBox* list = new gui.ListBox();
    for (int i = 1; i <= 12; i++) {
        char t[24];
        format(&t[0], 24, "Item %d", i);
        list->addItem(&t[0]);
    }
    sp->add(list);
    gui.Box* many = gui.vbox(4, 8);
    for (int i = 1; i <= 40; i++) {
        char t[48];
        format(&t[0], 48, "A line of the scrolling view, number %d", i);
        many->add(new gui.Label(&t[0]));
    }
    guix.ScrollView* sv = new guix.ScrollView();
    sv->fitWidth = true;
    sv->setContent(many);
    sp->add(sv);
    gui.Box* p = gui.vbox(0, 4);
    sp->flex = 1;
    p->add(sp);
    return p;
}

gui.Box* basicsPage() {
    gui.Box* p = gui.vbox(8, 12);
    p->add(new gui.Label("Hover the button for a tooltip"));
    gui.Button* b = new gui.Button("A button");
    b->tooltip = "Buttons can have tips";
    p->add(b);
    p->add(new gui.CheckBox("A check box"));
    gui.Slider* s = new gui.Slider(0, 100);
    s->tooltip = "Drag me";
    p->add(s);
    gui.ProgressBar* pb = new gui.ProgressBar();
    pb->setValue(60);
    p->add(pb);
    gui.TextBox* tb = new gui.TextBox();
    tb->placeholder = "Type here";
    p->add(tb);
    return p;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "showcase");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    info = new gui.Label("Ready");
    info->color = gui.cTextDim;
    gui.Window* w = disp->createWindow("Showcase", 520, 440, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Open...", askOpen)->accel("Ctrl+O");
    file->add("Save as...", askSave)->accel("Ctrl+S");
    file->addSeparator();
    file->add("Quit", quit)->accel("Ctrl+Q");
    guix.Menu* dialogs = bar->addMenu("&Dialogs");
    dialogs->add("Question...", askConfirm);
    dialogs->add("Ask for text...", askText);
    dialogs->add("Choose a colour...", askColor);
    guix.Menu* options = bar->addMenu("&Options");
    options->addCheck("Show something", true, checked);
    guix.Menu* sub = new guix.Menu();
    sub->addCheck("Fast", false, checked);
    sub->addCheck("Careful", true, checked);
    options->addSub("Mode", sub);
    col->add(bar);

    guix.TabView* tabs = new guix.TabView();
    tabs->flex = 1;
    tabs->addTab("Basics", basicsPage());
    tabs->addTab("Choices", choicesPage());
    tabs->addTab("Lists", listPage());
    gui.Box* body = gui.vbox(6, 8);
    body->flex = 1;
    body->add(tabs);
    body->add(info);
    col->add(body);
    w->setRoot(col);
    disp->run();
    return 0;
}
