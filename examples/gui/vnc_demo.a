// A display server with a VNC backend and one program in the same process: connect a VNC viewer to localhost:5900.
//     ac examples/gui/vnc_demo.a && ./vnc_demo-1-debug.elf [seconds]
import wsrv;
import wvnc;
import gui;

wsrv.Server* server;
int clicks = 0;
gui.Label* counter;
gui.Slider* slider;
gui.ProgressBar* bar;

int stepServer(int x) {
    server->step(0);
    return 0;
}

int clicked(int self) {
    clicks++;
    char text[64];
    format(&text[0], 64, "Clicked %d times", clicks);
    counter->setText(&text[0]);
    println(&text[0]);
    return 0;
}

int moved(int self) {
    bar->setValue(slider->value);
    return 0;
}

int main(int argc, char** argv) {
    int seconds = 0;
    if (argc > 1) {
        seconds = atoi(argv[1]);
    }
    wvnc.Vnc* vnc = new wvnc.Vnc(800, 600, 5900, "127.0.0.1");
    if (!vnc->ok()) {
        println("cannot listen on port 5900");
        return 1;
    }
    server = new wsrv.Server(vnc, 7000);
    server->allowInject = true;
    gui.idleHook = stepServer;
    gui.Display* d = gui.connectAs("7000", "vnc-demo");
    gui.Window* w = d->createWindow("A demo", 300, 190, 0);
    gui.Box* col = gui.vbox(8, 12);
    counter = new gui.Label("Not clicked yet");
    col->add(counter);
    gui.Button* b = new gui.Button("Click me");
    b->primary = true;
    b->onClick = clicked;
    col->add(b);
    slider = new gui.Slider(0, 100);
    slider->onChange = moved;
    col->add(slider);
    bar = new gui.ProgressBar();
    col->add(bar);
    col->add(new gui.TextBox());
    w->setRoot(col);
    println("display :0 on 127.0.0.1:7000, VNC on 127.0.0.1:5900");
    int start = millis();
    while (!d->quit && (seconds == 0 || millis() - start < seconds * 1000)) {
        server->step(10);
        d->pump(0);
    }
    server->close();
    return 0;
}
