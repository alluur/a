// A calculator.   ADISPLAY=0 ./calc
import gui;
import adp;

gui.Label* display;
double stored = 0;
int pendingOp = 0;              // '+', '-', '*', '/' or 0
char entry[40];
bool fresh = true;              // the next digit starts a new number
bool errorState = false;

void show() {
    if (errorState) {
        display->setText("Error");
        return;
    }
    display->setText(&entry[0]);
}

void setEntry(char* s) {
    strcpy(&entry[0], s);
}

double valueOf() {
    return parseDouble(&entry[0]);
}

void putValue(double v) {
    if (isNaN(v) || isInf(v)) {
        errorState = true;
        return;
    }
    char* t = doubleToText(v);
    setEntry(t);
    int n = strlen(&entry[0]);
    if (n > 2 && entry[n - 1] == '0' && entry[n - 2] == '.') {
        entry[n - 2] = 0;
    }
}

void apply() {
    if (pendingOp == 0) {
        return;
    }
    double b = valueOf();
    double r = stored;
    if (pendingOp == '+') { r = stored + b; }
    if (pendingOp == '-') { r = stored - b; }
    if (pendingOp == '*') { r = stored * b; }
    if (pendingOp == '/') {
        if (b == 0.0) {
            errorState = true;
            return;
        }
        r = stored / b;
    }
    putValue(r);
    pendingOp = 0;
}

void press(int k) {
    if (errorState && k != 'C') {
        return;
    }
    if (k >= '0' && k <= '9') {
        if (fresh) {
            setEntry("");
            fresh = false;
        }
        int n = strlen(&entry[0]);
        if (n == 1 && entry[0] == '0') {
            n = 0;
        }
        if (n < 15) {
            entry[n] = k;
            entry[n + 1] = 0;
        }
    } else if (k == '.') {
        if (fresh) {
            setEntry("0");
            fresh = false;
        }
        if (indexOf(&entry[0], '.') < 0) {
            strcat(&entry[0], ".");
        }
    } else if (k == 'C') {
        errorState = false;
        stored = 0;
        pendingOp = 0;
        setEntry("0");
        fresh = true;
    } else if (k == 8) {
        int n = strlen(&entry[0]);
        if (!fresh && n > 1) {
            entry[n - 1] = 0;
        } else {
            setEntry("0");
        }
    } else if (k == 'n') {
        if (entry[0] == '-') {
            strcpy(&entry[0], &entry[1]);
        } else if (!(strlen(&entry[0]) == 1 && entry[0] == '0')) {
            char tmp[40];
            strcpy(&tmp[0], &entry[0]);
            setEntry("-");
            strcat(&entry[0], &tmp[0]);
        }
    } else if (k == '+' || k == '-' || k == '*' || k == '/') {
        if (pendingOp != 0 && !fresh) {
            apply();
        }
        stored = valueOf();
        pendingOp = k;
        fresh = true;
    } else if (k == '=') {
        apply();
        fresh = true;
    }
    show();
}

int buttonClicked(int self) {
    gui.Button* b = (gui.Button*) self;
    press(b->userData);
    return 0;
}

int keyPressed(int win, int key, int uni) {
    if (uni >= '0' && uni <= '9') { press(uni); }
    else if (uni == '.' || uni == ',') { press('.'); }
    else if (uni == '+' || uni == '-' || uni == '*' || uni == '/') { press(uni); }
    else if (key == adp.KEY_ENTER || uni == '=') { press('='); }
    else if (key == adp.KEY_BACKSPACE) { press(8); }
    else if (key == adp.KEY_ESCAPE || uni == 'c' || uni == 'C') { press('C'); }
    return 0;
}

gui.Button* makeKey(char* label, int code, bool accent) {
    gui.Button* b = new gui.Button(label);
    b->userData = code;
    b->onClick = buttonClicked;
    b->primary = accent;
    b->flex = 1;
    return b;
}

gui.Box* makeRow(char* a, int ca, char* b, int cb, char* c, int cc, char* d, int cd) {
    gui.Box* row = gui.hbox(6, 0);
    row->flex = 1;
    row->add(makeKey(a, ca, ca == 'C'));
    row->add(makeKey(b, cb, false));
    row->add(makeKey(c, cc, cc == '='));
    row->add(makeKey(d, cd, false));
    return row;
}

int main() {
    gui.Display* d = gui.connectAs(null, "calculator");
    if (d == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    setEntry("0");
    gui.Window* w = d->createWindow("Calculator", 240, 330, 0);
    w->onKey = keyPressed;
    gui.Box* col = gui.vbox(6, 8);
    display = new gui.Label("0");
    display->font = gfx.sansBold();
    display->align = 2;
    display->h = 40;
    col->add(display);
    col->add(makeRow("C", 'C', "+/-", 'n', "<-", 8, "/", '/'));
    col->add(makeRow("7", '7', "8", '8', "9", '9', "*", '*'));
    col->add(makeRow("4", '4', "5", '5', "6", '6', "-", '-'));
    col->add(makeRow("1", '1', "2", '2', "3", '3', "+", '+'));
    col->add(makeRow("0", '0', ".", '.', "=", '=', "", 0));
    w->setRoot(col);
    d->run();
    return 0;
}
