// aview - an image viewer for PNG, BMP and PPM files.   ADISPLAY=0 ./aview [file]
//   Ctrl+O open, Ctrl+S save as PNG, + / - zoom, 0 actual size, 9 fit to the window (the mouse wheel scrolls; Ctrl+wheel zooms).
import gui;
import guix;
import gimg;
import gfx;
import adp;
import path;

gui.Display* disp;
gui.Window* win;
guix.ScrollView* scroller;
gui.Label* status;
gfx.Surface* original;
int zoom = 100;             // percent
bool fitMode = true;
char* current = "";

void show() {
    if (original == null) {
        return;
    }
    win->update();                  // lays the window out, so that the size of the view is known
    int w = original->w;
    int h = original->h;
    gfx.Surface* shown = original;
    if (fitMode) {
        int availW = scroller->w - 4;
        int availH = scroller->h - 4;
        if (availW < 16) { availW = 16; }
        if (availH < 16) { availH = 16; }
        if (w > availW || h > availH) {
            shown = gimg.fit(original, availW, availH);
            zoom = shown->w * 100 / w;
        } else {
            zoom = 100;
        }
    } else if (zoom != 100) {
        shown = gimg.scale(original, w * zoom / 100, h * zoom / 100);
    }
    scroller->setContent(new gui.ImageView(shown));
    char text[200];
    format(&text[0], 200, "%s    %d x %d    %d%%", strlen(current) > 0 ? path.basename(current) : "", w, h, zoom);
    status->setText(&text[0]);
    win->setTitle(strlen(current) > 0 ? path.basename(current) : "Image viewer");
}

void loadFile(char* p) {
    gfx.Surface* s = gimg.load(p);
    if (s == null) {
        status->setText("Cannot read that image (PNG, BMP and PPM are supported)");
        return;
    }
    original = s;
    current = strdup(p);
    fitMode = true;
    show();
}

int gotOpen(int p) { if (p != 0) { loadFile((char*) p); } return 0; }
int gotSave(int p) {
    if (p != 0 && original != null) {
        status->setText(gimg.savePng(original, (char*) p) ? "Saved" : "Cannot write that file");
    }
    return 0;
}
int doOpen(int item) { guix.openFile(disp, "Open image", ".", gotOpen); return 0; }
int doSave(int item) { guix.saveFile(disp, "Save as PNG", ".", "image.png", gotSave); return 0; }
int doQuit(int item) { disp->quit = true; return 0; }
int zoomIn(int item) { fitMode = false; zoom = zoom * 5 / 4; if (zoom > 800) { zoom = 800; } show(); return 0; }
int zoomOut(int item) { fitMode = false; zoom = zoom * 4 / 5; if (zoom < 5) { zoom = 5; } show(); return 0; }
int zoomActual(int item) { fitMode = false; zoom = 100; show(); return 0; }
int zoomFit(int item) { fitMode = true; show(); return 0; }
int resized(int window) { if (fitMode) { show(); } return 0; }

// keys that no widget wanted: + - 0 9
int keyPressed(int window, int key, int uni) {
    if (uni == '+' || uni == '=') { zoomIn(0); }
    else if (uni == '-') { zoomOut(0); }
    else if (uni == '0') { zoomActual(0); }
    else if (uni == '9') { zoomFit(0); }
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "aview");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    win = disp->createWindow("Image viewer", 640, 480, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("Open...", doOpen)->accel("Ctrl+O");
    file->add("Save as PNG...", doSave)->accel("Ctrl+S");
    file->addSeparator();
    file->add("Quit", doQuit)->accel("Ctrl+Q");
    guix.Menu* view = bar->addMenu("&View");
    view->add("Zoom in", zoomIn)->accel("+");
    view->add("Zoom out", zoomOut)->accel("-");
    view->add("Actual size", zoomActual)->accel("0");
    view->add("Fit to window", zoomFit)->accel("9");
    col->add(bar);
    scroller = new guix.ScrollView();
    scroller->flex = 1;
    scroller->border = true;
    col->add(scroller);
    status = new gui.Label("Open an image with Ctrl+O");
    status->color = gui.cTextDim;
    col->add(status);
    win->setRoot(col);
    win->onKey = keyPressed;
    win->onResize = resized;
    if (argc > 1) {
        loadFile(argv[1]);
    }
    disp->run();
    return 0;
}
