// adm - the display manager.   adm [config-file]
//
// Starts the display server (framebuffer and / or VNC, see dm for the configuration keys), shows the login screen
// and runs the sessions of the users. Run it as root to log in system users (users = system) or as any user with a
// users file. Example configuration (/etc/adm/adm.conf):
//
//     port = 0
//     fb = /dev/fb0
//     layout = fi
//     vnc = 0
//     users = system
//     session = /usr/local/bin/asession Calc=/usr/local/bin/calc Notes=/usr/local/bin/notes
//     greeting = Welcome to this computer
import wsrv;
import wvnc;
import wfb;
import dm;

int main(int argc, char** argv) {
    dm.Config* cfg = new dm.Config();
    char* path = "/etc/adm/adm.conf";
    if (argc > 1) {
        path = argv[1];
    }
    if (!dm.loadConfig(cfg, path)) {
        eprint("no configuration file ");
        eprintln(path);
    }
    if (cfg->displayPort < 100) {
        cfg->displayPort = 7000 + cfg->displayPort;
    }
    wsrv.Backend* primary = null;
    if (!streq(cfg->fbDevice, "none")) {
        wfb.Framebuffer* fb = new wfb.Framebuffer(cfg->fbDevice, cfg->layout);
        if (fb->ok()) {
            fb->takeConsole = cfg->takeConsole;
            fb->grabConsole();
            primary = fb;
            cfg->width = fb->w;
            cfg->height = fb->h;
        } else {
            eprint("framebuffer: ");
            eprintln(fb->error());
        }
    }
    wvnc.Vnc* vnc = null;
    if (cfg->vncPort > 0) {
        if (cfg->vncPort < 100) {
            cfg->vncPort = 5900 + cfg->vncPort;
        }
        vnc = new wvnc.Vnc(cfg->width, cfg->height, cfg->vncPort, cfg->vncHost);
        if (!vnc->ok()) {
            eprintln("cannot listen on the VNC port");
            vnc = null;
        }
    }
    if (primary == null) {
        if (vnc != null) {
            primary = vnc;
            vnc = null;
        } else {
            primary = new wsrv.Headless(cfg->width, cfg->height);
            eprintln("no screen: running without output");
        }
    }
    wsrv.Server* srv = new wsrv.Server(primary, cfg->displayPort);
    if (!srv->ok) {
        eprintln("cannot listen on the display port");
        return 1;
    }
    if (vnc != null) {
        srv->addBackend(vnc);
    }
    dm.Manager* m = new dm.Manager(srv, cfg);
    printf("adm: display %d ready\n", cfg->displayPort);
    m->run();
    srv->close();
    return 0;
}
