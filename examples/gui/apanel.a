// apanel - a taskbar: a button for every window (click to show it, click again to minimize it), launchers and a clock.
//
//   apanel [Name=command]...        for example   apanel Terminal=aterm Files=afiles
// It lives at the bottom of the screen, above the other windows. Windows have a minimize button in their title bar too.
import gui;
import adp;
import datetime;
import cunistd;

gui.Display* disp;
gui.Box* tasks;
gui.Label* clock;
char* signature;
char** commands;
int ncommands;

int launch(int self) {
    gui.Button* b = (gui.Button*) self;
    char* cmd = commands[b->userData];
    int pid = fork();
    if (pid == 0) {
        char* argv[4];
        argv[0] = "/bin/sh";
        argv[1] = "-c";
        argv[2] = cmd;
        argv[3] = null;
        execv("/bin/sh", &argv[0]);
        _exit(127);
    }
    return 0;
}

int taskClicked(int self) {
    gui.Button* b = (gui.Button*) self;
    int gid = b->userData;
    bool wasFocusedAndShown = (b->primary);
    disp->windowCommand(gid, wasFocusedAndShown ? adp.WC_MINIMIZE : adp.WC_ACTIVATE);
    disp->requestWindowList();
    return 0;
}

char* shorten(char* t) {
    char* r = malloc(40);
    int n = strlen(t);
    if (n <= 24) {
        strcpy(r, t);
    } else {
        memcpy(r, t, 22);
        r[22] = '.';
        r[23] = '.';
        r[24] = 0;
    }
    return r;
}

// the server answered: rebuild the buttons when something changed
int gotList(int display) {
    char* sig = malloc(4096);
    sig[0] = 0;
    for (int i = 0; i < disp->nWinList && strlen(sig) < 3500; i++) {
        gui.WinInfo* wi = disp->winList[i];
        char piece[200];
        format(&piece[0], 200, "%d:%d:%s;", wi->gid, wi->state, wi->title);
        strcat(sig, &piece[0]);
    }
    if (signature != null && streq(sig, signature)) {
        return 0;
    }
    signature = sig;
    tasks->removeAll();
    for (int i = 0; i < disp->nWinList; i++) {
        gui.WinInfo* wi = disp->winList[i];
        gui.Button* b = new gui.Button(shorten(wi->title));
        b->userData = wi->gid;
        b->primary = ((wi->state & adp.WS_FOCUSED) != 0) && ((wi->state & adp.WS_MINIMIZED) == 0);
        b->enabled = true;
        b->onClick = taskClicked;
        if ((wi->state & adp.WS_MINIMIZED) != 0) {
            b->tooltip = "Minimized - click to show";
        }
        tasks->add(b);
    }
    return 0;
}

int poll(int arg) {
    disp->requestWindowList();
    disp->after(400, poll, 0);
    return 0;
}

int tick(int arg) {
    datetime.DateTime* t = new datetime.DateTime(datetime.now());
    char text[40];
    format(&text[0], 40, "%02d:%02d", t->hour, t->minute);
    clock->setText(&text[0]);
    int st = 0;
    while (waitpid(-1, &st, 1) > 0) {
    }
    disp->after(1000, tick, 0);
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "panel");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    int sw = disp->screenW;
    int sh = disp->screenH;
    gui.Window* w = disp->createWindowAt("panel", 0, sh - 36, sw, 36, adp.F_NODECOR | adp.F_ABOVE | adp.F_NOFOCUS);
    gui.Box* bar = gui.hbox(6, 4);
    bar->background = 0xFFE2E5EC;
    bar->border = 0xFF9CA0AA;
    commands = (char**) calloc(argc + 1, 8);
    for (int i = 1; i < argc; i++) {
        int eq = indexOf(argv[i], '=');
        if (eq <= 0) {
            continue;
        }
        char* name = malloc(eq + 1);
        memcpy(name, argv[i], eq);
        name[eq] = 0;
        gui.Button* b = new gui.Button(name);
        b->userData = ncommands;
        commands[ncommands] = &argv[i][eq + 1];
        ncommands++;
        b->onClick = launch;
        bar->add(b);
    }
    tasks = gui.hbox(4, 0);
    tasks->flex = 1;
    bar->add(tasks);
    clock = new gui.Label("");
    bar->add(clock);
    w->setRoot(bar);
    disp->onWinList = gotList;
    tick(0);
    poll(0);
    disp->run();
    return 0;
}
