// The smallest graphical program: a window with a label and a button.
//   start a display server first (examples/gui/adisplayd.a), then:  ADISPLAY=0 ./hello
import gui;

int count = 0;
gui.Label* label;

int clicked(int self) {
    count++;
    char text[64];
    format(&text[0], 64, "You clicked %d time%s", count, count == 1 ? "" : "s");
    label->setText(&text[0]);
    return 0;
}

int main() {
    gui.Display* d = gui.connectAs(null, "hello");
    if (d == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    gui.Window* w = d->createWindow("Hello", 280, 120, 0);
    gui.Box* col = gui.vbox(10, 14);
    label = new gui.Label("Press the button");
    col->add(label);
    gui.Button* b = new gui.Button("Click me");
    b->primary = true;
    b->onClick = clicked;
    col->add(b);
    w->setRoot(col);
    w->fit();
    d->run();
    return 0;
}
