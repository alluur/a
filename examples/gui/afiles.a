// afiles - a file browser: folders on the left (a tree), the files of the selected folder on the right (a table).
//   ADISPLAY=0 ./afiles [folder]      Click a column header to sort, double-click a file to open it (images with aview,
//   everything else with notes; both have to be in PATH), double-click a folder to enter it.
import gui;
import guix;
import path;
import os;
import cunistd;
import cstdlib;

gui.Display* disp;
guix.TreeView* tree;
guix.TableView* table;
gui.Label* status;
char* currentDir;

bool isDir(char* p) {
    Stat sb;
    return stat(p, &sb) == 0 && S_ISDIR(sb.st_mode);
}

int fileSizeOf(char* p) {
    Stat sb;
    if (stat(p, &sb) != 0) {
        return 0;
    }
    return sb.st_size;
}

char* pathOf(guix.TreeNode* n) {
    return (char*) n->userData;
}

char* sizeText(int n) {
    char* t = malloc(24);
    if (n < 1024) { format(t, 24, "%d B", n); }
    else if (n < 1024 * 1024) { format(t, 24, "%d KB", n / 1024); }
    else { format(t, 24, "%d MB", n / (1024 * 1024)); }
    return t;
}

// the sub folders of a node, added as children (sorted by name)
void loadChildren(guix.TreeNode* node) {
    node->clear();
    char* names[1024];
    int n = os.listDir(pathOf(node), &names[0], 1024);
    for (int i = 1; i < n; i++) {
        char* v = names[i];
        int j = i - 1;
        while (j >= 0 && strcasecmp(v, names[j]) < 0) { names[j + 1] = names[j]; j--; }
        names[j + 1] = v;
    }
    for (int i = 0; i < n; i++) {
        if (names[i][0] == '.') { continue; }
        char* full = path.join(pathOf(node), names[i]);
        if (isDir(full)) {
            guix.TreeNode* k = node->add(names[i]);
            k->userData = (int) full;
            k->lazy = true;
        }
    }
}

int onExpand(int self) {
    loadChildren(tree->expandedNode);
    if (tree->expandedNode->count == 0) {
        tree->expandedNode->lazy = false;
    }
    return 0;
}

void fillTable(char* dir) {
    currentDir = dir;
    table->clear();
    char* names[2048];
    int n = os.listDir(dir, &names[0], 2048);
    int files = 0;
    for (int i = 0; i < n; i++) {
        if (names[i][0] == '.') { continue; }
        char* full = path.join(dir, names[i]);
        int r = table->addEmptyRow();
        table->setCell(r, 0, names[i]);
        if (isDir(full)) {
            table->setCell(r, 1, "");
            table->setCell(r, 2, "Folder");
        } else {
            table->setCell(r, 1, sizeText(fileSizeOf(full)));
            char* ext = path.extension(names[i]);
            table->setCell(r, 2, strlen(ext) > 0 ? ext : "File");
            files++;
        }
    }
    table->sortBy(0, true);
    char text[300];
    format(&text[0], 300, "%s    %d items", dir, table->rowCount());
    status->setText(&text[0]);
}

int treeSelected(int self) {
    if (tree->selected != null) {
        fillTable(pathOf(tree->selected));
    }
    return 0;
}

void run(char* prog, char* arg) {
    int pid = fork();
    if (pid == 0) {
        char* argv[3];
        argv[0] = prog;
        argv[1] = arg;
        argv[2] = null;
        execvp(prog, &argv[0]);
        _exit(127);
    }
}

int tableActivated(int self) {
    int r = table->selected;
    if (r < 0) { return 0; }
    char* name = table->cell(r, 0);
    char* full = path.join(currentDir, name);
    if (isDir(full)) {
        fillTable(full);
        return 0;
    }
    char* ext = path.extension(name);
    if (streqi(ext, ".png") || streqi(ext, ".bmp") || streqi(ext, ".ppm") || streqi(ext, ".pgm")) {
        run("aview", full);
    } else {
        run("notes", full);
    }
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "afiles");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    char* start = (argc > 1) ? argv[1] : os.getCwd();
    gui.Window* w = disp->createWindow("Files", 720, 460, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.Splitter* sp = new guix.Splitter(true, 220);
    sp->flex = 1;
    tree = new guix.TreeView();
    tree->onSelect = treeSelected;
    tree->onExpand = onExpand;
    guix.TreeNode* top = tree->addRoot("/");
    top->userData = (int) "/";
    top->lazy = true;
    table = new guix.TableView();
    table->addColumn("Name", 240);
    table->addColumn("Size", 80);
    table->addColumn("Type", 100);
    table->setAlign(1, 1);
    table->onActivate = tableActivated;
    sp->add(tree);
    sp->add(table);
    col->add(sp);
    status = new gui.Label("");
    status->color = gui.cTextDim;
    col->add(status);
    w->setRoot(col);
    tree->expand(top, true);
    fillTable(start);
    w->setFocus(table);
    disp->run();
    return 0;
}
