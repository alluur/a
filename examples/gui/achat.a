// achat - chat with the other computers on your network, no server needed.
//   ADISPLAY=0 ./achat [-n NAME] [-p TCPPORT] [-u UDPPORT] [-t UDPPORT]...
// (-t also announces to the achat on this computer that listens on that UDP port: for several chats on one machine)
// Every achat announces itself on the local network (UDP broadcast) and connects to the others it hears; the list on the left shows
// who is there. Chat > Connect... connects to an address by hand (host:port), for example over a VPN. A message that arrives while
// the window is in the background shows a notification. There is no encryption or login: use it on a network you trust.
import gui;
import guix;
import gnet;
import cstdlib;

gui.Display* disp;
gui.Window* win;
gnet.Chat* chat;
gui.ListBox* peers;
gui.TextArea* logView;
gui.TextBox* msgBox;
guix.StatusBar* status;
char* myName;

void append(char* line) {
    char* old = logView->text();
    char* t = malloc(strlen(old) + strlen(line) + 3);
    strcpy(t, old);
    strcat(t, line);
    strcat(t, "\n");
    logView->setText(t);
    // the end of the text is visible: the cursor goes there
    logView->onKey(1, adp.KEY_END, 0, adp.MOD_CTRL);
}

void refreshPeers() {
    peers->clear();
    for (int i = 0; i < chat->peerCount(); i++) {
        peers->addItem(chat->peerName(i));
    }
    char text[60];
    format(&text[0], 60, "%d online", chat->peerCount());
    status->setText(1, &text[0]);
}

int onEvent(int self) {
    gnet.Chat* c = (gnet.Chat*) self;
    char line[400];
    if (c->eventKind == 1) {
        format(&line[0], 400, "* %s joined", c->eventName);
        append(&line[0]);
        refreshPeers();
    } else if (c->eventKind == 2) {
        format(&line[0], 400, "* %s left", c->eventName);
        append(&line[0]);
        refreshPeers();
    } else if (c->eventKind == 3) {
        format(&line[0], 400, "<%s> %s", c->eventName, c->eventText);
        append(&line[0]);
        if (!win->focused) {
            guix.notify(disp, c->eventName, c->eventText, 0, 5000);
        }
    }
    return 0;
}

int doSend(int self) {
    char* t = msgBox->text();
    if (strlen(t) == 0) {
        return 0;
    }
    chat->say(t);
    char line[400];
    format(&line[0], 400, "<%s> %s", myName, t);
    append(&line[0]);
    msgBox->setText("");
    return 0;
}

int gotAddress(int p) {
    if (p == 0) {
        return 0;
    }
    char* text = (char*) p;
    int colon = indexOf(text, ':');
    char* host = strdup(text);
    int port = 7788;
    if (colon > 0) {
        host[colon] = 0;
        port = atoi(&text[colon + 1]);
    }
    if (!chat->connectTo(host, port)) {
        append("* cannot connect");
    }
    return 0;
}

int doConnect(int item) { guix.prompt(disp, "Connect", "Address (host or host:port):", "", gotAddress); return 0; }
int doQuit(int item) { disp->quit = true; return 0; }

int main(int argc, char** argv) {
    myName = getenv("USER");
    if (myName == null || strlen(myName) == 0) {
        myName = "guest";
    }
    int tcp = 7788;
    int udp = 7788;
    int targets[8];
    int ntargets = 0;
    for (int i = 1; i + 1 < argc; i = i + 2) {
        if (streq(argv[i], "-t") && ntargets < 8) { targets[ntargets] = atoi(argv[i + 1]); ntargets++; }
        else if (streq(argv[i], "-n")) { myName = argv[i + 1]; }
        else if (streq(argv[i], "-p")) { tcp = atoi(argv[i + 1]); }
        else if (streq(argv[i], "-u")) { udp = atoi(argv[i + 1]); }
    }
    disp = gui.connectAs(null, "achat");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    win = disp->createWindow("Chat", 620, 420, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* m = bar->addMenu("&Chat");
    m->add("Connect...", doConnect)->accel("Ctrl+K");
    m->addSeparator();
    m->add("Quit", doQuit)->accel("Ctrl+Q");
    col->add(bar);
    guix.Splitter* sp = new guix.Splitter(true, 150);
    sp->flex = 1;
    peers = new gui.ListBox();
    logView = new gui.TextArea();
    logView->readOnly = true;
    sp->add(peers);
    gui.Box* right = gui.vbox(6, 6);
    logView->flex = 1;
    right->add(logView);
    gui.Box* row = gui.hbox(6, 0);
    msgBox = new gui.TextBox();
    msgBox->flex = 1;
    msgBox->placeholder = "Say something";
    msgBox->onEnter = doSend;
    row->add(msgBox);
    gui.Button* b = new gui.Button("Send");
    b->primary = true;
    b->onClick = doSend;
    row->add(b);
    right->add(row);
    sp->add(right);
    col->add(sp);
    status = new guix.StatusBar();
    status->addSection(0);
    status->addSection(100);
    col->add(status);
    win->setRoot(col);
    win->setFocus(msgBox);

    chat = new gnet.Chat(myName, tcp, udp);
    chat->onEvent = onEvent;
    for (int i = 0; i < ntargets; i++) {
        chat->addTarget(0x7F000001, targets[i]);
    }
    char text[100];
    if (!chat->start(disp)) {
        format(&text[0], 100, "Cannot listen on port %d (is another achat running? use -p and -u)", tcp);
        append(&text[0]);
        status->setText(0, "not connected");
    } else {
        format(&text[0], 100, "%s, listening on port %d", myName, chat->tcpPort);
        status->setText(0, &text[0]);
        append("* looking for other chats on this network...");
    }
    refreshPeers();
    disp->run();
    chat->stop();
    return 0;
}
