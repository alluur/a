// anet - network tools: interfaces, connections, ARP and routes, DNS lookups, HTTP fetches and a port scanner.
//   ADISPLAY=0 ./anet
// The HTTP fetch and the port scan do not freeze the window (see gnet); the lists can be refreshed with F5.
import gui;
import guix;
import gnet;
import netif;
import netaddr;
import netutil;
import dns;
import http;
import net;

gui.Display* disp;
gui.Window* win;
guix.StatusBar* status;

// ---- interfaces, ARP, routes, connections ----------------------------------------------------------------------------------------
guix.TableView* ifaces;
guix.TableView* conns;
guix.TableView* arp;
guix.TableView* routes;

char* num(int v) {
    char* t = malloc(24);
    format(t, 24, "%d", v);
    return t;
}

void fillInterfaces() {
    ifaces->clear();
    for (int i = 0; i < netif.interfaceCount(); i++) {
        netif.Iface* f = netif.interfaceAt(i);
        int r = ifaces->addEmptyRow();
        ifaces->setCell(r, 0, &f->name[0]);
        ifaces->setCell(r, 1, f->ip != 0 ? netaddr.ipToText(f->ip) : "");
        ifaces->setCell(r, 2, f->mask != 0 ? netaddr.ipToText(f->mask) : "");
        ifaces->setCell(r, 3, netaddr.macToText(&f->mac[0]));
        ifaces->setCell(r, 4, f->isUp() ? "up" : "down");
        ifaces->setCell(r, 5, num(f->rxBytes / 1024));
        ifaces->setCell(r, 6, num(f->txBytes / 1024));
    }
}

char* endpoint(int ip, int port) {
    char* t = malloc(40);
    format(t, 40, "%s:%d", netaddr.ipToText(ip), port);
    return t;
}

void fillConnections() {
    conns->clear();
    for (int i = 0; i < netif.connectionCount(); i++) {
        netif.Socket* s = netif.connectionAt(i);
        int r = conns->addEmptyRow();
        conns->setCell(r, 0, &s->proto[0]);
        conns->setCell(r, 1, endpoint(s->localIp, s->localPort));
        conns->setCell(r, 2, s->remoteIp != 0 || s->remotePort != 0 ? endpoint(s->remoteIp, s->remotePort) : "");
        conns->setCell(r, 3, netif.stateName(s->state));
    }
}

void fillArp() {
    arp->clear();
    for (int i = 0; i < netif.arpCount(); i++) {
        netif.ArpEntry* e = netif.arpAt(i);
        int r = arp->addEmptyRow();
        arp->setCell(r, 0, netaddr.ipToText(e->ip));
        arp->setCell(r, 1, netaddr.macToText(&e->mac[0]));
        arp->setCell(r, 2, &e->device[0]);
    }
}

void fillRoutes() {
    routes->clear();
    for (int i = 0; i < netif.routeCount(); i++) {
        netif.Route* e = netif.routeAt(i);
        int r = routes->addEmptyRow();
        routes->setCell(r, 0, e->dest == 0 ? "default" : netaddr.ipToText(e->dest));
        routes->setCell(r, 1, netaddr.ipToText(e->mask));
        routes->setCell(r, 2, e->gateway == 0 ? "" : netaddr.ipToText(e->gateway));
        routes->setCell(r, 3, num(e->metric));
        routes->setCell(r, 4, &e->device[0]);
    }
}

int refreshAll(int self) {
    fillInterfaces();
    fillConnections();
    fillArp();
    fillRoutes();
    status->setText(0, "Refreshed");
    return 0;
}

gui.Box* tablePage(guix.TableView* t) {
    gui.Box* p = gui.vbox(6, 8);
    gui.Button* b = new gui.Button("Refresh");
    b->onClick = refreshAll;
    t->flex = 1;
    p->add(t);
    p->add(b);
    return p;
}

// ---- DNS -------------------------------------------------------------------------------------------------------------------------------------
gui.TextBox* dnsName;
guix.ComboBox* dnsType;
guix.TableView* dnsAnswers;

int dnsTypeCode() {
    int s = dnsType->selected;
    if (s == 0) { return dns.A; }
    if (s == 1) { return dns.AAAA; }
    if (s == 2) { return dns.MX; }
    if (s == 3) { return dns.NS; }
    if (s == 4) { return dns.TXT; }
    if (s == 5) { return dns.CNAME; }
    return dns.A;
}

int doLookup(int self) {
    char* name = dnsName->text();
    dnsAnswers->clear();
    if (strlen(name) == 0) {
        return 0;
    }
    int n = dns.query(name, dnsTypeCode());
    if (n <= 0) {
        status->setText(0, n < 0 ? "No answer from the name server" : "No such record");
        return 0;
    }
    for (int i = 0; i < n; i++) {
        dns.Record* r = dns.recordAt(i);
        int row = dnsAnswers->addEmptyRow();
        dnsAnswers->setCell(row, 0, dns.typeName(r->type));
        dnsAnswers->setCell(row, 1, dns.recordText(r));
    }
    char text[80];
    format(&text[0], 80, "%d answers", n);
    status->setText(0, &text[0]);
    return 0;
}

gui.Box* dnsPage() {
    gui.Box* p = gui.vbox(8, 8);
    gui.Box* row = gui.hbox(8, 0);
    dnsName = new gui.TextBox();
    dnsName->flex = 1;
    dnsName->placeholder = "host name";
    dnsName->onEnter = doLookup;
    row->add(dnsName);
    dnsType = new guix.ComboBox();
    dnsType->addItem("A");
    dnsType->addItem("AAAA");
    dnsType->addItem("MX");
    dnsType->addItem("NS");
    dnsType->addItem("TXT");
    dnsType->addItem("CNAME");
    row->add(dnsType);
    gui.Button* go = new gui.Button("Look up");
    go->primary = true;
    go->onClick = doLookup;
    row->add(go);
    p->add(row);
    dnsAnswers = new guix.TableView();
    dnsAnswers->addColumn("Type", 80);
    dnsAnswers->addColumn("Value", 380);
    dnsAnswers->flex = 1;
    p->add(dnsAnswers);
    return p;
}

// ---- HTTP -------------------------------------------------------------------------------------------------------------------------------
gui.TextBox* urlBox;
gui.TextArea* headersView;
gui.TextArea* bodyView;
gui.ProgressBar* fetchBar;
gui.Button* fetchButton;
gnet.Fetch* current;
gui.Label* fetchInfo;

int fetchProgress(int self) {
    gnet.Fetch* f = (gnet.Fetch*) self;
    if (f->contentLength > 0) {
        fetchBar->setValue(f->received * 100 / f->contentLength);
    }
    char text[80];
    format(&text[0], 80, "%d bytes received", f->received);
    fetchInfo->setText(&text[0]);
    return 0;
}

int fetchDone(int self) {
    gnet.Fetch* f = (gnet.Fetch*) self;
    fetchBar->stop();
    fetchBar->setValue(f->error == null ? 100 : 0);
    fetchButton->setText("Get");
    headersView->setText(f->headers);
    bodyView->setText(f->bodyLen > 200000 ? "(the body is too large to show)" : f->body);
    char text[200];
    if (f->error != null) {
        format(&text[0], 200, "%s", f->error);
    } else {
        format(&text[0], 200, "%d, %d bytes in %d ms", f->status, f->bodyLen, f->elapsed);
    }
    fetchInfo->setText(&text[0]);
    return 0;
}

int doFetch(int self) {
    if (current != null && current->running()) {
        current->cancel();
        return 0;
    }
    current = new gnet.Fetch();
    current->onProgress = fetchProgress;
    current->onDone = fetchDone;
    headersView->setText("");
    bodyView->setText("");
    fetchBar->setValue(0);
    if (current->start(disp, urlBox->text(), null)) {
        fetchBar->start();
        fetchButton->setText("Stop");
        fetchInfo->setText("Waiting...");
    } else {
        fetchInfo->setText(current->error);
    }
    return 0;
}

gui.Box* httpPage() {
    gui.Box* p = gui.vbox(8, 8);
    gui.Box* row = gui.hbox(8, 0);
    urlBox = new gui.TextBox();
    urlBox->flex = 1;
    urlBox->setText("http://127.0.0.1:8080/");
    urlBox->onEnter = doFetch;
    row->add(urlBox);
    fetchButton = new gui.Button("Get");
    fetchButton->primary = true;
    fetchButton->onClick = doFetch;
    row->add(fetchButton);
    p->add(row);
    fetchBar = new gui.ProgressBar();
    p->add(fetchBar);
    fetchInfo = new gui.Label("Enter an http:// address");
    fetchInfo->color = gui.cTextDim;
    p->add(fetchInfo);
    guix.Splitter* sp = new guix.Splitter(false, 110);
    sp->flex = 1;
    headersView = new gui.TextArea();
    headersView->readOnly = true;
    bodyView = new gui.TextArea();
    bodyView->readOnly = true;
    sp->add(headersView);
    sp->add(bodyView);
    p->add(sp);
    return p;
}

// ---- ports ----------------------------------------------------------------------------------------------------------------------------------
gui.TextBox* scanHost;
guix.SpinBox* scanFrom;
guix.SpinBox* scanTo;
gui.ListBox* scanList;
gui.ProgressBar* scanBar;
gui.Button* scanButton;
gnet.Scan* scan;

int scanFound(int self) {
    gnet.Scan* s = (gnet.Scan*) self;
    char text[40];
    format(&text[0], 40, "port %d is open", s->lastFound);
    scanList->addItem(&text[0]);
    return 0;
}

int scanProgress(int self) {
    gnet.Scan* s = (gnet.Scan*) self;
    scanBar->setValue((s->current - s->first) * 100 / (s->last - s->first + 1));
    return 0;
}

int scanFinished(int self) {
    gnet.Scan* s = (gnet.Scan*) self;
    scanButton->setText("Scan");
    char text[60];
    format(&text[0], 60, "Scan finished: %d open", s->found);
    status->setText(0, &text[0]);
    return 0;
}

int doScan(int self) {
    if (scan != null && scan->running) {
        scan->stop();
        scanButton->setText("Scan");
        return 0;
    }
    scan = new gnet.Scan();
    scan->onFound = scanFound;
    scan->onProgress = scanProgress;
    scan->onDone = scanFinished;
    scanList->clear();
    scanBar->setValue(0);
    if (scan->start(disp, scanHost->text(), scanFrom->value, scanTo->value, 250)) {
        scanButton->setText("Stop");
    } else {
        status->setText(0, "Check the port range");
    }
    return 0;
}

gui.Box* portsPage() {
    gui.Box* p = gui.vbox(8, 8);
    gui.Box* row = gui.hbox(8, 0);
    scanHost = new gui.TextBox();
    scanHost->flex = 1;
    scanHost->setText("127.0.0.1");
    row->add(scanHost);
    row->add(new gui.Label("from"));
    scanFrom = new guix.SpinBox(1, 65535);
    scanFrom->setValue(1);
    row->add(scanFrom);
    row->add(new gui.Label("to"));
    scanTo = new guix.SpinBox(1, 65535);
    scanTo->setValue(1024);
    row->add(scanTo);
    scanButton = new gui.Button("Scan");
    scanButton->primary = true;
    scanButton->onClick = doScan;
    row->add(scanButton);
    p->add(row);
    scanBar = new gui.ProgressBar();
    p->add(scanBar);
    scanList = new gui.ListBox();
    scanList->flex = 1;
    p->add(scanList);
    return p;
}

// ---- timing ---------------------------------------------------------------------------------------------------------------------------
gui.TextBox* pingHost;
guix.SpinBox* pingPort;
gui.ListBox* pingList;

int doPing(int self) {
    char* host = pingHost->text();
    pingList->clear();
    for (int i = 0; i < 4; i++) {
        int ms = netutil.tcpPing(host, pingPort->value, 1500);
        char text[80];
        if (ms < 0) {
            format(&text[0], 80, "%s:%d  no answer", host, pingPort->value);
        } else {
            format(&text[0], 80, "%s:%d  connected in %d ms", host, pingPort->value, ms);
        }
        pingList->addItem(&text[0]);
    }
    return 0;
}

gui.Box* pingPage() {
    gui.Box* p = gui.vbox(8, 8);
    gui.Box* row = gui.hbox(8, 0);
    pingHost = new gui.TextBox();
    pingHost->flex = 1;
    pingHost->setText("127.0.0.1");
    pingHost->onEnter = doPing;
    row->add(pingHost);
    row->add(new gui.Label("port"));
    pingPort = new guix.SpinBox(1, 65535);
    pingPort->setValue(80);
    row->add(pingPort);
    gui.Button* go = new gui.Button("Connect x4");
    go->primary = true;
    go->onClick = doPing;
    row->add(go);
    p->add(row);
    pingList = new gui.ListBox();
    pingList->flex = 1;
    p->add(pingList);
    return p;
}

int keyPressed(int window, int key, int uni) {
    if (key == adp.KEY_F1 + 4) {
        refreshAll(0);
    }
    return 0;
}

int main() {
    disp = gui.connectAs(null, "anet");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    win = disp->createWindow("Network tools", 700, 500, 0);
    gui.Box* col = gui.vbox(0, 0);
    guix.TabView* tabs = new guix.TabView();
    tabs->flex = 1;
    ifaces = new guix.TableView();
    ifaces->addColumn("Name", 90);
    ifaces->addColumn("Address", 120);
    ifaces->addColumn("Mask", 120);
    ifaces->addColumn("MAC", 140);
    ifaces->addColumn("State", 60);
    ifaces->addColumn("RX KB", 70);
    ifaces->addColumn("TX KB", 70);
    ifaces->setAlign(5, 1);
    ifaces->setAlign(6, 1);
    conns = new guix.TableView();
    conns->addColumn("Proto", 60);
    conns->addColumn("Local", 200);
    conns->addColumn("Remote", 200);
    conns->addColumn("State", 120);
    arp = new guix.TableView();
    arp->addColumn("Address", 160);
    arp->addColumn("MAC", 160);
    arp->addColumn("Device", 100);
    routes = new guix.TableView();
    routes->addColumn("Destination", 130);
    routes->addColumn("Mask", 130);
    routes->addColumn("Gateway", 130);
    routes->addColumn("Metric", 70);
    routes->addColumn("Device", 90);
    tabs->addTab("Interfaces", tablePage(ifaces));
    tabs->addTab("Connections", tablePage(conns));
    tabs->addTab("ARP", tablePage(arp));
    tabs->addTab("Routes", tablePage(routes));
    tabs->addTab("DNS", dnsPage());
    tabs->addTab("HTTP", httpPage());
    tabs->addTab("Ports", portsPage());
    tabs->addTab("Connect", pingPage());
    col->add(tabs);
    status = new guix.StatusBar();
    status->addSection(0);
    status->addSection(120);
    status->setText(1, "F5 refreshes");
    col->add(status);
    win->setRoot(col);
    win->onKey = keyPressed;
    refreshAll(0);
    disp->run();
    return 0;
}
