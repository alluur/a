// alock - locks the screen of a display server until the user's password is entered.
//
//   alock [-d N|host:port] [-u USERSFILE] [USER]
// USER defaults to the USER environment variable. Passwords are checked against /etc/shadow (the same $6$ hashes the display
// manager uses), or against a users file made for the display manager with  -u. Run it as root or as a user who may read
// /etc/shadow, or use a users file.
import glock;
import gui;
import dm;
import cstdlib;

dm.Config* cfg;
char* userName;

int check(int password) {
    return dm.authenticate(cfg, userName, (char*) password) != null ? 1 : 0;
}

int main(int argc, char** argv) {
    char* spec = null;
    cfg = new dm.Config();
    cfg->allowRoot = true;
    cfg->minUid = 0;
    userName = getenv("USER");
    for (int i = 1; i < argc; i++) {
        if (streq(argv[i], "-d") && i + 1 < argc) {
            spec = argv[i + 1];
            i++;
        } else if (streq(argv[i], "-u") && i + 1 < argc) {
            cfg->usersFile = argv[i + 1];
            i++;
        } else {
            userName = argv[i];
        }
    }
    if (userName == null || strlen(userName) == 0) {
        println("usage: alock [-d display] [-u usersfile] USER");
        return 2;
    }
    gui.Display* d = gui.connectAs(spec, "alock");
    if (d == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    glock.Locker* l = new glock.Locker(d, userName, check);
    l->run();
    return 0;
}
