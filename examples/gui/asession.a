// asession - a very small desktop session: a wallpaper, a panel with launchers and a clock.
//
//   asession [Name=command]...        for example   asession Calculator=calc Paint=paint Notes=notes
// Every argument makes a button in the panel that starts the command. "Log out" ends the session (the display manager
// shows the login screen again).
import gui;
import adp;
import datetime;
import cunistd;

gui.Display* disp;
gui.Label* clock;
char** commands;

int launch(int self) {
    gui.Button* b = (gui.Button*) self;
    char* cmd = commands[b->userData];
    int pid = fork();
    if (pid == 0) {
        char* argv[4];
        argv[0] = "/bin/sh";
        argv[1] = "-c";
        argv[2] = cmd;
        argv[3] = null;
        execv("/bin/sh", &argv[0]);
        _exit(127);
    }
    return 0;
}

int logout(int self) {
    disp->quit = true;
    return 0;
}

// the clock ticks once a second; finished programs are collected
int tick(int arg) {
    datetime.DateTime* t = new datetime.DateTime(datetime.now());
    char text[40];
    format(&text[0], 40, "%02d:%02d:%02d", t->hour, t->minute, t->second);
    clock->setText(&text[0]);
    int st = 0;
    while (waitpid(-1, &st, 1) > 0) {
    }
    disp->after(1000, tick, 0);
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "session");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    int sw = disp->screenW;
    int sh = disp->screenH;
    // the wallpaper
    gui.Window* paper = disp->createWindowAt("desktop", 0, 0, sw, sh, adp.F_NODECOR | adp.F_BELOW | adp.F_NOFOCUS);
    gfx.Surface* ps = paper->surf;
    ps->gradientV(0, 0, sw, sh, gfx.rgb(46, 74, 120), gfx.rgb(14, 22, 44));
    ps->text(gfx.sansBold(), 24, sh - 40, "A", gfx.argb(110, 255, 255, 255));
    paper->noClear = true;
    paper->invalidateAll();
    // the panel
    gui.Window* panel = disp->createWindowAt("panel", 0, 0, sw, 34, adp.F_NODECOR | adp.F_ABOVE | adp.F_NOFOCUS);
    gui.Box* bar = gui.hbox(6, 4);
    bar->background = 0xFFDCE0EA;
    commands = (char**) calloc(16, 8);
    int n = 0;
    for (int i = 1; i < argc && n < 16; i++) {
        int eq = indexOf(argv[i], '=');
        if (eq <= 0) {
            continue;
        }
        char* label = strdup(argv[i]);
        label[eq] = 0;
        commands[n] = &label[eq + 1];
        gui.Button* b = new gui.Button(label);
        b->userData = n;
        b->onClick = launch;
        bar->add(b);
        n++;
    }
    gui.Spacer* gap = new gui.Spacer(1);
    gap->flex = 1;
    bar->add(gap);
    clock = new gui.Label("");
    bar->add(clock);
    gui.Button* out = new gui.Button("Log out");
    out->onClick = logout;
    bar->add(out);
    panel->setRoot(bar);
    tick(0);
    disp->run();
    return 0;
}
