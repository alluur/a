// aterm - a terminal emulator.   ADISPLAY=0 ./aterm [command...]
//
// Without arguments it runs your shell ($SHELL); with arguments it runs the command (through /bin/sh -c) and closes when it
// ends. Ctrl+Shift+N opens another terminal window, Ctrl+Shift+W closes one, Ctrl+Shift+C / V copy and paste (selecting with
// the mouse copies too, the middle button pastes), Shift+PageUp / PageDown and the mouse wheel scroll the history.
import gui;
import guix;
import gterm;
import adp;

gui.Display* disp;
char* command;

void newTerminal();

int shellExited(int self) {
    gterm.Terminal* t = (gterm.Terminal*) self;
    t->win->close();
    return 0;
}

int windowClosed(int window) {
    gui.Window* w = (gui.Window*) window;
    gterm.Terminal* t = (gterm.Terminal*) w->userData;
    t->stop();
    return 0;
}

gterm.Terminal* terminalOf(int item) {
    guix.MenuItem* m = (guix.MenuItem*) item;
    return (gterm.Terminal*) m->userData;
}

int doNew(int item) { newTerminal(); return 0; }
int doClose(int item) { terminalOf(item)->win->close(); return 0; }
int doCopy(int item) { terminalOf(item)->copy(); return 0; }
int doPaste(int item) { terminalOf(item)->paste(); return 0; }
int doClear(int item) { terminalOf(item)->feed("\x1b[2J\x1b[H"); return 0; }
int doReset(int item) { terminalOf(item)->fullReset(); return 0; }

guix.MenuItem* item(guix.Menu* m, char* text, func f, char* accel, gterm.Terminal* t) {
    guix.MenuItem* it = m->add(text, f);
    if (strlen(accel) > 0) {
        it->accel(accel);
    }
    it->userData = (int) t;
    return it;
}

void newTerminal() {
    gui.Window* w = disp->createWindow("Terminal", 640, 400, 0);
    gui.Box* col = gui.vbox(0, 0);
    gterm.Terminal* t = new gterm.Terminal();
    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&Terminal");
    item(file, "New window", doNew, "Ctrl+Shift+N", t);
    item(file, "Close window", doClose, "Ctrl+Shift+W", t);
    guix.Menu* edit = bar->addMenu("&Edit");
    item(edit, "Copy", doCopy, "Ctrl+Shift+C", t);
    item(edit, "Paste", doPaste, "Ctrl+Shift+V", t);
    edit->addSeparator();
    item(edit, "Clear screen", doClear, "", t);
    item(edit, "Reset", doReset, "", t);
    col->add(bar);
    t->flex = 1;
    col->add(t);
    w->setRoot(col);
    w->fit();
    w->userData = (int) t;
    w->onClose = windowClosed;
    t->onExit = shellExited;
    w->setFocus(t);
    if (!t->start(disp, command)) {
        t->feed("Cannot open a pseudo terminal here.\r\n");
    }
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "aterm");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    command = "";
    if (argc > 1) {
        // the arguments make one command line
        char* line = malloc(4096);
        line[0] = 0;
        for (int i = 1; i < argc; i++) {
            if (i > 1) {
                strcat(line, " ");
            }
            strcat(line, argv[i]);
        }
        command = line;
    }
    newTerminal();
    disp->run();
    return 0;
}
