// A text editor.   ADISPLAY=0 ./notes [file]
import gui;
import adp;

gui.TextArea* area;
gui.TextBox* pathBox;
gui.Label* status;

int changed(int self) {
    char text[80];
    format(&text[0], 80, "%d lines", area->lineCount());
    status->setText(&text[0]);
    return 0;
}

int openClicked(int self) {
    char* t = readFile(pathBox->text());
    if (t == null) {
        status->setText("Cannot read that file");
        return 0;
    }
    area->setText(t);
    changed(0);
    return 0;
}

int saveClicked(int self) {
    if (writeFile(pathBox->text(), area->text())) {
        status->setText("Saved");
    } else {
        status->setText("Cannot write that file");
    }
    return 0;
}

int main(int argc, char** argv) {
    gui.Display* d = gui.connectAs(null, "notes");
    if (d == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    gui.Window* w = d->createWindow("Notes", 520, 380, 0);
    gui.Box* col = gui.vbox(6, 8);
    gui.Box* bar = gui.hbox(6, 0);
    bar->add(new gui.Label("File"));
    pathBox = new gui.TextBox();
    pathBox->flex = 1;
    pathBox->setText("notes.txt");
    bar->add(pathBox);
    gui.Button* open = new gui.Button("Open");
    open->onClick = openClicked;
    bar->add(open);
    gui.Button* save = new gui.Button("Save");
    save->onClick = saveClicked;
    save->primary = true;
    bar->add(save);
    col->add(bar);
    area = new gui.TextArea();
    area->onChange = changed;
    col->add(area);
    status = new gui.Label("");
    status->color = gui.cTextDim;
    col->add(status);
    w->setRoot(col);
    w->setFocus(area);
    if (argc > 1) {
        pathBox->setText(argv[1]);
        openClicked(0);
    }
    d->run();
    return 0;
}
