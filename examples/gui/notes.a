// A text editor with menus and file dialogs.   ADISPLAY=0 ./notes [file]
//   Ctrl+N new, Ctrl+O open, Ctrl+S save, Ctrl+Q quit; the Edit menu (and a right click) has cut, copy, paste, select all.
import gui;
import guix;
import adp;
import path;

gui.Display* disp;
gui.Window* win;
gui.TextArea* area;
gui.Label* status;
char* current;                  // the file that is being edited ("" = none yet)
guix.Menu* context;

void showStatus() {
    char text[300];
    format(&text[0], 300, "%s    %d lines", strlen(current) > 0 ? current : "(new file)", area->lineCount());
    status->setText(&text[0]);
    win->setTitle(strlen(current) > 0 ? path.basename(current) : "Notes");
}

int changed(int self) {
    showStatus();
    return 0;
}

void loadFile(char* p) {
    char* t = readFile(p);
    if (t == null) {
        status->setText("Cannot read that file");
        return;
    }
    area->setText(t);
    current = strdup(p);
    showStatus();
}

void saveTo(char* p) {
    if (writeFile(p, area->text())) {
        current = strdup(p);
        showStatus();
    } else {
        status->setText("Cannot write that file");
    }
}

int gotOpen(int p) {
    if (p != 0) {
        loadFile((char*) p);
    }
    return 0;
}

int gotSave(int p) {
    if (p != 0) {
        saveTo((char*) p);
    }
    return 0;
}

int doNew(int item) {
    area->setText("");
    current = "";
    showStatus();
    return 0;
}

int doOpen(int item) {
    guix.openFile(disp, "Open", ".", gotOpen);
    return 0;
}

int doSave(int item) {
    if (strlen(current) > 0) {
        saveTo(current);
    } else {
        guix.saveFile(disp, "Save as", ".", "notes.txt", gotSave);
    }
    return 0;
}

int doSaveAs(int item) {
    guix.saveFile(disp, "Save as", ".", strlen(current) > 0 ? path.basename(current) : "notes.txt", gotSave);
    return 0;
}

int doQuit(int item) {
    disp->quit = true;
    return 0;
}

// the clipboard commands send the keys the text area already understands
void key(int k) {
    area->onKey(1, k, k, adp.MOD_CTRL);
}

int doCut(int item) { key('x'); return 0; }
int doCopy(int item) { key('c'); return 0; }
int doPaste(int item) { key('v'); return 0; }
int doSelectAll(int item) { key('a'); return 0; }

int doWrap(int item) {
    status->setText("(word wrap is not part of this little editor)");
    return 0;
}

int rightClick(int widget) {
    context->popup(win, win->lastMouseX, win->lastMouseY);
    return 0;
}

int main(int argc, char** argv) {
    disp = gui.connectAs(null, "notes");
    if (disp == null) {
        println("cannot connect to the display server (is ADISPLAY set?)");
        return 1;
    }
    current = "";
    win = disp->createWindow("Notes", 560, 420, 0);
    gui.Box* col = gui.vbox(0, 0);

    guix.MenuBar* bar = new guix.MenuBar();
    guix.Menu* file = bar->addMenu("&File");
    file->add("New", doNew)->accel("Ctrl+N");
    file->add("Open...", doOpen)->accel("Ctrl+O");
    file->add("Save", doSave)->accel("Ctrl+S");
    file->add("Save as...", doSaveAs)->accel("Ctrl+Shift+S");
    file->addSeparator();
    file->add("Quit", doQuit)->accel("Ctrl+Q");
    guix.Menu* edit = bar->addMenu("&Edit");
    edit->add("Cut", doCut)->accel("Ctrl+X");
    edit->add("Copy", doCopy)->accel("Ctrl+C");
    edit->add("Paste", doPaste)->accel("Ctrl+V");
    edit->addSeparator();
    edit->add("Select all", doSelectAll)->accel("Ctrl+A");
    guix.Menu* view = bar->addMenu("&View");
    view->addCheck("Word wrap", false, doWrap);
    col->add(bar);

    gui.Box* body = gui.vbox(6, 8);
    body->flex = 1;
    area = new gui.TextArea();
    area->onChange = changed;
    area->onContext = rightClick;
    body->add(area);
    status = new gui.Label("");
    status->color = gui.cTextDim;
    body->add(status);
    col->add(body);

    context = new guix.Menu();
    context->add("Cut", doCut);
    context->add("Copy", doCopy);
    context->add("Paste", doPaste);
    context->addSeparator();
    context->add("Select all", doSelectAll);

    win->setRoot(col);
    win->setFocus(area);
    if (argc > 1) {
        loadFile(argv[1]);
    } else {
        showStatus();
    }
    disp->run();
    return 0;
}
