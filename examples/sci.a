// A scientific calculator: type an expression with + - * / ^ ( ), the constants pi and e and the functions
// sqrt sin cos tan asin acos atan exp ln log log2 abs floor ceil round gamma erf. An empty line ends the program.
//   build:  ac -o sci sci.a        run:  echo "2 * sin(pi / 6) + sqrt(16)" | ./sci
import clib;

char* src;
int pos;
bool failed;

void skipSpaces() {
    while (src[pos] == ' ' || src[pos] == 9) {
        pos++;
    }
}

int expression();

int number() {
    char* end;
    int v = strtod(&src[pos], &end);
    if (end == &src[pos]) {
        failed = true;
        return 0;
    }
    pos = pos + (int) end - (int) &src[pos];
    return v;
}

int call(char* name, int x) {
    if (streq(name, "sqrt")) return sqrt(x);
    if (streq(name, "sin")) return sin(x);
    if (streq(name, "cos")) return cos(x);
    if (streq(name, "tan")) return tan(x);
    if (streq(name, "asin")) return asin(x);
    if (streq(name, "acos")) return acos(x);
    if (streq(name, "atan")) return atan(x);
    if (streq(name, "exp")) return exp(x);
    if (streq(name, "ln")) return log(x);
    if (streq(name, "log")) return log10(x);
    if (streq(name, "log2")) return log2(x);
    if (streq(name, "abs")) return fabs(x);
    if (streq(name, "floor")) return floor(x);
    if (streq(name, "ceil")) return ceil(x);
    if (streq(name, "round")) return round(x);
    if (streq(name, "gamma")) return tgamma(x);
    if (streq(name, "erf")) return erf(x);
    failed = true;
    return 0;
}

int primary() {
    skipSpaces();
    int c = src[pos];
    if (c == '(') {
        pos++;
        int v = expression();
        skipSpaces();
        if (src[pos] != ')') {
            failed = true;
        }
        pos++;
        return v;
    }
    if (c == '-') {
        pos++;
        return dneg(primary());
    }
    if (c == '+') {
        pos++;
        return primary();
    }
    if (isalpha(c)) {
        char name[16];
        int n = 0;
        while (isalnum(src[pos]) && n < 15) {
            name[n] = src[pos];
            n++;
            pos++;
        }
        name[n] = 0;
        if (streq(name, "pi")) return M_PI;
        if (streq(name, "e")) return M_E;
        skipSpaces();
        if (src[pos] == '(') {
            pos++;
            int arg = expression();
            skipSpaces();
            if (src[pos] != ')') {
                failed = true;
            }
            pos++;
            return call(name, arg);
        }
        failed = true;
        return 0;
    }
    return number();
}

int power() {
    int base = primary();
    skipSpaces();
    if (src[pos] == '^') {
        pos++;
        int exponent = power();
        return pow(base, exponent);
    }
    return base;
}

int term() {
    int v = power();
    for (;;) {
        skipSpaces();
        int c = src[pos];
        if (c == '*') {
            pos++;
            v = dmul(v, power());
        } else if (c == '/') {
            pos++;
            v = ddiv(v, power());
        } else {
            return v;
        }
    }
    return v;
}

int expression() {
    int v = term();
    for (;;) {
        skipSpaces();
        int c = src[pos];
        if (c == '+') {
            pos++;
            v = dadd(v, term());
        } else if (c == '-') {
            pos++;
            v = dsub(v, term());
        } else {
            return v;
        }
    }
    return v;
}

int main() {
    char line[256];
    bool tty = isTerminal(0);
    for (;;) {
        if (tty) {
            print("sci> ");
        }
        if (readLine(line, 256) < 0 || line[0] == 0) {
            break;
        }
        src = line;
        pos = 0;
        failed = false;
        int v = expression();
        skipSpaces();
        if (failed || src[pos] != 0) {
            println("syntax error");
        } else {
            printfd("%.15g\n", v);
        }
    }
    return 0;
}
