// A small POP3 server (pop3d) for a Maildir, for example the one that smtpd_demo fills.
//   pop3d_demo [PORT [MAILDIR [PASSWORD]]]        (user name: ann)
//   the A client:  import pop3;  pop3.connect("pop3://ann:PASSWORD@localhost:PORT")  (give startTls NEVER in the options for a server without TLS)
import pop3d;

int main(int argc, char** argv) {
    int port = 1110;
    char* dir = "/tmp/mail/ann";
    char* password = "secret";
    if (argc > 1) port = atoi(argv[1]);
    if (argc > 2) dir = argv[2];
    if (argc > 3) password = argv[3];
    pop3d.Server* s = pop3d.newServer();
    s->addUser("ann", password, dir);
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("POP3 server on port %d, Maildir %s\n", s->port, dir);
    s->run();
    return 0;
}
