// A syslog collector (syslogd): RFC 5424 and RFC 3164 over UDP and TCP, one line per message in a rotating file and in a ring buffer, statistics on exit.
//   syslogd_demo [PORT [LOGFILE]]          (default port 5514, default file syslogd_demo.log, rotated at 1 MiB, 3 old files kept)
//   logger -n 127.0.0.1 -P PORT -d "hello"        (or: import syslog;  syslog.newSender("udp://localhost:PORT")->info("hello"))
// Stops after 60 seconds without a message.
import syslogd;

int main(int argc, char** argv) {
    int port = 5514;
    char* file = "syslogd_demo.log";
    if (argc > 1) {
        port = atoi(argv[1]);
    }
    if (argc > 2) {
        file = argv[2];
    }
    syslogd.Server* s = syslogd.newServer();
    if (!s->listenUdp(port) || !s->listenTcp(port)) {
        println("cannot listen on that port");
        return 1;
    }
    s->collector->addFile(null, file, 1048576, 3);
    printf("syslog collector on UDP and TCP port %d, writing %s\n", port, file);
    int last = millis();
    int seen = 0;
    while (millis() - last < 60000) {
        s->poll(100);
        if (s->collector->stats->received != seen) {
            seen = s->collector->stats->received;
            last = millis();
        }
    }
    printf("received %d messages (%d malformed)\n", s->collector->stats->received, s->collector->stats->malformed);
    s->shutdown();
    return 0;
}
