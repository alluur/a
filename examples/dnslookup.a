// dnslookup NAME [TYPE]      TYPE is A, AAAA, MX, NS, TXT, CNAME, SOA, SRV (default A)
import dns;

int main(int argc, char** argv) {
    if (argc < 2) { println("usage: dnslookup NAME [TYPE]"); return 1; }
    int type = dns.A;
    if (argc > 2) {
        char* t = argv[2];
        if (streq(t, "AAAA")) type = dns.AAAA;
        else if (streq(t, "MX")) type = dns.MX;
        else if (streq(t, "NS")) type = dns.NS;
        else if (streq(t, "TXT")) type = dns.TXT;
        else if (streq(t, "CNAME")) type = dns.CNAME;
        else if (streq(t, "SOA")) type = dns.SOA;
        else if (streq(t, "SRV")) type = dns.SRV;
        else if (streq(t, "PTR")) type = dns.PTR;
    }
    int n = dns.query(argv[1], type);
    if (n < 0) { println("no answer from the name servers"); return 1; }
    if (n == 0) { print("no records (response code "); printInt(dns.rcode()); println(")"); return 1; }
    for (int i = 0; i < n; i++) {
        dns.Record* r = dns.recordAt(i);
        print(r->name); print("  "); printInt(r->ttl); print("  "); print(dns.typeName(r->type)); print("  ");
        println(dns.recordText(r));
    }
    return 0;
}
