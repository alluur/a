// ANSI colours, cursor control and a countdown with sleepMs.
int main() {
    printColor(ANSI_RED, "red ");
    printColor(ANSI_GREEN, "green ");
    printColor(ANSI_YELLOW, "yellow ");
    printColor(ANSI_BLUE, "blue ");
    printColor(ANSI_MAGENTA, "magenta ");
    printColor(ANSI_CYAN, "cyan\n");
    for (int i = 5; i > 0; i--) {
        printf("\rlaunch in %d...", i, 0, 0, 0);
        sleepMs(300);
    }
    printColor(ANSI_BOLD, "\rliftoff!        \n");
    int t = millis();
    printf("(measured with millis(): started at %d ms)\n", t, 0, 0, 0);
    return 0;
}
