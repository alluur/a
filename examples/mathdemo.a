// Mathematics with the C library: a double is an int that holds the 64-bit IEEE number.
//   build:  ac -o mathdemo mathdemo.a
import clib;

void row(char* name, int x, int fx) {
    printfd("%-10s %-22s = %.15g\n", (int) name, x, fx);
}

int main() {
    int two = itod(2);
    printfd("pi  = %.20f\n", M_PI);
    printfd("e   = %.20f\n", M_E);
    printfd("sqrt(2) = %.17g\n", sqrt(two));
    printfd("2^0.5   = %.17g   (pow)\n", pow(two, dlit("0.5")));
    printfd("2^100   = %.0f\n", pow(two, itod(100)));
    println("");

    println("function   argument               value");
    int xs[5];
    xs[0] = dlit("0.5");
    xs[1] = dlit("1.0");
    xs[2] = dlit("2.0");
    xs[3] = dlit("10.0");
    xs[4] = dlit("-3.25");
    for (int i = 0; i < 5; i++) {
        int x = xs[i];
        char* a = dtostr(x);
        row("sin", (int) a, sin(x));
        row("cos", (int) a, cos(x));
        row("atan", (int) a, atan(x));
        row("exp", (int) a, exp(x));
        row("tanh", (int) a, tanh(x));
        if (dgt(x, 0)) {
            row("log", (int) a, log(x));
            row("sqrt", (int) a, sqrt(x));
        }
        row("floor", (int) a, floor(x));
        row("round", (int) a, round(x));
        row("erf", (int) a, erf(x));
        row("tgamma", (int) a, tgamma(x));
    }
    println("");

    // Euler's identity: e^(i pi) + 1 = 0, with the real and imaginary part separately
    printfd("cos(pi) = %.17g, sin(pi) = %.17g (the nearest double to pi is not pi)\n", cos(M_PI), sin(M_PI));
    // a sum that is not exact in binary
    int sum = 0;
    for (int i = 0; i < 10; i++) {
        sum = dadd(sum, dlit("0.1"));
    }
    printfd("ten times 0.1 = %.17g, equal to 1.0: %d\n", sum, deq(sum, itod(1)));
    // special values
    printfd("1/0 = %g, -1/0 = %g, 0/0 = %g\n", ddiv(itod(1), 0), ddiv(itod(-1), 0), ddiv(0, 0));
    printfd("sqrt(-1) = %g, log(0) = %g\n", sqrt(itod(-1)), log(0));
    printfd("largest double = %.17g, smallest = %g\n", DBL_MAX, DBL_TRUE_MIN);
    return 0;
}
