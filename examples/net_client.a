// Talks to net_server.a
import net;

int main() {
    int h = net.connect("127.0.0.1", 9000);
    if (h < 0) {
        println("cannot connect - is net_server running?");
        return 1;
    }
    net.sendText(h, "hello from A\n");
    char reply[256];
    net.recvLine(h, reply, 256);
    println(reply);
    net.close(h);
    return 0;
}
