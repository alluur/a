// The second batch of language features: var, tuples, lambdas, string interpolation and the exact printf.
//   ac examples/lang2.a -o lang2 && ./lang2
import algo;

// a function that returns two values
(int, int) minmax(int* a, int n) {
    var lo = a[0];
    var hi = a[0];
    for (var i = 1; i < n; i++) {
        if (a[i] < lo) { lo = a[i]; }
        if (a[i] > hi) { hi = a[i]; }
    }
    return (lo, hi);
}

(int, int) divmod(int a, int b) { return (a / b, a % b); }

// the n-th Fibonacci number and its predecessor, with a swap in the loop head
(int, int) fib(int n) {
    var (a, b) = (0, 1);
    for (var i = 0; i < n; i++) { (a, b) = (b, a + b); }
    return (a, b);
}

int main() {
    int values[8] = {42, 7, 19, 3, 88, 23, 5, 61};
    (int lo, int hi) = minmax(values, 8);
    println($"smallest {lo}, largest {hi}");

    (int q, int r) = divmod(100, 7);
    println($"100 = 7 * {q} + {r}");

    var (f, previous) = fib(30);
    println($"fib(30) = {f} (and {previous} before it)");

    // lambdas are anonymous functions; a library function that wants a comparison gets one right where it is called
    algo.sortBy(values, 8, (int a, int b) => b - a);        // descending
    print("sorted:");
    foreach (var v in values) { print($" {v}"); }
    println("");
    func square = x => x * x;
    println($"7 squared is {square(7)}");

    // text formatting: any number of values, doubles printed exactly
    double pi = 3.14159265358979;
    printf("%-8s|%8.3f|%-12e|%g|%v\n", "pi", pi, pi * 1e10, pi / 1e6, pi);
    printf("%.20f\n", 0.1);                                  // the true digits of the double that is closest to 0.1
    println($"{0.1 + 0.2}  {1.0 / 3.0}  {1e22}  {5e-324}");  // {x} for a double: the shortest text that reads back
    println($"{255:#x} {255:08b} {255:o} {pi:10.2f}| {"text":-8}| {true}");
    return 0;
}
