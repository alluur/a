// gallery - every widget of the tui toolkit in one program.                       ac examples/tui/gallery.a -o gallery && ./gallery
//
// Menus (F10 or Alt+F ...), tabs (Alt+1 .. Alt+5), the command palette (Ctrl+P), dialogs, a progress bar driven by a timer, a list with
// filter-as-you-type, a tree whose branches are filled when opened, a sortable table, a text pane that shows the output of a program while it
// runs (Run in the Output tab), a splitter you can drag, and a log of the last events. Ctrl+Q quits.
import tui;
import tuix;
import term;
import tscreen;

tui.App* app;
tui.StatusBar* status;
tui.ProgressBar* progress;
tuix.TextPane* events;
tuix.TextPane* output;
tui.TextInput* nameInput;
tui.Label* picked;
term.Process* proc;
int progressTimer;

// ---- actions ------------------------------------------------------------------------------------------------------------------------------
int doQuit(int x) { app->quit(0); return 0; }

int doAbout(int x) {
    tuix.messageBox(app, "About", "tui gallery\n\nA terminal user interface toolkit written in A: widgets, menus, dialogs, mouse, colours.", "&OK");
    return 0;
}

int doConfirm(int x) {
    bool yes = tuix.askYesNo(app, "Question", "Do you like terminals?");
    picked->setText(yes ? "answer: yes" : "answer: no");
    return 0;
}

int doPrompt(int x) {
    char* s = tuix.prompt(app, "Your name", "What is your name?", nameInput->getText());
    if (s != null) { nameInput->setText(s); picked->setText("name changed"); }
    return 0;
}

int doOpen(int x) {
    char* f = tuix.fileOpenDialog(app, "Open a file", "", "");
    if (f == null) { picked->setText("no file chosen"); return 0; }
    char buf[300];
    format(&buf[0], 300, "file: %s", f, 0, 0, 0);
    picked->setText(&buf[0]);
    return 0;
}

int doSave(int x) {
    char* f = tuix.fileSaveDialog(app, "Save as", "", "untitled.txt", "");
    if (f == null) { picked->setText("not saved"); return 0; }
    char buf[300];
    format(&buf[0], 300, "save to: %s", f, 0, 0, 0);
    picked->setText(&buf[0]);
    return 0;
}

int doColor(int x) {
    int c = tuix.colorDialog(app, tscreen.rgb(200, 100, 50));
    char buf[100];
    if (c < 0) { format(&buf[0], 100, "colour: cancelled", 0, 0, 0, 0); }
    else { format(&buf[0], 100, "colour: %x", c, 0, 0, 0); }
    picked->setText(&buf[0]);
    return 0;
}

int doPalette(int x) {
    tuix.commandPalette(app);
    return 0;
}

int doShell(int x) {
    app->runShell(null);
    status->message("back from the shell", 2000);
    return 0;
}

int doLs(int x) {
    app->runShell("echo 'running ls -l'; ls -l /; echo; echo 'press Enter'; read x");
    return 0;
}

int doToast(int x) {
    app->toast("a toast message", 1500);
    return 0;
}

int themeDark(int x) { tui.theme->useDark(); return 0; }
int themeLight(int x) { tui.theme->useLight(); return 0; }
int themeClassic(int x) { tui.theme->useClassic(); return 0; }
int themeMono(int x) { tui.theme->useMono(); return 0; }

// ---- the progress bar ----------------------------------------------------------------------------------------------------------------------
int tick(int ud) {
    int v = progress->value + 5;
    if (v > 100) { v = 0; }
    progress->setValue(v);
    return 0;
}

int toggleTimer(int cb) {
    tui.CheckBox* c = (tui.CheckBox*) cb;
    if (c->checked && progressTimer < 0) { progressTimer = app->addTimer(200, tick, 0, true); }
    if (!c->checked && progressTimer >= 0) { app->cancelTimer(progressTimer); progressTimer = -1; }
    return 0;
}

// ---- running a program and showing its output while it runs -----------------------------------------------------------------------------------
int outputReady(int fd, int ud) {
    char buf[1024];
    int n = proc->read(&buf[0], 1000);
    if (n > 0) {
        output->appendBytes(&buf[0], n);
        return 0;
    }
    app->unwatchFd(fd);
    int st = proc->finish();
    char msg[80];
    format(&msg[0], 80, "\e[36m[finished with status %d]\e[0m", st, 0, 0, 0);
    output->appendLine(&msg[0]);
    return 0;
}

int doRun(int b) {
    if (proc != null && proc->running) { output->appendLine("\e[33m[still running]\e[0m"); return 0; }
    proc = new term.Process();
    output->clear();
    if (!proc->startShell("for i in 1 2 3 4 5; do echo \"step $i\"; sleep 0.2; done; echo 'a \\033[31mred\\033[0m word'; ls /")) {
        output->appendLine("cannot start");
        return 0;
    }
    app->watchFd(proc->fd, outputReady, 0);
    return 0;
}

int lineClicked(int pane) {
    tuix.TextPane* p = (tuix.TextPane*) pane;
    char buf[200];
    format(&buf[0], 200, "clicked output line %d", p->clickedLine, 0, 0, 0);
    status->message(&buf[0], 2000);
    return 0;
}

// ---- the tree: branches are filled when opened --------------------------------------------------------------------------------------------------
int expandNode(int tree, int node) {
    tuix.TreeView* t = (tuix.TreeView*) tree;
    char buf[64];
    for (int i = 1; i <= 3; i++) {
        format(&buf[0], 64, "%s.%d", t->nodeText(node), i, 0, 0);
        t->addNode(node, &buf[0], t->nodeData(node) + 10, t->nodeData(node) < 10);
    }
    return 0;
}

// ---- event log -------------------------------------------------------------------------------------------------------------------------------
int keyHook(int appPtr, int ev) {
    term.Event* e = (term.Event*) ev;
    char d[64];
    term.describe(e, &d[0], 64);
    char line[100];
    format(&line[0], 100, "key: %s", &d[0], 0, 0, 0);
    events->appendLine(&line[0]);
    return 0;
}

int main() {
    app = new tui.App();
    if (!app->start()) {
        println("gallery needs a terminal");
        return 1;
    }
    app->setTitle("tui gallery");
    status = new tui.StatusBar();
    status->set(0, "F10 menu   Ctrl+P commands   Ctrl+Q quit");
    status->set(1, "A", 2);

    // menus
    tui.MenuBar* mb = new tui.MenuBar();
    tui.Menu* f = mb->addMenu("&File");
    f->add("&Open file...", doOpen, "Ctrl+O");
    f->add("&Save as...", doSave, "Ctrl+S");
    f->addSeparator();
    f->add("Run a &shell", doShell, "F9");
    f->add("Run &ls and come back", doLs);
    f->addSeparator();
    f->add("&Quit", doQuit, "Ctrl+Q");
    tui.Menu* v = mb->addMenu("&View");
    tui.Menu* th = v->addSub("&Theme");
    th->add("&Dark", themeDark);
    th->add("&Light", themeLight);
    th->add("&Classic (16 colours)", themeClassic);
    th->add("&Monochrome", themeMono);
    v->add("Colour &picker...", doColor, "Ctrl+K");
    v->add("&Toast", doToast);
    tui.Menu* h = mb->addMenu("&Help");
    h->add("&About", doAbout, "F1");

    app->addCommand("File: open", "", doOpen);
    app->addCommand("File: save as", "", doSave);
    app->addCommand("View: colour picker", "", doColor);
    app->addCommand("View: dark theme", "", themeDark);
    app->addCommand("View: light theme", "", themeLight);
    app->addCommand("View: classic theme", "", themeClassic);
    app->addCommand("View: monochrome theme", "", themeMono);
    app->addCommand("Help: about", "", doAbout);
    app->addCommand("Shell: run a shell", "", doShell);
    app->addCommand("Quit", "", doQuit);
    app->addShortcut("Ctrl+Q", doQuit);
    app->addShortcut("Ctrl+P", doPalette);
    app->addShortcut("F9", doShell);

    // page 1: inputs
    tui.Box* p1 = tui.vbox(1, 1);
    p1->themed = true;
    nameInput = new tui.TextInput("Ada");
    nameInput->name = "name";
    p1->add(new tui.Label("Name:"));
    p1->add(nameInput);
    tui.Box* checks = tui.hbox(3, 0);
    checks->themed = true;
    tui.CheckBox* c1 = new tui.CheckBox("&animate progress");
    c1->onChange = toggleTimer;
    checks->add(c1);
    checks->add(new tui.CheckBox("&mouse"));
    p1->add(checks);
    tui.Box* radios = tui.hbox(3, 0);
    radios->themed = true;
    for (int i = 0; i < 3; i++) {
        char* names[3] = {"one", "two", "three"};
        tui.CheckBox* r = new tui.CheckBox(names[i]);
        r->radio = true;
        r->name = "grp";
        if (i == 0) { r->checked = true; }
        radios->add(r);
    }
    p1->add(radios);
    progress = new tui.ProgressBar();
    p1->add(progress);
    tui.Slider* sl = new tui.Slider();
    sl->max = 100;
    sl->value = 30;
    p1->add(sl);
    tui.Box* buttons = tui.hbox(2, 0);
    buttons->themed = true;
    tui.Button* b1 = new tui.Button("&Question");
    b1->onClick = doConfirm;
    tui.Button* b2 = new tui.Button("&Prompt");
    b2->onClick = doPrompt;
    tui.Button* b3 = new tui.Button("&Colour");
    b3->onClick = doColor;
    tui.Button* b4 = new tui.Button("&Open");
    b4->onClick = doOpen;
    buttons->add(b1); buttons->add(b2); buttons->add(b3); buttons->add(b4);
    p1->add(buttons);
    picked = new tui.Label("(nothing chosen yet)");
    p1->add(picked);
    p1->add(new tui.Spacer());
    p1->getPrefW();

    // page 2: list and tree in a splitter
    tui.Splitter* sp = new tui.Splitter(true);
    tui.ListView* lv = new tui.ListView();
    lv->filterable = true;
    char* fruits[12] = {"apple", "apricot", "banana", "blueberry", "cherry", "date", "elderberry", "fig", "grape", "kiwi", "lemon", "mango"};
    for (int i = 0; i < 12; i++) { lv->add(fruits[i]); }
    sp->add(lv);
    tuix.TreeView* tree = new tuix.TreeView();
    tree->onExpand = expandNode;
    tree->addNode(0, "alpha", 0, true);
    tree->addNode(0, "beta", 1, true);
    tree->addNode(0, "gamma", 2, false);
    sp->add(tree);

    // page 3: a table
    tuix.Table* tb = new tuix.Table();
    tb->addColumn("Language", 0);
    tb->addColumn("Year", 6, 2);
    tb->addColumn("Typing", 10);
    tb->addRow("A", "2024", "static");
    tb->addRow("C", "1972", "static");
    tb->addRow("Python", "1991", "dynamic");
    tb->addRow("Lisp", "1958", "dynamic");
    tb->addRow("Rust", "2010", "static");
    tb->addRow("Go", "2009", "static");

    // page 4: program output
    tui.Box* p4 = tui.vbox(0, 0);
    p4->themed = true;
    tui.Button* run = new tui.Button("&Run");
    run->onClick = doRun;
    run->halign = 1;
    p4->add(run);
    output = new tuix.TextPane();
    output->flex = 1;
    output->selectable = true;
    output->onLineClick = lineClicked;
    p4->add(output);

    tui.TabView* tabs = new tui.TabView();
    tabs->flex = 1;
    tabs->addPage(p1, "&1 Inputs");
    tabs->addPage(sp, "&2 Lists");
    tabs->addPage(tb, "&3 Table");
    tabs->addPage(p4, "&4 Output");

    events = new tuix.TextPane();
    events->fixedH = 4;
    events->ansi = false;

    tui.Box* col = tui.vbox(0, 0);
    col->add(mb);
    col->add(tabs);
    col->add(events);
    col->add(status);
    app->setMenuBar(mb);
    app->setRoot(col);
    app->onKeyHook = keyHook;
    progressTimer = -1;
    return app->run();
}
