// algo_bench: measures the speed of the ds, strx and rng modules (operations per second on this machine). Usage:  ac examples/algo_bench.a -o algo_bench && ./algo_bench
// The numbers in docs/ALGO.md come from this program (native x86-64, one run on a shared machine: expect +-20 percent).
import cstdio;
import cstring;
import asys;
import ds;
import strx;
import rng;

int sink = 0;
uint64 sinkU = 0;

void report(char* name, int ops, int ms) {
    if (ms < 1) { ms = 1; }
    int perSec = ops * 1000 / ms;
    printf("| %-46s | %12d |\n", name, perSec);
}

int seed = 12345;
int rnd(int n) {
    int x = seed;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);
    x = x ^ (x << 17);
    seed = x;
    return ((x >> 8) & 0x7FFFFFFFFFFFFF) % n;
}

void benchDs() {
    int n = 1000000;
    int t0 = millis();
    ds.Deque d(16);
    for (int i = 0; i < n; i++) { d.pushBack(i); if ((i & 1) == 1) { sink = sink + d.popFront(); } }
    report("Deque pushBack + popFront", n + n / 2, millis() - t0);
    d.dispose();

    t0 = millis();
    ds.RingBuffer r(1024);
    for (int i = 0; i < n; i++) { r.push(i); }
    report("RingBuffer push (overwriting)", n, millis() - t0);
    r.dispose();

    t0 = millis();
    ds.BinaryHeap h;
    for (int i = 0; i < 200000; i++) { h.push(rnd(1000000), i); }
    for (int i = 0; i < 200000; i++) { sink = sink + h.pop(); }
    report("BinaryHeap push + pop (200000 each)", 400000, millis() - t0);
    h.dispose();

    t0 = millis();
    ds.OrderedMap m;
    for (int i = 0; i < 200000; i++) { m.put(rnd(100000000), i); }
    report("OrderedMap put (random keys)", 200000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 200000; i++) { sink = sink + m.get(rnd(100000000), 0); }
    report("OrderedMap get", 200000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 200000; i++) { sink = sink + m.floorNode(rnd(100000000)); }
    report("OrderedMap floorNode", 200000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 200000; i++) { sink = sink + m.rank(rnd(100000000)); }
    report("OrderedMap rank", 200000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 200000; i++) { m.remove(rnd(100000000)); }
    report("OrderedMap remove (mostly absent keys)", 200000, millis() - t0);
    m.dispose();

    t0 = millis();
    ds.HashMap hm;
    for (int i = 0; i < 500000; i++) { hm.put(rnd(1000000000), i); }
    report("HashMap put (int keys)", 500000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 500000; i++) { sink = sink + hm.get(rnd(1000000000), 0); }
    report("HashMap get", 500000, millis() - t0);
    hm.dispose();

    char** words = (char**) alloc(100001 * 8);
    char* store = alloc(100000 * 16);
    for (int i = 0; i < 100000; i++) { words[i] = &store[i * 16]; format(words[i], 16, "w%d", rnd(1000000)); }
    t0 = millis();
    ds.TextHashMap th;
    for (int i = 0; i < 100000; i++) { th.add(words[i], 1); }
    report("TextHashMap add (text keys)", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + th.get(words[i], 0); }
    report("TextHashMap get", 100000, millis() - t0);
    th.dispose();
    t0 = millis();
    ds.Trie tr;
    for (int i = 0; i < 100000; i++) { tr.put(words[i], i); }
    report("Trie put (text keys)", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + tr.countPrefix("w12"); }
    report("Trie countPrefix", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 1000; i++) { sink = sink + tr.countWildcard("w1?3*"); }
    report("Trie countWildcard (100000 keys)", 1000, millis() - t0);
    tr.dispose();

    t0 = millis();
    ds.DisjointSet u(1000000);
    for (int i = 0; i < 1000000; i++) { u.unite(rnd(1000000), rnd(1000000)); }
    report("DisjointSet unite (random pairs)", 1000000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 1000000; i++) { sink = sink + u.find(i); }
    report("DisjointSet find", 1000000, millis() - t0);
    u.dispose();

    t0 = millis();
    ds.BitSet b(1000000);
    for (int i = 0; i < 2000000; i++) { b.set(rnd(1000000)); }
    report("BitSet set", 2000000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 1000; i++) { sink = sink + b.count(); }
    report("BitSet count (1000000 bits)", 1000, millis() - t0);
    b.dispose();

    t0 = millis();
    ds.Fenwick f(1000000);
    for (int i = 0; i < 500000; i++) { f.add(rnd(1000000), 1); }
    for (int i = 0; i < 500000; i++) { sink = sink + f.prefix(rnd(1000000)); }
    report("Fenwick add / prefix (500000 each)", 1000000, millis() - t0);
    f.dispose();

    t0 = millis();
    ds.SegTree s(200000, ds.SEG_SUM);
    for (int i = 0; i < 100000; i++) { int a = rnd(200000); int c = rnd(200000); if (a > c) { int t = a; a = c; c = t; } s.add(a, c, 1); }
    for (int i = 0; i < 100000; i++) { int a = rnd(200000); int c = rnd(200000); if (a > c) { int t = a; a = c; c = t; } sink = sink + s.query(a, c); }
    report("SegTree range add / range sum (lazy)", 200000, millis() - t0);
    s.dispose();

    t0 = millis();
    ds.LruCache lru(10000);
    for (int i = 0; i < 500000; i++) { int k = rnd(20000); if (lru.get(k, -1) < 0) { lru.put(k, i); } }
    report("LruCache get / put (capacity 10000, 20000 keys)", 500000, millis() - t0);
    lru.dispose();

    t0 = millis();
    ds.BloomFilter bf(100000, 100);
    for (int i = 0; i < 100000; i++) { bf.add(i); }
    for (int i = 0; i < 400000; i++) { if (bf.mightContain(rnd(1000000))) { sink++; } }
    report("BloomFilter add + mightContain", 500000, millis() - t0);
    bf.dispose();
    t0 = millis();
    ds.CountMinSketch cm;
    for (int i = 0; i < 300000; i++) { cm.add(rnd(5000)); }
    for (int i = 0; i < 300000; i++) { sink = sink + cm.estimate(rnd(5000)); }
    report("CountMinSketch add + estimate", 600000, millis() - t0);
    cm.dispose();
}

void benchStrx() {
    int n = 4000000;
    char* text = alloc(n + 1);
    for (int i = 0; i < n; i++) { text[i] = 'a' + rnd(4); }
    text[n] = 0;
    int t0 = millis();
    strx.Kmp k("abcdabcdabcd");
    sink = sink + k.count(text, n);
    report("Kmp.count: bytes per second (4 MB, 12 letter pattern)", n, millis() - t0);
    strx.Horspool h("abcdabcdabcd");
    t0 = millis();
    sink = sink + h.count(text, n);
    report("Horspool.count: bytes per second", n, millis() - t0);
    strx.RabinKarp rk("abcdabcdabcd");
    t0 = millis();
    sink = sink + rk.count(text, n);
    report("RabinKarp.count: bytes per second", n, millis() - t0);
    t0 = millis();
    strx.AhoCorasick ac;
    for (int i = 0; i < 500; i++) { char w[8]; int len = 4 + rnd(4); for (int j = 0; j < len; j++) { w[j] = 'a' + rnd(4); } ac.add(&w[0], len); }
    sink = sink + ac.count(text, n);
    report("AhoCorasick (500 patterns): bytes per second", n, millis() - t0);
    ac.dispose();
    k.dispose(); h.dispose(); rk.dispose();

    char a[64];
    char b[64];
    for (int i = 0; i < 40; i++) { a[i] = 'a' + rnd(8); b[i] = 'a' + rnd(8); }
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + strx.levenshtein(&a[0], 40, &b[0], 40); }
    report("levenshtein of two 40 letter texts", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + strx.levenshteinMax(&a[0], 40, &b[0], 40, 3); }
    report("levenshteinMax(k = 3) of two 40 letter texts", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + strx.osa(&a[0], 40, &b[0], 40); }
    report("osa of two 40 letter texts", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 20000; i++) { double d = strx.jaroWinkler(&a[0], 40, &b[0], 40); sink = sink + (int) (d * 1000.0); }
    report("jaroWinkler of two 40 letter texts", 20000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + strx.lcsLength(&a[0], 40, &b[0], 40); }
    report("lcsLength of two 40 letter texts", 100000, millis() - t0);

    int m = 2000000;
    t0 = millis();
    strx.SuffixArray sa(text, m);
    report("SuffixArray build: letters per second (2 MB, 4 letters)", m, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + sa.count("abcab"); }
    report("SuffixArray.count of a 5 letter pattern", 100000, millis() - t0);
    sa.dispose();
    t0 = millis();
    sink = sink + strx.longestPalindrome(text, 2000000, null);
    report("longestPalindrome (Manacher): letters per second", 2000000, millis() - t0);

    int lines = 100000;
    char** x = (char**) alloc((lines + 1) * 8);
    char** y = (char**) alloc((lines + 100) * 8);
    char* store = alloc(lines * 12);
    for (int i = 0; i < lines; i++) { x[i] = &store[i * 12]; format(x[i], 12, "L%d", rnd(300)); }
    int ny = 0;
    for (int i = 0; i < lines; i++) { if (rnd(500) == 0) { continue; } y[ny] = x[i]; ny++; if (rnd(500) == 0) { y[ny] = "extra"; ny++; } }
    t0 = millis();
    strx.LineDiff d;
    d.run(x, lines, y, ny);
    report("LineDiff.run: lines per second (100000 lines, 400 edits)", lines, millis() - t0);
    t0 = millis();
    char* u = d.unified("a", "b", 3);
    report("LineDiff.unified: lines of output per second", d.distance() * 7 + 1, millis() - t0);
    strx.freeText(u);
    d.dispose();

    char** names = (char**) alloc(50001 * 8);
    char* ns = alloc(50000 * 32);
    for (int i = 0; i < 50000; i++) { names[i] = &ns[i * 32]; format(names[i], 32, "src/dir%d/file%d.a", rnd(300), i); }
    strx.FuzzyMatcher f("d12f77");
    int top[10];
    t0 = millis();
    f.rank(names, 50000, &top[0], 10, null);
    report("FuzzyMatcher.rank: candidates per second", 50000, millis() - t0);
    f.dispose();
    t0 = millis();
    for (int i = 0; i < 200000; i++) { if (strx.globMatch("src/**/*.a", "src/dir12/file77.a", strx.GLOB_PATHNAME)) { sink++; } }
    report("globMatch src/**/*.a", 200000, millis() - t0);
}

void benchRng() {
    int n = 2000000;
    int t0 = millis();
    rng.SplitMix64 a(1);
    for (int i = 0; i < n; i++) { sinkU = sinkU ^ a.nextU64(); }
    report("SplitMix64.nextU64", n, millis() - t0);
    rng.Xoshiro256 x(1);
    t0 = millis();
    for (int i = 0; i < n; i++) { sinkU = sinkU ^ x.nextU64(); }
    report("Xoshiro256.nextU64", n, millis() - t0);
    rng.Pcg32 p32(1, 1);
    t0 = millis();
    for (int i = 0; i < n; i++) { sinkU = sinkU ^ p32.nextU64(); }
    report("Pcg32.nextU64 (two 32 bit outputs)", n, millis() - t0);
    rng.Pcg64 p64(1, 1);
    t0 = millis();
    for (int i = 0; i < n; i++) { sinkU = sinkU ^ p64.nextU64(); }
    report("Pcg64.nextU64", n, millis() - t0);
    rng.Mt19937 mt(1);
    t0 = millis();
    for (int i = 0; i < n; i++) { sinkU = sinkU ^ mt.nextU64(); }
    report("Mt19937.nextU64 (two 32 bit outputs)", n, millis() - t0);
    rng.ChaCha20Rng cc;
    t0 = millis();
    for (int i = 0; i < 400000; i++) { sinkU = sinkU ^ cc.nextU64(); }
    report("ChaCha20Rng.nextU64 (CSPRNG)", 400000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < n; i++) { sink = sink + x.below(1000); }
    report("below(1000) (Lemire, no bias)", n, millis() - t0);
    t0 = millis();
    double s = 0.0;
    for (int i = 0; i < 500000; i++) { s = s + x.nextDouble(); }
    report("nextDouble (soft float)", 500000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 500000; i++) { s = s + x.normal(); }
    report("normal (ziggurat)", 500000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 300000; i++) { s = s + x.exponential(); }
    report("exponential (ziggurat)", 300000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { s = s + x.gamma(2.5); }
    report("gamma(2.5)", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + x.poisson(4.0); }
    report("poisson(4)", 100000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 20000; i++) { sink = sink + x.poisson(100.0); }
    report("poisson(100) (PTRS)", 20000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100000; i++) { sink = sink + x.binomial(100, 0.1); }
    report("binomial(100, 0.1)", 100000, millis() - t0);
    int* arr = (int*) alloc(1000001 * 8);
    for (int i = 0; i < 1000000; i++) { arr[i] = i; }
    t0 = millis();
    x.shuffle(arr, 1000000);
    report("shuffle: elements per second", 1000000, millis() - t0);
    t0 = millis();
    for (int i = 0; i < 100; i++) { x.sample(1000000, 1000, arr); }
    report("sample(1000000, 1000): samples per second x 1000", 100000, millis() - t0);
    double w[1000];
    for (int i = 0; i < 1000; i++) { w[i] = (double) (1 + i % 17); }
    rng.AliasTable t(&w[0], 1000);
    t0 = millis();
    for (int i = 0; i < 200000; i++) { sink = sink + t.sample(&x); }
    report("AliasTable.sample (1000 categories)", 200000, millis() - t0);
    t.dispose();
    char id[40];
    t0 = millis();
    for (int i = 0; i < 100000; i++) { cc.uuid4(&id[0]); }
    report("uuid4", 100000, millis() - t0);
    cc.dispose();
}

int main() {
    printf("| %-46s | %12s |\n", "operation", "per second");
    printf("|%s|%s|\n", "------------------------------------------------", "--------------");
    benchDs();
    benchStrx();
    benchRng();
    printf("(%d %u)\n", sink, sinkU);
    return 0;
}
