// A small "ls -l": lists a directory (default: the current one) with type, size, date and name.
//   build:  ac -o lsl lsl.a        run:  ./lsl /tmp
import clib;

int compare(char* a, char* b) {
    return strcmp(((char**) a)[0], ((char**) b)[0]);
}

int main(int argc, char** argv) {
    char* dir = ".";
    if (argc > 1) {
        dir = argv[1];
    }
    DIR* d = opendir(dir);
    if (d == null) {
        eprint(dir);
        eprint(": ");
        eprintln(strerror(errno));
        return 1;
    }
    char* names[2048];
    int n = 0;
    Dirent* e;
    while ((e = readdir(d)) != null && n < 2048) {
        if (!streq(&e->d_name[0], ".") && !streq(&e->d_name[0], "..")) {
            names[n] = strdup(&e->d_name[0]);
            n++;
        }
    }
    closedir(d);
    qsort((char*) names, n, 8, compare);
    int total = 0;
    for (int i = 0; i < n; i++) {
        char path[1024];
        snprintf(path, 1024, "%s/%s", dir, names[i]);
        Stat st;
        if (lstat(path, &st) != 0) {
            continue;
        }
        char kind = '-';
        if (S_ISDIR(st.st_mode)) kind = 'd';
        else if (S_ISLNK(st.st_mode)) kind = 'l';
        char when[32];
        int mt = st.st_mtime;
        strftime(when, 32, "%Y-%m-%d %H:%M", localtime(&mt));
        printf("%c %10d  %s  %s\n", kind, st.st_size, (int) when, names[i]);
        total = total + st.st_size;
    }
    printf("%d entries, %d bytes\n", n, total);
    return 0;
}
