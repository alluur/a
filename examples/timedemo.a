// A small "date": prints the current time in several time zones.   build:  ac -o timedemo timedemo.a
import clib;

void show(char* zone, char* label) {
    setenv("TZ", zone, true);
    tzset();
    int now = time(null);
    tm* t = localtime(&now);
    char buf[100];
    strftime(buf, 100, "%a %Y-%m-%d %H:%M:%S %Z (UTC%z)", t);
    printf("%-9s %s\n", (int) label, (int) buf);
}

int main() {
    show("UTC", "UTC");
    show("EET-2EEST,M3.5.0/3,M10.5.0/4", "Helsinki");
    show("CET-1CEST,M3.5.0,M10.5.0/3", "Paris");
    show("EST5EDT,M3.2.0,M11.1.0", "New York");
    show("PST8PDT,M3.2.0,M11.1.0", "Los Angeles");
    show("<+0530>-5:30", "Mumbai");
    show("JST-9", "Tokyo");
    show("AEST-10AEDT,M10.1.0,M4.1.0/3", "Sydney");
    // calendar arithmetic with mktime: 100 days from today
    setenv("TZ", "UTC", true);
    tzset();
    int now = time(null);
    tm* t = localtime(&now);
    t->tm_mday = t->tm_mday + 100;
    mktime(t);
    char buf[100];
    strftime(buf, 100, "in 100 days it is %A, %B %e %Y", t);
    println(buf);
    return 0;
}
