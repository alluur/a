// A small neural network learns XOR (a multi-layer perceptron with back-propagation)
import nn;
import fixed;

int main() {
    int ONE = fixed.ONE;
    int x[8] ;
    x[0] = 0; x[1] = 0;  x[2] = 0; x[3] = ONE;  x[4] = ONE; x[5] = 0;  x[6] = ONE; x[7] = ONE;
    int t[4];
    t[0] = 0; t[1] = ONE; t[2] = ONE; t[3] = 0;

    int sizes[3]; sizes[0] = 2; sizes[1] = 4; sizes[2] = 1;
    nn.Network* net = new nn.Network(3, sizes, nn.ACT_TANH, nn.ACT_SIGMOID);
    for (int round = 1; round <= 5; round++) {
        int loss = net->fit(x, t, 4, 200, fixed.fromText("0.5"), 0);
        print("after "); printInt(round * 200); print(" epochs the loss is ");
        fixed.putln(loss, 5);
    }
    for (int i = 0; i < 4; i++) {
        int* y = net->forward(&x[i * 2]);
        printInt(x[i * 2] / ONE); print(" xor "); printInt(x[i * 2 + 1] / ONE); print(" = ");
        fixed.putln(y[0], 3);
    }
    return 0;
}
