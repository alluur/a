// Lists a directory sorted by name with file sizes:   ./dirlist [directory]
import os;
import sort;
import path;
import decimal;

int main(int argc, char** argv) {
    char* dir = ".";
    if (argc > 1) {
        dir = argv[1];
    }
    char* names[512];
    int n = os.listDir(dir, names, 512);
    if (n < 0) {
        eprint("cannot read directory ");
        eprintln(dir);
        return 1;
    }
    sort.sortStrings(names, n);
    printf("%s (%d entries)\n", (int)os.getCwd(), n, 0, 0);
    for (int i = 0; i < n; i++) {
        int size = os.fileSize(path.join(dir, names[i]));
        if (size < 0) {
            printf("%-30s %12s\n", (int)names[i], (int)"<dir>", 0, 0);
        } else {
            printf("%-30s %12s\n", (int)names[i], (int)decimal.formatMoney(size * 100), 0, 0);
        }
    }
    return 0;
}
