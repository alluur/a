// An HTTPS web server for a directory:   httpsd cert.pem key.pem [port] [directory]
//
// cert.pem holds the server certificate (and the intermediate certificates after it), key.pem its private key (RSA or EC
// P-256 / P-384, PEM). TLS 1.3 only. A certificate for tests:
//
//   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 30 \
//       -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" -keyout key.pem -out cert.pem
//   ./httpsd cert.pem key.pem 8443 .        then   curl --cacert cert.pem https://localhost:8443/
import http;
import tls;

int main(int argc, char** argv) {
    if (argc < 3) {
        println("usage: httpsd cert.pem key.pem [port] [directory]");
        return 1;
    }
    char* cert = readFile(argv[1]);
    char* key = readFile(argv[2]);
    if (cert == null || key == null) {
        println("cannot read the certificate or the key");
        return 1;
    }
    tls.Config* cfg = tls.loadConfig(cert, key);
    if (cfg == null) {
        print("cannot use them: ");
        println(tls.lastError());
        return 1;
    }
    int port = (argc > 3) ? atoi(argv[3]) : 8443;
    char* dir = (argc > 4) ? argv[4] : ".";
    print("serving ");
    print(dir);
    print(" on https://localhost:");
    printlnInt(port);
    http.serveStaticTls(port, dir, 0, cfg);
    return 0;
}
