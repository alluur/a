// Shows what the system knows about the network: interfaces, gateway, DNS servers, ARP table, open sockets
import netif;
import netaddr;

int main() {
    println("== interfaces");
    for (int i = 0; i < netif.interfaceCount(); i++) {
        netif.Iface* f = netif.interfaceAt(i);
        print(f->name); print("  "); print(netaddr.ipToText(f->ip));
        if (f->mask != 0) { print("/"); printInt(netaddr.prefixFromMask(f->mask)); }
        print("  mac "); print(netaddr.macToText(&f->mac[0]));
        print("  mtu "); printInt(f->mtu);
        if (f->isUp()) print("  UP");
        println("");
    }
    print("default gateway: "); println(netaddr.ipToText(netif.defaultGateway()));
    int dns[4];
    int n = netif.dnsServers(dns, 4);
    for (int i = 0; i < n; i++) { print("dns server: "); println(netaddr.ipToText(dns[i])); }
    println("== arp table");
    for (int i = 0; i < netif.arpCount(); i++) {
        netif.ArpEntry* e = netif.arpAt(i);
        print(netaddr.ipToText(e->ip)); print("  "); print(netaddr.macToText(&e->mac[0])); print("  "); println(e->device);
    }
    println("== sockets");
    for (int i = 0; i < netif.connectionCount(); i++) {
        netif.Socket* s = netif.connectionAt(i);
        print(s->proto); print("  "); print(netaddr.ipToText(s->localIp)); print(":"); printInt(s->localPort);
        print("  "); print(netaddr.ipToText(s->remoteIp)); print(":"); printInt(s->remotePort);
        print("  "); println(netif.stateName(s->state));
    }
    return 0;
}
