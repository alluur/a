// Formatted output with printf: a multiplication table and a price list.
int main() {
    print("   |");
    for (int x = 1; x <= 9; x++) printf("%4d", x, 0, 0, 0);
    println("");
    printRepeat('-', 40); println("");
    for (int y = 1; y <= 9; y++) {
        printf("%2d |", y, 0, 0, 0);
        for (int x = 1; x <= 9; x++) printf("%4d", x * y, 0, 0, 0);
        println("");
    }
    println("");
    printf("%-12s %6s\n", (int)"item", (int)"price", 0, 0);
    printf("%-12s %6d\n", (int)"coffee", 350, 0, 0);
    printf("%-12s %6d\n", (int)"sandwich", 1250, 0, 0);
    printf("%-12s %06d  (hex %x)\n", (int)"total", 1600, 1600, 0);
    return 0;
}
