// A WebSocket echo server on port 8081: connect with a browser or a WebSocket client (ws://localhost:8081/)
import websocket;
import conn;

int main() {
    conn.Listener* l = new conn.Listener(8081);
    if (!l->ok()) { println("cannot listen on port 8081"); return 1; }
    println("websocket echo server on ws://localhost:8081/");
    for (;;) {
        conn.Connection* c = l->accept(-1);
        if (c == null) continue;
        websocket.WebSocket* ws = websocket.accept(c, null, 0);
        if (ws == null) continue;
        char buf[4096];
        int op;
        int n;
        while ((n = ws->receive(buf, 4095, &op)) >= 0) {
            if (op == websocket.OP_TEXT) { buf[n] = 0; ws->sendText(buf); }
            else ws->sendBinary(buf, n);
        }
    }
    return 0;
}
