// A small grep with regular expressions:   cat file | ./grep -n "[0-9]+ items"        (-v inverts, -c counts)
import regex;
import cli;

int main(int argc, char** argv) {
    cli.ArgParser p("grep", "Prints the lines of standard input that match a pattern");
    p.addFlag("-n,--line-number", "prefix each line with its number");
    p.addFlag("-v,--invert", "print the lines that do NOT match");
    p.addFlag("-c,--count", "only print how many lines match");
    if (!p.parse(argc, argv)) {
        return 1;
    }
    if (p.positionalCount() < 1) {
        eprintln("grep: a pattern is required (try --help)");
        return 2;
    }
    char* pattern = p.positional(0);
    char line[4096];
    int lineNo = 0;
    int matched = 0;
    while (readLine(line, 4096) >= 0) {
        lineNo++;
        bool hit = regex.test(pattern, line);
        if (p.flag("-v")) {
            hit = !hit;
        }
        if (!hit) {
            continue;
        }
        matched++;
        if (p.flag("-c")) {
            continue;
        }
        if (p.flag("-n")) {
            printf("%d:", lineNo, 0, 0, 0);
        }
        println(line);
    }
    if (p.flag("-c")) {
        printlnInt(matched);
    }
    if (matched > 0) {
        return 0;
    }
    return 1;
}
