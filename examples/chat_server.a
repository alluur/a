// A chat server for many clients in one thread: telnet localhost 7000 (stop with ctrl-c)
import conn;

conn.Connection* clients[64];
int nclients;

void broadcast(char* text, conn.Connection* except) {
    for (int i = 0; i < nclients; i++) {
        if (clients[i] != except) { clients[i]->writeLine(text); clients[i]->flush(); }
    }
}

int main() {
    conn.Listener* l = new conn.Listener(7000);
    if (!l->ok()) { println("cannot listen on port 7000"); return 1; }
    println("chat server on port 7000");
    conn.Poller* p = new conn.Poller();
    p->add(l->handle(), -1);
    for (;;) {
        int ready = p->wait(-1);
        for (int r = 0; r < ready; r++) {
            int tag = p->readyTag(r);
            if (tag == -1) {                                    // a new client
                conn.Connection* c = l->accept(0);
                if (c != null && nclients < 64) {
                    clients[nclients] = c;
                    p->add(c->handle(), nclients);
                    nclients++;
                    c->writeLine("welcome! type a message");
                    c->flush();
                    broadcast("* someone joined", c);
                }
            } else {
                conn.Connection* c = clients[tag];
                char line[256];
                if (c->readLine(line, 256) < 0) {               // the client left
                    p->remove(c->handle());
                    c->close();
                    clients[tag] = clients[nclients - 1];
                    nclients--;
                    broadcast("* someone left", null);
                } else {
                    char msg[300];
                    format(msg, 300, "<%d> %s", tag, line);
                    broadcast(msg, c);
                }
            }
        }
    }
    return 0;
}
