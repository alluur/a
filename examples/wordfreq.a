// Word frequencies of standard input using collections.StrMap, strings and sort.
//   echo "the cat and the hat and the bat" | ./wordfreq
import collections;
import strings;
import sort;

int main() {
    collections.StrMap words;
    char* text = readAll();
    char* parts[4096];
    int n = strings.split(strings.lower(text), ' ', parts, 4096);
    for (int i = 0; i < n; i++) {
        char* w = trim(parts[i]);
        if (strlen(w) > 0) {
            words.put(w, words.get(w, 0) + 1);
        }
    }
    // collect and sort the distinct words alphabetically
    char* keys[1024];
    int count = 0;
    for (int s = 0; s < words.capacity(); s++) {
        if (words.keyAt(s) != null && count < 1024) {
            keys[count] = words.keyAt(s);
            count++;
        }
    }
    sort.sortStrings(keys, count);
    for (int i = 0; i < count; i++) {
        printf("%-12s %d\n", (int)keys[i], words.get(keys[i], 0), 0, 0);
    }
    printf("%d distinct words\n", count, 0, 0, 0);
    return 0;
}
