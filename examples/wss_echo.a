// A blocking WebSocket echo server over TLS (wss://), one client at a time:  wss_echo PORT CERT.pem KEY.pem
// (for many clients at once use wshub, see hub_demo.a)
import websocket;
import conn;
import tls;

int main(int argc, char** argv) {
    if (argc < 4) { println("usage: wss_echo PORT CERT.pem KEY.pem"); return 1; }
    tls.Config* cfg = tls.loadConfig(readFile(argv[2]), readFile(argv[3]));
    if (cfg == null) { println("cannot load the certificate and key"); return 1; }
    conn.Listener* l = new conn.Listener(atoi(argv[1]));
    if (!l->ok()) { println("cannot listen"); return 1; }
    printf("wss echo server on port %d\n", l->port());
    for (;;) {
        conn.Connection* c = l->accept(-1);
        if (c == null) continue;
        char path[200];
        websocket.WebSocket* ws = websocket.acceptTls(c, cfg, &path[0], 200);
        if (ws == null) continue;
        for (;;) {
            websocket.Message* m = ws->receiveMessage();
            if (m == null) break;
            if (m->opcode == websocket.OP_TEXT) ws->sendText(m->data); else ws->sendBinary(m->data, m->length);
            m->dispose();
        }
        ws->dispose();
    }
    return 0;
}
