// Structs, pointers and the heap
struct Node {
    int value;
    Node* next;
}

Node* push(Node* head, int value) {
    Node* n = new Node;
    n->value = value;
    n->next = head;
    return n;
}

int main() {
    Node* list = null;
    for (int i = 1; i <= 5; i++) {
        list = push(list, i * i);
    }
    int sum = 0;
    for (Node* p = list; p != null; p = p->next) {
        printInt(p->value);
        print(" ");
        sum += p->value;
    }
    println("");
    print("sum = ");
    printlnInt(sum);
    return 0;
}
