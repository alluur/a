// A small SMTP server (smtpd) that stores every message in a Maildir: /tmp/mail/<name>/new/. It is NOT an open relay: only mail for the local domain is taken.
//   smtpd_demo [PORT [DOMAIN [DIRECTORY]]]
//   send with the A client (import smtp;  smtp.connect("smtp://localhost:PORT")), with  swaks, or with  nc  by hand: EHLO x / MAIL FROM:<a@b.test> / RCPT TO:<anyone@DOMAIN> / DATA
import smtpd;

int main(int argc, char** argv) {
    int port = 2525;
    char* domain = "example.org";
    char* dir = "/tmp/mail";
    if (argc > 1) port = atoi(argv[1]);
    if (argc > 2) domain = argv[2];
    if (argc > 3) dir = argv[3];
    smtpd.Server* s = smtpd.newServer();
    s->core->hostname = domain;
    s->core->addLocalDomain(domain);
    s->core->maildir = dir;
    if (!s->listen(port)) {
        println("cannot listen on that port");
        return 1;
    }
    printf("SMTP server on port %d for @%s, mailboxes in %s\n", s->port, domain, dir);
    s->run();
    return 0;
}
